{"file": "遇春枯木生：权臣的掌上明珠-第32集.mp4", "ep": 32, "duration": 56.7, "segments": [{"start": 0.0, "end": 0.92, "text": "快进来"}, {"start": 1.2, "end": 3.36, "text": "帮我把这玩意儿卸了脖子要断了"}, {"start": 10.28, "end": 11.56, "text": "我让你拿的册子呢"}, {"start": 14.29, "end": 15.77, "text": "行了 你俩快出去吧"}, {"start": 18.15, "end": 19.03, "text": "恶补一下"}, {"start": 19.19, "end": 20.67, "text": "前院酒席没那么快散"}, {"start": 20.67, "end": 21.47, "text": "世子爷"}, {"start": 29.59, "end": 34.1, "text": "夫君 美色无人啊"}, {"start": 34.38, "end": 35.42, "text": "怎么了"}, {"start": 35.78, "end": 37.14, "text": "天色已然不早"}, {"start": 37.54, "end": 39.38, "text": "夫君 早些休息吧"}, {"start": 40.38, "end": 40.86, "text": "好"}, {"start": 41.18, "end": 42.3, "text": "夫君 腿脚不便"}, {"start": 42.66, "end": 43.98, "text": "要不 我来"}, {"start": 44.26, "end": 49.36, "text": "不劳夫人费心"}, {"start": 50.27, "end": 51.19, "text": "那夫君"}, {"start": 51.78, "end": 53.06, "text": "可不要让我失望"}]}