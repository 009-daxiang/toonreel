{"file": "遇春枯木生：权臣的掌上明珠-第28集.mp4", "ep": 28, "duration": 50.3, "segments": [{"start": 8.06, "end": 8.78, "text": "大哥"}, {"start": 9.18, "end": 10.7, "text": "你如今不过是个废人"}, {"start": 11.02, "end": 12.58, "text": "娶个伤化女正配你"}, {"start": 13.1, "end": 18.85, "text": "这平宁侯府还得靠我"}, {"start": 18.97, "end": 20.85, "text": "二哥竟真娶了个伤祸女"}, {"start": 21.42, "end": 22.7, "text": "轻衣姐你别难过"}, {"start": 22.82, "end": 24.5, "text": "等会儿我非叫她当众出丑"}, {"start": 24.54, "end": 26.14, "text": "让她知道自己几斤几两"}, {"start": 26.46, "end": 27.18, "text": "阿玥"}, {"start": 27.58, "end": 28.54, "text": "你千万别"}, {"start": 30.3, "end": 34.06, "text": "新郎官街新娘子回来了"}, {"start": 34.06, "end": 36.34, "text": "郎官街新娘子回来了"}]}