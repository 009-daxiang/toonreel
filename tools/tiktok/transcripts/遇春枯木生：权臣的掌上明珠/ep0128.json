{"file": "遇春枯木生：权臣的掌上明珠-第128集.mp4", "ep": 128, "duration": 50.3, "segments": [{"start": 0.0, "end": 0.96, "text": "静待时机"}, {"start": 1.44, "end": 2.52, "text": "世子料事如神"}, {"start": 2.92, "end": 4.64, "text": "一月前您让盯手的河堤猫腻"}, {"start": 4.88, "end": 6.4, "text": "如今已借大雪放出风声"}, {"start": 6.76, "end": 7.56, "text": "不出三日"}, {"start": 7.84, "end": 8.88, "text": "满长安都会知道"}, {"start": 8.88, "end": 10.2, "text": "修堤只剩个空壳"}, {"start": 10.56, "end": 11.32, "text": "舆论一程"}, {"start": 11.6, "end": 12.92, "text": "比前联公布和陆家"}, {"start": 13.42, "end": 14.34, "text": "顺藤魔挂"}, {"start": 14.62, "end": 16.62, "text": "终将盘扯到结党英司之时"}, {"start": 16.94, "end": 17.5, "text": "世子"}, {"start": 17.94, "end": 19.26, "text": "咱们是否现在遞交证据"}, {"start": 19.26, "end": 20.1, "text": "顺势发难"}, {"start": 20.66, "end": 21.3, "text": "不急"}, {"start": 21.74, "end": 22.7, "text": "雪还没停"}, {"start": 23.36, "end": 24.28, "text": "现在出手"}, {"start": 24.6, "end": 26.6, "text": "顶多拉几个底层官员顶罪"}, {"start": 27.08, "end": 29.12, "text": "动不了沈怀金和陆家的根基"}, {"start": 29.6, "end": 30.8, "text": "更碰不到东宫"}, {"start": 31.43, "end": 31.95, "text": "等"}, {"start": 32.78, "end": 34.54, "text": "等河堤彻底亏他"}, {"start": 35.17, "end": 36.49, "text": "民怨沸腾"}, {"start": 44.71, "end": 45.71, "text": "天还没大亮"}, {"start": 45.99, "end": 47.71, "text": "这车是出了门回来的"}, {"start": 48.19, "end": 49.75, "text": "还是一整晚都没回来"}]}