{"file": "遇春枯木生：权臣的掌上明珠-第134集.mp4", "ep": 134, "duration": 49.9, "segments": [{"start": 0.0, "end": 1.0, "text": "你可明白了"}, {"start": 4.42, "end": 5.02, "text": "不过"}, {"start": 5.22, "end": 6.42, "text": "既然你回来了"}, {"start": 6.82, "end": 8.42, "text": "就别想那些烦心事"}, {"start": 8.82, "end": 9.82, "text": "这鬼天气"}, {"start": 9.82, "end": 11.82, "text": "你安心在家里住上两日"}, {"start": 12.22, "end": 13.42, "text": "不必急着回去"}, {"start": 13.82, "end": 15.22, "text": "让他自己烦心去"}, {"start": 19.63, "end": 20.83, "text": "这般能够药味"}, {"start": 21.03, "end": 22.63, "text": "三舅母常年静养"}, {"start": 22.83, "end": 24.03, "text": "我贸然前来"}, {"start": 24.43, "end": 26.03, "text": "怕是会打扰她休息"}, {"start": 26.23, "end": 28.03, "text": "可老夫人既有吩咐"}, {"start": 28.23, "end": 29.63, "text": "我又怎敢推托"}, {"start": 31.13, "end": 31.93, "text": "姑娘请"}, {"start": 32.13, "end": 38.75, "text": "来坐"}, {"start": 43.86, "end": 44.66, "text": "表舅母"}, {"start": 46.34, "end": 46.94, "text": "快坐"}, {"start": 46.94, "end": 49.84, "text": "小舅舅今日不在院中吗"}]}