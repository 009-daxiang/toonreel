{"file": "遇春枯木生：权臣的掌上明珠-第49集.mp4", "ep": 49, "duration": 49.2, "segments": [{"start": 0.0, "end": 0.76, "text": "捧杀"}, {"start": 3.53, "end": 4.13, "text": "算了"}, {"start": 4.45, "end": 5.53, "text": "我要进去看你哥了"}, {"start": 5.65, "end": 6.29, "text": "你要去吗"}, {"start": 6.41, "end": 6.97, "text": "不去"}, {"start": 7.09, "end": 8.05, "text": "我只是路过"}, {"start": 10.81, "end": 11.41, "text": "夫君"}, {"start": 11.73, "end": 13.41, "text": "不然我们歇歇再回府"}, {"start": 13.85, "end": 14.49, "text": "不碍事"}, {"start": 18.7, "end": 19.5, "text": "是是"}, {"start": 20.12, "end": 21.16, "text": "我送的那个"}, {"start": 21.48, "end": 22.12, "text": "正是"}, {"start": 22.44, "end": 23.84, "text": "我让春桃去查过"}, {"start": 24.24, "end": 26.16, "text": "那条街上的木座行关了大半"}, {"start": 26.32, "end": 27.48, "text": "东家急着转让"}, {"start": 27.56, "end": 29.16, "text": "这背后显然是他的手柄"}, {"start": 29.52, "end": 31.2, "text": "帮我压架才盘下了铺子"}, {"start": 31.52, "end": 32.52, "text": "还顺理成章"}, {"start": 32.52, "end": 33.4, "text": "收了轮椅"}, {"start": 35.0, "end": 36.04, "text": "那我们先回府吧"}, {"start": 36.44, "end": 37.0, "text": "蓄之"}, {"start": 37.2, "end": 37.72, "text": "嫂嫂"}, {"start": 38.08, "end": 38.8, "text": "今日余赛"}, {"start": 38.8, "end": 39.96, "text": "陆云舟没脸领奖了"}, {"start": 40.28, "end": 41.68, "text": "恭喜嫂嫂拔得头潮"}]}