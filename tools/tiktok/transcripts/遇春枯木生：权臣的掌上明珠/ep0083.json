{"file": "遇春枯木生：权臣的掌上明珠-第83集.mp4", "ep": 83, "duration": 49.2, "segments": [{"start": 0.69, "end": 1.89, "text": "等你歇差不多了"}, {"start": 2.49, "end": 3.61, "text": "再回去就是"}, {"start": 5.98, "end": 7.22, "text": "我不會回公部了"}, {"start": 8.25, "end": 9.25, "text": "你什麼意思"}, {"start": 9.84, "end": 10.56, "text": "我這腿"}, {"start": 11.19, "end": 11.79, "text": "廢了"}, {"start": 11.95, "end": 13.15, "text": "那又如何"}, {"start": 13.47, "end": 14.99, "text": "你就打算這麼一輩子"}, {"start": 16.1, "end": 16.82, "text": "那你呢"}, {"start": 17.57, "end": 18.85, "text": "今日你請我過來"}, {"start": 19.61, "end": 21.09, "text": "是以朋友的身份"}, {"start": 22.3, "end": 23.02, "text": "還是"}, {"start": 23.5, "end": 25.66, "text": "以英國公世子的身份"}, {"start": 25.82, "end": 27.18, "text": "他竟看得這般投車"}, {"start": 27.66, "end": 29.18, "text": "英國公府戰隊六皇子"}, {"start": 29.46, "end": 30.94, "text": "而太子如今風頭正盛"}, {"start": 31.18, "end": 32.94, "text": "父親讓我來試探沈庭的口風"}, {"start": 33.18, "end": 34.5, "text": "我原以為能瞞天過海"}, {"start": 34.66, "end": 35.9, "text": "到底還是低估了他"}, {"start": 36.18, "end": 38.18, "text": "那朝堂算起來試探多年好友"}, {"start": 38.58, "end": 39.62, "text": "我真是可笑"}, {"start": 41.18, "end": 42.26, "text": "你哪邊都不站"}, {"start": 42.66, "end": 43.62, "text": "看似兩拳"}, {"start": 44.46, "end": 45.26, "text": "實則"}, {"start": 46.05, "end": 47.25, "text": "兩邊都得罪了"}]}