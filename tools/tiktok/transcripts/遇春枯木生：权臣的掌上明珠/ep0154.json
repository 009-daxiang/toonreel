{"file": "遇春枯木生：权臣的掌上明珠-第154集.mp4", "ep": 154, "duration": 45.5, "segments": [{"start": 0.66, "end": 1.66, "text": "裴公子"}, {"start": 2.83, "end": 3.83, "text": "您这是"}, {"start": 4.36, "end": 6.36, "text": "可是世子那边的腿伤出了什么问题"}, {"start": 6.36, "end": 7.36, "text": "没有没有"}, {"start": 7.36, "end": 8.86, "text": "世子那边无碍"}, {"start": 8.86, "end": 13.3, "text": "世子夫人"}, {"start": 13.3, "end": 16.6, "text": "夫人回娘家了呀"}, {"start": 16.6, "end": 19.86, "text": "回娘家了"}, {"start": 19.86, "end": 21.55, "text": "她何时动身的"}, {"start": 21.55, "end": 23.05, "text": "我得去赔罪"}, {"start": 23.05, "end": 25.62, "text": "裴公子"}, {"start": 25.62, "end": 26.62, "text": "您这是怎么了"}, {"start": 26.62, "end": 28.62, "text": "夫人昨个清早便回去了"}, {"start": 28.62, "end": 30.62, "text": "世子今早已经亲自去接了"}, {"start": 30.62, "end": 33.63, "text": "昨日"}, {"start": 33.63, "end": 36.08, "text": "昨个清早便回去了"}, {"start": 36.08, "end": 38.68, "text": "我问你"}, {"start": 38.68, "end": 40.18, "text": "你家夫人平日里"}, {"start": 40.18, "end": 41.68, "text": "可偏爱月白色的衣裳"}, {"start": 41.68, "end": 42.78, "text": "夫人"}, {"start": 42.78, "end": 45.28, "text": "素来偏爱鲜亮翘皮的颜色"}]}