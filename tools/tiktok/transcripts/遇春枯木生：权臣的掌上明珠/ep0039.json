{"file": "遇春枯木生：权臣的掌上明珠-第39集.mp4", "ep": 39, "duration": 51.9, "segments": [{"start": 1.42, "end": 1.92, "text": "好"}, {"start": 2.5, "end": 3.9, "text": "上輩子這場馬求慧"}, {"start": 4.1, "end": 6.02, "text": "長新侯府有意在太子面前"}, {"start": 6.02, "end": 7.22, "text": "踩著我尚未"}, {"start": 7.42, "end": 8.98, "text": "結果是我拿了頭載"}, {"start": 9.3, "end": 11.26, "text": "最終導致了後來的慘劇"}, {"start": 11.42, "end": 12.3, "text": "重來一世"}, {"start": 12.62, "end": 13.54, "text": "我倒要看看"}, {"start": 13.82, "end": 15.58, "text": "這次死無葬身之地的"}, {"start": 15.78, "end": 16.66, "text": "會是誰"}, {"start": 19.0, "end": 19.84, "text": "看什麼呢"}, {"start": 21.01, "end": 21.65, "text": "我哥呢"}, {"start": 22.56, "end": 24.4, "text": "帶你嫂嫂去馬求慧了"}, {"start": 24.72, "end": 26.44, "text": "長新侯府下的帖子"}, {"start": 26.8, "end": 27.84, "text": "馬求慧"}, {"start": 28.82, "end": 29.74, "text": "他都那樣了"}, {"start": 29.9, "end": 31.18, "text": "還缺什麼馬求慧"}, {"start": 33.7, "end": 35.62, "text": "今日陸少子定能拔得頭巢"}, {"start": 37.94, "end": 39.34, "text": "我兄長今日奪冠"}, {"start": 39.34, "end": 40.78, "text": "是板上叮叮的事"}, {"start": 41.14, "end": 42.38, "text": "畢竟有些人"}, {"start": 42.7, "end": 44.34, "text": "連馬都上不去"}, {"start": 46.59, "end": 47.27, "text": "陸六公子"}, {"start": 47.59, "end": 49.11, "text": "聽說沈世子今日也會來"}, {"start": 49.11, "end": 50.27, "text": "他如今脾氣可不好"}, {"start": 50.27, "end": 51.75, "text": "他如今不過是個廢人"}]}