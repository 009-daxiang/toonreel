{"file": "遇春枯木生：权臣的掌上明珠-第34集.mp4", "ep": 34, "duration": 52.3, "segments": [{"start": 0.0, "end": 0.92, "text": "為什麼扔掉"}, {"start": 1.48, "end": 2.36, "text": "夫人不滿意"}, {"start": 2.96, "end": 4.16, "text": "夫君身強體壯"}, {"start": 4.16, "end": 5.12, "text": "用不上那些"}, {"start": 6.14, "end": 7.02, "text": "我還以為"}, {"start": 7.62, "end": 8.78, "text": "夫人會喜歡呢"}, {"start": 9.96, "end": 11.32, "text": "母親還等著進茶呢"}, {"start": 11.64, "end": 12.28, "text": "快走吧"}, {"start": 18.78, "end": 19.94, "text": "為了不讓我難堪"}, {"start": 20.59, "end": 22.07, "text": "請走的這般小心"}, {"start": 23.9, "end": 25.06, "text": "不過一個商戶女"}, {"start": 25.46, "end": 26.46, "text": "進門第一日"}, {"start": 26.46, "end": 27.54, "text": "竟然讓我們二房三房"}, {"start": 27.54, "end": 28.46, "text": "不必去進茶"}, {"start": 28.66, "end": 29.1, "text": "咔"}, {"start": 30.3, "end": 31.9, "text": "人家可是世子夫人"}, {"start": 32.02, "end": 33.1, "text": "金貴的狠"}, {"start": 33.54, "end": 33.94, "text": "走"}, {"start": 41.5, "end": 42.26, "text": "給父親"}, {"start": 42.5, "end": 43.34, "text": "母親請安"}, {"start": 46.87, "end": 47.43, "text": "父親"}, {"start": 47.59, "end": 48.19, "text": "母親"}, {"start": 48.51, "end": 49.23, "text": "起來吧"}, {"start": 49.71, "end": 50.47, "text": "是平靈猴"}, {"start": 50.47, "end": 51.31, "text": "怎麼這麼不帶見"}, {"start": 51.31, "end": 52.23, "text": "自己的親兒子"}]}