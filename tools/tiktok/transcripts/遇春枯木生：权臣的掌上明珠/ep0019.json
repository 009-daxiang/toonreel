{"file": "遇春枯木生：权臣的掌上明珠-第19集.mp4", "ep": 19, "duration": 55.9, "segments": [{"start": 0.0, "end": 2.0, "text": "那些木作行看您不用輪椅"}, {"start": 2.0, "end": 3.5, "text": "竟全又廢料糊弄"}, {"start": 3.5, "end": 5.2, "text": "甚至把您砸壞的撿回去"}, {"start": 5.2, "end": 6.3, "text": "翻新再賣"}, {"start": 6.3, "end": 7.8, "text": "這群喪盡天良的貂民"}, {"start": 7.8, "end": 9.5, "text": "竟敢如此折辱世子爺"}, {"start": 9.8, "end": 12.24, "text": "既然他們這麼喜歡糊弄"}, {"start": 12.73, "end": 13.93, "text": "那這買賣"}, {"start": 14.23, "end": 15.43, "text": "便不用做了"}, {"start": 15.43, "end": 18.05, "text": "世子的意思是"}, {"start": 18.05, "end": 19.55, "text": "查超他們的賬本"}, {"start": 19.75, "end": 21.82, "text": "看看有沒有偷稅漏稅的勾當"}, {"start": 21.82, "end": 22.42, "text": "若有"}, {"start": 22.42, "end": 23.82, "text": "直接送交經照也"}, {"start": 23.82, "end": 24.62, "text": "若沒有"}, {"start": 24.62, "end": 26.12, "text": "便讓他們在長安城"}, {"start": 26.12, "end": 28.02, "text": "永遠進不到一寸好幕僚"}, {"start": 28.02, "end": 29.02, "text": "屬下明白"}, {"start": 29.22, "end": 36.25, "text": "小姐"}, {"start": 36.25, "end": 37.45, "text": "是沈世子的信"}, {"start": 49.88, "end": 50.78, "text": "奴婢去秀公"}, {"start": 50.78, "end": 52.96, "text": "什麼都沒看"}, {"start": 52.96, "end": 53.76, "text": "阿玉"}]}