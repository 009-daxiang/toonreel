{"file": "遇春枯木生：权臣的掌上明珠-第127集.mp4", "ep": 127, "duration": 54.6, "segments": [{"start": 0.37, "end": 1.77, "text": "多谢附近"}, {"start": 1.77, "end": 6.3, "text": "谁都不敢接"}, {"start": 6.3, "end": 8.18, "text": "是世子爷替计家周旋的"}, {"start": 8.18, "end": 9.42, "text": "我自然记得"}, {"start": 9.42, "end": 11.82, "text": "当年计家曹韵被地方管理刁难"}, {"start": 11.82, "end": 13.54, "text": "长辈四处奔走无门"}, {"start": 13.54, "end": 15.02, "text": "只得求助于表哥"}, {"start": 15.02, "end": 16.38, "text": "比时表哥出入公部"}, {"start": 16.38, "end": 17.34, "text": "却不去权贵"}, {"start": 17.34, "end": 18.42, "text": "亲自彻查卷宗"}, {"start": 18.42, "end": 20.34, "text": "不过三日便替计家解了困局"}, {"start": 20.34, "end": 22.22, "text": "世人皆言君子润如玉"}, {"start": 22.22, "end": 23.58, "text": "风骨藏山河"}, {"start": 23.58, "end": 25.14, "text": "大底便是二哥这样"}, {"start": 25.14, "end": 26.26, "text": "磊落公正"}, {"start": 26.26, "end": 27.3, "text": "行事有度"}, {"start": 27.3, "end": 28.46, "text": "连陛下的说过"}, {"start": 28.46, "end": 31.06, "text": "二哥是当真难得的无双人物"}, {"start": 31.06, "end": 32.94, "text": "他们口中的神言"}, {"start": 33.46, "end": 43.35, "text": "是我从来没见过的"}, {"start": 43.35, "end": 43.99, "text": "是"}, {"start": 43.99, "end": 45.98, "text": "如何"}, {"start": 46.5, "end": 47.42, "text": "回世子"}, {"start": 47.42, "end": 48.66, "text": "您先前嘱咐的话"}, {"start": 48.66, "end": 50.58, "text": "属下已然尽数转达宋公子"}, {"start": 50.58, "end": 51.78, "text": "宋公子表示"}, {"start": 51.78, "end": 53.38, "text": "只暗中收拢侍警留言"}, {"start": 53.38, "end": 54.58, "text": "绝不贸然出手"}]}