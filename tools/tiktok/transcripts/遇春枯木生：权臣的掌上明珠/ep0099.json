{"file": "遇春枯木生：权臣的掌上明珠-第99集.mp4", "ep": 99, "duration": 47.9, "segments": [{"start": 0.85, "end": 1.85, "text": "恭喜嫂嫂"}, {"start": 2.35, "end": 3.85, "text": "还没坐稳三个月"}, {"start": 3.85, "end": 4.85, "text": "不好生肠"}, {"start": 10.17, "end": 10.67, "text": "徐之啊"}, {"start": 11.17, "end": 12.17, "text": "昨日的事"}, {"start": 12.17, "end": 13.67, "text": "我替清言跟你陪个博士"}, {"start": 14.17, "end": 15.17, "text": "这孩子心性浅薄"}, {"start": 15.17, "end": 16.17, "text": "行事莽撞"}, {"start": 16.17, "end": 17.17, "text": "你多担待"}, {"start": 17.17, "end": 18.17, "text": "二叔言重"}, {"start": 18.17, "end": 19.17, "text": "我已经让人"}, {"start": 19.17, "end": 20.67, "text": "把她送到了官家女院"}, {"start": 21.17, "end": 22.67, "text": "官 官家女院"}, {"start": 23.62, "end": 24.62, "text": "我原以为最坏不过"}, {"start": 24.62, "end": 25.62, "text": "前送回河甲"}, {"start": 25.62, "end": 27.12, "text": "两边翻可周旋陪罪"}, {"start": 27.12, "end": 27.62, "text": "这只"}, {"start": 28.12, "end": 29.62, "text": "徐之竞直接将人送进了"}, {"start": 29.62, "end": 31.62, "text": "幽情反复那种地方"}, {"start": 31.62, "end": 33.62, "text": "半点商量的余地都不留"}, {"start": 33.62, "end": 34.62, "text": "往后我该如何"}, {"start": 34.62, "end": 35.62, "text": "向河甲回话"}, {"start": 36.12, "end": 36.62, "text": "二弟"}, {"start": 37.24, "end": 38.24, "text": "这未免她"}, {"start": 38.24, "end": 39.24, "text": "她又没做什么"}, {"start": 39.24, "end": 40.24, "text": "伤天害理的事"}, {"start": 40.24, "end": 41.24, "text": "何至于此"}, {"start": 41.24, "end": 43.29, "text": "大哥若是联系"}, {"start": 43.79, "end": 45.29, "text": "大可将她收在身边"}, {"start": 45.79, "end": 46.79, "text": "那为妾侍"}, {"start": 46.79, "end": 47.79, "text": "你"}]}