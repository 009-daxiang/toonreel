{"file": "遇春枯木生：权臣的掌上明珠-第62集.mp4", "ep": 62, "duration": 51.1, "segments": [{"start": 3.44, "end": 4.52, "text": "是藥膏"}, {"start": 4.92, "end": 6.2, "text": "他在給我上藥"}, {"start": 6.44, "end": 8.88, "text": "起碼磨破皮的地方位置那麼隱密"}, {"start": 9.2, "end": 10.56, "text": "我又不好意思說"}, {"start": 10.88, "end": 12.4, "text": "他竟然看在了眼裡"}, {"start": 12.93, "end": 14.37, "text": "還親自給我塗"}, {"start": 15.96, "end": 16.6, "text": "疼嗎"}, {"start": 20.44, "end": 21.56, "text": "有什麼想知道的"}, {"start": 21.72, "end": 22.52, "text": "我同意講"}, {"start": 23.12, "end": 23.6, "text": "講"}, {"start": 23.92, "end": 24.76, "text": "講什麼"}, {"start": 26.94, "end": 27.9, "text": "侯府的人"}, {"start": 27.98, "end": 29.06, "text": "二方孩子多"}, {"start": 29.26, "end": 30.46, "text": "離出宿宿加在一起"}, {"start": 30.46, "end": 31.62, "text": "新婚第一日"}, {"start": 31.78, "end": 32.9, "text": "我曾對他說"}, {"start": 32.9, "end": 33.98, "text": "任我一個酒茶"}, {"start": 34.5, "end": 35.7, "text": "因為我覺得沒必要"}, {"start": 35.7, "end": 37.38, "text": "帶他融入這個冰冷的家"}, {"start": 37.7, "end": 38.54, "text": "但現在"}, {"start": 39.18, "end": 40.7, "text": "他那麼努力地想融入"}, {"start": 40.86, "end": 42.02, "text": "想不給我丟臉"}, {"start": 42.42, "end": 43.86, "text": "我總不能袖手旁觀"}, {"start": 43.98, "end": 45.34, "text": "切實納了兩三個"}, {"start": 45.58, "end": 46.94, "text": "至今卻息下無辭"}]}