{"file": "遇春枯木生：权臣的掌上明珠-第42集.mp4", "ep": 42, "duration": 51.8, "segments": [{"start": 0.5, "end": 1.38, "text": "都坐下"}, {"start": 2.1, "end": 3.9, "text": "姑今日只是来凑热闹"}, {"start": 3.9, "end": 4.9, "text": "不必拘礼"}, {"start": 4.9, "end": 6.63, "text": "这沈世子"}, {"start": 6.63, "end": 8.07, "text": "胆子也推大了些"}, {"start": 8.07, "end": 9.19, "text": "奇数不错"}, {"start": 9.19, "end": 11.07, "text": "长星侯教子有方"}, {"start": 11.07, "end": 12.75, "text": "蓄之也不必去内"}, {"start": 12.75, "end": 14.03, "text": "养好身子要紧"}, {"start": 14.03, "end": 15.23, "text": "来日方长"}, {"start": 15.23, "end": 17.74, "text": "世子"}, {"start": 17.74, "end": 19.3, "text": "陆云亮买了狂躁药粉"}, {"start": 19.3, "end": 21.02, "text": "要下在蒋公子的马槽里"}, {"start": 21.02, "end": 22.5, "text": "去帮他一把"}, {"start": 22.5, "end": 25.62, "text": "把药换到他亲哥陆云征的马槽里"}, {"start": 25.62, "end": 26.9, "text": "陆世子的马姓列"}, {"start": 26.9, "end": 28.42, "text": "若罚狂冲撞了太子"}, {"start": 28.42, "end": 30.42, "text": "要的就是冲撞"}, {"start": 30.42, "end": 32.25, "text": "陆家想出风头"}, {"start": 32.57, "end": 33.57, "text": "不便成全他"}, {"start": 33.57, "end": 34.82, "text": "去办"}, {"start": 34.82, "end": 36.3, "text": "守着干净些"}, {"start": 36.3, "end": 37.3, "text": "是"}, {"start": 37.3, "end": 47.26, "text": "挺得住啊"}, {"start": 47.26, "end": 49.19, "text": "你别担心"}, {"start": 49.19, "end": 50.79, "text": "我打马球还挺厉害的"}, {"start": 50.79, "end": 51.59, "text": "我上场啦"}]}