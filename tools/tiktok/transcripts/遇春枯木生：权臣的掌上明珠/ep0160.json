{"file": "遇春枯木生：权臣的掌上明珠-第160集.mp4", "ep": 160, "duration": 46.9, "segments": [{"start": 0.78, "end": 1.74, "text": "回世子"}, {"start": 2.38, "end": 4.18, "text": "今日裴公子来了"}, {"start": 5.22, "end": 6.02, "text": "他来合适"}, {"start": 6.42, "end": 7.66, "text": "今日便不需要试诊"}, {"start": 7.66, "end": 8.5, "text": "裴公子他"}, {"start": 8.66, "end": 9.86, "text": "他好像很关心夫人"}, {"start": 10.18, "end": 11.02, "text": "先是在院门口"}, {"start": 11.02, "end": 12.3, "text": "逗留许久未曾离去"}, {"start": 12.54, "end": 13.94, "text": "后又问夫人再不在院中"}, {"start": 14.5, "end": 15.7, "text": "还特意问起"}, {"start": 15.9, "end": 16.74, "text": "夫人平素偏爱"}, {"start": 16.74, "end": 17.78, "text": "什么颜色的衣料"}, {"start": 19.65, "end": 21.69, "text": "解决了内忧还有外患"}, {"start": 22.4, "end": 23.96, "text": "竟敢寄于我的人"}, {"start": 29.14, "end": 29.58, "text": "是"}, {"start": 33.26, "end": 33.98, "text": "完了完了"}, {"start": 34.42, "end": 35.22, "text": "裴公子如今"}, {"start": 35.22, "end": 36.46, "text": "还在给世子治腿"}, {"start": 36.74, "end": 38.02, "text": "世子要圣怒之下"}, {"start": 38.02, "end": 39.38, "text": "施了分寸将人杀了"}, {"start": 39.66, "end": 40.82, "text": "那腿还怎么治啊"}, {"start": 43.65, "end": 45.01, "text": "裴子萧啊 裴子萧"}, {"start": 45.21, "end": 46.81, "text": "你可真是欲速凌风"}]}