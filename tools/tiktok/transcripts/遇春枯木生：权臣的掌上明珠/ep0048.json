{"file": "遇春枯木生：权臣的掌上明珠-第48集.mp4", "ep": 48, "duration": 47.9, "segments": [{"start": 0.11, "end": 1.39, "text": "跟我兄长没关系"}, {"start": 1.83, "end": 2.83, "text": "要是我吓的"}, {"start": 3.07, "end": 4.19, "text": "主意是我出的"}, {"start": 4.43, "end": 5.55, "text": "他什么都不知道"}, {"start": 5.75, "end": 6.95, "text": "一人做事一人当"}, {"start": 7.27, "end": 8.43, "text": "要罚就罚我"}, {"start": 10.04, "end": 11.72, "text": "陆云郎蓄意下药"}, {"start": 11.92, "end": 13.16, "text": "用心险恶"}, {"start": 14.01, "end": 14.93, "text": "仗三十"}, {"start": 15.21, "end": 16.21, "text": "禁足半年"}, {"start": 16.41, "end": 17.77, "text": "陆云珍管教不言"}, {"start": 17.97, "end": 18.85, "text": "罚奉半年"}, {"start": 19.37, "end": 20.08, "text": "脱下去"}, {"start": 20.64, "end": 25.51, "text": "今日是"}, {"start": 25.95, "end": 27.15, "text": "改日登门赔罪"}, {"start": 27.55, "end": 28.71, "text": "要是我闯了祸"}, {"start": 28.95, "end": 30.11, "text": "我哥肯定不会提我爹"}, {"start": 30.31, "end": 31.91, "text": "说不准还会觉得罚得轻了"}, {"start": 32.15, "end": 33.07, "text": "再补上计较"}, {"start": 33.27, "end": 34.23, "text": "你羡慕陆云郎"}, {"start": 34.47, "end": 35.35, "text": "我才没有"}, {"start": 35.67, "end": 36.43, "text": "那个蠢货"}, {"start": 37.28, "end": 38.36, "text": "我只是觉得"}, {"start": 39.29, "end": 40.85, "text": "陆云珍对他弟弟还挺好的"}, {"start": 41.54, "end": 42.66, "text": "你不会没看出来"}, {"start": 43.02, "end": 44.58, "text": "陆云珍是故意那样说的吧"}, {"start": 44.78, "end": 45.34, "text": "什么"}, {"start": 45.62, "end": 46.62, "text": "他要是想害他弟弟"}, {"start": 46.62, "end": 47.9, "text": "干吗还要替他求情"}]}