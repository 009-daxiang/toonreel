{"file": "逆江湖之苍生为局-第218集.mp4", "ep": 218, "duration": 51.9, "segments": [{"start": 0.0, "end": 1.36, "text": "躺过无数条河"}, {"start": 2.06, "end": 2.7, "text": "最后"}, {"start": 3.18, "end": 5.02, "text": "去了一处与世隔绝的地方"}, {"start": 5.46, "end": 6.06, "text": "后来"}, {"start": 6.5, "end": 8.34, "text": "父亲每天都会去隔壁院子里"}, {"start": 8.34, "end": 9.3, "text": "教一个孩子"}, {"start": 9.42, "end": 11.74, "text": "他宁死也不愿放手的崩天神觉"}, {"start": 12.02, "end": 12.62, "text": "姐姐"}, {"start": 13.06, "end": 14.14, "text": "你叫什么名字啊"}, {"start": 14.38, "end": 15.26, "text": "神觉月月"}, {"start": 15.42, "end": 15.86, "text": "你呢"}, {"start": 16.7, "end": 17.62, "text": "顾苍生"}, {"start": 18.1, "end": 20.3, "text": "修炼崩天神觉需要用雷电"}, {"start": 20.38, "end": 22.86, "text": "将经脉全部摧毁烧断在玉河"}, {"start": 23.3, "end": 24.1, "text": "他每天"}, {"start": 24.62, "end": 26.54, "text": "都忍受着难以想象的痛苦"}, {"start": 27.22, "end": 27.86, "text": "疼吗"}, {"start": 28.3, "end": 28.82, "text": "疼"}, {"start": 29.06, "end": 30.24, "text": "每天都疼"}, {"start": 30.24, "end": 32.42, "text": "那我是方氏"}, {"start": 32.78, "end": 34.74, "text": "能治好自己"}, {"start": 34.98, "end": 36.26, "text": "为什么要这么累着自己"}, {"start": 36.58, "end": 37.78, "text": "因为我要活下去"}, {"start": 38.64, "end": 39.92, "text": "因为我要报仇"}, {"start": 40.24, "end": 40.92, "text": "后来"}, {"start": 41.28, "end": 42.96, "text": "我被托付到牡丹堂"}, {"start": 43.98, "end": 46.02, "text": "就再也没听见过那人的声音"}, {"start": 46.92, "end": 47.64, "text": "直到"}, {"start": 48.3, "end": 49.74, "text": "终于见到你了"}, {"start": 50.38, "end": 51.62, "text": "让你不老实"}]}