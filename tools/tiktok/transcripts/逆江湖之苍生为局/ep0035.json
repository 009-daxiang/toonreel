{"file": "逆江湖之苍生为局-第35集.mp4", "ep": 35, "duration": 76.9, "segments": [{"start": 0.0, "end": 0.5, "text": "能"}, {"start": 1.21, "end": 2.17, "text": "只要能救念念"}, {"start": 2.45, "end": 3.57, "text": "没什么是我做不到的"}, {"start": 3.85, "end": 4.37, "text": "好"}, {"start": 4.77, "end": 5.81, "text": "哥 就他了"}, {"start": 5.81, "end": 6.69, "text": "行倒是行"}, {"start": 7.13, "end": 8.09, "text": "但你那些兄弟姐妹"}, {"start": 8.09, "end": 9.09, "text": "哪个是省油的灯"}, {"start": 9.25, "end": 10.41, "text": "这小子又惹了宋家"}, {"start": 10.69, "end": 12.37, "text": "尽管明面上有黑龙令压着"}, {"start": 12.57, "end": 13.33, "text": "但暗地里呢"}, {"start": 13.41, "end": 14.05, "text": "你选他"}, {"start": 14.05, "end": 15.25, "text": "是给自己找麻烦啊"}, {"start": 15.37, "end": 15.97, "text": "我知道"}, {"start": 16.45, "end": 17.81, "text": "可现在也没其他办法"}, {"start": 18.5, "end": 19.3, "text": "如果没他"}, {"start": 19.62, "end": 20.26, "text": "恐怕明天"}, {"start": 20.26, "end": 21.46, "text": "我都无法走出这座城"}, {"start": 22.09, "end": 23.45, "text": "反正宋家该拉拢的"}, {"start": 23.69, "end": 24.53, "text": "已经被他们拉拢的"}, {"start": 24.53, "end": 25.21, "text": "差不多了"}, {"start": 25.21, "end": 26.45, "text": "就算没有这桩仇"}, {"start": 26.45, "end": 27.49, "text": "该来的都会来"}, {"start": 27.65, "end": 28.53, "text": "反倒有他在"}, {"start": 28.53, "end": 29.33, "text": "敌我分明"}, {"start": 29.57, "end": 31.25, "text": "铭枪总好过案件"}, {"start": 31.53, "end": 32.53, "text": "可小尖家"}, {"start": 32.89, "end": 34.53, "text": "你能想得住这小子吗"}, {"start": 35.37, "end": 37.13, "text": "以前可不是没发生过"}, {"start": 37.13, "end": 39.13, "text": "护卫杀害公子小姐的事"}, {"start": 43.8, "end": 44.8, "text": "这并非祥福"}, {"start": 44.96, "end": 45.96, "text": "这是一场交易"}, {"start": 46.52, "end": 48.16, "text": "一个能那样护着妹妹的人"}, {"start": 48.44, "end": 49.16, "text": "我信得过"}, {"start": 49.16, "end": 50.4, "text": "如若真的看错了人"}, {"start": 50.8, "end": 52.24, "text": "那也是我自己的本事不计"}, {"start": 52.52, "end": 53.28, "text": "怪不得他人"}, {"start": 53.6, "end": 54.56, "text": "死在他手里"}, {"start": 55.08, "end": 56.88, "text": "总好过死在兄弟姐妹的手中"}, {"start": 59.5, "end": 60.18, "text": "顾十一"}, {"start": 60.34, "end": 61.3, "text": "从今天开始"}, {"start": 61.66, "end": 62.98, "text": "你就是尖家的护卫"}, {"start": 63.26, "end": 64.18, "text": "负责保护他"}, {"start": 64.58, "end": 65.54, "text": "期限一年"}, {"start": 65.9, "end": 66.62, "text": "那孽孽呢"}, {"start": 70.4, "end": 71.4, "text": "每逢朔日"}, {"start": 71.8, "end": 72.76, "text": "头疼欲烈"}, {"start": 73.08, "end": 74.08, "text": "呼冷呼热"}, {"start": 74.36, "end": 75.4, "text": "生不如死"}, {"start": 75.68, "end": 76.44, "text": "你怎么知道"}]}