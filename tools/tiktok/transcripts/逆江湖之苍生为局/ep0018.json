{"file": "逆江湖之苍生为局-第18集.mp4", "ep": 18, "duration": 90.3, "segments": [{"start": 4.11, "end": 5.11, "text": "燕烈军"}, {"start": 5.11, "end": 6.71, "text": "果然是朕玉军"}, {"start": 7.71, "end": 8.91, "text": "他们怎么在这里"}, {"start": 8.91, "end": 9.71, "text": "妮妮"}, {"start": 9.71, "end": 10.31, "text": "逃"}, {"start": 11.46, "end": 12.26, "text": "快走"}, {"start": 12.66, "end": 15.41, "text": "抓住她"}, {"start": 15.41, "end": 16.81, "text": "她是死人同党"}, {"start": 16.81, "end": 18.01, "text": "不能放她离开"}, {"start": 23.31, "end": 24.31, "text": "姓徐的"}, {"start": 24.31, "end": 25.31, "text": "你再乱喊"}, {"start": 25.31, "end": 27.11, "text": "天王老子也救不了你"}, {"start": 28.31, "end": 32.38, "text": "小子"}, {"start": 32.38, "end": 33.78, "text": "放开小姐"}, {"start": 33.78, "end": 34.78, "text": "否则老夫"}, {"start": 34.78, "end": 36.58, "text": "定让你死无全尸"}, {"start": 37.58, "end": 43.06, "text": "贱家"}, {"start": 43.06, "end": 44.26, "text": "你怎么在这儿"}, {"start": 44.26, "end": 45.66, "text": "还让人给抓起来了"}, {"start": 46.19, "end": 46.99, "text": "小子"}, {"start": 46.99, "end": 48.19, "text": "松松手"}, {"start": 48.39, "end": 50.09, "text": "别一会儿给掐死了"}, {"start": 52.32, "end": 57.4, "text": "哪个是"}, {"start": 57.4, "end": 58.4, "text": "许文"}, {"start": 61.01, "end": 62.21, "text": "我就是许文"}, {"start": 62.21, "end": 63.01, "text": "赶工公子"}, {"start": 63.01, "end": 64.01, "text": "是宋师弟何人"}, {"start": 64.01, "end": 65.41, "text": "我是宋家二公子"}, {"start": 65.41, "end": 66.41, "text": "宋开明"}, {"start": 66.41, "end": 67.81, "text": "是你传信宋家的"}, {"start": 67.81, "end": 68.41, "text": "对"}, {"start": 68.41, "end": 69.41, "text": "是我"}, {"start": 69.41, "end": 70.41, "text": "六年前"}, {"start": 70.41, "end": 72.01, "text": "宋开明以六品巅峰"}, {"start": 72.01, "end": 73.81, "text": "夺得十大五师弟三"}, {"start": 73.81, "end": 75.21, "text": "如今六年过去"}, {"start": 75.21, "end": 77.41, "text": "谁也不知他到了何种境界"}, {"start": 77.41, "end": 79.01, "text": "你绝非他的对手"}, {"start": 79.01, "end": 80.41, "text": "不如放开我"}, {"start": 80.41, "end": 81.81, "text": "我可以替你做证"}, {"start": 81.81, "end": 83.61, "text": "是宋宣先动的时候"}, {"start": 83.61, "end": 84.21, "text": "这样"}, {"start": 84.21, "end": 84.81, "text": "二公子"}, {"start": 85.01, "end": 86.61, "text": "就是他杀了宋宣师弟"}, {"start": 86.61, "end": 87.61, "text": "自杀吧"}, {"start": 88.01, "end": 89.21, "text": "我允许你留下一个"}, {"start": 89.21, "end": 90.21, "text": "体面的失手"}]}