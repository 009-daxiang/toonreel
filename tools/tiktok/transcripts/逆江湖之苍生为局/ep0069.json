{"file": "逆江湖之苍生为局-第69集.mp4", "ep": 69, "duration": 99.7, "segments": [{"start": 0.0, "end": 0.88, "text": "有点不对劲"}, {"start": 1.2, "end": 2.24, "text": "希望陆家的名头"}, {"start": 2.24, "end": 3.04, "text": "能下退他"}, {"start": 3.2, "end": 3.76, "text": "正是"}, {"start": 4.08, "end": 4.64, "text": "前辈"}, {"start": 4.92, "end": 6.44, "text": "此间之事都是误会"}, {"start": 6.6, "end": 7.48, "text": "我愿意赔偿"}, {"start": 7.72, "end": 9.04, "text": "还望前辈高抬贵手"}, {"start": 10.26, "end": 10.82, "text": "温子梁"}, {"start": 10.82, "end": 12.1, "text": "是庆祝学府的学子"}, {"start": 12.3, "end": 13.54, "text": "老师是上等方式"}, {"start": 13.82, "end": 14.98, "text": "能不动干戈最好"}, {"start": 15.14, "end": 16.3, "text": "只怕你这身份"}, {"start": 16.66, "end": 17.98, "text": "不仅不会让他放手"}, {"start": 18.5, "end": 19.54, "text": "还会下死手"}, {"start": 25.22, "end": 26.02, "text": "这样啊"}, {"start": 26.96, "end": 28.08, "text": "我也想放你们"}, {"start": 28.08, "end": 33.29, "text": "可你们"}, {"start": 33.69, "end": 35.81, "text": "毁了我救命的梁耀"}, {"start": 36.13, "end": 62.16, "text": "终究还是吃了"}, {"start": 62.16, "end": 63.56, "text": "没有好兵器的亏"}, {"start": 63.88, "end": 70.83, "text": "区区七平五尸而已"}, {"start": 71.27, "end": 72.15, "text": "有魂马"}, {"start": 72.51, "end": 73.39, "text": "给我踏"}]}