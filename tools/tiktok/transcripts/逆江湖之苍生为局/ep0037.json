{"file": "逆江湖之苍生为局-第37集.mp4", "ep": 37, "duration": 96.4, "segments": [{"start": 0.0, "end": 1.16, "text": "这老玉有问题"}, {"start": 1.16, "end": 3.15, "text": "但应该不会害妮妮"}, {"start": 3.15, "end": 3.75, "text": "没有"}, {"start": 4.15, "end": 5.07, "text": "有我在"}, {"start": 5.35, "end": 7.55, "text": "保着丫头一年内无恙"}, {"start": 7.91, "end": 9.75, "text": "一年后你护送完奸家"}, {"start": 9.95, "end": 10.79, "text": "来北玉"}, {"start": 10.99, "end": 11.99, "text": "我让你见她"}, {"start": 12.19, "end": 13.15, "text": "好好历练"}, {"start": 13.31, "end": 14.23, "text": "说不准明年"}, {"start": 14.23, "end": 15.63, "text": "你就能把我们全杀了"}, {"start": 15.75, "end": 17.43, "text": "到时候再也没人能拦你"}, {"start": 20.2, "end": 21.52, "text": "让他们好好告个别"}, {"start": 24.6, "end": 25.24, "text": "妮妮"}, {"start": 25.6, "end": 26.28, "text": "对不起"}, {"start": 26.89, "end": 28.01, "text": "我保护不了你"}, {"start": 29.2, "end": 29.84, "text": "不过"}, {"start": 30.27, "end": 31.59, "text": "他们能治你的病"}, {"start": 31.83, "end": 32.51, "text": "以后"}, {"start": 32.95, "end": 34.31, "text": "妮妮就不用那么疼了"}, {"start": 34.51, "end": 37.08, "text": "不割心她"}, {"start": 37.2, "end": 38.12, "text": "我就信她"}, {"start": 38.4, "end": 39.32, "text": "一年很快的"}, {"start": 39.32, "end": 41.37, "text": "比他们都强"}, {"start": 41.61, "end": 42.77, "text": "要是到时候见不到你"}, {"start": 42.93, "end": 44.13, "text": "我就把他们全杀了"}, {"start": 45.05, "end": 46.09, "text": "要是他们欺负你"}, {"start": 46.09, "end": 47.37, "text": "你就暂时忍着"}, {"start": 47.37, "end": 48.66, "text": "偷偷记下来"}, {"start": 48.94, "end": 49.98, "text": "等见面再告诉我"}, {"start": 50.1, "end": 51.86, "text": "欺负你我就杀谁"}, {"start": 53.54, "end": 54.5, "text": "谷哥"}, {"start": 55.02, "end": 56.62, "text": "屋里还有一罐烟萝卜"}, {"start": 56.94, "end": 57.94, "text": "你记得戴上"}, {"start": 58.38, "end": 59.38, "text": "等后面你来北玉"}, {"start": 59.38, "end": 60.3, "text": "我再给你做"}, {"start": 65.53, "end": 66.37, "text": "好了"}, {"start": 66.77, "end": 68.21, "text": "这又不是生离死别"}]}