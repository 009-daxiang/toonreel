{"file": "逆江湖之苍生为局-第92集.mp4", "ep": 92, "duration": 95.6, "segments": [{"start": 0.0, "end": 1.56, "text": "漏水了 漏水了"}, {"start": 1.56, "end": 5.36, "text": "家主與刺不所全場"}, {"start": 5.36, "end": 7.32, "text": "小姐呢 小姐不見了"}, {"start": 7.32, "end": 9.72, "text": "小少爺也丟了 快找小少爺"}, {"start": 10.72, "end": 11.84, "text": "殺了他們"}, {"start": 15.56, "end": 16.64, "text": "是金服鋒的人"}, {"start": 17.32, "end": 39.87, "text": "你可別讓我久等"}, {"start": 39.87, "end": 44.91, "text": "出大事了"}, {"start": 44.91, "end": 45.99, "text": "我們得出去看看"}, {"start": 45.99, "end": 70.7, "text": "這是神箭手孟非凡的絕技"}, {"start": 70.7, "end": 72.34, "text": "在那邊 我去對付他"}, {"start": 72.34, "end": 75.54, "text": "龍歸護體"}, {"start": 75.54, "end": 76.34, "text": "三丑"}, {"start": 76.94, "end": 78.79, "text": "他射出的箭會拐彎"}, {"start": 78.79, "end": 84.61, "text": "找到你了"}, {"start": 84.61, "end": 86.06, "text": "奉天神絕"}, {"start": 86.06, "end": 86.46, "text": "就"}]}