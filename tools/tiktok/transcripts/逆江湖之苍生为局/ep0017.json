{"file": "逆江湖之苍生为局-第17集.mp4", "ep": 17, "duration": 53.9, "segments": [{"start": 3.28, "end": 4.8, "text": "怎 怎么可能"}, {"start": 5.08, "end": 6.4, "text": "身把铁鞋踢碎了"}, {"start": 6.64, "end": 7.6, "text": "小子住手"}, {"start": 7.72, "end": 9.44, "text": "你已经杀了一个梅长宫的人"}, {"start": 9.56, "end": 10.24, "text": "再杀一个"}, {"start": 10.36, "end": 11.76, "text": "天王老子也保不住你"}, {"start": 12.04, "end": 14.5, "text": "立若千军"}, {"start": 14.66, "end": 15.7, "text": "真气元流"}, {"start": 15.86, "end": 16.5, "text": "小子"}, {"start": 17.46, "end": 18.58, "text": "你是六品武士"}, {"start": 18.7, "end": 19.9, "text": "六 六品"}, {"start": 20.1, "end": 20.9, "text": "怎么可能"}, {"start": 21.1, "end": 22.58, "text": "杨爷爷您弄错了吧"}, {"start": 22.7, "end": 23.5, "text": "六品"}, {"start": 23.82, "end": 24.42, "text": "不是吧"}, {"start": 24.54, "end": 25.58, "text": "这小子才多大"}, {"start": 25.7, "end": 27.06, "text": "时尊武圣听说过吧"}, {"start": 27.38, "end": 28.3, "text": "去年大夏王朝"}, {"start": 28.42, "end": 29.74, "text": "选出来的十个最强天交"}, {"start": 29.98, "end": 30.78, "text": "全是六品"}, {"start": 31.2, "end": 32.64, "text": "这小子也是一个级别的"}, {"start": 39.4, "end": 40.44, "text": "真气元流"}, {"start": 40.72, "end": 41.76, "text": "立若千军"}, {"start": 42.08, "end": 43.08, "text": "不但是六品"}, {"start": 43.2, "end": 44.92, "text": "而且很可能已到天荒"}, {"start": 45.36, "end": 46.04, "text": "有意思"}, {"start": 46.16, "end": 46.56, "text": "不好"}, {"start": 46.68, "end": 47.4, "text": "得赶紧撤"}]}