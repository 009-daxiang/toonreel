{"file": "逆江湖之苍生为局-第25集.mp4", "ep": 25, "duration": 59.4, "segments": [{"start": 0.3, "end": 1.02, "text": "难道"}, {"start": 1.62, "end": 3.34, "text": "刚才那小子用的"}, {"start": 3.9, "end": 5.62, "text": "就是崩天神觉"}, {"start": 5.86, "end": 6.7, "text": "我叫林林"}, {"start": 6.94, "end": 7.62, "text": "六年前"}, {"start": 7.86, "end": 8.86, "text": "我亲眼看到"}, {"start": 9.26, "end": 10.7, "text": "神觉卓异崩天神觉"}, {"start": 10.7, "end": 11.66, "text": "打死我的师父"}, {"start": 11.66, "end": 13.18, "text": "所以我绝不会看错"}, {"start": 13.18, "end": 14.58, "text": "你刚才施展的拳法"}, {"start": 14.58, "end": 16.02, "text": "正是崩天神觉"}, {"start": 18.1, "end": 19.18, "text": "这么说来"}, {"start": 19.42, "end": 21.66, "text": "这小子是那恶人的徒弟"}, {"start": 21.9, "end": 23.34, "text": "不是徒弟就是儿子"}, {"start": 23.66, "end": 24.58, "text": "这等神功"}, {"start": 24.58, "end": 25.86, "text": "谁会传给外人"}, {"start": 27.58, "end": 34.5, "text": "我自小被师父收养"}, {"start": 34.82, "end": 38.2, "text": "师父带我恩助如山"}, {"start": 39.46, "end": 41.66, "text": "我发誓一定要替师父报仇"}, {"start": 42.02, "end": 42.98, "text": "三年前"}, {"start": 43.46, "end": 45.02, "text": "我参加施军武圣评选"}, {"start": 45.02, "end": 46.42, "text": "一次次击败对手"}, {"start": 46.42, "end": 48.18, "text": "可赢着赢着我忽然明白"}, {"start": 48.87, "end": 50.43, "text": "就算把那些温室里的花朵"}, {"start": 50.43, "end": 51.55, "text": "全踩在脚下"}, {"start": 51.67, "end": 53.87, "text": "我也绝不是神觉卓的对手"}, {"start": 54.3, "end": 54.94, "text": "所以"}, {"start": 55.56, "end": 57.52, "text": "我去了大廈最凶险的地方"}, {"start": 57.94, "end": 58.7, "text": "北越"}]}