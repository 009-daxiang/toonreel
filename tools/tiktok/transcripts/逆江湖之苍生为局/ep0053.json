{"file": "逆江湖之苍生为局-第53集.mp4", "ep": 53, "duration": 58.7, "segments": [{"start": 1.3, "end": 3.3, "text": "竟然逼得王妮盗心破碎"}, {"start": 3.62, "end": 5.46, "text": "我要退吗"}, {"start": 6.78, "end": 7.66, "text": "他奶奶的"}, {"start": 7.82, "end": 8.86, "text": "今天在这里退了"}, {"start": 8.98, "end": 10.46, "text": "老子以后还怎么进进"}, {"start": 10.62, "end": 11.18, "text": "小子"}, {"start": 11.34, "end": 12.46, "text": "我守回刚才的话"}, {"start": 12.62, "end": 14.22, "text": "是我和王妮看走了眼"}, {"start": 14.38, "end": 17.22, "text": "别用那娘们儿嘻嘻地操刀术来恶心老子"}, {"start": 17.34, "end": 19.42, "text": "操刀术还破不了老子的防御"}, {"start": 19.86, "end": 20.3, "text": "来"}, {"start": 20.58, "end": 22.02, "text": "用你的崩天神觉"}, {"start": 22.26, "end": 23.58, "text": "老子倒是要看看"}, {"start": 23.7, "end": 25.74, "text": "江湖上赫赫有名的崩天神觉"}, {"start": 25.74, "end": 26.82, "text": "到底有多厉害"}, {"start": 27.1, "end": 28.18, "text": "属你所愿"}, {"start": 33.52, "end": 34.12, "text": "痛快"}, {"start": 34.12, "end": 35.36, "text": "玄兽针绝"}, {"start": 35.72, "end": 37.56, "text": "玄归护体"}, {"start": 39.32, "end": 41.96, "text": "玄归护体靠全身针气凝成铁土一块"}, {"start": 41.96, "end": 43.12, "text": "刀剑难伤分好"}, {"start": 43.12, "end": 45.28, "text": "寻常欺贫武师绝不是我的对手"}, {"start": 45.28, "end": 47.16, "text": "但崩天神觉能碎金石"}, {"start": 47.16, "end": 49.4, "text": "我这层归可未必扛得住你的拳头"}, {"start": 49.4, "end": 51.04, "text": "我并非执着于活着"}, {"start": 51.24, "end": 52.68, "text": "但玄兽门的绝技"}, {"start": 52.68, "end": 54.28, "text": "绝不能在我手里蒙羞"}, {"start": 54.28, "end": 55.64, "text": "我愿引爆丹田"}, {"start": 55.64, "end": 57.64, "text": "以更强的玄弓来讨教阁下的"}, {"start": 57.64, "end": 58.6, "text": "崩天神觉"}]}