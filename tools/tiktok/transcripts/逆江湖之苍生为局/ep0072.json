{"file": "逆江湖之苍生为局-第72集.mp4", "ep": 72, "duration": 87.2, "segments": [{"start": 0.46, "end": 3.12, "text": "毁我灵狐 断我生路"}, {"start": 3.12, "end": 5.62, "text": "那你们就拿命来尝"}, {"start": 5.62, "end": 7.18, "text": "去死吧"}, {"start": 7.18, "end": 8.46, "text": "第二丹田"}, {"start": 8.46, "end": 9.34, "text": "开"}, {"start": 9.34, "end": 12.65, "text": "龙归户蹄"}, {"start": 12.65, "end": 29.65, "text": "难道你也和世中武圣一样"}, {"start": 29.65, "end": 31.29, "text": "又强者的真气传承"}, {"start": 31.29, "end": 33.46, "text": "千算万算"}, {"start": 33.46, "end": 35.22, "text": "没算到他竟有这种传承"}, {"start": 35.22, "end": 36.22, "text": "得撤"}, {"start": 36.22, "end": 37.88, "text": "好想"}, {"start": 37.88, "end": 43.38, "text": "替一贯"}, {"start": 43.38, "end": 44.14, "text": "八方"}, {"start": 44.14, "end": 50.07, "text": "你怎么也会"}, {"start": 50.07, "end": 52.75, "text": "一交的"}, {"start": 52.75, "end": 53.92, "text": "麒麟"}, {"start": 53.92, "end": 54.8, "text": "冲尘"}, {"start": 54.8, "end": 59.01, "text": "五人快逃"}, {"start": 59.01, "end": 80.84, "text": "害我损失如此之多"}, {"start": 80.84, "end": 86.62, "text": "温子梁必负"}]}