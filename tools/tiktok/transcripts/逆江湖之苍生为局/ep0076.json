{"file": "逆江湖之苍生为局-第76集.mp4", "ep": 76, "duration": 56.7, "segments": [{"start": 1.37, "end": 2.81, "text": "十一根手指"}, {"start": 3.62, "end": 4.46, "text": "顾十一"}, {"start": 4.82, "end": 5.42, "text": "难道"}, {"start": 8.0, "end": 9.92, "text": "你才是顾家那个丢失的嫡子"}, {"start": 10.44, "end": 11.2, "text": "我真正的"}, {"start": 11.92, "end": 12.8, "text": "未婚夫"}, {"start": 13.04, "end": 14.44, "text": "将猫和伯父伯母"}, {"start": 14.44, "end": 15.48, "text": "却有几分相似"}, {"start": 15.84, "end": 16.76, "text": "但天下之大"}, {"start": 16.76, "end": 17.96, "text": "相相之人何其多"}, {"start": 18.4, "end": 19.4, "text": "而且年纪不对"}, {"start": 19.8, "end": 21.52, "text": "真正的顾公子英是十六岁"}, {"start": 21.68, "end": 22.76, "text": "他却是十七岁"}, {"start": 23.24, "end": 24.12, "text": "最关键的是"}, {"start": 24.36, "end": 25.16, "text": "一个是方氏"}, {"start": 25.16, "end": 26.04, "text": "一个是武师"}, {"start": 26.28, "end": 26.96, "text": "对不上"}, {"start": 27.52, "end": 28.72, "text": "但也不能完全否定"}, {"start": 29.42, "end": 29.98, "text": "看来"}, {"start": 30.26, "end": 31.5, "text": "只能用低血认清了"}, {"start": 34.66, "end": 36.7, "text": "顾家与云家都曾出过武神"}, {"start": 37.06, "end": 38.06, "text": "血脉特殊"}, {"start": 38.38, "end": 40.47, "text": "我们的低血之法"}, {"start": 41.33, "end": 42.41, "text": "绝不会出错"}, {"start": 42.65, "end": 43.37, "text": "小时候"}, {"start": 43.73, "end": 44.97, "text": "我曾被坏人捂过"}, {"start": 45.73, "end": 46.61, "text": "他们把我关在了"}, {"start": 46.61, "end": 47.93, "text": "一处独特的空间里"}, {"start": 48.21, "end": 49.05, "text": "没有声音"}, {"start": 49.05, "end": 49.97, "text": "也没有光"}, {"start": 50.65, "end": 51.81, "text": "我不知道那是哪里"}, {"start": 52.09, "end": 53.05, "text": "只知道那是一个"}, {"start": 53.05, "end": 54.09, "text": "可怕的地方"}, {"start": 54.49, "end": 55.09, "text": "直到"}, {"start": 55.49, "end": 56.41, "text": "遇到了他"}]}