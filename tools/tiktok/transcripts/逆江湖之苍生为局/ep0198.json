{"file": "逆江湖之苍生为局-第198集.mp4", "ep": 198, "duration": 69.6, "segments": [{"start": 10.22, "end": 11.18, "text": "来对了"}, {"start": 11.18, "end": 12.66, "text": "看来阵法没问题"}, {"start": 22.88, "end": 25.0, "text": "有位姓宋的公子"}, {"start": 25.0, "end": 27.12, "text": "让我给您送封信"}, {"start": 27.12, "end": 28.4, "text": "姓宋"}, {"start": 28.4, "end": 30.41, "text": "把爪子伸到这里来了"}, {"start": 30.41, "end": 31.89, "text": "烦死了 我不要"}, {"start": 31.89, "end": 32.65, "text": "可"}, {"start": 32.65, "end": 35.25, "text": "可那位公子带人把我向宫绑了"}, {"start": 35.25, "end": 36.33, "text": "姑娘 您"}, {"start": 36.33, "end": 37.65, "text": "您就当行行好"}, {"start": 37.65, "end": 39.01, "text": "一定把信收下"}, {"start": 39.01, "end": 40.13, "text": "就是这样"}, {"start": 40.13, "end": 42.01, "text": "她怎么还是这么不要脸"}, {"start": 45.1, "end": 45.94, "text": "好吧"}, {"start": 46.3, "end": 47.58, "text": "你把信放下"}, {"start": 47.58, "end": 48.82, "text": "我自己会去"}, {"start": 48.82, "end": 50.1, "text": "不行啊"}, {"start": 50.58, "end": 53.58, "text": "她要我一定亲手交到您手上"}, {"start": 53.58, "end": 56.6, "text": "姑娘 算我求您了"}, {"start": 56.6, "end": 57.76, "text": "这"}, {"start": 57.76, "end": 59.2, "text": "好吧"}, {"start": 59.2, "end": 60.36, "text": "你进来吧"}]}