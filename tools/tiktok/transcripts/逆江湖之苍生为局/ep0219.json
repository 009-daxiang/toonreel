{"file": "逆江湖之苍生为局-第219集.mp4", "ep": 219, "duration": 70.3, "segments": [{"start": 0.5, "end": 1.62, "text": "這下災了吧"}, {"start": 2.1, "end": 3.06, "text": "但你放心"}, {"start": 3.78, "end": 5.18, "text": "我會為你報仇的"}, {"start": 5.74, "end": 7.3, "text": "本想著為你報仇"}, {"start": 7.74, "end": 9.14, "text": "但沒想到啊"}, {"start": 9.76, "end": 11.16, "text": "還是被你給耍了"}, {"start": 11.4, "end": 15.28, "text": "但你還活著"}, {"start": 19.82, "end": 21.14, "text": "所以你這次來"}, {"start": 21.42, "end": 22.86, "text": "是找那個傢伙"}, {"start": 23.22, "end": 24.14, "text": "報仇的嗎"}, {"start": 24.3, "end": 25.42, "text": "那個傢伙"}, {"start": 26.06, "end": 27.5, "text": "到底從哪兒冒出來的"}, {"start": 27.9, "end": 29.71, "text": "怎麼不去死"}, {"start": 30.43, "end": 31.71, "text": "老天瞎眼了嗎"}, {"start": 31.71, "end": 35.49, "text": "你死這個"}, {"start": 38.93, "end": 40.01, "text": "我是不是有病"}, {"start": 40.49, "end": 41.57, "text": "我來這裡幹嘛"}, {"start": 42.33, "end": 43.33, "text": "花魁比賽"}, {"start": 44.02, "end": 45.26, "text": "關我屁事"}, {"start": 45.54, "end": 47.54, "text": "你要是願意和我回牡丹堂"}, {"start": 47.78, "end": 48.74, "text": "那該多好"}, {"start": 49.22, "end": 52.06, "text": "這樣我就能保護你了"}, {"start": 52.26, "end": 53.3, "text": "帶她回牡丹堂"}, {"start": 53.81, "end": 54.57, "text": "然後"}, {"start": 55.15, "end": 57.15, "text": "問清當年父親死亡的真相"}, {"start": 63.17, "end": 64.25, "text": "顧蒼生那時"}, {"start": 65.14, "end": 66.78, "text": "絕不可能是爹爹的對手"}, {"start": 66.9, "end": 68.14, "text": "爹爹死在他手裡"}, {"start": 68.34, "end": 70.11, "text": "一定有什麼內情"}]}