{"file": "逆江湖之苍生为局-第115集.mp4", "ep": 115, "duration": 64.1, "segments": [{"start": 0.98, "end": 1.98, "text": "你先躲远点"}, {"start": 2.6, "end": 3.1, "text": "好"}, {"start": 5.53, "end": 7.03, "text": "公子倒是悠闲"}, {"start": 7.53, "end": 9.53, "text": "我们可是等了你不少时日呢"}, {"start": 11.82, "end": 13.32, "text": "不是要埋我吗"}, {"start": 13.89, "end": 15.39, "text": "看看谁埋谁"}, {"start": 15.89, "end": 20.96, "text": "开"}, {"start": 37.56, "end": 38.56, "text": "好本事"}, {"start": 45.01, "end": 45.51, "text": "阴气"}, {"start": 47.48, "end": 48.48, "text": "好眼力"}, {"start": 53.24, "end": 54.24, "text": "食阳阴气之下"}, {"start": 54.74, "end": 56.74, "text": "一切阳气皆为氧料"}, {"start": 57.24, "end": 59.24, "text": "你越强我便越强"}, {"start": 59.74, "end": 60.24, "text": "我"}, {"start": 60.74, "end": 62.24, "text": "就是武师的克星"}, {"start": 62.74, "end": 63.74, "text": "所以去死"}]}