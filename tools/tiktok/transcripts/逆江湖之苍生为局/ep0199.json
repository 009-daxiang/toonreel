{"file": "逆江湖之苍生为局-第199集.mp4", "ep": 199, "duration": 52.0, "segments": [{"start": 5.53, "end": 6.53, "text": "你想骗我"}, {"start": 6.53, "end": 7.53, "text": "对吧"}, {"start": 8.53, "end": 9.53, "text": "找不到信"}, {"start": 9.53, "end": 11.53, "text": "你就完蛋了"}, {"start": 11.53, "end": 12.53, "text": "你是男人"}, {"start": 12.53, "end": 13.53, "text": "聪明"}, {"start": 13.53, "end": 28.0, "text": "原来如此"}, {"start": 28.0, "end": 31.0, "text": "这里是一方没有灵气的小天地"}, {"start": 31.0, "end": 33.0, "text": "难怪我的分身会消失"}, {"start": 33.0, "end": 35.0, "text": "但你的算盘打错了"}, {"start": 35.0, "end": 36.0, "text": "就算外界没有灵气"}, {"start": 36.0, "end": 39.0, "text": "融入身体的法术也不会消失"}, {"start": 39.0, "end": 43.39, "text": "可以在任何时间"}, {"start": 43.39, "end": 45.39, "text": "将周深之物进行虚实转换"}, {"start": 45.39, "end": 47.65, "text": "胜负已分"}, {"start": 47.65, "end": 49.9, "text": "只要我实话比手"}, {"start": 49.9, "end": 51.9, "text": "它就会出现在你的体内"}]}