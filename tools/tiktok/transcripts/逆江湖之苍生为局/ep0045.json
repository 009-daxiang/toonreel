{"file": "逆江湖之苍生为局-第45集.mp4", "ep": 45, "duration": 58.9, "segments": [{"start": 0.24, "end": 1.12, "text": "我煮点粥"}, {"start": 1.68, "end": 2.16, "text": "不用"}, {"start": 6.18, "end": 6.94, "text": "乾坤剑"}, {"start": 7.34, "end": 8.42, "text": "一位故人所赠"}, {"start": 8.74, "end": 9.62, "text": "自成空间"}, {"start": 9.74, "end": 10.54, "text": "能穿食物"}, {"start": 11.72, "end": 12.4, "text": "听说过"}, {"start": 13.0, "end": 14.3, "text": "是由方氏连职的"}, {"start": 18.79, "end": 19.55, "text": "真好吃"}, {"start": 19.99, "end": 24.62, "text": "要是念念也在就好了"}, {"start": 25.94, "end": 26.86, "text": "她一定喜欢"}, {"start": 27.26, "end": 29.71, "text": "正式认识一下"}, {"start": 30.23, "end": 31.23, "text": "我叫陆菅家"}, {"start": 31.55, "end": 32.63, "text": "你可以叫我菅家"}, {"start": 34.68, "end": 35.96, "text": "我知道你担心念念"}, {"start": 36.4, "end": 37.16, "text": "但你放心"}, {"start": 37.72, "end": 39.12, "text": "镇玉石带走的人"}, {"start": 39.56, "end": 40.64, "text": "绝不会出问题"}, {"start": 42.21, "end": 43.81, "text": "你现在的任务是护卫我"}, {"start": 44.74, "end": 45.82, "text": "只要保护好我"}, {"start": 46.54, "end": 47.66, "text": "我一定让你见到她"}, {"start": 50.78, "end": 51.78, "text": "一直恩恩恩"}, {"start": 52.1, "end": 53.96, "text": "看你改名叫郭恩恩算了"}]}