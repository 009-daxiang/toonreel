{"file": "逆江湖之苍生为局-第46集.mp4", "ep": 46, "duration": 65.8, "segments": [{"start": 0.0, "end": 0.96, "text": "秦宫不错"}, {"start": 1.68, "end": 2.84, "text": "已出到真情门槛了"}, {"start": 2.96, "end": 3.56, "text": "是"}, {"start": 3.76, "end": 5.2, "text": "什么时候盯上我们的"}, {"start": 5.6, "end": 6.6, "text": "朕遇事一走"}, {"start": 6.72, "end": 7.84, "text": "就一直有人盯着"}, {"start": 8.48, "end": 10.08, "text": "现在外面也不止一双眼睛"}, {"start": 10.52, "end": 11.08, "text": "换上"}, {"start": 11.61, "end": 12.61, "text": "看能不能混出城"}, {"start": 12.77, "end": 13.33, "text": "好"}, {"start": 13.73, "end": 14.37, "text": "我穿"}, {"start": 20.26, "end": 21.34, "text": "很惊讶是吗"}, {"start": 21.74, "end": 23.18, "text": "我虽是世家出身"}, {"start": 23.34, "end": 24.66, "text": "但也分得清清楚"}, {"start": 24.78, "end": 26.02, "text": "关键时刻倒不含糊"}, {"start": 26.78, "end": 27.34, "text": "赶紧吃"}, {"start": 27.46, "end": 28.26, "text": "之后早点歇歇"}, {"start": 28.38, "end": 29.02, "text": "明早动身"}, {"start": 29.14, "end": 29.54, "text": "好"}, {"start": 29.82, "end": 44.3, "text": "要出城了"}, {"start": 44.42, "end": 56.98, "text": "不许关"}, {"start": 57.14, "end": 58.14, "text": "打开城门"}]}