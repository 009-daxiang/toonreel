{"file": "逆江湖之苍生为局-第24集.mp4", "ep": 24, "duration": 64.4, "segments": [{"start": 0.98, "end": 1.98, "text": "三眼"}, {"start": 3.01, "end": 4.62, "text": "怎么可能"}, {"start": 4.62, "end": 5.62, "text": "难道那小子也是"}, {"start": 6.62, "end": 7.62, "text": "不是"}, {"start": 7.62, "end": 8.62, "text": "怕是大夏人"}, {"start": 9.62, "end": 10.9, "text": "放开念念"}, {"start": 11.9, "end": 12.9, "text": "有什么冲我来"}, {"start": 13.9, "end": 16.73, "text": "我再问你一遍"}, {"start": 17.73, "end": 18.76, "text": "千人图身绝灼"}, {"start": 19.76, "end": 20.76, "text": "和你是什么关系"}, {"start": 20.76, "end": 21.76, "text": "千人图身绝灼"}, {"start": 22.76, "end": 23.76, "text": "怎么感觉这名字这么熟悉"}, {"start": 24.76, "end": 25.76, "text": "是啊"}, {"start": 25.76, "end": 26.76, "text": "好像哪里听过"}, {"start": 26.76, "end": 29.42, "text": "杨爷爷"}, {"start": 29.42, "end": 30.42, "text": "身绝灼是谁"}, {"start": 31.42, "end": 32.52, "text": "几年前"}, {"start": 32.52, "end": 34.52, "text": "一个让大夏王朝"}, {"start": 34.52, "end": 35.52, "text": "无数上京客"}, {"start": 35.52, "end": 36.52, "text": "无数江湖人"}, {"start": 36.52, "end": 38.52, "text": "谈之色变的疯子"}, {"start": 38.52, "end": 39.52, "text": "他原是二流门派"}, {"start": 39.52, "end": 40.52, "text": "体练门的弟子"}, {"start": 40.52, "end": 41.52, "text": "心性时常"}, {"start": 42.52, "end": 43.52, "text": "却偏偏机缘巧合"}, {"start": 43.52, "end": 44.52, "text": "得到上古医师的"}, {"start": 44.52, "end": 45.52, "text": "顶尖玄宫"}, {"start": 45.52, "end": 47.52, "text": "崩天神绝"}, {"start": 47.52, "end": 50.74, "text": "后来一招缝磨"}, {"start": 51.74, "end": 52.74, "text": "他将体练门"}, {"start": 52.74, "end": 54.74, "text": "上天弟子屠杀殆尽"}, {"start": 54.74, "end": 55.74, "text": "死在他拳下的"}, {"start": 55.74, "end": 57.74, "text": "金牌上京客"}, {"start": 57.74, "end": 59.74, "text": "更是毒技奇术"}, {"start": 59.74, "end": 61.34, "text": "几年前"}, {"start": 61.34, "end": 63.34, "text": "他突然没了消息"}]}