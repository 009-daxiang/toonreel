{"file": "逆江湖之苍生为局-第29集.mp4", "ep": 29, "duration": 60.0, "segments": [{"start": 0.59, "end": 2.59, "text": "小子 你叫什么名字"}, {"start": 2.59, "end": 4.59, "text": "顾十一"}, {"start": 4.59, "end": 8.74, "text": "醒顾"}, {"start": 8.74, "end": 11.74, "text": "果然没有那么巧的石肉"}, {"start": 11.74, "end": 13.74, "text": "为什么叫顾十一"}, {"start": 13.74, "end": 16.74, "text": "那他 为什么叫灵灵"}, {"start": 24.93, "end": 25.93, "text": "顾十一 听令"}, {"start": 25.93, "end": 27.93, "text": "黑龙令在场"}, {"start": 27.93, "end": 29.93, "text": "如陛下千临"}, {"start": 29.93, "end": 38.36, "text": "顾十一斩杀宋家弟子"}, {"start": 38.36, "end": 39.36, "text": "没偿宫学子"}, {"start": 39.36, "end": 40.36, "text": "当街杀人"}, {"start": 40.36, "end": 41.36, "text": "目无网法"}, {"start": 41.36, "end": 42.36, "text": "其罪当珠"}, {"start": 42.36, "end": 43.36, "text": "但"}, {"start": 43.36, "end": 45.42, "text": "正值家国用人之计时"}, {"start": 45.42, "end": 47.46, "text": "严其年少"}, {"start": 47.46, "end": 48.46, "text": "死罪可免"}, {"start": 48.46, "end": 49.46, "text": "国罪难逃"}, {"start": 49.46, "end": 50.46, "text": "把配北狱"}, {"start": 50.46, "end": 52.46, "text": "任善于实"}]}