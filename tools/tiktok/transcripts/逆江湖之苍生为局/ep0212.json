{"file": "逆江湖之苍生为局-第212集.mp4", "ep": 212, "duration": 59.0, "segments": [{"start": 0.27, "end": 1.99, "text": "我收回之前的话"}, {"start": 1.99, "end": 4.07, "text": "你的确有自拗的资本"}, {"start": 4.07, "end": 7.3, "text": "但你还是太大意了"}, {"start": 7.3, "end": 16.74, "text": "不是宅星阁"}, {"start": 16.74, "end": 18.14, "text": "这是哪儿"}, {"start": 18.14, "end": 24.01, "text": "传宋镇"}, {"start": 24.01, "end": 25.61, "text": "凶大无脑"}, {"start": 25.61, "end": 27.29, "text": "去和山里头的人"}, {"start": 27.29, "end": 33.42, "text": "他传哪儿了"}, {"start": 33.42, "end": 36.37, "text": "牢山"}, {"start": 36.37, "end": 41.72, "text": "四大家族的人"}, {"start": 41.72, "end": 43.64, "text": "要是真那么容易死就好了"}, {"start": 43.64, "end": 45.02, "text": "对了"}, {"start": 45.02, "end": 46.61, "text": "这个你拿好"}, {"start": 46.61, "end": 54.12, "text": "云烟烟在里面"}, {"start": 54.12, "end": 56.55, "text": "后面找个机会把他放了"}]}