{"file": "逆江湖之苍生为局-第129集.mp4", "ep": 129, "duration": 60.1, "segments": [{"start": 2.0, "end": 9.22, "text": "小师姐 还打吗"}, {"start": 9.22, "end": 10.22, "text": "不打了"}, {"start": 10.22, "end": 11.22, "text": "下次见面"}, {"start": 15.77, "end": 17.15, "text": "我一定杀了你"}, {"start": 18.15, "end": 25.68, "text": "他是谁"}, {"start": 25.68, "end": 27.68, "text": "好像对你和崩天神爵都很了解"}, {"start": 28.68, "end": 30.1, "text": "我从没见过他"}, {"start": 30.1, "end": 31.1, "text": "可我知道他是谁"}, {"start": 31.1, "end": 32.51, "text": "谁"}, {"start": 32.51, "end": 34.51, "text": "前人途神爵卓的女儿"}, {"start": 34.51, "end": 35.51, "text": "神爵卓的女儿"}, {"start": 35.51, "end": 36.54, "text": "他会崩天神爵"}, {"start": 36.54, "end": 39.31, "text": "他为什么要替你报仇"}, {"start": 40.31, "end": 41.5, "text": "因为神爵卓"}, {"start": 41.5, "end": 43.02, "text": "是我的师父"}, {"start": 43.02, "end": 45.84, "text": "神爵卓是顾十一的师父"}, {"start": 45.84, "end": 47.84, "text": "他不是杀了神爵卓吗"}, {"start": 47.84, "end": 48.84, "text": "他杀了自己的师父"}, {"start": 49.84, "end": 50.84, "text": "你能不能和我"}, {"start": 50.84, "end": 51.84, "text": "走吧"}]}