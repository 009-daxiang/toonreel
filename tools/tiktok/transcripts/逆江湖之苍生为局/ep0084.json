{"file": "逆江湖之苍生为局-第84集.mp4", "ep": 84, "duration": 76.4, "segments": [{"start": 0.14, "end": 1.3, "text": "原来陆姐姐"}, {"start": 1.66, "end": 3.34, "text": "来自大明鼎鼎的陆家"}, {"start": 4.3, "end": 5.9, "text": "难怪有这般气质"}, {"start": 7.42, "end": 8.1, "text": "陆姐姐"}, {"start": 8.66, "end": 11.02, "text": "这位公子是你的护卫吧"}, {"start": 11.62, "end": 12.7, "text": "并非护卫"}, {"start": 13.14, "end": 13.94, "text": "柳小姐"}, {"start": 14.42, "end": 16.3, "text": "不知可否能帮我"}, {"start": 16.42, "end": 17.86, "text": "引荐一下刘老爷子"}, {"start": 18.82, "end": 19.38, "text": "自然"}, {"start": 20.04, "end": 21.24, "text": "陆姐姐 到了"}, {"start": 22.61, "end": 24.05, "text": "小姐 家主吩咐"}, {"start": 24.29, "end": 26.21, "text": "请您带这位姑娘直接去客厅"}, {"start": 27.29, "end": 27.93, "text": "知道了"}, {"start": 28.68, "end": 31.24, "text": "还请这位公子到花园烧作休息"}, {"start": 32.0, "end": 33.88, "text": "我已安排人备好了上好韭菜"}, {"start": 35.5, "end": 36.66, "text": "柳穷那老东西"}, {"start": 36.86, "end": 38.06, "text": "简直不是太绝"}, {"start": 38.82, "end": 39.58, "text": "柳大长老"}, {"start": 40.56, "end": 41.88, "text": "你应该知道怎么做吧"}, {"start": 42.51, "end": 43.43, "text": "公子放心"}, {"start": 43.79, "end": 45.47, "text": "那小子敢动宋家的人"}, {"start": 45.71, "end": 47.43, "text": "老夫定叫他拿命来成"}, {"start": 47.79, "end": 49.93, "text": "是 那位陆家柳小姐"}, {"start": 50.13, "end": 50.85, "text": "如何处置"}, {"start": 50.85, "end": 51.57, "text": "不必理会"}, {"start": 52.01, "end": 52.93, "text": "我只要结果"}, {"start": 53.33, "end": 54.13, "text": "要么他死"}, {"start": 54.99, "end": 55.47, "text": "要么"}, {"start": 55.95, "end": 56.79, "text": "柳家命"}, {"start": 56.83, "end": 57.23, "text": "是"}, {"start": 57.69, "end": 59.57, "text": "此事老夫必倾尽全力"}, {"start": 59.57, "end": 60.41, "text": "自成之后"}, {"start": 60.85, "end": 62.25, "text": "这柳家家主之位"}, {"start": 62.81, "end": 64.99, "text": "多谢公子"}, {"start": 66.49, "end": 69.17, "text": "那本公子便等你的好消息"}]}