{"file": "逆江湖之苍生为局-第38集.mp4", "ep": 38, "duration": 69.1, "segments": [{"start": 0.18, "end": 1.62, "text": "宋 宋公子"}, {"start": 2.3, "end": 3.7, "text": "那宋宣 怎么办"}, {"start": 5.64, "end": 7.08, "text": "找个地方安葬了吧"}, {"start": 7.4, "end": 10.56, "text": "找个地"}, {"start": 10.56, "end": 11.2, "text": "怎么"}, {"start": 11.56, "end": 12.76, "text": "难道你还想把死人"}, {"start": 12.76, "end": 13.76, "text": "拉宋家门口成"}, {"start": 13.76, "end": 14.16, "text": "不敢"}, {"start": 14.16, "end": 14.96, "text": "那自然不敢"}, {"start": 15.88, "end": 17.12, "text": "顾时一是吗"}, {"start": 17.6, "end": 19.6, "text": "今日我给云镇编一个面子"}, {"start": 19.6, "end": 21.76, "text": "明日起能否活下来"}, {"start": 22.04, "end": 23.52, "text": "全看你本事了"}, {"start": 24.04, "end": 26.19, "text": "全是一帮臭鱼烂虾的迫使"}, {"start": 26.31, "end": 27.19, "text": "耽误功夫"}, {"start": 27.67, "end": 35.17, "text": "我们走"}, {"start": 57.06, "end": 57.58, "text": "走吧"}, {"start": 57.82, "end": 63.42, "text": "书读完了 改行路了"}]}