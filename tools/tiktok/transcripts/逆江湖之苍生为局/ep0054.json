{"file": "逆江湖之苍生为局-第54集.mp4", "ep": 54, "duration": 92.7, "segments": [{"start": 0.0, "end": 0.8, "text": "乖"}, {"start": 3.44, "end": 4.76, "text": "最强的防御"}, {"start": 4.76, "end": 6.44, "text": "也是最强的攻击"}, {"start": 6.44, "end": 7.88, "text": "玄归真绝"}, {"start": 7.88, "end": 9.52, "text": "龙归护体"}, {"start": 9.52, "end": 10.36, "text": "来吧"}, {"start": 10.64, "end": 13.56, "text": "让我看看崩天神绝的真本事"}, {"start": 13.56, "end": 22.39, "text": "崩拳"}, {"start": 22.39, "end": 48.66, "text": "崩天神绝"}, {"start": 49.19, "end": 50.47, "text": "果然厉害"}, {"start": 54.62, "end": 55.74, "text": "接下来了"}, {"start": 57.02, "end": 60.66, "text": "还是带着笑走的"}, {"start": 62.23, "end": 63.39, "text": "很少有人能接下"}, {"start": 63.39, "end": 65.15, "text": "七成为力的崩天神绝"}, {"start": 67.82, "end": 69.62, "text": "我若有你这样的本事就好了"}, {"start": 69.62, "end": 72.74, "text": "就不会如此举步为止"}, {"start": 72.74, "end": 74.5, "text": "要是孽孽能像你一样"}, {"start": 74.98, "end": 76.3, "text": "在大雪天坐着马车"}, {"start": 76.3, "end": 77.97, "text": "喝着热茶"}, {"start": 77.97, "end": 79.49, "text": "我愿意把这天赋送给你"}, {"start": 79.49, "end": 80.93, "text": "这样的强者"}, {"start": 80.93, "end": 81.77, "text": "为什么会沦落到"}, {"start": 81.77, "end": 83.13, "text": "起盖一般的境地"}, {"start": 83.13, "end": 84.95, "text": "变强是为了什么"}, {"start": 84.95, "end": 89.22, "text": "所谓修行又是为了什么"}, {"start": 89.22, "end": 90.78, "text": "总有一天"}, {"start": 90.78, "end": 92.66, "text": "我也会死在更强的人手里"}]}