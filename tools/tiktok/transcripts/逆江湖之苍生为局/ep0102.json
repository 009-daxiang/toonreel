{"file": "逆江湖之苍生为局-第102集.mp4", "ep": 102, "duration": 58.7, "segments": [{"start": 0.0, "end": 0.8, "text": "大哥"}, {"start": 5.49, "end": 7.17, "text": "我可怜的傻弟弟"}, {"start": 7.98, "end": 9.38, "text": "没在柳家杀你"}, {"start": 9.38, "end": 11.42, "text": "是怕老东西看见极眼拼命"}, {"start": 13.12, "end": 14.2, "text": "带你回来"}, {"start": 14.2, "end": 16.12, "text": "就是为了亲眼看着你死"}, {"start": 16.12, "end": 17.08, "text": "你不死"}, {"start": 18.18, "end": 19.66, "text": "我心难安"}, {"start": 20.06, "end": 25.43, "text": "还没到环般的点啊"}, {"start": 25.43, "end": 26.51, "text": "奶奶的"}, {"start": 26.51, "end": 28.19, "text": "不会又缠酒去了吧"}, {"start": 38.9, "end": 40.34, "text": "你今天屋子干什么了"}, {"start": 43.65, "end": 44.13, "text": "快"}, {"start": 44.13, "end": 45.37, "text": "把那缠也添进去"}, {"start": 45.37, "end": 46.33, "text": "动死老子了"}, {"start": 46.73, "end": 50.99, "text": "我测什么呢"}, {"start": 50.99, "end": 51.63, "text": "快点"}, {"start": 53.72, "end": 54.52, "text": "别装了"}, {"start": 55.44, "end": 57.38, "text": "既然认出来了"}, {"start": 57.38, "end": 58.42, "text": "那就动手吧"}]}