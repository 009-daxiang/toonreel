{"file": "逆江湖之苍生为局-第126集.mp4", "ep": 126, "duration": 85.9, "segments": [{"start": 18.1, "end": 19.1, "text": "早上好啊"}, {"start": 19.5, "end": 31.12, "text": "就在这儿吧"}, {"start": 31.4, "end": 35.6, "text": "他去啊"}, {"start": 35.6, "end": 37.12, "text": "不然要尿裤子里了"}, {"start": 37.4, "end": 39.68, "text": "吃个虫"}, {"start": 39.68, "end": 40.56, "text": "我记下了"}, {"start": 40.96, "end": 45.85, "text": "这位姑娘"}, {"start": 45.85, "end": 46.89, "text": "药爽了吧"}, {"start": 47.17, "end": 49.27, "text": "这人说话怎能这样粗鄙"}, {"start": 49.27, "end": 51.27, "text": "看在我让你尿爽的份上"}, {"start": 51.27, "end": 52.07, "text": "告诉我"}, {"start": 52.07, "end": 54.27, "text": "顾十一是怎么死的"}, {"start": 54.27, "end": 58.06, "text": "那这个做什么"}, {"start": 59.2, "end": 60.84, "text": "决定要不要杀你"}, {"start": 61.16, "end": 63.78, "text": "是不是要替他报仇"}, {"start": 64.3, "end": 65.78, "text": "难道他是顾十一的朋友"}, {"start": 66.06, "end": 66.58, "text": "说"}, {"start": 69.13, "end": 70.33, "text": "孟非凡杀的"}, {"start": 70.94, "end": 71.94, "text": "孟非凡"}, {"start": 72.48, "end": 73.16, "text": "是啊"}, {"start": 73.56, "end": 75.36, "text": "十尊五圣之下第一人"}, {"start": 75.64, "end": 76.76, "text": "见圣弟子"}, {"start": 77.26, "end": 78.06, "text": "那天"}, {"start": 78.34, "end": 80.18, "text": "他又射出了朱雀杀星"}, {"start": 80.78, "end": 81.5, "text": "但是"}, {"start": 81.86, "end": 83.74, "text": "朱雀杀星能杀得了别人"}, {"start": 84.42, "end": 85.94, "text": "却杀不了顾十一"}]}