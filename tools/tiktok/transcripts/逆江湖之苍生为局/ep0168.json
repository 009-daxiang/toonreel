{"file": "逆江湖之苍生为局-第168集.mp4", "ep": 168, "duration": 80.0, "segments": [{"start": 6.16, "end": 11.39, "text": "多谢姑娘赏脸"}, {"start": 11.39, "end": 13.39, "text": "姑娘如此佳人"}, {"start": 13.39, "end": 14.89, "text": "愿与我等贡猎"}, {"start": 14.89, "end": 25.32, "text": "想必是有什么目的吧"}, {"start": 25.32, "end": 27.32, "text": "那倒真是在下的荣幸了"}, {"start": 27.32, "end": 32.77, "text": "果然不管是神女还是仙子"}, {"start": 32.77, "end": 34.97, "text": "全都一个样子"}, {"start": 34.97, "end": 36.97, "text": "那你是看上她的人了"}, {"start": 36.97, "end": 41.85, "text": "还是看上她的背景啊"}, {"start": 41.85, "end": 42.85, "text": "哈哈哈"}, {"start": 42.85, "end": 43.85, "text": "你倒坦诚"}, {"start": 43.85, "end": 44.85, "text": "姑娘"}, {"start": 44.85, "end": 47.85, "text": "我似乎从未见过"}, {"start": 47.85, "end": 49.35, "text": "突然提这种要求"}, {"start": 49.35, "end": 55.91, "text": "未免太唐突了"}, {"start": 55.91, "end": 58.29, "text": "若换做自己"}, {"start": 58.29, "end": 59.29, "text": "那该多好"}, {"start": 59.29, "end": 60.79, "text": "你为什么只看上了她"}, {"start": 60.79, "end": 61.79, "text": "我们也能帮"}, {"start": 61.79, "end": 65.02, "text": "可是顾公子啊"}, {"start": 65.02, "end": 66.02, "text": "帮你"}, {"start": 66.02, "end": 68.02, "text": "对我来说有什么好处"}, {"start": 68.02, "end": 73.79, "text": "仙子"}, {"start": 73.79, "end": 75.29, "text": "你这话太空了"}, {"start": 75.29, "end": 76.29, "text": "不如这样"}, {"start": 76.29, "end": 77.29, "text": "事成之后"}, {"start": 77.29, "end": 79.29, "text": "你给咱们顾公子做个歉"}, {"start": 79.29, "end": 80.29, "text": "如何"}]}