{"file": "逆江湖之苍生为局-第217集.mp4", "ep": 217, "duration": 52.1, "segments": [{"start": 0.4, "end": 1.4, "text": "有吗"}, {"start": 1.4, "end": 2.4, "text": "嗯"}, {"start": 2.4, "end": 3.5, "text": "师姐"}, {"start": 3.5, "end": 4.5, "text": "过去的你"}, {"start": 4.5, "end": 5.5, "text": "曾经发誓"}, {"start": 5.5, "end": 8.5, "text": "要做这世上最潇洒的女人"}, {"start": 8.5, "end": 9.5, "text": "喝醉烈的酒"}, {"start": 9.5, "end": 10.5, "text": "请最快的马"}, {"start": 10.5, "end": 11.5, "text": "涂最好的烟枕"}, {"start": 11.5, "end": 12.5, "text": "上最好的男人"}, {"start": 12.5, "end": 13.5, "text": "快以恩仇"}, {"start": 13.5, "end": 14.5, "text": "只为自己而活"}, {"start": 14.5, "end": 16.5, "text": "绝不在乎他人看法"}, {"start": 16.5, "end": 17.5, "text": "万千仇私"}, {"start": 17.5, "end": 18.5, "text": "是他娘的"}, {"start": 21.2, "end": 22.2, "text": "不早了"}, {"start": 22.2, "end": 24.29, "text": "都去歇着吧"}, {"start": 24.29, "end": 28.46, "text": "潇洒"}, {"start": 28.46, "end": 30.46, "text": "谁又能真正地做到呢"}, {"start": 30.46, "end": 31.46, "text": "我叫阮莲月"}, {"start": 31.46, "end": 33.46, "text": "原名深觉月月"}, {"start": 33.46, "end": 35.72, "text": "父亲正是让江湖文风"}, {"start": 35.72, "end": 37.72, "text": "丧胆的风子深觉着"}, {"start": 37.72, "end": 38.72, "text": "多年前"}, {"start": 38.72, "end": 40.72, "text": "他机缘巧合下"}, {"start": 40.72, "end": 42.72, "text": "得到了崩天神觉"}, {"start": 42.72, "end": 43.72, "text": "但母亲"}, {"start": 43.72, "end": 45.72, "text": "却因此被人逼问杀死"}, {"start": 45.72, "end": 46.72, "text": "之后"}, {"start": 46.72, "end": 49.75, "text": "父亲带着我躲避追杀"}, {"start": 49.75, "end": 51.88, "text": "翻过无数座山"}]}