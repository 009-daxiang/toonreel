{"file": "乡下来的掌上明珠-第122集.mp4", "ep": 122, "duration": 108.4, "segments": [{"start": 0.08, "end": 1.12, "text": "冲喜"}, {"start": 1.68, "end": 3.52, "text": "大清王了没通知他们苏家吗"}, {"start": 4.45, "end": 5.21, "text": "再说了"}, {"start": 5.37, "end": 6.45, "text": "苏县州才八岁"}, {"start": 6.65, "end": 8.17, "text": "冲喜这不纯属胡闹吗"}, {"start": 8.45, "end": 9.77, "text": "哪家大元准会答应"}, {"start": 10.05, "end": 13.04, "text": "你是不是忘了"}, {"start": 13.48, "end": 15.04, "text": "苏家和你们陪家有婚"}, {"start": 15.04, "end": 16.6, "text": "吃瓜招到瓜田里"}, {"start": 16.6, "end": 18.04, "text": "愿种精是我自己"}, {"start": 19.08, "end": 20.28, "text": "我爷爷奶奶在殿"}, {"start": 20.28, "end": 22.04, "text": "也不可能把随女嫁娶苏家"}, {"start": 23.79, "end": 25.19, "text": "那可不一定啊"}, {"start": 25.39, "end": 26.03, "text": "帅哥"}, {"start": 26.27, "end": 27.47, "text": "帅哥你要我微信不"}, {"start": 28.03, "end": 28.67, "text": "帅哥"}, {"start": 28.67, "end": 29.71, "text": "你怎么不笑啊"}, {"start": 29.91, "end": 31.03, "text": "是有什么心事吗"}, {"start": 31.03, "end": 31.87, "text": "你好帅哥"}, {"start": 32.11, "end": 34.03, "text": "其实我是敌家奥特曼的人间体"}, {"start": 34.35, "end": 35.95, "text": "在上一次的战斗中"}, {"start": 36.19, "end": 37.23, "text": "我受伤了"}, {"start": 37.39, "end": 38.75, "text": "不能变身了"}, {"start": 38.95, "end": 40.35, "text": "我需要一个男孩"}, {"start": 40.55, "end": 41.71, "text": "跟我搞对象"}, {"start": 42.15, "end": 43.19, "text": "让我有希望"}, {"start": 43.19, "end": 44.95, "text": "让让我再次变成光"}, {"start": 44.95, "end": 46.41, "text": "保卫地球"}, {"start": 46.41, "end": 50.25, "text": "你愿意帮助我"}, {"start": 50.41, "end": 52.13, "text": "我们一起保卫地球"}, {"start": 52.13, "end": 53.37, "text": "保护人类吗"}, {"start": 53.37, "end": 54.37, "text": "启蒙了"}, {"start": 54.65, "end": 56.13, "text": "居然从一只苍鼠脸上"}, {"start": 56.13, "end": 57.53, "text": "看到了调戏的表情"}, {"start": 58.17, "end": 60.13, "text": "小白白说三哥帅"}, {"start": 61.58, "end": 62.18, "text": "是吗"}, {"start": 62.74, "end": 63.86, "text": "那我和你四哥"}, {"start": 63.98, "end": 64.62, "text": "谁帅"}, {"start": 65.71, "end": 66.63, "text": "又不幼稚"}, {"start": 66.63, "end": 67.71, "text": "都帅呀"}, {"start": 80.03, "end": 80.95, "text": "谁更帅"}, {"start": 80.95, "end": 84.81, "text": "你走"}, {"start": 89.1, "end": 89.7, "text": "人"}, {"start": 90.02, "end": 90.82, "text": "猫不累"}, {"start": 91.02, "end": 92.02, "text": "宝"}, {"start": 92.38, "end": 93.9, "text": "我也要抱"}, {"start": 93.9, "end": 94.62, "text": "没问题"}, {"start": 105.83, "end": 106.83, "text": "小机灵鬼"}, {"start": 107.31, "end": 108.43, "text": "还会转移话题"}]}