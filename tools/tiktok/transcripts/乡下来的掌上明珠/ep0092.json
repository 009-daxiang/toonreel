{"file": "乡下来的掌上明珠-第92集.mp4", "ep": 92, "duration": 75.3, "segments": [{"start": 0.3, "end": 4.4, "text": "不不"}, {"start": 4.4, "end": 5.84, "text": "这至少是百年人生"}, {"start": 5.84, "end": 6.28, "text": "不"}, {"start": 6.28, "end": 7.52, "text": "甚至是两百年"}, {"start": 7.52, "end": 9.0, "text": "如果说普通年份的人生"}, {"start": 9.0, "end": 11.32, "text": "能在生死关头调助人的一口气"}, {"start": 11.32, "end": 12.44, "text": "那两百年的人生"}, {"start": 12.44, "end": 13.36, "text": "若运用得当"}, {"start": 13.36, "end": 16.09, "text": "足以给人续命十年"}, {"start": 16.09, "end": 16.81, "text": "老铁们"}, {"start": 16.81, "end": 18.17, "text": "我眼眉花吧"}, {"start": 18.17, "end": 30.42, "text": "我来吃了"}, {"start": 30.42, "end": 43.54, "text": "到底干了什么蠢事啊"}, {"start": 43.54, "end": 44.46, "text": "老头子"}, {"start": 44.46, "end": 45.42, "text": "爷爷"}, {"start": 47.42, "end": 49.66, "text": "老头子你别吓我"}, {"start": 49.66, "end": 51.78, "text": "刚刚那人尘要是没扔多好"}, {"start": 51.78, "end": 52.98, "text": "现在起码给老头子"}, {"start": 52.98, "end": 54.38, "text": "吃口人生虚"}, {"start": 54.38, "end": 55.42, "text": "杀的"}, {"start": 55.42, "end": 57.88, "text": "从哪跑出来那么多畜生"}, {"start": 57.88, "end": 60.24, "text": "怎么就一口都没流呢"}, {"start": 67.87, "end": 69.26, "text": "喂"}, {"start": 69.26, "end": 70.26, "text": "是青州吗"}, {"start": 70.26, "end": 71.94, "text": "我刚收到消息"}, {"start": 71.94, "end": 73.02, "text": "说你们家得了一株"}, {"start": 73.02, "end": 74.14, "text": "两百年的人生"}, {"start": 74.14, "end": 75.18, "text": "这事是真的吗"}]}