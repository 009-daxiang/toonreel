{"file": "乡下来的掌上明珠-第62集.mp4", "ep": 62, "duration": 115.9, "segments": [{"start": 0.14, "end": 1.18, "text": "大师您好"}, {"start": 1.66, "end": 3.34, "text": "殷大夫 殷夫人"}, {"start": 3.54, "end": 4.38, "text": "二位请"}, {"start": 5.27, "end": 6.87, "text": "妙空大师带人接物"}, {"start": 6.87, "end": 8.27, "text": "向来礼数周全"}, {"start": 8.63, "end": 10.63, "text": "今日怎么会安排同一个时间段"}, {"start": 10.63, "end": 11.83, "text": "接待两家人呢"}, {"start": 12.19, "end": 14.67, "text": "难不成是殷无阳出了什么问题"}, {"start": 15.52, "end": 17.76, "text": "赤雍那孩子真是可惜了"}, {"start": 18.68, "end": 20.08, "text": "还好无阳没报名"}, {"start": 20.36, "end": 21.68, "text": "她这两天怎么样"}, {"start": 25.0, "end": 26.48, "text": "无阳现在状态不错"}, {"start": 27.29, "end": 29.77, "text": "早上还非要和我们一起来爬山呢"}, {"start": 30.05, "end": 30.77, "text": "什么"}, {"start": 32.87, "end": 35.55, "text": "殷无阳从小到大出门次数屈指可数"}, {"start": 35.71, "end": 36.91, "text": "如今愿意出门"}, {"start": 36.91, "end": 38.79, "text": "那岂不是说明情况好转了"}, {"start": 39.86, "end": 41.78, "text": "怎么该好转的肃气然没好转"}, {"start": 42.14, "end": 44.02, "text": "这殷无阳倒是越来越好了"}, {"start": 45.57, "end": 47.57, "text": "这可是当着殷无阳父母的面呢"}, {"start": 47.85, "end": 49.61, "text": "妆也得装出几分体面来"}, {"start": 50.28, "end": 51.8, "text": "那可真是太好了"}, {"start": 52.0, "end": 54.08, "text": "无阳是我看着长大的孩子"}, {"start": 54.52, "end": 56.64, "text": "我自然是希望她越来越好"}, {"start": 56.84, "end": 58.44, "text": "她要是能经常出门"}, {"start": 58.56, "end": 60.28, "text": "让她多和娇娇玩一玩"}, {"start": 61.74, "end": 62.9, "text": "就你那反应"}, {"start": 63.22, "end": 65.3, "text": "那是盼着我家无阳好的意思吗"}, {"start": 66.18, "end": 68.62, "text": "而且无阳明明是和悠悠玩得好"}, {"start": 69.46, "end": 72.34, "text": "为什么要让她和满嘴谎话的陪娇娇玩"}, {"start": 72.7, "end": 73.78, "text": "几位施主"}, {"start": 74.06, "end": 76.5, "text": "常常今年的明前新茶"}, {"start": 77.06, "end": 78.06, "text": "妙空大师"}, {"start": 78.58, "end": 79.9, "text": "我就开门见山了"}, {"start": 80.62, "end": 81.54, "text": "我想问问"}, {"start": 81.98, "end": 83.38, "text": "若是恩人还在世"}, {"start": 83.74, "end": 85.74, "text": "能为对方宿相共奉相活吗"}, {"start": 85.74, "end": 88.54, "text": "夫人一片报恩之心实为大善"}, {"start": 88.9, "end": 91.7, "text": "但为活人宿相相当于见生慈"}, {"start": 92.06, "end": 93.5, "text": "若是命格太弱"}, {"start": 93.54, "end": 95.18, "text": "恐有折瘦风险啊"}, {"start": 95.75, "end": 97.99, "text": "不如夫人立一块长生牌位"}, {"start": 98.23, "end": 100.71, "text": "为其祈求福寿以表感激"}, {"start": 101.03, "end": 102.59, "text": "多谢大师指点迷津"}, {"start": 103.07, "end": 104.39, "text": "那就立长生牌位"}, {"start": 106.03, "end": 108.55, "text": "到底是谁对应家有这么大的恩德"}, {"start": 112.19, "end": 115.63, "text": "请夫人在纸上写下恩人的性命"}]}