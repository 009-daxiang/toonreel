{"file": "乡下来的掌上明珠-第35集.mp4", "ep": 35, "duration": 79.1, "segments": [{"start": 0.0, "end": 2.0, "text": "越過面面的高山"}, {"start": 2.0, "end": 4.0, "text": "越過五金的滄海"}, {"start": 4.0, "end": 5.0, "text": "哎呀好好好"}, {"start": 5.0, "end": 7.0, "text": "我們悠悠可真棒"}, {"start": 7.0, "end": 9.1, "text": "好孩子拿去玩"}, {"start": 9.1, "end": 10.1, "text": "是亮晶晶"}, {"start": 10.1, "end": 11.1, "text": "喜不喜歡"}, {"start": 11.1, "end": 12.1, "text": "嗯"}, {"start": 12.1, "end": 13.1, "text": "謝謝姑奶"}, {"start": 13.1, "end": 14.1, "text": "姑奶你真好"}, {"start": 14.1, "end": 16.1, "text": "悠悠給你再表演一首"}, {"start": 16.1, "end": 18.1, "text": "呦還買一送一呢"}, {"start": 18.1, "end": 20.1, "text": "那大金爪子又粗又厚"}, {"start": 20.1, "end": 21.1, "text": "一看就是實心的"}, {"start": 21.1, "end": 22.1, "text": "估計得一百多克"}, {"start": 22.1, "end": 24.1, "text": "真是便宜了那個小土包子"}, {"start": 24.1, "end": 25.1, "text": "嗯"}, {"start": 25.1, "end": 32.5, "text": "劉大"}, {"start": 32.5, "end": 33.5, "text": "戲呢"}, {"start": 33.5, "end": 34.5, "text": "哎呦喂"}, {"start": 34.5, "end": 35.5, "text": "唱得有模有樣呢"}, {"start": 35.5, "end": 37.5, "text": "這麼小的年紀"}, {"start": 37.5, "end": 39.5, "text": "土自這麼清楚啊"}, {"start": 39.5, "end": 40.72, "text": "別說"}, {"start": 40.72, "end": 41.72, "text": "還挺可愛"}, {"start": 41.72, "end": 50.41, "text": "小丫頭不得了啊"}, {"start": 50.41, "end": 51.41, "text": "老培啊"}, {"start": 51.41, "end": 52.41, "text": "你們家這小寶貝"}, {"start": 52.41, "end": 53.41, "text": "太好玩了"}, {"start": 53.41, "end": 54.41, "text": "孩子"}, {"start": 54.41, "end": 55.41, "text": "舅爺啥都沒有"}, {"start": 55.41, "end": 57.41, "text": "就是房子多"}, {"start": 57.41, "end": 58.41, "text": "舅爺有一套"}, {"start": 58.41, "end": 59.41, "text": "郊區的別墅"}, {"start": 59.41, "end": 60.41, "text": "這就過戶給你"}, {"start": 60.41, "end": 61.41, "text": "謝謝舅爺"}, {"start": 61.41, "end": 62.41, "text": "呦"}, {"start": 62.41, "end": 63.41, "text": "你還知道"}, {"start": 63.41, "end": 64.41, "text": "我是你舅爺"}, {"start": 64.41, "end": 65.41, "text": "那我考考你"}, {"start": 65.41, "end": 66.41, "text": "這是誰"}, {"start": 66.41, "end": 68.41, "text": "是二爺爺"}, {"start": 68.41, "end": 69.41, "text": "這個呢"}, {"start": 69.41, "end": 73.9, "text": "他們倆呢"}, {"start": 73.9, "end": 76.34, "text": "阿娜"}]}