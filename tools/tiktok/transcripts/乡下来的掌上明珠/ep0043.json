{"file": "乡下来的掌上明珠-第43集.mp4", "ep": 43, "duration": 83.0, "segments": [{"start": 7.31, "end": 7.99, "text": "王警官"}, {"start": 8.47, "end": 9.19, "text": "我建议查一下"}, {"start": 9.19, "end": 10.35, "text": "王妈的手机购物记录"}, {"start": 15.76, "end": 16.24, "text": "女士"}, {"start": 16.6, "end": 17.92, "text": "请配合我们检查手机"}, {"start": 19.76, "end": 20.48, "text": "凭什么"}, {"start": 20.8, "end": 21.64, "text": "如果你拒绝"}, {"start": 22.0, "end": 23.12, "text": "我们只能请你回警局"}, {"start": 23.12, "end": 23.72, "text": "配合调查"}, {"start": 25.98, "end": 26.58, "text": "王妈"}, {"start": 27.06, "end": 28.06, "text": "你该不会真的"}, {"start": 28.06, "end": 28.5, "text": "夫人"}, {"start": 28.5, "end": 33.51, "text": "手机交出来"}, {"start": 39.85, "end": 40.81, "text": "谁能解释一下这个"}, {"start": 41.29, "end": 42.21, "text": "强力劳手药"}, {"start": 42.49, "end": 43.77, "text": "购买日期就是一个月前"}, {"start": 43.89, "end": 44.85, "text": "收获人王秀芬"}, {"start": 45.13, "end": 49.34, "text": "她那些野猫围狗太脏了"}, {"start": 49.34, "end": 50.62, "text": "怕他们伤到娇娇小姐"}, {"start": 50.62, "end": 51.93, "text": "我是为了要小姐呀"}, {"start": 51.93, "end": 52.41, "text": "王妈"}, {"start": 52.41, "end": 52.85, "text": "你"}, {"start": 52.85, "end": 54.05, "text": "你怎么能做出这种事"}, {"start": 54.05, "end": 55.09, "text": "要是伤到孩子怎么办"}, {"start": 55.09, "end": 55.73, "text": "娇娇小姐"}, {"start": 55.73, "end": 56.29, "text": "您帮我说"}, {"start": 61.8, "end": 62.44, "text": "王秀芬"}, {"start": 62.84, "end": 64.08, "text": "你涉嫌连环投毒案"}, {"start": 64.6, "end": 65.72, "text": "现在请你跟我们回警局"}, {"start": 65.72, "end": 66.4, "text": "协助调查"}]}