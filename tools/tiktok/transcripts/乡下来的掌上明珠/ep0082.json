{"file": "乡下来的掌上明珠-第82集.mp4", "ep": 82, "duration": 74.9, "segments": [{"start": 0.0, "end": 2.48, "text": "哥哥 要由自己走"}, {"start": 4.4, "end": 6.52, "text": "我就是个连妹妹都抱不了的废物"}, {"start": 6.52, "end": 8.4, "text": "哥哥 痛痛"}, {"start": 9.54, "end": 10.66, "text": "阿姨 不用"}, {"start": 11.06, "end": 11.98, "text": "我自己可以的"}, {"start": 11.98, "end": 14.98, "text": "超绝敏感机 又开始敏感喽"}, {"start": 15.26, "end": 17.78, "text": "小野 这么大了还要哥哥抱啊"}, {"start": 18.06, "end": 19.02, "text": "怎么是你"}, {"start": 19.42, "end": 20.98, "text": "哥哥想你和悠悠了呀"}, {"start": 21.52, "end": 23.97, "text": "三哥悠悠呀"}, {"start": 23.97, "end": 24.69, "text": "真乖"}, {"start": 25.09, "end": 27.17, "text": "还是香香软软的妹妹比较可爱"}, {"start": 27.37, "end": 29.89, "text": "怀里抽抽阴影的弟弟真想挂着我回收了"}, {"start": 30.33, "end": 30.93, "text": "上来"}, {"start": 31.37, "end": 32.05, "text": "哥背你"}, {"start": 32.25, "end": 33.01, "text": "不需要"}, {"start": 33.37, "end": 36.29, "text": "哇 原来我们牧野不喜欢背"}, {"start": 36.57, "end": 38.45, "text": "喜欢被哥扛在尖上啊"}, {"start": 38.45, "end": 39.85, "text": "你短句看多了吧你"}, {"start": 40.05, "end": 42.33, "text": "什么 更喜欢公主抱啊"}, {"start": 42.33, "end": 44.01, "text": "OK 哥满足你"}, {"start": 44.01, "end": 45.21, "text": "这不哀老年"}, {"start": 45.21, "end": 46.33, "text": "最后一次机会"}, {"start": 46.57, "end": 48.13, "text": "选公主抱还是背你"}, {"start": 48.37, "end": 50.33, "text": "小样 还治不了你"}, {"start": 50.49, "end": 52.7, "text": "哥 我回家啦"}, {"start": 52.7, "end": 54.3, "text": "悠悠会想你啦"}, {"start": 54.3, "end": 55.5, "text": "你乖乖哦"}, {"start": 55.78, "end": 56.86, "text": "不许牵黄毛的手"}, {"start": 56.86, "end": 58.26, "text": "松开 给我松开"}, {"start": 58.26, "end": 60.06, "text": "你们几个 快回家吧"}, {"start": 60.5, "end": 63.34, "text": "阿戴 你在天日灵看到了吗"}, {"start": 64.06, "end": 67.46, "text": "你的女儿遇到了偏心的爷爷奶奶"}, {"start": 68.06, "end": 70.54, "text": "好在也遇到了宠她护她的哥哥"}, {"start": 71.72, "end": 73.16, "text": "有爱她的家人"}, {"start": 73.52, "end": 74.68, "text": "那才是家"}]}