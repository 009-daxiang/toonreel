{"file": "乡下来的掌上明珠-第42集.mp4", "ep": 42, "duration": 68.6, "segments": [{"start": 1.01, "end": 1.65, "text": "女士"}, {"start": 2.21, "end": 3.81, "text": "你似乎很不想让我们进去"}, {"start": 4.56, "end": 5.2, "text": "哥哥"}, {"start": 5.4, "end": 7.48, "text": "王妈为什么留这么多汉呀"}, {"start": 7.64, "end": 8.88, "text": "可能是心虚吧"}, {"start": 9.4, "end": 10.03, "text": "四少"}, {"start": 10.23, "end": 11.62, "text": "挂是什么意思"}, {"start": 11.86, "end": 13.42, "text": "既然悠悠都止了"}, {"start": 13.62, "end": 15.42, "text": "就让景观进去看看吧"}, {"start": 15.78, "end": 16.94, "text": "轻者自轻"}, {"start": 17.14, "end": 18.06, "text": "怕什么呢"}, {"start": 18.42, "end": 19.1, "text": "是啊"}, {"start": 19.34, "end": 21.3, "text": "进去看看不就真相大白了"}, {"start": 22.41, "end": 23.25, "text": "王景观"}, {"start": 23.53, "end": 24.25, "text": "你们请"}, {"start": 24.69, "end": 25.37, "text": "不"}, {"start": 25.85, "end": 30.88, "text": "初步判断"}, {"start": 31.08, "end": 32.04, "text": "应该是老鼠药"}, {"start": 32.36, "end": 32.84, "text": "小张"}, {"start": 33.0, "end": 33.68, "text": "拿证物袋"}, {"start": 33.84, "end": 34.84, "text": "带回去检测一下"}, {"start": 35.24, "end": 35.76, "text": "好的"}, {"start": 36.12, "end": 38.67, "text": "她怎么回事"}, {"start": 48.02, "end": 48.74, "text": "娇娇小姐"}, {"start": 48.9, "end": 50.11, "text": "我 我"}, {"start": 50.35, "end": 50.87, "text": "女士"}, {"start": 51.11, "end": 51.99, "text": "你能解释一下"}, {"start": 52.23, "end": 54.03, "text": "为什么你家储物监里会有老鼠药吗"}, {"start": 54.23, "end": 56.26, "text": "悠悠从乡下带来的"}, {"start": 56.26, "end": 57.66, "text": "她怪我"}, {"start": 57.66, "end": 58.22, "text": "王妈"}, {"start": 58.38, "end": 59.26, "text": "你还要不要脸"}, {"start": 59.78, "end": 60.74, "text": "悠悠才三岁半"}, {"start": 60.94, "end": 61.82, "text": "她怎么陷害你"}, {"start": 62.3, "end": 62.9, "text": "是啊"}, {"start": 63.54, "end": 65.1, "text": "也许是悠悠"}, {"start": 65.46, "end": 65.98, "text": "奶奶"}, {"start": 66.18, "end": 66.9, "text": "到了现在"}, {"start": 67.14, "end": 68.5, "text": "你还觉得是悠悠的错吗"}]}