{"file": "我就是丧尸之王-第153集.mp4", "ep": 153, "duration": 40.8, "segments": [{"start": 5.97, "end": 6.69, "text": "老人家"}, {"start": 6.69, "end": 7.77, "text": "请问还要等多久"}, {"start": 7.77, "end": 9.01, "text": "才会分住宿房间"}, {"start": 9.41, "end": 10.73, "text": "这里没有住宿"}, {"start": 10.73, "end": 11.61, "text": "什么意思"}, {"start": 11.61, "end": 13.17, "text": "被送到这一层的人"}, {"start": 13.45, "end": 14.61, "text": "都是实验笔"}, {"start": 15.09, "end": 15.89, "text": "别胡说"}, {"start": 15.89, "end": 17.01, "text": "这里是官方基地"}, {"start": 17.01, "end": 18.09, "text": "我们是被救回来的"}, {"start": 18.09, "end": 19.09, "text": "不是小白鼠"}, {"start": 19.09, "end": 20.13, "text": "真要拿人做实验"}, {"start": 20.13, "end": 21.05, "text": "他们敢一次送进来"}, {"start": 21.05, "end": 21.77, "text": "这么多人"}, {"start": 22.42, "end": 23.9, "text": "可能只是检查项目多"}, {"start": 24.06, "end": 25.34, "text": "官方没有理由害我们"}, {"start": 26.21, "end": 27.29, "text": "安安再等一会儿"}, {"start": 27.49, "end": 28.29, "text": "检查完"}, {"start": 28.29, "end": 29.37, "text": "我们就去新房间"}, {"start": 30.16, "end": 31.36, "text": "第31号药门"}, {"start": 31.36, "end": 32.88, "text": "能量输入继续提升"}, {"start": 33.12, "end": 34.52, "text": "排一数值超过警戒"}, {"start": 34.52, "end": 35.56, "text": "接入刑合百应"}, {"start": 35.56, "end": 38.53, "text": "放开我"}]}