{"file": "我就是丧尸之王-第94集.mp4", "ep": 94, "duration": 45.1, "segments": [{"start": 0.0, "end": 2.44, "text": "吴勋曾经私下强迫并准备伤害你"}, {"start": 2.68, "end": 3.2, "text": "是"}, {"start": 3.76, "end": 4.84, "text": "如果不是催斩"}, {"start": 5.32, "end": 6.28, "text": "我已经死了"}, {"start": 6.68, "end": 8.64, "text": "一号目标从末日开始到现在"}, {"start": 8.76, "end": 10.08, "text": "能力增长得非常快"}, {"start": 10.2, "end": 11.68, "text": "快得不像正常艺能者"}, {"start": 12.24, "end": 13.44, "text": "他第一次出现时"}, {"start": 13.88, "end": 15.04, "text": "远没有现在强"}, {"start": 16.08, "end": 17.72, "text": "你不问我刚才哪一句是假话"}, {"start": 18.0, "end": 19.48, "text": "你和吴勋之间发生了什么"}, {"start": 19.48, "end": 20.2, "text": "是私人问题"}, {"start": 20.76, "end": 22.76, "text": "二队六队七队同时寻找一号"}, {"start": 22.96, "end": 23.72, "text": "只确认位置"}, {"start": 23.84, "end": 24.64, "text": "不得单独接触"}, {"start": 24.96, "end": 25.64, "text": "我关心的是"}, {"start": 25.64, "end": 26.68, "text": "一个能在极短时间内"}, {"start": 26.68, "end": 27.56, "text": "不断增加艺能"}, {"start": 27.64, "end": 28.92, "text": "还可以控制失去的目标"}, {"start": 29.0, "end": 30.12, "text": "会成长到什么程度"}, {"start": 30.4, "end": 31.04, "text": "队长说过"}, {"start": 31.64, "end": 32.36, "text": "如果他死了"}, {"start": 32.68, "end": 33.92, "text": "就把他葬在嫂子旁边"}, {"start": 34.12, "end": 35.08, "text": "现在是特殊时期"}, {"start": 35.36, "end": 36.4, "text": "遗体不能丝丝带离"}, {"start": 37.32, "end": 38.16, "text": "我负责转运"}, {"start": 38.44, "end": 39.6, "text": "也承担全部风险"}, {"start": 40.54, "end": 41.66, "text": "给他最后一点体面"}]}