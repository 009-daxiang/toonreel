{"file": "我就是丧尸之王-第28集.mp4", "ep": 28, "duration": 40.3, "segments": [{"start": 1.58, "end": 2.74, "text": "季川 等一下"}, {"start": 3.06, "end": 4.82, "text": "芸汐姐的异能还没弄明白呢"}, {"start": 6.18, "end": 7.46, "text": "昨晚露露的光剑"}, {"start": 7.62, "end": 8.7, "text": "还有你那团火"}, {"start": 8.94, "end": 10.1, "text": "真的是我造成的"}, {"start": 10.62, "end": 11.66, "text": "试一次就知道了"}, {"start": 12.93, "end": 14.81, "text": "露露只用最小的力量"}, {"start": 15.17, "end": 27.5, "text": "所以我的异能"}, {"start": 28.1, "end": 29.67, "text": "真是把剑变出"}, {"start": 31.63, "end": 32.19, "text": "再看"}, {"start": 32.51, "end": 39.84, "text": "我没有主动做什么"}]}