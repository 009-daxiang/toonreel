{"file": "我就是丧尸之王-第164集.mp4", "ep": 164, "duration": 40.4, "segments": [{"start": 0.0, "end": 1.0, "text": "袁宋他们"}, {"start": 1.52, "end": 2.64, "text": "一个都没回来"}, {"start": 2.8, "end": 3.52, "text": "我知道"}, {"start": 3.68, "end": 5.36, "text": "是我把他们带过去的"}, {"start": 7.4, "end": 8.32, "text": "先活下来"}, {"start": 8.93, "end": 9.89, "text": "该说的话"}, {"start": 10.05, "end": 11.09, "text": "我陪你去说"}, {"start": 12.26, "end": 13.74, "text": "是一号先攻击你们"}, {"start": 13.82, "end": 14.38, "text": "不是"}, {"start": 14.5, "end": 15.54, "text": "他先和我们沟通"}, {"start": 15.62, "end": 16.82, "text": "说只要我们不伤害他"}, {"start": 16.9, "end": 17.9, "text": "他就不会伤害我们"}, {"start": 17.98, "end": 18.94, "text": "是我先动手"}, {"start": 19.22, "end": 20.22, "text": "他躲避了一段时间"}, {"start": 20.3, "end": 21.18, "text": "才开始反击"}, {"start": 21.74, "end": 22.9, "text": "袁森没有预警"}, {"start": 23.18, "end": 24.14, "text": "他劝我撤退"}, {"start": 24.5, "end": 25.18, "text": "我没听"}, {"start": 25.34, "end": 25.9, "text": "首领"}, {"start": 26.14, "end": 26.98, "text": "是我太自大"}, {"start": 27.06, "end": 28.14, "text": "做出了错误判断"}, {"start": 28.38, "end": 29.94, "text": "六个人的死责任在我"}, {"start": 30.5, "end": 32.26, "text": "六名金河新人全部死亡"}, {"start": 32.78, "end": 34.42, "text": "另一名红河消耗四张牌"}, {"start": 34.5, "end": 35.5, "text": "才换回一个人"}, {"start": 36.21, "end": 37.05, "text": "你先去休息"}, {"start": 37.41, "end": 39.01, "text": "星河区和一号的处理方式"}, {"start": 39.09, "end": 40.05, "text": "我重新评估"}]}