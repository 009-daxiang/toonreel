{"file": "我就是丧尸之王-第13集.mp4", "ep": 13, "duration": 45.3, "segments": [{"start": 0.59, "end": 1.59, "text": "对不起"}, {"start": 1.59, "end": 3.59, "text": "我好像好心办坏事了"}, {"start": 3.59, "end": 6.85, "text": "附近有一家车行"}, {"start": 6.85, "end": 8.85, "text": "应该能找到轮胎和维修工具"}, {"start": 8.85, "end": 10.25, "text": "我带你去"}, {"start": 10.25, "end": 18.1, "text": "你到底是什么"}, {"start": 18.1, "end": 19.7, "text": "有意识的丧失"}, {"start": 19.7, "end": 22.94, "text": "你能听懂"}, {"start": 22.94, "end": 24.14, "text": "但还不能说话"}, {"start": 24.14, "end": 30.25, "text": "别往那边走"}, {"start": 30.25, "end": 33.93, "text": "那边全是丧失"}, {"start": 33.93, "end": 35.53, "text": "直接过去会被发现"}, {"start": 35.53, "end": 36.33, "text": "跟我走"}, {"start": 36.33, "end": 37.73, "text": "这边有条安全通道"}, {"start": 37.73, "end": 38.73, "text": "谢谢姐姐"}]}