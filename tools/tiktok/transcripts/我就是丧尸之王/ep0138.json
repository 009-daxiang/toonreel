{"file": "我就是丧尸之王-第138集.mp4", "ep": 138, "duration": 44.1, "segments": [{"start": 3.38, "end": 4.1, "text": "坐下"}, {"start": 7.74, "end": 8.7, "text": "手收回去"}, {"start": 9.1, "end": 10.1, "text": "没有我的命令"}, {"start": 10.34, "end": 11.58, "text": "不许再攻击他们"}, {"start": 15.06, "end": 15.94, "text": "我叫季川"}, {"start": 16.14, "end": 18.14, "text": "新河区复仇者兼基地的首领"}, {"start": 18.38, "end": 19.38, "text": "他是来找我的"}, {"start": 19.82, "end": 20.9, "text": "毁了你们的房子"}, {"start": 20.9, "end": 21.78, "text": "责任算我的"}, {"start": 22.22, "end": 23.1, "text": "你想怎么赔"}, {"start": 23.42, "end": 24.86, "text": "你们的安全物已经暴露"}, {"start": 25.45, "end": 26.61, "text": "跟我去奥利加尔"}, {"start": 26.81, "end": 28.01, "text": "那里有完整围墙"}, {"start": 28.01, "end": 28.97, "text": "食物和住处"}, {"start": 29.09, "end": 30.49, "text": "从没见过的红河"}, {"start": 31.02, "end": 31.9, "text": "直接夺取"}, {"start": 32.14, "end": 33.06, "text": "可能带来连我的"}, {"start": 33.06, "end": 34.18, "text": "无法预估的结果"}, {"start": 34.98, "end": 36.18, "text": "让它活着合作"}, {"start": 36.38, "end": 37.26, "text": "更有价值"}, {"start": 37.9, "end": 39.54, "text": "妈 这里守不住了"}, {"start": 40.02, "end": 40.74, "text": "你决定"}, {"start": 41.06, "end": 41.98, "text": "我跟你一起"}, {"start": 42.88, "end": 44.0, "text": "好 我们去"}]}