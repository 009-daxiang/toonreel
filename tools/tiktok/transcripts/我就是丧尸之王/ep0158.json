{"file": "我就是丧尸之王-第158集.mp4", "ep": 158, "duration": 41.8, "segments": [{"start": 2.16, "end": 2.88, "text": "小哥"}, {"start": 3.12, "end": 4.08, "text": "上面不安全"}, {"start": 4.44, "end": 5.24, "text": "需要我救你下來嗎"}, {"start": 5.24, "end": 5.6, "text": "隊長"}, {"start": 6.08, "end": 7.0, "text": "他不是"}, {"start": 7.44, "end": 9.57, "text": "你是喪屍"}, {"start": 9.89, "end": 10.41, "text": "是"}, {"start": 12.81, "end": 13.89, "text": "你們不攻擊我"}, {"start": 14.33, "end": 15.57, "text": "我也不會傷害你們"}, {"start": 16.01, "end": 17.3, "text": "可你是喪屍"}, {"start": 17.99, "end": 19.63, "text": "今天正好讓這些新人看看"}, {"start": 19.83, "end": 21.23, "text": "真正的強者怎麼戰鬥"}, {"start": 21.83, "end": 22.59, "text": "所以"}, {"start": 22.99, "end": 24.23, "text": "你還是要動手"}, {"start": 24.71, "end": 28.9, "text": "直接控制失敗"}, {"start": 29.57, "end": 31.93, "text": "能量和一直都沒被削弱的高階目標"}, {"start": 32.17, "end": 33.21, "text": "果然沒那麼容易"}, {"start": 35.69, "end": 36.29, "text": "所有人"}, {"start": 36.53, "end": 37.57, "text": "按訓練方案進攻"}]}