{"file": "我就是丧尸之王-第221集.mp4", "ep": 221, "duration": 41.2, "segments": [{"start": 0.37, "end": 1.17, "text": "没人错"}, {"start": 1.53, "end": 2.41, "text": "他就是阎光"}, {"start": 3.03, "end": 4.15, "text": "他批开酒店大门"}, {"start": 4.15, "end": 5.31, "text": "又第一个攻击首领"}, {"start": 5.63, "end": 6.87, "text": "所以被清除了记忆"}, {"start": 7.39, "end": 9.46, "text": "现在大家叫他土豆"}, {"start": 9.9, "end": 11.26, "text": "我们还能保留意识"}, {"start": 11.66, "end": 13.38, "text": "确实是首领手下留情"}, {"start": 13.62, "end": 14.94, "text": "不用一致我也知道"}, {"start": 15.34, "end": 16.26, "text": "以后还会在这里"}, {"start": 16.26, "end": 17.34, "text": "碰到熟面狗"}, {"start": 18.44, "end": 19.36, "text": "有些人在遇到"}, {"start": 19.36, "end": 20.6, "text": "更强的对手前"}, {"start": 21.27, "end": 23.07, "text": "永远觉得自己天下无敌"}, {"start": 27.86, "end": 29.02, "text": "正级攻击以前"}, {"start": 29.84, "end": 31.16, "text": "一号没有伤害任何人"}, {"start": 33.66, "end": 34.54, "text": "正级死后"}, {"start": 34.82, "end": 35.7, "text": "他解除重力"}, {"start": 36.02, "end": 37.02, "text": "放其余人离开"}, {"start": 38.0, "end": 38.72, "text": "所以"}, {"start": 39.28, "end": 41.0, "text": "你认为他不会主动杀人"}]}