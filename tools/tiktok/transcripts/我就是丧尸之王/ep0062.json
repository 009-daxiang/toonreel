{"file": "我就是丧尸之王-第62集.mp4", "ep": 62, "duration": 44.4, "segments": [{"start": 0.0, "end": 8.69, "text": "妈妈"}, {"start": 8.69, "end": 9.89, "text": "这个卦尸"}, {"start": 9.89, "end": 12.8, "text": "是小萱亲手卦在她爸爸包上的"}, {"start": 12.8, "end": 13.71, "text": "爸爸的宝"}, {"start": 13.71, "end": 16.78, "text": "爸爸"}, {"start": 16.78, "end": 18.14, "text": "你在哪里见到她的"}, {"start": 18.14, "end": 19.46, "text": "她还活着吗"}, {"start": 19.46, "end": 23.29, "text": "她已经死了"}, {"start": 23.29, "end": 26.62, "text": "临死前"}, {"start": 26.62, "end": 28.22, "text": "她托我把物资带回来"}, {"start": 28.22, "end": 36.08, "text": "先住这里"}, {"start": 36.08, "end": 36.96, "text": "门所没有坏"}, {"start": 36.96, "end": 37.92, "text": "食物也留给你们"}, {"start": 37.92, "end": 39.16, "text": "你已经救了我们两次"}, {"start": 39.16, "end": 40.72, "text": "我不知道还能怎么献你"}, {"start": 40.72, "end": 41.88, "text": "活下去再说"}]}