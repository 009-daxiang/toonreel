{"file": "我就是丧尸之王-第4集.mp4", "ep": 4, "duration": 132.5, "segments": [{"start": 1.39, "end": 2.71, "text": "金色金河"}, {"start": 3.19, "end": 4.19, "text": "只要杀了她"}, {"start": 4.27, "end": 5.07, "text": "就能拿到"}, {"start": 6.07, "end": 10.35, "text": "她没害过我"}, {"start": 10.43, "end": 28.27, "text": "漂亮女生的属性点"}, {"start": 28.67, "end": 29.83, "text": "都加美貌了"}, {"start": 30.35, "end": 36.34, "text": "你不喜欢"}, {"start": 36.54, "end": 43.06, "text": "再说下去"}, {"start": 43.3, "end": 44.95, "text": "我真要改变主意了"}, {"start": 45.35, "end": 56.04, "text": "车先借我"}, {"start": 56.59, "end": 58.23, "text": "你的金河我不要"}, {"start": 58.67, "end": 63.02, "text": "我没死"}, {"start": 64.02, "end": 65.46, "text": "那只丧尸没吃我"}, {"start": 65.54, "end": 66.98, "text": "只是抢走了我的车"}, {"start": 67.22, "end": 68.58, "text": "丧尸还会开车"}, {"start": 68.86, "end": 71.22, "text": "好像是小区里的邻居"}, {"start": 71.42, "end": 72.34, "text": "车也没了"}, {"start": 72.42, "end": 73.54, "text": "食物也没了"}, {"start": 73.82, "end": 74.82, "text": "我怎么出去"}, {"start": 77.33, "end": 78.17, "text": "这座城"}, {"start": 78.75, "end": 80.51, "text": "现在倒想只为我开放"}, {"start": 80.75, "end": 97.8, "text": "只要金河足够多"}, {"start": 98.32, "end": 99.6, "text": "我就能一直变强"}, {"start": 99.84, "end": 114.38, "text": "车不是白借的"}, {"start": 114.58, "end": 121.14, "text": "丧尸"}, {"start": 121.38, "end": 122.41, "text": "还会长腿"}, {"start": 122.77, "end": 125.01, "text": "让我开门"}, {"start": 126.14, "end": 127.42, "text": "她要真想吃我"}, {"start": 127.86, "end": 129.66, "text": "白天我晕倒时就已经动手了"}]}