{"file": "我就是丧尸之王-第151集.mp4", "ep": 151, "duration": 43.5, "segments": [{"start": 0.0, "end": 1.32, "text": "只要公开确切地址"}, {"start": 1.8, "end": 3.44, "text": "江华基地一定会来核查"}, {"start": 4.4, "end": 5.4, "text": "他们再厉害"}, {"start": 5.56, "end": 6.6, "text": "能有基川厉害"}, {"start": 7.71, "end": 9.47, "text": "我以前只是前线探察队长"}, {"start": 9.99, "end": 11.63, "text": "真正战斗部队的高级能力"}, {"start": 11.87, "end": 13.15, "text": "大多数于保密信息"}, {"start": 13.59, "end": 14.79, "text": "连我也不知道全貌"}, {"start": 15.15, "end": 16.67, "text": "现在基地又在吸收新人"}, {"start": 16.91, "end": 18.47, "text": "能调动的人只会越来越多"}, {"start": 19.1, "end": 20.38, "text": "我们没必要主动把门牌"}, {"start": 20.38, "end": 21.26, "text": "送到他们手里"}, {"start": 22.93, "end": 23.81, "text": "地址不公开"}, {"start": 24.21, "end": 25.37, "text": "有人自己找到这里"}, {"start": 25.57, "end": 26.45, "text": "再核实身份"}, {"start": 27.25, "end": 28.25, "text": "招募信息取消"}, {"start": 30.49, "end": 31.01, "text": "姓名"}, {"start": 31.17, "end": 31.65, "text": "周弥"}, {"start": 31.97, "end": 33.21, "text": "这是我女儿周宇安"}, {"start": 33.53, "end": 34.05, "text": "艺能"}, {"start": 34.33, "end": 35.13, "text": "我每次醒来"}, {"start": 35.13, "end": 36.41, "text": "都能准确知道现在几点"}, {"start": 37.79, "end": 38.35, "text": "孩子呢"}, {"start": 38.67, "end": 39.71, "text": "安安不用死放水"}, {"start": 39.91, "end": 40.95, "text": "也能直接吹出泡泡"}]}