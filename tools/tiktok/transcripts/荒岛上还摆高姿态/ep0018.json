{"file": "荒岛上还摆高姿态-第18集.mp4", "ep": 18, "duration": 42.1, "segments": [{"start": 5.9, "end": 7.42, "text": "十几个人抓一只兔"}, {"start": 7.42, "end": 8.58, "text": "差点累死了"}, {"start": 8.58, "end": 11.22, "text": "这么大"}, {"start": 11.22, "end": 12.22, "text": "少得意"}, {"start": 12.22, "end": 13.26, "text": "这么大一只羊"}, {"start": 13.26, "end": 14.98, "text": "谁知道是不是本来就受伤了"}, {"start": 14.98, "end": 16.02, "text": "被你摆检的"}, {"start": 16.02, "end": 16.46, "text": "对"}, {"start": 16.46, "end": 17.22, "text": "我运气好"}, {"start": 17.22, "end": 18.26, "text": "你们运气也不错"}, {"start": 18.26, "end": 19.82, "text": "十几个人为一只兔"}, {"start": 19.82, "end": 21.46, "text": "又是石头又是木棍"}, {"start": 21.46, "end": 22.34, "text": "有人崴脚"}, {"start": 22.34, "end": 23.54, "text": "有人沾一手屎"}, {"start": 23.54, "end": 24.66, "text": "最后居然赢了"}, {"start": 24.66, "end": 25.66, "text": "值得庆祝"}, {"start": 25.66, "end": 26.82, "text": "别说了"}, {"start": 26.82, "end": 28.06, "text": "我突然觉得这兔子"}, {"start": 28.06, "end": 29.46, "text": "吃着都有点丢人"}, {"start": 31.37, "end": 32.29, "text": "晚上给我留点"}, {"start": 32.29, "end": 33.53, "text": "先把今天的活干完"}, {"start": 33.53, "end": 34.05, "text": "行"}, {"start": 34.7, "end": 36.34, "text": "你们两个什么时候这么熟了"}, {"start": 36.34, "end": 36.9, "text": "怎么"}, {"start": 36.9, "end": 38.14, "text": "我跟谁说句话"}, {"start": 38.14, "end": 39.42, "text": "还得先给你打报告"}, {"start": 39.42, "end": 40.82, "text": "你什么时候当上岛主了"}]}