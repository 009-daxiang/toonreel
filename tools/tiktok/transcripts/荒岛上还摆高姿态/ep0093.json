{"file": "荒岛上还摆高姿态-第93集.mp4", "ep": 93, "duration": 79.5, "segments": [{"start": 2.03, "end": 3.19, "text": "又来炫耀"}, {"start": 3.63, "end": 4.95, "text": "听说你是建筑设计师"}, {"start": 5.27, "end": 6.27, "text": "是 怎么了"}, {"start": 6.55, "end": 7.83, "text": "我准备建长期住房"}, {"start": 7.83, "end": 8.79, "text": "这只鸡当定金"}, {"start": 8.79, "end": 9.47, "text": "你出设计"}, {"start": 9.87, "end": 10.51, "text": "赵然姐"}, {"start": 10.51, "end": 11.71, "text": "你真是建筑设计师"}, {"start": 12.07, "end": 12.91, "text": "我学建筑"}, {"start": 12.91, "end": 14.11, "text": "后来一直做商业空间"}, {"start": 14.11, "end": 14.83, "text": "和民宿设计"}, {"start": 14.83, "end": 15.95, "text": "之前岛上没材料"}, {"start": 15.95, "end": 16.67, "text": "说了也没用"}, {"start": 16.67, "end": 18.15, "text": "现在有毛筑 木料"}, {"start": 18.15, "end": 19.07, "text": "松纸和山洞"}, {"start": 19.07, "end": 20.03, "text": "我要做长期住处"}, {"start": 20.59, "end": 21.95, "text": "防潮 防雨"}, {"start": 22.43, "end": 22.95, "text": "耐大风"}, {"start": 23.76, "end": 25.0, "text": "面积 住几个人"}, {"start": 25.0, "end": 25.76, "text": "汤处多少"}, {"start": 26.08, "end": 26.88, "text": "火源放哪里"}, {"start": 26.88, "end": 28.4, "text": "地势颇渡我必须现场看"}, {"start": 28.96, "end": 30.0, "text": "现在就能开始"}, {"start": 30.0, "end": 31.04, "text": "不看场地"}, {"start": 31.2, "end": 32.68, "text": "我只能给你画纸上谈兵"}, {"start": 35.42, "end": 36.66, "text": "这是专业服务定金"}, {"start": 36.94, "end": 38.46, "text": "你用面膜换人帮你装海水"}, {"start": 38.46, "end": 39.5, "text": "和我用设计换食物"}, {"start": 39.5, "end": 40.14, "text": "有什么区别"}, {"start": 40.14, "end": 41.14, "text": "后续报酬怎么算"}, {"start": 41.38, "end": 42.54, "text": "成稿满意再结一笔"}, {"start": 42.82, "end": 43.7, "text": "施工验收令算"}, {"start": 43.7, "end": 45.54, "text": "设计调整和施工错误要分开"}, {"start": 45.54, "end": 45.94, "text": "可以"}, {"start": 46.81, "end": 47.33, "text": "成交"}, {"start": 49.89, "end": 51.09, "text": "这里不能直接贴地剑"}, {"start": 51.49, "end": 52.09, "text": "暴雨一来"}, {"start": 52.09, "end": 53.41, "text": "山上的水会往这边回"}, {"start": 53.53, "end": 54.61, "text": "主体至少抬高"}, {"start": 54.77, "end": 55.57, "text": "先做排水工"}, {"start": 55.57, "end": 56.17, "text": "屋顶呢"}, {"start": 56.77, "end": 57.41, "text": "大坡顶"}, {"start": 57.61, "end": 58.49, "text": "迎风面压低"}, {"start": 58.49, "end": 59.37, "text": "竹墙做双层"}, {"start": 59.37, "end": 60.65, "text": "关键接缝再用松枝"}, {"start": 62.02, "end": 62.98, "text": "山洞做仓库"}, {"start": 63.02, "end": 63.78, "text": "外面接主屋"}, {"start": 63.78, "end": 65.02, "text": "火区和睡眠区分开"}, {"start": 65.42, "end": 66.1, "text": "人手多少"}, {"start": 66.26, "end": 67.14, "text": "至少二十人分组"}, {"start": 67.14, "end": 68.18, "text": "主粮 批主"}, {"start": 68.18, "end": 69.06, "text": "边墙 屋顶"}, {"start": 69.06, "end": 69.94, "text": "搬运分别做"}, {"start": 70.22, "end": 71.26, "text": "不能全挤一件事"}, {"start": 73.53, "end": 74.57, "text": "你不是缺材料"}, {"start": 74.57, "end": 75.81, "text": "你缺组织施工"}, {"start": 76.21, "end": 77.21, "text": "这个我刚好有办法"}, {"start": 77.98, "end": 79.42, "text": "明天开始招建筑工"}]}