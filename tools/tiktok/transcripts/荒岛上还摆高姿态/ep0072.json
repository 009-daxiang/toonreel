{"file": "荒岛上还摆高姿态-第72集.mp4", "ep": 72, "duration": 67.5, "segments": [{"start": 0.0, "end": 1.64, "text": "宿车真没给带回来的肉"}, {"start": 1.64, "end": 2.24, "text": "没有"}, {"start": 2.24, "end": 3.28, "text": "但他说明白了"}, {"start": 3.28, "end": 4.4, "text": "以后想拿资源"}, {"start": 4.4, "end": 5.24, "text": "就去干活"}, {"start": 5.24, "end": 6.64, "text": "而且下一步他他要盖房"}, {"start": 6.64, "end": 7.64, "text": "需要大量人手"}, {"start": 7.64, "end": 8.72, "text": "至少在他那边"}, {"start": 8.72, "end": 9.48, "text": "干多少"}, {"start": 9.48, "end": 10.88, "text": "拿多少先讲清楚"}, {"start": 10.88, "end": 13.24, "text": "给一个男人干半天活"}, {"start": 13.24, "end": 14.12, "text": "吃顿肉"}, {"start": 14.12, "end": 15.48, "text": "就把你们收买了"}, {"start": 15.48, "end": 17.68, "text": "你们还真廉价"}, {"start": 17.68, "end": 19.24, "text": "连不廉价先不说"}, {"start": 19.24, "end": 20.76, "text": "我至少吃饱了"}, {"start": 20.76, "end": 22.36, "text": "你这边倒挺高贵"}, {"start": 22.36, "end": 24.36, "text": "高贵到晚饭还不知道在哪"}, {"start": 25.95, "end": 26.79, "text": "我只知道"}, {"start": 26.79, "end": 28.07, "text": "我今天干了多少"}, {"start": 28.07, "end": 29.11, "text": "吃了多少"}, {"start": 29.19, "end": 30.11, "text": "谁都没零食"}, {"start": 30.11, "end": 30.91, "text": "扣我一颗"}, {"start": 31.9, "end": 37.11, "text": "还不够了"}, {"start": 37.11, "end": 38.35, "text": "不是柴的问题"}, {"start": 38.35, "end": 39.35, "text": "火种太弱"}, {"start": 39.35, "end": 40.31, "text": "再灭一次"}, {"start": 40.31, "end": 42.23, "text": "今晚就只能重新找血压"}, {"start": 42.23, "end": 43.47, "text": "想接火也行"}, {"start": 43.47, "end": 45.11, "text": "明天替我装两套海水"}, {"start": 45.11, "end": 46.47, "text": "我们今天累了一整天"}, {"start": 46.47, "end": 47.55, "text": "火不止它有"}, {"start": 47.55, "end": 48.15, "text": "菲姐"}, {"start": 48.15, "end": 49.11, "text": "你是说"}, {"start": 49.11, "end": 50.95, "text": "宿车你要去找他借"}, {"start": 50.95, "end": 51.51, "text": "对"}, {"start": 51.51, "end": 52.55, "text": "他不会摆给"}, {"start": 52.55, "end": 53.71, "text": "所以我去谈"}, {"start": 53.71, "end": 54.47, "text": "去啊"}, {"start": 54.47, "end": 55.47, "text": "我倒要看看"}, {"start": 55.47, "end": 57.03, "text": "宿车能不能摆给你火"}, {"start": 57.03, "end": 58.63, "text": "别等会儿又被人赶回来"}, {"start": 58.63, "end": 60.39, "text": "还得求我点达达火鸡"}, {"start": 60.39, "end": 61.59, "text": "至少我去之前"}, {"start": 61.59, "end": 62.79, "text": "就知道要付代价"}, {"start": 62.83, "end": 63.99, "text": "不像有些人"}, {"start": 63.99, "end": 65.47, "text": "先说全女家庭"}, {"start": 65.47, "end": 66.87, "text": "后面什么都拿来卡自己"}]}