{"file": "大将军扛楼养活百万大军-第23集.mp4", "ep": 23, "duration": 58.5, "segments": [{"start": 0.0, "end": 1.04, "text": "二十五分钟"}, {"start": 1.52, "end": 3.44, "text": "应该最迟四十分钟就能起来"}, {"start": 3.68, "end": 4.64, "text": "咱们再等等吧"}, {"start": 5.12, "end": 6.64, "text": "就是不知道能不能捞上来"}, {"start": 10.42, "end": 11.3, "text": "你怎么上来了"}, {"start": 11.54, "end": 12.66, "text": "不是让你给我们发信号"}, {"start": 12.66, "end": 13.66, "text": "我们把你拉起来吗"}, {"start": 17.11, "end": 18.63, "text": "我绑好了 你们拉吧"}, {"start": 18.79, "end": 20.43, "text": "这才二十多分钟就能绑好"}, {"start": 20.51, "end": 21.83, "text": "快 启动机器"}, {"start": 26.04, "end": 26.88, "text": "确实绑好了"}, {"start": 33.74, "end": 34.86, "text": "厉害啊 兄弟"}, {"start": 34.86, "end": 35.46, "text": "来来来"}, {"start": 35.66, "end": 36.58, "text": "把这衣服给换了"}, {"start": 36.58, "end": 37.54, "text": "进办公室里去"}, {"start": 37.66, "end": 38.62, "text": "我给你喝点茶"}, {"start": 38.7, "end": 39.54, "text": "辛苦了"}, {"start": 39.7, "end": 40.82, "text": "等会还得给你钱呢"}, {"start": 42.26, "end": 45.85, "text": "笑哥 你可吓死我了"}, {"start": 45.85, "end": 46.69, "text": "没事"}, {"start": 46.69, "end": 48.25, "text": "跟你说了我水性好"}, {"start": 48.57, "end": 51.94, "text": "兄弟 签个名吧"}, {"start": 52.5, "end": 53.82, "text": "这笔钱有个出处"}, {"start": 53.82, "end": 55.7, "text": "你签了名就可以拿走了"}, {"start": 56.1, "end": 56.9, "text": "没毛笔吗"}, {"start": 57.1, "end": 57.9, "text": "毛笔"}]}