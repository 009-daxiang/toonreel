{"file": "大将军扛楼养活百万大军-第72集.mp4", "ep": 72, "duration": 69.9, "segments": [{"start": 0.0, "end": 0.6, "text": "肖将军"}, {"start": 0.6, "end": 0.88, "text": "对"}, {"start": 0.88, "end": 2.08, "text": "我们是前往沙洲城的"}, {"start": 2.08, "end": 2.8, "text": "走 上马"}, {"start": 2.8, "end": 4.16, "text": "我带你们回沙洲城"}, {"start": 4.16, "end": 5.24, "text": "这个能做吗"}, {"start": 5.24, "end": 6.56, "text": "岌岌应该可以了"}, {"start": 6.56, "end": 8.08, "text": "这能带得起我们吗"}, {"start": 8.08, "end": 8.88, "text": "此乃铁马"}, {"start": 8.88, "end": 10.04, "text": "不可以以长马肚子"}, {"start": 10.04, "end": 10.88, "text": "老丈 坐好了"}, {"start": 10.88, "end": 11.56, "text": "我们可要走了"}, {"start": 11.56, "end": 12.32, "text": "好 我去"}, {"start": 13.38, "end": 14.18, "text": "这是什么马"}, {"start": 14.18, "end": 15.58, "text": "此为铁马是神仙之物也"}, {"start": 15.58, "end": 16.5, "text": "不用吃草不用喝水"}, {"start": 16.5, "end": 17.34, "text": "以神一由为之"}, {"start": 17.34, "end": 18.7, "text": "一个时辰可行使两三百里"}, {"start": 18.7, "end": 20.02, "text": "这天底下竟然还有这种东西"}, {"start": 20.02, "end": 21.66, "text": "两人出去几个时辰了"}, {"start": 21.66, "end": 22.82, "text": "可是刘三和肖将军"}, {"start": 22.82, "end": 23.94, "text": "却依旧还没回来"}, {"start": 23.94, "end": 24.66, "text": "要是肖将军"}, {"start": 24.66, "end": 25.74, "text": "他们遇到楼局大军"}, {"start": 25.74, "end": 26.9, "text": "可就很难搞了"}, {"start": 26.9, "end": 28.48, "text": "范先生您看"}, {"start": 28.48, "end": 30.75, "text": "是肖将军回来了"}, {"start": 30.75, "end": 35.73, "text": "开门"}, {"start": 35.73, "end": 36.65, "text": "范先生"}, {"start": 36.65, "end": 37.49, "text": "你安排好他们吧"}, {"start": 37.49, "end": 38.41, "text": "放心"}, {"start": 38.41, "end": 39.29, "text": "我会安排好他们的"}, {"start": 39.29, "end": 40.13, "text": "肖将军"}, {"start": 40.13, "end": 41.37, "text": "多谢救命之恩"}, {"start": 41.37, "end": 42.13, "text": "不用谢我"}, {"start": 42.13, "end": 43.65, "text": "既然来到我们沙洲城"}, {"start": 43.65, "end": 44.89, "text": "我希望你也能为沙洲城"}, {"start": 44.89, "end": 45.81, "text": "出一份力"}, {"start": 45.81, "end": 46.69, "text": "不要以为沙洲城"}, {"start": 46.69, "end": 47.29, "text": "就安全了"}, {"start": 47.29, "end": 48.21, "text": "现在我们沙洲城"}, {"start": 48.21, "end": 49.45, "text": "依旧积极可危"}, {"start": 49.45, "end": 50.97, "text": "正需要大家通力合作"}, {"start": 50.97, "end": 52.53, "text": "希望你能配合我们这边"}, {"start": 52.53, "end": 53.61, "text": "至于吃穿用度这些"}, {"start": 53.61, "end": 54.49, "text": "你们不用担心"}, {"start": 54.49, "end": 55.41, "text": "进数由我们进"}, {"start": 55.41, "end": 56.45, "text": "谢谢"}, {"start": 56.45, "end": 57.25, "text": "谢谢"}, {"start": 57.25, "end": 57.97, "text": "刘三"}, {"start": 57.97, "end": 59.17, "text": "让你选几个人练铁马"}, {"start": 59.21, "end": 59.61, "text": "选好没"}, {"start": 59.61, "end": 60.33, "text": "选好了"}, {"start": 60.33, "end": 61.37, "text": "你们几个给我过来"}, {"start": 61.37, "end": 62.26, "text": "是"}, {"start": 62.26, "end": 62.82, "text": "好好学"}, {"start": 62.82, "end": 63.58, "text": "以后这些铁马"}, {"start": 63.58, "end": 64.54, "text": "就是我们的站马了"}, {"start": 64.54, "end": 65.5, "text": "要好好爱护"}, {"start": 65.5, "end": 65.9, "text": "还有"}, {"start": 65.9, "end": 66.9, "text": "要省着点游用"}, {"start": 66.9, "end": 67.34, "text": "是"}, {"start": 67.34, "end": 67.58, "text": "好"}, {"start": 67.58, "end": 67.94, "text": "刘三"}, {"start": 67.94, "end": 68.74, "text": "剩下的就交给你了"}, {"start": 68.74, "end": 69.34, "text": "我先处理别的事了"}, {"start": 69.34, "end": 69.9, "text": "将军放心"}]}