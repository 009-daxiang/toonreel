{"file": "大将军扛楼养活百万大军-第30集.mp4", "ep": 30, "duration": 57.6, "segments": [{"start": 0.0, "end": 1.48, "text": "看他的樣子不像作假"}, {"start": 2.7, "end": 4.42, "text": "還真又沒見識過現在社會的人啊"}, {"start": 4.78, "end": 6.18, "text": "不過長得是真帥啊"}, {"start": 8.8, "end": 9.96, "text": "老闆 要點米"}, {"start": 10.32, "end": 11.04, "text": "最便宜的米"}, {"start": 11.28, "end": 11.84, "text": "一萬斤"}, {"start": 11.96, "end": 12.52, "text": "好好好"}, {"start": 12.56, "end": 13.56, "text": "老闆 放哪裡"}, {"start": 13.64, "end": 14.56, "text": "這裡哪裡沒有人"}, {"start": 14.68, "end": 15.64, "text": "那邊有條巷子"}, {"start": 15.72, "end": 16.32, "text": "那裡沒人"}, {"start": 16.4, "end": 17.12, "text": "那就給我放那裡"}, {"start": 17.2, "end": 18.44, "text": "行 我馬上安排人"}, {"start": 18.52, "end": 18.96, "text": "等等"}, {"start": 19.04, "end": 19.64, "text": "這油怎麼賣"}, {"start": 19.72, "end": 20.52, "text": "四十五塊錢一桶"}, {"start": 20.6, "end": 21.24, "text": "給我來十桶"}, {"start": 21.44, "end": 22.32, "text": "還有這是白糖嗎"}, {"start": 22.4, "end": 22.64, "text": "對"}, {"start": 22.72, "end": 23.4, "text": "三塊五一斤"}, {"start": 23.48, "end": 24.24, "text": "給我來一百斤"}, {"start": 24.52, "end": 25.12, "text": "這是什麼"}, {"start": 25.4, "end": 26.08, "text": "這個叫泡麵啊"}, {"start": 26.12, "end": 26.68, "text": "你不認識嗎"}, {"start": 26.76, "end": 27.56, "text": "這人怎麼回事"}, {"start": 27.6, "end": 28.52, "text": "感覺怎麼傻傻的呢"}, {"start": 28.6, "end": 29.16, "text": "泡麵"}, {"start": 29.36, "end": 29.88, "text": "吃的嗎"}, {"start": 29.92, "end": 30.2, "text": "對啊"}, {"start": 30.28, "end": 30.8, "text": "要不然呢"}, {"start": 30.92, "end": 31.48, "text": "怎麼吃"}, {"start": 32.4, "end": 33.56, "text": "見識也太少了吧"}, {"start": 33.76, "end": 34.84, "text": "你把這東西撕開"}, {"start": 35.08, "end": 35.88, "text": "裡面就有麵"}, {"start": 35.96, "end": 36.56, "text": "還有配料"}, {"start": 37.26, "end": 37.78, "text": "乾量"}, {"start": 38.1, "end": 38.74, "text": "啊 對對對"}, {"start": 39.02, "end": 40.18, "text": "你把它叫乾量也行"}, {"start": 40.5, "end": 41.26, "text": "多少錢一盒"}, {"start": 41.58, "end": 42.22, "text": "三塊五"}, {"start": 42.46, "end": 43.34, "text": "那我要三桶試試"}, {"start": 43.58, "end": 43.86, "text": "行"}, {"start": 44.02, "end": 44.7, "text": "我給你裝好"}, {"start": 44.82, "end": 46.42, "text": "一共兩萬三千一百塊錢"}, {"start": 46.7, "end": 47.66, "text": "你就給兩萬三吧"}, {"start": 48.58, "end": 48.86, "text": "好"}, {"start": 49.14, "end": 50.86, "text": "我馬上安排給你送到巷子裡"}, {"start": 53.59, "end": 54.15, "text": "回去"}, {"start": 55.62, "end": 56.46, "text": "真可以"}]}