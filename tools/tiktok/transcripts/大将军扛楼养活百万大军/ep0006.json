{"file": "大将军扛楼养活百万大军-第6集.mp4", "ep": 6, "duration": 68.2, "segments": [{"start": 1.62, "end": 2.82, "text": "两位这么早啊"}, {"start": 2.82, "end": 3.62, "text": "将军"}, {"start": 3.62, "end": 4.62, "text": "您小心一些"}, {"start": 4.62, "end": 6.62, "text": "可千万不要掉到里面去了"}, {"start": 6.62, "end": 10.78, "text": "不去"}, {"start": 10.78, "end": 11.78, "text": "范先生"}, {"start": 11.78, "end": 12.78, "text": "怎么没点动静呢"}, {"start": 12.78, "end": 14.78, "text": "该不会也掉到毛坑里去了吧"}, {"start": 14.78, "end": 15.78, "text": "胡说"}, {"start": 15.78, "end": 16.78, "text": "你以为是你啊"}, {"start": 16.78, "end": 17.78, "text": "你不知道"}, {"start": 17.78, "end": 18.78, "text": "他是五位大将军"}, {"start": 18.78, "end": 19.78, "text": "不好意思求救"}, {"start": 19.78, "end": 20.78, "text": "我进去看看"}, {"start": 20.78, "end": 21.78, "text": "我的大将军"}, {"start": 21.78, "end": 23.78, "text": "你可不要掉下去才行啊"}, {"start": 23.78, "end": 24.78, "text": "刘三"}, {"start": 24.78, "end": 25.78, "text": "我看你是饿了吧"}, {"start": 25.78, "end": 28.99, "text": "我又进来了"}, {"start": 28.99, "end": 35.37, "text": "大兄弟"}, {"start": 35.37, "end": 38.23, "text": "是叫我吗"}, {"start": 38.23, "end": 40.23, "text": "你找工作啊"}, {"start": 40.23, "end": 42.23, "text": "我去劳务市场"}, {"start": 42.23, "end": 44.23, "text": "不远就在前面"}, {"start": 44.23, "end": 45.23, "text": "你没吃饭吗"}, {"start": 45.23, "end": 46.97, "text": "给"}, {"start": 46.97, "end": 49.09, "text": "多谢"}, {"start": 49.09, "end": 50.09, "text": "那个货运的"}, {"start": 50.09, "end": 51.09, "text": "说除了运费之外"}, {"start": 51.09, "end": 53.09, "text": "他要从六楼班那些东西"}, {"start": 53.09, "end": 54.09, "text": "得给他一千块钱"}, {"start": 54.09, "end": 56.09, "text": "要不然就不接这个单"}, {"start": 56.09, "end": 57.12, "text": "一千"}, {"start": 57.12, "end": 58.12, "text": "他想疯了吧"}, {"start": 58.12, "end": 60.12, "text": "我了解过市场航况"}, {"start": 60.12, "end": 62.54, "text": "顶多五百块钱"}, {"start": 62.54, "end": 63.54, "text": "搬东西是吧"}, {"start": 63.54, "end": 64.54, "text": "我搬"}, {"start": 64.54, "end": 65.54, "text": "我收四百"}, {"start": 65.54, "end": 67.43, "text": "你"}, {"start": 67.43, "end": 68.43, "text": "对对对我"}]}