{"file": "满朝文武都以为我败家-第50集.mp4", "ep": 50, "duration": 58.0, "segments": [{"start": 0.72, "end": 1.4, "text": "陛下"}, {"start": 1.56, "end": 2.72, "text": "乾国公之子慕櫻"}, {"start": 2.72, "end": 3.48, "text": "殿外求见"}, {"start": 6.07, "end": 6.87, "text": "让他进来"}, {"start": 7.35, "end": 10.54, "text": "臣慕櫻参见陛下"}, {"start": 10.78, "end": 11.46, "text": "起来吧"}, {"start": 12.38, "end": 13.86, "text": "这大中午的来找朕"}, {"start": 14.06, "end": 14.7, "text": "什么事"}, {"start": 15.49, "end": 16.05, "text": "陛下"}, {"start": 16.41, "end": 17.05, "text": "臣来"}, {"start": 17.25, "end": 19.33, "text": "是为陛国公之子方扬求请"}, {"start": 19.89, "end": 21.73, "text": "你为那拜家子求请"}, {"start": 21.93, "end": 22.45, "text": "是"}, {"start": 24.35, "end": 25.27, "text": "有意思"}, {"start": 25.79, "end": 27.07, "text": "你们俩不是不合吗"}, {"start": 27.19, "end": 28.91, "text": "怎么还替他求请请来了"}, {"start": 29.42, "end": 29.98, "text": "陛下"}, {"start": 30.46, "end": 31.66, "text": "臣为方扬求请"}, {"start": 32.14, "end": 33.09, "text": "全因臣觉得"}, {"start": 33.21, "end": 34.25, "text": "他说的话没错"}, {"start": 35.87, "end": 37.63, "text": "泛夫走族三教九游"}, {"start": 37.91, "end": 39.07, "text": "皆是大厨百姓"}, {"start": 39.88, "end": 41.32, "text": "本公子乃勋贵之后"}, {"start": 41.52, "end": 42.72, "text": "世代享受国恩"}, {"start": 43.08, "end": 44.84, "text": "自是应该维护大厨百姓"}, {"start": 45.12, "end": 49.42, "text": "可拜家子儿啊"}, {"start": 49.58, "end": 52.06, "text": "大厨的百姓朕自然会维护"}, {"start": 52.3, "end": 54.22, "text": "这个方扬朕会放的"}, {"start": 54.5, "end": 55.38, "text": "多谢陛下"}]}