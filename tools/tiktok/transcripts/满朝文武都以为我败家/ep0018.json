{"file": "满朝文武都以为我败家-第18集.mp4", "ep": 18, "duration": 62.0, "segments": [{"start": 0.3, "end": 1.3, "text": "少爺"}, {"start": 1.5, "end": 3.3, "text": "永平侯可是精英將軍"}, {"start": 3.3, "end": 5.1, "text": "他要是壯告皇上啊"}, {"start": 5.1, "end": 7.5, "text": "我爹正在風餐路速為皇帝賣命"}, {"start": 7.5, "end": 8.7, "text": "只要我不造反"}, {"start": 8.7, "end": 9.5, "text": "不殺人"}, {"start": 9.5, "end": 11.1, "text": "不做天怒人怨的事"}, {"start": 11.1, "end": 13.1, "text": "他回來之前暫時沒事"}, {"start": 13.3, "end": 15.1, "text": "我這是合法精英"}, {"start": 17.26, "end": 18.06, "text": "女兒"}, {"start": 18.26, "end": 19.86, "text": "為何愁眉苦臉"}, {"start": 20.38, "end": 21.18, "text": "父親"}, {"start": 21.38, "end": 22.58, "text": "你看看這個"}, {"start": 22.78, "end": 24.94, "text": "這字"}, {"start": 24.94, "end": 26.54, "text": "父親先看內容"}, {"start": 28.37, "end": 30.17, "text": "畫上合花合上畫"}, {"start": 30.17, "end": 31.97, "text": "這是何人出的絕對"}, {"start": 32.17, "end": 33.9, "text": "芳陽寫的"}, {"start": 34.3, "end": 35.78, "text": "芳陽"}, {"start": 39.37, "end": 41.17, "text": "先是兩手傳世詩詞"}, {"start": 41.37, "end": 42.97, "text": "又是一副千古絕對"}, {"start": 42.97, "end": 43.57, "text": "此字"}, {"start": 43.77, "end": 44.97, "text": "當真是深藏無路"}, {"start": 44.97, "end": 45.57, "text": "父親"}, {"start": 45.57, "end": 46.57, "text": "他只是抄的"}, {"start": 46.57, "end": 47.37, "text": "那這字呢"}, {"start": 48.22, "end": 49.22, "text": "瘦骨臨尋"}, {"start": 49.22, "end": 50.22, "text": "瘋忙閉路"}, {"start": 50.22, "end": 51.62, "text": "芳陽卻自成一格"}, {"start": 51.62, "end": 53.02, "text": "能寫出這種字的人"}, {"start": 53.22, "end": 54.62, "text": "當為當事才子"}, {"start": 54.82, "end": 57.74, "text": "我退掉的"}, {"start": 57.94, "end": 59.83, "text": "究竟是一個敗家子"}, {"start": 60.03, "end": 61.83, "text": "還是一位絕世才子"}]}