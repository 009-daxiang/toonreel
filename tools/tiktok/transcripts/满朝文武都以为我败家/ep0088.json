{"file": "满朝文武都以为我败家-第88集.mp4", "ep": 88, "duration": 63.7, "segments": [{"start": 0.34, "end": 1.38, "text": "你可知"}, {"start": 3.27, "end": 5.07, "text": "这代人是何人"}, {"start": 5.55, "end": 7.51, "text": "小人知道"}, {"start": 8.3, "end": 9.66, "text": "有村民告诉小人"}, {"start": 9.98, "end": 11.06, "text": "他亲眼看见"}, {"start": 11.38, "end": 12.78, "text": "杀害我家妹子的"}, {"start": 13.34, "end": 16.28, "text": "正是成国公家的方杨"}, {"start": 17.81, "end": 20.33, "text": "啥"}, {"start": 20.65, "end": 21.77, "text": "本官且问你"}, {"start": 22.05, "end": 22.81, "text": "你确定"}, {"start": 23.53, "end": 26.05, "text": "要照成国公之子方杨"}, {"start": 26.69, "end": 27.7, "text": "对"}, {"start": 28.06, "end": 29.7, "text": "小人就是要告那拜家子"}, {"start": 30.34, "end": 32.26, "text": "今日早上四十初"}, {"start": 32.58, "end": 33.66, "text": "有人亲眼所见"}, {"start": 33.86, "end": 34.98, "text": "那拜家子代人想要"}, {"start": 34.98, "end": 36.18, "text": "凌辱我家妹子"}, {"start": 36.42, "end": 37.54, "text": "我家妹子不从"}, {"start": 37.54, "end": 39.22, "text": "就被她代人残忍杀害"}, {"start": 39.22, "end": 40.38, "text": "岂受不辱啊"}, {"start": 40.38, "end": 41.82, "text": "亏她还是国公之子"}, {"start": 41.82, "end": 42.42, "text": "素卿"}, {"start": 42.98, "end": 43.98, "text": "你说杀人者"}, {"start": 43.98, "end": 45.46, "text": "乃是成国公之子"}, {"start": 45.78, "end": 47.3, "text": "我看你是胡说八道"}, {"start": 47.46, "end": 48.02, "text": "大人"}, {"start": 48.02, "end": 49.34, "text": "有人亲眼所见"}, {"start": 49.34, "end": 50.9, "text": "又怎么会是我胡说"}, {"start": 51.1, "end": 51.7, "text": "方杨"}, {"start": 54.3, "end": 55.06, "text": "告诉她"}, {"start": 55.34, "end": 56.66, "text": "今日四十初"}, {"start": 56.9, "end": 57.82, "text": "你在做什么"}, {"start": 58.66, "end": 59.18, "text": "大人"}, {"start": 59.97, "end": 60.81, "text": "陈时墨"}, {"start": 61.25, "end": 63.65, "text": "本公子便在办房点猛了"}]}