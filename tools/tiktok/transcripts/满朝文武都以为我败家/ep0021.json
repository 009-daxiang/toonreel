{"file": "满朝文武都以为我败家-第21集.mp4", "ep": 21, "duration": 51.2, "segments": [{"start": 0.05, "end": 1.25, "text": "泳平侯"}, {"start": 3.14, "end": 4.02, "text": "陛下恕罪"}, {"start": 5.04, "end": 6.24, "text": "你还知道有罪"}, {"start": 6.84, "end": 8.88, "text": "刻意隐藏事情真相"}, {"start": 9.4, "end": 11.04, "text": "要启军吗"}, {"start": 11.32, "end": 12.08, "text": "臣不敢"}, {"start": 12.52, "end": 14.72, "text": "是臣未能了解事情全蟒"}, {"start": 15.0, "end": 16.36, "text": "还请陛下恕罪"}, {"start": 16.72, "end": 18.2, "text": "泳平侯谢林"}, {"start": 18.52, "end": 19.72, "text": "欲事不查"}, {"start": 20.0, "end": 21.4, "text": "此次乏奉半年"}, {"start": 21.8, "end": 22.92, "text": "若有下次"}, {"start": 23.52, "end": 24.74, "text": "消官去绝"}, {"start": 24.98, "end": 25.9, "text": "典去宣服"}, {"start": 26.1, "end": 27.94, "text": "臣谢助隆恩"}, {"start": 28.18, "end": 29.02, "text": "行了 下去吧"}, {"start": 29.26, "end": 29.98, "text": "臣告退"}, {"start": 32.48, "end": 33.4, "text": "又是方杨"}, {"start": 34.12, "end": 35.68, "text": "你说那小子开了个酒楼是吧"}, {"start": 35.88, "end": 36.64, "text": "是的 陛下"}, {"start": 36.84, "end": 37.84, "text": "行了 告诉玉厨房"}, {"start": 38.04, "end": 38.92, "text": "午膳不用张落了"}, {"start": 44.44, "end": 46.12, "text": "客官 您这是要听餐"}, {"start": 46.32, "end": 47.0, "text": "还是包房"}, {"start": 47.24, "end": 48.92, "text": "自然是包房"}]}