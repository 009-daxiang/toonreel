{"file": "满朝文武都以为我败家-第36集.mp4", "ep": 36, "duration": 59.2, "segments": [{"start": 1.36, "end": 2.36, "text": "臣沐英"}, {"start": 2.36, "end": 3.6, "text": "参见太子殿下"}, {"start": 4.19, "end": 5.07, "text": "不必多礼"}, {"start": 5.81, "end": 7.25, "text": "顾今日威府出宫"}, {"start": 7.53, "end": 10.0, "text": "那陛下哪里"}, {"start": 10.51, "end": 11.19, "text": "无妨"}, {"start": 11.39, "end": 12.19, "text": "你不用管"}, {"start": 15.05, "end": 17.09, "text": "听说太学出了个厉害人物"}, {"start": 17.37, "end": 19.41, "text": "赶往技巧的九湖路里撒尿"}, {"start": 20.01, "end": 20.89, "text": "不瞒殿下"}, {"start": 21.17, "end": 22.29, "text": "正是陈告发的"}, {"start": 23.17, "end": 24.93, "text": "你知道他是陈国公之子吗"}, {"start": 24.93, "end": 25.73, "text": "臣知道"}, {"start": 25.73, "end": 27.21, "text": "带顾去陈国公府见他"}, {"start": 27.41, "end": 28.17, "text": "现在"}, {"start": 28.17, "end": 28.97, "text": "现在"}, {"start": 30.59, "end": 31.19, "text": "殿下"}, {"start": 31.39, "end": 32.95, "text": "那拜家子整日有手好闲"}, {"start": 32.95, "end": 34.67, "text": "这回只怕早去了青楼雅院"}, {"start": 34.79, "end": 36.19, "text": "那就去青楼找他"}, {"start": 36.19, "end": 36.83, "text": "什么"}, {"start": 37.11, "end": 37.91, "text": "太子殿下"}, {"start": 37.91, "end": 38.43, "text": "这"}, {"start": 38.63, "end": 39.27, "text": "怕什么"}, {"start": 39.75, "end": 40.99, "text": "孤子是去找人"}, {"start": 40.99, "end": 43.02, "text": "太子逛青楼"}, {"start": 43.02, "end": 44.1, "text": "这要是传出去"}, {"start": 45.52, "end": 46.52, "text": "公子请随我来"}, {"start": 46.68, "end": 47.32, "text": "去哪"}, {"start": 47.32, "end": 48.92, "text": "今夜平儿姑娘登台卖艺"}, {"start": 48.92, "end": 50.16, "text": "来的公子大多是为他"}, {"start": 50.16, "end": 50.96, "text": "听着不错"}, {"start": 50.96, "end": 51.72, "text": "不过"}, {"start": 51.84, "end": 53.0, "text": "本公子只要最好的"}, {"start": 53.0, "end": 54.56, "text": "阁中最好的真是平儿姑娘"}, {"start": 54.56, "end": 55.64, "text": "只是他是亲管人"}, {"start": 55.64, "end": 56.64, "text": "想做入牧之拼"}, {"start": 56.64, "end": 57.88, "text": "还得看公子的本事"}, {"start": 57.88, "end": 58.32, "text": "好"}, {"start": 58.48, "end": 59.16, "text": "就他了"}]}