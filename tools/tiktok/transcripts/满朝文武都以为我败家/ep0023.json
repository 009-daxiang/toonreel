{"file": "满朝文武都以为我败家-第23集.mp4", "ep": 23, "duration": 119.7, "segments": [{"start": 4.08, "end": 5.08, "text": "牧鹰"}, {"start": 6.08, "end": 8.3, "text": "是你"}, {"start": 8.8, "end": 9.8, "text": "不错"}, {"start": 9.8, "end": 10.8, "text": "是我"}, {"start": 10.8, "end": 11.8, "text": "张龙"}, {"start": 11.8, "end": 13.05, "text": "在"}, {"start": 13.05, "end": 16.55, "text": "带人把那几个想动本公子酒水的杂碎压出来"}, {"start": 16.55, "end": 18.29, "text": "得令"}, {"start": 22.1, "end": 23.6, "text": "不愧是边关退下来的"}, {"start": 23.6, "end": 25.1, "text": "手脚就是麻利"}, {"start": 25.1, "end": 26.7, "text": "我只是来买酒的"}, {"start": 26.7, "end": 28.89, "text": "并不想和你起冲突"}, {"start": 28.89, "end": 29.89, "text": "不好意思"}, {"start": 29.89, "end": 32.18, "text": "这酒楼就是本公子的"}, {"start": 32.18, "end": 34.68, "text": "所以你已经和本公子起冲突了"}, {"start": 34.68, "end": 37.18, "text": "我们天先罪近期限量供应"}, {"start": 37.18, "end": 39.18, "text": "你的要求我们做不到"}, {"start": 39.78, "end": 41.78, "text": "不过凡事都有例外"}, {"start": 41.78, "end": 43.78, "text": "而你前国公世子"}, {"start": 43.78, "end": 45.78, "text": "自然就是其中一个例外"}, {"start": 45.78, "end": 47.7, "text": "看到没"}, {"start": 47.7, "end": 48.7, "text": "那幅对子"}, {"start": 48.7, "end": 50.86, "text": "你只要对出来"}, {"start": 50.86, "end": 52.86, "text": "你想要多少酒水"}, {"start": 52.86, "end": 55.06, "text": "本本就给你多少"}, {"start": 55.06, "end": 57.88, "text": "怎么样"}, {"start": 57.88, "end": 59.88, "text": "我不善于对联一道"}, {"start": 59.88, "end": 61.88, "text": "可以换成别的"}, {"start": 61.88, "end": 62.88, "text": "比如"}, {"start": 62.88, "end": 64.88, "text": "诗词歌副等"}, {"start": 64.88, "end": 65.88, "text": "好"}, {"start": 65.88, "end": 66.88, "text": "你出题"}, {"start": 66.88, "end": 67.88, "text": "若是你赢了"}, {"start": 67.88, "end": 69.88, "text": "本公子奠力酒水"}, {"start": 69.88, "end": 72.55, "text": "你认取 认拿"}, {"start": 72.55, "end": 74.05, "text": "若你是本公子赢了"}, {"start": 74.05, "end": 75.05, "text": "从今往后"}, {"start": 75.05, "end": 76.05, "text": "见到本公子"}, {"start": 76.05, "end": 78.05, "text": "你就要叫本公子大哥"}, {"start": 78.05, "end": 79.05, "text": "同时给本公子"}, {"start": 79.05, "end": 81.05, "text": "五百两的精神损失费"}, {"start": 81.05, "end": 82.05, "text": "和务功费"}, {"start": 82.05, "end": 84.75, "text": "如何"}, {"start": 84.75, "end": 86.25, "text": "今日我来此"}, {"start": 86.25, "end": 87.75, "text": "便是为了买酒"}, {"start": 87.75, "end": 89.75, "text": "那咱们就以引酒为题吧"}, {"start": 89.75, "end": 92.87, "text": "可以"}, {"start": 92.87, "end": 93.87, "text": "那么"}, {"start": 93.87, "end": 95.96, "text": "就由你先来吧"}, {"start": 95.96, "end": 97.0, "text": "不用"}, {"start": 97.0, "end": 98.0, "text": "你先"}, {"start": 98.0, "end": 100.03, "text": "免得我的诗意出"}, {"start": 100.03, "end": 102.03, "text": "再让你没了灵感"}, {"start": 102.03, "end": 104.76, "text": "好"}, {"start": 104.76, "end": 105.76, "text": "既然如此"}, {"start": 106.26, "end": 109.89, "text": "那我就确直不公了"}, {"start": 109.89, "end": 111.89, "text": "昨夜我在院中独着"}, {"start": 111.89, "end": 113.89, "text": "现在想来"}, {"start": 113.89, "end": 116.34, "text": "倒是颇为伤感"}, {"start": 116.34, "end": 117.37, "text": "既如此"}, {"start": 117.37, "end": 119.37, "text": "我便以此为题吧"}]}