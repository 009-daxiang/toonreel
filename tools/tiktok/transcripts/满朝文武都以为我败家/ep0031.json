{"file": "满朝文武都以为我败家-第31集.mp4", "ep": 31, "duration": 64.1, "segments": [{"start": 1.49, "end": 3.09, "text": "有事起奏"}, {"start": 3.09, "end": 5.09, "text": "不是退朝"}, {"start": 5.09, "end": 5.81, "text": "陛下"}, {"start": 5.81, "end": 8.49, "text": "北盟国的使臣再度要求禁键"}, {"start": 8.49, "end": 9.81, "text": "照他们上朝"}, {"start": 9.81, "end": 12.81, "text": "宣北盟国使臣阿路格巴桑"}, {"start": 12.81, "end": 15.01, "text": "阿路格巴圖禁键"}, {"start": 20.42, "end": 21.26, "text": "陛下"}, {"start": 21.26, "end": 23.94, "text": "我们北盟大军已等待许久"}, {"start": 23.94, "end": 25.42, "text": "不知我们的要求"}, {"start": 25.42, "end": 27.26, "text": "你们考虑得怎么样了"}, {"start": 27.26, "end": 30.04, "text": "大胆"}, {"start": 30.04, "end": 31.68, "text": "真是狂妄至极"}, {"start": 31.68, "end": 33.72, "text": "真当我大楚无人了"}, {"start": 33.72, "end": 35.57, "text": "虚虚满意"}, {"start": 35.57, "end": 37.85, "text": "也敢在我大楚大放决词"}, {"start": 38.13, "end": 40.93, "text": "真当我大楚兵甲不利乎"}, {"start": 40.93, "end": 42.05, "text": "满意"}, {"start": 42.05, "end": 43.65, "text": "齐心可诛"}, {"start": 50.72, "end": 52.24, "text": "若是你们够胆"}, {"start": 52.24, "end": 53.68, "text": "那就直接开战"}, {"start": 53.68, "end": 55.44, "text": "我北盟国数十万大军"}, {"start": 55.44, "end": 56.68, "text": "早已磨刀祸祸"}, {"start": 56.68, "end": 59.6, "text": "时刻准备好了开战"}, {"start": 59.6, "end": 61.4, "text": "大楚皇帝陛下"}, {"start": 61.4, "end": 64.08, "text": "我们北盟绝对是可求和平的"}]}