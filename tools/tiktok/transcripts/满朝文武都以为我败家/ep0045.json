{"file": "满朝文武都以为我败家-第45集.mp4", "ep": 45, "duration": 51.0, "segments": [{"start": 0.0, "end": 2.0, "text": "剛才本公子還在晚歇"}, {"start": 2.0, "end": 4.0, "text": "老爹出門在外沒人送飯"}, {"start": 4.0, "end": 6.0, "text": "轉頭平兒姑娘就送來了"}, {"start": 6.0, "end": 7.0, "text": "多謝多謝"}, {"start": 9.98, "end": 10.98, "text": "公子別動"}, {"start": 10.98, "end": 11.98, "text": "有米粒"}, {"start": 12.98, "end": 15.1, "text": "公子"}, {"start": 15.1, "end": 17.1, "text": "還有什麼我能為你做的嗎"}, {"start": 17.1, "end": 18.1, "text": "你確定"}, {"start": 18.1, "end": 22.82, "text": "事情倒是有一件"}, {"start": 22.82, "end": 23.82, "text": "讓本公子看看"}, {"start": 23.82, "end": 30.62, "text": "你不戴面紗的樣子"}, {"start": 30.62, "end": 31.62, "text": "公子"}, {"start": 31.62, "end": 32.62, "text": "好看嗎"}, {"start": 32.62, "end": 35.62, "text": "平兒姑娘的容顏"}, {"start": 35.62, "end": 36.62, "text": "真是動人心魄"}, {"start": 36.62, "end": 40.75, "text": "這個"}, {"start": 40.75, "end": 41.75, "text": "給你"}, {"start": 41.75, "end": 42.78, "text": "什麼"}, {"start": 42.78, "end": 44.78, "text": "公子請您收下"}, {"start": 44.78, "end": 48.34, "text": "方揚"}, {"start": 48.34, "end": 49.34, "text": "你還真是"}, {"start": 49.34, "end": 50.34, "text": "越活越回去了"}]}