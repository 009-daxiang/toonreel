{"file": "满朝文武都以为我败家-第59集.mp4", "ep": 59, "duration": 64.6, "segments": [{"start": 0.75, "end": 4.03, "text": "当初上太学的时候"}, {"start": 4.03, "end": 6.03, "text": "要是能多上几天学"}, {"start": 6.03, "end": 8.1, "text": "说不得就不会这样"}, {"start": 8.1, "end": 9.1, "text": "方大哥"}, {"start": 9.1, "end": 16.53, "text": "你来找我了"}, {"start": 17.53, "end": 18.53, "text": "老弟"}, {"start": 18.53, "end": 19.53, "text": "哥哥想死你了"}, {"start": 19.53, "end": 20.53, "text": "方大哥"}, {"start": 20.53, "end": 21.53, "text": "我也想你"}, {"start": 21.53, "end": 22.53, "text": "好好"}, {"start": 23.53, "end": 24.53, "text": "你这些天怎么样"}, {"start": 24.53, "end": 26.49, "text": "不太好"}, {"start": 26.49, "end": 27.49, "text": "上次的事之后"}, {"start": 27.49, "end": 29.52, "text": "我爹抱揍了我一顿"}, {"start": 29.52, "end": 30.52, "text": "对了"}, {"start": 30.52, "end": 31.52, "text": "上次的事"}, {"start": 31.52, "end": 32.52, "text": "你还揍了没有"}, {"start": 32.52, "end": 33.52, "text": "我跑树上去了"}, {"start": 33.52, "end": 35.71, "text": "我爹没上去"}, {"start": 35.71, "end": 36.71, "text": "老弟"}, {"start": 36.71, "end": 37.71, "text": "不想挨揍"}, {"start": 37.71, "end": 39.9, "text": "跑不是办法"}, {"start": 39.9, "end": 41.9, "text": "咱们得做成事情才行"}, {"start": 41.9, "end": 44.29, "text": "这次大哥来找你"}, {"start": 44.29, "end": 46.51, "text": "是为了和你共谋大"}, {"start": 46.51, "end": 48.47, "text": "大哥"}, {"start": 48.47, "end": 49.47, "text": "你要干啥"}, {"start": 49.47, "end": 51.47, "text": "造反的事情可不能干啊"}, {"start": 51.47, "end": 52.79, "text": "什么话"}, {"start": 52.79, "end": 56.99, "text": "方大哥"}, {"start": 56.99, "end": 57.99, "text": "只要不是造反"}, {"start": 57.99, "end": 58.99, "text": "啥都好说"}, {"start": 58.99, "end": 59.99, "text": "你说吧"}, {"start": 59.99, "end": 60.99, "text": "这次"}, {"start": 60.99, "end": 61.99, "text": "往谁葫芦里撒尿"}]}