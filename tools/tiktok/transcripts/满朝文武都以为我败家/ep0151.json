{"file": "满朝文武都以为我败家-第151集.mp4", "ep": 151, "duration": 61.9, "segments": [{"start": 0.0, "end": 0.72, "text": "薛公子"}, {"start": 1.28, "end": 2.04, "text": "你可知道"}, {"start": 2.44, "end": 3.2, "text": "那些钱"}, {"start": 3.6, "end": 5.72, "text": "是从前线将士手里摳出来的"}, {"start": 5.88, "end": 7.48, "text": "军器件摳下一吻前"}, {"start": 7.76, "end": 10.28, "text": "前线将士的兵器铠甲就差一分"}, {"start": 10.64, "end": 11.84, "text": "等大战一开"}, {"start": 12.32, "end": 15.08, "text": "就让这些将士拿着劣质兵器去拼灭"}, {"start": 18.19, "end": 18.91, "text": "薛公子"}, {"start": 19.72, "end": 20.76, "text": "最后劝你一拳"}, {"start": 20.88, "end": 22.68, "text": "有些钱绝对不能拿"}, {"start": 23.0, "end": 24.32, "text": "心里得有条底线"}, {"start": 24.84, "end": 27.08, "text": "我的底线不许我做这种事"}, {"start": 27.44, "end": 29.04, "text": "这钱我不会赚"}, {"start": 29.56, "end": 31.56, "text": "这种功劳我也不懈要"}, {"start": 32.28, "end": 32.96, "text": "换作我"}, {"start": 33.2, "end": 34.76, "text": "直接退出军器件的过职"}, {"start": 38.81, "end": 40.17, "text": "市职怎么回来了"}, {"start": 40.79, "end": 42.11, "text": "军器件那边有事"}, {"start": 42.85, "end": 43.53, "text": "侍博"}, {"start": 43.89, "end": 45.13, "text": "有人不给你面子"}, {"start": 45.45, "end": 46.01, "text": "怎么"}, {"start": 46.41, "end": 47.81, "text": "军器件不让你进"}, {"start": 48.05, "end": 48.49, "text": "不是"}, {"start": 48.65, "end": 49.29, "text": "进去了"}, {"start": 49.41, "end": 51.13, "text": "小职是侍博举件进去的"}, {"start": 51.45, "end": 53.09, "text": "那老匹夫不给侍博面子"}, {"start": 53.21, "end": 54.17, "text": "小职怎么能忍"}, {"start": 54.29, "end": 55.33, "text": "直接就把人骂了"}, {"start": 57.67, "end": 58.59, "text": "对不起侍博"}, {"start": 58.87, "end": 60.27, "text": "小职给你惹麻烦了"}]}