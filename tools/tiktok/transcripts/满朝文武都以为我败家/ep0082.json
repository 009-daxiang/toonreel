{"file": "满朝文武都以为我败家-第82集.mp4", "ep": 82, "duration": 58.0, "segments": [{"start": 0.43, "end": 1.23, "text": "公子"}, {"start": 1.23, "end": 2.63, "text": "萍儿姑娘怎么来了"}, {"start": 2.63, "end": 3.35, "text": "公子"}, {"start": 3.35, "end": 4.35, "text": "萍儿说了"}, {"start": 4.35, "end": 5.43, "text": "会等你出来"}, {"start": 5.43, "end": 6.87, "text": "萍儿姑娘找我"}, {"start": 7.15, "end": 7.99, "text": "有什么事"}, {"start": 9.13, "end": 10.85, "text": "公子收了萍儿的手帕"}, {"start": 11.21, "end": 12.37, "text": "萍儿今日来"}, {"start": 12.65, "end": 14.89, "text": "是想问问公子如今是何想法"}, {"start": 14.89, "end": 15.85, "text": "手帕"}, {"start": 16.33, "end": 20.05, "text": "公子放心"}, {"start": 20.29, "end": 22.69, "text": "萍儿知道自己高攀不上公子"}, {"start": 22.93, "end": 24.21, "text": "若是公子有意"}, {"start": 24.49, "end": 26.17, "text": "萍儿自会为自己赎身"}, {"start": 26.17, "end": 27.45, "text": "跟在公子身边"}, {"start": 27.93, "end": 28.97, "text": "为奴为弊"}, {"start": 29.37, "end": 30.29, "text": "也是好的"}, {"start": 32.71, "end": 33.59, "text": "萍儿姑娘"}, {"start": 33.91, "end": 34.87, "text": "当日之事"}, {"start": 35.19, "end": 36.27, "text": "你不用放在心上"}, {"start": 36.47, "end": 39.51, "text": "公子是不喜欢萍儿吗"}, {"start": 39.71, "end": 41.63, "text": "本公子只是一个俗人"}, {"start": 41.79, "end": 43.83, "text": "自然会喜欢姑娘这般美人"}, {"start": 44.89, "end": 46.25, "text": "也正因这份喜欢"}, {"start": 46.41, "end": 47.57, "text": "本公子才不愿"}, {"start": 47.77, "end": 49.21, "text": "让姑娘被恩情裹写"}, {"start": 49.41, "end": 50.25, "text": "维生于我"}, {"start": 51.14, "end": 52.06, "text": "公子放心"}, {"start": 52.46, "end": 53.58, "text": "抛去那些事情"}, {"start": 53.78, "end": 55.26, "text": "萍儿一样会这么选择"}]}