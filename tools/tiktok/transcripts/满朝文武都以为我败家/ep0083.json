{"file": "满朝文武都以为我败家-第83集.mp4", "ep": 83, "duration": 51.7, "segments": [{"start": 0.0, "end": 0.64, "text": "这"}, {"start": 0.88, "end": 1.76, "text": "公子放心"}, {"start": 1.76, "end": 3.28, "text": "我家小姐是亲故人"}, {"start": 3.28, "end": 4.16, "text": "赎生之后"}, {"start": 4.16, "end": 5.44, "text": "也和梁家女子无异"}, {"start": 5.44, "end": 6.0, "text": "好玩"}, {"start": 8.93, "end": 10.53, "text": "平儿姑娘心意我知道了"}, {"start": 10.77, "end": 11.97, "text": "只是咱们不过"}, {"start": 11.97, "end": 12.93, "text": "才见了一面"}, {"start": 13.09, "end": 13.89, "text": "这事情发展得"}, {"start": 13.89, "end": 14.93, "text": "是不是有些太快了"}, {"start": 15.01, "end": 16.45, "text": "公子觉得太快的话"}, {"start": 16.45, "end": 17.41, "text": "奴家可以等"}, {"start": 19.98, "end": 20.7, "text": "少爷"}, {"start": 20.86, "end": 22.3, "text": "宫里来人传旨了"}, {"start": 23.98, "end": 24.7, "text": "你先回吧"}, {"start": 24.86, "end": 26.06, "text": "改日我去闻乡阁找你"}, {"start": 26.06, "end": 27.18, "text": "咱们再详谈此事"}, {"start": 27.34, "end": 29.26, "text": "那平儿便在闻乡阁等你"}, {"start": 32.1, "end": 32.74, "text": "公公"}, {"start": 33.14, "end": 34.34, "text": "这次是什么旨意"}, {"start": 34.34, "end": 35.78, "text": "是陛下的口谕"}, {"start": 36.1, "end": 36.82, "text": "公子"}, {"start": 36.82, "end": 37.94, "text": "您听好了"}, {"start": 38.66, "end": 39.3, "text": "方扬"}, {"start": 39.54, "end": 41.46, "text": "朕命你去顺天府当差"}, {"start": 41.46, "end": 42.66, "text": "好生反省自己"}, {"start": 42.98, "end": 43.7, "text": "而今"}, {"start": 43.7, "end": 44.9, "text": "你却找人顶替"}, {"start": 44.9, "end": 46.5, "text": "当真以为朕不知吗"}, {"start": 46.66, "end": 48.1, "text": "先命你速速去负任"}, {"start": 48.34, "end": 49.38, "text": "若再有期满"}, {"start": 49.38, "end": 50.9, "text": "朕将你流放冲军"}]}