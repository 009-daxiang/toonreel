{"file": "满朝文武都以为我败家-第106集.mp4", "ep": 106, "duration": 60.3, "segments": [{"start": 3.15, "end": 3.75, "text": "少爷"}, {"start": 6.23, "end": 7.47, "text": "通知牧鹰和承勇没有"}, {"start": 7.71, "end": 8.51, "text": "已经通知了"}, {"start": 9.35, "end": 10.55, "text": "走 去码头"}, {"start": 16.68, "end": 17.56, "text": "楚兄没来"}, {"start": 17.72, "end": 18.4, "text": "他有事情"}, {"start": 18.4, "end": 19.32, "text": "不过出了五十人"}, {"start": 19.32, "end": 20.12, "text": "都在这里了"}, {"start": 20.12, "end": 21.52, "text": "我和承勇也是一人五十"}, {"start": 21.52, "end": 22.52, "text": "一共一百五十人"}, {"start": 22.52, "end": 23.08, "text": "好"}, {"start": 23.28, "end": 24.6, "text": "兵器带着以防万一"}, {"start": 24.84, "end": 25.76, "text": "尽量不要使用"}, {"start": 25.96, "end": 26.84, "text": "莫要出了人命"}, {"start": 26.84, "end": 28.24, "text": "放心 都安排好了"}, {"start": 28.24, "end": 29.24, "text": "这事我有经验"}, {"start": 29.44, "end": 29.96, "text": "走"}, {"start": 32.74, "end": 33.38, "text": "干什么的"}, {"start": 33.38, "end": 34.18, "text": "今天有规定"}, {"start": 34.18, "end": 34.98, "text": "曹运停摆"}, {"start": 34.98, "end": 36.1, "text": "不想死的赶紧滚"}, {"start": 36.38, "end": 37.26, "text": "给我打"}, {"start": 41.46, "end": 42.58, "text": "说我错了 说我错了"}, {"start": 42.58, "end": 43.26, "text": "代曆"}, {"start": 43.82, "end": 44.82, "text": "去你们帮派"}, {"start": 45.18, "end": 47.53, "text": "走"}, {"start": 48.69, "end": 49.37, "text": "你是谁"}, {"start": 49.37, "end": 51.33, "text": "杀了我妹子还想走"}, {"start": 51.45, "end": 53.13, "text": "今天就让你血债血偿"}, {"start": 53.41, "end": 55.05, "text": "弄死陈和"}, {"start": 55.05, "end": 55.37, "text": "是"}]}