{"file": "满朝文武都以为我败家-第49集.mp4", "ep": 49, "duration": 49.8, "segments": [{"start": 0.0, "end": 1.2, "text": "至于提亲的事"}, {"start": 1.48, "end": 2.48, "text": "是我对不住你"}, {"start": 3.08, "end": 4.4, "text": "以后休要再提了"}, {"start": 10.3, "end": 11.54, "text": "方公子 你"}, {"start": 11.66, "end": 12.9, "text": "让平儿姑娘见笑了"}, {"start": 14.07, "end": 16.87, "text": "刚才我真以为公子要签字了"}, {"start": 17.87, "end": 19.67, "text": "真当本公子是三岁小孩吗"}, {"start": 20.88, "end": 21.8, "text": "公子放心"}, {"start": 22.32, "end": 23.8, "text": "我一定会将你救出来"}, {"start": 24.2, "end": 25.56, "text": "哪怕是去告欲状"}, {"start": 25.84, "end": 27.04, "text": "也在所不惜"}, {"start": 27.2, "end": 34.88, "text": "你知不知道自己在说什么"}, {"start": 36.46, "end": 37.3, "text": "平儿姑娘"}, {"start": 37.46, "end": 39.18, "text": "你的心意本公子心领了"}, {"start": 39.5, "end": 40.34, "text": "不过你放心"}, {"start": 40.5, "end": 41.5, "text": "不用你去告欲状"}, {"start": 41.78, "end": 42.7, "text": "不小两天"}, {"start": 42.9, "end": 44.06, "text": "本公子就能出去了"}, {"start": 45.92, "end": 46.52, "text": "那好"}, {"start": 46.92, "end": 48.44, "text": "平儿就等公子出来"}, {"start": 48.84, "end": 49.76, "text": "公子保重"}]}