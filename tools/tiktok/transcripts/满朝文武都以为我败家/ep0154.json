{"file": "满朝文武都以为我败家-第154集.mp4", "ep": 154, "duration": 75.4, "segments": [{"start": 3.7, "end": 4.46, "text": "陛下"}, {"start": 4.86, "end": 5.94, "text": "臣要弹劾"}, {"start": 6.34, "end": 8.86, "text": "陈国公之子芳阳目无法计"}, {"start": 9.67, "end": 10.91, "text": "那臭小子"}, {"start": 11.43, "end": 13.79, "text": "真是一天都不想让朕省心啊"}, {"start": 14.03, "end": 15.75, "text": "在军器监内撒野"}, {"start": 16.07, "end": 18.35, "text": "顶撞上司 公然侮辱臣"}, {"start": 18.63, "end": 21.07, "text": "才请陛下为臣作主"}, {"start": 23.7, "end": 24.26, "text": "陛下"}, {"start": 24.66, "end": 25.66, "text": "芳阳有奏"}, {"start": 28.98, "end": 29.98, "text": "他有什么奏"}, {"start": 30.18, "end": 30.9, "text": "回陛下"}, {"start": 31.3, "end": 33.54, "text": "昨日芳阳从军器监离开之后"}, {"start": 33.78, "end": 35.22, "text": "便回武城兵马司"}, {"start": 35.58, "end": 37.22, "text": "写了一份弹劾奏辙"}, {"start": 37.66, "end": 39.54, "text": "让臣今日早朝转交"}, {"start": 39.74, "end": 41.02, "text": "请陛下过目"}, {"start": 43.07, "end": 43.99, "text": "直接念吧"}, {"start": 44.35, "end": 44.83, "text": "是"}, {"start": 46.08, "end": 46.64, "text": "陛下"}, {"start": 47.16, "end": 47.92, "text": "陛芳阳"}, {"start": 48.24, "end": 50.36, "text": "叩请陛下诛杀兼政孙云"}, {"start": 54.61, "end": 55.25, "text": "疯了吧"}, {"start": 55.33, "end": 58.44, "text": "一口就是要请诛杀军器监兼政"}, {"start": 59.42, "end": 60.98, "text": "这上来就要人命"}, {"start": 61.38, "end": 63.02, "text": "这败家子好狠啊"}, {"start": 63.02, "end": 65.51, "text": "失心疯啊"}, {"start": 68.31, "end": 68.91, "text": "陛下"}, {"start": 69.47, "end": 71.27, "text": "军器监兼政孙云"}, {"start": 71.47, "end": 73.79, "text": "有三大不可饶恕之罪"}]}