{"file": "满朝文武都以为我败家-第128集.mp4", "ep": 128, "duration": 68.3, "segments": [{"start": 3.09, "end": 4.89, "text": "方公子来找平儿姑娘吗"}, {"start": 4.89, "end": 5.61, "text": "不错"}, {"start": 8.57, "end": 9.89, "text": "张龙 看赏"}, {"start": 12.88, "end": 13.6, "text": "姑娘"}, {"start": 13.8, "end": 15.12, "text": "去把你们妈妈叫来"}, {"start": 15.36, "end": 16.04, "text": "今日"}, {"start": 16.48, "end": 18.96, "text": "本公子要为平儿姑娘赎身"}, {"start": 19.16, "end": 20.32, "text": "好的 公子稍等"}, {"start": 20.32, "end": 21.56, "text": "奴婢这就去叫妈妈"}, {"start": 21.72, "end": 29.5, "text": "考姑娘等到了"}, {"start": 29.5, "end": 31.54, "text": "公子"}, {"start": 32.46, "end": 33.38, "text": "平儿姑娘"}, {"start": 33.38, "end": 35.22, "text": "本公子可是想杀你也"}, {"start": 35.54, "end": 47.26, "text": "乖"}, {"start": 51.73, "end": 53.29, "text": "我已和我爹通过信了"}, {"start": 53.57, "end": 55.12, "text": "他已同意让你入府"}, {"start": 55.12, "end": 58.84, "text": "子"}, {"start": 58.84, "end": 67.96, "text": "进来吧"}]}