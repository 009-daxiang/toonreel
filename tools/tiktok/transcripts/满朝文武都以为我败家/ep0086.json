{"file": "满朝文武都以为我败家-第86集.mp4", "ep": 86, "duration": 63.1, "segments": [{"start": 1.87, "end": 2.55, "text": "公子"}, {"start": 3.24, "end": 5.08, "text": "我們只需尋查這勇定和兩岸"}, {"start": 5.48, "end": 6.52, "text": "等下有船過來"}, {"start": 6.96, "end": 8.8, "text": "咱們上去跟這船走一圈即可"}, {"start": 11.88, "end": 12.92, "text": "若遇到什麼騷亂"}, {"start": 13.16, "end": 14.08, "text": "船自會靠岸"}, {"start": 14.52, "end": 15.72, "text": "咱們過去解決就行"}, {"start": 21.54, "end": 22.78, "text": "船家多少錢"}, {"start": 23.26, "end": 24.38, "text": "這兩位哥哥的錢"}, {"start": 24.58, "end": 25.66, "text": "本老爺一併付了"}, {"start": 27.14, "end": 28.94, "text": "這位大人不收錢的"}, {"start": 29.34, "end": 30.78, "text": "你放心做就好了"}, {"start": 31.86, "end": 32.5, "text": "不要錢"}, {"start": 33.56, "end": 34.16, "text": "方公子"}, {"start": 34.32, "end": 36.04, "text": "咱們做船一直是不收錢的"}, {"start": 36.56, "end": 36.96, "text": "不是"}, {"start": 37.24, "end": 38.92, "text": "不要錢他們怎麼掙錢"}, {"start": 40.5, "end": 42.02, "text": "這船是曹韻幫派的"}, {"start": 42.5, "end": 43.86, "text": "他們不收咱們的船費"}, {"start": 44.46, "end": 44.94, "text": "當然"}, {"start": 45.3, "end": 46.98, "text": "若是他們生出一些小事"}, {"start": 47.46, "end": 49.02, "text": "咱們讓他們自行解決就行"}, {"start": 50.82, "end": 52.02, "text": "曹韻幫派"}, {"start": 52.7, "end": 54.42, "text": "已經越過朝天的管制了"}, {"start": 57.27, "end": 58.71, "text": "郭大人也不過問嗎"}]}