{"file": "满朝文武都以为我败家-第102集.mp4", "ep": 102, "duration": 55.1, "segments": [{"start": 0.0, "end": 1.08, "text": "少爺 少爺"}, {"start": 1.36, "end": 2.4, "text": "老爺來信了"}, {"start": 3.28, "end": 4.32, "text": "我爹還記得我"}, {"start": 6.02, "end": 7.42, "text": "為父已到山海關"}, {"start": 7.5, "end": 8.1, "text": "悟孽"}, {"start": 8.22, "end": 9.14, "text": "天氣見了"}, {"start": 9.38, "end": 11.18, "text": "我兒在家記了增添衣服"}, {"start": 11.3, "end": 12.1, "text": "為父不在"}, {"start": 12.1, "end": 13.3, "text": "我人幫你上後"}, {"start": 13.5, "end": 14.86, "text": "我兒莫要闖禍"}, {"start": 17.05, "end": 18.33, "text": "我怎麼可能會闖禍"}, {"start": 23.94, "end": 24.5, "text": "方伯"}, {"start": 24.9, "end": 25.86, "text": "我給我爹寫封信"}, {"start": 25.86, "end": 26.82, "text": "你讓人給他帶過去"}, {"start": 26.82, "end": 27.94, "text": "好嘞 少爺"}, {"start": 28.14, "end": 28.9, "text": "走去廚房"}, {"start": 31.18, "end": 31.98, "text": "你十字"}, {"start": 32.18, "end": 32.7, "text": "少爺"}, {"start": 32.7, "end": 34.02, "text": "小的讀過幾年書"}, {"start": 34.14, "end": 34.86, "text": "會算嗎"}, {"start": 35.14, "end": 35.78, "text": "少爺"}, {"start": 35.78, "end": 37.46, "text": "我之前一直往帳房作帳"}, {"start": 37.58, "end": 38.42, "text": "學過一些"}, {"start": 39.02, "end": 41.02, "text": "這不 人才就來了嗎"}, {"start": 41.74, "end": 42.22, "text": "不錯"}, {"start": 42.54, "end": 43.82, "text": "等著本公子重用吧"}, {"start": 44.18, "end": 44.98, "text": "多謝少爺"}, {"start": 45.7, "end": 46.42, "text": "不用這樣"}, {"start": 46.54, "end": 47.46, "text": "咱們都是自家人"}, {"start": 48.09, "end": 49.65, "text": "本公子也是剛好要用人"}, {"start": 50.13, "end": 51.41, "text": "是方光幫了我才是"}]}