{"file": "末世度假酒店-第21集.mp4", "ep": 21, "duration": 53.2, "segments": [{"start": 0.0, "end": 1.8, "text": "对 他不仅穿得干净整洁"}, {"start": 1.8, "end": 2.68, "text": "气色还特别好"}, {"start": 2.68, "end": 4.08, "text": "看起来完全不缺资源"}, {"start": 4.08, "end": 5.0, "text": "那还等什么"}, {"start": 5.0, "end": 5.84, "text": "抱他腿去"}, {"start": 5.84, "end": 6.44, "text": "等等"}, {"start": 6.44, "end": 7.2, "text": "我刚才说了"}, {"start": 7.2, "end": 8.0, "text": "他不仅长得好看"}, {"start": 8.0, "end": 8.72, "text": "还穿得很干净"}, {"start": 8.72, "end": 9.8, "text": "你这样过去不行"}, {"start": 9.8, "end": 11.04, "text": "那你还站着干什么"}, {"start": 11.04, "end": 12.2, "text": "快去给我接水啊"}, {"start": 12.2, "end": 13.68, "text": "难道你想让我顶着这副鬼样子"}, {"start": 13.68, "end": 14.48, "text": "去见金主"}, {"start": 14.48, "end": 15.48, "text": "你 你忘了"}, {"start": 15.48, "end": 16.64, "text": "上次变换人格的时候"}, {"start": 16.64, "end": 18.04, "text": "你把他扔下窗外了"}, {"start": 18.04, "end": 18.64, "text": "他"}, {"start": 18.64, "end": 21.41, "text": "那个有些强大的水系艺能者"}, {"start": 21.41, "end": 26.07, "text": "试图控制我的老女人"}, {"start": 26.07, "end": 27.03, "text": "糟了"}, {"start": 27.03, "end": 28.75, "text": "主人又要变人格了"}, {"start": 37.62, "end": 38.66, "text": "我在"}, {"start": 38.66, "end": 39.34, "text": "前面带路"}, {"start": 39.34, "end": 40.74, "text": "是 是"}, {"start": 40.78, "end": 51.71, "text": "心怀不轨的女人都该死"}, {"start": 51.71, "end": 52.35, "text": "人呢"}]}