{"file": "末世度假酒店-第81集.mp4", "ep": 81, "duration": 49.8, "segments": [{"start": 3.15, "end": 4.23, "text": "快歇歇 妖儿"}, {"start": 4.23, "end": 5.23, "text": "没受伤吧"}, {"start": 5.23, "end": 6.23, "text": "身上疼不疼"}, {"start": 6.23, "end": 6.75, "text": "没事"}, {"start": 6.75, "end": 7.63, "text": "一点伤都没有"}, {"start": 7.63, "end": 8.23, "text": "好着呢"}, {"start": 8.23, "end": 8.87, "text": "那就好"}, {"start": 8.87, "end": 9.95, "text": "那快上楼洗漱吧"}, {"start": 9.95, "end": 11.03, "text": "吃完饭赶紧下来"}, {"start": 11.03, "end": 12.43, "text": "老板说晚上请咱们看戏"}, {"start": 12.43, "end": 13.19, "text": "看戏"}, {"start": 13.51, "end": 15.62, "text": "赶紧上去"}, {"start": 15.62, "end": 16.42, "text": "别看她"}, {"start": 18.94, "end": 19.78, "text": "速度点"}, {"start": 19.78, "end": 21.22, "text": "别耽误大家的时间"}, {"start": 21.22, "end": 22.71, "text": "马上就好"}, {"start": 22.71, "end": 23.55, "text": "夏老板"}, {"start": 23.55, "end": 24.23, "text": "马上"}, {"start": 38.64, "end": 39.68, "text": "自己看监控吧"}, {"start": 39.68, "end": 41.28, "text": "把这都是干了什么蠢事啊"}, {"start": 41.56, "end": 42.84, "text": "您知道这是什么地方"}, {"start": 42.84, "end": 43.93, "text": "下去完完了"}, {"start": 43.93, "end": 45.53, "text": "晚饭前把这里彻底弄干净"}, {"start": 45.53, "end": 46.57, "text": "装满这三个袋子"}, {"start": 46.57, "end": 47.85, "text": "少擦一块砖"}, {"start": 47.85, "end": 49.57, "text": "我就把你跟你爸挂在一起"}]}