{"file": "末世度假酒店-第44集.mp4", "ep": 44, "duration": 47.7, "segments": [{"start": 1.84, "end": 2.52, "text": "老板"}, {"start": 3.5, "end": 4.34, "text": "客人有事吗"}, {"start": 4.5, "end": 5.98, "text": "不知道老板说的那些话"}, {"start": 6.14, "end": 6.9, "text": "还做数吗"}, {"start": 8.37, "end": 9.65, "text": "可以大量提供货物的事"}, {"start": 9.65, "end": 10.21, "text": "做数"}, {"start": 10.45, "end": 11.81, "text": "明天一大早我就离开"}, {"start": 12.42, "end": 13.78, "text": "也会静态赶回来提货"}, {"start": 14.06, "end": 15.52, "text": "希望老板能把货备足"}, {"start": 15.68, "end": 16.84, "text": "都要耽误双方的时间"}, {"start": 16.84, "end": 17.48, "text": "没问题"}, {"start": 18.04, "end": 20.96, "text": "还不知道怎么称呼老板"}, {"start": 22.52, "end": 23.2, "text": "我姓夏"}, {"start": 23.44, "end": 24.56, "text": "叫我夏老板就好"}, {"start": 25.04, "end": 26.53, "text": "好的夏老板"}, {"start": 26.73, "end": 27.57, "text": "我叫苏梅"}, {"start": 28.09, "end": 33.96, "text": "锦衣卖"}, {"start": 33.96, "end": 34.96, "text": "你就给我照明就行"}, {"start": 34.96, "end": 35.56, "text": "站那儿别动"}, {"start": 36.16, "end": 37.53, "text": "好"}, {"start": 37.77, "end": 40.74, "text": "这个报帧好看"}, {"start": 40.74, "end": 41.3, "text": "拿走"}, {"start": 41.42, "end": 42.58, "text": "这个额脚灯也不错"}, {"start": 42.58, "end": 43.3, "text": "也拿走"}, {"start": 43.98, "end": 46.1, "text": "还有这个胡桃木的石木单人床"}, {"start": 46.26, "end": 46.9, "text": "都拿走"}]}