{"file": "末世度假酒店-第121集.mp4", "ep": 121, "duration": 53.9, "segments": [{"start": 0.48, "end": 1.04, "text": "夏老板"}, {"start": 1.16, "end": 2.04, "text": "我也要买东西"}, {"start": 2.64, "end": 3.4, "text": "客人要买什么"}, {"start": 3.64, "end": 4.48, "text": "就刚刚他要的"}, {"start": 4.6, "end": 5.8, "text": "同样给我也来一份"}, {"start": 6.24, "end": 6.68, "text": "好的"}, {"start": 7.04, "end": 8.48, "text": "一共是一百五十二级分"}, {"start": 8.8, "end": 9.4, "text": "请刷卡"}, {"start": 17.23, "end": 17.71, "text": "别看"}, {"start": 21.89, "end": 22.89, "text": "大家一定要安静"}, {"start": 23.17, "end": 24.29, "text": "宾馆路途遥远"}, {"start": 24.41, "end": 25.73, "text": "我们尽量保护好大家"}, {"start": 25.85, "end": 27.13, "text": "千万别到处乱跑"}, {"start": 27.57, "end": 28.01, "text": "大妈"}, {"start": 28.49, "end": 29.85, "text": "我们一定会安全到宾馆的"}, {"start": 35.1, "end": 35.82, "text": "大家拿好"}, {"start": 35.98, "end": 36.9, "text": "路上也有个保障"}, {"start": 41.37, "end": 41.85, "text": "儿子"}, {"start": 42.13, "end": 43.21, "text": "他叫你过去干吗"}, {"start": 43.37, "end": 43.89, "text": "没什么"}, {"start": 44.17, "end": 45.65, "text": "只是让我跟他们去第二级地"}, {"start": 45.65, "end": 46.29, "text": "我拒绝了"}, {"start": 46.98, "end": 47.82, "text": "儿子不同意"}, {"start": 47.94, "end": 49.1, "text": "就说明没那么简单"}, {"start": 49.38, "end": 50.62, "text": "既然说了以后信儿子"}, {"start": 50.78, "end": 51.82, "text": "就不能出儿凡儿"}, {"start": 53.22, "end": 53.82, "text": "我知道了"}]}