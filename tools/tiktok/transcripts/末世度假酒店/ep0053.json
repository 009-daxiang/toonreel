{"file": "末世度假酒店-第53集.mp4", "ep": 53, "duration": 55.2, "segments": [{"start": 0.18, "end": 1.18, "text": "快请进"}, {"start": 1.18, "end": 2.18, "text": "早餐已经准备好了"}, {"start": 2.18, "end": 3.18, "text": "请用餐吧"}, {"start": 3.18, "end": 5.23, "text": "夏老板"}, {"start": 5.23, "end": 6.23, "text": "一夜未见"}, {"start": 6.23, "end": 8.23, "text": "店内变化这么大的吗"}, {"start": 8.23, "end": 10.23, "text": "欢迎光临度假宾馆全天服务餐厅"}, {"start": 10.23, "end": 12.23, "text": "为保证顾客的人身安全"}, {"start": 12.23, "end": 14.23, "text": "本店禁止使用意义"}, {"start": 14.23, "end": 16.23, "text": "统一体力值为五十"}, {"start": 16.23, "end": 18.23, "text": "离开宾馆后即可恢复"}, {"start": 18.23, "end": 20.33, "text": "果然调动不了意泥"}, {"start": 20.33, "end": 21.33, "text": "算了"}, {"start": 21.33, "end": 23.33, "text": "等吃完出去看看能不能恢复"}, {"start": 23.33, "end": 24.33, "text": "餐盘呢"}, {"start": 24.33, "end": 36.82, "text": "包机啊"}, {"start": 36.82, "end": 37.82, "text": "最贵才八几分"}, {"start": 37.82, "end": 38.82, "text": "最便宜"}, {"start": 38.82, "end": 39.82, "text": "一几分"}, {"start": 39.82, "end": 42.02, "text": "先回到了墨世前"}, {"start": 42.02, "end": 51.66, "text": "力量回来了"}, {"start": 51.66, "end": 53.66, "text": "是时候出门攒金盒了"}]}