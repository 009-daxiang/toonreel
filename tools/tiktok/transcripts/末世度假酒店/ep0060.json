{"file": "末世度假酒店-第60集.mp4", "ep": 60, "duration": 41.7, "segments": [{"start": 0.96, "end": 1.72, "text": "冯经理"}, {"start": 1.72, "end": 3.44, "text": "这事怎么能轮到你干呢"}, {"start": 3.44, "end": 4.6, "text": "我们啥啥都不会"}, {"start": 4.6, "end": 5.64, "text": "只能吃干饭"}, {"start": 5.92, "end": 6.76, "text": "冯经理"}, {"start": 6.76, "end": 7.6, "text": "让我来"}, {"start": 7.6, "end": 8.56, "text": "你快歇着"}, {"start": 9.07, "end": 9.87, "text": "女同志"}, {"start": 10.38, "end": 11.74, "text": "感谢你的无私奉献"}, {"start": 12.14, "end": 13.5, "text": "我一定会在物资来了后"}, {"start": 13.5, "end": 14.54, "text": "给你多发一份"}, {"start": 14.7, "end": 16.1, "text": "冯 冯经理"}, {"start": 16.1, "end": 17.21, "text": "那"}, {"start": 17.21, "end": 17.93, "text": "必须真"}, {"start": 18.13, "end": 19.45, "text": "不然天打雷劈"}, {"start": 20.44, "end": 24.42, "text": "谢谢 谢谢下去了"}, {"start": 24.42, "end": 29.7, "text": "一群暴民"}, {"start": 29.7, "end": 30.7, "text": "还想要物资"}, {"start": 30.7, "end": 31.62, "text": "想得美"}, {"start": 31.62, "end": 32.22, "text": "奶奶"}, {"start": 32.22, "end": 32.94, "text": "我们走"}, {"start": 32.94, "end": 34.02, "text": "就算是死了"}, {"start": 34.02, "end": 35.82, "text": "我们也要死在干净的地方"}, {"start": 37.46, "end": 38.94, "text": "我们先去宾馆吃两天"}, {"start": 39.02, "end": 40.66, "text": "养胖点再去找你的领导汇报"}, {"start": 40.66, "end": 41.7, "text": "不是更有说服力吗"}]}