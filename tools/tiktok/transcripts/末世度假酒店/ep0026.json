{"file": "末世度假酒店-第26集.mp4", "ep": 26, "duration": 52.0, "segments": [{"start": 5.52, "end": 6.24, "text": "系統"}, {"start": 6.48, "end": 8.76, "text": "咱商城裏有沒有便宜點的洗衣機"}, {"start": 8.76, "end": 10.24, "text": "洗衣烘乾液體機"}, {"start": 10.24, "end": 11.72, "text": "最低500積分"}, {"start": 11.72, "end": 13.0, "text": "500太貴了"}, {"start": 13.0, "end": 14.24, "text": "有沒有單獨洗衣服的"}, {"start": 14.24, "end": 14.68, "text": "有"}, {"start": 14.68, "end": 15.56, "text": "單洗脫水機"}, {"start": 15.56, "end": 16.64, "text": "50積分一台"}, {"start": 16.64, "end": 17.04, "text": "好"}, {"start": 17.04, "end": 17.68, "text": "就買這個"}, {"start": 17.68, "end": 18.12, "text": "要兩台"}, {"start": 18.12, "end": 18.44, "text": "釘"}, {"start": 18.44, "end": 19.44, "text": "以放置完畢"}, {"start": 19.44, "end": 20.88, "text": "再買一個歷史玻璃斬櫃"}, {"start": 20.88, "end": 21.56, "text": "放在大廳"}, {"start": 21.56, "end": 22.48, "text": "斬櫃以放置"}, {"start": 22.48, "end": 23.96, "text": "需要補充其他售賣物品嗎"}, {"start": 23.96, "end": 25.28, "text": "把洗衣粉 衛生巾"}, {"start": 25.28, "end": 26.08, "text": "換線的衣物"}, {"start": 26.08, "end": 26.84, "text": "都放進去"}, {"start": 27.61, "end": 29.69, "text": "這樣才像個能長期營業的酒店"}, {"start": 31.5, "end": 32.34, "text": "老闆好"}, {"start": 32.34, "end": 43.11, "text": "我要恢復得更快"}, {"start": 43.11, "end": 44.15, "text": "再快一點"}, {"start": 44.15, "end": 46.15, "text": "這樣才能早日回到戰場"}]}