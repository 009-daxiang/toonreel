{"file": "末世度假酒店-第134集.mp4", "ep": 134, "duration": 40.6, "segments": [{"start": 0.34, "end": 1.74, "text": "我只是个开宾馆的"}, {"start": 1.74, "end": 2.9, "text": "没有旧事的心"}, {"start": 2.9, "end": 3.86, "text": "也没有这个能力"}, {"start": 3.86, "end": 5.3, "text": "小店里吃喝都有"}, {"start": 5.3, "end": 6.26, "text": "还绝对的安全"}, {"start": 6.26, "end": 7.02, "text": "如果你们只打算"}, {"start": 7.02, "end": 7.5, "text": "依靠别人"}, {"start": 7.5, "end": 8.62, "text": "等卡里的积分消耗完"}, {"start": 8.62, "end": 9.86, "text": "我会立刻把你们赶出去"}, {"start": 10.42, "end": 12.31, "text": "我知道了"}, {"start": 14.52, "end": 15.36, "text": "不用担心"}, {"start": 15.36, "end": 16.4, "text": "天塌下来"}, {"start": 16.4, "end": 17.4, "text": "都有爸爸顶着"}, {"start": 17.4, "end": 19.36, "text": "以后日子会一天天好起来的"}, {"start": 20.58, "end": 21.26, "text": "果然"}, {"start": 21.26, "end": 23.1, "text": "还是美食能治愈人心"}, {"start": 23.1, "end": 35.7, "text": "怎么样"}, {"start": 35.7, "end": 36.34, "text": "张开嘴"}, {"start": 36.34, "end": 39.73, "text": "慢点吃"}, {"start": 39.76, "end": 40.6, "text": "都是你的"}]}