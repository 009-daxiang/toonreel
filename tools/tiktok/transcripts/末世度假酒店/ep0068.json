{"file": "末世度假酒店-第68集.mp4", "ep": 68, "duration": 51.5, "segments": [{"start": 1.46, "end": 2.78, "text": "顾客打算住店吗"}, {"start": 2.78, "end": 4.34, "text": "小店即将关门休息了"}, {"start": 4.34, "end": 5.74, "text": "住 住宿"}, {"start": 5.74, "end": 7.42, "text": "怎么 怎么收费"}, {"start": 7.42, "end": 8.58, "text": "小店提供住宿"}, {"start": 8.58, "end": 10.74, "text": "单人间一人只需要三十几分"}, {"start": 11.95, "end": 12.67, "text": "不要怕"}, {"start": 12.67, "end": 14.07, "text": "只是给你们照路用的"}, {"start": 14.07, "end": 15.19, "text": "需要住店吗"}, {"start": 15.39, "end": 16.47, "text": "如果不用的话"}, {"start": 16.47, "end": 17.55, "text": "小店就关门了"}, {"start": 18.07, "end": 20.8, "text": "那我关门喽"}, {"start": 21.4, "end": 25.43, "text": "熊熊"}, {"start": 25.43, "end": 26.23, "text": "开门吧"}, {"start": 26.23, "end": 27.23, "text": "我回去睡觉了"}, {"start": 27.55, "end": 28.67, "text": "好搭主人"}, {"start": 29.19, "end": 32.42, "text": "摇儿"}, {"start": 32.42, "end": 35.1, "text": "冯天席两人进居后"}, {"start": 35.1, "end": 36.18, "text": "一直没出来吧"}, {"start": 36.18, "end": 37.9, "text": "冯天席从里面拿了东西出来"}, {"start": 37.9, "end": 38.86, "text": "一脸惊喜"}, {"start": 39.1, "end": 39.9, "text": "那台机器"}, {"start": 40.02, "end": 41.1, "text": "一定有什么秘密"}, {"start": 44.7, "end": 45.58, "text": "能不能砸开"}, {"start": 48.58, "end": 49.1, "text": "算了"}, {"start": 49.34, "end": 50.53, "text": "还是先找个安全的地方"}, {"start": 50.53, "end": 51.37, "text": "度过精原吧"}]}