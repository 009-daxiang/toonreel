{"file": "末世度假酒店-第129集.mp4", "ep": 129, "duration": 45.6, "segments": [{"start": 0.0, "end": 1.72, "text": "对对对 我们三个人"}, {"start": 5.44, "end": 6.56, "text": "上面有价格表"}, {"start": 6.56, "end": 7.36, "text": "先别急"}, {"start": 7.68, "end": 9.16, "text": "双人间五十积分"}, {"start": 9.16, "end": 11.04, "text": "加一人需支付八十积分"}, {"start": 11.24, "end": 12.84, "text": "夏老板 我们住双人间"}, {"start": 13.0, "end": 14.92, "text": "你之前住过 应该了解便归"}, {"start": 15.04, "end": 17.0, "text": "了解 就按夏老板说的来"}, {"start": 20.02, "end": 21.66, "text": "还有谁要住宿一个一个来"}, {"start": 21.66, "end": 22.78, "text": "有积分卡的优先"}, {"start": 22.78, "end": 24.46, "text": "不 我有积分卡"}, {"start": 24.46, "end": 24.98, "text": "我有积分卡"}, {"start": 24.98, "end": 26.34, "text": "通知 先给我开一间"}, {"start": 27.42, "end": 28.1, "text": "双人间"}, {"start": 28.42, "end": 30.1, "text": "不 我要两个单人间"}, {"start": 30.42, "end": 30.94, "text": "不行"}, {"start": 31.18, "end": 32.34, "text": "我 为什么"}, {"start": 32.5, "end": 33.5, "text": "人多房间少"}, {"start": 33.78, "end": 34.82, "text": "你们在基地里的房子"}, {"start": 34.82, "end": 35.74, "text": "不也是单人间吗"}, {"start": 35.98, "end": 37.14, "text": "那就双人间"}, {"start": 37.5, "end": 38.06, "text": "刷卡吧"}, {"start": 39.17, "end": 39.77, "text": "五十积分"}, {"start": 41.86, "end": 43.22, "text": "下一位顾客 你来吧"}, {"start": 43.78, "end": 45.54, "text": "我们要双人间 三个人"}]}