{"file": "末世度假酒店-第104集.mp4", "ep": 104, "duration": 47.1, "segments": [{"start": 0.0, "end": 0.6, "text": "别急"}, {"start": 0.84, "end": 1.8, "text": "走他们拍好队"}, {"start": 1.96, "end": 3.4, "text": "手里有金河的才能购买"}, {"start": 3.52, "end": 4.16, "text": "不许抢"}, {"start": 4.28, "end": 5.04, "text": "我有金河"}, {"start": 5.04, "end": 5.68, "text": "让我过去"}, {"start": 5.68, "end": 6.4, "text": "我有钱"}, {"start": 6.4, "end": 6.96, "text": "我也有"}, {"start": 6.96, "end": 7.68, "text": "我先买"}, {"start": 7.8, "end": 8.68, "text": "我家里上有老母"}, {"start": 8.68, "end": 9.32, "text": "下有小孩"}, {"start": 9.32, "end": 10.16, "text": "让我先买"}, {"start": 10.16, "end": 11.84, "text": "谁家没着招队等吃饭的人"}, {"start": 11.84, "end": 12.88, "text": "别打老子的道"}, {"start": 17.7, "end": 18.3, "text": "何饭呢"}, {"start": 18.82, "end": 19.7, "text": "我的何饭呢"}, {"start": 19.98, "end": 20.78, "text": "再不滚"}, {"start": 20.98, "end": 22.86, "text": "消失的就不仅仅是何饭了"}, {"start": 26.74, "end": 27.46, "text": "其他人"}, {"start": 27.46, "end": 27.9, "text": "来"}, {"start": 28.1, "end": 28.82, "text": "不要急"}, {"start": 29.26, "end": 30.22, "text": "谁有金河"}, {"start": 30.22, "end": 31.06, "text": "举手示意"}, {"start": 31.3, "end": 31.86, "text": "我有"}, {"start": 31.86, "end": 32.82, "text": "我有金河"}, {"start": 32.82, "end": 33.3, "text": "我也有"}, {"start": 33.3, "end": 34.22, "text": "老板看我"}, {"start": 34.22, "end": 34.74, "text": "行"}, {"start": 34.82, "end": 35.3, "text": "你"}, {"start": 35.3, "end": 36.3, "text": "过来冲击分吧"}, {"start": 37.15, "end": 37.75, "text": "冲好了"}, {"start": 37.91, "end": 39.31, "text": "这枚金河兑换了一百击分"}, {"start": 39.31, "end": 40.03, "text": "都在卡里"}, {"start": 40.19, "end": 40.87, "text": "要哪个饭"}, {"start": 41.19, "end": 42.15, "text": "鱼香肉丝饭"}, {"start": 42.35, "end": 43.54, "text": "好"}, {"start": 43.54, "end": 44.3, "text": "举手示意"}, {"start": 44.5, "end": 44.94, "text": "我"}, {"start": 44.94, "end": 45.54, "text": "还有我"}, {"start": 45.54, "end": 46.42, "text": "老板看见了"}]}