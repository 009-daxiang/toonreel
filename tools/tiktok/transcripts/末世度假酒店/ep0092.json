{"file": "末世度假酒店-第92集.mp4", "ep": 92, "duration": 46.6, "segments": [{"start": 0.14, "end": 0.86, "text": "没有没有"}, {"start": 0.86, "end": 1.74, "text": "天地良心"}, {"start": 1.74, "end": 2.94, "text": "我们真的是来住宿的"}, {"start": 2.94, "end": 4.1, "text": "对店主出言不讯"}, {"start": 4.1, "end": 4.98, "text": "还想入住"}, {"start": 4.98, "end": 6.06, "text": "出去另找地方"}, {"start": 6.06, "end": 7.62, "text": "再闹事直接为丧失"}, {"start": 7.62, "end": 8.66, "text": "熊熊 丢出去"}, {"start": 12.98, "end": 13.98, "text": "老大"}, {"start": 13.98, "end": 15.06, "text": "接下来怎么办"}, {"start": 15.06, "end": 15.78, "text": "还能怎么办"}, {"start": 15.78, "end": 16.82, "text": "想办法住进去"}, {"start": 16.82, "end": 18.74, "text": "你没看见里面有水有电有空调吗"}, {"start": 18.74, "end": 19.7, "text": "笨蛋"}, {"start": 19.7, "end": 20.78, "text": "要是你不招惹老板"}, {"start": 20.78, "end": 22.02, "text": "我们早就住进去了"}, {"start": 22.02, "end": 22.86, "text": "第二任阁的细致"}, {"start": 22.86, "end": 24.46, "text": "从来不会干这种蠢事"}, {"start": 24.46, "end": 25.98, "text": "偏偏主任阁总乱来"}, {"start": 25.98, "end": 27.26, "text": "夕颜也很久没出现了"}, {"start": 27.26, "end": 27.9, "text": "放屁"}, {"start": 27.9, "end": 28.62, "text": "这能怪我"}, {"start": 28.62, "end": 29.5, "text": "是你侦查不利"}, {"start": 29.5, "end": 30.82, "text": "没摸起老板性格害我挨打"}, {"start": 30.82, "end": 31.7, "text": "结果你必须被"}, {"start": 32.3, "end": 32.94, "text": "好好好"}, {"start": 32.94, "end": 33.74, "text": "我的错"}, {"start": 33.74, "end": 35.18, "text": "那我们现在到底怎么办"}, {"start": 35.18, "end": 36.06, "text": "没办法"}, {"start": 36.06, "end": 38.02, "text": "那只毛绒熊打人也太疼了"}, {"start": 38.02, "end": 39.02, "text": "还专门打脸"}, {"start": 39.02, "end": 39.66, "text": "气死我了"}, {"start": 39.66, "end": 40.26, "text": "不行"}, {"start": 40.26, "end": 41.34, "text": "我一定要住进去"}, {"start": 41.34, "end": 42.26, "text": "先找地方落脚"}, {"start": 42.26, "end": 43.1, "text": "明天再来"}, {"start": 43.1, "end": 44.1, "text": "我刚看过了"}, {"start": 44.1, "end": 45.38, "text": "后面有洞空军名楼"}, {"start": 45.38, "end": 46.58, "text": "我们暂时住那里就行"}]}