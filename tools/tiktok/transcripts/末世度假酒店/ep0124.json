{"file": "末世度假酒店-第124集.mp4", "ep": 124, "duration": 56.8, "segments": [{"start": 1.33, "end": 2.45, "text": "快推到樓上去"}, {"start": 2.45, "end": 3.29, "text": "快"}, {"start": 3.29, "end": 4.49, "text": "你们也快躲起来"}, {"start": 4.49, "end": 5.69, "text": "躲到对面的楼上去"}, {"start": 5.69, "end": 6.89, "text": "快点"}, {"start": 6.89, "end": 7.65, "text": "出去"}, {"start": 7.65, "end": 9.01, "text": "我们没有保护你们的义务"}, {"start": 14.94, "end": 16.18, "text": "快去找东西啊"}, {"start": 16.18, "end": 17.34, "text": "傻站在干吗"}, {"start": 17.34, "end": 17.98, "text": "我"}, {"start": 17.98, "end": 19.38, "text": "我腿上没劲"}, {"start": 19.38, "end": 20.38, "text": "躲不了路"}, {"start": 21.26, "end": 22.14, "text": "东西来了"}, {"start": 22.14, "end": 23.14, "text": "快门"}, {"start": 24.66, "end": 25.14, "text": "上帝啊"}, {"start": 25.14, "end": 25.9, "text": "求你救救我"}, {"start": 25.9, "end": 26.94, "text": "给条活路吧"}, {"start": 26.94, "end": 27.98, "text": "滚一边去"}, {"start": 27.98, "end": 28.78, "text": "与其求上帝"}, {"start": 28.78, "end": 29.98, "text": "还不如求老子我"}, {"start": 29.98, "end": 31.02, "text": "你们安静点"}, {"start": 31.02, "end": 31.82, "text": "别吵了"}, {"start": 31.82, "end": 33.54, "text": "要把桑思基也过来了"}, {"start": 40.54, "end": 42.14, "text": "闭嘴桑思来了"}, {"start": 42.14, "end": 43.14, "text": "闭嘴"}, {"start": 44.75, "end": 45.95, "text": "快挡住门"}, {"start": 45.95, "end": 47.07, "text": "再拿东西来"}, {"start": 47.07, "end": 47.91, "text": "不够"}, {"start": 49.38, "end": 50.94, "text": "别再发出声音了"}, {"start": 50.94, "end": 51.94, "text": "求你们了"}, {"start": 52.46, "end": 54.02, "text": "桑思基来了"}]}