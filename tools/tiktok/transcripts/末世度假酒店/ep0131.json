{"file": "末世度假酒店-第131集.mp4", "ep": 131, "duration": 45.5, "segments": [{"start": 0.05, "end": 1.01, "text": "下一位顾客"}, {"start": 1.49, "end": 2.21, "text": "夏老板"}, {"start": 2.37, "end": 3.41, "text": "给我一间房办"}, {"start": 3.41, "end": 4.13, "text": "求你了"}, {"start": 4.13, "end": 5.37, "text": "我的孩子快不行了"}, {"start": 5.37, "end": 6.37, "text": "求你了 夏老板"}, {"start": 6.37, "end": 7.29, "text": "夏老板 给我一间房办"}, {"start": 7.29, "end": 8.21, "text": "我家也有孩子"}, {"start": 8.21, "end": 9.05, "text": "求求你 夏老板"}, {"start": 9.05, "end": 10.21, "text": "我也是 我也是 我也是 我也是"}, {"start": 10.21, "end": 11.21, "text": "先别吵"}, {"start": 11.21, "end": 13.05, "text": "你们和自己家人站在一起"}, {"start": 13.05, "end": 14.77, "text": "我根据人数分配房间"}, {"start": 15.76, "end": 17.4, "text": "别急 都能住进来"}, {"start": 17.4, "end": 18.16, "text": "你先来吧"}, {"start": 18.72, "end": 20.4, "text": "你们就住最后一间双人间"}, {"start": 20.4, "end": 21.12, "text": "310吧"}, {"start": 21.86, "end": 23.78, "text": "你们暂时住单人间206吧"}, {"start": 23.78, "end": 25.06, "text": "要是双人间空出来"}, {"start": 25.06, "end": 26.3, "text": "安排你们优先入住"}, {"start": 26.93, "end": 29.13, "text": "你们剩下的人就住单人间"}, {"start": 35.27, "end": 35.87, "text": "熊熊"}, {"start": 35.99, "end": 37.03, "text": "等客人们放好东西"}, {"start": 37.03, "end": 37.95, "text": "你把大家叫下来"}, {"start": 37.95, "end": 39.31, "text": "我有些事需要提前告知"}]}