{"file": "末世度假酒店-第17集.mp4", "ep": 17, "duration": 47.6, "segments": [{"start": 0.0, "end": 1.6, "text": "收工 吃飯"}, {"start": 33.7, "end": 35.7, "text": "第二 偷盜本店財務"}, {"start": 35.7, "end": 38.86, "text": "惡意騷擾其他住戶 挑撥事端者"}, {"start": 38.86, "end": 40.86, "text": "喪屍堆裡一日遊"}, {"start": 40.86, "end": 44.58, "text": "最後再寫上 一切解釋權歸本店所有"}, {"start": 44.58, "end": 45.58, "text": "不錯"}]}