{"file": "末世度假酒店-第85集.mp4", "ep": 85, "duration": 59.4, "segments": [{"start": 0.56, "end": 1.64, "text": "我替她還"}, {"start": 2.04, "end": 3.28, "text": "回期一星期"}, {"start": 3.28, "end": 5.2, "text": "把三枚二級金盒還給我"}, {"start": 5.2, "end": 6.48, "text": "過時不厚"}, {"start": 8.86, "end": 9.7, "text": "親名子"}, {"start": 9.7, "end": 11.18, "text": "從現在開始"}, {"start": 11.18, "end": 12.58, "text": "你就跟在蓬佩身邊"}, {"start": 12.58, "end": 14.18, "text": "二十四小時不能離開"}, {"start": 16.62, "end": 17.62, "text": "各位顧客"}, {"start": 17.62, "end": 20.18, "text": "今晚耽誤大家寶貴的休息時間了"}, {"start": 20.18, "end": 21.38, "text": "時間不早了"}, {"start": 21.38, "end": 23.62, "text": "還請顧客們進往上樓休息"}, {"start": 23.62, "end": 36.48, "text": "還背上三枚二級金盒的外站"}, {"start": 36.48, "end": 37.74, "text": "我一個人"}, {"start": 37.74, "end": 40.22, "text": "怎麼去殺二級喪屍啊"}, {"start": 40.22, "end": 41.34, "text": "系統"}, {"start": 41.34, "end": 42.42, "text": "熊熊怎麼升級"}, {"start": 42.42, "end": 44.14, "text": "升級到二級需要兩百積分"}, {"start": 44.3, "end": 45.46, "text": "可升級語言功能"}, {"start": 45.46, "end": 46.98, "text": "解鎖更複雜的智能對答"}, {"start": 46.98, "end": 48.02, "text": "好升級吧"}, {"start": 48.02, "end": 50.02, "text": "從我私人帳戶裡支付積分"}, {"start": 50.02, "end": 55.82, "text": "開門"}, {"start": 55.82, "end": 57.62, "text": "保護大家安全"}, {"start": 57.62, "end": 59.26, "text": "熊熊乖乖開門"}]}