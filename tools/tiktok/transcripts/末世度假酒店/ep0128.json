{"file": "末世度假酒店-第128集.mp4", "ep": 128, "duration": 43.4, "segments": [{"start": 0.0, "end": 0.8, "text": "熊熊"}, {"start": 0.8, "end": 2.6, "text": "把刚才带头的几人丢出去"}, {"start": 2.6, "end": 4.9, "text": "凭什么赶我出去"}, {"start": 4.9, "end": 5.9, "text": "我什么都没干"}, {"start": 5.9, "end": 6.7, "text": "凭什么"}, {"start": 6.7, "end": 8.1, "text": "就凭宾馆是我的"}, {"start": 8.1, "end": 8.5, "text": "而且"}, {"start": 8.5, "end": 9.7, "text": "你以为我忘记你了"}, {"start": 9.7, "end": 11.3, "text": "那天抢和饭的就是你吧"}, {"start": 11.3, "end": 13.1, "text": "把他直接扔在丧事堆里"}, {"start": 14.3, "end": 14.9, "text": "我错了"}, {"start": 14.9, "end": 15.7, "text": "夏老板"}, {"start": 15.7, "end": 16.9, "text": "那不是我的本意"}, {"start": 16.9, "end": 18.9, "text": "我是听从了别人的挑唆啊"}, {"start": 18.9, "end": 20.5, "text": "别把我扔进丧事堆里"}, {"start": 20.5, "end": 21.5, "text": "救命啊"}, {"start": 22.46, "end": 23.26, "text": "夏老板"}, {"start": 23.26, "end": 24.06, "text": "我知道错了"}, {"start": 24.06, "end": 25.46, "text": "求你给我一次机会吧"}, {"start": 25.46, "end": 26.46, "text": "杀鸡至锦侯"}, {"start": 26.46, "end": 27.66, "text": "今天不镇住他们"}, {"start": 27.66, "end": 29.46, "text": "所有人都会把我当做阮世子"}, {"start": 29.46, "end": 30.46, "text": "熊熊"}, {"start": 30.66, "end": 31.26, "text": "丢出去"}, {"start": 36.82, "end": 39.79, "text": "够狠"}, {"start": 39.79, "end": 40.59, "text": "齐化队长"}, {"start": 41.75, "end": 42.75, "text": "我在"}, {"start": 42.75, "end": 43.35, "text": "住宿"}]}