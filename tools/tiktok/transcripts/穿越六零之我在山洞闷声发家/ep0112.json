{"file": "穿越六零之我在山洞闷声发家-第112集.mp4", "ep": 112, "duration": 59.9, "segments": [{"start": 0.0, "end": 0.56, "text": "算"}, {"start": 1.17, "end": 3.17, "text": "那我以后能常来新房玩吗"}, {"start": 4.66, "end": 5.74, "text": "这也是你的家"}, {"start": 5.98, "end": 6.86, "text": "想来就来"}, {"start": 8.79, "end": 9.99, "text": "姐 你听见没"}, {"start": 10.11, "end": 11.43, "text": "姐夫说这是我的家"}, {"start": 12.42, "end": 13.18, "text": "听见了"}, {"start": 16.22, "end": 17.22, "text": "从今以后"}, {"start": 18.41, "end": 19.73, "text": "我不是一个人了"}, {"start": 23.26, "end": 24.1, "text": "秦大哥"}, {"start": 24.54, "end": 25.78, "text": "今天真想做梦"}, {"start": 26.74, "end": 27.82, "text": "还叫秦大哥"}, {"start": 29.22, "end": 30.06, "text": "那叫什么"}, {"start": 30.5, "end": 31.58, "text": "你自己想"}, {"start": 31.94, "end": 34.18, "text": "阿天"}, {"start": 34.58, "end": 42.36, "text": "以后这里真是我们的家吗"}, {"start": 42.84, "end": 43.36, "text": "是"}, {"start": 44.84, "end": 46.24, "text": "房子会越住越暖"}, {"start": 46.96, "end": 48.12, "text": "院子会种满菜"}, {"start": 48.83, "end": 50.15, "text": "审子身体会养好"}, {"start": 50.63, "end": 52.11, "text": "小山也能读书认字"}, {"start": 54.24, "end": 55.16, "text": "那我以后"}, {"start": 55.52, "end": 57.28, "text": "把院子收拾得干干净净"}, {"start": 58.16, "end": 59.68, "text": "我负责把日子撑起来"}]}