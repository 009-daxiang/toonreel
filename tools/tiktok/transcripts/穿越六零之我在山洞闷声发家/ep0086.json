{"file": "穿越六零之我在山洞闷声发家-第86集.mp4", "ep": 86, "duration": 60.6, "segments": [{"start": 0.0, "end": 1.06, "text": "你"}, {"start": 1.06, "end": 2.06, "text": "你不願意"}, {"start": 2.06, "end": 3.06, "text": "不是"}, {"start": 3.06, "end": 4.06, "text": "就是太快了"}, {"start": 4.06, "end": 5.06, "text": "我家裡"}, {"start": 6.51, "end": 7.51, "text": "家裡不用你操心"}, {"start": 7.51, "end": 8.51, "text": "婶子再好轉"}, {"start": 8.51, "end": 10.51, "text": "小山會長大"}, {"start": 10.51, "end": 11.51, "text": "有我在"}, {"start": 11.51, "end": 12.51, "text": "日子會好起來"}, {"start": 12.51, "end": 14.54, "text": "我不是一時衝動"}, {"start": 14.54, "end": 15.54, "text": "我想有個家"}, {"start": 15.54, "end": 16.54, "text": "有房子"}, {"start": 16.54, "end": 17.54, "text": "有地"}, {"start": 17.54, "end": 19.54, "text": "有你在的家"}, {"start": 19.54, "end": 20.54, "text": "秦大哥"}, {"start": 20.54, "end": 22.54, "text": "我怕我配不上你"}, {"start": 22.54, "end": 23.54, "text": "別再說這種話"}, {"start": 23.54, "end": 24.54, "text": "在我眼裡"}, {"start": 24.54, "end": 25.54, "text": "你比誰都好"}, {"start": 25.54, "end": 30.42, "text": "那就說定了"}, {"start": 30.42, "end": 31.42, "text": "等房子蓋好"}, {"start": 31.42, "end": 32.42, "text": "我去提金"}, {"start": 34.03, "end": 37.78, "text": "同志"}, {"start": 37.78, "end": 40.36, "text": "這麼晚還來場裡"}, {"start": 40.36, "end": 41.36, "text": "採購課的"}, {"start": 41.36, "end": 42.36, "text": "找高課長送貨"}, {"start": 42.36, "end": 46.89, "text": "你就是秦天同志吧"}, {"start": 46.89, "end": 47.89, "text": "高課長交代過"}, {"start": 47.89, "end": 49.89, "text": "說你這兩天可能來"}, {"start": 49.89, "end": 50.89, "text": "快進去"}, {"start": 50.89, "end": 51.89, "text": "他在辦公室"}, {"start": 51.89, "end": 52.89, "text": "謝謝"}, {"start": 52.89, "end": 58.4, "text": "小兄弟"}, {"start": 58.4, "end": 60.4, "text": "我就猜到你這兩天會來"}]}