{"file": "穿越六零之我在山洞闷声发家-第101集.mp4", "ep": 101, "duration": 59.3, "segments": [{"start": 0.8, "end": 2.6, "text": "飞龙汤给沈捷补身子"}, {"start": 3.2, "end": 5.6, "text": "飞龙?那可是稀罕物啊"}, {"start": 5.6, "end": 6.6, "text": "脱裂户采购的"}, {"start": 7.0, "end": 8.2, "text": "沈子这两天也累"}, {"start": 8.2, "end": 8.8, "text": "得补补"}, {"start": 9.0, "end": 10.2, "text": "大家一会儿都尝尝"}, {"start": 10.99, "end": 11.59, "text": "阿天"}, {"start": 11.79, "end": 12.79, "text": "别总惦记我"}, {"start": 12.99, "end": 13.99, "text": "太破费了"}, {"start": 14.59, "end": 15.79, "text": "沈子把身体养好"}, {"start": 15.99, "end": 17.39, "text": "将来还得帮我们带孩子呢"}, {"start": 25.7, "end": 26.7, "text": "这肉顿的入味"}, {"start": 26.7, "end": 28.1, "text": "阿天 你手艺绝了"}, {"start": 28.1, "end": 29.9, "text": "阿天这日子越过越红火了"}, {"start": 29.9, "end": 30.5, "text": "小夕"}, {"start": 30.5, "end": 31.9, "text": "把汤端来给大家分分"}, {"start": 39.13, "end": 39.73, "text": "沈子"}, {"start": 39.73, "end": 40.53, "text": "先喝汤"}, {"start": 43.94, "end": 44.54, "text": "怎么了"}, {"start": 44.54, "end": 45.34, "text": "没事"}, {"start": 45.54, "end": 46.74, "text": "就是太好喝了"}, {"start": 47.46, "end": 48.06, "text": "阿天"}, {"start": 48.46, "end": 49.66, "text": "谢谢你遍记着我"}, {"start": 50.06, "end": 50.66, "text": "沈子"}, {"start": 51.39, "end": 52.79, "text": "以后日子会越来越好"}, {"start": 53.39, "end": 54.19, "text": "您养好身体"}, {"start": 54.59, "end": 55.39, "text": "等着享福"}]}