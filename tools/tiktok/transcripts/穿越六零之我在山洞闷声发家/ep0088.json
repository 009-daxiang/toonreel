{"file": "穿越六零之我在山洞闷声发家-第88集.mp4", "ep": 88, "duration": 59.7, "segments": [{"start": 0.0, "end": 1.0, "text": "我减了便宜"}, {"start": 2.36, "end": 3.16, "text": "货在哪儿"}, {"start": 3.7, "end": 6.4, "text": "熊掌熊胆熊皮先弹架"}, {"start": 9.08, "end": 10.38, "text": "熊掌一只600"}, {"start": 10.78, "end": 11.88, "text": "四只2400"}, {"start": 12.48, "end": 13.58, "text": "熊胆1200"}, {"start": 14.18, "end": 15.28, "text": "熊皮360"}, {"start": 15.68, "end": 17.28, "text": "总共3960"}, {"start": 17.78, "end": 18.28, "text": "行"}, {"start": 18.78, "end": 20.18, "text": "熊肉熊骨我自己留着"}, {"start": 20.87, "end": 22.67, "text": "你小子惊的很成"}, {"start": 23.07, "end": 23.87, "text": "其他货呢"}, {"start": 24.76, "end": 25.76, "text": "粮食蔬菜"}, {"start": 25.96, "end": 27.06, "text": "29张狼皮"}, {"start": 27.56, "end": 28.96, "text": "还有苹果追力"}, {"start": 29.06, "end": 30.46, "text": "藻子都在楼下"}, {"start": 32.76, "end": 34.26, "text": "高大哥还有件事"}, {"start": 34.46, "end": 36.36, "text": "你说我准备盖房子"}, {"start": 36.46, "end": 37.56, "text": "插砖瓦水泥"}, {"start": 37.76, "end": 38.66, "text": "常理有路子吗"}, {"start": 42.45, "end": 45.15, "text": "砖瓦水泥是计划物资不好弄"}, {"start": 45.75, "end": 47.55, "text": "不过常理旧仓库要拆"}, {"start": 47.85, "end": 49.15, "text": "旧砖瓦能云你一批"}, {"start": 49.65, "end": 51.55, "text": "水泥我想办法给你三十代"}, {"start": 52.44, "end": 54.24, "text": "够了谢谢高大哥"}, {"start": 55.32, "end": 55.72, "text": "啊"}, {"start": 56.9, "end": 58.5, "text": "还有辆旧三轮自行车"}, {"start": 58.7, "end": 59.7, "text": "放仓库吃辉"}]}