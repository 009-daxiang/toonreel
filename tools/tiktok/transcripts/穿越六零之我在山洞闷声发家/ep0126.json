{"file": "穿越六零之我在山洞闷声发家-第126集.mp4", "ep": 126, "duration": 60.3, "segments": [{"start": 1.75, "end": 2.75, "text": "秦大哥"}, {"start": 3.75, "end": 4.75, "text": "娘说"}, {"start": 4.75, "end": 6.75, "text": "姑娘家最珍贵的"}, {"start": 6.75, "end": 8.75, "text": "要留在最郑重的时候"}, {"start": 8.75, "end": 9.75, "text": "我想把"}, {"start": 9.75, "end": 11.75, "text": "那件事"}, {"start": 11.75, "end": 13.75, "text": "留到咱们新婚那一晚"}, {"start": 13.75, "end": 14.75, "text": "可以吗"}, {"start": 16.01, "end": 17.01, "text": "当然可以"}, {"start": 17.01, "end": 18.14, "text": "小夕"}, {"start": 18.14, "end": 19.14, "text": "我尊重你"}, {"start": 19.14, "end": 20.14, "text": "也珍惜你"}, {"start": 20.14, "end": 21.14, "text": "我们有一辈子的时间"}, {"start": 21.14, "end": 22.14, "text": "不及这一时"}, {"start": 23.14, "end": 24.14, "text": "谢谢你秦大哥"}, {"start": 24.14, "end": 38.77, "text": "好家伙"}, {"start": 38.77, "end": 40.77, "text": "这么大的野牛"}, {"start": 40.77, "end": 43.14, "text": "秦兄弟"}, {"start": 43.14, "end": 45.14, "text": "你这路子太野了"}, {"start": 45.14, "end": 46.14, "text": "别人弄不到的"}, {"start": 46.14, "end": 47.14, "text": "你全包了"}, {"start": 47.14, "end": 50.86, "text": "高大哥"}, {"start": 50.86, "end": 52.9, "text": "借着大伙都在"}, {"start": 52.9, "end": 53.9, "text": "说个喜事"}, {"start": 53.9, "end": 56.22, "text": "下个月十八我结婚"}, {"start": 56.22, "end": 58.22, "text": "到时候请各位大哥"}, {"start": 58.22, "end": 59.22, "text": "一定赏光"}, {"start": 59.22, "end": 60.22, "text": "必须去"}]}