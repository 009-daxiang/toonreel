{"file": "穿越六零之我在山洞闷声发家-第51集.mp4", "ep": 51, "duration": 59.0, "segments": [{"start": 4.37, "end": 11.7, "text": "秦大哥"}, {"start": 11.94, "end": 13.1, "text": "你怎么这么早"}, {"start": 14.42, "end": 15.74, "text": "给沈子送点水"}, {"start": 15.94, "end": 16.86, "text": "还有粮食"}, {"start": 26.76, "end": 28.48, "text": "沈子 您坐着"}, {"start": 28.98, "end": 30.54, "text": "水继续喝 别断"}, {"start": 30.74, "end": 32.46, "text": "身子刚好 得鞏固"}, {"start": 32.86, "end": 34.18, "text": "多亏您的沈水"}, {"start": 34.34, "end": 35.42, "text": "我咳得少了"}, {"start": 35.42, "end": 36.62, "text": "饭也吃得下了"}, {"start": 36.9, "end": 43.32, "text": "玉米面 土豆红薯"}, {"start": 43.32, "end": 44.28, "text": "还有鱼和肉"}, {"start": 44.28, "end": 44.96, "text": "您收着"}, {"start": 45.12, "end": 46.48, "text": "身体要紧 别省"}, {"start": 46.76, "end": 48.02, "text": "这怎么使得"}, {"start": 48.18, "end": 49.82, "text": "上次已经拿了那么多"}, {"start": 49.82, "end": 50.62, "text": "沈子"}, {"start": 50.94, "end": 52.06, "text": "您养好身体"}, {"start": 52.38, "end": 54.34, "text": "沈希和小山才能轻松些"}, {"start": 54.34, "end": 56.46, "text": "日子才能越过越好"}]}