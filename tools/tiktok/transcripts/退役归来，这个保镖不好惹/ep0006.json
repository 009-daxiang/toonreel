{"file": "退役归来，这个保镖不好惹-第6集.mp4", "ep": 6, "duration": 133.7, "segments": [{"start": 17.07, "end": 17.71, "text": "妈"}, {"start": 18.38, "end": 19.18, "text": "儿子不孝"}, {"start": 19.87, "end": 20.63, "text": "对不起你"}, {"start": 20.83, "end": 21.55, "text": "对不起爸"}, {"start": 21.71, "end": 22.71, "text": "更对不起婷婷"}, {"start": 23.03, "end": 24.03, "text": "你安心地走吧"}, {"start": 24.35, "end": 25.55, "text": "我会把婷婷照顾好"}, {"start": 25.91, "end": 26.99, "text": "我会让她上大学"}, {"start": 27.11, "end": 28.19, "text": "会让她找份好工作"}, {"start": 28.19, "end": 29.39, "text": "看着她嫁人成家"}, {"start": 30.15, "end": 32.42, "text": "你和爸的仇我一定会报"}, {"start": 32.86, "end": 34.75, "text": "欺负过你们的人"}, {"start": 34.75, "end": 35.83, "text": "一个都别想跑"}, {"start": 44.61, "end": 45.57, "text": "去给她处理一下"}, {"start": 46.05, "end": 68.44, "text": "你们要干吗"}, {"start": 68.64, "end": 69.6, "text": "你说我们要干吗"}, {"start": 69.96, "end": 70.92, "text": "是自己跟我们走"}, {"start": 70.92, "end": 72.16, "text": "还是我让人把你靠走"}, {"start": 73.75, "end": 75.23, "text": "等我处理完我妈的后事"}, {"start": 75.55, "end": 76.35, "text": "我会去找你"}, {"start": 77.26, "end": 78.3, "text": "现在请你们让开"}, {"start": 78.92, "end": 80.0, "text": "我要带她去殡仪馆"}, {"start": 81.04, "end": 81.6, "text": "李队"}, {"start": 81.6, "end": 82.68, "text": "人和车都在现场"}, {"start": 82.68, "end": 83.8, "text": "身份还没和人清楚"}, {"start": 83.8, "end": 84.52, "text": "不能让她走"}, {"start": 87.49, "end": 88.05, "text": "让她走"}, {"start": 88.45, "end": 88.93, "text": "什么"}, {"start": 88.93, "end": 90.17, "text": "李队 你要让她走"}, {"start": 90.17, "end": 91.17, "text": "对 让她走"}, {"start": 91.49, "end": 92.37, "text": "让她先去殡仪馆"}, {"start": 92.37, "end": 93.29, "text": "安葬了她母亲"}, {"start": 93.77, "end": 95.13, "text": "我相信她处理完了之后"}, {"start": 95.29, "end": 96.21, "text": "会自己来找我的"}, {"start": 96.49, "end": 97.25, "text": "她要是跑了"}, {"start": 97.25, "end": 98.25, "text": "这个责任谁来承担"}, {"start": 98.37, "end": 98.81, "text": "我"}, {"start": 99.17, "end": 100.09, "text": "是我放她走的"}, {"start": 100.21, "end": 101.69, "text": "一切责任都由我个人承担"}, {"start": 101.69, "end": 102.49, "text": "与你们无关"}, {"start": 102.49, "end": 103.09, "text": "收队"}, {"start": 104.44, "end": 106.0, "text": "我给你一天时间处理后事"}, {"start": 106.0, "end": 107.44, "text": "明天到治安大队来"}, {"start": 107.88, "end": 109.48, "text": "我们帮你联系殡仪馆的车吧"}, {"start": 109.48, "end": 110.68, "text": "不用 我帮她去"}, {"start": 110.68, "end": 111.64, "text": "我要亲自送她"}, {"start": 124.71, "end": 125.43, "text": "告诉我"}, {"start": 125.43, "end": 127.63, "text": "当你打妈的人是谁"}]}