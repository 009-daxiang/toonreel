{"file": "退役归来，这个保镖不好惹-第16集.mp4", "ep": 16, "duration": 105.0, "segments": [{"start": 0.0, "end": 1.4, "text": "这件事没得商量"}, {"start": 2.4, "end": 3.2, "text": "小陈"}, {"start": 5.58, "end": 6.58, "text": "从现在开始"}, {"start": 6.58, "end": 8.38, "text": "小陈就是你的生活助理"}, {"start": 8.58, "end": 9.38, "text": "不管去哪儿"}, {"start": 9.38, "end": 10.38, "text": "你都得带着她"}, {"start": 10.78, "end": 11.38, "text": "爸"}, {"start": 11.38, "end": 12.38, "text": "安全方面"}, {"start": 12.38, "end": 13.58, "text": "必须听她的"}, {"start": 13.78, "end": 15.58, "text": "如果小陈告诉我"}, {"start": 15.58, "end": 17.18, "text": "你不配合她的工作"}, {"start": 17.58, "end": 19.78, "text": "那你准备了两年的发展计划"}, {"start": 20.25, "end": 21.45, "text": "就别想让我签字"}, {"start": 21.45, "end": 23.05, "text": "还有从今天开始"}, {"start": 23.05, "end": 24.65, "text": "你的车归小陈开"}, {"start": 24.85, "end": 26.45, "text": "你不许再自己开车"}, {"start": 26.45, "end": 27.65, "text": "把车钥匙交给她"}, {"start": 30.23, "end": 31.83, "text": "连车都不让我开了"}, {"start": 32.03, "end": 33.23, "text": "这事就这么定了"}, {"start": 34.21, "end": 34.81, "text": "小陈"}, {"start": 35.94, "end": 37.14, "text": "雨函就交给你了"}, {"start": 37.14, "end": 38.14, "text": "她要是不听话"}, {"start": 38.14, "end": 39.34, "text": "你直接给我打电话"}, {"start": 39.34, "end": 40.34, "text": "我来收拾她"}, {"start": 40.54, "end": 54.06, "text": "你是在叫我吗"}, {"start": 54.06, "end": 55.26, "text": "我不叫你叫谁"}, {"start": 55.26, "end": 56.66, "text": "这里除了你还有别人吗"}, {"start": 57.38, "end": 58.38, "text": "我叫陈云东"}, {"start": 58.78, "end": 60.5, "text": "你叫什么跟我没关系"}, {"start": 61.67, "end": 62.67, "text": "我就想知道"}, {"start": 62.87, "end": 64.27, "text": "我爸从哪儿把你找来的"}, {"start": 64.67, "end": 65.27, "text": "我家"}, {"start": 66.22, "end": 67.62, "text": "你是故意跟我绕圈子吗"}, {"start": 67.82, "end": 69.42, "text": "我问你之前干什么工作的"}, {"start": 69.62, "end": 70.42, "text": "吴易"}, {"start": 70.86, "end": 71.66, "text": "吴易"}, {"start": 71.86, "end": 73.33, "text": "那我问你"}, {"start": 73.73, "end": 75.33, "text": "我爸一个月到底给你多少钱"}, {"start": 75.76, "end": 76.96, "text": "不管我爸给你多少"}, {"start": 77.36, "end": 78.36, "text": "我出双倍"}, {"start": 79.5, "end": 81.1, "text": "拿了钱立刻从我面前消失"}, {"start": 81.3, "end": 82.1, "text": "明白吗"}, {"start": 84.51, "end": 85.11, "text": "干吗"}, {"start": 85.31, "end": 86.5, "text": "把车钥匙给我"}, {"start": 86.7, "end": 88.41, "text": "车钥匙"}, {"start": 88.81, "end": 90.53, "text": "我凭什么给你车钥匙"}, {"start": 91.41, "end": 92.41, "text": "从现在开始"}, {"start": 92.61, "end": 94.21, "text": "我会二十四小时保护你的安全"}, {"start": 94.61, "end": 95.87, "text": "你的车由我来开"}, {"start": 97.37, "end": 98.57, "text": "要去哪里你告诉我"}, {"start": 98.77, "end": 99.69, "text": "怎么"}, {"start": 100.61, "end": 101.81, "text": "你是在命令我吗"}]}