{"file": "一身腱子肉，乱世做谋臣-第10集.mp4", "ep": 10, "duration": 64.6, "segments": [{"start": 0.0, "end": 1.48, "text": "神特门的军师啊"}, {"start": 1.64, "end": 3.0, "text": "你管带头早阵斩杀敌军"}, {"start": 3.0, "end": 3.96, "text": "猛将叫计谋"}, {"start": 4.08, "end": 5.52, "text": "有你这杀穿几万人的本事"}, {"start": 5.52, "end": 6.76, "text": "什么计谋成不了啊"}, {"start": 7.76, "end": 9.48, "text": "李先生 好计谋"}, {"start": 9.48, "end": 11.32, "text": "李先生我们服了你好计谋"}, {"start": 11.32, "end": 12.4, "text": "谋家就算谋家"}, {"start": 12.4, "end": 13.4, "text": "起高一潮吧"}, {"start": 15.24, "end": 15.96, "text": "李先生"}, {"start": 16.16, "end": 17.24, "text": "以天生神力"}, {"start": 17.24, "end": 18.12, "text": "若当武将"}, {"start": 18.12, "end": 19.84, "text": "必能排进浩天大陆前时"}, {"start": 19.84, "end": 20.04, "text": "要不"}, {"start": 20.04, "end": 21.2, "text": "眼下莫要再开玩笑"}, {"start": 21.2, "end": 23.0, "text": "谋家是谋士 谋士"}, {"start": 27.73, "end": 28.61, "text": "李将军好"}, {"start": 28.61, "end": 29.81, "text": "谋家是谋士"}, {"start": 29.81, "end": 31.29, "text": "谋士应该叫先生"}, {"start": 31.29, "end": 31.81, "text": "懂不"}, {"start": 31.81, "end": 33.21, "text": "是 李先生"}, {"start": 33.85, "end": 35.37, "text": "明明武力值超群"}, {"start": 35.37, "end": 36.77, "text": "怎么飞得当谋士啊"}, {"start": 36.77, "end": 38.05, "text": "真是搞不清楚"}, {"start": 39.26, "end": 40.38, "text": "老王 看啥呢"}, {"start": 40.38, "end": 41.54, "text": "长公主设验款待谁呢"}, {"start": 41.54, "end": 43.02, "text": "当然是款待李先生啊"}, {"start": 43.02, "end": 44.02, "text": "棋军撤兵"}, {"start": 44.02, "end": 45.42, "text": "全是李先生的妙计"}, {"start": 45.42, "end": 46.14, "text": "给他跟我说说"}, {"start": 46.14, "end": 46.94, "text": "葫芦口粮仓"}, {"start": 46.94, "end": 47.9, "text": "被烧到你怎么回事"}, {"start": 47.9, "end": 48.7, "text": "据探子报"}, {"start": 48.7, "end": 49.34, "text": "余军得了一位"}, {"start": 49.34, "end": 50.62, "text": "名叫李浩的大财谋士"}, {"start": 50.62, "end": 52.02, "text": "传令城东避害出动"}, {"start": 52.02, "end": 52.78, "text": "务必暗杀掉"}, {"start": 52.78, "end": 54.02, "text": "这个叫李浩的谋士"}, {"start": 55.61, "end": 56.57, "text": "群里边放火"}, {"start": 56.57, "end": 57.89, "text": "给他们来个吊唬离山"}, {"start": 58.05, "end": 59.05, "text": "走毁了"}, {"start": 59.05, "end": 61.2, "text": "快吊唬"}, {"start": 61.2, "end": 62.52, "text": "最右边那个房间"}, {"start": 62.56, "end": 64.12, "text": "就是新来的谋士李浩"}, {"start": 64.12, "end": 64.64, "text": "上"}]}