{"file": "一身腱子肉，乱世做谋臣-第51集.mp4", "ep": 51, "duration": 64.6, "segments": [{"start": 0.96, "end": 4.14, "text": "报 陛下"}, {"start": 4.14, "end": 5.22, "text": "大师不好了"}, {"start": 5.22, "end": 6.02, "text": "韩当"}, {"start": 6.02, "end": 7.5, "text": "你这老东西有好什么伤"}, {"start": 7.5, "end": 8.34, "text": "回陛下"}, {"start": 8.34, "end": 9.9, "text": "张远山不遵王旨"}, {"start": 9.9, "end": 10.9, "text": "他刺世兵权"}, {"start": 10.9, "end": 12.26, "text": "称将在外军有所不受"}, {"start": 12.26, "end": 13.86, "text": "非要破了定远县才肯回师"}, {"start": 13.86, "end": 15.18, "text": "那逆贼是先王的义子"}, {"start": 15.18, "end": 16.06, "text": "如今守卧重兵"}, {"start": 16.06, "end": 17.06, "text": "他到底想干什么"}, {"start": 17.06, "end": 18.58, "text": "还有那只深入境内的余军"}, {"start": 18.58, "end": 19.46, "text": "神速如雷"}, {"start": 19.46, "end": 19.94, "text": "已经"}, {"start": 19.94, "end": 21.5, "text": "已经攻破了永宁城"}, {"start": 21.5, "end": 23.54, "text": "守将郭涛当场殉国"}, {"start": 23.54, "end": 24.78, "text": "该死 快"}, {"start": 24.78, "end": 26.3, "text": "在八百里加急传密令"}, {"start": 26.3, "end": 26.98, "text": "给寡人命他"}, {"start": 26.98, "end": 28.42, "text": "立刻滚回王都救驾"}, {"start": 28.42, "end": 29.3, "text": "快去"}, {"start": 31.86, "end": 32.62, "text": "殿下"}, {"start": 32.94, "end": 34.66, "text": "骑军攻势如怒涛拍案"}, {"start": 34.66, "end": 35.34, "text": "今日弟兄们"}, {"start": 35.34, "end": 37.1, "text": "几乎拼尽了最后一滴血"}, {"start": 37.1, "end": 38.1, "text": "以老臣之见"}, {"start": 38.1, "end": 39.02, "text": "不如趁夜突围"}, {"start": 39.02, "end": 40.06, "text": "怕是绝对守不住了"}, {"start": 40.06, "end": 41.18, "text": "先退守内地吧"}, {"start": 41.18, "end": 42.0, "text": "不行"}, {"start": 42.0, "end": 42.76, "text": "定远县乃是我"}, {"start": 42.76, "end": 44.24, "text": "大于南面的最后门患"}, {"start": 44.24, "end": 44.96, "text": "此城一师"}, {"start": 44.96, "end": 45.88, "text": "千万大于子民将"}, {"start": 45.88, "end": 47.36, "text": "任由骑军铁铁似意践踏"}, {"start": 47.36, "end": 48.8, "text": "本宫也绝不退半步"}, {"start": 48.8, "end": 49.76, "text": "再者"}, {"start": 49.76, "end": 51.28, "text": "本宫深信李先生"}, {"start": 51.28, "end": 53.04, "text": "他从未让本宫失望过"}, {"start": 53.04, "end": 53.84, "text": "这一次"}, {"start": 53.84, "end": 55.15, "text": "也绝不会"}, {"start": 55.15, "end": 55.71, "text": "报"}, {"start": 55.71, "end": 59.23, "text": "王都八百里加急非隔传说"}, {"start": 59.23, "end": 60.71, "text": "怎会如此"}, {"start": 60.71, "end": 62.31, "text": "永宁城竟然被破了"}, {"start": 62.31, "end": 63.35, "text": "过头被斩首"}]}