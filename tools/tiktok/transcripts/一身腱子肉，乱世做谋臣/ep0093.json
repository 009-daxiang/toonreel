{"file": "一身腱子肉，乱世做谋臣-第93集.mp4", "ep": 93, "duration": 69.6, "segments": [{"start": 0.0, "end": 1.0, "text": "启禀大王"}, {"start": 1.0, "end": 2.12, "text": "边关暂时吃紧"}, {"start": 2.12, "end": 3.44, "text": "陈老家十万麻山之中"}, {"start": 3.44, "end": 4.16, "text": "隐匿着一员"}, {"start": 4.16, "end": 5.44, "text": "惊天动地的爵士猛将"}, {"start": 5.44, "end": 6.48, "text": "陈特来向大王请旨"}, {"start": 6.48, "end": 7.16, "text": "准陈还乡"}, {"start": 7.16, "end": 8.32, "text": "将次猛将招揽出山"}, {"start": 8.32, "end": 9.88, "text": "替朝廷挂帅御敌"}, {"start": 10.52, "end": 11.32, "text": "公准了"}, {"start": 11.32, "end": 12.56, "text": "李大人速去速回"}, {"start": 13.47, "end": 14.19, "text": "大王"}, {"start": 14.19, "end": 14.83, "text": "此前陈"}, {"start": 14.83, "end": 15.79, "text": "悬赏招募赵广"}, {"start": 15.79, "end": 16.87, "text": "和马威两位将军"}, {"start": 16.87, "end": 17.55, "text": "按军规"}, {"start": 17.55, "end": 18.63, "text": "赢赏两千金"}, {"start": 18.63, "end": 19.31, "text": "这两千金"}, {"start": 19.31, "end": 21.11, "text": "全是微臣自掏腰包垫附的"}, {"start": 21.11, "end": 22.23, "text": "眼下国库虽空"}, {"start": 22.23, "end": 22.83, "text": "但这仗"}, {"start": 22.83, "end": 23.63, "text": "李艾清"}, {"start": 23.75, "end": 25.51, "text": "你当真是半点亏都不肯吃"}, {"start": 25.51, "end": 26.23, "text": "拿纸笔来"}, {"start": 26.23, "end": 28.99, "text": "给我给你打"}, {"start": 28.99, "end": 30.07, "text": "大王当真爽快"}, {"start": 30.07, "end": 30.51, "text": "不过"}, {"start": 30.51, "end": 31.67, "text": "陈此次回去招安的那位"}, {"start": 31.67, "end": 32.67, "text": "爵士猛将费"}, {"start": 32.67, "end": 33.35, "text": "要不大王"}, {"start": 33.35, "end": 34.59, "text": "也一并给陈开了吧"}, {"start": 34.59, "end": 35.9, "text": "李浩"}, {"start": 35.9, "end": 36.38, "text": "罢了"}, {"start": 36.38, "end": 37.54, "text": "我"}, {"start": 37.54, "end": 38.58, "text": "大王真乃我大鱼"}, {"start": 38.58, "end": 39.7, "text": "第一爽快之人"}, {"start": 41.98, "end": 42.86, "text": "想当年老子也是"}, {"start": 42.86, "end": 44.02, "text": "横行妖界的霸主"}, {"start": 44.02, "end": 45.22, "text": "结果撞见那个大魔头"}, {"start": 45.22, "end": 45.98, "text": "被活生生追着"}, {"start": 45.98, "end": 47.02, "text": "暴奏了三个月"}, {"start": 47.94, "end": 49.38, "text": "打得老子借肉吃素"}, {"start": 49.38, "end": 49.98, "text": "如今沦落到"}, {"start": 49.98, "end": 51.06, "text": "厨地重包米吃"}, {"start": 51.66, "end": 54.5, "text": "真是丢尽妖界的颜面啊"}, {"start": 54.5, "end": 55.02, "text": "凤凰乃是"}, {"start": 55.02, "end": 56.82, "text": "横压十万大山的鲜天火灵霸主"}, {"start": 56.82, "end": 58.14, "text": "怎么下得跟个野鸡似的"}, {"start": 58.14, "end": 58.78, "text": "难道说"}, {"start": 58.78, "end": 59.7, "text": "哎呀呀"}, {"start": 59.7, "end": 62.58, "text": "某家可还当真是手无腹鸡之力啊"}, {"start": 62.58, "end": 64.5, "text": "连只肥野鸡都抓不住啊"}, {"start": 64.5, "end": 65.42, "text": "惭愧"}, {"start": 65.42, "end": 66.9, "text": "惭愧至极啊"}, {"start": 66.9, "end": 67.58, "text": "哟"}, {"start": 67.58, "end": 68.46, "text": "熊大"}, {"start": 68.46, "end": 69.58, "text": "忙着重包米呢"}]}