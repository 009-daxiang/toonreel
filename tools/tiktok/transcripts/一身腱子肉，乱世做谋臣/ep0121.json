{"file": "一身腱子肉，乱世做谋臣-第121集.mp4", "ep": 121, "duration": 62.0, "segments": [{"start": 2.7, "end": 3.9, "text": "二十万骑军"}, {"start": 3.9, "end": 6.5, "text": "才给某家权术留下"}, {"start": 6.5, "end": 7.82, "text": "替破军"}, {"start": 7.82, "end": 13.58, "text": "杀光骑狗"}, {"start": 13.58, "end": 15.06, "text": "后军攻怒手结阵"}, {"start": 15.06, "end": 15.86, "text": "给本将"}, {"start": 15.86, "end": 17.62, "text": "稳住战刑啊"}, {"start": 23.55, "end": 24.43, "text": "李先生"}, {"start": 24.43, "end": 25.07, "text": "是他"}, {"start": 25.07, "end": 25.79, "text": "是李先生"}, {"start": 25.79, "end": 27.18, "text": "杀穿后路回来了"}, {"start": 27.18, "end": 27.82, "text": "弟兄们"}, {"start": 27.82, "end": 29.46, "text": "大鱼的战神李少林回来了"}, {"start": 29.46, "end": 30.9, "text": "胜利就在眼前"}, {"start": 30.9, "end": 31.98, "text": "随估反击"}, {"start": 31.98, "end": 34.34, "text": "阿绝提扣"}, {"start": 34.34, "end": 35.02, "text": "乱了"}, {"start": 35.02, "end": 35.99, "text": "分乱了"}, {"start": 35.99, "end": 37.19, "text": "秦贼先秦王"}, {"start": 37.19, "end": 38.43, "text": "必须不惜一切代价"}, {"start": 38.43, "end": 39.11, "text": "先宰了那头"}, {"start": 39.11, "end": 40.59, "text": "冲阵的怪物李浩"}, {"start": 40.59, "end": 41.23, "text": "赵鹏"}, {"start": 41.23, "end": 42.03, "text": "朱鹏"}, {"start": 42.03, "end": 43.63, "text": "你们二人乃我骑军猛将"}, {"start": 43.63, "end": 44.47, "text": "速速提刀去"}, {"start": 44.47, "end": 47.5, "text": "斩了李浩内死的人头"}, {"start": 47.5, "end": 49.1, "text": "莫 莫将领命"}, {"start": 49.1, "end": 49.82, "text": "吟道长"}, {"start": 49.82, "end": 50.62, "text": "赵鹏与朱猛"}, {"start": 50.62, "end": 52.26, "text": "不过是去送死的幼儿妻子"}, {"start": 52.26, "end": 53.98, "text": "带李浩斩杀二人分神之际"}, {"start": 53.98, "end": 54.82, "text": "全养一汪道长的"}, {"start": 54.82, "end": 56.18, "text": "非箭施展致命绝杀"}, {"start": 56.18, "end": 57.46, "text": "只要李浩已死"}, {"start": 57.46, "end": 58.62, "text": "于国必亡"}, {"start": 58.62, "end": 59.66, "text": "赵将军放心"}, {"start": 59.66, "end": 61.06, "text": "贫道的遇见非箭"}, {"start": 61.06, "end": 61.98, "text": "绝不会失手"}]}