{"file": "一身腱子肉，乱世做谋臣-第116集.mp4", "ep": 116, "duration": 91.3, "segments": [{"start": 0.0, "end": 0.96, "text": "大于鼠辈"}, {"start": 1.2, "end": 3.56, "text": "谁敢出城与本将军决议死战"}, {"start": 3.92, "end": 4.44, "text": "大王"}, {"start": 4.72, "end": 6.32, "text": "末将愿去娶此贼狗头"}, {"start": 7.2, "end": 8.2, "text": "赵将军小心"}, {"start": 10.87, "end": 11.71, "text": "报上明来"}, {"start": 11.79, "end": 13.07, "text": "某枪下无名之鬼"}, {"start": 13.15, "end": 13.63, "text": "杀"}, {"start": 18.1, "end": 19.66, "text": "无奈赵广是野"}, {"start": 19.82, "end": 20.38, "text": "困仗"}, {"start": 20.66, "end": 21.18, "text": "萌萌"}, {"start": 21.34, "end": 22.18, "text": "给我斩了他"}, {"start": 22.3, "end": 22.82, "text": "是啊"}, {"start": 22.9, "end": 24.14, "text": "贼将受死"}, {"start": 30.0, "end": 30.96, "text": "两个一起上"}, {"start": 31.12, "end": 32.0, "text": "围剿他"}, {"start": 34.16, "end": 34.92, "text": "来得好"}, {"start": 35.16, "end": 39.86, "text": "杨瀚成"}, {"start": 40.02, "end": 41.3, "text": "你亲自出"}, {"start": 41.3, "end": 42.62, "text": "赵广小儿凶狂"}, {"start": 42.74, "end": 43.98, "text": "吃某架一刀"}, {"start": 44.46, "end": 73.45, "text": "偷击不成十八米"}, {"start": 73.57, "end": 74.97, "text": "连长我四元大将"}, {"start": 75.09, "end": 76.25, "text": "取取一个赵广"}, {"start": 76.37, "end": 77.69, "text": "怎么可能凶悍之子"}, {"start": 77.69, "end": 78.21, "text": "将军"}, {"start": 78.37, "end": 79.25, "text": "传闻着赵广"}, {"start": 79.37, "end": 81.29, "text": "在大于仅仅未列五虎尚将"}, {"start": 81.45, "end": 82.85, "text": "赵广已然如此无敌"}, {"start": 83.13, "end": 84.85, "text": "那大于传闻中身负万军神力"}, {"start": 84.85, "end": 86.29, "text": "据五虎尚将之手的李浩"}, {"start": 86.41, "end": 88.05, "text": "该是何等毁天灭地的魔物"}, {"start": 88.13, "end": 88.73, "text": "传令"}, {"start": 88.85, "end": 90.37, "text": "明日全军二十万主力押尚"}, {"start": 90.49, "end": 91.25, "text": "估计代价"}]}