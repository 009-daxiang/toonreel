{"file": "一身腱子肉，乱世做谋臣-第65集.mp4", "ep": 65, "duration": 75.3, "segments": [{"start": 0.0, "end": 1.2, "text": "鱼贼纳命来"}, {"start": 1.6, "end": 2.48, "text": "给我停下"}, {"start": 3.46, "end": 3.98, "text": "坏了"}, {"start": 3.98, "end": 4.78, "text": "空马腐骑"}, {"start": 4.78, "end": 5.42, "text": "中计了"}, {"start": 5.42, "end": 6.26, "text": "吊虎离山"}, {"start": 8.09, "end": 9.17, "text": "此刻赶回永济城"}, {"start": 9.17, "end": 10.85, "text": "怕是那城头早已插上鱼骑了"}, {"start": 10.85, "end": 12.61, "text": "那能扛着两座小山狂奔的人形怪物"}, {"start": 12.61, "end": 13.37, "text": "深不可测"}, {"start": 13.37, "end": 14.81, "text": "凭到年事已高气血衰退"}, {"start": 14.81, "end": 16.69, "text": "回去死拼夺回一座空城毫无异处"}, {"start": 16.69, "end": 17.33, "text": "当务之急"}, {"start": 17.33, "end": 18.45, "text": "唯有火速驱寻大王"}, {"start": 18.45, "end": 19.73, "text": "护住圣驾方为上击"}, {"start": 20.73, "end": 31.24, "text": "动击防脚盘"}, {"start": 31.24, "end": 32.0, "text": "敲镜中"}, {"start": 32.64, "end": 34.12, "text": "守住脚盘"}, {"start": 35.18, "end": 35.82, "text": "李兄"}, {"start": 35.82, "end": 36.94, "text": "吊桥卡在半空"}, {"start": 36.94, "end": 37.86, "text": "敌军何为了"}, {"start": 38.02, "end": 39.18, "text": "若圣女她们被斩杀"}, {"start": 39.18, "end": 40.58, "text": "我军再无破成机会呀"}, {"start": 41.1, "end": 44.5, "text": "某家卡"}, {"start": 44.5, "end": 45.66, "text": "给某家"}, {"start": 45.66, "end": 47.1, "text": "滚下去"}, {"start": 47.1, "end": 49.53, "text": "兄弟们"}, {"start": 49.53, "end": 50.57, "text": "吊桥一通"}, {"start": 50.57, "end": 51.81, "text": "随某家杀进去"}, {"start": 56.74, "end": 58.46, "text": "全给某家滚开"}, {"start": 58.46, "end": 59.82, "text": "立破千军"}, {"start": 59.82, "end": 61.65, "text": "军师救我"}, {"start": 61.65, "end": 62.65, "text": "军师"}, {"start": 62.65, "end": 64.01, "text": "你们家管这种身重树刀"}, {"start": 64.01, "end": 65.93, "text": "都不倒的重甲死兵叫军师"}, {"start": 65.93, "end": 73.78, "text": "战场上喊文官救命"}, {"start": 73.78, "end": 74.5, "text": "韩老头"}, {"start": 74.5, "end": 75.26, "text": "别来无恙了"}]}