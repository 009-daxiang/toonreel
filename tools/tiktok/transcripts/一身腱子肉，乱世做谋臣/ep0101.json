{"file": "一身腱子肉，乱世做谋臣-第101集.mp4", "ep": 101, "duration": 65.0, "segments": [{"start": 0.14, "end": 0.7, "text": "李浩"}, {"start": 1.1, "end": 2.3, "text": "你怎么把大军撤回来了"}, {"start": 2.46, "end": 3.42, "text": "齐军主力人呢"}, {"start": 3.78, "end": 4.26, "text": "谭兄"}, {"start": 4.46, "end": 5.3, "text": "你可算回来了"}, {"start": 5.54, "end": 6.62, "text": "你那破鬼谋默默积极"}, {"start": 6.62, "end": 7.38, "text": "一点不顶用"}, {"start": 7.66, "end": 8.42, "text": "某家到了前线"}, {"start": 8.42, "end": 9.26, "text": "随手射了一箭"}, {"start": 9.54, "end": 10.02, "text": "一不小心"}, {"start": 10.02, "end": 11.14, "text": "就把敌将轰成灰了"}, {"start": 11.42, "end": 12.82, "text": "那帮齐军下得全逃光了"}, {"start": 13.7, "end": 14.1, "text": "对了"}, {"start": 14.22, "end": 15.42, "text": "某家那一箭没收住力气"}, {"start": 15.54, "end": 16.38, "text": "顺带着把你射伏的"}, {"start": 16.38, "end": 17.34, "text": "凤凰谷半遍山峰"}, {"start": 17.34, "end": 18.3, "text": "全给轰塔掩埋了"}, {"start": 18.38, "end": 19.42, "text": "你那火功妙计"}, {"start": 19.62, "end": 20.34, "text": "估摸着是彻底"}, {"start": 20.34, "end": 21.18, "text": "派不上用场了"}, {"start": 22.74, "end": 23.58, "text": "老夫闭门推演"}, {"start": 23.58, "end": 24.26, "text": "整整三天的"}, {"start": 24.26, "end": 25.66, "text": "三天的至高绝世鬼谋"}, {"start": 25.86, "end": 26.9, "text": "被你随手一箭"}, {"start": 27.06, "end": 28.93, "text": "给他们当场红报废了"}, {"start": 29.84, "end": 30.36, "text": "韩大人"}, {"start": 30.68, "end": 31.64, "text": "满在前方埋伏处"}, {"start": 31.64, "end": 32.72, "text": "眼珠子都快瞪瞎了"}, {"start": 32.88, "end": 33.64, "text": "等了大半天"}, {"start": 33.8, "end": 34.76, "text": "连个齐军的鬼影子"}, {"start": 34.76, "end": 35.32, "text": "都没见着"}, {"start": 35.52, "end": 36.68, "text": "这齐兵怎么还不来啊"}, {"start": 36.88, "end": 38.16, "text": "您还是亲自问李大人吧"}, {"start": 38.32, "end": 39.48, "text": "末将至今神魂不定"}, {"start": 39.76, "end": 40.84, "text": "某家今日总算误了"}, {"start": 41.04, "end": 41.96, "text": "你那套阴谋鬼计"}, {"start": 41.96, "end": 42.96, "text": "难登大雅之谈"}, {"start": 43.28, "end": 43.92, "text": "收拾收拾"}, {"start": 44.08, "end": 45.4, "text": "传令全军班师回城吧"}, {"start": 45.72, "end": 46.72, "text": "李先生韩大人"}, {"start": 47.16, "end": 48.52, "text": "你们怎能回视这般神速"}, {"start": 48.92, "end": 50.36, "text": "那齐国数万先锋大军呢"}, {"start": 50.8, "end": 51.64, "text": "齐兵大王"}, {"start": 51.8, "end": 53.16, "text": "齐军已被某家打退了"}, {"start": 53.44, "end": 54.72, "text": "某家林镇神机妙算"}, {"start": 54.72, "end": 55.92, "text": "使了一招无上兵法"}, {"start": 55.92, "end": 57.16, "text": "凝坏移驻景天计"}, {"start": 57.28, "end": 58.36, "text": "当场杀的齐国先锋"}, {"start": 58.36, "end": 58.96, "text": "屁滚尿流"}, {"start": 58.96, "end": 59.96, "text": "又亏其假而逃"}, {"start": 60.92, "end": 62.2, "text": "移 移驻景天计"}, {"start": 62.44, "end": 63.2, "text": "孤伯滥求疏"}, {"start": 63.2, "end": 63.8, "text": "大于兵法中"}, {"start": 63.8, "end": 64.8, "text": "何曾有过这么齐谋"}]}