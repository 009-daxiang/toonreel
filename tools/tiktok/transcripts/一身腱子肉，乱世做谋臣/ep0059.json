{"file": "一身腱子肉，乱世做谋臣-第59集.mp4", "ep": 59, "duration": 68.3, "segments": [{"start": 0.0, "end": 2.0, "text": "诸位爱卿 敌军半日即至"}, {"start": 2.0, "end": 5.0, "text": "要不 孤先带后宫与文库戏暖汽城巡戏"}, {"start": 5.0, "end": 7.0, "text": "而等在此卫孤尽忠守城 如何"}, {"start": 7.0, "end": 9.0, "text": "大王乃一国根本 礼当避其封王"}, {"start": 9.0, "end": 10.0, "text": "放屁"}, {"start": 10.0, "end": 13.0, "text": "大王若汽城军心避散 王都不攻自破"}, {"start": 13.0, "end": 14.0, "text": "等同王国"}, {"start": 14.0, "end": 17.0, "text": "够了 都给孤闭嘴 一群废物"}, {"start": 17.0, "end": 20.61, "text": "如今贼寇杀到眼皮子底下 你一下如何"}, {"start": 20.61, "end": 23.9, "text": "大王 万万不可汽城离京"}, {"start": 23.9, "end": 25.9, "text": "大王在京城民心就在"}, {"start": 25.9, "end": 27.9, "text": "且我王都内上有三万惊甲瑞士"}, {"start": 27.9, "end": 29.9, "text": "更有国师大宗师作证王军"}, {"start": 29.9, "end": 30.9, "text": "善"}, {"start": 30.9, "end": 31.9, "text": "左相所言极是"}, {"start": 31.9, "end": 33.9, "text": "由左相全权统领王都防务"}, {"start": 33.9, "end": 35.9, "text": "务必将来犯敌军碎尸万刀"}, {"start": 35.9, "end": 38.9, "text": "老臣领旨 城头投尸机全数装填巨石"}, {"start": 38.9, "end": 40.9, "text": "滚木类石 金之废油皆备"}, {"start": 40.9, "end": 42.9, "text": "定教敌军有来无回"}, {"start": 42.9, "end": 43.9, "text": "老裴 听得住吗"}, {"start": 43.9, "end": 45.9, "text": "听得住 老子还能杀"}, {"start": 45.9, "end": 47.9, "text": "殿下 守不住了 撤吧"}, {"start": 47.9, "end": 50.9, "text": "想必李兄深入敌后 早已凶多极少了"}, {"start": 50.9, "end": 51.9, "text": "不能撤"}, {"start": 51.9, "end": 52.9, "text": "定远陷弱失守"}, {"start": 52.9, "end": 54.9, "text": "大鱼再无半寸退路"}, {"start": 54.9, "end": 55.9, "text": "孤与城池共存弯"}, {"start": 55.9, "end": 59.84, "text": "撤了"}, {"start": 59.84, "end": 61.84, "text": "莫非 当真是李兄在敌后得手"}, {"start": 61.84, "end": 62.84, "text": "比秦军回房了"}, {"start": 62.84, "end": 63.84, "text": "对呀"}, {"start": 63.84, "end": 66.45, "text": "为卫旧诏 李先生 当真"}]}