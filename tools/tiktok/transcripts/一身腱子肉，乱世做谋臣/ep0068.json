{"file": "一身腱子肉，乱世做谋臣-第68集.mp4", "ep": 68, "duration": 69.5, "segments": [{"start": 0.0, "end": 1.28, "text": "军师 不行了"}, {"start": 1.28, "end": 3.0, "text": "敌人的骑兵追上来了"}, {"start": 3.0, "end": 4.0, "text": "火舟礼号"}, {"start": 4.0, "end": 5.44, "text": "抢回大王金银财宝"}, {"start": 5.44, "end": 6.64, "text": "碎石万段"}, {"start": 7.52, "end": 9.44, "text": "骑王那老王把治愈这么抠门吗"}, {"start": 9.44, "end": 11.08, "text": "某家不过是顺手拿了点盘铲"}, {"start": 11.08, "end": 12.12, "text": "他 他们派十万铁骑"}, {"start": 12.12, "end": 13.36, "text": "追杀老子几千里"}, {"start": 13.72, "end": 14.52, "text": "四面八方"}, {"start": 14.52, "end": 16.32, "text": "全是赶来秦阳的骑国精锐"}, {"start": 16.32, "end": 17.4, "text": "我军抢得虽痛快"}, {"start": 17.4, "end": 18.52, "text": "却错失了良机"}, {"start": 18.52, "end": 19.56, "text": "如今直退大渔"}, {"start": 19.56, "end": 21.12, "text": "无意于自投罗网啊"}, {"start": 21.12, "end": 22.64, "text": "谁说要原路犯回"}, {"start": 22.64, "end": 25.06, "text": "某家看这里就挺好吗"}, {"start": 25.06, "end": 26.2, "text": "这里"}, {"start": 26.2, "end": 27.0, "text": "李兄"}, {"start": 27.0, "end": 28.96, "text": "此处乃宁国境内的险关要案"}, {"start": 31.04, "end": 31.84, "text": "是在人为吗"}, {"start": 31.84, "end": 32.4, "text": "某家亲自去"}, {"start": 32.4, "end": 33.68, "text": "同他们手将好好讲讲道理"}, {"start": 33.68, "end": 34.48, "text": "万一人家生命大义"}, {"start": 34.48, "end": 35.2, "text": "放我们过去呢"}, {"start": 35.2, "end": 36.24, "text": "速主出谋划册成功"}, {"start": 36.24, "end": 37.68, "text": "完成计册将获得神机奖励"}, {"start": 37.68, "end": 38.36, "text": "若计册失败"}, {"start": 38.36, "end": 39.6, "text": "惩罚速主便利公共"}, {"start": 39.6, "end": 40.4, "text": "郭先生"}, {"start": 40.4, "end": 41.56, "text": "这计册真能成吗"}, {"start": 41.56, "end": 42.44, "text": "他冲锋险阵"}, {"start": 42.44, "end": 43.6, "text": "可动脑子这事"}, {"start": 43.6, "end": 45.19, "text": "你提供什么呢"}, {"start": 45.19, "end": 46.23, "text": "某家出的计册"}, {"start": 46.23, "end": 46.99, "text": "哪一次没把敌人"}, {"start": 46.99, "end": 48.81, "text": "玩得团团转"}, {"start": 48.81, "end": 49.65, "text": "就这么定了"}, {"start": 49.65, "end": 50.89, "text": "全军就地修整一刻中"}, {"start": 50.89, "end": 51.69, "text": "拔营进发"}, {"start": 51.69, "end": 55.1, "text": "借到宁国"}, {"start": 55.1, "end": 56.22, "text": "此乃宁国边境"}, {"start": 56.22, "end": 57.82, "text": "而等率残兵前来所为何事"}, {"start": 57.82, "end": 58.74, "text": "速速报上名来"}, {"start": 58.74, "end": 59.58, "text": "对面的将军"}, {"start": 59.58, "end": 60.98, "text": "某家乃是大鱼军师"}, {"start": 60.98, "end": 62.62, "text": "只因抄了齐王都归国兽祖"}, {"start": 62.62, "end": 64.02, "text": "与借到归国返回大鱼"}, {"start": 64.02, "end": 65.34, "text": "还请将军行个方便"}, {"start": 65.34, "end": 65.98, "text": "借到"}, {"start": 65.98, "end": 66.58, "text": "作风"}, {"start": 66.58, "end": 67.62, "text": "修得前进一步"}, {"start": 67.62, "end": 68.42, "text": "若敢越界"}, {"start": 68.42, "end": 69.54, "text": "是同对我宁国开战"}]}