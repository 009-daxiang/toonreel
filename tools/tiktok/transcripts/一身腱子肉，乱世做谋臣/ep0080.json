{"file": "一身腱子肉，乱世做谋臣-第80集.mp4", "ep": 80, "duration": 67.8, "segments": [{"start": 0.0, "end": 2.0, "text": "殿下 是我大义了"}, {"start": 2.0, "end": 3.36, "text": "那张远乡鬼击多端"}, {"start": 3.36, "end": 4.32, "text": "彻底留有后手"}, {"start": 4.32, "end": 5.16, "text": "李兄若有闪失"}, {"start": 5.16, "end": 6.44, "text": "为臣白死莫俗啊"}, {"start": 6.44, "end": 7.88, "text": "本宫已有决断之时"}, {"start": 7.88, "end": 9.16, "text": "只怕李先生福大命大"}, {"start": 9.16, "end": 9.72, "text": "报"}, {"start": 9.72, "end": 10.4, "text": "启禀殿下"}, {"start": 10.4, "end": 10.88, "text": "李先生"}, {"start": 10.88, "end": 12.24, "text": "李先生大劫班事回朝了"}, {"start": 12.24, "end": 12.88, "text": "太好了"}, {"start": 12.88, "end": 13.36, "text": "诸位"}, {"start": 13.36, "end": 15.08, "text": "速速随宫出城迎接李先生"}, {"start": 15.08, "end": 15.8, "text": "诺"}, {"start": 18.98, "end": 19.62, "text": "狄形"}, {"start": 19.62, "end": 20.47, "text": "是吧"}, {"start": 20.47, "end": 21.99, "text": "将士大军攻城了"}, {"start": 21.99, "end": 23.11, "text": "全军戒备"}, {"start": 23.11, "end": 24.19, "text": "准备放箭"}, {"start": 24.84, "end": 25.52, "text": "等等"}, {"start": 25.52, "end": 26.24, "text": "别放箭"}, {"start": 26.24, "end": 26.84, "text": "殿下"}, {"start": 26.84, "end": 28.98, "text": "是某家呀"}, {"start": 28.98, "end": 29.86, "text": "李先生"}, {"start": 30.74, "end": 31.46, "text": "殿下"}, {"start": 31.46, "end": 33.26, "text": "某家刚大破定冥城凯旋"}, {"start": 33.3, "end": 34.98, "text": "咱那一进门就要挨箭子"}, {"start": 34.98, "end": 36.22, "text": "您这是闹哪一出啊"}, {"start": 37.78, "end": 38.74, "text": "李先生"}, {"start": 38.74, "end": 40.6, "text": "当真完事你"}, {"start": 40.6, "end": 42.08, "text": "你身旁的这个怪物是"}, {"start": 42.08, "end": 43.16, "text": "殿下有所不知"}, {"start": 43.16, "end": 44.44, "text": "那张月山卑鄙之急"}, {"start": 44.44, "end": 45.0, "text": "在城中留了"}, {"start": 45.0, "end": 46.52, "text": "湿山派的邪道伏击某家"}, {"start": 46.52, "end": 47.32, "text": "得亏某家聪明"}, {"start": 47.32, "end": 47.88, "text": "林镇学会了"}, {"start": 47.88, "end": 49.16, "text": "湿山派决学控尸术"}, {"start": 49.16, "end": 50.84, "text": "顺手收服了这尊金甲释亡"}, {"start": 50.84, "end": 52.16, "text": "这才平定了满城祸乱"}, {"start": 53.32, "end": 53.76, "text": "先生"}, {"start": 53.76, "end": 55.0, "text": "当真学会了控尸术"}, {"start": 55.0, "end": 55.68, "text": "张兄"}, {"start": 55.68, "end": 57.0, "text": "你看某家的套略如何"}, {"start": 57.0, "end": 58.64, "text": "某家早就说过不能做一代币"}, {"start": 58.64, "end": 59.6, "text": "唯有主动出击"}, {"start": 59.6, "end": 60.16, "text": "你看"}, {"start": 60.2, "end": 61.44, "text": "定偏强已进入拿中"}, {"start": 62.44, "end": 63.08, "text": "李兄"}, {"start": 63.08, "end": 64.08, "text": "真乃神人意"}, {"start": 64.08, "end": 64.64, "text": "殿下"}, {"start": 64.64, "end": 65.56, "text": "某家多日未归"}, {"start": 65.56, "end": 67.16, "text": "得先回去给娘子报喜去喽"}, {"start": 67.16, "end": 67.76, "text": "告辞"}]}