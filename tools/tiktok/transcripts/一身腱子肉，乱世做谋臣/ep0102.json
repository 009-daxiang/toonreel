{"file": "一身腱子肉，乱世做谋臣-第102集.mp4", "ep": 102, "duration": 65.9, "segments": [{"start": 0.0, "end": 0.68, "text": "杭爱卿"}, {"start": 0.88, "end": 2.0, "text": "这一驻景天际"}, {"start": 2.0, "end": 3.44, "text": "到底是何等深奥谋略"}, {"start": 3.56, "end": 4.2, "text": "回大王"}, {"start": 4.48, "end": 5.64, "text": "分明是他把纯体中剑"}, {"start": 5.64, "end": 6.72, "text": "当工程大炮射"}, {"start": 7.24, "end": 8.2, "text": "随手一炮把敌将"}, {"start": 8.2, "end": 9.52, "text": "和半宿大山轰成了下"}, {"start": 9.52, "end": 10.68, "text": "兵部尚书李昊"}, {"start": 10.68, "end": 11.84, "text": "阵前沈永退敌"}, {"start": 11.84, "end": 12.76, "text": "功勋卓众"}, {"start": 12.76, "end": 13.64, "text": "孤特将旨"}, {"start": 13.64, "end": 14.72, "text": "加封李尚书为"}, {"start": 14.72, "end": 15.76, "text": "大鱼冠军侯"}, {"start": 15.76, "end": 16.8, "text": "赐九夕金印"}, {"start": 16.8, "end": 17.68, "text": "恭喜李大人"}, {"start": 17.68, "end": 19.08, "text": "特席大人奉侯"}, {"start": 19.08, "end": 19.76, "text": "大王"}, {"start": 19.76, "end": 20.6, "text": "李爱卿"}, {"start": 20.8, "end": 22.92, "text": "冠军侯乃武将至高侯爵"}, {"start": 23.04, "end": 24.36, "text": "你为何抗旨不接"}, {"start": 24.36, "end": 24.96, "text": "大王"}, {"start": 25.32, "end": 26.68, "text": "臣是用计谋退敌的"}, {"start": 26.68, "end": 27.28, "text": "更何况"}, {"start": 27.28, "end": 28.92, "text": "臣乃是从一品文臣谋事"}, {"start": 28.92, "end": 29.52, "text": "您怎能给臣"}, {"start": 29.52, "end": 31.12, "text": "扣一个纯武夫的军功封号"}, {"start": 31.12, "end": 32.56, "text": "传出去臣颜面何存"}, {"start": 32.56, "end": 33.44, "text": "大王若真要封"}, {"start": 33.44, "end": 34.84, "text": "李当封臣一个文官侯爵"}, {"start": 34.84, "end": 35.76, "text": "比如什么文臣侯"}, {"start": 35.76, "end": 36.72, "text": "文臣侯之流"}, {"start": 36.72, "end": 37.68, "text": "一箭射碎敌将"}, {"start": 37.68, "end": 39.68, "text": "还要脸皮自称文谋求文官侯爵"}, {"start": 40.32, "end": 41.68, "text": "李爱卿言之有理"}, {"start": 41.68, "end": 42.68, "text": "既然爱卿是移住"}, {"start": 42.68, "end": 43.84, "text": "滕天之谋退敌"}, {"start": 43.84, "end": 45.0, "text": "那顾便顺应天意"}, {"start": 45.0, "end": 46.04, "text": "侧封李爱卿为"}, {"start": 46.04, "end": 46.92, "text": "李官侯"}, {"start": 48.2, "end": 49.4, "text": "李官侯"}, {"start": 49.4, "end": 50.76, "text": "多谢大王龙恩"}, {"start": 50.8, "end": 51.8, "text": "某家平生侯"}, {"start": 51.8, "end": 53.8, "text": "简直是为某家良身定做"}, {"start": 54.36, "end": 55.96, "text": "女帝分明是在内涵你"}, {"start": 55.96, "end": 57.76, "text": "以丽夫人的丽官侯啊"}]}