{"file": "一身腱子肉，乱世做谋臣-第123集.mp4", "ep": 123, "duration": 72.3, "segments": [{"start": 0.91, "end": 2.11, "text": "全军撤退"}, {"start": 2.11, "end": 3.31, "text": "保全残兑"}, {"start": 3.31, "end": 3.91, "text": "撤"}, {"start": 3.91, "end": 4.75, "text": "快撤"}, {"start": 10.62, "end": 12.7, "text": "哪里跑"}, {"start": 12.7, "end": 14.58, "text": "留下脑袋当花飞"}, {"start": 21.82, "end": 24.9, "text": "弟兄们"}, {"start": 24.9, "end": 26.18, "text": "敌军亏败"}, {"start": 26.18, "end": 28.26, "text": "出城痛打落水狗"}, {"start": 28.26, "end": 47.62, "text": "大王"}, {"start": 47.62, "end": 48.58, "text": "某家不负厚望"}, {"start": 48.58, "end": 50.02, "text": "两面包家之策攻城"}, {"start": 50.02, "end": 51.46, "text": "其军主力全军覆没"}, {"start": 51.46, "end": 52.58, "text": "某家这其谋神策"}, {"start": 52.58, "end": 53.42, "text": "成了吧"}, {"start": 53.42, "end": 55.1, "text": "成特成"}, {"start": 55.1, "end": 57.38, "text": "固执大陨能有李先生这等勇猛"}, {"start": 57.38, "end": 58.74, "text": "这等制谋超绝之事"}, {"start": 58.82, "end": 60.74, "text": "这乃大于万事之福啊"}, {"start": 60.74, "end": 61.54, "text": "听到没"}, {"start": 61.54, "end": 62.86, "text": "大王都夸某家"}, {"start": 62.86, "end": 63.74, "text": "制谋超绝"}, {"start": 63.74, "end": 65.82, "text": "某家就说某家是大于第一神谋文臣"}, {"start": 65.82, "end": 67.22, "text": "尔等先前还不信"}, {"start": 67.22, "end": 68.94, "text": "神特么制谋超绝"}, {"start": 68.94, "end": 71.54, "text": "分明是全凭个人大力出奇迹啊"}]}