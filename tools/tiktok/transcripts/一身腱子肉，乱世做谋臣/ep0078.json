{"file": "一身腱子肉，乱世做谋臣-第78集.mp4", "ep": 78, "duration": 90.8, "segments": [{"start": 0.0, "end": 1.0, "text": "两位先生"}, {"start": 1.0, "end": 2.0, "text": "不止这一处"}, {"start": 2.0, "end": 3.0, "text": "全城各处民房"}, {"start": 3.0, "end": 4.0, "text": "堆满了这种黑关"}, {"start": 4.0, "end": 6.0, "text": "是齐国协纵失山派"}, {"start": 6.0, "end": 7.0, "text": "快 传令全军将士"}, {"start": 7.0, "end": 8.0, "text": "立刻交上火油分烧"}, {"start": 8.0, "end": 9.0, "text": "送关母 快啊"}, {"start": 9.0, "end": 10.0, "text": "失山派"}, {"start": 10.0, "end": 11.0, "text": "这帮协修以秘书操控失洒"}, {"start": 11.0, "end": 12.0, "text": "张远山那丝"}, {"start": 12.0, "end": 13.0, "text": "根本不是气成溃逃"}, {"start": 13.0, "end": 14.0, "text": "他是故意把定边城"}, {"start": 14.0, "end": 15.0, "text": "控出来"}, {"start": 15.0, "end": 16.0, "text": "要用全城阴尸"}, {"start": 16.0, "end": 17.0, "text": "将我军一网打尽"}, {"start": 17.0, "end": 18.0, "text": "快 按郭先生吩咐"}, {"start": 18.0, "end": 19.0, "text": "烧关"}, {"start": 19.0, "end": 20.16, "text": "张萌"}, {"start": 20.16, "end": 23.15, "text": "谁把你伤成这副德性"}, {"start": 23.15, "end": 24.15, "text": "是啊"}, {"start": 24.15, "end": 25.15, "text": "死人全活过来了"}, {"start": 25.15, "end": 26.15, "text": "坏了"}, {"start": 26.15, "end": 28.15, "text": "好狠的绝护毒剂"}, {"start": 28.15, "end": 29.15, "text": "郭怀元"}, {"start": 29.15, "end": 30.15, "text": "现在才想明白"}, {"start": 30.15, "end": 31.15, "text": "未免太迟了"}, {"start": 31.15, "end": 33.15, "text": "老夫封张远山将军"}, {"start": 33.15, "end": 35.15, "text": "密令阵守于此"}, {"start": 35.15, "end": 36.15, "text": "今日定教你们"}, {"start": 36.15, "end": 37.15, "text": "叉赤难逃"}, {"start": 37.15, "end": 38.15, "text": "你爹给你大爷"}, {"start": 38.15, "end": 39.15, "text": "笑得跟公鸭教室的"}, {"start": 39.15, "end": 40.15, "text": "真难听"}, {"start": 40.15, "end": 41.15, "text": "一看你就是个短命反派"}, {"start": 41.15, "end": 42.15, "text": "反派通来没好下场"}, {"start": 42.15, "end": 43.15, "text": "懂不懂"}, {"start": 43.15, "end": 44.15, "text": "无知猛汉"}, {"start": 44.15, "end": 45.15, "text": "你就是那个黑沙神吧"}, {"start": 45.15, "end": 46.15, "text": "今日留下来"}, {"start": 46.15, "end": 47.15, "text": "给老夫当师奴吧"}, {"start": 47.15, "end": 48.15, "text": "屁"}, {"start": 48.15, "end": 49.15, "text": "某家是宝都师叔的"}, {"start": 49.15, "end": 50.15, "text": "正经民事"}, {"start": 50.15, "end": 51.15, "text": "要叫先生"}, {"start": 51.15, "end": 52.15, "text": "去 死死他"}, {"start": 52.15, "end": 53.15, "text": "下手小心"}, {"start": 53.15, "end": 57.93, "text": "那怪物刀枪不入"}, {"start": 57.93, "end": 58.93, "text": "老夫练了"}, {"start": 58.93, "end": 61.14, "text": "是 背你"}, {"start": 61.14, "end": 62.14, "text": "老东西"}, {"start": 62.14, "end": 63.14, "text": "你知道某家身为读书人"}, {"start": 63.14, "end": 65.14, "text": "为何还要刻苦练舞吗"}, {"start": 65.14, "end": 66.14, "text": "为 为何"}, {"start": 66.14, "end": 67.14, "text": "为了让你们这帮"}, {"start": 67.14, "end": 68.14, "text": "名顽的老东西"}, {"start": 68.14, "end": 69.14, "text": "能心平气和地"}, {"start": 69.14, "end": 70.14, "text": "跟某家讲道理"}, {"start": 70.14, "end": 71.14, "text": "放肆"}, {"start": 71.14, "end": 72.14, "text": "全给老夫上"}, {"start": 72.14, "end": 73.14, "text": "死了他"}, {"start": 73.14, "end": 76.83, "text": "小狠"}, {"start": 76.83, "end": 78.83, "text": "莫将连一尊都挡不住"}, {"start": 78.83, "end": 79.93, "text": "军师几拳就给收拾了"}, {"start": 79.93, "end": 80.93, "text": "军师大夫"}, {"start": 80.93, "end": 81.93, "text": "果然大力出奇迹"}, {"start": 81.93, "end": 83.93, "text": "老夫的银甲是"}, {"start": 83.93, "end": 84.93, "text": "老东西"}, {"start": 84.93, "end": 85.93, "text": "现在能跟某家坐下来"}, {"start": 85.93, "end": 86.93, "text": "好好说话了吗"}, {"start": 86.93, "end": 87.93, "text": "老夫"}, {"start": 87.93, "end": 88.93, "text": "叫你全军陪葬"}]}