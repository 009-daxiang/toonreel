{"file": "一身腱子肉，乱世做谋臣-第75集.mp4", "ep": 75, "duration": 77.0, "segments": [{"start": 0.0, "end": 1.24, "text": "李先生 孤先生"}, {"start": 1.24, "end": 2.04, "text": "昨夜受苦了"}, {"start": 2.04, "end": 3.32, "text": "殿下 我們沒事"}, {"start": 3.32, "end": 4.2, "text": "敢問殿下"}, {"start": 4.2, "end": 5.84, "text": "趙統帥率重兵包圍我營"}, {"start": 5.84, "end": 7.4, "text": "擺出這副陣史適合用意"}, {"start": 7.64, "end": 9.28, "text": "趙將軍堅持稱軍中會有監系"}, {"start": 9.28, "end": 10.28, "text": "要全軍撤查"}, {"start": 10.28, "end": 11.4, "text": "確認沒有通敵鐵陣後"}, {"start": 11.4, "end": 12.4, "text": "方可放諸位進城"}, {"start": 12.4, "end": 14.08, "text": "監系 撤查"}, {"start": 14.08, "end": 14.76, "text": "李兄"}, {"start": 14.76, "end": 15.88, "text": "深圳不怕隱子邪"}, {"start": 15.88, "end": 16.72, "text": "若不讓他們查"}, {"start": 16.72, "end": 18.08, "text": "恐給我們扣上通敵罪名"}, {"start": 18.08, "end": 18.76, "text": "依了殿下吧"}, {"start": 18.76, "end": 20.24, "text": "好 點一殿下"}, {"start": 20.24, "end": 20.72, "text": "來人"}, {"start": 20.72, "end": 21.08, "text": "搜"}, {"start": 21.08, "end": 22.28, "text": "給本將軍好好搜查"}, {"start": 22.28, "end": 23.64, "text": "尤其是這幾位大功臣"}, {"start": 24.57, "end": 26.57, "text": "此遼昨日竟敢當眾辱罵本將"}, {"start": 30.13, "end": 31.21, "text": "小不忍則亂大目"}, {"start": 31.21, "end": 32.09, "text": "李先生"}, {"start": 32.09, "end": 33.25, "text": "墨匠沒事"}, {"start": 33.25, "end": 34.61, "text": "別揍手"}, {"start": 34.61, "end": 35.21, "text": "冰將軍"}, {"start": 35.21, "end": 36.53, "text": "在營帳內抄出無數私藏的"}, {"start": 36.53, "end": 37.45, "text": "珠寶才藝"}, {"start": 37.45, "end": 38.25, "text": "通通充攻"}, {"start": 38.25, "end": 38.85, "text": "將軍"}, {"start": 38.85, "end": 39.89, "text": "那是兄弟們在齊國"}, {"start": 39.89, "end": 41.21, "text": "拿命換回來的戰利品"}, {"start": 41.21, "end": 42.61, "text": "憑什麼充攻"}, {"start": 42.61, "end": 43.49, "text": "大膽奴才"}, {"start": 43.49, "end": 45.01, "text": "私屯絞禍罪無可恕"}, {"start": 45.01, "end": 45.49, "text": "脫下去"}, {"start": 45.49, "end": 46.41, "text": "重打五十軍棍"}, {"start": 46.41, "end": 46.89, "text": "李兄"}, {"start": 46.89, "end": 48.25, "text": "忍住千萬別衝動"}, {"start": 48.25, "end": 49.53, "text": "好個角色有誤"}, {"start": 49.53, "end": 50.13, "text": "此女定是"}, {"start": 50.13, "end": 51.29, "text": "齊國派來的奸喜"}, {"start": 51.29, "end": 51.93, "text": "來人"}, {"start": 51.93, "end": 53.49, "text": "綁了送到本將大帳中"}, {"start": 53.49, "end": 54.97, "text": "我忍你大業"}, {"start": 54.97, "end": 57.09, "text": "再忍老子就不姓李"}, {"start": 57.09, "end": 59.18, "text": "爹"}, {"start": 59.22, "end": 60.26, "text": "你要造反不成"}, {"start": 60.26, "end": 61.7, "text": "竟敢當眾擊殺本將親兵"}, {"start": 61.7, "end": 62.42, "text": "反就反了"}, {"start": 62.42, "end": 63.3, "text": "你能砸地"}, {"start": 63.3, "end": 64.14, "text": "全軍聽令"}, {"start": 64.14, "end": 65.86, "text": "把這幫朝廷狗賊全宰了"}, {"start": 65.86, "end": 67.39, "text": "去你的朝廷官位"}, {"start": 69.39, "end": 71.07, "text": "誰敢動李先生一根豪毛"}, {"start": 71.07, "end": 72.51, "text": "老夫第一個不答應"}, {"start": 72.51, "end": 73.67, "text": "誰敢動李先生"}]}