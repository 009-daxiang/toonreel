{"file": "一身腱子肉，乱世做谋臣-第128集.mp4", "ep": 128, "duration": 72.5, "segments": [{"start": 2.1, "end": 2.82, "text": "马将军"}, {"start": 3.06, "end": 3.58, "text": "我们"}, {"start": 3.7, "end": 4.7, "text": "我们好像迷路了"}, {"start": 5.58, "end": 6.9, "text": "什么"}, {"start": 7.22, "end": 8.02, "text": "这可是李大人"}, {"start": 8.02, "end": 8.98, "text": "力堡老子领的兵"}, {"start": 9.46, "end": 10.26, "text": "若是无法暗示"}, {"start": 10.26, "end": 11.06, "text": "绕到齐军背后"}, {"start": 11.06, "end": 11.74, "text": "完成夹击"}, {"start": 11.74, "end": 12.9, "text": "正面战场一旦开打"}, {"start": 12.9, "end": 13.7, "text": "于军拿头去扛"}, {"start": 13.7, "end": 14.94, "text": "赵葵星的十万主力啊"}, {"start": 15.38, "end": 15.98, "text": "将军"}, {"start": 15.98, "end": 17.18, "text": "只南针全失灵了"}, {"start": 17.18, "end": 18.54, "text": "到处都是妖兽分辨"}, {"start": 18.54, "end": 19.62, "text": "这可如何是好"}, {"start": 19.62, "end": 20.14, "text": "快"}, {"start": 20.14, "end": 21.14, "text": "撒出所有赤猴"}, {"start": 21.14, "end": 22.46, "text": "不惜一切代价探路"}, {"start": 22.46, "end": 23.22, "text": "就是爬"}, {"start": 23.22, "end": 24.06, "text": "也要给老子爬到"}, {"start": 24.06, "end": 25.06, "text": "齐军屁股后面去"}, {"start": 25.06, "end": 25.74, "text": "快去"}, {"start": 26.18, "end": 29.76, "text": "赵葵星"}, {"start": 29.76, "end": 30.84, "text": "上前搭话"}, {"start": 31.32, "end": 33.26, "text": "昭玲公主"}, {"start": 33.26, "end": 34.34, "text": "以父王以降"}, {"start": 36.58, "end": 37.74, "text": "何必赴于顽抗"}, {"start": 37.74, "end": 39.18, "text": "本将大军在此"}, {"start": 39.18, "end": 40.54, "text": "若肯下马受降"}, {"start": 40.54, "end": 50.46, "text": "保你一事如华"}, {"start": 50.46, "end": 51.78, "text": "阿玉武虎权在正面"}, {"start": 51.78, "end": 52.98, "text": "能没有绕好欺兵"}, {"start": 52.98, "end": 53.94, "text": "看来这昭玲是打算"}, {"start": 53.94, "end": 54.5, "text": "孤注一致"}, {"start": 54.5, "end": 55.5, "text": "与本将死磕了"}, {"start": 55.5, "end": 56.3, "text": "优势在乎"}, {"start": 56.3, "end": 57.14, "text": "赵葵星"}, {"start": 57.14, "end": 58.22, "text": "你这败军之将"}, {"start": 58.22, "end": 59.9, "text": "昨日刚被杀的丢亏炮甲"}, {"start": 59.9, "end": 61.42, "text": "今日也敢在孤面前犬废"}, {"start": 61.42, "end": 62.66, "text": "大于风骨争争"}, {"start": 62.66, "end": 63.62, "text": "孤在此立势"}, {"start": 63.62, "end": 64.22, "text": "终有一日"}, {"start": 64.22, "end": 65.9, "text": "大于铁铁壁踏破齐都"}, {"start": 65.9, "end": 66.78, "text": "无知妇人"}, {"start": 66.78, "end": 67.74, "text": "你余国偏安易于"}, {"start": 67.74, "end": 68.74, "text": "还妄图妇国"}, {"start": 68.74, "end": 70.02, "text": "简直吃人说梦"}, {"start": 70.02, "end": 71.18, "text": "众将听令"}, {"start": 71.18, "end": 72.5, "text": "谁去秦霞这妇人"}]}