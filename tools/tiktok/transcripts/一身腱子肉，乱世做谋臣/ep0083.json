{"file": "一身腱子肉，乱世做谋臣-第83集.mp4", "ep": 83, "duration": 71.9, "segments": [{"start": 0.82, "end": 2.54, "text": "万岁万万岁"}, {"start": 2.54, "end": 3.22, "text": "即日起"}, {"start": 3.22, "end": 4.86, "text": "封韩军为立部尚书"}, {"start": 4.86, "end": 6.18, "text": "陈四为理部尚书"}, {"start": 6.18, "end": 7.46, "text": "赵拓为公部尚书"}, {"start": 7.46, "end": 8.5, "text": "其余有功之臣"}, {"start": 8.5, "end": 9.3, "text": "皆晋升拙把"}, {"start": 9.3, "end": 11.7, "text": "臣等叩谢大王皇恩"}, {"start": 11.7, "end": 13.63, "text": "众爱卿平身"}, {"start": 13.63, "end": 14.31, "text": "大王"}, {"start": 14.31, "end": 15.15, "text": "您急召微臣"}, {"start": 15.15, "end": 16.95, "text": "是有什么要紧的事吗"}, {"start": 16.95, "end": 18.11, "text": "韩爱卿请坐"}, {"start": 18.11, "end": 19.67, "text": "百官分封孤皆有定夺"}, {"start": 19.67, "end": 20.91, "text": "唯独这李浩吴先生"}, {"start": 20.91, "end": 21.63, "text": "让孤范了难"}, {"start": 21.63, "end": 22.35, "text": "微臣明白"}, {"start": 22.35, "end": 23.15, "text": "在陛下眼中"}, {"start": 23.15, "end": 24.67, "text": "李兄乃天下无双的猛将"}, {"start": 24.67, "end": 25.91, "text": "李英锋为兵马大元帅"}, {"start": 25.91, "end": 26.95, "text": "可李兄却偏偏以文臣"}, {"start": 26.95, "end": 27.91, "text": "这人谋事自居"}, {"start": 27.91, "end": 28.87, "text": "是也不是"}, {"start": 28.87, "end": 29.75, "text": "正是"}, {"start": 29.75, "end": 31.43, "text": "他若执意不肯领武职"}, {"start": 31.43, "end": 32.43, "text": "孤若强封"}, {"start": 32.43, "end": 33.91, "text": "恐伤了功臣之心"}, {"start": 33.91, "end": 34.75, "text": "陛下莫慌"}, {"start": 34.75, "end": 35.67, "text": "他不是硬觉得自己"}, {"start": 35.67, "end": 37.31, "text": "是算无余策的大文臣吗"}, {"start": 37.31, "end": 38.43, "text": "陛下所幸便封他一个"}, {"start": 38.43, "end": 39.59, "text": "正义品文官"}, {"start": 39.59, "end": 41.29, "text": "兵部尚书"}, {"start": 41.29, "end": 42.61, "text": "兵部尚书"}, {"start": 42.61, "end": 43.29, "text": "陛下"}, {"start": 43.29, "end": 44.25, "text": "兵部可不是光靠"}, {"start": 44.25, "end": 45.05, "text": "大力出奇迹就能"}, {"start": 45.05, "end": 46.09, "text": "懵混过去的"}, {"start": 46.09, "end": 47.45, "text": "统筹三军粮草调配"}, {"start": 47.45, "end": 48.49, "text": "合宴辅训军饷"}, {"start": 48.49, "end": 49.77, "text": "匹附各地布防公文"}, {"start": 49.77, "end": 50.33, "text": "那是天底下"}, {"start": 50.33, "end": 51.77, "text": "最魔人的反复文书"}, {"start": 51.77, "end": 52.77, "text": "陛下在纯水推舟"}, {"start": 52.77, "end": 53.77, "text": "将他改封为军前大将"}, {"start": 53.77, "end": 54.77, "text": "他便再无借口推托"}, {"start": 54.77, "end": 55.77, "text": "不过"}, {"start": 55.77, "end": 56.77, "text": "兵部乃三军命买"}, {"start": 56.77, "end": 57.77, "text": "不可真乱了他"}, {"start": 57.77, "end": 58.77, "text": "陛下莫慌"}, {"start": 58.77, "end": 59.77, "text": "可命郭怀远和张柏林"}, {"start": 59.77, "end": 60.77, "text": "为兵部左右侍郎"}, {"start": 60.77, "end": 61.77, "text": "有这二人兜底"}, {"start": 61.77, "end": 62.77, "text": "大局无忧"}, {"start": 62.77, "end": 63.77, "text": "如此甚好"}, {"start": 63.77, "end": 65.77, "text": "就依韩爱卿所奏"}]}