{"file": "一身腱子肉，乱世做谋臣-第33集.mp4", "ep": 33, "duration": 58.1, "segments": [{"start": 0.0, "end": 1.2, "text": "郭先生何故發酵"}, {"start": 1.28, "end": 2.24, "text": "莫非有何高見"}, {"start": 3.32, "end": 3.88, "text": "殿下"}, {"start": 3.96, "end": 5.36, "text": "此乃棋君全境不防徒"}, {"start": 5.44, "end": 6.32, "text": "是郭某這些日子"}, {"start": 6.4, "end": 7.0, "text": "閉門絕食"}, {"start": 7.08, "end": 7.68, "text": "憑畢生所學"}, {"start": 7.76, "end": 8.48, "text": "親手復刻出來的"}, {"start": 8.56, "end": 9.28, "text": "特憲殿下"}, {"start": 9.36, "end": 10.36, "text": "棋君不防徒"}, {"start": 10.6, "end": 11.32, "text": "有了此徒"}, {"start": 11.4, "end": 12.36, "text": "迫其指日可待"}, {"start": 12.44, "end": 13.68, "text": "郭先生當局手工"}, {"start": 13.76, "end": 14.76, "text": "郭某不要公明"}, {"start": 15.12, "end": 16.2, "text": "只求殿下有朝一日"}, {"start": 16.28, "end": 17.0, "text": "殺入棋都"}, {"start": 17.36, "end": 19.4, "text": "容郭某親手斬下那昏君狗頭"}, {"start": 19.48, "end": 20.28, "text": "手刃血仇"}, {"start": 20.36, "end": 21.24, "text": "若真有那一日"}, {"start": 21.32, "end": 22.24, "text": "本宮定將圖刀"}, {"start": 22.32, "end": 23.28, "text": "交到先生手中"}, {"start": 23.36, "end": 24.12, "text": "絕不實驗"}, {"start": 24.2, "end": 24.92, "text": "多謝殿下"}, {"start": 25.52, "end": 26.12, "text": "郭兄"}, {"start": 26.2, "end": 27.04, "text": "你已投我大軍"}, {"start": 30.48, "end": 31.52, "text": "防線全部重排"}, {"start": 31.6, "end": 32.28, "text": "你這圖"}, {"start": 32.36, "end": 33.52, "text": "怕是成了一張廢紙吧"}, {"start": 33.6, "end": 34.4, "text": "韓兄不懂張遠山"}, {"start": 34.48, "end": 35.28, "text": "此人極度似乎"}, {"start": 35.36, "end": 35.92, "text": "他千變萬化"}, {"start": 36.0, "end": 36.68, "text": "唯獨定兵城"}, {"start": 36.76, "end": 37.6, "text": "他絕不敢動"}, {"start": 37.68, "end": 38.76, "text": "定兵城"}, {"start": 39.12, "end": 40.56, "text": "此城備靠重山郡嶺"}, {"start": 40.64, "end": 41.44, "text": "一手難攻"}, {"start": 41.52, "end": 43.16, "text": "乃棋君良草與戰略疏扭"}, {"start": 43.24, "end": 43.84, "text": "若我軍能在"}, {"start": 43.92, "end": 44.84, "text": "張遠山辯陣之際"}, {"start": 44.92, "end": 46.12, "text": "一舉突襲拿下定城"}, {"start": 46.2, "end": 47.0, "text": "整條棋國邊防"}, {"start": 47.08, "end": 48.0, "text": "必全線崩潰"}, {"start": 48.08, "end": 49.2, "text": "好獨立的戰略"}, {"start": 49.28, "end": 50.36, "text": "好一個定兵城"}, {"start": 50.44, "end": 51.24, "text": "不行不行"}, {"start": 51.32, "end": 52.56, "text": "定兵城乃險觀"}, {"start": 52.64, "end": 53.12, "text": "千里奔襲"}, {"start": 53.2, "end": 53.92, "text": "彈劾容易"}, {"start": 54.0, "end": 54.96, "text": "敵軍嚴防死守"}, {"start": 55.0, "end": 56.04, "text": "我軍哪有這等神將"}, {"start": 56.12, "end": 56.68, "text": "能撕開城門"}, {"start": 56.76, "end": 57.8, "text": "一舉強攻多城"}]}