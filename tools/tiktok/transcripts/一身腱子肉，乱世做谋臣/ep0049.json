{"file": "一身腱子肉，乱世做谋臣-第49集.mp4", "ep": 49, "duration": 59.9, "segments": [{"start": 0.0, "end": 0.96, "text": "全军听令"}, {"start": 0.96, "end": 2.32, "text": "十日之内攻破定员"}, {"start": 2.32, "end": 3.24, "text": "围令者斩"}, {"start": 3.24, "end": 4.04, "text": "拿下"}, {"start": 4.4, "end": 5.64, "text": "小人们是正经商股"}, {"start": 5.64, "end": 6.48, "text": "出来跪地地"}, {"start": 6.48, "end": 7.88, "text": "孝敬军烟 买酒喝"}, {"start": 9.42, "end": 10.54, "text": "本官事才眼花"}, {"start": 10.54, "end": 11.26, "text": "你们一看就是"}, {"start": 11.26, "end": 12.14, "text": "尊计手法的大良民"}, {"start": 12.14, "end": 13.14, "text": "进城 快进城"}, {"start": 13.14, "end": 14.26, "text": "谢军爷 赵府"}, {"start": 17.54, "end": 18.42, "text": "蓬州传信"}, {"start": 18.7, "end": 20.14, "text": "蓬州被水烟轮陷了"}, {"start": 20.14, "end": 21.98, "text": "贼军正朝我永宁城出来"}, {"start": 21.98, "end": 22.9, "text": "既有此事"}, {"start": 22.9, "end": 23.58, "text": "将军快下令"}, {"start": 23.58, "end": 24.58, "text": "关闭四门全城戒烟"}, {"start": 24.58, "end": 24.94, "text": "快"}, {"start": 24.94, "end": 25.66, "text": "求军将股"}, {"start": 25.66, "end": 26.34, "text": "全军登城"}, {"start": 26.34, "end": 27.26, "text": "严加戒备"}, {"start": 27.26, "end": 28.7, "text": "大批羽军不知何时"}, {"start": 28.7, "end": 29.26, "text": "早已伪装"}, {"start": 29.26, "end": 30.5, "text": "将潜伏入城"}, {"start": 30.5, "end": 31.94, "text": "趁夜偷袭砍杀了城门手足"}, {"start": 31.94, "end": 32.62, "text": "大开四门"}, {"start": 32.62, "end": 33.78, "text": "全城实现"}, {"start": 33.78, "end": 34.38, "text": "完了"}, {"start": 34.38, "end": 35.42, "text": "怎么可能这么快"}, {"start": 35.42, "end": 36.22, "text": "城在人在"}, {"start": 36.22, "end": 37.18, "text": "城破人亡"}, {"start": 37.18, "end": 37.98, "text": "将军且慢"}, {"start": 37.98, "end": 39.86, "text": "某院随将军一同赴死"}, {"start": 39.86, "end": 41.26, "text": "先生本是文若书生"}, {"start": 41.26, "end": 42.54, "text": "还有治国报复未斩"}, {"start": 42.54, "end": 43.74, "text": "何必陪我送死"}, {"start": 43.74, "end": 45.58, "text": "速速从岸道逃命去吧"}, {"start": 45.58, "end": 46.98, "text": "若无将军信念一番之恩"}, {"start": 46.98, "end": 48.18, "text": "某早已饿死荒野"}, {"start": 48.18, "end": 49.14, "text": "今日永宁遭劫"}, {"start": 49.14, "end": 50.66, "text": "某事与将军从生共死"}, {"start": 50.66, "end": 51.54, "text": "与军长途奔袭"}, {"start": 51.54, "end": 52.46, "text": "已是强弩之末"}, {"start": 52.46, "end": 53.5, "text": "随我多回东城门"}, {"start": 53.5, "end": 54.9, "text": "把贼构堵死在城里"}, {"start": 55.74, "end": 56.34, "text": "张将军"}, {"start": 56.34, "end": 57.74, "text": "其军与死锋东门断我生路"}, {"start": 57.74, "end": 58.66, "text": "绝不能让他们合为"}, {"start": 58.66, "end": 59.86, "text": "军事救我"}]}