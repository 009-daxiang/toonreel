{"file": "一身腱子肉，乱世做谋臣-第62集.mp4", "ep": 62, "duration": 67.5, "segments": [{"start": 0.0, "end": 2.32, "text": "恕死狂妄 找死"}, {"start": 8.7, "end": 11.02, "text": "那是大宗师界天地之力的无上神通"}, {"start": 11.02, "end": 12.58, "text": "水德真身 法相天地"}, {"start": 12.58, "end": 14.75, "text": "水煞不灭 真身不死"}, {"start": 14.75, "end": 16.39, "text": "郭氏大人别打了"}, {"start": 16.39, "end": 17.55, "text": "别打了"}, {"start": 17.55, "end": 18.39, "text": "大王他"}, {"start": 18.39, "end": 19.99, "text": "大王他扛着传国玉玺"}, {"start": 19.99, "end": 22.83, "text": "带着后宫三千家事和国库金银"}, {"start": 22.83, "end": 25.76, "text": "彻底气成跑路了"}, {"start": 26.48, "end": 27.24, "text": "什么"}, {"start": 27.24, "end": 30.51, "text": "大王气成跑了"}, {"start": 30.51, "end": 31.27, "text": "李先生"}, {"start": 31.27, "end": 33.47, "text": "家门不幸 改日再战"}, {"start": 33.47, "end": 34.79, "text": "大王跑了"}, {"start": 34.79, "end": 36.43, "text": "前方大宗师尚在死战"}, {"start": 36.43, "end": 38.47, "text": "大王竟然被两座山下的气成跑了"}, {"start": 38.47, "end": 39.87, "text": "这叫个什么事啊"}, {"start": 39.87, "end": 40.79, "text": "大王都跑路了"}, {"start": 40.79, "end": 41.83, "text": "我们还起谁卖命"}, {"start": 41.83, "end": 42.15, "text": "就是"}, {"start": 42.15, "end": 43.11, "text": "连王上都跑了"}, {"start": 43.11, "end": 44.27, "text": "大家伙散火逃命吧"}, {"start": 44.27, "end": 45.11, "text": "人在城在"}, {"start": 45.11, "end": 46.11, "text": "谁敢后退半步"}, {"start": 46.11, "end": 47.27, "text": "立斩不舍"}, {"start": 47.27, "end": 49.59, "text": "那老道的天地法相卓士有些门道"}, {"start": 49.59, "end": 51.07, "text": "硬冲怕是要吃亏"}, {"start": 51.07, "end": 51.75, "text": "传令"}, {"start": 51.75, "end": 53.47, "text": "撤军三里 安营扎债"}, {"start": 53.47, "end": 54.23, "text": "李兄"}, {"start": 54.23, "end": 55.55, "text": "听老夫一句劝"}, {"start": 55.55, "end": 56.35, "text": "退兵吧"}, {"start": 56.35, "end": 57.65, "text": "退兵"}, {"start": 57.65, "end": 59.81, "text": "虽然老夫恨不得圣诞齐王之肉"}, {"start": 59.81, "end": 61.29, "text": "但如今打军逼至齐都"}, {"start": 61.29, "end": 62.93, "text": "违位旧兆的战略已然全胜"}, {"start": 62.93, "end": 63.61, "text": "见好就收"}, {"start": 63.61, "end": 64.73, "text": "咱们赶紧撤回大鱼吧"}, {"start": 64.73, "end": 65.45, "text": "李先生"}, {"start": 65.45, "end": 66.17, "text": "批兵难知"}, {"start": 66.17, "end": 67.41, "text": "再不走当真走不掉了"}]}