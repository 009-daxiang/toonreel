{"file": "一身腱子肉，乱世做谋臣-第117集.mp4", "ep": 117, "duration": 64.1, "segments": [{"start": 3.66, "end": 5.66, "text": "本将军再给你最后一次机会"}, {"start": 5.66, "end": 6.66, "text": "若开城纳祥"}, {"start": 6.66, "end": 7.66, "text": "前诺依然做数"}, {"start": 7.66, "end": 9.66, "text": "否则城破之日"}, {"start": 9.66, "end": 11.66, "text": "定员满城鸡权不留"}, {"start": 11.66, "end": 12.66, "text": "赵葵星"}, {"start": 12.66, "end": 13.66, "text": "昨日不知是谁被我军小将"}, {"start": 13.66, "end": 14.66, "text": "斩七郎外退"}, {"start": 14.66, "end": 15.66, "text": "败军之权"}, {"start": 15.66, "end": 16.66, "text": "安敢在城下狂毁"}, {"start": 16.66, "end": 17.66, "text": "明完不灵"}, {"start": 17.66, "end": 18.66, "text": "前锋营"}, {"start": 18.66, "end": 19.66, "text": "压上去"}, {"start": 26.15, "end": 27.15, "text": "大王"}, {"start": 27.15, "end": 28.15, "text": "底下冲上来的"}, {"start": 28.15, "end": 30.15, "text": "全是咱们大鱼的富老乡亲啊"}, {"start": 30.15, "end": 31.15, "text": "这怎么打"}, {"start": 31.15, "end": 33.59, "text": "战场之上"}, {"start": 33.59, "end": 35.59, "text": "烦灯成者皆是敌寇"}, {"start": 35.59, "end": 36.59, "text": "对敌人的人词"}, {"start": 36.59, "end": 37.59, "text": "就是对满城军民的残忍"}, {"start": 37.59, "end": 38.59, "text": "放箭"}, {"start": 41.35, "end": 42.35, "text": "自动消耗的差不多了"}, {"start": 42.35, "end": 43.35, "text": "起军精锐"}, {"start": 43.35, "end": 44.35, "text": "全卸攻城"}, {"start": 51.18, "end": 52.18, "text": "一个月了"}, {"start": 52.18, "end": 53.18, "text": "城内守军减员"}, {"start": 53.18, "end": 54.18, "text": "超过三分之一"}, {"start": 54.18, "end": 55.18, "text": "滚木滚石几乎耗尽"}, {"start": 56.18, "end": 57.18, "text": "诸位爱卿"}, {"start": 57.18, "end": 58.18, "text": "可有退敌良策"}, {"start": 58.18, "end": 59.18, "text": "大王"}, {"start": 59.18, "end": 60.18, "text": "不如由微臣领死"}, {"start": 60.18, "end": 61.18, "text": "是夜袭敌营"}, {"start": 61.18, "end": 62.3, "text": "烧起粮草"}, {"start": 62.3, "end": 63.3, "text": "不夺"}]}