{"file": "一身腱子肉，乱世做谋臣-第48集.mp4", "ep": 48, "duration": 72.1, "segments": [{"start": 4.46, "end": 6.22, "text": "陛下 大祸临头"}, {"start": 6.22, "end": 7.5, "text": "出天大的事了"}, {"start": 7.94, "end": 9.54, "text": "慌什么 成何体统"}, {"start": 9.74, "end": 10.38, "text": "陛下"}, {"start": 10.58, "end": 11.38, "text": "一直不知从哪儿"}, {"start": 11.38, "end": 12.82, "text": "钻出来的渔军越过边境"}, {"start": 12.82, "end": 14.46, "text": "首次大山水烟鹏州城"}, {"start": 14.46, "end": 15.54, "text": "斩杀三万守军"}, {"start": 15.54, "end": 16.86, "text": "如今正星叶直奔王都"}, {"start": 16.86, "end": 18.22, "text": "永济城杀来啊"}, {"start": 18.22, "end": 18.94, "text": "什么"}, {"start": 19.1, "end": 20.22, "text": "水烟鹏州"}, {"start": 20.22, "end": 21.18, "text": "张远山那条老狗"}, {"start": 21.18, "end": 22.22, "text": "是干什么吃的"}, {"start": 22.22, "end": 24.06, "text": "传旨 给国人传王旨"}, {"start": 24.06, "end": 25.98, "text": "让张远山立刻滚回来救驾"}, {"start": 25.98, "end": 26.82, "text": "快去"}, {"start": 27.3, "end": 28.06, "text": "饭桶"}, {"start": 28.22, "end": 30.18, "text": "全是一帮吃干饭的酒囊饭袋"}, {"start": 30.18, "end": 31.46, "text": "十五万大军"}, {"start": 31.46, "end": 32.66, "text": "连区区一座小小的"}, {"start": 32.66, "end": 34.02, "text": "定远县都肯不下来"}, {"start": 34.02, "end": 35.9, "text": "老夫的脸都被你们丢尽了"}, {"start": 35.9, "end": 36.94, "text": "报 大将军"}, {"start": 36.94, "end": 37.9, "text": "大后方急报"}, {"start": 37.9, "end": 39.62, "text": "鹏州城突遭万丈洪水烟墨"}, {"start": 39.62, "end": 40.9, "text": "三万守军全军覆墨"}, {"start": 40.9, "end": 42.42, "text": "渔军正奔王都杀去"}, {"start": 42.66, "end": 43.82, "text": "怎会如此"}, {"start": 44.06, "end": 45.98, "text": "鹏州城怎可能顺序沦陷"}, {"start": 45.98, "end": 47.38, "text": "张将军 大王明旨"}, {"start": 47.38, "end": 48.3, "text": "渔军直逼王都"}, {"start": 48.3, "end": 49.3, "text": "乐令张军即刻帅"}, {"start": 49.3, "end": 50.5, "text": "全军拔营回源"}, {"start": 50.5, "end": 51.38, "text": "不得有误"}, {"start": 51.38, "end": 52.5, "text": "戒指吧"}, {"start": 52.5, "end": 53.14, "text": "赵公公"}, {"start": 53.14, "end": 54.38, "text": "这王旨本将接了"}, {"start": 54.38, "end": 55.7, "text": "但回防王都之令"}, {"start": 55.7, "end": 57.02, "text": "本将树南从命"}, {"start": 57.02, "end": 57.82, "text": "张远山"}, {"start": 57.82, "end": 58.9, "text": "你敢违抗王旨"}, {"start": 58.9, "end": 59.98, "text": "你想谋反不成"}, {"start": 59.98, "end": 60.62, "text": "将在外"}, {"start": 60.62, "end": 61.86, "text": "军命有所不受"}, {"start": 61.86, "end": 63.02, "text": "王都前上有永宁城"}, {"start": 63.02, "end": 64.66, "text": "与长陵城两座天险雄关"}, {"start": 64.66, "end": 66.58, "text": "渔军绝不可能短时间攻破"}, {"start": 66.58, "end": 67.3, "text": "回禀大王"}, {"start": 67.3, "end": 68.1, "text": "十日之内"}, {"start": 68.1, "end": 69.42, "text": "待本将踏防定远县"}, {"start": 69.42, "end": 71.1, "text": "自会挥尸回京全奸贼寇"}, {"start": 71.1, "end": 71.9, "text": "送客"}]}