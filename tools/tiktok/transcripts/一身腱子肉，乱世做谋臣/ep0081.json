{"file": "一身腱子肉，乱世做谋臣-第81集.mp4", "ep": 81, "duration": 72.9, "segments": [{"start": 0.11, "end": 0.91, "text": "顾先生"}, {"start": 0.91, "end": 2.03, "text": "这到底是怎么一回事"}, {"start": 2.03, "end": 3.39, "text": "李先生真学了控世术"}, {"start": 4.41, "end": 5.13, "text": "殿下"}, {"start": 5.13, "end": 6.25, "text": "破城是真的"}, {"start": 6.25, "end": 7.89, "text": "李兄完全是靠肉身满力左右开弓"}, {"start": 7.89, "end": 9.33, "text": "把那师王活生生打到怀疑师生"}, {"start": 9.33, "end": 10.21, "text": "跪地管他叫爹"}, {"start": 10.21, "end": 11.09, "text": "这才认得住"}, {"start": 11.74, "end": 12.9, "text": "李兄大力出奇迹"}, {"start": 12.9, "end": 13.78, "text": "为臣拜福"}, {"start": 19.1, "end": 19.86, "text": "诸位同僚"}, {"start": 19.86, "end": 20.82, "text": "你等年纪轻轻"}, {"start": 20.82, "end": 21.78, "text": "黑眼圈就这么大"}, {"start": 21.78, "end": 22.82, "text": "身子骨这般虚伏"}, {"start": 22.82, "end": 23.66, "text": "成何体统"}, {"start": 23.66, "end": 24.9, "text": "都给我打起精神来"}, {"start": 24.9, "end": 25.86, "text": "召集诸位"}, {"start": 25.86, "end": 27.3, "text": "是有惊天恶好"}, {"start": 27.3, "end": 28.14, "text": "殿下"}, {"start": 28.14, "end": 29.42, "text": "究竟发生了何事"}, {"start": 29.42, "end": 31.7, "text": "齐军一直偏事孤军奔袭王都"}, {"start": 31.82, "end": 34.02, "text": "大王竟然不战而降"}, {"start": 34.02, "end": 35.74, "text": "如今我大于大半江山"}, {"start": 35.74, "end": 37.42, "text": "以净数落入七国铁梯之下"}, {"start": 37.42, "end": 38.02, "text": "什么"}, {"start": 38.02, "end": 38.78, "text": "大王降了"}, {"start": 38.78, "end": 39.42, "text": "王都城高池"}, {"start": 39.42, "end": 40.06, "text": "凉墓组织三年"}, {"start": 40.06, "end": 41.42, "text": "少有五万精锐军啊"}, {"start": 41.42, "end": 42.98, "text": "大王怎能降啊"}, {"start": 42.98, "end": 43.7, "text": "我等在前县"}, {"start": 43.7, "end": 44.82, "text": "抛头炉撒热血"}, {"start": 44.82, "end": 46.38, "text": "他在老朝直接给人跪了"}, {"start": 46.38, "end": 47.14, "text": "国都亡了"}, {"start": 47.14, "end": 48.74, "text": "我们在此拼命还有何意义"}, {"start": 48.74, "end": 50.14, "text": "此前派来的赵绝明"}, {"start": 50.14, "end": 51.3, "text": "便是接管我们定远军的"}, {"start": 51.3, "end": 52.14, "text": "齐听傀儡"}, {"start": 52.14, "end": 53.18, "text": "得亏李先生当机立断"}, {"start": 53.18, "end": 53.82, "text": "将其斩杀"}, {"start": 53.82, "end": 55.62, "text": "否则我等早已死无藏身之地"}, {"start": 55.62, "end": 56.58, "text": "国都已失"}, {"start": 56.58, "end": 57.66, "text": "大王已降"}, {"start": 61.7, "end": 62.7, "text": "只要我们还在"}, {"start": 62.7, "end": 64.02, "text": "大于就没有王"}, {"start": 64.02, "end": 65.74, "text": "那草包大王膝盖软"}, {"start": 65.74, "end": 66.82, "text": "那是他无能"}, {"start": 66.82, "end": 69.06, "text": "殿下您乃大于王室纯正血脉"}, {"start": 69.06, "end": 70.22, "text": "既然王位空了"}, {"start": 70.22, "end": 71.7, "text": "不如就在这定远县"}, {"start": 71.7, "end": 72.9, "text": "登基成王"}]}