{"file": "一身腱子肉，乱世做谋臣-第3集.mp4", "ep": 3, "duration": 84.1, "segments": [{"start": 1.84, "end": 2.64, "text": "见过将军"}, {"start": 2.64, "end": 3.76, "text": "某家是军师"}, {"start": 3.76, "end": 5.16, "text": "是毛氏"}, {"start": 5.16, "end": 7.42, "text": "差声闻句多"}, {"start": 7.42, "end": 8.95, "text": "是装备问题"}, {"start": 8.95, "end": 10.55, "text": "毛氏就得雨扇灵精"}, {"start": 10.55, "end": 11.75, "text": "找殿下要装备去"}, {"start": 11.75, "end": 16.83, "text": "毛家李浩求见殿"}, {"start": 16.83, "end": 17.75, "text": "殿下"}, {"start": 17.75, "end": 19.87, "text": "您家的门貌似不太揭示"}, {"start": 19.87, "end": 20.75, "text": "李先生"}, {"start": 20.75, "end": 21.79, "text": "进来说话吧"}, {"start": 21.79, "end": 23.03, "text": "李先生查了本宫的门"}, {"start": 23.03, "end": 23.87, "text": "所谓何事啊"}, {"start": 23.87, "end": 24.47, "text": "殿下"}, {"start": 24.47, "end": 25.55, "text": "某家现在是毛氏了"}, {"start": 25.55, "end": 27.03, "text": "毛氏就该雨扇灵精才对"}, {"start": 27.03, "end": 28.55, "text": "某家这身衣物太粗鄙了"}, {"start": 28.55, "end": 31.08, "text": "特来求一套闻人形头"}, {"start": 31.08, "end": 33.16, "text": "就为这事儿准了"}, {"start": 33.16, "end": 35.12, "text": "本宫这就让人去给你定制"}, {"start": 35.12, "end": 36.16, "text": "切殿下"}, {"start": 39.3, "end": 43.71, "text": "别说还挺像那么回事"}, {"start": 43.71, "end": 44.43, "text": "太轻了"}, {"start": 44.43, "end": 46.42, "text": "一点风没有还容易弄丢"}, {"start": 46.42, "end": 47.1, "text": "有了"}, {"start": 47.1, "end": 50.16, "text": "去打一把揭示的"}, {"start": 50.16, "end": 50.96, "text": "掌柜的"}, {"start": 50.96, "end": 51.36, "text": "重"}, {"start": 51.36, "end": 51.96, "text": "先生"}, {"start": 51.96, "end": 53.0, "text": "您要打什么兵刃"}, {"start": 53.0, "end": 54.32, "text": "大铁锤还是斩马刀"}, {"start": 54.32, "end": 55.72, "text": "某家要打一把扇子"}, {"start": 55.72, "end": 56.96, "text": "全铁打造的雨扇"}, {"start": 56.96, "end": 57.68, "text": "分量要足"}, {"start": 57.68, "end": 58.24, "text": "要重"}, {"start": 58.24, "end": 58.76, "text": "铁"}, {"start": 58.76, "end": 59.48, "text": "铁扇子"}, {"start": 59.48, "end": 60.92, "text": "那能扇出风吗"}, {"start": 60.92, "end": 61.84, "text": "能不能打"}, {"start": 61.84, "end": 62.72, "text": "能打能打"}, {"start": 62.72, "end": 63.68, "text": "只要钱到位了"}, {"start": 63.68, "end": 64.52, "text": "啥都能打"}, {"start": 64.52, "end": 65.4, "text": "三天后来取"}, {"start": 65.4, "end": 66.92, "text": "帮您满意"}, {"start": 66.92, "end": 67.76, "text": "海先生"}, {"start": 67.76, "end": 68.72, "text": "您这是怎么了"}, {"start": 68.72, "end": 70.04, "text": "气色怎么会如此惨白"}, {"start": 70.04, "end": 71.12, "text": "回殿下"}, {"start": 71.16, "end": 72.0, "text": "陈氏"}, {"start": 72.0, "end": 72.8, "text": "饿的"}, {"start": 72.8, "end": 73.8, "text": "饿的"}, {"start": 73.8, "end": 74.6, "text": "军中何曾短了"}, {"start": 74.6, "end": 75.48, "text": "先生的伙食"}, {"start": 75.48, "end": 76.0, "text": "殿下"}, {"start": 76.0, "end": 76.96, "text": "并非臣不吃"}, {"start": 76.96, "end": 77.8, "text": "而是那位李先生"}, {"start": 77.8, "end": 79.0, "text": "太能吃了"}, {"start": 79.0, "end": 79.84, "text": "他一个人"}, {"start": 79.84, "end": 80.88, "text": "把我们七个人的饭菜"}, {"start": 80.88, "end": 82.48, "text": "连统全给造完了"}]}