{"file": "一身腱子肉，乱世做谋臣-第70集.mp4", "ep": 70, "duration": 87.6, "segments": [{"start": 5.65, "end": 6.25, "text": "别动"}, {"start": 6.45, "end": 7.45, "text": "动一下 宰了你"}, {"start": 7.85, "end": 8.25, "text": "你"}, {"start": 8.45, "end": 9.97, "text": "你到底是人是鬼"}, {"start": 10.17, "end": 10.57, "text": "退退"}, {"start": 10.77, "end": 11.57, "text": "谁敢上前一步"}, {"start": 11.57, "end": 12.77, "text": "某家当场动了他的狗头"}, {"start": 12.77, "end": 13.17, "text": "退后"}, {"start": 13.17, "end": 13.97, "text": "都给老子滚退后"}, {"start": 13.97, "end": 14.37, "text": "别过来"}, {"start": 14.37, "end": 15.37, "text": "这位副将军"}, {"start": 15.57, "end": 16.57, "text": "你刚喊某家什么"}, {"start": 16.57, "end": 16.97, "text": "大家"}, {"start": 16.97, "end": 17.37, "text": "浩瀚"}, {"start": 17.37, "end": 18.57, "text": "某家是正经读书人"}, {"start": 18.57, "end": 19.37, "text": "文臣谋事"}, {"start": 19.37, "end": 19.97, "text": "叫先生"}, {"start": 19.97, "end": 20.77, "text": "先生 先生"}, {"start": 20.77, "end": 21.37, "text": "本将错了"}, {"start": 21.37, "end": 22.37, "text": "先生切莫手斗"}, {"start": 22.37, "end": 23.17, "text": "有话好说啊"}, {"start": 23.17, "end": 23.77, "text": "借不借到"}, {"start": 23.77, "end": 24.57, "text": "借 借到"}, {"start": 24.57, "end": 25.17, "text": "立刻放行"}, {"start": 25.17, "end": 25.97, "text": "绝不阻拦"}, {"start": 33.5, "end": 35.1, "text": "某家与这位将军商量妥了"}, {"start": 35.1, "end": 36.3, "text": "将军身名大义"}, {"start": 36.3, "end": 37.9, "text": "已经同意借到放我们入境了"}, {"start": 37.9, "end": 39.1, "text": "这位将军人还怪好嘞"}, {"start": 39.1, "end": 40.9, "text": "鱼兄 你开心就好"}, {"start": 40.9, "end": 42.1, "text": "全军听令"}, {"start": 42.1, "end": 43.1, "text": "开城门"}, {"start": 43.1, "end": 44.5, "text": "放鱼军借到"}, {"start": 44.5, "end": 45.9, "text": "退避两侧"}, {"start": 45.9, "end": 46.9, "text": "谁敢阻拦"}, {"start": 46.9, "end": 48.1, "text": "格杀勿论"}, {"start": 51.03, "end": 51.83, "text": "这位先生"}, {"start": 51.83, "end": 52.43, "text": "你看"}, {"start": 52.43, "end": 54.23, "text": "贵军已然技术安全过关"}, {"start": 54.23, "end": 56.23, "text": "不知可否放本将一条生路啊"}, {"start": 57.54, "end": 58.14, "text": "行"}, {"start": 58.34, "end": 58.94, "text": "将军"}, {"start": 58.94, "end": 59.94, "text": "这一路多亏有你"}, {"start": 59.94, "end": 60.94, "text": "你人还怪好嘞"}, {"start": 60.94, "end": 62.14, "text": "还未请教大明"}, {"start": 62.14, "end": 64.34, "text": "本将在宁国抚远将军复成武"}, {"start": 64.34, "end": 64.94, "text": "敢问"}, {"start": 64.94, "end": 66.34, "text": "先生尊姓大明"}, {"start": 66.34, "end": 67.94, "text": "某家大鱼正义品谋事"}, {"start": 67.94, "end": 69.14, "text": "行不给名做不改姓"}, {"start": 69.14, "end": 70.14, "text": "韩军誓言"}, {"start": 70.34, "end": 71.34, "text": "大鱼韩军"}, {"start": 71.34, "end": 71.94, "text": "好"}, {"start": 71.94, "end": 72.74, "text": "韩先生"}, {"start": 72.74, "end": 74.34, "text": "今日之恩本将莫是难忘"}, {"start": 74.34, "end": 75.14, "text": "后会有期"}, {"start": 75.14, "end": 75.94, "text": "后会有期"}, {"start": 75.94, "end": 76.94, "text": "好人将军"}, {"start": 79.45, "end": 80.25, "text": "韩军"}, {"start": 80.25, "end": 81.2, "text": "蠢"}, {"start": 81.2, "end": 82.4, "text": "真当老夫是好人"}, {"start": 82.4, "end": 84.6, "text": "下辈子去阎王殿报你的大名吧"}, {"start": 85.0, "end": 85.6, "text": "不对劲"}]}