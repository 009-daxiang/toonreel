{"file": "死囚营杀敌就能加点-第187集.mp4", "ep": 187, "duration": 60.1, "segments": [{"start": 0.0, "end": 1.54, "text": "后来没人练得动"}, {"start": 1.86, "end": 3.4, "text": "不是太祖薄情"}, {"start": 3.8, "end": 5.34, "text": "是后人太软"}, {"start": 5.6, "end": 7.4, "text": "重甲重起死战"}, {"start": 7.97, "end": 10.53, "text": "哪一代不是养在圣规里读圣贤书"}, {"start": 10.79, "end": 12.07, "text": "我倒不怕死"}, {"start": 13.14, "end": 14.94, "text": "我是怕没人跟得上我死"}, {"start": 15.2, "end": 15.96, "text": "八尺"}, {"start": 16.7, "end": 17.98, "text": "现在的汉子"}, {"start": 18.24, "end": 19.78, "text": "能到这数的不多"}, {"start": 21.34, "end": 22.12, "text": "我有力气"}, {"start": 22.62, "end": 23.64, "text": "有脑子"}, {"start": 23.9, "end": 25.57, "text": "选不出合格的"}, {"start": 26.12, "end": 30.13, "text": "我就把不合格的练到合格"}, {"start": 30.39, "end": 31.93, "text": "一米八五的个子打底"}, {"start": 32.96, "end": 34.24, "text": "身体建数"}, {"start": 35.06, "end": 36.86, "text": "身板还得硬得像石头"}, {"start": 38.38, "end": 39.66, "text": "这哪是征兵"}, {"start": 39.92, "end": 41.2, "text": "是条深刻"}, {"start": 43.06, "end": 44.84, "text": "普通兵撞上来就是送"}, {"start": 45.1, "end": 47.4, "text": "前世谁跟我说百倍兵力还能打"}, {"start": 47.66, "end": 48.94, "text": "我准当他是疯子"}, {"start": 49.88, "end": 51.16, "text": "可这世界有钢器"}, {"start": 51.42, "end": 52.68, "text": "有刀锋能划墙"}, {"start": 52.94, "end": 53.98, "text": "这个数不是吹的"}, {"start": 54.67, "end": 56.21, "text": "书里写的一笛摆"}, {"start": 56.47, "end": 58.01, "text": "是真能杀出来的"}, {"start": 58.7, "end": 59.98, "text": "不是仗坊算出来的"}]}