{"file": "死囚营杀敌就能加点-第276集.mp4", "ep": 276, "duration": 45.1, "segments": [{"start": 0.0, "end": 0.48, "text": "老大"}, {"start": 0.84, "end": 1.92, "text": "这点你不用担心"}, {"start": 2.28, "end": 3.96, "text": "咱们大前王朝是军决制度"}, {"start": 4.36, "end": 5.64, "text": "以你昨天立下的战功"}, {"start": 5.72, "end": 6.68, "text": "足以让你升官"}, {"start": 6.76, "end": 7.84, "text": "并且拿到军决了"}, {"start": 8.62, "end": 9.74, "text": "我想今天赵老大那边"}, {"start": 9.74, "end": 10.54, "text": "就能确定下来"}, {"start": 10.98, "end": 12.54, "text": "毕竟手里有你这么一个猛人"}, {"start": 12.78, "end": 14.78, "text": "任谁也不会放着单独当一个小兵"}, {"start": 17.52, "end": 18.2, "text": "李道是吗"}, {"start": 19.65, "end": 20.17, "text": "小子"}, {"start": 20.77, "end": 22.13, "text": "找我们老大有什么事"}, {"start": 22.49, "end": 25.9, "text": "什么时候新兵这么大拆灭了"}, {"start": 31.57, "end": 31.97, "text": "行了"}, {"start": 32.41, "end": 33.01, "text": "放他下来"}, {"start": 34.57, "end": 35.57, "text": "我们老大找你"}, {"start": 35.85, "end": 37.33, "text": "拜托给我好一点"}, {"start": 42.3, "end": 43.42, "text": "请问找我有何事"}]}