{"file": "死囚营杀敌就能加点-第121集.mp4", "ep": 121, "duration": 60.1, "segments": [{"start": 0.0, "end": 0.92, "text": "小姐猜对了"}, {"start": 1.2, "end": 2.2, "text": "你就是骗了我"}, {"start": 3.82, "end": 5.62, "text": "我重新给你陪个故事行吧"}, {"start": 6.1, "end": 6.62, "text": "你"}, {"start": 9.74, "end": 10.7, "text": "捏了她的脸"}, {"start": 11.19, "end": 13.07, "text": "下意识把她当自家妹妹了"}, {"start": 13.39, "end": 14.91, "text": "这下真成登徒子了"}, {"start": 18.07, "end": 18.75, "text": "游儿"}, {"start": 19.07, "end": 20.43, "text": "今天怎么回来这么早"}, {"start": 20.55, "end": 21.87, "text": "她真的骗了我"}, {"start": 21.87, "end": 22.75, "text": "真是个坏人"}, {"start": 22.75, "end": 23.67, "text": "坏人吗"}, {"start": 24.07, "end": 25.91, "text": "既然游儿你说她是坏人"}, {"start": 25.91, "end": 27.15, "text": "那一定是坏人"}, {"start": 27.35, "end": 29.43, "text": "我让护卫出手解决了她怎么样"}, {"start": 29.43, "end": 30.03, "text": "不要"}, {"start": 30.03, "end": 30.71, "text": "游儿"}, {"start": 30.95, "end": 32.87, "text": "看样子你是真的纯粹蒙重了"}, {"start": 32.87, "end": 33.79, "text": "我才没有"}, {"start": 33.87, "end": 35.35, "text": "我要一直陪着小姐你"}, {"start": 35.63, "end": 36.83, "text": "陪着小姐我"}, {"start": 36.83, "end": 38.43, "text": "你将来可能所托非人"}, {"start": 38.79, "end": 40.35, "text": "那游儿更不能留下小姐了"}, {"start": 41.1, "end": 41.78, "text": "逗你的"}, {"start": 42.1, "end": 42.98, "text": "放心吧 游儿"}, {"start": 43.14, "end": 44.42, "text": "小姐不会让你受苦的"}, {"start": 52.88, "end": 54.12, "text": "随上骂我坏人"}, {"start": 54.68, "end": 56.16, "text": "倒点还天天淋泛来"}, {"start": 56.74, "end": 58.58, "text": "这丫头比我想得傲娇"}]}