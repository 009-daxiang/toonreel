{"file": "死囚营杀敌就能加点-第190集.mp4", "ep": 190, "duration": 45.2, "segments": [{"start": 0.21, "end": 1.21, "text": "恩宫"}, {"start": 1.21, "end": 3.21, "text": "再留一段时间吧"}, {"start": 4.21, "end": 6.21, "text": "恩宫 求你别走"}, {"start": 6.21, "end": 7.21, "text": "能不能不走啊"}, {"start": 8.21, "end": 9.21, "text": "我们舍不得你"}, {"start": 9.21, "end": 11.21, "text": "舍不得你"}, {"start": 15.09, "end": 16.09, "text": "都安静点"}, {"start": 16.09, "end": 17.09, "text": "恩宫有自己的事情"}, {"start": 17.09, "end": 19.09, "text": "那能是你们可以左右的"}, {"start": 19.09, "end": 20.09, "text": "恩宫救了我们的命"}, {"start": 20.09, "end": 21.09, "text": "帮我们报了仇"}, {"start": 22.09, "end": 23.09, "text": "难不成你们就想用"}, {"start": 23.09, "end": 24.09, "text": "这般无理取闹的样子"}, {"start": 24.09, "end": 25.09, "text": "回报恩宫"}, {"start": 25.09, "end": 26.09, "text": "你们对得起"}, {"start": 26.09, "end": 27.09, "text": "自己的良心吗"}, {"start": 27.09, "end": 35.16, "text": "恩宫"}, {"start": 35.16, "end": 37.16, "text": "我们虽然没有读过什么书"}, {"start": 37.16, "end": 38.16, "text": "但我们也知道"}, {"start": 38.16, "end": 41.16, "text": "救命之恩之恩无以为报"}, {"start": 41.16, "end": 43.48, "text": "只恨我等姐妹们"}, {"start": 43.48, "end": 44.48, "text": "现在无力报恩"}]}