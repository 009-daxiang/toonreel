{"file": "死囚营杀敌就能加点-第239集.mp4", "ep": 239, "duration": 60.1, "segments": [{"start": 0.18, "end": 1.58, "text": "报道信上有印章"}, {"start": 1.98, "end": 3.18, "text": "可以确定我的身份"}, {"start": 3.38, "end": 4.18, "text": "印章"}, {"start": 4.62, "end": 5.34, "text": "不好意思"}, {"start": 5.58, "end": 6.34, "text": "我势力不好"}, {"start": 6.34, "end": 6.98, "text": "看不清"}, {"start": 10.02, "end": 12.38, "text": "现在只要我们从问杀表姓小飞"}, {"start": 14.94, "end": 15.98, "text": "那请问两位"}, {"start": 16.14, "end": 17.5, "text": "我该如何示好才对"}, {"start": 17.66, "end": 18.7, "text": "你自己的事情"}, {"start": 18.7, "end": 19.9, "text": "自己解决才对"}, {"start": 19.98, "end": 21.06, "text": "我们也没办法"}, {"start": 21.06, "end": 21.82, "text": "又或者"}, {"start": 21.82, "end": 22.9, "text": "你可以回去请人过来"}, {"start": 22.9, "end": 23.82, "text": "说明你的身份"}, {"start": 23.98, "end": 24.5, "text": "当然"}, {"start": 24.66, "end": 26.06, "text": "不能超过三天时间"}, {"start": 26.18, "end": 27.34, "text": "超过三天时间"}, {"start": 27.34, "end": 28.54, "text": "你可就成了逃兵"}, {"start": 28.54, "end": 29.82, "text": "那会很麻烦的"}, {"start": 30.14, "end": 31.46, "text": "跟你们废话够了"}, {"start": 34.08, "end": 34.72, "text": "白浅"}, {"start": 35.44, "end": 36.28, "text": "让他们看"}, {"start": 37.05, "end": 38.21, "text": "什么叫规矩"}, {"start": 45.92, "end": 46.28, "text": "去"}, {"start": 46.48, "end": 47.36, "text": "将信送上去"}, {"start": 48.45, "end": 50.01, "text": "白浅经过保学改造"}, {"start": 50.86, "end": 52.22, "text": "借此离位"}]}