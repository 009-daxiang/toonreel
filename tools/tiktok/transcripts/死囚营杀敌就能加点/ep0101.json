{"file": "死囚营杀敌就能加点-第101集.mp4", "ep": 101, "duration": 62.7, "segments": [{"start": 0.98, "end": 1.66, "text": "沈胖子"}, {"start": 2.41, "end": 5.17, "text": "我这刚进来就听见有人在侮辱我"}, {"start": 6.26, "end": 7.18, "text": "侮辱你"}, {"start": 7.66, "end": 8.94, "text": "我还想打你呢"}, {"start": 9.3, "end": 10.02, "text": "一个月了"}, {"start": 10.26, "end": 11.54, "text": "你的威武营好了"}, {"start": 12.1, "end": 13.62, "text": "但老子的自由身呢"}, {"start": 17.78, "end": 19.1, "text": "你手上拿的是"}, {"start": 19.66, "end": 22.7, "text": "护级登记册"}, {"start": 23.26, "end": 24.21, "text": "真的"}, {"start": 24.73, "end": 26.38, "text": "你猜"}, {"start": 26.94, "end": 31.15, "text": "行了 魏统领"}, {"start": 31.88, "end": 33.48, "text": "都这个时候了你就别逗他了"}, {"start": 34.15, "end": 34.79, "text": "接下来"}, {"start": 34.91, "end": 36.91, "text": "你们只需要将自己的情况说出来"}, {"start": 37.23, "end": 38.91, "text": "我便可以给你们登记再册"}, {"start": 39.58, "end": 40.7, "text": "之后交上去后"}, {"start": 41.18, "end": 42.26, "text": "从此在官方"}, {"start": 42.26, "end": 44.26, "text": "你们便是重新有护级的人了"}, {"start": 46.59, "end": 47.59, "text": "你们谁先来"}, {"start": 47.83, "end": 49.23, "text": "还要提醒你们一点"}, {"start": 50.54, "end": 52.74, "text": "护级不要和之前的一样"}, {"start": 53.06, "end": 54.5, "text": "否则会出现问题"}, {"start": 54.98, "end": 57.06, "text": "最好写一个完全与之前"}, {"start": 57.18, "end": 58.9, "text": "不相干的陌生护级"}]}