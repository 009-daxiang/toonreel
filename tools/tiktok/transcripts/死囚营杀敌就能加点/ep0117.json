{"file": "死囚营杀敌就能加点-第117集.mp4", "ep": 117, "duration": 69.8, "segments": [{"start": 0.0, "end": 1.16, "text": "在讲故事前"}, {"start": 1.92, "end": 3.92, "text": "你得让我先吃饱肚子再说吧"}, {"start": 3.92, "end": 4.56, "text": "你等着"}, {"start": 9.19, "end": 9.71, "text": "给你"}, {"start": 10.19, "end": 10.87, "text": "吃饱了"}, {"start": 10.87, "end": 12.11, "text": "就乖乖给我讲故事"}, {"start": 12.39, "end": 17.22, "text": "怎么这么丰盛"}, {"start": 17.69, "end": 18.89, "text": "本姑娘打的饭"}, {"start": 19.13, "end": 20.33, "text": "当然和别人不一样"}, {"start": 21.6, "end": 22.24, "text": "谢谢了"}, {"start": 22.6, "end": 28.18, "text": "吃饭样子倒顺眼"}, {"start": 28.58, "end": 33.77, "text": "可我是陪嫁的名"}, {"start": 35.18, "end": 37.18, "text": "只求小姐往后夫婿"}, {"start": 37.34, "end": 39.02, "text": "像她这样就够了"}, {"start": 40.19, "end": 40.75, "text": "吃完了"}, {"start": 40.75, "end": 42.11, "text": "可以给我讲故事了吧"}, {"start": 43.07, "end": 43.99, "text": "自然可以了"}, {"start": 45.01, "end": 46.37, "text": "那么请问尤二姑娘"}, {"start": 46.81, "end": 48.21, "text": "你想听什么样的故事"}, {"start": 49.25, "end": 50.73, "text": "你有什么样的故事"}, {"start": 52.94, "end": 54.8, "text": "那可多"}, {"start": 54.8, "end": 55.84, "text": "古代言情"}, {"start": 55.84, "end": 56.88, "text": "先侠言情"}, {"start": 56.88, "end": 57.72, "text": "历史言情"}, {"start": 58.24, "end": 59.56, "text": "又或者东方神话"}, {"start": 59.56, "end": 60.48, "text": "西方魔法"}, {"start": 60.8, "end": 61.64, "text": "历史名著"}, {"start": 61.8, "end": 62.48, "text": "总之"}, {"start": 62.6, "end": 63.28, "text": "你挑一个"}, {"start": 63.4, "end": 64.12, "text": "我都可以"}, {"start": 64.58, "end": 65.86, "text": "你说的那些故事"}, {"start": 65.86, "end": 66.66, "text": "你都有吗"}, {"start": 67.81, "end": 68.37, "text": "都有"}, {"start": 68.98, "end": 69.62, "text": "你挑吧"}]}