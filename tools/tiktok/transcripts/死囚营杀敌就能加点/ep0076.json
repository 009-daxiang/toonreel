{"file": "死囚营杀敌就能加点-第76集.mp4", "ep": 76, "duration": 60.2, "segments": [{"start": 0.14, "end": 1.14, "text": "還等什麼"}, {"start": 1.14, "end": 2.14, "text": "還不給我上"}, {"start": 4.26, "end": 6.26, "text": "殺敵一人獲得屬性"}, {"start": 6.26, "end": 7.26, "text": "零點六八"}, {"start": 8.26, "end": 9.26, "text": "大魔者"}, {"start": 9.26, "end": 10.26, "text": "接屬是"}, {"start": 11.26, "end": 13.26, "text": "六十九啊"}, {"start": 19.06, "end": 20.06, "text": "趕過去支援"}, {"start": 20.06, "end": 21.22, "text": "塔木大公子"}, {"start": 21.22, "end": 23.22, "text": "就會露到對方手上"}, {"start": 23.22, "end": 24.96, "text": "卑鄙"}, {"start": 25.96, "end": 26.96, "text": "你也有臉談卑鄙"}, {"start": 26.96, "end": 28.96, "text": "當初你背叛師門"}, {"start": 28.96, "end": 30.96, "text": "後面敗入塔木部落實"}, {"start": 30.96, "end": 31.96, "text": "怎麼這麼想"}, {"start": 33.18, "end": 35.18, "text": "本來就已經被大前王朝通激"}, {"start": 35.18, "end": 38.18, "text": "如果塔木大王子在我手上出了意外"}, {"start": 38.18, "end": 40.18, "text": "那麼背蠻我也混不下去了"}, {"start": 40.18, "end": 42.18, "text": "好不容易熬了十五年"}, {"start": 42.18, "end": 44.18, "text": "成為塔木大王子的師父"}, {"start": 44.18, "end": 46.18, "text": "將來可能成為塔木部落的王師"}, {"start": 46.18, "end": 48.18, "text": "我怎麼可能就這麼放過"}, {"start": 48.18, "end": 49.18, "text": "小心"}, {"start": 49.18, "end": 50.18, "text": "流言回去了"}]}