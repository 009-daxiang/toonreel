{"file": "死囚营杀敌就能加点-第216集.mp4", "ep": 216, "duration": 64.9, "segments": [{"start": 0.0, "end": 1.32, "text": "厉害啊 哥们"}, {"start": 1.6, "end": 2.52, "text": "五百斤"}, {"start": 2.52, "end": 4.04, "text": "那可是五百斤"}, {"start": 4.36, "end": 5.91, "text": "你们看到了吗"}, {"start": 6.07, "end": 7.55, "text": "他还是一只手举下来了"}, {"start": 7.71, "end": 9.29, "text": "跟我天生神力吧"}, {"start": 9.61, "end": 19.38, "text": "总算明白"}, {"start": 19.38, "end": 20.78, "text": "为何是什么之前正劳"}, {"start": 20.98, "end": 22.58, "text": "唯独夸奖他一个人了"}, {"start": 25.0, "end": 26.56, "text": "是因为人家真的和我们"}, {"start": 26.56, "end": 28.16, "text": "不是一个层次的存在"}, {"start": 29.88, "end": 31.56, "text": "你住了二十顿"}, {"start": 31.56, "end": 33.0, "text": "少一顿都不可以"}, {"start": 34.68, "end": 35.56, "text": "都干什么"}, {"start": 35.72, "end": 36.8, "text": "还不给我散开"}, {"start": 39.06, "end": 40.82, "text": "小子干得不错"}, {"start": 40.98, "end": 42.18, "text": "没给我丢人"}, {"start": 44.16, "end": 45.68, "text": "今天看在这小子的"}, {"start": 45.68, "end": 47.4, "text": "面子上饶你们一次"}, {"start": 47.8, "end": 48.68, "text": "否则"}, {"start": 49.84, "end": 52.12, "text": "接下来的测试就比较特殊了"}, {"start": 52.52, "end": 53.24, "text": "首先"}, {"start": 53.48, "end": 55.2, "text": "我先在这里我先问一句"}, {"start": 55.72, "end": 57.72, "text": "你们之中有谁是舞者"}, {"start": 58.08, "end": 58.56, "text": "大人"}, {"start": 58.72, "end": 59.28, "text": "我是舞者"}, {"start": 59.28, "end": 59.72, "text": "我也是"}, {"start": 59.72, "end": 60.8, "text": "我可是后天八匹"}, {"start": 60.8, "end": 62.16, "text": "我后天就舞行不行"}]}