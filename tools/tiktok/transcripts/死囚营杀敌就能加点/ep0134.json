{"file": "死囚营杀敌就能加点-第134集.mp4", "ep": 134, "duration": 60.1, "segments": [{"start": 0.0, "end": 1.36, "text": "根据我脑海中的记忆"}, {"start": 1.56, "end": 3.0, "text": "这条长街名为龙道"}, {"start": 3.24, "end": 4.24, "text": "全长十公里"}, {"start": 4.4, "end": 5.84, "text": "一路可以延伸至工程"}, {"start": 6.32, "end": 7.76, "text": "宽足足两百二十二米"}, {"start": 8.04, "end": 9.32, "text": "横踪都非常宽广"}, {"start": 9.56, "end": 11.36, "text": "将整个地都分成东西两半"}, {"start": 11.68, "end": 13.72, "text": "大前王朝历代皇帝登基出行"}, {"start": 13.72, "end": 14.84, "text": "都会走这一条道路"}, {"start": 15.58, "end": 18.1, "text": "前世历史盛世大堂的长安城"}, {"start": 19.93, "end": 22.05, "text": "同样有一条历史文明的走道"}, {"start": 22.45, "end": 23.45, "text": "诛阙大道"}, {"start": 25.48, "end": 27.36, "text": "但也仅仅只有五公里长"}, {"start": 28.34, "end": 30.06, "text": "一百五十米宽而已"}, {"start": 30.3, "end": 31.42, "text": "前之君烈"}, {"start": 31.82, "end": 32.82, "text": "汉之微武"}, {"start": 33.42, "end": 34.42, "text": "汤之圣命"}, {"start": 35.16, "end": 36.36, "text": "宋之富裕"}, {"start": 36.76, "end": 38.36, "text": "还有就是明之纲强"}, {"start": 39.73, "end": 41.65, "text": "假如将国家比作人的话"}, {"start": 42.52, "end": 45.0, "text": "大前完全就是拿着完美主角庙吧"}, {"start": 45.58, "end": 46.54, "text": "可惜的是"}, {"start": 47.03, "end": 48.39, "text": "狭义武犯戒"}, {"start": 49.39, "end": 50.39, "text": "后天武者"}, {"start": 50.63, "end": 52.91, "text": "便可一人破百甲而不允命"}, {"start": 54.02, "end": 56.3, "text": "先天武者寿严一百五"}, {"start": 56.58, "end": 59.84, "text": "破千军而不忘"}]}