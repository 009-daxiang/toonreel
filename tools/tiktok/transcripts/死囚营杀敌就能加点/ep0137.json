{"file": "死囚营杀敌就能加点-第137集.mp4", "ep": 137, "duration": 60.1, "segments": [{"start": 4.82, "end": 6.18, "text": "快点快点 来不及了"}, {"start": 6.18, "end": 6.86, "text": "都拿快点"}, {"start": 6.86, "end": 7.98, "text": "这地方待不下去了"}, {"start": 8.94, "end": 9.74, "text": "我们这么做"}, {"start": 10.06, "end": 11.42, "text": "是不是有点过分了"}, {"start": 12.06, "end": 12.82, "text": "过分什么"}, {"start": 13.06, "end": 13.94, "text": "府里快散了"}, {"start": 14.18, "end": 14.94, "text": "不拿白不拿"}, {"start": 14.94, "end": 15.74, "text": "别拿了"}, {"start": 16.45, "end": 17.57, "text": "你们不准拿"}, {"start": 18.4, "end": 19.96, "text": "这些都是府里的东西"}, {"start": 20.24, "end": 21.72, "text": "也都是公子的"}, {"start": 22.66, "end": 23.5, "text": "九儿姑娘"}, {"start": 23.78, "end": 25.1, "text": "你也就别拦我们了"}, {"start": 25.42, "end": 27.58, "text": "我们也是被逼无奈啊"}, {"start": 28.02, "end": 30.46, "text": "是啊"}, {"start": 30.46, "end": 31.54, "text": "现在我们不拿"}, {"start": 31.54, "end": 32.26, "text": "那过了今天"}, {"start": 32.26, "end": 33.34, "text": "这些都是别人的了"}, {"start": 33.74, "end": 34.82, "text": "我劝九儿姑娘"}, {"start": 34.82, "end": 36.34, "text": "你也收拾点东西撤吧"}, {"start": 36.62, "end": 37.54, "text": "这安远伯府"}, {"start": 37.54, "end": 38.98, "text": "已经快要是过去事了"}, {"start": 39.3, "end": 42.16, "text": "这么做就是不对"}, {"start": 42.6, "end": 50.84, "text": "爷爷 看他们"}, {"start": 51.08, "end": 54.78, "text": "走吧 都走吧"}, {"start": 55.34, "end": 56.38, "text": "走得远远的"}, {"start": 56.38, "end": 58.02, "text": "不要再回来了"}]}