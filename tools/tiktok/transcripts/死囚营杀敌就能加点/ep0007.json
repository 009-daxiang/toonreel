{"file": "死囚营杀敌就能加点-第7集.mp4", "ep": 7, "duration": 121.8, "segments": [{"start": 0.0, "end": 2.12, "text": "麻烦道长再为我儿测一测滋质"}, {"start": 2.32, "end": 3.12, "text": "自然"}, {"start": 5.96, "end": 7.64, "text": "道长 我儿滋质"}, {"start": 8.45, "end": 11.01, "text": "薄爷 恕贫道直言"}, {"start": 11.45, "end": 14.77, "text": "令公子天生绝脉无法修行"}, {"start": 15.01, "end": 16.17, "text": "天生绝脉"}, {"start": 16.29, "end": 17.17, "text": "想要修行"}, {"start": 17.17, "end": 18.17, "text": "人体内就需要有"}, {"start": 18.17, "end": 19.61, "text": "可以让真气游走的渠道"}, {"start": 19.77, "end": 21.09, "text": "修行之人称之为脉络"}, {"start": 21.09, "end": 22.41, "text": "而根据贫道检测"}, {"start": 22.41, "end": 24.05, "text": "令公子体内没有这些脉络"}, {"start": 24.05, "end": 25.45, "text": "自然也就无法修行"}, {"start": 25.45, "end": 26.13, "text": "这样啊"}, {"start": 26.25, "end": 27.69, "text": "不能修行就不能修行吧"}, {"start": 27.69, "end": 28.97, "text": "等将来继承我的绝位"}, {"start": 28.97, "end": 30.09, "text": "当个普通人也好"}, {"start": 30.29, "end": 55.06, "text": "狂风刀法"}, {"start": 60.46, "end": 63.5, "text": "主人 礼道 体魄 4.71"}, {"start": 63.74, "end": 65.82, "text": "可用属性 2.13"}, {"start": 71.13, "end": 73.85, "text": "主人 礼道 体魄 6.84"}, {"start": 73.85, "end": 75.41, "text": "可用属性 0"}, {"start": 87.51, "end": 89.15, "text": "获得属性 0.24"}, {"start": 100.5, "end": 102.46, "text": "获得属性 0.24"}, {"start": 102.46, "end": 103.5, "text": "杀敌一人"}, {"start": 103.5, "end": 105.46, "text": "获得属性 0.21"}, {"start": 105.74, "end": 106.7, "text": "杀敌一人"}, {"start": 106.7, "end": 108.66, "text": "获得属性 0.18"}, {"start": 110.78, "end": 111.7, "text": "对面的蛮子"}, {"start": 112.02, "end": 112.98, "text": "局势已定"}, {"start": 113.34, "end": 114.7, "text": "你还不速速投降"}, {"start": 115.58, "end": 116.62, "text": "投降"}, {"start": 116.94, "end": 119.38, "text": "我们北蛮骑兵死不投降"}, {"start": 119.38, "end": 120.54, "text": "杀"}]}