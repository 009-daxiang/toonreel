{"file": "死囚营杀敌就能加点-第52集.mp4", "ep": 52, "duration": 60.1, "segments": [{"start": 0.0, "end": 1.08, "text": "大前王朝的人"}, {"start": 1.08, "end": 1.8, "text": "你们竟然敢偷袭"}, {"start": 1.8, "end": 2.48, "text": "我们塔木部落"}, {"start": 2.48, "end": 3.24, "text": "押运的队伍"}, {"start": 3.24, "end": 4.2, "text": "就不怕我们北蛮"}, {"start": 4.2, "end": 5.72, "text": "和你们大前王朝开战吗"}, {"start": 5.72, "end": 6.44, "text": "开战"}, {"start": 6.44, "end": 6.96, "text": "你别告诉我"}, {"start": 6.96, "end": 8.12, "text": "你不知道你们这一批剑士"}, {"start": 8.12, "end": 8.88, "text": "是用来干什么的"}, {"start": 8.88, "end": 9.6, "text": "还有你所谓的"}, {"start": 9.6, "end": 11.08, "text": "北蛮与大前开战是假的"}, {"start": 11.08, "end": 11.88, "text": "应该是大前与你"}, {"start": 11.88, "end": 12.92, "text": "塔木部落的开战"}, {"start": 12.92, "end": 14.16, "text": "北蛮并不是所有部落"}, {"start": 14.16, "end": 15.08, "text": "都愿意对抗大前"}, {"start": 16.42, "end": 18.1, "text": "猎伙部落的人"}, {"start": 18.1, "end": 19.7, "text": "你们就这样看着吗"}, {"start": 19.7, "end": 21.02, "text": "要记着你们部落的"}, {"start": 21.02, "end": 23.62, "text": "王之前是怎么说的"}, {"start": 23.62, "end": 24.82, "text": "这一次剑士"}, {"start": 24.82, "end": 27.09, "text": "如果有所损失"}, {"start": 27.09, "end": 28.41, "text": "你们猎伙部落"}, {"start": 28.41, "end": 37.38, "text": "也要承担一部分责任"}, {"start": 37.38, "end": 41.1, "text": "天"}, {"start": 41.1, "end": 42.62, "text": "塔山"}, {"start": 42.62, "end": 45.3, "text": "没想到您也有求人的时候"}, {"start": 45.3, "end": 46.61, "text": "猎伙"}, {"start": 46.61, "end": 48.37, "text": "你到底出不出手"}, {"start": 48.37, "end": 48.97, "text": "出"}, {"start": 48.97, "end": 50.17, "text": "当然出"}, {"start": 50.17, "end": 51.97, "text": "不过之前你们塔木部落"}, {"start": 51.97, "end": 53.97, "text": "答应我们猎伙部落的东西"}, {"start": 53.97, "end": 55.21, "text": "需要翻倍"}, {"start": 55.21, "end": 57.21, "text": "你们怎么不去抢"}, {"start": 57.21, "end": 58.01, "text": "抢"}, {"start": 58.01, "end": 60.01, "text": "有敲诈来得快吗"}]}