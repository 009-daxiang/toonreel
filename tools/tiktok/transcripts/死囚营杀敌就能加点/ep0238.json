{"file": "死囚营杀敌就能加点-第238集.mp4", "ep": 238, "duration": 60.1, "segments": [{"start": 4.27, "end": 5.59, "text": "应该就是这里了"}, {"start": 6.04, "end": 7.08, "text": "黄沙漫天"}, {"start": 7.44, "end": 9.04, "text": "连棵树豆库的梅叶子"}, {"start": 9.28, "end": 10.52, "text": "这地方够荒"}, {"start": 10.76, "end": 11.84, "text": "够我折腾了"}, {"start": 12.16, "end": 17.45, "text": "应该是新人吧"}, {"start": 17.81, "end": 18.86, "text": "肯定是了"}, {"start": 19.06, "end": 19.94, "text": "要不然谁愿一个人"}, {"start": 19.94, "end": 21.26, "text": "来这鸟不拉屎的地方"}, {"start": 21.66, "end": 22.7, "text": "那咱们该怎么办"}, {"start": 23.14, "end": 24.58, "text": "谁也不该怎么办"}, {"start": 25.1, "end": 25.82, "text": "叫人吗"}, {"start": 26.34, "end": 32.02, "text": "不用叫"}, {"start": 32.34, "end": 33.46, "text": "既然是新人"}, {"start": 33.58, "end": 35.54, "text": "咱们就先教教他新人的规矩"}, {"start": 35.66, "end": 37.22, "text": "也省得他后面不适应"}, {"start": 37.46, "end": 38.22, "text": "也对"}, {"start": 38.5, "end": 40.62, "text": "叫了他们可能就轮不到我们了"}, {"start": 40.86, "end": 48.94, "text": "来者何人"}, {"start": 49.34, "end": 50.5, "text": "新兵前来入伍"}, {"start": 51.27, "end": 52.35, "text": "新兵"}, {"start": 53.35, "end": 54.63, "text": "我们黄沙镇大营"}, {"start": 54.63, "end": 56.11, "text": "多年没新兵来了"}, {"start": 56.39, "end": 57.99, "text": "你不会是骗我们的吧"}]}