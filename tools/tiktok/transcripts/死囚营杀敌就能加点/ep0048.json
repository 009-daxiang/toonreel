{"file": "死囚营杀敌就能加点-第48集.mp4", "ep": 48, "duration": 69.6, "segments": [{"start": 0.0, "end": 1.24, "text": "所以這一次"}, {"start": 1.64, "end": 3.52, "text": "不僅你們五個人要去"}, {"start": 4.68, "end": 5.84, "text": "我也會帶一部分"}, {"start": 5.84, "end": 7.4, "text": "威武營的人陪你們去"}, {"start": 10.9, "end": 11.7, "text": "很棘手嗎"}, {"start": 14.51, "end": 15.75, "text": "的確有點棘手"}, {"start": 16.47, "end": 17.51, "text": "我得到消息"}, {"start": 18.17, "end": 19.33, "text": "這次押韻的人"}, {"start": 20.44, "end": 22.84, "text": "裡面有一位先天舞者"}, {"start": 23.84, "end": 25.42, "text": "先天舞者"}, {"start": 25.66, "end": 27.02, "text": "你不是開玩笑吧"}, {"start": 27.02, "end": 28.38, "text": "這誰能對付"}, {"start": 29.16, "end": 30.0, "text": "你們放心"}, {"start": 30.68, "end": 33.28, "text": "那名先天並不需要你們動手"}, {"start": 37.07, "end": 38.91, "text": "由我來對付就可以了"}, {"start": 40.32, "end": 41.68, "text": "你是先天"}, {"start": 42.82, "end": 43.54, "text": "怎麼"}, {"start": 44.28, "end": 45.52, "text": "不可以嗎"}, {"start": 50.44, "end": 51.64, "text": "我們想不接"}, {"start": 52.12, "end": 53.12, "text": "但你同意嗎"}, {"start": 53.32, "end": 57.38, "text": "不同意"}, {"start": 58.66, "end": 60.26, "text": "那你還浪費什麼口水"}, {"start": 60.91, "end": 61.99, "text": "九五二七"}, {"start": 62.07, "end": 63.03, "text": "好久不見了"}, {"start": 63.31, "end": 63.99, "text": "劉副長"}, {"start": 64.99, "end": 66.39, "text": "看樣子你們真是穩了"}, {"start": 66.71, "end": 68.31, "text": "不到最後誰知道結果呢"}]}