{"file": "死囚营杀敌就能加点-第249集.mp4", "ep": 249, "duration": 60.1, "segments": [{"start": 0.24, "end": 1.08, "text": "换一条路"}, {"start": 1.32, "end": 2.76, "text": "这哪里还有路能让你走"}, {"start": 2.92, "end": 4.16, "text": "只有这一条路好吧"}, {"start": 5.14, "end": 6.26, "text": "世间本无路"}, {"start": 6.82, "end": 7.62, "text": "走得多了"}, {"start": 8.26, "end": 9.26, "text": "那就变成了路"}, {"start": 11.3, "end": 12.06, "text": "你先走吧"}, {"start": 12.46, "end": 13.18, "text": "不用管我"}, {"start": 19.82, "end": 21.02, "text": "路就在脚下"}, {"start": 21.62, "end": 22.74, "text": "这山壁算什么"}, {"start": 23.27, "end": 24.63, "text": "不过是殿脚十八"}, {"start": 31.18, "end": 32.86, "text": "黄沙阵的骑兵追不上"}, {"start": 41.7, "end": 43.22, "text": "被瞒人越跑越远"}, {"start": 43.7, "end": 44.74, "text": "得换个法子"}, {"start": 45.53, "end": 46.69, "text": "应该能追上吧"}, {"start": 46.81, "end": 51.24, "text": "这身板跑起来比马快"}, {"start": 52.12, "end": 53.16, "text": "起码是对的"}, {"start": 54.83, "end": 56.15, "text": "以我现如今的速度"}, {"start": 57.18, "end": 58.22, "text": "几乎没有什么动物"}, {"start": 58.22, "end": 59.42, "text": "比我跑得更快了"}]}