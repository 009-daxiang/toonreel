{"file": "死囚营杀敌就能加点-第116集.mp4", "ep": 116, "duration": 60.1, "segments": [{"start": 0.0, "end": 1.2, "text": "我不要你的钱了"}, {"start": 6.1, "end": 7.1, "text": "不要钱的话"}, {"start": 7.84, "end": 8.92, "text": "我会很愧疚的"}, {"start": 10.05, "end": 11.25, "text": "那你换种方式"}, {"start": 11.25, "end": 12.25, "text": "偿还车费吧"}, {"start": 13.89, "end": 14.73, "text": "什么方式"}, {"start": 15.17, "end": 17.13, "text": "看你的样子"}, {"start": 17.37, "end": 19.01, "text": "应该是四方游客吧"}, {"start": 21.38, "end": 22.38, "text": "你想说什么"}, {"start": 23.46, "end": 25.5, "text": "那既然你是四方游客"}, {"start": 26.06, "end": 27.98, "text": "那你应该去过很多地方"}, {"start": 28.26, "end": 29.62, "text": "了解到很多故事吧"}, {"start": 30.22, "end": 30.9, "text": "算是吧"}, {"start": 31.52, "end": 33.0, "text": "那你故事讲得好吗"}, {"start": 42.19, "end": 43.15, "text": "应该比较"}, {"start": 43.15, "end": 44.75, "text": "算是擅长抢故事吧"}, {"start": 45.07, "end": 45.71, "text": "真的吗"}, {"start": 46.03, "end": 46.99, "text": "我可告诉你"}, {"start": 47.23, "end": 48.63, "text": "我也听过许多故事呢"}, {"start": 48.91, "end": 49.63, "text": "我保证"}, {"start": 50.07, "end": 51.63, "text": "我的故事没人听过"}, {"start": 52.35, "end": 52.83, "text": "行"}, {"start": 53.31, "end": 54.91, "text": "那本姑娘就信你一次"}, {"start": 55.27, "end": 57.31, "text": "故事好听就不要你车费了"}, {"start": 57.63, "end": 58.59, "text": "要是不好听"}, {"start": 58.71, "end": 59.99, "text": "看本姑娘怎么教训你"}]}