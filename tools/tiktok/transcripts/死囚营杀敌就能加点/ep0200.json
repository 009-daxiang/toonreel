{"file": "死囚营杀敌就能加点-第200集.mp4", "ep": 200, "duration": 56.3, "segments": [{"start": 0.0, "end": 1.6, "text": "别人怕角落汤填命"}, {"start": 2.04, "end": 3.4, "text": "我正缺人命炼手"}, {"start": 8.72, "end": 9.72, "text": "位于那边"}, {"start": 10.34, "end": 11.86, "text": "只能先说声对不住了"}, {"start": 19.27, "end": 19.99, "text": "大同理啊"}, {"start": 20.19, "end": 21.35, "text": "你都先天无辙了"}, {"start": 21.35, "end": 22.39, "text": "还会生病不成"}, {"start": 23.58, "end": 24.82, "text": "先天无辙怎么了"}, {"start": 25.02, "end": 25.86, "text": "那也是人"}, {"start": 26.14, "end": 27.62, "text": "这过去了一个多月了"}, {"start": 28.14, "end": 29.22, "text": "九五二七那家伙"}, {"start": 29.22, "end": 30.74, "text": "应该早已经到地都了吧"}, {"start": 31.22, "end": 32.34, "text": "按时间来算"}, {"start": 32.34, "end": 33.82, "text": "就算慢一点也差不多"}, {"start": 34.62, "end": 35.58, "text": "不知道那家伙"}, {"start": 35.58, "end": 36.74, "text": "什么时候能找过来"}, {"start": 37.48, "end": 38.88, "text": "要是那家伙加入我们"}, {"start": 39.0, "end": 40.04, "text": "威武营的战力"}, {"start": 40.04, "end": 41.12, "text": "得提升一大截"}, {"start": 41.36, "end": 42.84, "text": "你就不怕那家伙不来"}, {"start": 42.84, "end": 43.92, "text": "跑到别人那里去"}, {"start": 44.92, "end": 46.56, "text": "那小子拿着新户籍"}, {"start": 46.72, "end": 48.36, "text": "他以前的关系根本无用"}, {"start": 48.64, "end": 49.6, "text": "除了我们这"}, {"start": 49.76, "end": 51.04, "text": "你说他还能跑去哪"}, {"start": 52.13, "end": 54.09, "text": "希望那家伙能快点回来"}, {"start": 54.45, "end": 56.17, "text": "这边已经有点不安分了"}]}