{"file": "死囚营杀敌就能加点-第113集.mp4", "ep": 113, "duration": 68.3, "segments": [{"start": 0.02, "end": 1.1, "text": "等车队出发"}, {"start": 1.46, "end": 3.3, "text": "你就跟着这辆车走就可以了"}, {"start": 4.91, "end": 5.47, "text": "知道了"}, {"start": 5.75, "end": 7.04, "text": "那个谁"}, {"start": 8.12, "end": 9.28, "text": "原来是游儿姑娘"}, {"start": 9.4, "end": 10.4, "text": "请问有什么事吗"}, {"start": 11.66, "end": 12.94, "text": "小姐让我问你们"}, {"start": 12.94, "end": 14.18, "text": "车队都准备好了吗"}, {"start": 14.85, "end": 15.57, "text": "准备好了"}, {"start": 15.69, "end": 16.93, "text": "我这边随时可以出发"}, {"start": 17.13, "end": 18.01, "text": "请小姐放心"}, {"start": 18.17, "end": 18.89, "text": "那就好"}, {"start": 19.13, "end": 20.25, "text": "要是出了问题"}, {"start": 20.25, "end": 21.69, "text": "小姐可是会问责的"}, {"start": 26.99, "end": 27.83, "text": "这位大哥"}, {"start": 28.19, "end": 29.96, "text": "可否告知这次车队"}, {"start": 30.2, "end": 31.88, "text": "领队的是铁家的哪位"}, {"start": 32.57, "end": 33.57, "text": "你不知道吗"}, {"start": 34.19, "end": 36.07, "text": "我刚从边塞外来到玉门镇"}, {"start": 36.83, "end": 37.79, "text": "那怪不得"}, {"start": 38.61, "end": 40.05, "text": "看见那辆豪华马车没"}, {"start": 40.85, "end": 41.49, "text": "看见了"}, {"start": 41.65, "end": 47.59, "text": "可是坐着铁家三小姐"}, {"start": 47.79, "end": 49.06, "text": "铁三墙"}, {"start": 53.15, "end": 55.79, "text": "铁家老大老二是出了名的废物王库"}, {"start": 56.19, "end": 58.51, "text": "铁三姐十二岁长家天赋异病"}, {"start": 58.87, "end": 61.03, "text": "容貌与明月变成帝都绝美"}, {"start": 62.02, "end": 63.46, "text": "没想到车队是她带的"}, {"start": 63.94, "end": 65.86, "text": "我和她唯一能扯上关系的爹"}, {"start": 66.78, "end": 68.14, "text": "也就因为明月吧"}]}