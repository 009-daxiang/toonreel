{"file": "死囚营杀敌就能加点-第59集.mp4", "ep": 59, "duration": 66.9, "segments": [{"start": 0.0, "end": 0.96, "text": "坏事丑闻"}, {"start": 3.14, "end": 4.86, "text": "我说出来你们可不要乱传"}, {"start": 5.38, "end": 6.34, "text": "放心"}, {"start": 6.74, "end": 9.74, "text": "我江湖称号成石手信小郎君"}, {"start": 10.02, "end": 12.1, "text": "嘴巴出了名的言识"}, {"start": 15.57, "end": 18.25, "text": "传闻在皇室一个多月前的宫宴之上"}, {"start": 18.41, "end": 20.41, "text": "有一位胆大包天之辈"}, {"start": 20.98, "end": 22.74, "text": "闯入皇室宫尾之中"}, {"start": 22.74, "end": 24.82, "text": "坏了一位公主的清白"}, {"start": 29.06, "end": 29.78, "text": "你们继续"}, {"start": 30.06, "end": 31.7, "text": "那这也太大胆了吧"}, {"start": 32.02, "end": 33.02, "text": "敢在皇宫里面"}, {"start": 33.02, "end": 34.54, "text": "挣打光明的睡公主"}, {"start": 34.86, "end": 36.74, "text": "真难我被开磨"}, {"start": 39.96, "end": 41.8, "text": "老大 你没事吧"}, {"start": 41.96, "end": 51.52, "text": "小声点"}, {"start": 51.88, "end": 52.92, "text": "告诉我是谁干的"}, {"start": 52.92, "end": 54.0, "text": "我要杀了他"}, {"start": 54.0, "end": 56.0, "text": "沈三 这和你有什么关系"}, {"start": 56.0, "end": 57.36, "text": "那可是明月公主"}, {"start": 57.36, "end": 58.76, "text": "传闻大前第一大美人"}, {"start": 58.76, "end": 60.16, "text": "我的梦中情人"}, {"start": 60.16, "end": 61.24, "text": "怎么清白就落在一个"}, {"start": 61.24, "end": 62.64, "text": "无耻之徒身上呢"}, {"start": 62.64, "end": 64.4, "text": "你怎么就知道是无耻之徒呢"}, {"start": 64.4, "end": 66.36, "text": "祸乱宫尾当然是无耻之徒"}]}