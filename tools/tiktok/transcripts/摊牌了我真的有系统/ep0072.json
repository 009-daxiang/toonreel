{"file": "摊牌了我真的有系统-第72集.mp4", "ep": 72, "duration": 70.0, "segments": [{"start": 8.46, "end": 9.26, "text": "全家"}, {"start": 12.18, "end": 13.38, "text": "先生 差不多了"}, {"start": 13.74, "end": 15.02, "text": "再砸 人就没了"}, {"start": 15.18, "end": 16.3, "text": "看着他爹被人打"}, {"start": 16.46, "end": 17.18, "text": "谁能忍住"}, {"start": 17.54, "end": 18.9, "text": "况且 这种人渣"}, {"start": 19.06, "end": 19.82, "text": "死不足息"}, {"start": 19.82, "end": 20.7, "text": "先看看老先生"}, {"start": 20.86, "end": 21.62, "text": "赶紧送医院"}, {"start": 21.78, "end": 22.62, "text": "对 对"}, {"start": 22.94, "end": 23.54, "text": "我爸"}, {"start": 23.94, "end": 24.78, "text": "小侧"}, {"start": 25.38, "end": 26.42, "text": "你咋来了"}, {"start": 27.05, "end": 28.01, "text": "别跟他打"}, {"start": 28.49, "end": 29.61, "text": "那人是龙阁"}, {"start": 29.81, "end": 30.81, "text": "咱惹不起"}, {"start": 31.33, "end": 32.09, "text": "爸没事"}, {"start": 32.41, "end": 33.61, "text": "又是装了一下"}, {"start": 34.05, "end": 35.45, "text": "还好 没有大碍"}, {"start": 36.09, "end": 37.77, "text": "但老先生估计之前有旧伤"}, {"start": 37.97, "end": 39.29, "text": "肋骨这边有明显偏异"}, {"start": 39.49, "end": 40.25, "text": "别轻易移动"}, {"start": 40.37, "end": 41.21, "text": "等救援队"}, {"start": 42.01, "end": 43.13, "text": "急救我已经叫了"}, {"start": 43.49, "end": 45.09, "text": "看状牌应该没刺破脏气"}, {"start": 45.21, "end": 45.93, "text": "静养能好"}, {"start": 45.93, "end": 47.13, "text": "姐 王哥"}, {"start": 47.57, "end": 48.33, "text": "谢谢你们"}, {"start": 48.53, "end": 53.93, "text": "龙哥都敢动"}, {"start": 54.13, "end": 54.81, "text": "给我打"}, {"start": 54.97, "end": 56.57, "text": "出了事 龙哥给你们斗敌"}, {"start": 56.85, "end": 60.82, "text": "你"}]}