{"file": "觉醒伪神：神明弃我我自为神8-第35集.mp4", "ep": 35, "duration": 50.0, "segments": [{"start": 0.0, "end": 1.0, "text": "我都怕孫座"}, {"start": 1.0, "end": 2.0, "text": "爬出來踩你兩舊塞"}, {"start": 2.0, "end": 3.0, "text": "浩兒 走了"}, {"start": 4.0, "end": 6.26, "text": "今日有幸見世神座神威"}, {"start": 6.26, "end": 7.26, "text": "天外有天"}, {"start": 7.26, "end": 8.26, "text": "陳浩宇受教了"}, {"start": 8.26, "end": 9.26, "text": "勞煩告知我家那位"}, {"start": 9.26, "end": 11.26, "text": "等我去神堂接她回家"}, {"start": 12.26, "end": 14.29, "text": "神堂就是她的家"}, {"start": 15.29, "end": 16.8, "text": "回"}, {"start": 16.8, "end": 17.8, "text": "走"}, {"start": 17.8, "end": 18.8, "text": "走"}, {"start": 18.8, "end": 19.8, "text": "我帶路"}, {"start": 19.8, "end": 20.8, "text": "大帥還在等諸位"}, {"start": 20.8, "end": 21.8, "text": "先過去再說"}, {"start": 21.8, "end": 22.8, "text": "還能走嗎"}, {"start": 22.8, "end": 24.06, "text": "能"}, {"start": 24.06, "end": 25.06, "text": "跟進師姐"}, {"start": 25.06, "end": 26.06, "text": "先離開這裡"}, {"start": 26.06, "end": 27.06, "text": "其他事回去再說"}, {"start": 27.06, "end": 28.06, "text": "大忙 跟上"}, {"start": 28.06, "end": 29.06, "text": "別落在後面"}, {"start": 29.06, "end": 31.31, "text": "桃桃 跟我們一起走"}, {"start": 31.31, "end": 32.31, "text": "你怎麼不動"}, {"start": 32.31, "end": 33.31, "text": "別一個人留在這裡"}, {"start": 34.31, "end": 35.82, "text": "我得留下"}, {"start": 35.82, "end": 38.55, "text": "神座會欠諾你"}, {"start": 39.84, "end": 40.84, "text": "你帶不走她"}, {"start": 40.84, "end": 41.84, "text": "從頭計時"}, {"start": 43.19, "end": 44.19, "text": "都坐穩了"}, {"start": 44.19, "end": 45.19, "text": "離開這裡再說"}, {"start": 46.19, "end": 47.19, "text": "怎麼了"}, {"start": 47.19, "end": 48.19, "text": "剛才不是都挺牛的嗎"}]}