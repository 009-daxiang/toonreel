{"file": "觉醒伪神：神明弃我我自为神8-第85集.mp4", "ep": 85, "duration": 50.1, "segments": [{"start": 0.0, "end": 0.56, "text": "难堪"}, {"start": 1.08, "end": 2.28, "text": "跟赖哈马蹦带一样"}, {"start": 2.68, "end": 4.52, "text": "有机会让你瞧瞧老子老家的阴歌舞"}, {"start": 4.6, "end": 5.92, "text": "专破这些牛鬼神神"}, {"start": 6.0, "end": 6.6, "text": "行啊"}, {"start": 6.68, "end": 7.48, "text": "到时候你跳"}, {"start": 7.48, "end": 8.56, "text": "老子给你敲锣"}, {"start": 11.56, "end": 20.67, "text": "这下骨子民敢玩阴的"}, {"start": 23.19, "end": 23.87, "text": "天上"}, {"start": 24.03, "end": 25.35, "text": "这些该死的阴族"}, {"start": 27.16, "end": 28.04, "text": "真恶心"}, {"start": 28.44, "end": 29.36, "text": "强攻不下"}, {"start": 29.6, "end": 31.08, "text": "拿百姓当党箭牌"}, {"start": 31.24, "end": 31.76, "text": "师帅"}, {"start": 31.92, "end": 32.44, "text": "打不打"}, {"start": 33.4, "end": 34.96, "text": "他们果然不敢开火"}, {"start": 35.12, "end": 35.88, "text": "下骨人"}, {"start": 36.0, "end": 37.56, "text": "你们不是以民为先吗"}, {"start": 37.76, "end": 39.76, "text": "敢不敢对着自己的人开火"}, {"start": 40.2, "end": 41.8, "text": "快走 老家伙"}, {"start": 42.91, "end": 43.79, "text": "开火"}, {"start": 43.91, "end": 45.63, "text": "你们不是很厉害吗"}, {"start": 46.77, "end": 47.49, "text": "下骨人"}, {"start": 47.69, "end": 48.61, "text": "做好准备吧"}, {"start": 48.81, "end": 49.69, "text": "老子来了"}]}