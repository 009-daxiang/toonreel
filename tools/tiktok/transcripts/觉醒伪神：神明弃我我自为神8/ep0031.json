{"file": "觉醒伪神：神明弃我我自为神8-第31集.mp4", "ep": 31, "duration": 50.1, "segments": [{"start": 0.0, "end": 2.0, "text": "他先邀你再贈神通"}, {"start": 2.0, "end": 4.0, "text": "外人只会觉得你不是好歹"}, {"start": 4.0, "end": 6.0, "text": "他敢在大庭广众之下对我动手"}, {"start": 6.0, "end": 8.0, "text": "拒绝加入不要紧"}, {"start": 8.0, "end": 9.0, "text": "可你提升神鹰的本事"}, {"start": 9.0, "end": 11.0, "text": "威胁到了神堂地位"}, {"start": 11.0, "end": 12.0, "text": "这才是他不肯放手的原因"}, {"start": 12.0, "end": 14.0, "text": "没触碰利益他们才合言乐色"}, {"start": 14.0, "end": 16.0, "text": "没有强硬手段哪来如今地位"}, {"start": 16.0, "end": 18.0, "text": "现在拒绝他真可能出手"}, {"start": 18.0, "end": 19.0, "text": "小浩"}, {"start": 19.0, "end": 20.0, "text": "放心"}, {"start": 20.0, "end": 21.0, "text": "我只封你一种神通"}, {"start": 21.0, "end": 22.0, "text": "绝不会伤你半分"}, {"start": 22.0, "end": 23.0, "text": "楚狂人不是做宝了吗"}, {"start": 23.0, "end": 24.0, "text": "这么久没动静"}, {"start": 24.0, "end": 25.0, "text": "怎么偏偏惊天天"}, {"start": 25.0, "end": 26.0, "text": "同意加入"}, {"start": 26.0, "end": 27.0, "text": "就跟楚狂人一样受限制"}, {"start": 27.0, "end": 28.0, "text": "他才放心"}, {"start": 28.0, "end": 29.0, "text": "我家老头子说的对"}, {"start": 29.0, "end": 31.0, "text": "这些大佬一个比一个小心眼"}, {"start": 31.0, "end": 32.0, "text": "小浩"}, {"start": 32.0, "end": 35.0, "text": "你一天神通与你试获不是福"}, {"start": 35.0, "end": 37.0, "text": "本座替你封印他"}, {"start": 37.0, "end": 38.0, "text": "是为你好"}, {"start": 38.0, "end": 39.0, "text": "花师姐"}, {"start": 39.0, "end": 40.0, "text": "带老齐先走"}, {"start": 40.0, "end": 41.0, "text": "别管我们"}, {"start": 41.0, "end": 42.0, "text": "护着他走"}, {"start": 42.0, "end": 43.0, "text": "列丰迎"}, {"start": 43.0, "end": 44.0, "text": "邪小小"}, {"start": 44.0, "end": 45.0, "text": "见过神座大人"}, {"start": 45.0, "end": 46.0, "text": "列丰迎"}, {"start": 46.0, "end": 47.0, "text": "封列的人来了"}]}