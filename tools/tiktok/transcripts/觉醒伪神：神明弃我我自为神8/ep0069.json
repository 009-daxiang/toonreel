{"file": "觉醒伪神：神明弃我我自为神8-第69集.mp4", "ep": 69, "duration": 50.1, "segments": [{"start": 2.1, "end": 3.66, "text": "我只要大好男儿"}, {"start": 3.66, "end": 5.13, "text": "不不决生死"}, {"start": 5.13, "end": 7.53, "text": "只怕护不住龙牧城"}, {"start": 7.53, "end": 9.81, "text": "亏对城中数万老若复命"}, {"start": 9.81, "end": 11.61, "text": "亏对风帅嘱托"}, {"start": 11.61, "end": 13.99, "text": "你动手吧"}, {"start": 13.99, "end": 16.19, "text": "我该上路了"}, {"start": 16.19, "end": 19.43, "text": "千老去的命"}, {"start": 19.43, "end": 20.74, "text": "我还你"}, {"start": 20.74, "end": 22.02, "text": "女王"}, {"start": 22.02, "end": 23.62, "text": "让我最后"}, {"start": 23.62, "end": 25.74, "text": "看一眼故乡的皇上"}, {"start": 25.74, "end": 26.9, "text": "看一眼"}, {"start": 26.9, "end": 29.34, "text": "我下过的大好河山吧"}, {"start": 29.34, "end": 30.54, "text": "若是平时"}, {"start": 30.54, "end": 32.74, "text": "老子就算死也抱着你上路"}, {"start": 32.74, "end": 33.98, "text": "可龙牧城里"}, {"start": 34.22, "end": 36.1, "text": "云民抱着一组跳城墙"}, {"start": 36.1, "end": 38.62, "text": "腐褥顶着炮火往城头送饭"}, {"start": 38.62, "end": 39.65, "text": "那一刻"}, {"start": 39.65, "end": 40.65, "text": "我觉得"}, {"start": 40.65, "end": 42.29, "text": "那都真无趣"}, {"start": 42.29, "end": 43.05, "text": "快点吧"}, {"start": 43.05, "end": 43.89, "text": "老子"}, {"start": 43.89, "end": 44.93, "text": "累了"}, {"start": 44.93, "end": 46.81, "text": "你以为老子不想杀你"}, {"start": 46.81, "end": 48.25, "text": "老许说过"}, {"start": 48.25, "end": 50.05, "text": "为家国大义而死者"}]}