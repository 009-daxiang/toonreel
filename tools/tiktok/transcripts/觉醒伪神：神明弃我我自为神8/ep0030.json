{"file": "觉醒伪神：神明弃我我自为神8-第30集.mp4", "ep": 30, "duration": 50.1, "segments": [{"start": 0.0, "end": 1.36, "text": "太远 我云船"}, {"start": 1.52, "end": 2.16, "text": "混账"}, {"start": 2.16, "end": 3.56, "text": "侮辱神堂 蟹毒神明"}, {"start": 3.56, "end": 4.84, "text": "还敢拒绝神作好意"}, {"start": 4.96, "end": 6.08, "text": "若无楚狂人做宝"}, {"start": 6.08, "end": 6.88, "text": "你早死了"}, {"start": 7.0, "end": 7.96, "text": "没有神明受益"}, {"start": 7.96, "end": 9.6, "text": "善改神印就是侮辱神明"}, {"start": 9.6, "end": 10.12, "text": "怎么"}, {"start": 10.24, "end": 10.88, "text": "不服气"}, {"start": 11.08, "end": 12.8, "text": "不服气你也认楚狂人当爹啊"}, {"start": 12.96, "end": 14.4, "text": "父亲还受契约限制"}, {"start": 14.48, "end": 15.6, "text": "卫生也不能暴露"}, {"start": 15.88, "end": 16.8, "text": "现在进去"}, {"start": 16.88, "end": 18.12, "text": "我拿什么带父亲出来"}, {"start": 18.24, "end": 18.92, "text": "无妨"}, {"start": 19.08, "end": 20.24, "text": "玉牌不收回"}, {"start": 20.44, "end": 21.68, "text": "苏泽已告诉了我"}, {"start": 21.76, "end": 23.04, "text": "楚狂人为你做宝"}, {"start": 23.24, "end": 24.48, "text": "神堂不会追究"}, {"start": 24.6, "end": 25.28, "text": "不过"}, {"start": 25.36, "end": 26.88, "text": "神印乃神明所赐"}, {"start": 27.04, "end": 28.2, "text": "你善改神印"}, {"start": 28.36, "end": 29.88, "text": "终究是对神明不敬"}, {"start": 30.24, "end": 32.24, "text": "本座赐你三种世间绝绝"}, {"start": 32.36, "end": 33.28, "text": "作为交换"}, {"start": 33.44, "end": 35.32, "text": "封印你替换神印的手段"}, {"start": 35.48, "end": 36.84, "text": "凡我神堂所有"}, {"start": 37.0, "end": 37.84, "text": "我无不云"}, {"start": 37.96, "end": 38.56, "text": "别拒绝"}, {"start": 38.56, "end": 39.24, "text": "先别开口"}, {"start": 39.24, "end": 40.2, "text": "真让他封印我"}, {"start": 40.56, "end": 42.16, "text": "谁知道那封印会留下什么"}, {"start": 42.6, "end": 43.68, "text": "邀你入神堂"}, {"start": 43.68, "end": 44.8, "text": "是想暗中软迹"}, {"start": 44.88, "end": 46.12, "text": "便想封住你的手段"}, {"start": 46.36, "end": 47.32, "text": "你刚才拒绝"}, {"start": 47.32, "end": 48.28, "text": "他就换个办法"}, {"start": 48.52, "end": 49.32, "text": "再拒绝"}, {"start": 49.32, "end": 50.24, "text": "他出手也有事"}]}