{"file": "觉醒伪神：神明弃我我自为神8-第180集.mp4", "ep": 180, "duration": 50.1, "segments": [{"start": 0.0, "end": 1.32, "text": "愿为夏国而战"}, {"start": 1.48, "end": 2.76, "text": "花招不善战斗"}, {"start": 3.16, "end": 4.16, "text": "后勤辅助"}, {"start": 4.44, "end": 5.32, "text": "交给我们"}, {"start": 6.0, "end": 6.6, "text": "多谢"}, {"start": 7.12, "end": 7.84, "text": "这一拜"}, {"start": 8.77, "end": 9.69, "text": "替夏国"}, {"start": 14.23, "end": 15.51, "text": "真想弄死我"}, {"start": 15.51, "end": 16.31, "text": "不知道啊"}, {"start": 16.51, "end": 17.35, "text": "发生了什么"}, {"start": 17.51, "end": 18.07, "text": "谷哥"}, {"start": 18.23, "end": 19.35, "text": "你脸咋流血了"}, {"start": 19.47, "end": 20.43, "text": "大姨父来了"}, {"start": 20.75, "end": 22.27, "text": "你不是想饿我们吧"}, {"start": 24.55, "end": 25.03, "text": "爷"}, {"start": 25.15, "end": 26.51, "text": "咱们啥时候回来啊"}, {"start": 26.59, "end": 27.91, "text": "能赶上我开学部"}, {"start": 30.56, "end": 31.28, "text": "快乐"}, {"start": 31.48, "end": 33.25, "text": "等打跑了那些杂碎"}, {"start": 33.37, "end": 34.37, "text": "咱们就回家"}, {"start": 34.53, "end": 35.25, "text": "那是"}, {"start": 35.41, "end": 37.53, "text": "爹爹说咱们的战士天下无双"}, {"start": 37.65, "end": 38.37, "text": "大哥哥"}, {"start": 38.49, "end": 39.61, "text": "你们一定会赢的"}, {"start": 39.93, "end": 40.81, "text": "等我长大了"}, {"start": 40.93, "end": 42.29, "text": "也要像你一样当战士"}, {"start": 42.29, "end": 43.21, "text": "保家卫国"}, {"start": 44.41, "end": 45.25, "text": "从现在起"}, {"start": 45.41, "end": 45.97, "text": "你就是我们"}, {"start": 45.97, "end": 47.09, "text": "城防军的小战士了"}, {"start": 47.21, "end": 48.17, "text": "好好保护你爷爷"}, {"start": 48.17, "end": 48.77, "text": "遵命"}]}