{"file": "御狐-第190集.mp4", "ep": 190, "duration": 48.9, "segments": [{"start": 2.54, "end": 3.54, "text": "储师弟"}, {"start": 3.82, "end": 5.82, "text": "要不这次大笔你就别参加了"}, {"start": 5.82, "end": 7.26, "text": "先养好伤药劲"}, {"start": 7.26, "end": 8.38, "text": "是啊少爷"}, {"start": 8.38, "end": 10.74, "text": "反正你已经被丹阳子长老收尾弟子了"}, {"start": 10.74, "end": 12.38, "text": "11年在今外门也没什么"}, {"start": 12.38, "end": 14.5, "text": "离重新举办大笔还有一段时间"}, {"start": 14.96, "end": 16.52, "text": "我的伤还能再好一些"}, {"start": 16.52, "end": 18.28, "text": "到时候再看能不能参加"}, {"start": 19.44, "end": 20.24, "text": "好吧"}, {"start": 20.48, "end": 21.76, "text": "那你好好养伤"}, {"start": 21.76, "end": 23.24, "text": "千万别勉强自己"}, {"start": 23.24, "end": 24.64, "text": "我们就先走了"}, {"start": 24.64, "end": 38.6, "text": "师弟"}, {"start": 38.6, "end": 39.68, "text": "喝药了"}, {"start": 39.68, "end": 40.72, "text": "师姐"}, {"start": 41.26, "end": 42.62, "text": "今天还有几晚"}, {"start": 42.62, "end": 43.78, "text": "最后一晚了"}, {"start": 43.78, "end": 44.74, "text": "里面加了蜜"}, {"start": 44.74, "end": 45.62, "text": "没那么苦"}]}