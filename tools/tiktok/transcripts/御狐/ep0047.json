{"file": "御狐-第47集.mp4", "ep": 47, "duration": 50.8, "segments": [{"start": 0.37, "end": 16.96, "text": "少爷"}, {"start": 16.96, "end": 18.56, "text": "你这赏怎么回事"}, {"start": 18.56, "end": 22.92, "text": "敷了伤药已经好多了"}, {"start": 22.92, "end": 24.92, "text": "那你今天可多吃点补补"}, {"start": 24.92, "end": 26.42, "text": "特意给你打的"}, {"start": 26.42, "end": 31.77, "text": "你契约第二只灵兽的事情如何了"}, {"start": 31.77, "end": 33.27, "text": "如果找不到合适的"}, {"start": 33.27, "end": 41.74, "text": "我明日可以你一起找"}, {"start": 41.74, "end": 43.74, "text": "少爷那可真够厉害的"}, {"start": 43.74, "end": 45.24, "text": "只不过这是啥品种"}, {"start": 45.24, "end": 46.24, "text": "俺怎么没印象"}, {"start": 46.24, "end": 47.24, "text": "别出"}]}