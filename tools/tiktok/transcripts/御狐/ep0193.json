{"file": "御狐-第193集.mp4", "ep": 193, "duration": 49.7, "segments": [{"start": 1.14, "end": 2.34, "text": "抱歉師父"}, {"start": 2.34, "end": 4.64, "text": "剛才雪屋領悟了敗月技能"}, {"start": 4.64, "end": 5.64, "text": "好"}, {"start": 5.64, "end": 7.14, "text": "真是敗月"}, {"start": 7.14, "end": 16.99, "text": "確實是敗月"}, {"start": 16.99, "end": 18.99, "text": "這隻無垢不天賦不錯"}, {"start": 18.99, "end": 21.94, "text": "師父"}, {"start": 21.94, "end": 24.05, "text": "您這是怎麼了"}, {"start": 24.05, "end": 26.55, "text": "維師的事輪不到你管"}, {"start": 26.55, "end": 28.0, "text": "師父"}, {"start": 28.0, "end": 33.0, "text": "弟子給您包扎一下吧"}, {"start": 33.0, "end": 39.32, "text": "包吧"}, {"start": 39.32, "end": 40.32, "text": "是用枝腳掐出來的"}, {"start": 40.32, "end": 42.32, "text": "初見之時也剛好是滿月"}, {"start": 42.32, "end": 44.32, "text": "師父也是手纏著繃帶"}, {"start": 44.32, "end": 45.32, "text": "一領皮色"}, {"start": 45.32, "end": 47.73, "text": "難道丹陽子每逢滿月"}, {"start": 47.73, "end": 49.73, "text": "體內的藥膏都會發作"}]}