{"file": "御狐-第1集.mp4", "ep": 1, "duration": 205.8, "segments": [{"start": 0.0, "end": 1.4, "text": "泰谷之初"}, {"start": 1.4, "end": 3.8, "text": "诸多灵兽行走于世间"}, {"start": 3.8, "end": 5.8, "text": "与强大的人类结器"}, {"start": 5.8, "end": 7.2, "text": "玉兽之人"}, {"start": 7.2, "end": 8.8, "text": "誓称灵褚"}, {"start": 8.8, "end": 10.6, "text": "灵褚血脉传承"}, {"start": 10.6, "end": 12.2, "text": "生来半身灵褚"}, {"start": 12.2, "end": 13.8, "text": "分世世间长大"}, {"start": 13.8, "end": 15.2, "text": "可天命疏遇"}, {"start": 15.2, "end": 16.8, "text": "极少数灵褚与灵褚"}, {"start": 16.8, "end": 19.0, "text": "伸出超越契约的共鸣"}, {"start": 19.0, "end": 20.6, "text": "二者同修共生"}, {"start": 20.6, "end": 23.0, "text": "血量相对不断的"}, {"start": 23.6, "end": 40.83, "text": "也对不起你"}, {"start": 40.83, "end": 69.77, "text": "保护少主"}, {"start": 69.77, "end": 98.23, "text": "什么叫半生"}, {"start": 98.23, "end": 110.33, "text": "我命灵褚翻天网"}, {"start": 110.33, "end": 111.53, "text": "突破九阶了"}, {"start": 111.53, "end": 144.11, "text": "有出真是好生凶猛"}, {"start": 144.11, "end": 145.11, "text": "再成长几年"}, {"start": 145.11, "end": 147.11, "text": "估计就能变成一阶灵兽"}, {"start": 147.11, "end": 157.17, "text": "双玉"}, {"start": 157.17, "end": 158.17, "text": "你看到了吗"}, {"start": 158.17, "end": 162.25, "text": "少主你又进步了"}, {"start": 162.25, "end": 164.66, "text": "以此深城山川溃增"}, {"start": 164.66, "end": 167.42, "text": "以此婚敬万灵归夕"}, {"start": 167.42, "end": 169.78, "text": "感谢自然生灵溃增"}, {"start": 171.0, "end": 175.02, "text": "不过十六岁"}, {"start": 175.02, "end": 177.38, "text": "还未觉醒便已能感应灵力"}, {"start": 177.38, "end": 179.13, "text": "用出战迹"}, {"start": 179.13, "end": 180.33, "text": "这天赋"}, {"start": 180.33, "end": 181.79, "text": "实在可怕"}, {"start": 181.79, "end": 183.14, "text": "说起来"}, {"start": 183.14, "end": 184.14, "text": "今天便是镇上"}, {"start": 184.14, "end": 185.14, "text": "举办本命灵兽"}, {"start": 185.14, "end": 186.74, "text": "觉醒仪式的日子"}, {"start": 187.94, "end": 188.94, "text": "少主不知不觉"}, {"start": 188.94, "end": 190.94, "text": "也到了这个年纪了"}, {"start": 190.94, "end": 191.94, "text": "你答应过"}, {"start": 191.94, "end": 194.39, "text": "等我成功觉醒"}, {"start": 194.39, "end": 195.39, "text": "就告诉我"}, {"start": 195.39, "end": 196.62, "text": "我的身世吧"}, {"start": 196.62, "end": 198.38, "text": "我会的"}]}