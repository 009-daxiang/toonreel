{"file": "御狐-第238集.mp4", "ep": 238, "duration": 45.9, "segments": [{"start": 0.0, "end": 2.45, "text": "戴着她滚"}, {"start": 6.45, "end": 9.76, "text": "今日之事你们都看到了"}, {"start": 9.76, "end": 11.76, "text": "像汪植这样残害同门"}, {"start": 11.76, "end": 17.95, "text": "心思歹毒之人"}, {"start": 17.95, "end": 19.95, "text": "我赤肖宗必不能留"}, {"start": 19.95, "end": 21.95, "text": "诸位引以为戒"}, {"start": 21.95, "end": 23.95, "text": "谨遵宗主教诲"}, {"start": 23.95, "end": 25.95, "text": "你叫楚少也是吧"}, {"start": 25.95, "end": 27.95, "text": "刚才可有受伤"}, {"start": 27.95, "end": 33.44, "text": "谢宗主关心"}, {"start": 33.44, "end": 35.44, "text": "弟子无事"}, {"start": 35.44, "end": 37.44, "text": "容霞"}, {"start": 37.44, "end": 39.44, "text": "你作为裁判"}, {"start": 39.44, "end": 41.44, "text": "却出了如此大的疏漏"}, {"start": 41.44, "end": 43.44, "text": "可知罪"}]}