{"file": "御狐-第11集.mp4", "ep": 11, "duration": 79.0, "segments": [{"start": 0.27, "end": 1.27, "text": "终于到了"}, {"start": 1.79, "end": 2.75, "text": "赤销宗"}, {"start": 13.24, "end": 14.0, "text": "见过前辈"}, {"start": 18.02, "end": 19.02, "text": "这是我的推荐信"}, {"start": 19.3, "end": 20.3, "text": "来赤销宗报道"}, {"start": 20.82, "end": 23.74, "text": "你就是陆师弟信中提到的楚少爷"}, {"start": 24.7, "end": 26.94, "text": "倒是气质沉稳的好少年"}, {"start": 27.34, "end": 29.54, "text": "可惜本命灵兽无够糊"}, {"start": 29.7, "end": 31.58, "text": "终身无法突破三阶"}, {"start": 32.06, "end": 34.14, "text": "终究敏然众人意"}, {"start": 34.7, "end": 35.58, "text": "可叹"}, {"start": 36.05, "end": 37.81, "text": "老夫名唤方青山"}, {"start": 38.05, "end": 39.89, "text": "是赤销宗的外门管事"}, {"start": 40.29, "end": 41.49, "text": "晚辈见过方管事"}, {"start": 41.77, "end": 43.21, "text": "你来的倒是巧"}, {"start": 43.82, "end": 45.66, "text": "赶上我外出归来的时候"}, {"start": 46.28, "end": 47.24, "text": "跟我来吧"}, {"start": 50.58, "end": 51.42, "text": "四季灵兽"}, {"start": 51.66, "end": 52.58, "text": "朱鼎宇贺"}, {"start": 54.07, "end": 56.07, "text": "小子都是有些见识"}, {"start": 56.35, "end": 57.03, "text": "上来吧"}, {"start": 71.31, "end": 72.07, "text": "不用怕"}, {"start": 72.59, "end": 75.27, "text": "丹于有护体灵力不会让你掉下去"}]}