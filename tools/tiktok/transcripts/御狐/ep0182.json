{"file": "御狐-第182集.mp4", "ep": 182, "duration": 58.5, "segments": [{"start": 7.06, "end": 8.46, "text": "禀告清基大人"}, {"start": 8.46, "end": 9.46, "text": "洪基大人"}, {"start": 9.46, "end": 12.46, "text": "已确认宗主闭关之地未受剥击"}, {"start": 12.46, "end": 15.86, "text": "只是这杂役损失严重"}, {"start": 15.86, "end": 17.39, "text": "此次大笔"}, {"start": 17.39, "end": 19.66, "text": "经一日一夜的排查"}, {"start": 19.66, "end": 21.74, "text": "共确认弟子死亡"}, {"start": 21.74, "end": 23.34, "text": "一百二十一人"}, {"start": 23.34, "end": 25.14, "text": "重伤五十二人"}, {"start": 25.14, "end": 27.34, "text": "轻伤三百七十八人"}, {"start": 27.34, "end": 30.34, "text": "另有八百零六人至今下落不明"}, {"start": 30.34, "end": 32.94, "text": "大多死于寿朝和帝列"}, {"start": 32.94, "end": 35.34, "text": "若非我等旨意更改大笔规则"}, {"start": 35.34, "end": 36.94, "text": "开启秘境"}, {"start": 37.14, "end": 40.15, "text": "或许便不会有此结束"}, {"start": 40.15, "end": 42.21, "text": "姐姐不必自觉"}, {"start": 42.21, "end": 44.0, "text": "即便没有大笔"}, {"start": 44.0, "end": 46.8, "text": "那百足无功既已至突破边缘"}, {"start": 46.8, "end": 49.13, "text": "迟早也会破风而出"}, {"start": 49.13, "end": 50.13, "text": "况且"}, {"start": 50.13, "end": 53.49, "text": "内门外门可是我赤销宗中留底柱"}, {"start": 53.49, "end": 55.29, "text": "杂役损失些所"}, {"start": 55.29, "end": 56.69, "text": "日后广开山门"}, {"start": 56.69, "end": 58.29, "text": "纳补新缘便是"}]}