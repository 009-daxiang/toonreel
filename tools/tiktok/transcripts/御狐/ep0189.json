{"file": "御狐-第189集.mp4", "ep": 189, "duration": 50.5, "segments": [{"start": 2.9, "end": 3.58, "text": "请坐"}, {"start": 6.03, "end": 7.67, "text": "阿门遭盼着过来超超你来"}, {"start": 7.67, "end": 9.43, "text": "可这是胆样子长老的住处"}, {"start": 9.43, "end": 10.23, "text": "不便等闷"}, {"start": 10.59, "end": 11.99, "text": "竟然碰上短目使节"}, {"start": 11.99, "end": 13.47, "text": "才央着他令阿门过来来"}, {"start": 14.14, "end": 15.42, "text": "这次害你们担心了"}, {"start": 15.74, "end": 16.3, "text": "少爷"}, {"start": 16.3, "end": 17.98, "text": "我们不仅是同门也是朋友"}, {"start": 17.98, "end": 19.22, "text": "担心你是应该的"}, {"start": 19.22, "end": 20.26, "text": "如今看到你没事"}, {"start": 20.26, "end": 21.1, "text": "我们就放心了"}, {"start": 21.42, "end": 22.74, "text": "这几日我都在养伤"}, {"start": 22.98, "end": 24.38, "text": "宗门内现在如何了"}, {"start": 24.7, "end": 26.14, "text": "赤销大笔还在继续吗"}, {"start": 26.3, "end": 27.74, "text": "这次宗门损失惨重"}, {"start": 27.94, "end": 29.26, "text": "需要修养一段时间"}, {"start": 29.5, "end": 30.86, "text": "赤销大笔才会继续"}, {"start": 31.1, "end": 32.94, "text": "但现在三阶试炼常毁了"}, {"start": 32.94, "end": 33.82, "text": "应该会附用"}, {"start": 33.82, "end": 34.98, "text": "以前的比赛方式"}, {"start": 35.26, "end": 36.34, "text": "倒是你储师弟"}, {"start": 36.7, "end": 37.98, "text": "你这次立了大功了"}, {"start": 38.26, "end": 40.5, "text": "宗门内原本因为百族无功的事"}, {"start": 40.5, "end": 41.5, "text": "人心惶惶"}, {"start": 41.74, "end": 43.3, "text": "知道百族无功死了后"}, {"start": 43.3, "end": 44.42, "text": "大家才安下心"}, {"start": 45.37, "end": 46.01, "text": "这没什么"}, {"start": 46.49, "end": 48.49, "text": "赤销大笔能继续举行就好"}]}