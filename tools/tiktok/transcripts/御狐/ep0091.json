{"file": "御狐-第91集.mp4", "ep": 91, "duration": 54.9, "segments": [{"start": 0.0, "end": 1.08, "text": "还挺狡猾"}, {"start": 1.28, "end": 3.04, "text": "居然知道提前留下气味"}, {"start": 3.48, "end": 4.68, "text": "楚师弟没事"}, {"start": 4.92, "end": 5.92, "text": "我都追半年了"}, {"start": 5.92, "end": 6.96, "text": "连跟毛美磨倒"}, {"start": 7.4, "end": 8.52, "text": "你抓不着也正常"}, {"start": 9.24, "end": 10.36, "text": "只是奇怪"}, {"start": 10.6, "end": 11.96, "text": "这只灵兽最近偷灵草"}, {"start": 11.96, "end": 12.84, "text": "次数变多了"}, {"start": 13.32, "end": 14.88, "text": "以前一天不会来第二次"}, {"start": 15.28, "end": 17.4, "text": "看来这只灵兽最近很需要灵期"}, {"start": 17.68, "end": 18.72, "text": "是要进阶了吗"}, {"start": 19.67, "end": 20.47, "text": "师兄放心"}, {"start": 20.71, "end": 29.79, "text": "三阶木属性灵丹"}, {"start": 29.79, "end": 31.47, "text": "原来楚师弟还是个傅家子"}, {"start": 31.47, "end": 32.59, "text": "身藏不漏"}, {"start": 32.79, "end": 33.95, "text": "如果我猜得没错"}, {"start": 34.31, "end": 36.43, "text": "这只灵兽对自己的速度很自信"}, {"start": 36.99, "end": 38.55, "text": "又极度需要大量灵期"}, {"start": 40.03, "end": 41.67, "text": "这颗灵丹他不会放过的"}, {"start": 53.96, "end": 54.64, "text": "抓到了"}]}