{"file": "御狐-第154集.mp4", "ep": 154, "duration": 42.3, "segments": [{"start": 6.19, "end": 9.73, "text": "嗯"}, {"start": 9.73, "end": 11.23, "text": "今日是大笔报名"}, {"start": 11.23, "end": 12.73, "text": "张师兄不参加吗"}, {"start": 12.73, "end": 13.73, "text": "楚师弟说笑了"}, {"start": 13.73, "end": 15.23, "text": "我虽然是三接灵主"}, {"start": 15.23, "end": 16.73, "text": "但我已经四十有五"}, {"start": 16.73, "end": 17.73, "text": "天赋到了头"}, {"start": 17.73, "end": 19.23, "text": "此生恐难有寸进"}, {"start": 19.23, "end": 20.73, "text": "就算侥幸成了通过大笔"}, {"start": 20.73, "end": 21.73, "text": "也不过成一个"}, {"start": 21.73, "end": 23.73, "text": "连师父都拜不上的普通弟子"}, {"start": 23.73, "end": 26.23, "text": "倒还不如老师留在这灵药园"}, {"start": 26.23, "end": 27.73, "text": "捞点油水混日子"}, {"start": 27.73, "end": 29.73, "text": "若我没有背负血海深仇"}, {"start": 29.73, "end": 31.73, "text": "我恐怕就会留在楚家村"}, {"start": 31.73, "end": 33.73, "text": "和殿阳平凡一时"}, {"start": 33.73, "end": 35.82, "text": "但是我如今见识过"}, {"start": 35.82, "end": 38.21, "text": "这广大的灵兽世界"}, {"start": 38.21, "end": 39.71, "text": "当真还能甘心一辈子"}, {"start": 39.71, "end": 41.21, "text": "只当一位一接灵主吗"}]}