{"file": "御狐-第105集.mp4", "ep": 105, "duration": 62.0, "segments": [{"start": 0.27, "end": 1.47, "text": "什么情况"}, {"start": 1.47, "end": 4.79, "text": "为什么管事对少爷的态度如此惨媚"}, {"start": 4.79, "end": 6.63, "text": "昨日之事我已听说"}, {"start": 6.63, "end": 8.55, "text": "少年人切磋无妨"}, {"start": 8.55, "end": 10.39, "text": "但要注意分寸才行"}, {"start": 10.39, "end": 11.59, "text": "弟子紧急"}, {"start": 11.59, "end": 14.23, "text": "徒家人受了重伤无法上工"}, {"start": 14.23, "end": 17.35, "text": "以后灵药园日常工作由你来安排"}, {"start": 17.35, "end": 18.51, "text": "股源帮衬"}, {"start": 18.51, "end": 19.91, "text": "方青山 靠谱"}, {"start": 19.91, "end": 21.7, "text": "多谢管事赏师"}, {"start": 21.7, "end": 23.02, "text": "弟子定不负所托"}, {"start": 23.02, "end": 27.76, "text": "日常差事你们安排就好"}, {"start": 27.76, "end": 29.08, "text": "不必事事禀报"}, {"start": 29.08, "end": 30.2, "text": "当然"}, {"start": 30.4, "end": 32.0, "text": "药园中些许灵职"}, {"start": 32.0, "end": 34.94, "text": "除了月曆定之外也可以自取"}, {"start": 34.94, "end": 35.66, "text": "是"}, {"start": 35.66, "end": 37.18, "text": "弟子谢过管事"}, {"start": 37.18, "end": 41.33, "text": "弟子告退了"}, {"start": 41.33, "end": 42.33, "text": "少爷"}, {"start": 42.33, "end": 43.53, "text": "启管事竟然没罚我们"}, {"start": 43.53, "end": 45.09, "text": "启管事心思不在药园"}, {"start": 45.09, "end": 47.73, "text": "之前交给徒家荣是因为他实力最强能服众"}, {"start": 47.73, "end": 48.77, "text": "如今我打赢了他"}, {"start": 48.77, "end": 49.45, "text": "自然交给我"}, {"start": 49.45, "end": 50.13, "text": "原来如此"}, {"start": 50.13, "end": 52.01, "text": "咱们是光明正大接下这位置的"}, {"start": 52.01, "end": 53.37, "text": "待会回来药园自信点"}, {"start": 53.37, "end": 54.13, "text": "别掉份"}, {"start": 54.13, "end": 56.53, "text": "管事可是说了以后药园也归你管"}, {"start": 56.53, "end": 57.53, "text": "我看好你"}]}