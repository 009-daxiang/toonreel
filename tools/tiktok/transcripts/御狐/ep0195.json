{"file": "御狐-第195集.mp4", "ep": 195, "duration": 45.0, "segments": [{"start": 0.3, "end": 1.02, "text": "师父"}, {"start": 1.46, "end": 2.74, "text": "你体内的药毒"}, {"start": 2.98, "end": 4.38, "text": "真没有灵药能解吗"}, {"start": 4.98, "end": 6.42, "text": "也不是完全没有办法"}, {"start": 6.66, "end": 7.62, "text": "九色之血"}, {"start": 7.74, "end": 8.7, "text": "可解百毒"}, {"start": 8.82, "end": 9.82, "text": "可消百病"}, {"start": 10.14, "end": 11.54, "text": "但那是灵兽的血液"}, {"start": 11.78, "end": 12.66, "text": "极难获得"}, {"start": 13.06, "end": 14.62, "text": "九色之血是何等灵药"}, {"start": 14.98, "end": 16.22, "text": "怎么会没有人能得到"}, {"start": 16.74, "end": 17.7, "text": "严格来说"}, {"start": 17.94, "end": 19.62, "text": "九色之血并不是灵药"}, {"start": 19.74, "end": 21.26, "text": "而是一种灵兽的血液"}, {"start": 21.34, "end": 22.98, "text": "以你现在的修为还接触不到"}, {"start": 23.06, "end": 24.82, "text": "等你以后成为强大的灵主了"}, {"start": 25.06, "end": 26.18, "text": "后续有机会见到"}, {"start": 27.88, "end": 28.36, "text": "好了"}, {"start": 28.52, "end": 29.72, "text": "这不是你该管的事"}, {"start": 29.88, "end": 31.04, "text": "大晚上的快去睡觉"}, {"start": 31.32, "end": 32.32, "text": "养好你的伤"}, {"start": 32.44, "end": 34.48, "text": "别在持消大笔伤给老夫丢脸"}, {"start": 36.08, "end": 36.88, "text": "遵命师父"}, {"start": 37.12, "end": 37.96, "text": "师父慢走"}, {"start": 41.04, "end": 42.0, "text": "若有机会"}, {"start": 42.42, "end": 43.26, "text": "我一定要为师父"}, {"start": 43.26, "end": 44.46, "text": "去九色之血并"}]}