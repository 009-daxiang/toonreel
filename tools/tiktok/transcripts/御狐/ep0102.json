{"file": "御狐-第102集.mp4", "ep": 102, "duration": 48.1, "segments": [{"start": 3.22, "end": 4.02, "text": "习惯氏"}, {"start": 4.42, "end": 5.02, "text": "何意啊"}, {"start": 5.02, "end": 7.02, "text": "拿老子背进去垫你的鞋底"}, {"start": 7.02, "end": 8.22, "text": "你好大的胆子"}, {"start": 8.42, "end": 9.62, "text": "我命你为代管要员"}, {"start": 9.62, "end": 10.62, "text": "是让你公正处事"}, {"start": 10.62, "end": 11.62, "text": "团结弟子的"}, {"start": 11.62, "end": 13.42, "text": "你居然还敢在此搬弄了是非"}, {"start": 13.42, "end": 14.42, "text": "管 管氏名剑"}, {"start": 14.42, "end": 15.22, "text": "弟子没有啊"}, {"start": 15.22, "end": 16.42, "text": "那楚少爷终究只是个"}, {"start": 16.42, "end": 17.42, "text": "二阶的废物罢了"}, {"start": 17.42, "end": 18.82, "text": "就算咱们真废了他"}, {"start": 18.82, "end": 20.22, "text": "方长老也不会怎么样的"}, {"start": 20.22, "end": 21.42, "text": "还敢嘴硬"}, {"start": 21.62, "end": 23.02, "text": "看老子先废了你"}, {"start": 25.02, "end": 26.02, "text": "习惯氏饶命"}, {"start": 26.02, "end": 27.42, "text": "我什么都没干啊"}, {"start": 27.82, "end": 29.22, "text": "还敢嘴硬"}, {"start": 29.82, "end": 32.22, "text": "我看你就是不见棺材不落泪"}, {"start": 34.22, "end": 36.76, "text": "气死老子了"}, {"start": 37.16, "end": 39.36, "text": "不过方长老素来冷面无私"}, {"start": 39.36, "end": 41.36, "text": "怎会对一个弟子如此伤心"}, {"start": 41.56, "end": 42.36, "text": "怪在"}, {"start": 42.76, "end": 43.96, "text": "其中必有蹊跷"}, {"start": 44.36, "end": 45.76, "text": "说不定我讨好一番"}, {"start": 46.16, "end": 47.96, "text": "还能对方青山释放善意"}]}