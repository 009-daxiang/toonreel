{"file": "御狐-第239集.mp4", "ep": 239, "duration": 44.3, "segments": [{"start": 0.0, "end": 1.2, "text": "罚你半年月前"}, {"start": 1.6, "end": 3.4, "text": "以后切不可再疏忽大意"}, {"start": 3.8, "end": 5.72, "text": "是弟子没有尽好裁判之责"}, {"start": 6.2, "end": 7.08, "text": "弟子领罚"}, {"start": 7.64, "end": 9.0, "text": "宗主亲自未问我"}, {"start": 9.55, "end": 11.03, "text": "还罚了他的亲传弟子"}, {"start": 11.35, "end": 12.75, "text": "这都是蹭了师父的光"}, {"start": 13.42, "end": 14.7, "text": "师父的厉害程度"}, {"start": 14.98, "end": 16.7, "text": "真是不断地超出我的想象"}, {"start": 23.06, "end": 24.1, "text": "回去收拾干净"}, {"start": 24.3, "end": 25.78, "text": "别在最后的排名赛事"}, {"start": 25.78, "end": 26.9, "text": "给老夫丢人"}, {"start": 27.53, "end": 27.93, "text": "是"}, {"start": 36.68, "end": 38.28, "text": "刚才可真是吓死我们了"}, {"start": 38.68, "end": 39.84, "text": "幸好你反应快"}, {"start": 40.04, "end": 41.12, "text": "没想到汪植的胆子"}, {"start": 41.12, "end": 41.96, "text": "竟然这么大了"}, {"start": 42.52, "end": 44.08, "text": "比赛结束后还敢偷袭"}]}