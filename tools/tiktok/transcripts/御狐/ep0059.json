{"file": "御狐-第59集.mp4", "ep": 59, "duration": 53.6, "segments": [{"start": 0.3, "end": 1.3, "text": "狂化"}, {"start": 9.95, "end": 10.95, "text": "狂化后攻防敏捷提升三场"}, {"start": 10.95, "end": 11.95, "text": "一战灵兽理智大将"}, {"start": 11.95, "end": 13.95, "text": "还会抽干灵主的灵气"}, {"start": 13.95, "end": 15.95, "text": "这可是伤敌一千四损一千二的战斗方式"}, {"start": 15.95, "end": 16.95, "text": "汪志你疯了吗"}, {"start": 16.95, "end": 17.95, "text": "这可是死斗"}, {"start": 17.95, "end": 34.13, "text": "今来的杂役还挺厉害"}, {"start": 34.13, "end": 36.13, "text": "侯三召唤一只就艰难了"}, {"start": 36.13, "end": 38.13, "text": "他竟能同时操控两只"}, {"start": 38.13, "end": 39.13, "text": "还有任由于"}, {"start": 39.13, "end": 41.13, "text": "他这两只灵宠配合得也很好"}, {"start": 41.13, "end": 42.13, "text": "这样下去"}, {"start": 42.13, "end": 43.13, "text": "侯三必输无疑啊"}, {"start": 43.13, "end": 44.13, "text": "不要和他硬碰一盒"}, {"start": 44.13, "end": 45.13, "text": "在场中周旋"}, {"start": 45.13, "end": 47.13, "text": "消耗他的灵气"}]}