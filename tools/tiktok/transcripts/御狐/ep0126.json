{"file": "御狐-第126集.mp4", "ep": 126, "duration": 103.1, "segments": [{"start": 4.66, "end": 7.13, "text": "雪霧"}, {"start": 7.13, "end": 8.13, "text": "你醒了"}, {"start": 8.13, "end": 9.22, "text": "我泡了多久"}, {"start": 9.22, "end": 10.22, "text": "半个时辰"}, {"start": 10.22, "end": 12.22, "text": "我第一次给人用这药汤"}, {"start": 12.22, "end": 14.22, "text": "不过你身体强度比我预想的强得多"}, {"start": 14.22, "end": 16.22, "text": "明明才二阶"}, {"start": 16.22, "end": 18.22, "text": "精脉却比三阶还宽阔"}, {"start": 18.22, "end": 20.22, "text": "自身对灵力的清合力也很高"}, {"start": 20.22, "end": 22.22, "text": "慕灵对你的恢复效果不差"}, {"start": 22.22, "end": 24.22, "text": "确实如师父所说"}, {"start": 24.22, "end": 26.22, "text": "若非数年如一日般的苦恋"}, {"start": 26.22, "end": 27.22, "text": "做不到你这样"}, {"start": 27.22, "end": 29.96, "text": "丹阳子长老付出的代价"}, {"start": 29.96, "end": 31.96, "text": "亲身经历才是其中一二"}, {"start": 31.96, "end": 34.98, "text": "是我高看自己了"}, {"start": 34.98, "end": 37.02, "text": "别忘自匪伯"}, {"start": 37.02, "end": 39.5, "text": "你已经做得很好了"}, {"start": 39.5, "end": 41.5, "text": "不过刚才的练体"}, {"start": 41.5, "end": 43.66, "text": "其实是师父给你的考验"}, {"start": 43.66, "end": 45.66, "text": "你若试一下就放弃"}, {"start": 45.66, "end": 46.66, "text": "或没坚持一住香"}, {"start": 46.66, "end": 47.66, "text": "考验便失败"}, {"start": 47.66, "end": 48.66, "text": "会被逐出灵药源"}, {"start": 48.66, "end": 50.69, "text": "还好我熬了下来"}, {"start": 50.69, "end": 52.69, "text": "这盆是师父亲手为你的"}, {"start": 52.69, "end": 53.69, "text": "本命灵兽调配的"}, {"start": 53.69, "end": 54.69, "text": "雪霧也要泡"}, {"start": 54.69, "end": 56.69, "text": "灵主与本命灵兽同生共死"}, {"start": 56.69, "end": 57.69, "text": "光你体质上去不够"}, {"start": 57.69, "end": 58.69, "text": "她当然也要"}, {"start": 58.69, "end": 60.69, "text": "除非你想要突破上线的时候"}, {"start": 60.69, "end": 63.1, "text": "灵兽疼死过去"}, {"start": 63.1, "end": 64.1, "text": "你想说"}, {"start": 64.1, "end": 65.1, "text": "你也要变强"}, {"start": 65.1, "end": 67.1, "text": "灵兽随主人"}, {"start": 67.1, "end": 68.1, "text": "还养得很不错"}, {"start": 68.1, "end": 71.9, "text": "雪霧是我的家人"}, {"start": 71.9, "end": 74.11, "text": "那便来吧"}, {"start": 74.11, "end": 77.7, "text": "放心"}, {"start": 77.7, "end": 83.39, "text": "师父调配的肯定是合适的"}, {"start": 83.39, "end": 84.39, "text": "端木师姐"}, {"start": 84.39, "end": 86.81, "text": "这是你的本命灵兽"}, {"start": 86.81, "end": 87.81, "text": "木元素精灵"}, {"start": 87.81, "end": 89.81, "text": "诞生在元素浓郁之地"}, {"start": 89.81, "end": 91.81, "text": "成年后至少能达到七节"}, {"start": 91.81, "end": 92.81, "text": "我想问"}, {"start": 92.81, "end": 93.81, "text": "师姐也经历过练体吗"}, {"start": 93.81, "end": 94.81, "text": "自然"}, {"start": 94.81, "end": 96.81, "text": "端木师姐天赋不可估量"}, {"start": 96.81, "end": 97.81, "text": "这么有天赋的人"}, {"start": 97.81, "end": 98.81, "text": "还如此努力"}, {"start": 98.81, "end": 99.81, "text": "我有什么理由"}, {"start": 99.81, "end": 100.81, "text": "按于现状"}, {"start": 100.81, "end": 101.81, "text": "我要更加努力"}, {"start": 101.81, "end": 102.81, "text": "变得更强才对"}]}