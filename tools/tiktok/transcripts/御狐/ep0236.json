{"file": "御狐-第236集.mp4", "ep": 236, "duration": 43.8, "segments": [{"start": 2.45, "end": 3.45, "text": "弟子知错"}, {"start": 7.79, "end": 8.79, "text": "丹阳子长老"}, {"start": 8.79, "end": 10.19, "text": "在下教徒无方"}, {"start": 10.19, "end": 12.19, "text": "竟然让他做出此种恶事"}, {"start": 12.19, "end": 13.39, "text": "还望丹阳子长老"}, {"start": 13.39, "end": 14.59, "text": "看在在下的面子上"}, {"start": 14.59, "end": 15.59, "text": "饶过他这次"}, {"start": 15.59, "end": 16.99, "text": "你在我这儿有什么面子"}, {"start": 19.29, "end": 20.49, "text": "丹阳子长老"}, {"start": 20.49, "end": 22.49, "text": "我的徒儿只是一时气不过"}, {"start": 22.49, "end": 23.69, "text": "少年心性"}, {"start": 23.69, "end": 25.29, "text": "贵徒并未受伤"}, {"start": 25.29, "end": 27.09, "text": "不如得饶人处且饶人"}, {"start": 36.58, "end": 38.52, "text": "丹阳子"}, {"start": 38.52, "end": 39.92, "text": "我好歹也是长老"}, {"start": 39.92, "end": 41.12, "text": "你居然瞅我"}]}