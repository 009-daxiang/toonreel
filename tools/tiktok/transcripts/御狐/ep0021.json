{"file": "御狐-第21集.mp4", "ep": 21, "duration": 76.7, "segments": [{"start": 0.0, "end": 0.8, "text": "人兄"}, {"start": 0.8, "end": 3.2, "text": "那咱们杂役怎么样才能成为外门弟子"}, {"start": 3.2, "end": 4.4, "text": "不愧是安兄弟"}, {"start": 4.4, "end": 5.4, "text": "优质气"}, {"start": 5.4, "end": 6.6, "text": "屈道嘛当然优"}, {"start": 6.6, "end": 8.0, "text": "不过竞争大了很"}, {"start": 8.0, "end": 9.6, "text": "你港进总闷直到了也没有"}, {"start": 9.6, "end": 11.2, "text": "猜一截直到了又能砸点"}, {"start": 11.86, "end": 12.46, "text": "也对"}, {"start": 12.46, "end": 13.46, "text": "别回形"}, {"start": 13.46, "end": 14.46, "text": "停格的"}, {"start": 14.46, "end": 16.26, "text": "先安心适应总门省货"}, {"start": 16.26, "end": 17.86, "text": "等你至少省上二截"}, {"start": 17.86, "end": 18.86, "text": "我再跟你说吧"}, {"start": 18.86, "end": 19.86, "text": "谢谢人兄"}, {"start": 20.71, "end": 21.91, "text": "不早嘞"}, {"start": 22.31, "end": 23.71, "text": "你赶路也挺累的"}, {"start": 23.91, "end": 24.91, "text": "早点休息吧"}, {"start": 25.31, "end": 26.11, "text": "我来试读"}, {"start": 42.01, "end": 43.41, "text": "人兄已经去上工了吗"}, {"start": 44.99, "end": 46.19, "text": "昨日方管师说"}, {"start": 46.19, "end": 47.99, "text": "会有人来接我办理身份预排"}, {"start": 48.19, "end": 49.19, "text": "到门口等等吧"}, {"start": 60.0, "end": 61.4, "text": "你就是楚少爷吧"}, {"start": 61.6, "end": 62.6, "text": "我叫季云彤"}, {"start": 62.8, "end": 64.2, "text": "方管师是我师父"}, {"start": 64.4, "end": 66.4, "text": "师父让我带你去人事堂报道"}, {"start": 66.8, "end": 67.4, "text": "上来吧"}, {"start": 72.45, "end": 73.85, "text": "棉花糖出发吧"}]}