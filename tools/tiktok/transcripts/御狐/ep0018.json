{"file": "御狐-第18集.mp4", "ep": 18, "duration": 41.8, "segments": [{"start": 0.0, "end": 0.83, "text": "等等"}, {"start": 11.02, "end": 11.7, "text": "抱歉抱歉"}, {"start": 11.7, "end": 12.3, "text": "师兄"}, {"start": 14.15, "end": 15.15, "text": "怪阿墨出神"}, {"start": 15.51, "end": 17.31, "text": "皮操肉后挨几下磨四嘞"}, {"start": 22.16, "end": 22.88, "text": "师兄喝水"}, {"start": 23.96, "end": 24.8, "text": "若是受伤"}, {"start": 25.53, "end": 27.29, "text": "我身上带着些跌打的伤药"}, {"start": 27.92, "end": 28.96, "text": "安教人生平"}, {"start": 29.36, "end": 30.32, "text": "入门两年"}, {"start": 30.52, "end": 31.48, "text": "是三接灵主"}, {"start": 31.8, "end": 33.0, "text": "也不用叫我师兄"}, {"start": 33.44, "end": 34.68, "text": "杂义弟子不分这个"}, {"start": 34.96, "end": 36.28, "text": "咱们互称名字就行"}, {"start": 36.9, "end": 38.54, "text": "初次见面就把修为交代"}, {"start": 38.86, "end": 40.3, "text": "看到是个可识的家伙"}, {"start": 40.58, "end": 41.58, "text": "是个好人吗"}]}