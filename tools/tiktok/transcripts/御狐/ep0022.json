{"file": "御狐-第22集.mp4", "ep": 22, "duration": 54.6, "segments": [{"start": 5.2, "end": 5.7, "text": "喂"}, {"start": 6.1, "end": 7.3, "text": "可以松开我了吧"}, {"start": 9.67, "end": 10.07, "text": "抱"}, {"start": 10.37, "end": 11.07, "text": "抱歉"}, {"start": 11.17, "end": 11.97, "text": "师姐"}, {"start": 12.27, "end": 13.47, "text": "明明比我还小"}, {"start": 13.67, "end": 14.97, "text": "体格倒是挺壮的"}, {"start": 15.47, "end": 17.07, "text": "咱们赤销宗活还挺多的"}, {"start": 17.17, "end": 18.07, "text": "不过你放心"}, {"start": 18.17, "end": 19.07, "text": "师傅跟我说了"}, {"start": 19.17, "end": 20.87, "text": "会给你安排轻松点的活计"}, {"start": 21.17, "end": 21.87, "text": "师姐"}, {"start": 22.27, "end": 23.47, "text": "这是什么零售啊"}, {"start": 23.67, "end": 24.77, "text": "我还是第一次见"}, {"start": 25.27, "end": 26.47, "text": "你说棉花糖啊"}, {"start": 26.77, "end": 28.27, "text": "它是咱们赤销宗特产的"}, {"start": 28.27, "end": 29.47, "text": "云寿便衣而成"}, {"start": 29.57, "end": 30.67, "text": "叫做侠云寿"}, {"start": 30.77, "end": 32.67, "text": "每逢傍晚赤侠要天时"}, {"start": 32.97, "end": 34.37, "text": "在云山峰上的云寿"}, {"start": 34.37, "end": 35.47, "text": "就有概率变成"}, {"start": 36.17, "end": 38.07, "text": "你要是未来能成为外门弟子"}, {"start": 38.37, "end": 40.17, "text": "有机会可以去通通运气"}, {"start": 40.47, "end": 42.57, "text": "若是没有坐骑出行确实不便"}, {"start": 42.67, "end": 44.37, "text": "未来有机会去收服一只看看"}, {"start": 49.6, "end": 50.7, "text": "这是身份预排"}, {"start": 50.7, "end": 51.4, "text": "你收好"}, {"start": 51.8, "end": 53.0, "text": "等下带你登记工作"}, {"start": 53.63, "end": 54.33, "text": "谢谢师姐"}]}