{"file": "御狐-第170集.mp4", "ep": 170, "duration": 52.6, "segments": [{"start": 0.66, "end": 1.26, "text": "倘亦"}, {"start": 3.46, "end": 3.86, "text": "在"}, {"start": 4.06, "end": 5.46, "text": "开启护踪大阵"}, {"start": 6.09, "end": 6.69, "text": "红鸡"}, {"start": 7.09, "end": 8.09, "text": "你与我同序"}, {"start": 8.82, "end": 9.82, "text": "其余长老"}, {"start": 10.02, "end": 11.62, "text": "立刻随我们进入秘境"}, {"start": 11.82, "end": 13.42, "text": "务必在其突破前"}, {"start": 13.62, "end": 14.62, "text": "将其剿灭"}, {"start": 15.02, "end": 16.02, "text": "是 是"}, {"start": 19.85, "end": 20.85, "text": "灵力月灵的地方"}, {"start": 20.85, "end": 21.65, "text": "要守大队"}, {"start": 21.85, "end": 23.25, "text": "利用雪宝的寻寶天赋"}, {"start": 23.45, "end": 25.05, "text": "故意避开灵力浓厚的地方"}, {"start": 25.54, "end": 26.54, "text": "能暂时休息了"}, {"start": 30.43, "end": 31.43, "text": "谢谢雪宝"}, {"start": 31.63, "end": 32.43, "text": "辛苦了"}, {"start": 34.24, "end": 36.04, "text": "幸好鬼面之珠没有毒性"}, {"start": 36.5, "end": 38.3, "text": "这秘境中灵质灵狂丰富"}, {"start": 38.5, "end": 39.7, "text": "倒是帮了大忙"}, {"start": 40.46, "end": 41.66, "text": "必须尽快恢复"}, {"start": 42.22, "end": 44.02, "text": "尽快和人兄雇员会合"}, {"start": 45.34, "end": 46.94, "text": "若是被汪旨找到机会"}, {"start": 47.34, "end": 48.74, "text": "免不了一场恶战"}]}