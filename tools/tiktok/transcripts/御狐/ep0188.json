{"file": "御狐-第188集.mp4", "ep": 188, "duration": 41.9, "segments": [{"start": 0.24, "end": 10.53, "text": "少爷"}, {"start": 10.53, "end": 11.53, "text": "出师弟"}, {"start": 11.53, "end": 13.53, "text": "你知不知道我有多担心你"}, {"start": 13.53, "end": 15.53, "text": "我真以为你死了"}, {"start": 15.53, "end": 17.07, "text": "是我不好"}, {"start": 17.07, "end": 23.49, "text": "还记姐姐担心了"}, {"start": 23.49, "end": 24.49, "text": "少爷"}, {"start": 24.49, "end": 26.49, "text": "我真以为再也见不到你了"}, {"start": 26.49, "end": 28.49, "text": "没有你我可怎么活啊"}, {"start": 28.49, "end": 29.49, "text": "出兄弟伤害牧豪利索来"}, {"start": 29.49, "end": 31.55, "text": "可得仔细着点"}, {"start": 31.55, "end": 32.55, "text": "少爷"}, {"start": 32.55, "end": 33.55, "text": "我没伤到你吧"}, {"start": 33.55, "end": 34.55, "text": "没事"}, {"start": 34.55, "end": 35.74, "text": "都是外伤"}, {"start": 35.74, "end": 36.74, "text": "师弟"}, {"start": 36.74, "end": 37.74, "text": "我去给你煎药了"}, {"start": 37.74, "end": 38.74, "text": "你们聊"}]}