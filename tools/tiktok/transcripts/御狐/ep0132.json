{"file": "御狐-第132集.mp4", "ep": 132, "duration": 83.8, "segments": [{"start": 6.16, "end": 9.6, "text": "呦 楚师弟嘛 真是冤家禄辰"}, {"start": 9.6, "end": 12.12, "text": "屠家荣 是你"}, {"start": 12.12, "end": 24.66, "text": "鬼针草 三阶木属性植物类灵兽"}, {"start": 24.66, "end": 26.98, "text": "发弹鬼针可远离射出"}, {"start": 26.98, "end": 29.18, "text": "叶片可聚伦同盾"}, {"start": 29.18, "end": 34.81, "text": "屠家荣 宗门禁止弟子私斗"}, {"start": 34.81, "end": 37.21, "text": "你就不怕被发现逐出宗门吗"}, {"start": 37.21, "end": 40.65, "text": "这里又没别人 谁知道"}, {"start": 40.65, "end": 42.41, "text": "上次全角是我大远"}, {"start": 42.41, "end": 45.25, "text": "今日灵宠对账 看你还走"}, {"start": 45.25, "end": 64.74, "text": "什么 三阶了"}, {"start": 64.74, "end": 66.54, "text": "雪巫 途径"}, {"start": 80.86, "end": 82.22, "text": "你不是我的对手"}, {"start": 82.22, "end": 83.74, "text": "确定还要继续打吗"}]}