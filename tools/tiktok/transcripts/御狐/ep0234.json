{"file": "御狐-第234集.mp4", "ep": 234, "duration": 46.8, "segments": [{"start": 0.0, "end": 0.92, "text": "丹阳子"}, {"start": 1.28, "end": 3.44, "text": "你徒弟要赢我徒弟的命了"}, {"start": 3.68, "end": 4.52, "text": "你让开"}, {"start": 4.96, "end": 6.68, "text": "你徒弟自己用的狂话"}, {"start": 7.24, "end": 8.48, "text": "关我徒弟什么事"}, {"start": 8.88, "end": 10.28, "text": "你自己教的弟子"}, {"start": 10.6, "end": 11.64, "text": "自己管不住"}, {"start": 12.04, "end": 13.52, "text": "倒怪到我头上来了"}, {"start": 14.08, "end": 15.2, "text": "好一对师徒"}, {"start": 15.52, "end": 16.64, "text": "等成事之后"}, {"start": 16.92, "end": 18.12, "text": "无论是丹阳子"}, {"start": 18.12, "end": 19.44, "text": "还是他这个徒弟"}, {"start": 19.6, "end": 21.2, "text": "都别想有好下场"}, {"start": 21.52, "end": 37.3, "text": "一个三阶灵族"}, {"start": 37.86, "end": 39.54, "text": "灵力怎么还没耗尽"}, {"start": 40.14, "end": 41.42, "text": "他一定是装的"}, {"start": 41.7, "end": 43.08, "text": "都怪这个小子"}, {"start": 43.08, "end": 46.03, "text": "竟然让我在整个宗门的人面前丢脸"}]}