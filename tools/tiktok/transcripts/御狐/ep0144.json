{"file": "御狐-第144集.mp4", "ep": 144, "duration": 53.2, "segments": [{"start": 0.5, "end": 1.3, "text": "雪巫"}, {"start": 1.3, "end": 2.74, "text": "拿着令牌去找端木师姐"}, {"start": 2.74, "end": 3.94, "text": "股源你对医药草更了解"}, {"start": 3.94, "end": 4.82, "text": "帮忙做应急处理"}, {"start": 4.82, "end": 5.74, "text": "需要什么给你打下手"}, {"start": 5.74, "end": 6.34, "text": "好"}, {"start": 11.8, "end": 12.56, "text": "端木师姐"}, {"start": 12.56, "end": 13.56, "text": "百花离难铲了"}, {"start": 13.56, "end": 14.56, "text": "麻烦你救救她"}, {"start": 15.04, "end": 16.34, "text": "幼崽太大"}, {"start": 16.34, "end": 17.34, "text": "生不出来"}, {"start": 17.34, "end": 18.14, "text": "木灵"}, {"start": 18.14, "end": 19.02, "text": "生机"}, {"start": 19.34, "end": 25.38, "text": "我只能暂时掉住她的命"}, {"start": 25.66, "end": 26.66, "text": "大得和小的"}, {"start": 27.06, "end": 27.98, "text": "选一个吧"}, {"start": 28.38, "end": 30.64, "text": "端木师姐"}, {"start": 30.96, "end": 32.04, "text": "可能两个都能救"}, {"start": 32.04, "end": 32.96, "text": "您帮我一下"}, {"start": 33.16, "end": 33.72, "text": "好"}, {"start": 33.92, "end": 34.64, "text": "我帮你"}, {"start": 34.92, "end": 36.08, "text": "皮开起驱崽"}, {"start": 36.56, "end": 38.76, "text": "你让灵虫用麻痺和生机称征"}, {"start": 39.08, "end": 39.92, "text": "线子挥蝶"}, {"start": 40.28, "end": 40.96, "text": "麻痺"}, {"start": 42.56, "end": 43.08, "text": "木灵"}, {"start": 43.44, "end": 44.44, "text": "继续用生机"}]}