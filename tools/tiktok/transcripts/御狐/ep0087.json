{"file": "御狐-第87集.mp4", "ep": 87, "duration": 48.6, "segments": [{"start": 8.59, "end": 10.19, "text": "红血藻 补结"}, {"start": 10.31, "end": 11.75, "text": "虽然是火属性的灵藏"}, {"start": 11.87, "end": 13.79, "text": "但却喜爱潮湿阴冷的环境"}, {"start": 14.15, "end": 16.19, "text": "只在清澈干净的水源中生长"}, {"start": 16.31, "end": 17.39, "text": "传闻中神龙之血"}, {"start": 17.51, "end": 19.39, "text": "滴落在水中生根幻化而成"}, {"start": 19.51, "end": 21.39, "text": "灵主服用可洗经法随"}, {"start": 21.51, "end": 23.11, "text": "修炼进度可一日千里"}, {"start": 23.23, "end": 24.71, "text": "而如果是灵兽服用"}, {"start": 24.83, "end": 27.15, "text": "则有极低几率史无属性灵兽"}, {"start": 27.27, "end": 28.71, "text": "潮龙类灵兽净化"}, {"start": 29.48, "end": 30.72, "text": "图件中却没有提到"}, {"start": 30.84, "end": 32.28, "text": "龙血藻已置换作用"}, {"start": 32.75, "end": 34.35, "text": "那当时强烈的饥饿感"}, {"start": 34.47, "end": 35.87, "text": "和脑海中那个莫名的声音"}, {"start": 35.99, "end": 37.26, "text": "又是哪个声音"}, {"start": 37.46, "end": 38.02, "text": "罢了"}, {"start": 38.58, "end": 40.14, "text": "至少确实因获得福了"}, {"start": 40.87, "end": 41.63, "text": "这样一来"}, {"start": 41.95, "end": 43.55, "text": "参加赤销大笔的把握"}, {"start": 43.67, "end": 44.63, "text": "也就更足了"}, {"start": 45.26, "end": 46.7, "text": "关于灵职想不明白的"}, {"start": 47.06, "end": 48.5, "text": "明日再问问古师兄吧"}]}