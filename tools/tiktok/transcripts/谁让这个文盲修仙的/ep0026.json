{"file": "谁让这个文盲修仙的-第26集.mp4", "ep": 26, "duration": 92.2, "segments": [{"start": 0.99, "end": 1.91, "text": "你告诉我"}, {"start": 2.23, "end": 3.75, "text": "你是不是文芒"}, {"start": 4.83, "end": 6.31, "text": "我 文芒"}, {"start": 6.43, "end": 7.83, "text": "怎么 怎么可能"}, {"start": 8.55, "end": 9.95, "text": "千万不能被他发现"}, {"start": 10.31, "end": 11.51, "text": "不然自己圣子的位置"}, {"start": 11.51, "end": 12.71, "text": "绝对没希望了"}, {"start": 13.19, "end": 14.67, "text": "现在立刻"}, {"start": 14.87, "end": 17.59, "text": "马上给我去严务场比拼"}, {"start": 19.44, "end": 20.32, "text": "我不认路"}, {"start": 20.72, "end": 21.68, "text": "我露痴"}, {"start": 22.08, "end": 23.32, "text": "要不你带我一场"}, {"start": 23.56, "end": 24.7, "text": "好"}, {"start": 25.1, "end": 27.06, "text": "我带你一程"}, {"start": 27.34, "end": 29.53, "text": "给老子滚进去"}, {"start": 57.94, "end": 58.9, "text": "臣急"}, {"start": 59.83, "end": 61.83, "text": "今日我必将你斩杀"}, {"start": 62.91, "end": 64.03, "text": "你是不是有病"}, {"start": 64.54, "end": 65.86, "text": "为了争夺个圣子"}, {"start": 65.86, "end": 67.06, "text": "你还要玩命"}, {"start": 67.58, "end": 69.78, "text": "但凭你强迫小师妹一事"}, {"start": 70.02, "end": 71.26, "text": "我便饶不了你"}, {"start": 71.58, "end": 72.86, "text": "我啥时候强迫"}, {"start": 75.38, "end": 76.14, "text": "斗安静"}, {"start": 76.3, "end": 81.5, "text": "他纯流氓啊"}, {"start": 82.3, "end": 84.7, "text": "圣子选拔现在开始"}, {"start": 85.14, "end": 87.46, "text": "双方切磋点到为止"}, {"start": 87.46, "end": 89.06, "text": "不可出现死亡"}, {"start": 89.98, "end": 91.58, "text": "我要下圣子战"}]}