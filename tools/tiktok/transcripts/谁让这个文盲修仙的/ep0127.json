{"file": "谁让这个文盲修仙的-第127集.mp4", "ep": 127, "duration": 67.2, "segments": [{"start": 0.0, "end": 1.72, "text": "要天神族的神子吗"}, {"start": 2.35, "end": 3.55, "text": "据说他是你们之中"}, {"start": 3.55, "end": 4.71, "text": "实力最强的"}, {"start": 5.68, "end": 6.56, "text": "血生圣子"}, {"start": 7.0, "end": 8.16, "text": "您别听信谣言"}, {"start": 8.32, "end": 9.92, "text": "他绝不是你一招之敌"}, {"start": 14.46, "end": 15.74, "text": "距离腐蚀成功"}, {"start": 15.74, "end": 17.18, "text": "还有一段时间"}, {"start": 18.79, "end": 21.03, "text": "我等你口中的神子到来"}, {"start": 22.1, "end": 24.42, "text": "送你们一起上路"}, {"start": 24.74, "end": 25.26, "text": "你"}, {"start": 25.74, "end": 29.35, "text": "你再不是天母神术"}, {"start": 30.93, "end": 31.69, "text": "没错"}, {"start": 32.09, "end": 34.05, "text": "融合了剑母神术的树心"}, {"start": 34.29, "end": 35.13, "text": "我就拥有了"}, {"start": 35.13, "end": 37.05, "text": "无穷无尽的恢复能力"}, {"start": 37.09, "end": 38.05, "text": "到时我就是"}, {"start": 38.05, "end": 39.77, "text": "不死不灭的存在"}, {"start": 39.97, "end": 42.5, "text": "一旦让他成功"}, {"start": 42.5, "end": 43.62, "text": "可就出大事了"}, {"start": 43.9, "end": 45.02, "text": "他怎么还不来"}, {"start": 45.18, "end": 49.14, "text": "我还是失败的话"}, {"start": 49.14, "end": 51.29, "text": "就只能自暴"}, {"start": 51.29, "end": 53.53, "text": "拼死也要弄死他"}, {"start": 53.53, "end": 55.41, "text": "不要想着自暴杀死我"}, {"start": 55.41, "end": 57.56, "text": "你们太弱了"}, {"start": 59.74, "end": 60.94, "text": "我希望能够遇到"}, {"start": 60.94, "end": 62.74, "text": "一位士军力敌的对手"}, {"start": 62.94, "end": 63.94, "text": "可惜"}, {"start": 64.86, "end": 66.86, "text": "你们太让我失望了"}]}