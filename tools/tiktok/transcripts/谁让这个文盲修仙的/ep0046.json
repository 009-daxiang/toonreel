{"file": "谁让这个文盲修仙的-第46集.mp4", "ep": 46, "duration": 62.3, "segments": [{"start": 2.94, "end": 3.62, "text": "可惜了"}, {"start": 4.76, "end": 5.52, "text": "被他跑了"}, {"start": 6.81, "end": 7.37, "text": "聖子"}, {"start": 7.57, "end": 8.57, "text": "我们接下来怎么办"}, {"start": 9.8, "end": 10.24, "text": "走"}, {"start": 10.72, "end": 11.6, "text": "去客栈休息"}, {"start": 11.96, "end": 12.84, "text": "还去那里"}, {"start": 13.2, "end": 14.04, "text": "我们岂不是暴露"}, {"start": 14.04, "end": 14.72, "text": "被发现"}, {"start": 15.72, "end": 16.76, "text": "老子说过了"}, {"start": 16.76, "end": 17.68, "text": "我要做最高"}, {"start": 18.04, "end": 18.92, "text": "所有人都将成为"}, {"start": 18.92, "end": 19.84, "text": "我脚下的枯骨"}, {"start": 19.84, "end": 21.04, "text": "助我登顶"}, {"start": 22.86, "end": 23.46, "text": "周老"}, {"start": 24.18, "end": 25.3, "text": "这一届的大笔"}, {"start": 26.06, "end": 27.7, "text": "你觉得我能夺得第一吗"}, {"start": 28.06, "end": 29.42, "text": "古往今来中"}, {"start": 29.62, "end": 31.1, "text": "大皇子是唯一一个"}, {"start": 31.1, "end": 32.3, "text": "以如此年龄"}, {"start": 32.3, "end": 33.86, "text": "修出皇道龙契的人"}, {"start": 34.42, "end": 36.58, "text": "甚至比老皇主还要恐怖"}, {"start": 38.3, "end": 40.18, "text": "周老说话总是这么严谨"}, {"start": 40.46, "end": 41.7, "text": "天下英雄"}, {"start": 41.7, "end": 43.26, "text": "犹如过疆之计"}, {"start": 43.74, "end": 45.78, "text": "大皇子虽为人中龙奉"}, {"start": 46.06, "end": 47.74, "text": "可也不要掉以清心"}, {"start": 48.38, "end": 50.3, "text": "听说昊然宗的林蓝天"}, {"start": 50.3, "end": 51.46, "text": "凝聚剑心"}, {"start": 51.7, "end": 52.42, "text": "没错"}, {"start": 52.82, "end": 54.26, "text": "慈子的剑道之心"}, {"start": 54.26, "end": 55.3, "text": "不同凡响"}, {"start": 55.91, "end": 57.39, "text": "有几分不凡"}, {"start": 57.99, "end": 59.47, "text": "倒是想要见识一下"}, {"start": 59.59, "end": 60.99, "text": "凝聚剑心的剑修"}, {"start": 60.99, "end": 62.11, "text": "有几分是"}]}