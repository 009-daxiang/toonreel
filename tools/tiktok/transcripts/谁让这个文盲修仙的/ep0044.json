{"file": "谁让这个文盲修仙的-第44集.mp4", "ep": 44, "duration": 67.1, "segments": [{"start": 0.0, "end": 1.2, "text": "而我"}, {"start": 1.2, "end": 3.44, "text": "便要踏着所有修世的海谷"}, {"start": 3.44, "end": 5.56, "text": "一步一步走到最高"}, {"start": 5.56, "end": 7.8, "text": "我要做最高"}, {"start": 8.28, "end": 10.12, "text": "神经病啊"}, {"start": 10.12, "end": 11.12, "text": "挡我路了"}, {"start": 11.72, "end": 13.73, "text": "看你岁数大了"}, {"start": 13.73, "end": 14.85, "text": "不跟你一般见识"}, {"start": 14.85, "end": 15.81, "text": "修炼一图"}, {"start": 15.81, "end": 18.41, "text": "就是要踏着尸山血海登上高峰"}, {"start": 18.41, "end": 20.01, "text": "谁要是敢拦我"}, {"start": 20.01, "end": 21.41, "text": "我就宰了他"}, {"start": 21.81, "end": 22.73, "text": "不错不错"}, {"start": 22.73, "end": 24.01, "text": "如此可教也"}, {"start": 24.01, "end": 30.86, "text": "一群该死的贱民"}, {"start": 30.86, "end": 32.26, "text": "赶紧给我滚开"}, {"start": 32.66, "end": 34.02, "text": "敢拦本公主的路"}, {"start": 34.02, "end": 35.1, "text": "活腻了吗"}, {"start": 35.38, "end": 45.38, "text": "也是给我"}, {"start": 45.38, "end": 48.42, "text": "不长眼的东西"}, {"start": 48.42, "end": 49.74, "text": "不给本公主让路"}, {"start": 49.74, "end": 65.38, "text": "我看你才是活腻了"}]}