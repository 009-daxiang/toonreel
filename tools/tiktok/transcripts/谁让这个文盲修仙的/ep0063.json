{"file": "谁让这个文盲修仙的-第63集.mp4", "ep": 63, "duration": 57.4, "segments": [{"start": 0.4, "end": 0.96, "text": "你别动"}, {"start": 2.24, "end": 13.68, "text": "可是黄道龙驱"}, {"start": 14.0, "end": 15.6, "text": "你能扛得住几层"}, {"start": 19.72, "end": 21.64, "text": "浮游与昊月争辉"}, {"start": 28.62, "end": 30.06, "text": "必杀名单又多一个人"}, {"start": 31.09, "end": 32.69, "text": "双手一拍"}, {"start": 33.05, "end": 37.41, "text": "喊杀 杀了"}, {"start": 37.41, "end": 37.97, "text": "什么"}, {"start": 39.0, "end": 40.32, "text": "你还敢说自己修炼的是"}, {"start": 40.32, "end": 41.36, "text": "昊然正气爵"}, {"start": 41.88, "end": 43.16, "text": "孤法里没有这招"}, {"start": 45.86, "end": 46.9, "text": "当初单挑的时候"}, {"start": 47.18, "end": 48.54, "text": "怎么没有见到他用这招"}, {"start": 49.16, "end": 50.16, "text": "来来来"}, {"start": 50.63, "end": 52.83, "text": "让我看看你的小龙崽子"}, {"start": 52.83, "end": 55.15, "text": "能扛得住几拳"}]}