{"file": "谁让这个文盲修仙的-第24集.mp4", "ep": 24, "duration": 91.4, "segments": [{"start": 2.42, "end": 3.22, "text": "成了"}, {"start": 3.46, "end": 5.02, "text": "老子 我成了"}, {"start": 9.98, "end": 12.94, "text": "让我试一试威力 怎么样"}, {"start": 15.14, "end": 17.06, "text": "大黄球天掌"}, {"start": 24.18, "end": 26.47, "text": "傻玩意儿"}, {"start": 27.34, "end": 28.02, "text": "掌呢"}, {"start": 28.62, "end": 29.86, "text": "我修炼个艳品"}, {"start": 30.22, "end": 34.07, "text": "慈子到底什么来头"}, {"start": 34.19, "end": 36.07, "text": "我看他精神有点问题"}, {"start": 37.47, "end": 38.35, "text": "别多问了"}, {"start": 39.36, "end": 41.6, "text": "我只能说慈子天资绝顶"}, {"start": 49.69, "end": 50.13, "text": "不对"}, {"start": 50.29, "end": 51.81, "text": "难不成有人攻打攻门"}, {"start": 53.85, "end": 56.77, "text": "该不会是这小子搞出来的吧"}, {"start": 56.77, "end": 58.72, "text": "不天掌"}, {"start": 58.72, "end": 67.61, "text": "这儿说话"}, {"start": 67.81, "end": 69.16, "text": "甭子"}, {"start": 69.4, "end": 71.62, "text": "甭子"}, {"start": 75.93, "end": 77.01, "text": "大师兄回来了"}, {"start": 77.41, "end": 78.53, "text": "这次的圣子之位"}, {"start": 78.53, "end": 79.81, "text": "必定是大师兄的"}, {"start": 80.01, "end": 80.65, "text": "当然了"}, {"start": 80.65, "end": 82.41, "text": "大师兄可是金丹镜的强者"}, {"start": 82.41, "end": 83.41, "text": "绝世天才"}, {"start": 83.41, "end": 84.37, "text": "那个魔兄呢"}, {"start": 84.53, "end": 86.09, "text": "是不是害怕不敢来了"}, {"start": 86.67, "end": 87.43, "text": "大师兄"}, {"start": 87.91, "end": 89.75, "text": "清仙等你拿下圣子之位"}, {"start": 90.03, "end": 91.07, "text": "迎娶清仙"}]}