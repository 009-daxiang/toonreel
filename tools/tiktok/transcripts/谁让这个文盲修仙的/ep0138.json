{"file": "谁让这个文盲修仙的-第138集.mp4", "ep": 138, "duration": 66.4, "segments": [{"start": 0.66, "end": 2.94, "text": "我用剑木修補伤势"}, {"start": 2.94, "end": 5.07, "text": "什么都能压得住"}, {"start": 6.42, "end": 8.46, "text": "我要吞了你"}, {"start": 13.9, "end": 15.1, "text": "给我住手"}, {"start": 25.92, "end": 28.56, "text": "你的黄道龙器我也要"}, {"start": 31.42, "end": 32.98, "text": "我的药天之力"}, {"start": 32.98, "end": 34.86, "text": "你是不是也想要"}, {"start": 36.85, "end": 38.25, "text": "这些智强之力"}, {"start": 38.25, "end": 40.45, "text": "在你的身上简直是浪费"}, {"start": 40.45, "end": 41.93, "text": "我大哥大招放完"}, {"start": 41.93, "end": 43.33, "text": "有你死的时候"}, {"start": 44.05, "end": 44.77, "text": "他"}, {"start": 45.23, "end": 46.83, "text": "他都自身难保了"}, {"start": 47.18, "end": 48.74, "text": "不用我动手就死了"}, {"start": 51.13, "end": 52.73, "text": "都给我闪开"}, {"start": 53.31, "end": 55.99, "text": "老子看他能不能去得下"}, {"start": 58.54, "end": 59.26, "text": "跑"}, {"start": 59.26, "end": 60.38, "text": "快跑"}, {"start": 60.38, "end": 61.14, "text": "跑"}, {"start": 61.14, "end": 62.74, "text": "他用风大刀啊"}, {"start": 62.74, "end": 64.1, "text": "玩灭啦"}]}