{"file": "谁让这个文盲修仙的-第73集.mp4", "ep": 73, "duration": 58.1, "segments": [{"start": 0.08, "end": 1.04, "text": "别喊了"}, {"start": 1.8, "end": 3.12, "text": "再喊一声"}, {"start": 3.68, "end": 5.24, "text": "老夫就宰了你"}, {"start": 7.04, "end": 8.24, "text": "你个老东西"}, {"start": 8.72, "end": 10.16, "text": "就自己宗门的圣子"}, {"start": 10.16, "end": 11.56, "text": "还喜欢卡铁来"}, {"start": 12.32, "end": 13.48, "text": "不是有你在"}, {"start": 13.48, "end": 14.52, "text": "我放心"}, {"start": 16.0, "end": 19.3, "text": "张道陵"}, {"start": 19.78, "end": 21.67, "text": "竟然与魔修为伍"}, {"start": 21.67, "end": 22.95, "text": "就不怕"}, {"start": 23.55, "end": 27.34, "text": "小子看清楚了"}, {"start": 27.54, "end": 29.5, "text": "这才是大荒求天长"}, {"start": 30.26, "end": 35.35, "text": "是我眼灼看错了"}, {"start": 35.67, "end": 37.39, "text": "此子是功法逆修"}, {"start": 37.87, "end": 39.67, "text": "并不是修炼的魔功"}, {"start": 39.67, "end": 41.07, "text": "不是魔修"}, {"start": 41.07, "end": 43.21, "text": "逆修"}, {"start": 43.21, "end": 45.13, "text": "世上真的有磁灯天才"}, {"start": 45.13, "end": 46.13, "text": "不可能"}, {"start": 46.37, "end": 47.33, "text": "他就是魔"}, {"start": 47.33, "end": 48.05, "text": "老子早"}, {"start": 48.05, "end": 49.73, "text": "他们们看你不睡眼了"}, {"start": 52.35, "end": 53.75, "text": "你敢当着这么多人的面"}, {"start": 53.75, "end": 54.83, "text": "杀我"}]}