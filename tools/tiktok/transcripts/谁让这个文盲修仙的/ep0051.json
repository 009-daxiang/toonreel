{"file": "谁让这个文盲修仙的-第51集.mp4", "ep": 51, "duration": 61.1, "segments": [{"start": 0.59, "end": 1.59, "text": "小子"}, {"start": 1.59, "end": 3.59, "text": "你家掌媒告诉你"}, {"start": 3.59, "end": 5.59, "text": "外面有的人不能惹"}, {"start": 5.59, "end": 7.59, "text": "不然怎么死的都不知道"}, {"start": 7.59, "end": 9.17, "text": "怎么"}, {"start": 9.17, "end": 11.62, "text": "你想要弄死你"}, {"start": 11.62, "end": 12.81, "text": "周老"}, {"start": 12.81, "end": 14.96, "text": "你再给我教育教育他"}, {"start": 14.96, "end": 16.96, "text": "除了是我担着"}, {"start": 16.96, "end": 18.5, "text": "小子"}, {"start": 18.5, "end": 20.5, "text": "我便替你家掌门"}, {"start": 20.5, "end": 22.5, "text": "教育教育你"}, {"start": 22.5, "end": 27.77, "text": "你的实力当真苦苦"}, {"start": 27.77, "end": 30.77, "text": "主机能够硬扛金单径"}, {"start": 31.77, "end": 36.26, "text": "浩然宗"}, {"start": 36.26, "end": 38.26, "text": "何时出了这等天降"}, {"start": 38.26, "end": 39.58, "text": "周老"}, {"start": 39.58, "end": 43.22, "text": "我来祝你"}, {"start": 43.22, "end": 44.47, "text": "别急"}, {"start": 44.47, "end": 46.47, "text": "一会儿就该领导他"}, {"start": 46.47, "end": 50.55, "text": "你助机的实力能够硬扛金单径"}, {"start": 50.55, "end": 55.1, "text": "小子"}, {"start": 55.1, "end": 57.1, "text": "话我们已带到"}, {"start": 57.1, "end": 58.1, "text": "今晚敢不敢来"}, {"start": 58.1, "end": 59.1, "text": "看你了"}, {"start": 59.1, "end": 61.1, "text": "公主我们走"}]}