{"file": "谁让这个文盲修仙的-第81集.mp4", "ep": 81, "duration": 61.6, "segments": [{"start": 8.14, "end": 9.42, "text": "秘境开启"}, {"start": 9.94, "end": 11.78, "text": "所有人按顺序进入"}, {"start": 12.1, "end": 12.98, "text": "本次大赛"}, {"start": 13.18, "end": 14.74, "text": "终点为上操之上的入口"}, {"start": 14.74, "end": 15.58, "text": "通天见幕里"}, {"start": 15.82, "end": 16.62, "text": "结果已收获的"}, {"start": 16.62, "end": 17.7, "text": "天才地宝数量"}, {"start": 17.82, "end": 18.9, "text": "珍贵程度排名"}, {"start": 19.02, "end": 19.78, "text": "从而获得进入"}, {"start": 19.78, "end": 21.06, "text": "上操之上的名额"}, {"start": 21.3, "end": 23.3, "text": "本次大赛没有任何规定"}, {"start": 23.3, "end": 24.3, "text": "生死由命"}, {"start": 24.3, "end": 25.62, "text": "全凭自己实力"}, {"start": 25.62, "end": 26.74, "text": "量力而行"}, {"start": 34.48, "end": 35.36, "text": "小子"}, {"start": 35.68, "end": 37.8, "text": "但愿秘境中别遇到我"}, {"start": 38.12, "end": 39.88, "text": "不然你可就惨了"}, {"start": 42.89, "end": 43.81, "text": "他们三哥"}, {"start": 44.13, "end": 45.21, "text": "怎么可以先进去"}, {"start": 45.9, "end": 47.94, "text": "三大神族排名最靠前"}, {"start": 47.94, "end": 49.62, "text": "肯定要他们最先进入"}, {"start": 49.62, "end": 51.46, "text": "然后就是我们浩然宗"}, {"start": 51.46, "end": 52.14, "text": "去吧"}, {"start": 52.38, "end": 57.68, "text": "你俩发什么愣呢"}, {"start": 57.68, "end": 58.88, "text": "还不赶紧进去"}, {"start": 58.88, "end": 59.88, "text": "越扫兴去获得的"}, {"start": 59.88, "end": 61.6, "text": "天才地宝珍贵程度就越高"}]}