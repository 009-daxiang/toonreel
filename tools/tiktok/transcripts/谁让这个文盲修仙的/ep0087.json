{"file": "谁让这个文盲修仙的-第87集.mp4", "ep": 87, "duration": 62.3, "segments": [{"start": 0.0, "end": 1.72, "text": "就你们是不可能的"}, {"start": 2.4, "end": 3.12, "text": "你们都成为"}, {"start": 3.12, "end": 5.12, "text": "更精花蕊的养分吗"}, {"start": 5.7, "end": 7.14, "text": "甚至还可能使花蕊"}, {"start": 7.14, "end": 9.54, "text": "突破顶级领寶的层次"}, {"start": 10.62, "end": 12.5, "text": "更精花蕊终于到手了"}, {"start": 12.86, "end": 13.62, "text": "有了它"}, {"start": 13.82, "end": 14.82, "text": "我得黄道龙器"}, {"start": 14.82, "end": 16.5, "text": "绝对可以更上一层楼"}, {"start": 18.39, "end": 19.55, "text": "不愧是我儿"}, {"start": 19.91, "end": 20.83, "text": "罕金沙漠的"}, {"start": 20.83, "end": 22.43, "text": "顶级之宝到手了"}, {"start": 22.71, "end": 23.27, "text": "不错"}, {"start": 23.51, "end": 24.23, "text": "黄道龙器"}, {"start": 24.23, "end": 25.95, "text": "本就是至高自强之气"}, {"start": 26.27, "end": 27.83, "text": "有了更精花蕊的加持"}, {"start": 28.15, "end": 28.99, "text": "绝对有朝着"}, {"start": 28.99, "end": 30.27, "text": "更高的层次突破"}, {"start": 30.27, "end": 31.59, "text": "我劝你现在担心一下"}, {"start": 31.59, "end": 32.43, "text": "你儿子吧"}, {"start": 32.43, "end": 33.51, "text": "再不走的话"}, {"start": 33.51, "end": 35.43, "text": "陈吉林兰天可就到了"}, {"start": 38.78, "end": 39.5, "text": "来不及了"}, {"start": 39.9, "end": 40.62, "text": "已经到了"}]}