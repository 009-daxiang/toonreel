{"file": "谁让这个文盲修仙的-第103集.mp4", "ep": 103, "duration": 69.8, "segments": [{"start": 1.87, "end": 2.95, "text": "他在做什么"}, {"start": 3.23, "end": 4.79, "text": "为什么还不出手帮他"}, {"start": 5.15, "end": 8.15, "text": "难不成他们之间有矛盾"}, {"start": 8.55, "end": 9.43, "text": "完了完了"}, {"start": 9.75, "end": 11.19, "text": "师之如何在一起"}, {"start": 11.35, "end": 13.39, "text": "这种旁人大物怎么打呀"}, {"start": 17.38, "end": 18.22, "text": "变蓝天"}, {"start": 19.13, "end": 20.81, "text": "你可知道何为修世"}, {"start": 22.42, "end": 23.7, "text": "还请圣子解惑"}, {"start": 24.18, "end": 25.14, "text": "我被修世"}, {"start": 25.3, "end": 26.98, "text": "修得便是逆天而行"}, {"start": 27.14, "end": 28.78, "text": "与人争与天斗"}, {"start": 28.78, "end": 29.94, "text": "其乐无穷"}, {"start": 30.66, "end": 32.38, "text": "尤其你身为剑修"}, {"start": 32.86, "end": 33.98, "text": "主修杀法"}, {"start": 34.3, "end": 35.7, "text": "太过于锦小身危"}, {"start": 36.34, "end": 38.02, "text": "未来如何成就一番作为"}, {"start": 38.26, "end": 39.22, "text": "而我"}, {"start": 39.54, "end": 41.58, "text": "便要踏着所有修世的海谷"}, {"start": 41.74, "end": 43.58, "text": "一步一步走到最高"}, {"start": 43.94, "end": 45.62, "text": "我要做最高"}, {"start": 50.14, "end": 51.14, "text": "我被修世"}, {"start": 51.34, "end": 53.26, "text": "与人争与天斗"}, {"start": 53.26, "end": 54.66, "text": "其乐无穷"}]}