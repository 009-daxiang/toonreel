{"file": "谁让这个文盲修仙的-第88集.mp4", "ep": 88, "duration": 69.0, "segments": [{"start": 0.0, "end": 1.0, "text": "夏皇子啊"}, {"start": 1.28, "end": 2.16, "text": "又见面了"}, {"start": 2.56, "end": 3.2, "text": "想我了吗"}, {"start": 3.2, "end": 4.08, "text": "陈锦"}, {"start": 4.4, "end": 6.12, "text": "为什么总是阴魂不散"}, {"start": 6.12, "end": 7.4, "text": "你是怎么找到我的"}, {"start": 7.4, "end": 8.88, "text": "我可不是特意找你的"}, {"start": 8.88, "end": 10.8, "text": "可能是你我之间缘分拨身"}, {"start": 10.8, "end": 12.92, "text": "被命运紧紧地捆绑在了一起"}, {"start": 13.36, "end": 13.96, "text": "滚"}, {"start": 14.16, "end": 15.56, "text": "我没有楼阳之匹"}, {"start": 21.33, "end": 22.05, "text": "好啊"}, {"start": 22.53, "end": 23.69, "text": "出手伤人"}, {"start": 24.25, "end": 25.21, "text": "给我把你手中的"}, {"start": 25.21, "end": 26.81, "text": "天才第五都交出来"}, {"start": 27.29, "end": 27.97, "text": "不然"}, {"start": 30.43, "end": 31.15, "text": "不然"}, {"start": 31.39, "end": 32.85, "text": "打死你"}, {"start": 32.85, "end": 35.38, "text": "陈锦"}, {"start": 36.34, "end": 38.06, "text": "我劝你赶快离开秘境"}, {"start": 38.06, "end": 39.22, "text": "耀天神子可是在"}, {"start": 39.22, "end": 40.38, "text": "满秘境地找你"}, {"start": 40.38, "end": 41.66, "text": "只要你肯离开"}, {"start": 41.66, "end": 43.95, "text": "我就当作没有见过你"}, {"start": 43.95, "end": 44.79, "text": "不然"}, {"start": 45.65, "end": 47.49, "text": "我捏碎这枚玉佩"}, {"start": 47.49, "end": 50.04, "text": "耀天神子即刻就会出现"}, {"start": 50.04, "end": 51.2, "text": "捏吧"}, {"start": 51.2, "end": 53.86, "text": "我看是他来得快"}, {"start": 53.86, "end": 55.98, "text": "还是你死得快"}, {"start": 67.18, "end": 68.86, "text": "看来你没机会了"}]}