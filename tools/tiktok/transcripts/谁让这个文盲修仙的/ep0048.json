{"file": "谁让这个文盲修仙的-第48集.mp4", "ep": 48, "duration": 64.6, "segments": [{"start": 0.0, "end": 0.96, "text": "要我说啊"}, {"start": 0.96, "end": 2.16, "text": "这届比拼圣子"}, {"start": 2.16, "end": 3.68, "text": "绝对能力压群熊"}, {"start": 4.08, "end": 5.32, "text": "最近我听说"}, {"start": 5.76, "end": 7.28, "text": "浩然宗的灵郎天"}, {"start": 7.28, "end": 8.52, "text": "风头很盛啊"}, {"start": 8.8, "end": 9.48, "text": "圣子"}, {"start": 9.48, "end": 11.04, "text": "这灵郎天算个屁啊"}, {"start": 11.04, "end": 12.84, "text": "您可是修炼了大日不灭旧"}, {"start": 12.84, "end": 14.28, "text": "单手就能镇压他"}, {"start": 16.22, "end": 18.54, "text": "现在的人真猖狂"}, {"start": 18.54, "end": 21.78, "text": "哪来的废物"}, {"start": 22.02, "end": 24.07, "text": "敢说我"}, {"start": 25.78, "end": 28.14, "text": "我说你猖狂说错了吗"}, {"start": 28.42, "end": 29.66, "text": "好大的胆子"}, {"start": 30.14, "end": 31.54, "text": "你家掌门没教过你"}, {"start": 31.54, "end": 32.66, "text": "出门在外"}, {"start": 32.66, "end": 34.18, "text": "有的话不能说"}, {"start": 34.54, "end": 36.3, "text": "有的人不能惹"}, {"start": 36.3, "end": 51.24, "text": "二位"}, {"start": 51.24, "end": 53.4, "text": "我们是穷宵圣地之人"}, {"start": 53.4, "end": 55.26, "text": "可否拼个桌"}, {"start": 55.26, "end": 56.34, "text": "圣女"}, {"start": 56.34, "end": 57.58, "text": "何必跟他们商量"}, {"start": 57.58, "end": 59.78, "text": "直接轰走不就行了"}, {"start": 59.78, "end": 61.42, "text": "如果你再说这种话"}, {"start": 61.42, "end": 63.54, "text": "这次大比你不用参加了"}, {"start": 63.54, "end": 64.78, "text": "可以回圣地了"}]}