{"file": "末日来临：囤货癖的她又赢麻啦！-第164集.mp4", "ep": 164, "duration": 71.3, "segments": [{"start": 2.18, "end": 2.82, "text": "不可能"}, {"start": 9.7, "end": 10.9, "text": "还在为妖妖生气"}, {"start": 11.38, "end": 12.42, "text": "我跟她只是朋友"}, {"start": 12.58, "end": 13.46, "text": "是她自己粘着我"}, {"start": 13.46, "end": 13.98, "text": "够了"}, {"start": 14.3, "end": 15.06, "text": "我不想听"}, {"start": 16.54, "end": 17.26, "text": "那我问你"}, {"start": 17.74, "end": 18.66, "text": "你们有多少人"}, {"start": 19.18, "end": 20.34, "text": "队友都有什么异能"}, {"start": 20.78, "end": 21.9, "text": "你会告诉外人吗"}, {"start": 22.73, "end": 23.85, "text": "我苏西再爱你"}, {"start": 24.37, "end": 26.05, "text": "也不可能做卖队友的事情"}, {"start": 27.1, "end": 28.3, "text": "我是外人 对吧"}, {"start": 29.05, "end": 29.61, "text": "不是吗"}, {"start": 30.17, "end": 32.05, "text": "我对你来说又是什么"}, {"start": 34.03, "end": 34.51, "text": "算了"}, {"start": 35.18, "end": 35.82, "text": "我受够了"}, {"start": 36.26, "end": 37.18, "text": "从今天开始"}, {"start": 37.66, "end": 38.62, "text": "我们就是陌生人"}, {"start": 38.98, "end": 39.46, "text": "行"}, {"start": 40.1, "end": 41.02, "text": "你别后悔"}, {"start": 41.66, "end": 42.18, "text": "学姐"}, {"start": 42.54, "end": 43.78, "text": "这里早上还发早餐"}, {"start": 44.1, "end": 45.9, "text": "小小姐说你没吃饭就下来了"}, {"start": 46.06, "end": 46.7, "text": "让我找你"}, {"start": 49.9, "end": 50.82, "text": "下来就下来"}, {"start": 51.14, "end": 52.1, "text": "头发也不擦一下"}, {"start": 55.33, "end": 56.01, "text": "怕你饿着"}, {"start": 57.33, "end": 58.13, "text": "你又是谁"}, {"start": 59.18, "end": 59.62, "text": "别闹"}, {"start": 60.26, "end": 61.02, "text": "我们在说事"}, {"start": 61.3, "end": 61.98, "text": "你先上去"}, {"start": 65.73, "end": 66.73, "text": "原来有别人了"}, {"start": 67.47, "end": 68.35, "text": "难怪这么绝绝"}, {"start": 69.88, "end": 70.84, "text": "你跟她睡了"}]}