{"file": "永夜苟神：十万住户供我发育-第137集.mp4", "ep": 137, "duration": 49.5, "segments": [{"start": 0.76, "end": 1.72, "text": "他来干什么"}, {"start": 3.52, "end": 4.44, "text": "陈安同学"}, {"start": 4.44, "end": 5.56, "text": "能不能探比交易"}, {"start": 5.76, "end": 6.44, "text": "交易"}, {"start": 6.96, "end": 7.76, "text": "进来说吧"}, {"start": 9.96, "end": 11.04, "text": "你之前说"}, {"start": 11.16, "end": 12.68, "text": "只要给你带回礼包"}, {"start": 12.8, "end": 14.88, "text": "就帮忙把房门升到四级"}, {"start": 15.16, "end": 17.12, "text": "这话还算不算数"}, {"start": 17.12, "end": 18.4, "text": "我当众说的话"}, {"start": 18.68, "end": 19.56, "text": "自然算数"}, {"start": 19.56, "end": 20.56, "text": "只要有礼包"}, {"start": 20.68, "end": 22.16, "text": "我不管里面开出什么"}, {"start": 22.32, "end": 23.76, "text": "都保你一扇四级门"}, {"start": 24.64, "end": 25.24, "text": "好"}, {"start": 25.68, "end": 27.48, "text": "我已经把礼包挂在了交易平台上"}, {"start": 27.76, "end": 29.24, "text": "指定了交易对象是你"}, {"start": 29.8, "end": 31.56, "text": "只要你现在去帮我升四级门"}, {"start": 31.8, "end": 33.16, "text": "礼包就是你的"}, {"start": 35.91, "end": 37.19, "text": "房贝心挺重啊"}, {"start": 37.39, "end": 38.43, "text": "怕我黑吃黑"}, {"start": 38.83, "end": 40.63, "text": "连东西都不敢直接拿出来"}, {"start": 40.91, "end": 41.43, "text": "聪明"}, {"start": 41.43, "end": 42.23, "text": "喝口水"}, {"start": 42.35, "end": 43.95, "text": "开放你的房间升级权限"}, {"start": 44.31, "end": 45.35, "text": "你在这屋里待着"}, {"start": 45.55, "end": 46.55, "text": "我去给你生门"}]}