{"file": "永夜苟神：十万住户供我发育-第169集.mp4", "ep": 169, "duration": 53.5, "segments": [{"start": 0.59, "end": 1.59, "text": "白老师"}, {"start": 2.16, "end": 3.36, "text": "我之前的邀请"}, {"start": 3.36, "end": 4.66, "text": "你考虑的怎么样了"}, {"start": 5.19, "end": 6.69, "text": "愿不愿意加入我的房间"}, {"start": 7.19, "end": 11.68, "text": "不缴的地方都没了"}, {"start": 13.18, "end": 13.68, "text": "不急"}, {"start": 14.18, "end": 16.68, "text": "距离明天怪物入侵还有十几个小时"}, {"start": 16.98, "end": 18.68, "text": "白老师可以回去慢慢考虑"}, {"start": 25.56, "end": 27.56, "text": "二十二个金币买来的盲盒"}, {"start": 27.96, "end": 28.76, "text": "让我看看"}, {"start": 28.76, "end": 30.76, "text": "到底能开出什么极品好货"}, {"start": 30.76, "end": 31.26, "text": "来"}, {"start": 31.46, "end": 32.26, "text": "开盲盒"}, {"start": 32.56, "end": 34.26, "text": "是否打开木质宝箱"}, {"start": 34.76, "end": 35.26, "text": "是"}, {"start": 38.95, "end": 39.65, "text": "这么多"}, {"start": 39.95, "end": 40.45, "text": "还不错"}, {"start": 40.95, "end": 41.95, "text": "光是六枚银币"}, {"start": 42.45, "end": 43.95, "text": "就接近一个金币地的价值了"}, {"start": 44.45, "end": 44.95, "text": "而且"}, {"start": 45.45, "end": 46.45, "text": "终于能刷牙了"}, {"start": 46.95, "end": 47.95, "text": "睡醒一股臭味"}, {"start": 47.95, "end": 48.95, "text": "太难顶了"}, {"start": 48.95, "end": 49.95, "text": "你才臭呢"}, {"start": 50.45, "end": 50.95, "text": "不过"}, {"start": 51.45, "end": 52.95, "text": "这卫生纸更是必需品"}]}