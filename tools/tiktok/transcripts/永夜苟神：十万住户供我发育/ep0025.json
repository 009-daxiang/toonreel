{"file": "永夜苟神：十万住户供我发育-第25集.mp4", "ep": 25, "duration": 49.2, "segments": [{"start": 0.27, "end": 1.11, "text": "同学"}, {"start": 1.11, "end": 2.75, "text": "现在情况跟末日类似"}, {"start": 2.75, "end": 4.59, "text": "咱们人类应该抱团取暖"}, {"start": 4.59, "end": 5.99, "text": "不能当独郎啊"}, {"start": 5.99, "end": 6.87, "text": "实在不行"}, {"start": 6.87, "end": 7.95, "text": "我们做个交易"}, {"start": 10.32, "end": 16.3, "text": "居然是铁门"}, {"start": 16.3, "end": 18.2, "text": "这难道是三级房门"}, {"start": 18.2, "end": 20.28, "text": "他没出门送物资和打怪"}, {"start": 20.28, "end": 21.96, "text": "怎么做到这么快升级的"}, {"start": 21.96, "end": 22.92, "text": "昨天他房间里"}, {"start": 22.92, "end": 23.84, "text": "甚至还有糖衣"}, {"start": 23.84, "end": 25.4, "text": "软店 锅碗 瓢盆"}, {"start": 25.4, "end": 27.08, "text": "纯靠天赋强度吗"}, {"start": 27.08, "end": 28.48, "text": "这资源体量简直看"}, {"start": 28.48, "end": 30.24, "text": "比一个大团队了"}, {"start": 30.24, "end": 34.4, "text": "陈安同学"}, {"start": 34.4, "end": 35.32, "text": "在家吗"}, {"start": 35.32, "end": 37.32, "text": "我来跟你谈合作了"}, {"start": 37.32, "end": 39.89, "text": "又来"}, {"start": 40.33, "end": 41.33, "text": "短短一个多小时"}, {"start": 41.33, "end": 42.57, "text": "都第四波了"}, {"start": 42.57, "end": 45.29, "text": "邀请的道德绑架的威胁的"}, {"start": 45.29, "end": 47.38, "text": "果然只要有人的地方"}, {"start": 47.38, "end": 49.1, "text": "就会有无穷的争斗"}]}