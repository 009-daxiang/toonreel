{"file": "永夜苟神：十万住户供我发育-第63集.mp4", "ep": 63, "duration": 52.1, "segments": [{"start": 0.0, "end": 0.56, "text": "不急"}, {"start": 0.76, "end": 1.6, "text": "先凑材料"}, {"start": 1.8, "end": 2.76, "text": "只要材料够"}, {"start": 2.76, "end": 4.36, "text": "空间的问题自然能解决"}, {"start": 4.6, "end": 6.4, "text": "徐伯能爆出扩容图纸"}, {"start": 6.4, "end": 7.44, "text": "别人肯定也能"}, {"start": 7.76, "end": 9.0, "text": "我手里物资充足"}, {"start": 9.16, "end": 10.16, "text": "绝对能买到"}, {"start": 11.76, "end": 13.16, "text": "另一张图纸是什么"}, {"start": 13.36, "end": 15.52, "text": "一张积累的百剑图纸"}, {"start": 16.19, "end": 18.35, "text": "本来我想要另一张防弩图纸的"}, {"start": 18.75, "end": 20.55, "text": "徐伯他们死活不愿意让"}, {"start": 20.91, "end": 21.91, "text": "防弩"}, {"start": 22.39, "end": 23.51, "text": "攻击性武器"}, {"start": 23.71, "end": 24.11, "text": "对"}, {"start": 24.19, "end": 25.39, "text": "现在房间里的弩"}, {"start": 25.39, "end": 27.63, "text": "如果房门被迫会自动攻击外来者"}, {"start": 27.91, "end": 29.47, "text": "可惜他们占七成收益"}, {"start": 29.47, "end": 30.23, "text": "我抢不过来"}, {"start": 30.23, "end": 31.79, "text": "能在门内多一层防御"}, {"start": 31.99, "end": 33.07, "text": "确实是好东西"}, {"start": 33.63, "end": 35.59, "text": "看来徐伯他们今天的收益很高啊"}, {"start": 35.91, "end": 37.47, "text": "手里至少两三张图纸"}, {"start": 38.89, "end": 40.13, "text": "而且我严重怀疑"}, {"start": 40.33, "end": 41.93, "text": "他们肯定还隐藏了一部分资源"}, {"start": 41.93, "end": 42.53, "text": "没拿出来"}, {"start": 42.53, "end": 43.33, "text": "不用怀疑"}, {"start": 43.65, "end": 45.21, "text": "他们一定隐藏了不少东西"}, {"start": 45.45, "end": 46.87, "text": "明明我们的作用最大"}, {"start": 47.07, "end": 48.15, "text": "引了全路道的怪"}, {"start": 48.47, "end": 49.15, "text": "要不是我们"}, {"start": 49.15, "end": 50.47, "text": "他们能那么轻松偷袭"}, {"start": 50.67, "end": 52.07, "text": "只不定要死多少人呢"}]}