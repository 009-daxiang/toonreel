{"file": "我李长生重回八零，赶山狩猎养妻女-第136集.mp4", "ep": 136, "duration": 39.6, "segments": [{"start": 0.02, "end": 1.3, "text": "放了几十年的东西"}, {"start": 1.3, "end": 2.46, "text": "磕子都救透了"}, {"start": 2.46, "end": 3.26, "text": "磕一下"}, {"start": 3.26, "end": 4.3, "text": "几十磕一起炸"}, {"start": 4.3, "end": 5.1, "text": "扛不能扛"}, {"start": 5.1, "end": 5.78, "text": "流不能流"}, {"start": 5.78, "end": 6.7, "text": "那咋整"}, {"start": 6.7, "end": 10.9, "text": "不命了"}, {"start": 11.58, "end": 12.42, "text": "闭嘴"}, {"start": 12.42, "end": 13.42, "text": "我听水"}, {"start": 13.74, "end": 16.8, "text": "地下十米"}, {"start": 16.8, "end": 17.8, "text": "有条暗河"}, {"start": 18.31, "end": 19.19, "text": "有河能打的"}, {"start": 19.19, "end": 20.39, "text": "还能把毒气淹了"}, {"start": 20.83, "end": 23.31, "text": "对"}, {"start": 23.71, "end": 24.63, "text": "真严"}, {"start": 25.54, "end": 26.62, "text": "地下水压大"}, {"start": 26.86, "end": 28.18, "text": "只要把岩层打开"}, {"start": 28.18, "end": 29.34, "text": "让暗河倒灌"}, {"start": 29.34, "end": 30.34, "text": "那有救了"}, {"start": 31.01, "end": 31.81, "text": "那你呢"}, {"start": 33.14, "end": 34.02, "text": "我留最后"}, {"start": 34.34, "end": 36.29, "text": "长生"}, {"start": 36.29, "end": 37.09, "text": "这是命令"}, {"start": 37.09, "end": 37.65, "text": "走"}]}