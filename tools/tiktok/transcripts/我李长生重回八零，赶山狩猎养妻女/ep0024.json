{"file": "我李长生重回八零，赶山狩猎养妻女-第24集.mp4", "ep": 24, "duration": 52.9, "segments": [{"start": 3.86, "end": 4.66, "text": "兄弟"}, {"start": 4.66, "end": 6.34, "text": "咱明人不说暗话"}, {"start": 6.34, "end": 7.46, "text": "两千"}, {"start": 7.46, "end": 10.79, "text": "行"}, {"start": 10.79, "end": 12.54, "text": "紫雕你留下"}, {"start": 12.54, "end": 14.6, "text": "不过"}, {"start": 14.6, "end": 15.96, "text": "这只鸟"}, {"start": 15.96, "end": 17.59, "text": "只是个天头"}, {"start": 17.59, "end": 20.58, "text": "两千块的极品紫雕"}, {"start": 20.58, "end": 22.1, "text": "只是天头"}, {"start": 29.42, "end": 31.81, "text": "这么好的东西"}, {"start": 31.81, "end": 33.53, "text": "给胡老三糟蹋了可惜"}, {"start": 33.53, "end": 34.33, "text": "小子"}, {"start": 34.33, "end": 35.33, "text": "鸟留下"}, {"start": 35.33, "end": 36.05, "text": "人"}, {"start": 36.05, "end": 36.85, "text": "滚"}, {"start": 36.85, "end": 39.21, "text": "你刚才说"}, {"start": 39.21, "end": 40.61, "text": "让我滚"}, {"start": 40.61, "end": 42.18, "text": "咋的"}, {"start": 42.18, "end": 43.58, "text": "听不懂人话"}, {"start": 43.58, "end": 45.89, "text": "这只鸟老子看上了"}, {"start": 46.33, "end": 46.97, "text": "五十块"}, {"start": 46.97, "end": 47.69, "text": "我带走"}, {"start": 47.69, "end": 48.45, "text": "强哥"}, {"start": 48.45, "end": 49.97, "text": "这可是极品火紫雕"}, {"start": 49.97, "end": 51.13, "text": "两千块的货"}, {"start": 51.13, "end": 52.77, "text": "五十块不合规矩"}]}