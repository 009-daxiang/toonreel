{"file": "我李长生重回八零，赶山狩猎养妻女-第155集.mp4", "ep": 155, "duration": 47.2, "segments": [{"start": 1.84, "end": 2.4, "text": "有情况"}, {"start": 2.72, "end": 3.24, "text": "不是人"}, {"start": 5.55, "end": 6.07, "text": "黑虾子"}, {"start": 6.27, "end": 7.03, "text": "这大冷天的"}, {"start": 7.19, "end": 8.35, "text": "黑虾子不都冒冬吗"}, {"start": 8.71, "end": 9.19, "text": "吴雄"}, {"start": 9.43, "end": 10.87, "text": "秋天没贴够标 饿醒了"}, {"start": 11.23, "end": 12.23, "text": "这种没冬眠的黑虾子"}, {"start": 12.23, "end": 12.87, "text": "脾气最暴"}, {"start": 13.11, "end": 14.07, "text": "碰上活物就撕"}, {"start": 14.71, "end": 15.67, "text": "那白镜海那帮人呢"}, {"start": 15.79, "end": 16.39, "text": "咱不追了"}, {"start": 17.7, "end": 18.34, "text": "人跑不了"}, {"start": 18.9, "end": 20.06, "text": "这黑虾子既然撞上了"}, {"start": 20.18, "end": 20.7, "text": "也不能放"}, {"start": 20.78, "end": 21.1, "text": "哥"}, {"start": 21.26, "end": 21.74, "text": "咱一开枪"}, {"start": 21.74, "end": 22.38, "text": "那帮人不就知道"}, {"start": 22.38, "end": 23.06, "text": "咱跟上来了"}, {"start": 23.3, "end": 24.02, "text": "所以不用枪"}, {"start": 24.54, "end": 25.06, "text": "枪一响"}, {"start": 25.22, "end": 25.82, "text": "人得招来"}, {"start": 26.22, "end": 26.86, "text": "不用枪"}, {"start": 27.22, "end": 28.46, "text": "那可是几百斤的黑虾子"}, {"start": 28.98, "end": 30.1, "text": "熊皮打坏了不值钱"}, {"start": 30.18, "end": 31.1, "text": "要是再伤了熊胆"}, {"start": 31.22, "end": 32.06, "text": "这趟更白折腾"}, {"start": 33.36, "end": 33.92, "text": "那咋成"}, {"start": 34.28, "end": 34.8, "text": "套俗"}, {"start": 35.0, "end": 35.36, "text": "弓"}, {"start": 35.52, "end": 35.92, "text": "刀"}, {"start": 36.84, "end": 37.52, "text": "你们跟进我"}, {"start": 37.8, "end": 38.4, "text": "没有我的话"}, {"start": 38.48, "end": 39.2, "text": "谁都别乱动"}, {"start": 43.62, "end": 44.3, "text": "朕在里边"}]}