{"file": "我李长生重回八零，赶山狩猎养妻女-第80集.mp4", "ep": 80, "duration": 39.6, "segments": [{"start": 1.55, "end": 2.75, "text": "我再问一遍"}, {"start": 3.28, "end": 5.8, "text": "谁开的枪"}, {"start": 7.9, "end": 9.5, "text": "一条畜生也敢拦弓雾"}, {"start": 9.5, "end": 10.7, "text": "老子连他一块"}, {"start": 12.8, "end": 14.8, "text": "刚才那枪是你开的"}, {"start": 15.2, "end": 16.0, "text": "李长生"}, {"start": 16.2, "end": 17.4, "text": "我们是县领导"}, {"start": 17.4, "end": 18.6, "text": "你敢拿枪敌我"}, {"start": 19.0, "end": 20.0, "text": "我问你"}, {"start": 20.2, "end": 22.07, "text": "是不是你开的"}, {"start": 22.47, "end": 26.15, "text": "长生"}, {"start": 26.35, "end": 27.75, "text": "别真绕出人命"}, {"start": 27.95, "end": 29.15, "text": "说 我有说"}, {"start": 29.35, "end": 34.49, "text": "听"}, {"start": 34.49, "end": 35.09, "text": "别动"}]}