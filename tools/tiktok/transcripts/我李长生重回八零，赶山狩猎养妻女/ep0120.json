{"file": "我李长生重回八零，赶山狩猎养妻女-第120集.mp4", "ep": 120, "duration": 47.0, "segments": [{"start": 0.21, "end": 0.89, "text": "长生"}, {"start": 1.83, "end": 2.95, "text": "老鼠长 是我"}, {"start": 3.27, "end": 3.95, "text": "出事了"}, {"start": 4.94, "end": 6.9, "text": "有人拿着省里的公文进了靠山屯"}, {"start": 7.46, "end": 8.06, "text": "姓白"}, {"start": 8.73, "end": 9.37, "text": "叫什么"}, {"start": 10.48, "end": 11.16, "text": "白景山"}, {"start": 12.16, "end": 12.96, "text": "白景山"}, {"start": 13.48, "end": 15.17, "text": "你认识"}, {"start": 15.53, "end": 17.01, "text": "白景山原名白鹤鸣"}, {"start": 17.21, "end": 17.89, "text": "建国前"}, {"start": 18.01, "end": 19.93, "text": "他爹就是给激动军带路的汉奸"}, {"start": 20.09, "end": 21.65, "text": "这小王不但后来逃到境外"}, {"start": 21.73, "end": 23.21, "text": "专门给敌对势力捣腾文物"}, {"start": 23.29, "end": 23.81, "text": "情报"}, {"start": 24.66, "end": 25.66, "text": "那份省里公文"}, {"start": 25.74, "end": 26.34, "text": "假的"}, {"start": 26.54, "end": 27.54, "text": "我们这里出了内鬼"}, {"start": 27.62, "end": 28.58, "text": "给他弄的假身份"}, {"start": 29.02, "end": 30.94, "text": "李长生"}, {"start": 31.18, "end": 32.02, "text": "给我滚出来"}, {"start": 32.91, "end": 33.59, "text": "老鼠长"}, {"start": 34.15, "end": 35.19, "text": "人就在我院子里"}, {"start": 35.43, "end": 36.03, "text": "咋处理"}, {"start": 36.46, "end": 37.06, "text": "李长生"}, {"start": 40.0, "end": 41.32, "text": "白景山极度危险"}, {"start": 41.56, "end": 43.16, "text": "手里占过我们同志的血"}, {"start": 43.44, "end": 44.68, "text": "我给你最高授权"}, {"start": 44.92, "end": 45.76, "text": "就地正法"}, {"start": 46.04, "end": 46.84, "text": "不留活口"}]}