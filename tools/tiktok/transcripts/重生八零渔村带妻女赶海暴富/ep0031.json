{"file": "重生八零渔村带妻女赶海暴富-第31集.mp4", "ep": 31, "duration": 65.0, "segments": [{"start": 3.32, "end": 4.92, "text": "老弟 这是来开船吗"}, {"start": 9.98, "end": 11.06, "text": "我想趁着退潮"}, {"start": 11.06, "end": 12.34, "text": "找个孤岛弄点窍祸"}, {"start": 12.34, "end": 13.78, "text": "准备找王哥你买点冰块"}, {"start": 15.82, "end": 16.82, "text": "昨天出海"}, {"start": 16.98, "end": 18.5, "text": "因为准备不足没弄冰"}, {"start": 18.9, "end": 19.78, "text": "不过还好"}, {"start": 20.57, "end": 22.17, "text": "可能因为昨天一直下雨"}, {"start": 22.65, "end": 24.37, "text": "那些雨坚持到了避风港"}, {"start": 25.1, "end": 26.66, "text": "媳妇 给弄击桶冰"}, {"start": 27.14, "end": 28.26, "text": "老弟需要多少冰块"}, {"start": 28.26, "end": 29.14, "text": "五桶够不够"}, {"start": 29.14, "end": 30.38, "text": "够了 多少钱"}, {"start": 30.7, "end": 32.58, "text": "老弟 你这话说的"}, {"start": 32.58, "end": 33.58, "text": "想打我脸不是"}, {"start": 34.02, "end": 35.58, "text": "自家兄弟要击桶冰"}, {"start": 35.58, "end": 36.58, "text": "我王志强"}, {"start": 36.58, "end": 37.94, "text": "难道还能要你钱吗"}, {"start": 39.42, "end": 40.46, "text": "这样不好吧"}, {"start": 40.46, "end": 41.7, "text": "有什么不好的"}, {"start": 41.7, "end": 42.5, "text": "以后你要冰"}, {"start": 42.5, "end": 43.62, "text": "只管找我拿"}, {"start": 43.62, "end": 44.74, "text": "哥哥免费赠送"}, {"start": 44.74, "end": 45.62, "text": "分文不取"}, {"start": 46.5, "end": 47.58, "text": "那谢谢哥哥了"}, {"start": 47.58, "end": 48.54, "text": "自家兄弟说什么"}, {"start": 48.54, "end": 49.5, "text": "谢不谢的"}, {"start": 49.5, "end": 50.78, "text": "以后老弟有了好货"}, {"start": 50.78, "end": 51.7, "text": "只管送过来"}, {"start": 51.7, "end": 53.3, "text": "哥哥一定给你高价"}, {"start": 60.3, "end": 62.87, "text": "这次我要再干一条大的"}]}