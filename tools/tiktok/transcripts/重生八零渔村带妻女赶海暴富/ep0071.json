{"file": "重生八零渔村带妻女赶海暴富-第71集.mp4", "ep": 71, "duration": 99.1, "segments": [{"start": 0.0, "end": 0.88, "text": "我骗人"}, {"start": 1.56, "end": 3.04, "text": "那我倒要问问你胡麻子"}, {"start": 3.32, "end": 4.56, "text": "你能五块三一斤"}, {"start": 4.72, "end": 6.08, "text": "把这些对下都给收了吗"}, {"start": 6.86, "end": 8.1, "text": "你按照五块三收的"}, {"start": 8.74, "end": 10.94, "text": "码头上对下的价格常年在五块"}, {"start": 11.3, "end": 13.5, "text": "顶多网上浮动一毛两毛"}, {"start": 13.86, "end": 15.14, "text": "五块三这个价格"}, {"start": 15.3, "end": 16.62, "text": "确实超出市场价了"}, {"start": 17.14, "end": 18.9, "text": "要知道我们这些余贩子正的"}, {"start": 19.22, "end": 20.74, "text": "就是这一毛两毛的力呀"}, {"start": 22.0, "end": 22.64, "text": "小老弟"}, {"start": 22.96, "end": 24.16, "text": "王胖子真是五块三一斤"}, {"start": 24.16, "end": 24.88, "text": "收的你的货"}, {"start": 25.36, "end": 27.12, "text": "昨天是按照五块三收的"}, {"start": 27.6, "end": 29.92, "text": "强哥说今天给我按五块四来着"}, {"start": 30.56, "end": 31.2, "text": "对吧 强哥"}, {"start": 32.14, "end": 33.38, "text": "好 你个小白脸"}, {"start": 33.78, "end": 35.38, "text": "老子故意说多了一毛钱"}, {"start": 35.62, "end": 37.3, "text": "本来是想下退其他余贩子"}, {"start": 37.46, "end": 38.66, "text": "没想到你压更黑"}, {"start": 38.9, "end": 40.14, "text": "居然还想趁火打劫"}, {"start": 40.3, "end": 41.1, "text": "再加一毛"}, {"start": 41.65, "end": 43.45, "text": "趴在我王胖子身上吸血"}, {"start": 46.9, "end": 47.74, "text": "老子不过了"}, {"start": 48.1, "end": 48.58, "text": "没错"}, {"start": 49.22, "end": 51.22, "text": "五块四 我们俩都说好了"}, {"start": 51.74, "end": 52.9, "text": "行啊 你王胖子"}, {"start": 53.26, "end": 54.66, "text": "刚才是老子小看你了"}, {"start": 54.94, "end": 55.94, "text": "没想到你小子"}, {"start": 56.06, "end": 57.5, "text": "居然也有做慈善的一天"}, {"start": 58.42, "end": 59.1, "text": "你懂什么"}, {"start": 59.62, "end": 60.86, "text": "都说了这是我小舅子"}, {"start": 61.38, "end": 62.98, "text": "一家人我可不得照顾着点吗"}, {"start": 66.46, "end": 67.58, "text": "真以为我王胖子"}, {"start": 67.74, "end": 69.78, "text": "在碧峰岗码头白混这么多年呢"}, {"start": 70.14, "end": 71.66, "text": "张建国不到一周的时间"}, {"start": 71.82, "end": 73.5, "text": "就能接连弄到三批几批货"}, {"start": 73.7, "end": 74.78, "text": "这已经不是运气好"}, {"start": 75.06, "end": 76.42, "text": "应该说是龙王爷保佑"}, {"start": 76.74, "end": 77.74, "text": "与这样的人交往"}, {"start": 77.94, "end": 79.82, "text": "当然是放长线 调大"}, {"start": 80.18, "end": 81.34, "text": "让他看出我的可靠"}, {"start": 81.58, "end": 82.62, "text": "跟我长期合作"}, {"start": 82.98, "end": 85.22, "text": "如此才能利益最大化"}, {"start": 93.94, "end": 94.7, "text": "建国弟弟"}, {"start": 95.18, "end": 96.9, "text": "你昨天怎么到我哥那里去了"}]}