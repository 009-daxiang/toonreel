{"file": "重生八零渔村带妻女赶海暴富-第134集.mp4", "ep": 134, "duration": 64.9, "segments": [{"start": 0.0, "end": 0.68, "text": "喂"}, {"start": 7.51, "end": 9.43, "text": "这边这些不到两斤的"}, {"start": 9.43, "end": 11.07, "text": "一斤给你按三块八"}, {"start": 11.07, "end": 12.91, "text": "两斤以上的一斤五块"}, {"start": 15.81, "end": 17.13, "text": "这个最大的"}, {"start": 17.86, "end": 18.66, "text": "这个"}, {"start": 18.86, "end": 20.18, "text": "一斤六块八"}, {"start": 23.82, "end": 24.9, "text": "那黄游戏呢"}, {"start": 24.9, "end": 31.17, "text": "可是四有黄银儿"}, {"start": 31.17, "end": 33.33, "text": "他的价格还是大家最关心的"}, {"start": 33.53, "end": 34.57, "text": "我要是给他们一整个"}, {"start": 34.57, "end": 36.33, "text": "这个收购站很黑的印象"}, {"start": 36.33, "end": 38.44, "text": "以后就没人来我这新鲜货了"}, {"start": 40.19, "end": 41.27, "text": "说来也巧"}, {"start": 41.43, "end": 43.19, "text": "我这边有个市里头的"}, {"start": 43.19, "end": 44.83, "text": "海鲜酒店大老板"}, {"start": 44.83, "end": 46.35, "text": "正想要黄游戏"}, {"start": 46.35, "end": 47.39, "text": "招待贵客"}, {"start": 47.83, "end": 49.11, "text": "建国你运气好"}, {"start": 49.39, "end": 50.43, "text": "他给的价格"}, {"start": 50.43, "end": 52.35, "text": "一斤足足有九块八"}, {"start": 54.98, "end": 55.82, "text": "好家伙"}, {"start": 56.14, "end": 57.38, "text": "张建国这一天"}, {"start": 57.38, "end": 58.26, "text": "竟然搞到了别人"}, {"start": 58.26, "end": 59.22, "text": "半年的收货"}, {"start": 59.58, "end": 60.5, "text": "难道说"}, {"start": 60.78, "end": 62.06, "text": "他们家的小船"}, {"start": 62.06, "end": 63.02, "text": "真的有说法"}]}