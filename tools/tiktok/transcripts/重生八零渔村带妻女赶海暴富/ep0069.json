{"file": "重生八零渔村带妻女赶海暴富-第69集.mp4", "ep": 69, "duration": 62.2, "segments": [{"start": 2.12, "end": 3.08, "text": "强哥 强哥"}, {"start": 3.28, "end": 4.24, "text": "来收货了"}, {"start": 13.14, "end": 14.38, "text": "老弟 你牛逼啊"}, {"start": 14.74, "end": 16.02, "text": "又弄这么多对瞎"}, {"start": 16.54, "end": 17.54, "text": "凌晨就起来了"}, {"start": 17.7, "end": 18.66, "text": "就想着做搞点"}, {"start": 19.1, "end": 19.94, "text": "怎么样 强哥"}, {"start": 20.26, "end": 21.82, "text": "昨天的对瞎都消出去了吧"}, {"start": 22.47, "end": 23.59, "text": "老弟 你说笑呢"}, {"start": 23.95, "end": 24.99, "text": "就哥哥这本事"}, {"start": 25.07, "end": 26.31, "text": "别说三百斤对瞎"}, {"start": 26.55, "end": 27.71, "text": "就是再来三千斤"}, {"start": 27.79, "end": 29.31, "text": "我也能都当天给你卖出去"}, {"start": 29.67, "end": 31.63, "text": "昨天卖掉那三百斤大对瞎"}, {"start": 31.83, "end": 33.55, "text": "我可是足足赚了一百多"}, {"start": 34.77, "end": 35.61, "text": "真要那样"}, {"start": 35.77, "end": 37.13, "text": "王哥 你不得发大财啊"}, {"start": 39.32, "end": 39.68, "text": "那当"}, {"start": 39.76, "end": 40.24, "text": "不对"}, {"start": 41.02, "end": 42.1, "text": "卖给我对瞎的人"}, {"start": 42.14, "end": 43.22, "text": "就在眼前站着呢"}, {"start": 43.46, "end": 44.54, "text": "可不能瞎嘚瑟"}, {"start": 44.74, "end": 45.94, "text": "影响以后的合作"}, {"start": 46.82, "end": 48.02, "text": "我发不发财的"}, {"start": 48.14, "end": 49.66, "text": "还是得养仗老弟你"}, {"start": 50.22, "end": 50.94, "text": "你吃肉"}, {"start": 51.1, "end": 52.54, "text": "我跟着喝点汤就行"}, {"start": 53.43, "end": 54.39, "text": "王哥说笑了"}, {"start": 54.91, "end": 56.07, "text": "你有那么大的买卖"}, {"start": 56.23, "end": 57.35, "text": "雇佣好几个工人"}, {"start": 57.55, "end": 59.07, "text": "每天都收上万斤海鲜"}, {"start": 59.27, "end": 60.23, "text": "我可跟你比不了"}]}