{"file": "重生八零渔村带妻女赶海暴富-第136集.mp4", "ep": 136, "duration": 52.6, "segments": [{"start": 1.1, "end": 2.1, "text": "高价"}, {"start": 3.1, "end": 4.1, "text": "多高"}, {"start": 4.93, "end": 5.93, "text": "那我不知道"}, {"start": 6.33, "end": 7.73, "text": "反正应该比你给的高"}, {"start": 14.77, "end": 15.77, "text": "建军舅舅"}, {"start": 16.25, "end": 17.89, "text": "你真要直接过去闹事吗"}, {"start": 18.45, "end": 20.37, "text": "我小舅的拳头可不是开玩笑"}, {"start": 25.49, "end": 26.77, "text": "你这个小兔崽子"}, {"start": 27.01, "end": 28.65, "text": "你是吃了熊心豹子胆了"}, {"start": 28.77, "end": 29.93, "text": "居然这么说我"}, {"start": 37.11, "end": 37.87, "text": "别别别"}, {"start": 37.99, "end": 38.75, "text": "小祖宗"}, {"start": 38.99, "end": 40.15, "text": "我不打你了行不"}, {"start": 40.51, "end": 41.47, "text": "你别喊啊"}, {"start": 45.78, "end": 47.06, "text": "你要是想买我小舅舅的船"}, {"start": 47.06, "end": 47.98, "text": "就出高价"}, {"start": 48.22, "end": 49.5, "text": "只要价钱比别人高"}, {"start": 49.5, "end": 50.82, "text": "我舅舅肯定会卖给你"}]}