{"file": "重生八零渔村带妻女赶海暴富-第26集.mp4", "ep": 26, "duration": 89.9, "segments": [{"start": 6.74, "end": 7.58, "text": "什么玩意"}, {"start": 8.86, "end": 12.53, "text": "这是漏雨了"}, {"start": 13.39, "end": 14.43, "text": "几十年的房子"}, {"start": 14.75, "end": 16.19, "text": "漏雨简直太正常不过"}, {"start": 16.51, "end": 18.07, "text": "这些水桶 盆子"}, {"start": 18.35, "end": 20.27, "text": "想来应该是老娘或者雅琴她们"}, {"start": 20.35, "end": 21.47, "text": "在发现漏雨之后"}, {"start": 21.67, "end": 23.59, "text": "不忍心朝醒我 偷偷放她"}, {"start": 23.71, "end": 25.03, "text": "虽然老娘和雅琴她们"}, {"start": 25.03, "end": 26.23, "text": "表面对我态度不好"}, {"start": 26.51, "end": 27.31, "text": "可实际上"}, {"start": 27.55, "end": 28.87, "text": "她们还是很关心我的"}, {"start": 29.03, "end": 36.54, "text": "小月这是忘记了锁门了"}, {"start": 36.7, "end": 45.26, "text": "你不是说喝完海鲜鱼汤"}, {"start": 45.26, "end": 46.18, "text": "这有奶了吗"}, {"start": 46.49, "end": 48.05, "text": "这孩子有的痴子还在哭"}, {"start": 50.88, "end": 51.48, "text": "不知道"}, {"start": 51.72, "end": 53.44, "text": "可能是被雷声和风声吓到了"}, {"start": 53.99, "end": 54.79, "text": "有可能"}, {"start": 55.19, "end": 56.71, "text": "你这么抱着她哄了多久了"}, {"start": 56.95, "end": 58.15, "text": "两个多小时了"}, {"start": 58.31, "end": 60.23, "text": "刚才一直抱着她在屋里转悠"}, {"start": 60.35, "end": 61.11, "text": "刚坐下"}, {"start": 61.43, "end": 62.51, "text": "两个多小时"}, {"start": 62.71, "end": 63.75, "text": "那得多累啊"}, {"start": 72.02, "end": 73.14, "text": "我一抱就不哭"}, {"start": 73.38, "end": 74.46, "text": "这丫头跟我亲"}, {"start": 76.14, "end": 77.54, "text": "明明我哄了两个多小时"}, {"start": 77.54, "end": 78.54, "text": "都哄不睡她"}, {"start": 79.06, "end": 80.74, "text": "应该确实是被台风吓到了"}, {"start": 81.5, "end": 82.46, "text": "跟爹在一起"}, {"start": 82.78, "end": 83.78, "text": "闻到爹的味道"}, {"start": 84.16, "end": 85.4, "text": "小丫头有了安全感"}, {"start": 85.6, "end": 86.32, "text": "就困了"}]}