{"file": "重生八零渔村带妻女赶海暴富-第1集.mp4", "ep": 1, "duration": 204.5, "segments": [{"start": 1.62, "end": 3.06, "text": "张建国 你个秦兽"}, {"start": 3.06, "end": 4.7, "text": "你都已经还不快下来"}, {"start": 5.5, "end": 11.7, "text": "竟然重生了"}, {"start": 12.38, "end": 13.1, "text": "眼前的女人"}, {"start": 13.1, "end": 14.22, "text": "是我的第三个前妻"}, {"start": 14.22, "end": 14.9, "text": "刘晓月"}, {"start": 14.9, "end": 15.62, "text": "三天前"}, {"start": 15.62, "end": 16.62, "text": "我们办了离婚证"}, {"start": 16.62, "end": 17.22, "text": "刚才"}, {"start": 17.5, "end": 18.7, "text": "是我至于家里没人"}, {"start": 18.7, "end": 19.9, "text": "把她拉入我的厨房"}, {"start": 19.9, "end": 20.7, "text": "算了吧"}, {"start": 20.7, "end": 24.4, "text": "你滚出去 你没听到"}, {"start": 31.69, "end": 32.29, "text": "媳妇"}, {"start": 33.25, "end": 34.01, "text": "我想你了"}, {"start": 37.62, "end": 39.02, "text": "你要是针对我有感情"}, {"start": 39.02, "end": 39.86, "text": "怎么会逼着我"}, {"start": 44.75, "end": 45.47, "text": "这些年"}, {"start": 45.95, "end": 47.71, "text": "我的母亲和三个前妻"}, {"start": 48.35, "end": 49.87, "text": "就靠着帮人治愈网"}, {"start": 49.87, "end": 51.03, "text": "养活一大家子"}, {"start": 51.7, "end": 52.78, "text": "上一次"}, {"start": 52.78, "end": 53.74, "text": "明明三个前妻"}, {"start": 53.74, "end": 55.26, "text": "个顶个儿的对我好"}, {"start": 55.26, "end": 56.66, "text": "离婚不离家"}, {"start": 56.66, "end": 57.82, "text": "和老娘一起"}, {"start": 57.82, "end": 59.26, "text": "操持着大小事务"}, {"start": 59.9, "end": 61.1, "text": "每天照顾孩子"}, {"start": 61.46, "end": 62.1, "text": "感慨"}, {"start": 62.61, "end": 63.37, "text": "知语往"}, {"start": 63.37, "end": 64.25, "text": "贴不家用"}, {"start": 65.79, "end": 67.23, "text": "可我却不懂得珍惜"}, {"start": 67.95, "end": 68.95, "text": "我每天除了赌博"}, {"start": 68.95, "end": 69.99, "text": "就是出门糊涕"}, {"start": 71.34, "end": 72.5, "text": "成了小愚村人人"}, {"start": 72.5, "end": 73.78, "text": "逆之不及的该溜子"}, {"start": 74.63, "end": 75.63, "text": "直到三个前妻"}, {"start": 75.63, "end": 76.59, "text": "在海滩感慨"}, {"start": 77.18, "end": 79.06, "text": "遇到海啸同时惨死"}, {"start": 82.62, "end": 85.43, "text": "我才心无国难"}, {"start": 85.43, "end": 86.11, "text": "媳妇"}, {"start": 86.59, "end": 87.75, "text": "为了也和三个前妻"}, {"start": 87.75, "end": 88.83, "text": "留下的三个孩子"}, {"start": 89.11, "end": 90.47, "text": "我当了远洋传言人"}, {"start": 90.47, "end": 91.75, "text": "因为长期离家"}, {"start": 91.75, "end": 93.07, "text": "我始终觉得很亏欠的"}, {"start": 93.07, "end": 93.75, "text": "三个孩子"}, {"start": 93.75, "end": 95.56, "text": "可是等我老了"}, {"start": 95.56, "end": 96.28, "text": "他们却不及"}, {"start": 96.28, "end": 100.5, "text": "前嫌的在床前尽孝"}, {"start": 100.5, "end": 101.38, "text": "我心中并没有"}, {"start": 101.38, "end": 103.46, "text": "一丝一毫对死亡的剧本"}, {"start": 103.46, "end": 106.26, "text": "不是你三个"}, {"start": 106.26, "end": 111.1, "text": "因为我无能而惨死的前妻"}, {"start": 111.1, "end": 111.82, "text": "回到了一家人"}, {"start": 111.82, "end": 113.14, "text": "还整整棋棋的时候"}, {"start": 113.14, "end": 114.92, "text": "是不知道"}, {"start": 114.92, "end": 115.56, "text": "今天具体是"}, {"start": 115.56, "end": 125.88, "text": "哪年哪月那一天"}, {"start": 125.88, "end": 126.76, "text": "娘"}, {"start": 126.76, "end": 127.56, "text": "走开"}, {"start": 127.56, "end": 129.93, "text": "看到我提着这么重一桶花蛤吗"}, {"start": 129.93, "end": 135.37, "text": "别妨碍我干活"}, {"start": 135.37, "end": 136.33, "text": "娘"}, {"start": 136.33, "end": 139.71, "text": "这些花蛤哪儿来的"}, {"start": 139.71, "end": 141.07, "text": "还能是哪儿"}, {"start": 141.07, "end": 142.83, "text": "当然是村头海滩"}, {"start": 142.83, "end": 143.91, "text": "今天小退潮"}, {"start": 143.91, "end": 146.56, "text": "洪树林那里遍地是花蛤"}, {"start": 146.56, "end": 147.36, "text": "我和雅琪曼玛"}, {"start": 147.36, "end": 148.12, "text": "还有大鸭二鸭"}, {"start": 148.12, "end": 149.2, "text": "捡了一大桶"}, {"start": 149.2, "end": 152.95, "text": "他们让我先弄回来"}, {"start": 152.95, "end": 154.39, "text": "洪树林"}, {"start": 154.39, "end": 155.35, "text": "娘"}, {"start": 155.35, "end": 158.01, "text": "今天是几月几号"}, {"start": 158.01, "end": 159.65, "text": "你赌钱赌傻了"}, {"start": 159.65, "end": 160.57, "text": "今天是八零年"}, {"start": 160.57, "end": 172.7, "text": "四月十六号"}, {"start": 172.7, "end": 174.4, "text": "上个字的今天"}, {"start": 174.4, "end": 175.36, "text": "我的女儿大鸭"}, {"start": 175.36, "end": 177.36, "text": "在跟着大前妻赶海的时候"}, {"start": 177.36, "end": 178.08, "text": "被一条剧毒的"}, {"start": 178.08, "end": 179.4, "text": "咸水蛇咬中"}, {"start": 179.4, "end": 187.14, "text": "当场逼迷"}, {"start": 187.14, "end": 188.58, "text": "母亲受不了这个刺激"}, {"start": 188.58, "end": 188.98, "text": "大鸭"}, {"start": 188.98, "end": 190.22, "text": "头发脑淤血"}, {"start": 190.22, "end": 192.16, "text": "不治好"}, {"start": 192.16, "end": 192.96, "text": "那一天"}, {"start": 193.51, "end": 196.18, "text": "失去了两个亲人"}, {"start": 196.18, "end": 197.25, "text": "大鸭"}, {"start": 197.25, "end": 198.33, "text": "等着爸爸"}]}