{"file": "重生八零渔村带妻女赶海暴富-第146集.mp4", "ep": 146, "duration": 102.3, "segments": [{"start": 1.14, "end": 2.26, "text": "这孩子脸上的伤"}, {"start": 2.26, "end": 3.14, "text": "是你弄的吗"}, {"start": 3.14, "end": 4.26, "text": "我是她亲奶奶"}, {"start": 4.26, "end": 5.34, "text": "我打她怎么了"}, {"start": 5.34, "end": 6.26, "text": "奶奶"}, {"start": 6.26, "end": 7.3, "text": "你是谁的奶奶"}, {"start": 7.3, "end": 7.94, "text": "你别忘了"}, {"start": 7.94, "end": 8.5, "text": "我大姐一家"}, {"start": 8.5, "end": 9.22, "text": "已经和你们老李家"}, {"start": 9.22, "end": 10.22, "text": "算绝关系了"}, {"start": 10.22, "end": 11.14, "text": "警察同志"}, {"start": 11.14, "end": 12.79, "text": "事情是这样的"}, {"start": 12.79, "end": 13.39, "text": "所以说"}, {"start": 13.39, "end": 14.71, "text": "从法律层面上来讲"}, {"start": 14.71, "end": 15.63, "text": "我大姐一家跟李家"}, {"start": 15.63, "end": 16.67, "text": "已经没有任何关系"}, {"start": 16.67, "end": 17.95, "text": "没有任何关系的人"}, {"start": 17.95, "end": 18.75, "text": "突然在大集上"}, {"start": 18.75, "end": 19.99, "text": "抢劫我们家几个孩子"}, {"start": 19.99, "end": 20.39, "text": "还威胁"}, {"start": 20.39, "end": 21.39, "text": "如果不把钱都交出来"}, {"start": 21.39, "end": 22.43, "text": "就要打死他们"}, {"start": 22.43, "end": 23.43, "text": "这种情况下"}, {"start": 23.43, "end": 24.03, "text": "我们黄手"}, {"start": 24.03, "end": 25.15, "text": "应该算是正当防卫吧"}, {"start": 25.15, "end": 26.19, "text": "放屁"}, {"start": 26.19, "end": 27.27, "text": "什么叫抢劫"}, {"start": 27.27, "end": 28.67, "text": "不就是两个唐胡了"}, {"start": 28.71, "end": 29.67, "text": "我两个孙子还小"}, {"start": 29.67, "end": 30.35, "text": "他们只是孩子"}, {"start": 30.35, "end": 31.23, "text": "他们懂什么"}, {"start": 31.23, "end": 31.83, "text": "我们家孩子"}, {"start": 31.83, "end": 32.43, "text": "一个才六岁"}, {"start": 32.43, "end": 32.95, "text": "一个八岁"}, {"start": 32.95, "end": 33.31, "text": "张建国"}, {"start": 33.31, "end": 33.95, "text": "你跟他们计较"}, {"start": 33.95, "end": 34.51, "text": "你还试人吗"}, {"start": 34.51, "end": 34.75, "text": "行了"}, {"start": 34.75, "end": 35.39, "text": "都闭嘴"}, {"start": 35.95, "end": 39.07, "text": "太过分了"}, {"start": 39.07, "end": 39.91, "text": "亲儿子中了毒"}, {"start": 39.91, "end": 40.63, "text": "居然也能很心"}, {"start": 40.63, "end": 41.39, "text": "赶着家门"}, {"start": 41.39, "end": 42.67, "text": "儿子都被赶出去了"}, {"start": 42.67, "end": 43.79, "text": "还要抢劫打人"}, {"start": 43.79, "end": 44.43, "text": "头顶长窗"}, {"start": 44.43, "end": 45.11, "text": "脚下流泥"}, {"start": 45.11, "end": 45.63, "text": "他坏透了"}, {"start": 45.63, "end": 46.43, "text": "我跟你们说"}, {"start": 46.43, "end": 46.83, "text": "就这种"}, {"start": 46.83, "end": 47.39, "text": "张嘴闭嘴"}, {"start": 47.39, "end": 47.75, "text": "骂别人"}, {"start": 47.75, "end": 48.39, "text": "白眼狼的人"}, {"start": 48.39, "end": 49.39, "text": "才是真正的狠人"}, {"start": 49.39, "end": 49.91, "text": "手心手背"}, {"start": 49.91, "end": 50.43, "text": "都是肉"}, {"start": 50.43, "end": 50.95, "text": "哪怕一碗水"}, {"start": 50.95, "end": 51.55, "text": "断不平的"}, {"start": 51.55, "end": 52.51, "text": "可也不能这样啊"}, {"start": 52.51, "end": 53.11, "text": "警察同志"}, {"start": 60.75, "end": 61.47, "text": "他只是个孩子"}, {"start": 61.47, "end": 62.27, "text": "他知道什么"}, {"start": 62.27, "end": 63.15, "text": "你一个大老爷们"}, {"start": 63.15, "end": 63.79, "text": "跟孩子计较"}, {"start": 63.79, "end": 64.67, "text": "你还试人吗"}, {"start": 66.46, "end": 66.86, "text": "这件事"}, {"start": 66.86, "end": 67.82, "text": "李家抢劫在先"}, {"start": 67.82, "end": 68.9, "text": "又打了李素元"}, {"start": 68.9, "end": 69.7, "text": "但张建国出手"}, {"start": 69.7, "end": 70.46, "text": "也确实狠"}, {"start": 70.46, "end": 71.42, "text": "双方各有过失"}, {"start": 71.42, "end": 72.1, "text": "我建议此事"}, {"start": 72.1, "end": 72.7, "text": "就是作罢"}, {"start": 72.7, "end": 73.26, "text": "双方隔解"}, {"start": 73.26, "end": 73.58, "text": "如何"}, {"start": 73.58, "end": 74.36, "text": "好啊"}, {"start": 74.36, "end": 77.36, "text": "你们警察跟张建国同志"}, {"start": 77.36, "end": 78.12, "text": "警察张建国"}, {"start": 78.12, "end": 89.03, "text": "要不陪着"}, {"start": 89.03, "end": 89.79, "text": "毕啥"}, {"start": 89.79, "end": 90.39, "text": "我们先走"}, {"start": 90.39, "end": 91.35, "text": "站住"}, {"start": 91.35, "end": 92.75, "text": "把唐虎路前留下"}, {"start": 92.75, "end": 93.19, "text": "还有我们家"}, {"start": 93.19, "end": 99.48, "text": "宋元的医疗费"}, {"start": 99.48, "end": 100.28, "text": "不合解"}]}