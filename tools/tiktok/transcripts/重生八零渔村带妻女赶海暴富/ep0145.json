{"file": "重生八零渔村带妻女赶海暴富-第145集.mp4", "ep": 145, "duration": 88.5, "segments": [{"start": 3.76, "end": 5.56, "text": "是你爬外的小畜生"}, {"start": 5.56, "end": 6.56, "text": "你再打啊"}, {"start": 6.56, "end": 14.95, "text": "打回事啊"}, {"start": 14.95, "end": 16.15, "text": "怎么上来就打"}, {"start": 16.15, "end": 17.22, "text": "好家伙"}, {"start": 17.22, "end": 18.02, "text": "够狠的"}, {"start": 18.02, "end": 19.02, "text": "该说不说"}, {"start": 19.02, "end": 20.62, "text": "这个老前婆嘴那么臭"}, {"start": 20.62, "end": 21.82, "text": "打他也活该"}, {"start": 25.65, "end": 27.25, "text": "上回没长进行是吧"}, {"start": 27.25, "end": 28.45, "text": "还敢来找事"}, {"start": 28.45, "end": 29.85, "text": "老前婆"}, {"start": 29.85, "end": 31.45, "text": "我看你是疲养了"}, {"start": 57.03, "end": 57.83, "text": "别急"}, {"start": 57.83, "end": 58.63, "text": "慢慢说"}, {"start": 58.63, "end": 58.83, "text": "不够"}, {"start": 58.83, "end": 61.8, "text": "笔夫缘这个小兔崽子"}, {"start": 61.8, "end": 65.94, "text": "和他"}, {"start": 65.94, "end": 67.54, "text": "我要求你们马上把他们救主俩"}, {"start": 67.54, "end": 68.34, "text": "抓进派出所"}, {"start": 68.34, "end": 68.74, "text": "枪毙死"}, {"start": 68.74, "end": 86.44, "text": "这孩子脸上的伤势你弄的吗"}]}