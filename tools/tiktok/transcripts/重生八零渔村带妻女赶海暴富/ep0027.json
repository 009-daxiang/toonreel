{"file": "重生八零渔村带妻女赶海暴富-第27集.mp4", "ep": 27, "duration": 99.1, "segments": [{"start": 1.17, "end": 2.61, "text": "少往自己脸上贴金"}, {"start": 3.05, "end": 4.37, "text": "明明是孩子闹累了"}, {"start": 4.37, "end": 5.01, "text": "才不肯"}, {"start": 7.2, "end": 7.76, "text": "你要这么说"}, {"start": 7.76, "end": 8.64, "text": "那我可走了啊"}, {"start": 9.9, "end": 10.7, "text": "你要死啊"}, {"start": 10.7, "end": 11.7, "text": "孩子还没睡熟"}, {"start": 11.7, "end": 12.62, "text": "你要是敢把他吵醒"}, {"start": 12.62, "end": 13.46, "text": "看我不打死你"}, {"start": 13.94, "end": 14.46, "text": "疼"}, {"start": 16.58, "end": 17.66, "text": "你不让我放手"}, {"start": 18.14, "end": 19.14, "text": "是不是就代表"}, {"start": 19.14, "end": 19.82, "text": "想让我今晚"}, {"start": 19.82, "end": 20.94, "text": "就留在你们屋里睡"}, {"start": 21.84, "end": 22.68, "text": "装什么装"}, {"start": 23.08, "end": 23.68, "text": "忘了之前"}, {"start": 23.68, "end": 24.84, "text": "你自己是怎么死皮赖脸的"}, {"start": 24.84, "end": 25.76, "text": "往我屋里钻了"}, {"start": 26.24, "end": 27.2, "text": "慢慢解说得对"}, {"start": 27.36, "end": 28.6, "text": "确实不是个好玩意"}, {"start": 44.34, "end": 45.14, "text": "你想干啥"}, {"start": 45.82, "end": 46.58, "text": "你说干啥"}, {"start": 47.26, "end": 48.62, "text": "我帮你哄了这么久孩子"}, {"start": 49.1, "end": 50.22, "text": "你不得给我一点好处"}, {"start": 50.66, "end": 51.74, "text": "少话言巧语"}, {"start": 52.3, "end": 53.94, "text": "你哄的明明是你自己的孩子"}, {"start": 54.42, "end": 55.06, "text": "那我不管"}, {"start": 55.7, "end": 56.9, "text": "反正我不能白干活"}, {"start": 57.7, "end": 58.66, "text": "你得给我点好处"}, {"start": 60.46, "end": 62.37, "text": "那 那你快点"}, {"start": 62.77, "end": 63.49, "text": "小心点"}, {"start": 63.77, "end": 64.61, "text": "别吵醒三丫"}, {"start": 65.79, "end": 67.15, "text": "小月可能不是对我感情"}, {"start": 67.15, "end": 67.99, "text": "最深的那一个"}, {"start": 68.43, "end": 69.75, "text": "但一定是最好拿捏的"}, {"start": 70.27, "end": 71.91, "text": "上辈子明明都已经离了婚"}, {"start": 72.27, "end": 73.71, "text": "她后面还给我生了个儿子"}, {"start": 78.97, "end": 79.33, "text": "下去"}, {"start": 79.69, "end": 80.41, "text": "别妨碍我睡觉"}, {"start": 80.77, "end": 81.57, "text": "是你说让我快点"}, {"start": 81.57, "end": 82.29, "text": "别吵到三丫头"}, {"start": 82.29, "end": 82.93, "text": "行了 别说了"}, {"start": 82.93, "end": 83.41, "text": "快睡吧"}, {"start": 85.95, "end": 87.15, "text": "本想靠实力征服"}, {"start": 87.39, "end": 88.47, "text": "却不想弄巧承拙"}, {"start": 88.83, "end": 94.83, "text": "等老子赚了钱"}, {"start": 95.19, "end": 96.11, "text": "第一件要做的事情"}, {"start": 96.11, "end": 96.95, "text": "就是见心房"}]}