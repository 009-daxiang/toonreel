{"file": "重生八零渔村带妻女赶海暴富-第111集.mp4", "ep": 111, "duration": 38.2, "segments": [{"start": 10.19, "end": 11.03, "text": "我太傻了"}, {"start": 11.95, "end": 12.59, "text": "建国"}, {"start": 12.79, "end": 13.59, "text": "你牛叉"}, {"start": 13.83, "end": 15.07, "text": "以前我只觉得你恨"}, {"start": 15.15, "end": 15.99, "text": "现在才知道"}, {"start": 16.07, "end": 17.91, "text": "你知恩图报 有情有义"}, {"start": 18.03, "end": 18.99, "text": "是条汉子"}, {"start": 19.31, "end": 20.31, "text": "我说什么来着"}, {"start": 20.71, "end": 22.39, "text": "我们老张家就没有脑种"}, {"start": 23.43, "end": 24.23, "text": "好小子"}, {"start": 24.35, "end": 24.87, "text": "对了"}, {"start": 25.27, "end": 26.91, "text": "我是你本家的舅舅张建民"}, {"start": 27.11, "end": 27.83, "text": "记住了啊"}, {"start": 28.03, "end": 29.43, "text": "以后有啥事就找我"}, {"start": 29.59, "end": 30.35, "text": "我照着你"}, {"start": 30.83, "end": 31.83, "text": "我有我亲舅舅"}, {"start": 32.11, "end": 33.03, "text": "用不着别人"}, {"start": 34.56, "end": 35.52, "text": "这孩子"}]}