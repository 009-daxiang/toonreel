{"file": "天降萌娃，奶爸开店致富-第220集.mp4", "ep": 220, "duration": 42.1, "segments": [{"start": 0.0, "end": 0.8, "text": "可受不起动"}, {"start": 1.8, "end": 3.0, "text": "爸爸迅暴了"}, {"start": 9.04, "end": 10.04, "text": "怎么还没消息"}, {"start": 10.86, "end": 12.02, "text": "别往衣服里塞雪"}, {"start": 12.02, "end": 13.06, "text": "动找了又点难受"}, {"start": 13.26, "end": 18.42, "text": "知道了"}, {"start": 18.42, "end": 19.22, "text": "我找凌宇"}, {"start": 19.62, "end": 20.42, "text": "找我们老板"}, {"start": 20.42, "end": 21.82, "text": "您稍等 我去叫他"}, {"start": 22.66, "end": 23.46, "text": "黄英"}, {"start": 23.46, "end": 24.26, "text": "你怎么来了"}, {"start": 24.46, "end": 25.66, "text": "这是雅姐乘坐的航班"}, {"start": 25.66, "end": 27.06, "text": "今晚八点飞机落地江城"}, {"start": 27.26, "end": 28.46, "text": "本来应该我去接机的"}, {"start": 28.46, "end": 29.26, "text": "不过我突然临时"}, {"start": 29.26, "end": 30.06, "text": "有点事情去不了"}, {"start": 30.26, "end": 30.86, "text": "思来想去"}, {"start": 30.86, "end": 32.06, "text": "还是觉得只有你去合适"}, {"start": 32.06, "end": 33.06, "text": "记住别晚点啊"}, {"start": 33.06, "end": 33.86, "text": "雅姐盛产时"}, {"start": 33.86, "end": 34.66, "text": "身体出了点毛病"}, {"start": 34.66, "end": 35.26, "text": "不能受冷"}, {"start": 35.26, "end": 35.86, "text": "以防万一"}, {"start": 35.86, "end": 36.66, "text": "这外套你到时候"}, {"start": 36.66, "end": 37.46, "text": "一起带过去吧"}, {"start": 37.46, "end": 38.26, "text": "愣着做什么"}, {"start": 38.26, "end": 39.26, "text": "还不赶你说谢谢"}, {"start": 40.26, "end": 40.86, "text": "谢谢"}, {"start": 41.66, "end": 42.06, "text": "这还差"}]}