{"file": "天降萌娃，奶爸开店致富-第97集.mp4", "ep": 97, "duration": 42.1, "segments": [{"start": 1.1, "end": 2.1, "text": "我叫龚洁"}, {"start": 2.6, "end": 4.1, "text": "王德洋是我老公"}, {"start": 4.1, "end": 5.1, "text": "嫂子你好"}, {"start": 5.1, "end": 6.1, "text": "你稍等"}, {"start": 6.1, "end": 7.1, "text": "我去叫我哥"}, {"start": 7.1, "end": 8.1, "text": "哥"}, {"start": 8.1, "end": 9.1, "text": "有人找你"}, {"start": 10.1, "end": 11.1, "text": "嫂子是吧"}, {"start": 11.1, "end": 12.52, "text": "第一次见"}, {"start": 12.52, "end": 13.52, "text": "你好"}, {"start": 13.52, "end": 14.52, "text": "没提前说一声"}, {"start": 14.52, "end": 15.52, "text": "没打扰你休息吧"}, {"start": 15.52, "end": 16.52, "text": "没有"}, {"start": 16.52, "end": 17.52, "text": "喝点什么"}, {"start": 17.52, "end": 18.52, "text": "不用麻烦"}, {"start": 18.52, "end": 20.52, "text": "我今天主要来买东西"}, {"start": 20.52, "end": 22.52, "text": "老王昨天带回去那带肉"}, {"start": 22.52, "end": 23.52, "text": "味道确实很好"}, {"start": 23.52, "end": 24.52, "text": "你这里还有吗"}, {"start": 24.52, "end": 25.52, "text": "有"}, {"start": 25.52, "end": 26.52, "text": "嫂子等着"}, {"start": 26.52, "end": 31.58, "text": "我马上拿"}, {"start": 31.58, "end": 33.58, "text": "你要爸爸"}, {"start": 33.58, "end": 34.58, "text": "哎呀"}, {"start": 34.58, "end": 36.58, "text": "好可爱的小朋友"}, {"start": 36.58, "end": 37.58, "text": "过来让姨姨抱抱"}]}