{"file": "天降萌娃，奶爸开店致富-第121集.mp4", "ep": 121, "duration": 42.1, "segments": [{"start": 0.0, "end": 0.96, "text": "给你就拿着"}, {"start": 1.44, "end": 2.4, "text": "一部手机而已"}, {"start": 2.6, "end": 3.52, "text": "别默默积极"}, {"start": 5.33, "end": 6.13, "text": "谢谢哥"}, {"start": 8.9, "end": 9.38, "text": "哥"}, {"start": 9.54, "end": 11.02, "text": "这心电脑挺快啊"}, {"start": 12.27, "end": 12.91, "text": "那当然"}, {"start": 13.07, "end": 14.03, "text": "就得早该换了"}, {"start": 14.47, "end": 15.19, "text": "你看这点电"}, {"start": 15.31, "end": 16.03, "text": "我上楼一趟"}, {"start": 16.27, "end": 17.03, "text": "行 哥"}, {"start": 21.22, "end": 21.74, "text": "您好"}, {"start": 21.86, "end": 22.86, "text": "请问林宇在吗"}, {"start": 23.9, "end": 24.5, "text": "在"}, {"start": 24.66, "end": 25.66, "text": "你们找我哥"}, {"start": 26.06, "end": 26.5, "text": "对"}, {"start": 26.78, "end": 27.94, "text": "找他了解点情况"}, {"start": 28.32, "end": 28.84, "text": "哥"}, {"start": 28.96, "end": 30.48, "text": "有警察找你"}, {"start": 33.65, "end": 34.45, "text": "找我干什么"}, {"start": 34.57, "end": 35.25, "text": "不知道啊"}, {"start": 35.37, "end": 36.69, "text": "说是找你了解情况"}, {"start": 38.02, "end": 38.66, "text": "两位警官"}, {"start": 38.74, "end": 39.38, "text": "有什么事"}, {"start": 39.9, "end": 40.9, "text": "这个牌子的咖啡"}, {"start": 40.98, "end": 41.9, "text": "是你店里卖的吗"}]}