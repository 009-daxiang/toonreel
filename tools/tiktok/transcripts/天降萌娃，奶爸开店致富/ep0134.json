{"file": "天降萌娃，奶爸开店致富-第134集.mp4", "ep": 134, "duration": 42.1, "segments": [{"start": 0.0, "end": 1.28, "text": "我外面欠了三千多"}, {"start": 1.28, "end": 2.36, "text": "人家都催上门了"}, {"start": 4.7, "end": 5.38, "text": "五千"}, {"start": 5.58, "end": 6.7, "text": "那先拿三千给我"}, {"start": 7.42, "end": 8.38, "text": "不是五千"}, {"start": 8.98, "end": 9.7, "text": "五百"}, {"start": 10.02, "end": 10.7, "text": "多少"}, {"start": 11.34, "end": 12.06, "text": "五百"}, {"start": 12.38, "end": 18.43, "text": "以前我什么都不用管"}, {"start": 18.63, "end": 20.23, "text": "一个月还有四千房租"}, {"start": 21.44, "end": 22.96, "text": "现在天天人来人往"}, {"start": 22.96, "end": 24.64, "text": "忙半天才赚五百"}, {"start": 25.73, "end": 26.81, "text": "当初我提议"}, {"start": 26.81, "end": 28.01, "text": "你自己也答应了"}, {"start": 28.37, "end": 30.21, "text": "我是因为你说能赚钱"}, {"start": 30.53, "end": 30.97, "text": "哥"}, {"start": 31.21, "end": 32.21, "text": "要不要拍下来"}, {"start": 32.57, "end": 33.77, "text": "框拍有什么意思"}, {"start": 33.97, "end": 34.73, "text": "拿把瓜子"}, {"start": 34.73, "end": 35.69, "text": "站人家门口看"}]}