{"file": "天降萌娃，奶爸开店致富-第234集.mp4", "ep": 234, "duration": 42.1, "segments": [{"start": 1.33, "end": 2.49, "text": "过来 我跟你说"}, {"start": 4.99, "end": 5.67, "text": "大善哥"}, {"start": 5.87, "end": 7.15, "text": "刚才那位到底是谁啊"}, {"start": 7.27, "end": 8.35, "text": "你还叫她大姐头"}, {"start": 8.71, "end": 9.91, "text": "刚才那个是"}, {"start": 10.27, "end": 11.31, "text": "是鱼的妈妈"}, {"start": 11.47, "end": 12.15, "text": "不过她跟鱼哥"}, {"start": 12.15, "end": 13.43, "text": "现在关系有点不好解释"}, {"start": 13.43, "end": 14.07, "text": "反正你叫秦雅"}, {"start": 14.07, "end": 14.87, "text": "鱼的妈妈"}, {"start": 14.99, "end": 15.83, "text": "那她跟林哥"}, {"start": 15.83, "end": 16.91, "text": "反正你叫秦雅姐就好"}, {"start": 16.91, "end": 17.63, "text": "别乱喊"}, {"start": 18.47, "end": 19.07, "text": "好"}, {"start": 28.77, "end": 29.65, "text": "黄哥这样"}, {"start": 29.81, "end": 30.89, "text": "顿出来还真闲"}, {"start": 39.79, "end": 40.55, "text": "开饭啦"}]}