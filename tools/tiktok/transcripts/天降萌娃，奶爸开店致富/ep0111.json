{"file": "天降萌娃，奶爸开店致富-第111集.mp4", "ep": 111, "duration": 42.1, "segments": [{"start": 0.0, "end": 2.0, "text": "正好看见你回来了"}, {"start": 2.0, "end": 3.0, "text": "就过来问问"}, {"start": 3.0, "end": 4.0, "text": "抓蛇"}, {"start": 4.0, "end": 5.0, "text": "没问题"}, {"start": 5.0, "end": 7.0, "text": "抓完还能给秦叔补补"}, {"start": 7.0, "end": 10.11, "text": "小羽"}, {"start": 10.11, "end": 11.11, "text": "真能抓吗"}, {"start": 11.11, "end": 13.11, "text": "不行就叫物业吧"}, {"start": 13.11, "end": 14.5, "text": "黑梅锦蛇"}, {"start": 14.5, "end": 15.5, "text": "梅毒"}, {"start": 15.5, "end": 17.17, "text": "看我怎么收的"}, {"start": 17.17, "end": 19.17, "text": "黄金右臂开启"}, {"start": 19.17, "end": 21.17, "text": "右臂力量增幅百分之五百"}, {"start": 21.17, "end": 26.37, "text": "这么大一条"}, {"start": 26.37, "end": 27.37, "text": "你一巴掌"}, {"start": 27.37, "end": 29.1, "text": "搞定"}, {"start": 29.1, "end": 30.36, "text": "雪姨"}, {"start": 30.36, "end": 32.36, "text": "晚上记得和秦叔过来吃饭"}, {"start": 32.36, "end": 33.36, "text": "尝尝我手艺"}, {"start": 33.36, "end": 35.81, "text": "你还会做饭啦"}, {"start": 35.81, "end": 36.81, "text": "行 晚上肯定来"}, {"start": 36.81, "end": 42.01, "text": "送阿姨一点反应都没"}]}