{"file": "公路求生榜一说他要走到公路尽头-第101集.mp4", "ep": 101, "duration": 45.7, "segments": [{"start": 0.0, "end": 1.92, "text": "兄弟 你受苦了"}, {"start": 3.54, "end": 4.3, "text": "别难过了"}, {"start": 4.58, "end": 5.74, "text": "拿去买点求生币"}, {"start": 6.02, "end": 6.9, "text": "重新找一个"}, {"start": 8.03, "end": 8.75, "text": "谢了客人"}, {"start": 9.03, "end": 9.83, "text": "我正好需要"}, {"start": 16.68, "end": 17.6, "text": "地上有求生币"}, {"start": 17.68, "end": 18.36, "text": "你没看到"}, {"start": 18.56, "end": 19.2, "text": "看到了"}, {"start": 19.71, "end": 20.71, "text": "那你怎么不减"}, {"start": 21.07, "end": 22.15, "text": "你们这种穷人"}, {"start": 22.23, "end": 23.23, "text": "平时少一员的工资"}, {"start": 23.23, "end": 24.23, "text": "都要强迫脑袋"}, {"start": 24.63, "end": 25.35, "text": "因为车里"}, {"start": 25.59, "end": 26.63, "text": "坐着松柜的客人"}, {"start": 26.91, "end": 27.75, "text": "你能安全平稳"}, {"start": 27.75, "end": 28.55, "text": "顺利的到家"}, {"start": 29.03, "end": 30.07, "text": "才是我最该做的"}, {"start": 30.35, "end": 32.54, "text": "你不要走"}, {"start": 32.7, "end": 37.5, "text": "回头看看"}, {"start": 37.58, "end": 38.94, "text": "客人已安全送达"}, {"start": 39.1, "end": 40.62, "text": "任务完成度百分之百"}, {"start": 40.62, "end": 41.78, "text": "正在脱移副本"}, {"start": 42.06, "end": 43.26, "text": "倒计十亿分钟"}, {"start": 44.22, "end": 45.3, "text": "记住我们的独主"}]}