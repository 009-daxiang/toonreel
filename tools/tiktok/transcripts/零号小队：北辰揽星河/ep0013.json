{"file": "零号小队：北辰揽星河-第13集.mp4", "ep": 13, "duration": 56.8, "segments": [{"start": 0.0, "end": 0.5, "text": "我"}, {"start": 1.67, "end": 2.67, "text": "我看见你"}, {"start": 3.67, "end": 6.38, "text": "浑身是血"}, {"start": 6.38, "end": 7.44, "text": "好了"}, {"start": 7.44, "end": 8.44, "text": "别说了"}, {"start": 8.44, "end": 10.47, "text": "小臣浑身是血"}, {"start": 10.47, "end": 12.47, "text": "他到底看到了什么"}, {"start": 12.47, "end": 14.82, "text": "谢谢温守邪"}, {"start": 14.82, "end": 15.82, "text": "考虑一下我吧"}, {"start": 15.82, "end": 17.82, "text": "我会是一个合格的队友"}, {"start": 17.82, "end": 18.82, "text": "等那一刻到来"}, {"start": 18.82, "end": 19.82, "text": "我会站在他身侧"}, {"start": 19.82, "end": 20.82, "text": "以命相护"}, {"start": 20.82, "end": 22.82, "text": "因为你看到的未来"}, {"start": 22.82, "end": 23.82, "text": "没必要"}, {"start": 23.82, "end": 24.82, "text": "有必要"}, {"start": 24.82, "end": 25.82, "text": "我想成为你的队友"}, {"start": 25.82, "end": 26.82, "text": "你的同伴"}, {"start": 26.82, "end": 28.82, "text": "和我组队会很危险"}, {"start": 28.82, "end": 29.82, "text": "要命"}, {"start": 29.82, "end": 30.82, "text": "我知道"}, {"start": 30.82, "end": 31.82, "text": "我不怕"}, {"start": 31.82, "end": 32.82, "text": "生死不论"}, {"start": 32.82, "end": 35.55, "text": "你想加入就来吧"}, {"start": 35.55, "end": 37.99, "text": "好"}, {"start": 37.99, "end": 38.99, "text": "谢谢队长"}, {"start": 38.99, "end": 41.05, "text": "恭喜两位"}, {"start": 41.05, "end": 44.58, "text": "说得跟要结婚一样"}, {"start": 44.58, "end": 45.58, "text": "秀文哥"}, {"start": 45.58, "end": 46.58, "text": "他的先知之言"}, {"start": 46.58, "end": 47.58, "text": "请不要记录"}, {"start": 47.58, "end": 48.68, "text": "身份暴露后"}, {"start": 48.68, "end": 50.68, "text": "想逼他亏谈未来的人"}, {"start": 50.68, "end": 51.68, "text": "不会少"}, {"start": 51.68, "end": 52.68, "text": "好"}, {"start": 52.68, "end": 53.68, "text": "不会有其他人知道"}, {"start": 53.68, "end": 54.68, "text": "谢谢"}, {"start": 54.68, "end": 56.68, "text": "这枚护身服送给队长"}]}