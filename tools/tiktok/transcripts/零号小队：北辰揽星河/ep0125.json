{"file": "零号小队：北辰揽星河-第125集.mp4", "ep": 125, "duration": 45.8, "segments": [{"start": 0.0, "end": 1.44, "text": "我的石海都能開"}, {"start": 1.44, "end": 2.72, "text": "用得著你補魂"}, {"start": 3.21, "end": 4.05, "text": "想死"}, {"start": 4.29, "end": 5.57, "text": "我現在就成全你"}, {"start": 6.03, "end": 7.43, "text": "這話是不是重了"}, {"start": 8.87, "end": 9.67, "text": "對不起"}, {"start": 11.74, "end": 13.74, "text": "我需要的是陪我走下去的同伴"}, {"start": 14.06, "end": 15.1, "text": "不是蕭浩平"}, {"start": 15.9, "end": 16.9, "text": "我叫伊修過來"}, {"start": 18.18, "end": 18.9, "text": "回局裡"}, {"start": 22.62, "end": 23.26, "text": "站穩"}, {"start": 25.78, "end": 27.14, "text": "你現在比他還嚴重"}, {"start": 29.15, "end": 29.83, "text": "我背你"}, {"start": 29.99, "end": 31.83, "text": "一個人的傷分到兩個人身上"}, {"start": 31.83, "end": 32.75, "text": "有什麼意義"}, {"start": 33.55, "end": 35.9, "text": "性感情"}, {"start": 35.9, "end": 36.58, "text": "那我也"}, {"start": 36.58, "end": 37.14, "text": "林局"}, {"start": 37.54, "end": 38.5, "text": "我剛才說的"}, {"start": 38.5, "end": 39.5, "text": "對你也一樣"}, {"start": 39.5, "end": 40.14, "text": "是"}, {"start": 40.58, "end": 42.46, "text": "剛才只是瞄準沒開槍問題不大"}, {"start": 42.98, "end": 44.02, "text": "誰教你的槍法"}, {"start": 45.14, "end": 45.78, "text": "助局"}]}