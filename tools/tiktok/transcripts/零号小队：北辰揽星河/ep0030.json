{"file": "零号小队：北辰揽星河-第30集.mp4", "ep": 30, "duration": 57.5, "segments": [{"start": 12.5, "end": 13.14, "text": "承让"}, {"start": 13.3, "end": 16.19, "text": "阿神 求报大腿"}, {"start": 16.35, "end": 21.41, "text": "怎么还会打架"}, {"start": 21.77, "end": 23.61, "text": "什么打架 俗气"}, {"start": 23.81, "end": 25.37, "text": "不就是街头混混干的事"}, {"start": 25.61, "end": 26.85, "text": "林老师是联续三届"}, {"start": 26.85, "end": 28.13, "text": "中州三打总冠军"}, {"start": 28.92, "end": 29.92, "text": "你师父是谁"}, {"start": 30.69, "end": 32.69, "text": "已经不在了 也不能说"}, {"start": 32.97, "end": 34.13, "text": "加入三打协会吧"}, {"start": 34.25, "end": 35.25, "text": "会长让给你当"}, {"start": 37.81, "end": 39.13, "text": "没兴趣 谢谢"}, {"start": 39.29, "end": 40.17, "text": "跟我打比赛"}, {"start": 40.17, "end": 41.29, "text": "你肯定拿冠军"}, {"start": 41.41, "end": 43.17, "text": "不考虑 我喜欢读书"}, {"start": 43.37, "end": 45.37, "text": "林老师 留个联系方式"}, {"start": 47.1, "end": 48.38, "text": "小臣留意到一个人"}, {"start": 48.38, "end": 49.98, "text": "先让资料组合适临权的公开信息"}, {"start": 50.14, "end": 50.94, "text": "方大腿比较帅"}, {"start": 50.94, "end": 52.22, "text": "阿神晚据 还保持风度最帅"}, {"start": 52.87, "end": 54.43, "text": "温辰 我有话想单独说"}, {"start": 54.59, "end": 55.11, "text": "很快的"}, {"start": 55.11, "end": 56.23, "text": "这话 这地方"}, {"start": 56.43, "end": 57.51, "text": "怎么越来越熟悉了"}]}