{"file": "零号小队：北辰揽星河-第91集.mp4", "ep": 91, "duration": 50.3, "segments": [{"start": 0.02, "end": 1.02, "text": "那你呢"}, {"start": 1.7, "end": 2.7, "text": "我還有事"}, {"start": 2.7, "end": 3.7, "text": "回去吧"}, {"start": 3.7, "end": 4.7, "text": "明天見"}, {"start": 4.7, "end": 5.7, "text": "隊長見外了"}, {"start": 5.7, "end": 7.87, "text": "會用劍嗎"}, {"start": 9.56, "end": 10.56, "text": "來"}, {"start": 10.56, "end": 21.1, "text": "這種劍路"}, {"start": 21.1, "end": 22.1, "text": "難道是"}, {"start": 22.1, "end": 27.05, "text": "好厲害的劍法"}, {"start": 27.05, "end": 28.68, "text": "這是青雲劍法"}, {"start": 28.68, "end": 30.17, "text": "青雲谷的"}, {"start": 30.17, "end": 31.37, "text": "青雲劍法"}, {"start": 31.37, "end": 33.77, "text": "修行界無人不知的青雲谷"}, {"start": 33.77, "end": 35.77, "text": "五年前已經被滅門"}, {"start": 35.77, "end": 38.02, "text": "想學嗎"}, {"start": 38.02, "end": 42.17, "text": "我教你"}, {"start": 42.17, "end": 45.44, "text": "青雲谷的劍法"}, {"start": 45.44, "end": 47.84, "text": "不該隨青雲谷一同埋葬"}]}