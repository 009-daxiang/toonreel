{"file": "零号小队：北辰揽星河-第21集.mp4", "ep": 21, "duration": 60.3, "segments": [{"start": 6.29, "end": 7.25, "text": "康指揮"}, {"start": 7.45, "end": 9.57, "text": "這個難度對修行者沒有任何困難"}, {"start": 10.22, "end": 10.94, "text": "我知道"}, {"start": 13.92, "end": 14.88, "text": "再試一遍"}, {"start": 15.2, "end": 19.95, "text": "什麼感覺"}, {"start": 20.72, "end": 21.8, "text": "他在壓制靈力"}, {"start": 23.48, "end": 24.8, "text": "你體數這麼好"}, {"start": 25.32, "end": 26.28, "text": "體數不好"}, {"start": 26.28, "end": 28.08, "text": "小時候早就見太奶了"}, {"start": 30.74, "end": 31.62, "text": "有話直說"}, {"start": 32.38, "end": 33.3, "text": "執行者"}, {"start": 33.3, "end": 34.66, "text": "1708隊旅樂"}, {"start": 34.9, "end": 36.02, "text": "中州最安全"}, {"start": 36.22, "end": 37.86, "text": "執行者實力會稍弱一些"}, {"start": 38.26, "end": 39.86, "text": "怪不得隊長以前不組隊"}, {"start": 40.59, "end": 41.43, "text": "什麼意思"}, {"start": 41.63, "end": 42.64, "text": "來比一場"}, {"start": 42.88, "end": 44.0, "text": "就在結界裡比"}, {"start": 44.0, "end": 44.88, "text": "不用靈力"}, {"start": 48.82, "end": 49.86, "text": "沒有靈力"}, {"start": 50.78, "end": 52.3, "text": "誠然有任有餘"}, {"start": 52.3, "end": 58.23, "text": "有點本事"}, {"start": 59.3, "end": 59.94, "text": "成讓"}]}