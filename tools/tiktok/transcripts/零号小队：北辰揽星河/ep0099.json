{"file": "零号小队：北辰揽星河-第99集.mp4", "ep": 99, "duration": 55.0, "segments": [{"start": 0.98, "end": 1.54, "text": "爸爸"}, {"start": 2.02, "end": 3.18, "text": "姐姐怎么还没来"}, {"start": 3.58, "end": 4.85, "text": "你不是说她会来吗"}, {"start": 4.97, "end": 5.49, "text": "人呢"}, {"start": 5.81, "end": 6.57, "text": "还没到点"}, {"start": 6.77, "end": 7.33, "text": "急什么"}, {"start": 7.87, "end": 8.83, "text": "给她打电话"}, {"start": 10.41, "end": 11.33, "text": "谁有她电话"}, {"start": 12.74, "end": 13.82, "text": "时间到了"}, {"start": 14.38, "end": 15.22, "text": "她不到"}, {"start": 15.62, "end": 17.18, "text": "仪式一样开始"}, {"start": 17.74, "end": 18.7, "text": "狼才女貌"}, {"start": 18.9, "end": 19.78, "text": "确实般配"}, {"start": 20.14, "end": 26.5, "text": "真千金竟然没来闹"}, {"start": 27.95, "end": 28.99, "text": "她没看见"}, {"start": 29.43, "end": 30.43, "text": "真是可惜"}, {"start": 32.91, "end": 33.51, "text": "温辰"}, {"start": 35.83, "end": 36.99, "text": "你们谁看见我小弟了"}, {"start": 38.59, "end": 39.87, "text": "刚才来了一个女孩"}, {"start": 40.07, "end": 41.23, "text": "她跑着跟人走了"}, {"start": 42.17, "end": 43.73, "text": "那女孩长得还怪好看的"}, {"start": 45.54, "end": 46.58, "text": "跟人走了"}, {"start": 46.9, "end": 48.1, "text": "还跑着"}]}