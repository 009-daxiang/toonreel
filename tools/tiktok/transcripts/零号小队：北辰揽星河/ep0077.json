{"file": "零号小队：北辰揽星河-第77集.mp4", "ep": 77, "duration": 48.7, "segments": [{"start": 0.0, "end": 1.0, "text": "你们很闲吗"}, {"start": 1.2, "end": 1.8, "text": "很烦"}, {"start": 2.5, "end": 3.3, "text": "是很烦"}, {"start": 4.06, "end": 4.86, "text": "谈完这次"}, {"start": 5.06, "end": 6.06, "text": "我绝不再打扰你"}, {"start": 6.46, "end": 7.86, "text": "也尽量让苏家不再来"}, {"start": 11.34, "end": 12.94, "text": "先是孟家 又是苏家"}, {"start": 12.94, "end": 13.74, "text": "温辰到底什么来的"}, {"start": 13.74, "end": 14.74, "text": "温 温辰"}, {"start": 14.94, "end": 16.54, "text": "温辰的名字烫嘴吗"}, {"start": 16.94, "end": 17.93, "text": "现在走吗"}, {"start": 18.33, "end": 19.13, "text": "你怎么来了"}, {"start": 20.63, "end": 22.23, "text": "刚提了新车 顺路"}, {"start": 23.22, "end": 24.22, "text": "你先去车上等我"}, {"start": 26.77, "end": 27.37, "text": "慢聊"}, {"start": 29.7, "end": 30.3, "text": "去那说"}, {"start": 34.38, "end": 34.98, "text": "那是谁"}, {"start": 36.38, "end": 36.98, "text": "朋友"}, {"start": 37.67, "end": 38.87, "text": "想说什么 说吧"}, {"start": 39.27, "end": 40.07, "text": "下月一号"}, {"start": 40.27, "end": 41.67, "text": "苏灵运和陆婷峰订婚"}, {"start": 42.27, "end": 43.07, "text": "你需要出席"}, {"start": 43.47, "end": 44.07, "text": "让外界知道"}, {"start": 44.07, "end": 45.47, "text": "苏家没有客带亲生女儿"}, {"start": 46.17, "end": 47.37, "text": "爷爷还让我带你回去"}, {"start": 47.77, "end": 48.77, "text": "找老师教导礼仪"}]}