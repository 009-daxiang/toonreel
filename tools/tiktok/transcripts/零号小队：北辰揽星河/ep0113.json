{"file": "零号小队：北辰揽星河-第113集.mp4", "ep": 113, "duration": 49.0, "segments": [{"start": 0.94, "end": 1.94, "text": "我練了二十年"}, {"start": 1.94, "end": 3.87, "text": "還不夠熟"}, {"start": 3.87, "end": 5.87, "text": "畫幅真不用沐浴焚香"}, {"start": 5.87, "end": 14.43, "text": "或許可能不用"}, {"start": 14.43, "end": 17.3, "text": "這一趟還真是充實"}, {"start": 17.3, "end": 18.3, "text": "我們出去走走"}, {"start": 18.3, "end": 20.3, "text": "順便和助局打聲招呼"}, {"start": 20.3, "end": 21.3, "text": "行"}, {"start": 21.3, "end": 22.3, "text": "我還有事"}, {"start": 22.3, "end": 23.3, "text": "就不陪你們了"}, {"start": 23.3, "end": 28.01, "text": "警局來電"}, {"start": 28.01, "end": 29.01, "text": "他們派去"}, {"start": 29.01, "end": 30.2, "text": "販毒團伙的臥底失聯"}, {"start": 30.2, "end": 31.2, "text": "可能暴露了"}, {"start": 31.2, "end": 32.2, "text": "你安排三個人"}, {"start": 32.2, "end": 33.2, "text": "循宗 擊殺 救治"}, {"start": 33.2, "end": 34.2, "text": "去支援一下"}, {"start": 34.2, "end": 35.2, "text": "是"}, {"start": 35.2, "end": 37.67, "text": "警局來電"}, {"start": 37.67, "end": 38.67, "text": "他們派去"}, {"start": 38.67, "end": 39.67, "text": "販毒團伙的臥底失聯"}, {"start": 39.67, "end": 40.67, "text": "可能暴露了"}, {"start": 40.67, "end": 41.67, "text": "你安排三個人"}, {"start": 41.67, "end": 42.67, "text": "循宗 擊殺 救治"}, {"start": 42.67, "end": 43.67, "text": "去支援一下"}, {"start": 43.67, "end": 47.04, "text": "是"}, {"start": 47.04, "end": 48.04, "text": "我們去哪兒"}, {"start": 48.04, "end": 49.04, "text": "警區還是商業區"}]}