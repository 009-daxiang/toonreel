{"file": "零号小队：北辰揽星河-第39集.mp4", "ep": 39, "duration": 56.0, "segments": [{"start": 0.62, "end": 1.82, "text": "来 我背你"}, {"start": 1.82, "end": 3.42, "text": "不要 我一会儿就好"}, {"start": 3.42, "end": 5.42, "text": "上来 带你去一个地方"}, {"start": 5.42, "end": 9.02, "text": "你背得动吗 我很沉的"}, {"start": 9.02, "end": 13.6, "text": "报警 害怕就闭上眼睛"}, {"start": 13.6, "end": 14.6, "text": "什么"}, {"start": 14.6, "end": 19.18, "text": "松开点 累得慌"}, {"start": 19.18, "end": 22.44, "text": "温辰 你居然会飞"}, {"start": 22.44, "end": 23.24, "text": "嗯"}, {"start": 23.24, "end": 25.53, "text": "我们去哪儿"}, {"start": 25.53, "end": 30.17, "text": "找地方睡觉"}, {"start": 30.17, "end": 32.57, "text": "少说话 一会儿灌风难受"}, {"start": 32.57, "end": 36.51, "text": "你这窗户挺大 进出真方便"}, {"start": 36.51, "end": 38.51, "text": "你先坐 我去收拾房间"}, {"start": 38.51, "end": 41.1, "text": "一起一起"}, {"start": 41.1, "end": 42.9, "text": "你自便 我出去一趟"}, {"start": 45.9, "end": 47.7, "text": "以后新人强弱悬书"}, {"start": 47.7, "end": 49.5, "text": "得找一个平衡点"}, {"start": 49.5, "end": 50.9, "text": "今天最后一项"}, {"start": 50.9, "end": 52.3, "text": "是今天第一项"}, {"start": 52.3, "end": 53.7, "text": "发皮"}, {"start": 53.7, "end": 54.7, "text": "测完就休息"}]}