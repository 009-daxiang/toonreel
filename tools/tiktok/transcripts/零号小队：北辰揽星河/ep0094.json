{"file": "零号小队：北辰揽星河-第94集.mp4", "ep": 94, "duration": 52.2, "segments": [{"start": 1.33, "end": 3.57, "text": "他把这套剑法发挥到了极致"}, {"start": 5.69, "end": 6.53, "text": "燕叔"}, {"start": 6.53, "end": 7.81, "text": "假期有安排吗"}, {"start": 8.25, "end": 9.09, "text": "没有"}, {"start": 9.53, "end": 10.89, "text": "跟我去一趟北周"}, {"start": 11.49, "end": 12.25, "text": "好"}, {"start": 13.28, "end": 14.2, "text": "一起"}, {"start": 14.48, "end": 15.24, "text": "可以"}, {"start": 15.24, "end": 16.2, "text": "什么时候出发"}, {"start": 16.2, "end": 17.08, "text": "我来买票"}, {"start": 17.24, "end": 18.0, "text": "不用"}, {"start": 18.86, "end": 19.86, "text": "有专机"}, {"start": 20.06, "end": 22.83, "text": "周六下午三点"}, {"start": 22.83, "end": 23.79, "text": "平机平集合"}, {"start": 23.79, "end": 24.95, "text": "直飞北周分局"}, {"start": 24.95, "end": 25.59, "text": "那里冷"}, {"start": 25.59, "end": 26.71, "text": "准备两身后衣服"}, {"start": 26.71, "end": 27.99, "text": "或者待局里发的装备"}, {"start": 27.99, "end": 28.99, "text": "他凌厉还弱"}, {"start": 28.99, "end": 30.47, "text": "不能完全隔绝低温"}, {"start": 30.47, "end": 31.71, "text": "在那里待八天"}, {"start": 31.71, "end": 33.15, "text": "假期最后一天回来"}, {"start": 33.15, "end": 39.37, "text": "我怎么像个敦人的私生犯"}, {"start": 41.58, "end": 42.54, "text": "我想问"}, {"start": 42.7, "end": 43.82, "text": "那两个人是谁"}, {"start": 44.46, "end": 45.46, "text": "你不需要知道"}, {"start": 45.74, "end": 46.9, "text": "我没有别的意思"}, {"start": 47.18, "end": 48.7, "text": "只想尽自己所能补偿"}, {"start": 49.27, "end": 50.39, "text": "特意局会解决"}, {"start": 50.71, "end": 52.19, "text": "执行员家属有人保护"}]}