{"file": "零号小队：北辰揽星河-第42集.mp4", "ep": 42, "duration": 52.5, "segments": [{"start": 0.94, "end": 1.74, "text": "她是我队长"}, {"start": 2.3, "end": 3.98, "text": "你应该比她大吧"}, {"start": 4.99, "end": 5.87, "text": "我今年二十岁"}, {"start": 6.19, "end": 7.27, "text": "比队长年长两岁"}, {"start": 9.7, "end": 10.74, "text": "原来还能这样"}, {"start": 10.94, "end": 14.9, "text": "那温辰能不能也当我的队长"}, {"start": 15.3, "end": 15.86, "text": "抱歉"}, {"start": 16.49, "end": 17.65, "text": "跟我组队会要命"}, {"start": 18.01, "end": 19.65, "text": "招他进来不是让他送死"}, {"start": 22.35, "end": 23.15, "text": "不如跟着我"}, {"start": 23.74, "end": 24.86, "text": "我现在也没有队友"}, {"start": 25.75, "end": 26.99, "text": "你就是个唐巴皮"}, {"start": 27.31, "end": 27.99, "text": "不过也行"}, {"start": 28.11, "end": 29.07, "text": "我就勉强答应吧"}, {"start": 29.63, "end": 30.99, "text": "你们聊 我先回宿舍"}, {"start": 31.43, "end": 33.39, "text": "好 明早我送你们回学校"}, {"start": 34.79, "end": 35.35, "text": "六点半"}, {"start": 36.18, "end": 36.66, "text": "队长"}, {"start": 37.1, "end": 38.46, "text": "我的宿舍安排在你隔壁"}, {"start": 40.49, "end": 41.65, "text": "队长有什么烦心事"}, {"start": 42.21, "end": 42.93, "text": "可以和我说吗"}, {"start": 43.21, "end": 44.05, "text": "我的烦心事"}, {"start": 44.57, "end": 45.13, "text": "就是他"}, {"start": 45.81, "end": 47.09, "text": "齐璇 我说过"}, {"start": 47.45, "end": 48.53, "text": "跟我组队很危险"}, {"start": 48.81, "end": 49.49, "text": "可能会死"}, {"start": 50.1, "end": 51.02, "text": "我最怕欠债"}, {"start": 51.3, "end": 52.3, "text": "尤其是人命债"}]}