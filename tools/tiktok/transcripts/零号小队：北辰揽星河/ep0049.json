{"file": "零号小队：北辰揽星河-第49集.mp4", "ep": 49, "duration": 48.6, "segments": [{"start": 0.08, "end": 1.0, "text": "不怕"}, {"start": 1.0, "end": 2.2, "text": "只要我能"}, {"start": 2.2, "end": 4.34, "text": "就算是死"}, {"start": 4.34, "end": 5.62, "text": "也無所謂"}, {"start": 5.62, "end": 7.3, "text": "我怕死"}, {"start": 7.3, "end": 9.46, "text": "但如果能保護家人朋友"}, {"start": 9.46, "end": 11.14, "text": "我願意克服恐懼"}, {"start": 11.14, "end": 12.86, "text": "附朝之下無完萬"}, {"start": 12.86, "end": 14.86, "text": "我願意成為第一道防線"}, {"start": 14.86, "end": 16.73, "text": "等周末"}, {"start": 16.73, "end": 18.57, "text": "和我去特意局辦入職"}, {"start": 18.57, "end": 20.54, "text": "活家老頭在場"}, {"start": 20.54, "end": 23.3, "text": "知道了"}, {"start": 23.3, "end": 24.4, "text": "煩"}, {"start": 24.4, "end": 26.65, "text": "像蒼蠅一樣"}, {"start": 26.65, "end": 27.73, "text": "沒傷害"}, {"start": 27.73, "end": 29.93, "text": "卻沒完沒了的惡心人"}, {"start": 29.93, "end": 38.86, "text": "寧燕書已經同意入職"}, {"start": 38.86, "end": 42.96, "text": "你們知不知道"}, {"start": 42.96, "end": 43.96, "text": "我家到底怎麼了"}, {"start": 44.08, "end": 45.28, "text": "燕哥哥別急"}, {"start": 45.28, "end": 46.68, "text": "我已經讓人打聽了"}, {"start": 46.68, "end": 47.76, "text": "我能不急嗎"}, {"start": 47.76, "end": 48.76, "text": "我要去找爺爺"}]}