{"file": "零号小队：北辰揽星河-第101集.mp4", "ep": 101, "duration": 54.7, "segments": [{"start": 0.56, "end": 1.16, "text": "你出去"}, {"start": 2.63, "end": 3.31, "text": "别乱说话"}, {"start": 3.31, "end": 3.87, "text": "等我回来"}, {"start": 3.87, "end": 4.47, "text": "小陈"}, {"start": 4.67, "end": 5.87, "text": "来了怎么不说一声"}, {"start": 5.87, "end": 6.95, "text": "一事都结束了"}, {"start": 7.15, "end": 7.71, "text": "正好"}, {"start": 7.87, "end": 9.19, "text": "省得你们担心我添乱"}, {"start": 9.39, "end": 10.07, "text": "怎么会"}, {"start": 10.19, "end": 11.27, "text": "我们一直在等你"}, {"start": 11.39, "end": 12.31, "text": "虚情假意"}, {"start": 12.47, "end": 13.35, "text": "别自我感动"}, {"start": 13.63, "end": 15.15, "text": "长辈和你说话就这态度"}, {"start": 15.15, "end": 15.83, "text": "站起来"}, {"start": 16.19, "end": 16.87, "text": "长辈"}, {"start": 17.31, "end": 18.07, "text": "你们也配"}, {"start": 19.07, "end": 19.63, "text": "人齐了"}, {"start": 20.46, "end": 20.9, "text": "姐"}, {"start": 20.9, "end": 21.54, "text": "快起来"}, {"start": 21.54, "end": 22.26, "text": "这是爷爷"}, {"start": 23.26, "end": 23.78, "text": "闭嘴"}, {"start": 23.9, "end": 24.82, "text": "这里没你说话的份"}, {"start": 25.02, "end": 26.18, "text": "这个真千金"}, {"start": 26.3, "end": 27.22, "text": "不能轻视"}, {"start": 27.46, "end": 28.02, "text": "好了"}, {"start": 28.14, "end": 28.82, "text": "都坐吧"}, {"start": 30.33, "end": 30.93, "text": "你也坐"}, {"start": 31.17, "end": 33.17, "text": "怎么像下手面对领导"}, {"start": 33.37, "end": 35.25, "text": "你就是苏家那个丫头"}, {"start": 35.25, "end": 36.53, "text": "我和苏家没有关系"}, {"start": 36.53, "end": 37.85, "text": "苏家可以认回你"}, {"start": 38.01, "end": 39.05, "text": "你和灵运一样"}, {"start": 39.05, "end": 40.17, "text": "都是苏家孙女"}, {"start": 40.17, "end": 42.29, "text": "两枚玉符已经还清生恩"}, {"start": 42.49, "end": 44.53, "text": "我没有上赶着给人当孙子的爱好"}, {"start": 45.76, "end": 46.76, "text": "今天大家都在"}, {"start": 46.76, "end": 47.76, "text": "我最后说一次"}, {"start": 47.96, "end": 49.76, "text": "我对苏家 陆家都没兴趣"}, {"start": 50.08, "end": 50.96, "text": "别再骚扰我"}, {"start": 51.12, "end": 51.96, "text": "各走各的路"}, {"start": 52.28, "end": 53.72, "text": "不想和霍家一个下场"}, {"start": 53.72, "end": 54.68, "text": "就离我远点"}]}