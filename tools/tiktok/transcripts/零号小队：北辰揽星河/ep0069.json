{"file": "零号小队：北辰揽星河-第69集.mp4", "ep": 69, "duration": 57.3, "segments": [{"start": 0.85, "end": 2.85, "text": "访客不得越过紧急线"}, {"start": 2.85, "end": 3.85, "text": "陈老师"}, {"start": 3.85, "end": 4.85, "text": "这些全都要用"}, {"start": 4.85, "end": 5.85, "text": "不是全用"}, {"start": 5.85, "end": 7.85, "text": "能搬来的都搬来给你们看看"}, {"start": 7.85, "end": 8.85, "text": "我能试试吗"}, {"start": 8.85, "end": 9.94, "text": "是"}, {"start": 9.94, "end": 15.33, "text": "随便是"}, {"start": 15.33, "end": 16.33, "text": "能把你的手部画面"}, {"start": 16.33, "end": 17.33, "text": "做成教学视频吗"}, {"start": 17.33, "end": 18.33, "text": "不露脸"}, {"start": 18.33, "end": 19.46, "text": "好"}, {"start": 19.46, "end": 21.35, "text": "十环"}, {"start": 21.35, "end": 22.35, "text": "十环"}, {"start": 22.35, "end": 23.35, "text": "十环"}, {"start": 23.35, "end": 25.35, "text": "灵力让势力和感知都增强了"}, {"start": 25.35, "end": 26.35, "text": "这样参加普通比赛"}, {"start": 26.35, "end": 28.35, "text": "会不会不公平"}, {"start": 28.35, "end": 32.74, "text": "九环"}, {"start": 32.74, "end": 33.74, "text": "九环"}, {"start": 33.74, "end": 37.98, "text": "九环"}, {"start": 37.98, "end": 39.98, "text": "他给十环瞄了个鞭"}, {"start": 39.98, "end": 42.65, "text": "你真的不参加比赛"}, {"start": 42.65, "end": 43.65, "text": "再考虑一下"}, {"start": 43.65, "end": 45.0, "text": "没兴趣"}, {"start": 45.0, "end": 47.99, "text": "如果把灵力覆盖在子弹上呢"}, {"start": 47.99, "end": 52.49, "text": "薄薄一层好像不够"}, {"start": 52.49, "end": 54.49, "text": "再加一点"}]}