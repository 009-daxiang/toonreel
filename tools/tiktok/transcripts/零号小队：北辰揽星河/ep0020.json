{"file": "零号小队：北辰揽星河-第20集.mp4", "ep": 20, "duration": 57.1, "segments": [{"start": 0.0, "end": 1.0, "text": "谢谢伯父"}, {"start": 1.0, "end": 1.6, "text": "谢卓"}, {"start": 1.6, "end": 2.6, "text": "温辰在哪儿"}, {"start": 2.6, "end": 3.2, "text": "谁"}, {"start": 3.2, "end": 4.2, "text": "不认识啊"}, {"start": 4.2, "end": 6.6, "text": "昨晚我亲眼看见他上了你的车"}, {"start": 6.6, "end": 8.4, "text": "谢先生这么快就忘了"}, {"start": 8.4, "end": 10.2, "text": "苏先生看错了吧"}, {"start": 10.2, "end": 12.65, "text": "好好说话"}, {"start": 12.65, "end": 13.85, "text": "你找他做什么"}, {"start": 13.85, "end": 15.05, "text": "他是苏家的孩子"}, {"start": 15.05, "end": 16.45, "text": "自然是接他回家"}, {"start": 16.45, "end": 19.05, "text": "原来温辰就是苏家亲生女儿"}, {"start": 19.05, "end": 20.45, "text": "苏家女儿是苏灵玉"}, {"start": 20.45, "end": 21.25, "text": "不是温辰"}, {"start": 21.25, "end": 22.85, "text": "两个女儿苏家养得起"}, {"start": 22.85, "end": 24.05, "text": "温辰回来会过得很好"}, {"start": 24.05, "end": 24.65, "text": "不会受委屈"}, {"start": 24.65, "end": 26.25, "text": "他受的委屈还少吗"}, {"start": 27.48, "end": 28.88, "text": "苏家他看不上"}, {"start": 28.88, "end": 30.71, "text": "他的消息我也不会说"}, {"start": 30.91, "end": 32.11, "text": "你别费心了"}, {"start": 32.11, "end": 33.11, "text": "伯父伯母"}, {"start": 33.11, "end": 33.91, "text": "打扰了"}, {"start": 33.91, "end": 34.71, "text": "小卓"}, {"start": 34.71, "end": 37.38, "text": "开门"}, {"start": 37.38, "end": 37.98, "text": "别摸头"}, {"start": 37.98, "end": 39.58, "text": "我又不是小孩子了"}, {"start": 39.58, "end": 41.58, "text": "温辰是小卓的朋友吗"}, {"start": 41.58, "end": 42.38, "text": "嗯"}, {"start": 42.38, "end": 46.46, "text": "有机会带他来家里玩"}, {"start": 46.46, "end": 48.52, "text": "这次在家待几天"}, {"start": 48.52, "end": 50.55, "text": "三天"}, {"start": 50.55, "end": 51.15, "text": "谢卓"}, {"start": 51.15, "end": 51.75, "text": "休假取消"}, {"start": 51.75, "end": 52.55, "text": "明天回来"}, {"start": 52.55, "end": 53.55, "text": "为什么"}, {"start": 53.55, "end": 54.15, "text": "少废话"}, {"start": 54.15, "end": 54.95, "text": "按时回来"}, {"start": 54.95, "end": 55.75, "text": "收到"}, {"start": 55.75, "end": 56.95, "text": "现在是一天了"}]}