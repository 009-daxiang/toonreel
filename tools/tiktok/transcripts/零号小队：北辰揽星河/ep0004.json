{"file": "零号小队：北辰揽星河-第4集.mp4", "ep": 4, "duration": 49.4, "segments": [{"start": 1.55, "end": 2.27, "text": "你怎么来了"}, {"start": 2.67, "end": 3.67, "text": "唐指辉告诉你的"}, {"start": 4.9, "end": 5.94, "text": "我申请去南京"}, {"start": 6.1, "end": 7.3, "text": "他才说你回了帝都"}, {"start": 8.3, "end": 9.3, "text": "西军能伦修"}, {"start": 9.62, "end": 11.3, "text": "我请了探亲家来接你"}, {"start": 12.98, "end": 14.26, "text": "我自己打车也能过去"}, {"start": 15.22, "end": 15.9, "text": "多麻烦"}, {"start": 16.63, "end": 17.35, "text": "我在帝都"}, {"start": 17.59, "end": 18.35, "text": "你随时叫我"}, {"start": 20.26, "end": 21.98, "text": "苏师太远去我那儿住"}, {"start": 22.46, "end": 23.58, "text": "明天我送你去学校"}, {"start": 24.22, "end": 24.66, "text": "不行"}, {"start": 27.79, "end": 28.23, "text": "不行"}, {"start": 28.51, "end": 29.27, "text": "小臣不许去"}, {"start": 32.86, "end": 34.02, "text": "你凭什么管他"}, {"start": 34.46, "end": 35.1, "text": "我是他哥"}, {"start": 35.18, "end": 35.9, "text": "不劳费心"}, {"start": 36.86, "end": 37.86, "text": "苏承既然不要"}, {"start": 38.14, "end": 38.78, "text": "这没送你"}, {"start": 39.26, "end": 40.22, "text": "另一没给苏夫人"}, {"start": 40.62, "end": 41.82, "text": "温文真是大手笔"}, {"start": 42.26, "end": 42.66, "text": "请"}, {"start": 43.45, "end": 44.13, "text": "有好提示"}, {"start": 44.49, "end": 45.69, "text": "玉芙最好贴身戴着"}, {"start": 46.01, "end": 46.77, "text": "摔不碎"}, {"start": 47.01, "end": 47.85, "text": "谢耀还羡慕"}, {"start": 48.41, "end": 49.33, "text": "他到底什么来历"}]}