{"file": "零号小队：北辰揽星河-第74集.mp4", "ep": 74, "duration": 52.5, "segments": [{"start": 2.1, "end": 3.38, "text": "陈陈 什么情况"}, {"start": 3.9, "end": 4.9, "text": "上面要求组队"}, {"start": 5.18, "end": 6.18, "text": "齐璇有一家入"}, {"start": 6.18, "end": 6.86, "text": "我就收了"}, {"start": 8.42, "end": 9.14, "text": "挺好的"}, {"start": 9.58, "end": 10.94, "text": "别把自己逼得太紧"}, {"start": 11.1, "end": 12.1, "text": "我们也不是废物"}, {"start": 12.46, "end": 12.98, "text": "温温"}, {"start": 13.38, "end": 14.86, "text": "你为什么会当齐璇的队长"}, {"start": 15.83, "end": 16.67, "text": "看着顺眼"}, {"start": 18.38, "end": 19.46, "text": "什么叫看着顺眼"}, {"start": 19.78, "end": 20.54, "text": "我们这么多人"}, {"start": 20.54, "end": 21.42, "text": "就看他顺眼"}, {"start": 23.29, "end": 24.37, "text": "我就看他顺眼"}, {"start": 27.84, "end": 28.52, "text": "所以"}, {"start": 28.88, "end": 30.11, "text": "他看我不顺眼"}, {"start": 32.51, "end": 33.35, "text": "燕叔温陈"}, {"start": 33.55, "end": 34.55, "text": "晚上一起吃饭吗"}, {"start": 34.87, "end": 36.07, "text": "附近新开了火锅店"}, {"start": 36.23, "end": 37.51, "text": "我和娇娇准备去尝尝"}, {"start": 41.75, "end": 42.27, "text": "谢谢"}, {"start": 42.67, "end": 43.87, "text": "不过我们晚上有约了"}, {"start": 44.07, "end": 44.63, "text": "下次吧"}, {"start": 45.23, "end": 46.03, "text": "改天我请客"}, {"start": 46.15, "end": 47.31, "text": "大家一起吃饭唱歌"}, {"start": 48.15, "end": 49.59, "text": "不如叫上你的朋友一起"}, {"start": 49.87, "end": 50.91, "text": "人多更热闹呀"}]}