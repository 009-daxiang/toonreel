{"file": "零号小队：北辰揽星河-第16集.mp4", "ep": 16, "duration": 56.6, "segments": [{"start": 0.0, "end": 1.08, "text": "现在是两个人了"}, {"start": 1.4, "end": 2.16, "text": "我叫温辰"}, {"start": 2.28, "end": 3.36, "text": "刚分到这个宿舍"}, {"start": 4.46, "end": 4.98, "text": "您好"}, {"start": 5.1, "end": 5.9, "text": "我叫宁燕叔"}, {"start": 6.42, "end": 7.18, "text": "宁燕叔"}, {"start": 7.3, "end": 7.98, "text": "十七岁"}, {"start": 8.1, "end": 8.78, "text": "西州人"}, {"start": 8.9, "end": 10.02, "text": "提前有淋漓波动"}, {"start": 10.3, "end": 11.1, "text": "那张控床"}, {"start": 11.22, "end": 11.9, "text": "你住那边"}, {"start": 12.9, "end": 13.34, "text": "好"}, {"start": 14.99, "end": 16.79, "text": "有两位男性朋友帮我搬行李"}, {"start": 16.91, "end": 17.71, "text": "方便进来吗"}, {"start": 18.38, "end": 18.86, "text": "可以"}, {"start": 19.14, "end": 20.26, "text": "正好我收一下桌子"}, {"start": 23.78, "end": 24.38, "text": "打扰了"}, {"start": 24.82, "end": 33.72, "text": "四十平双人且还有厨位"}, {"start": 34.0, "end": 35.04, "text": "中途大学可以"}, {"start": 35.83, "end": 36.51, "text": "有厨房"}, {"start": 36.71, "end": 37.87, "text": "要不要准备公安瓢盘"}, {"start": 39.25, "end": 39.89, "text": "别别别"}, {"start": 40.25, "end": 40.89, "text": "吃食堂"}, {"start": 41.29, "end": 41.85, "text": "不习惯"}, {"start": 42.21, "end": 43.05, "text": "我找人送饭"}, {"start": 43.77, "end": 44.69, "text": "我智商正常"}, {"start": 45.01, "end": 45.81, "text": "饿不死自己"}, {"start": 47.14, "end": 47.9, "text": "收拾完了"}, {"start": 48.02, "end": 48.82, "text": "你们可以走了"}, {"start": 49.22, "end": 50.14, "text": "那我要做什么"}, {"start": 50.99, "end": 51.63, "text": "先跟我走"}, {"start": 51.87, "end": 52.99, "text": "顺便试试训练计划"}, {"start": 53.19, "end": 53.67, "text": "去吧"}, {"start": 54.43, "end": 55.35, "text": "有事发消息"}, {"start": 55.51, "end": 56.39, "text": "及时打电话"}]}