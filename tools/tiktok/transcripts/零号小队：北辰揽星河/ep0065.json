{"file": "零号小队：北辰揽星河-第65集.mp4", "ep": 65, "duration": 55.8, "segments": [{"start": 0.0, "end": 0.88, "text": "她不想回来"}, {"start": 1.28, "end": 2.32, "text": "不如顺其自然"}, {"start": 2.6, "end": 3.32, "text": "互不打扰"}, {"start": 4.07, "end": 4.63, "text": "不行"}, {"start": 5.26, "end": 7.02, "text": "她是我十月淮胎生下的女儿"}, {"start": 7.14, "end": 7.98, "text": "我一定要认"}, {"start": 9.42, "end": 11.06, "text": "如今人尽皆知"}, {"start": 11.22, "end": 12.58, "text": "让她流落在外"}, {"start": 12.94, "end": 14.34, "text": "别人怎么看苏家"}, {"start": 16.83, "end": 17.99, "text": "把她带回来"}, {"start": 18.63, "end": 20.51, "text": "订婚宴上带来见我"}, {"start": 21.66, "end": 22.94, "text": "抓紧找老师"}, {"start": 23.26, "end": 24.66, "text": "好好教她礼仪"}, {"start": 25.34, "end": 26.18, "text": "父亲放心"}, {"start": 26.58, "end": 27.74, "text": "我一定好好教她"}, {"start": 29.74, "end": 30.86, "text": "不可以再找她一次"}, {"start": 31.22, "end": 32.14, "text": "来不来我管不了"}, {"start": 32.54, "end": 34.46, "text": "再一再二不再三"}, {"start": 36.05, "end": 36.89, "text": "多找几个"}, {"start": 37.09, "end": 38.45, "text": "礼仪绝不能出错"}, {"start": 38.89, "end": 40.05, "text": "陆家的婚约"}, {"start": 40.37, "end": 41.73, "text": "不是她能消响的"}, {"start": 44.51, "end": 45.51, "text": "确实两颗门牙"}, {"start": 45.67, "end": 46.63, "text": "需要进行修复"}, {"start": 50.94, "end": 52.5, "text": "这样怎么参加订婚宴"}]}