{"file": "零号小队：北辰揽星河-第27集.mp4", "ep": 27, "duration": 57.3, "segments": [{"start": 0.02, "end": 1.5, "text": "工作和生活分开"}, {"start": 1.82, "end": 2.9, "text": "还是另有用途"}, {"start": 3.46, "end": 6.25, "text": "今天体育课"}, {"start": 6.25, "end": 7.45, "text": "你怎么还穿长袖"}, {"start": 7.81, "end": 8.69, "text": "林老师每节课"}, {"start": 8.69, "end": 9.81, "text": "都让仙袍两千米"}, {"start": 10.37, "end": 11.41, "text": "穿长袖习惯了"}, {"start": 12.31, "end": 12.75, "text": "走吧"}, {"start": 13.27, "end": 14.67, "text": "中大体育要上三年"}, {"start": 14.67, "end": 16.23, "text": "闪打游泳攀岩"}, {"start": 16.23, "end": 16.91, "text": "一个不辣"}, {"start": 17.03, "end": 17.63, "text": "所有人"}, {"start": 17.63, "end": 18.47, "text": "仙袍五圈"}, {"start": 18.47, "end": 19.15, "text": "两千米"}, {"start": 27.99, "end": 28.51, "text": "还好"}, {"start": 29.78, "end": 30.78, "text": "身体素质不错"}, {"start": 30.94, "end": 32.02, "text": "要不要发展个特长"}, {"start": 32.02, "end": 32.66, "text": "不考虑"}, {"start": 33.22, "end": 34.28, "text": "行吧"}, {"start": 34.68, "end": 36.34, "text": "宁燕书旁边那个是谁"}, {"start": 36.54, "end": 37.46, "text": "新来的温辰"}, {"start": 37.46, "end": 38.74, "text": "现在和宁燕书是设有"}, {"start": 38.74, "end": 39.58, "text": "宁燕书军训时"}, {"start": 39.58, "end": 41.3, "text": "体能对抗射击全是第一"}, {"start": 41.3, "end": 42.46, "text": "跟燕书住一起"}, {"start": 42.7, "end": 44.02, "text": "还能增强体质"}, {"start": 44.54, "end": 45.52, "text": "集合"}, {"start": 45.96, "end": 47.14, "text": "先复习上节课"}, {"start": 47.26, "end": 47.86, "text": "宁燕书"}, {"start": 47.86, "end": 48.66, "text": "你展示一下"}, {"start": 49.18, "end": 49.94, "text": "那个新来的"}, {"start": 49.94, "end": 50.62, "text": "你配合他"}, {"start": 50.62, "end": 51.22, "text": "等等"}, {"start": 51.46, "end": 52.54, "text": "他上节课没来"}, {"start": 53.18, "end": 53.86, "text": "我知道"}, {"start": 54.18, "end": 54.78, "text": "去试试"}]}