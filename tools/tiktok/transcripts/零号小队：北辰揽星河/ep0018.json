{"file": "零号小队：北辰揽星河-第18集.mp4", "ep": 18, "duration": 112.3, "segments": [{"start": 0.08, "end": 1.0, "text": "谁是狗"}, {"start": 1.24, "end": 2.2, "text": "你胡说什么"}, {"start": 2.2, "end": 4.09, "text": "佳柔只是关心我"}, {"start": 4.09, "end": 5.29, "text": "你怎么能这么说"}, {"start": 5.29, "end": 6.21, "text": "我说她"}, {"start": 6.21, "end": 7.49, "text": "跟你有什么关系"}, {"start": 7.89, "end": 9.29, "text": "你的身份我不稀罕"}, {"start": 9.29, "end": 10.89, "text": "苏家我也看不上"}, {"start": 10.89, "end": 12.13, "text": "作为既得利益者"}, {"start": 12.13, "end": 13.17, "text": "就安分一点"}, {"start": 13.17, "end": 14.29, "text": "管好你自己"}, {"start": 14.29, "end": 15.17, "text": "我"}, {"start": 15.17, "end": 16.97, "text": "她怎么知道我是赵佳达"}, {"start": 16.97, "end": 18.09, "text": "你提过我"}, {"start": 18.87, "end": 19.71, "text": "没有"}, {"start": 19.95, "end": 22.11, "text": "燕哥哥"}, {"start": 22.11, "end": 22.99, "text": "你去哪儿"}, {"start": 22.99, "end": 24.55, "text": "我有话想和你单独说"}, {"start": 24.55, "end": 26.03, "text": "霍佳独子霍燕"}, {"start": 26.43, "end": 27.11, "text": "三个月前"}, {"start": 27.11, "end": 28.71, "text": "抢闯禁地的五人之一"}, {"start": 28.71, "end": 29.87, "text": "还是主谋"}, {"start": 31.26, "end": 32.38, "text": "就在树林里说"}, {"start": 33.65, "end": 34.69, "text": "谢谢你陪我"}, {"start": 34.69, "end": 35.53, "text": "你先回去"}, {"start": 35.97, "end": 36.53, "text": "不"}, {"start": 36.53, "end": 37.53, "text": "我就在这里等"}, {"start": 37.53, "end": 38.37, "text": "有事叫我"}, {"start": 41.88, "end": 42.6, "text": "温辰"}, {"start": 42.96, "end": 44.72, "text": "我知道你不是普通人"}, {"start": 44.72, "end": 46.28, "text": "三个月前的云雾山"}, {"start": 46.28, "end": 47.36, "text": "我都看见了"}, {"start": 48.7, "end": 49.42, "text": "所以呢"}, {"start": 51.45, "end": 52.21, "text": "你也不想自己"}, {"start": 52.21, "end": 53.57, "text": "不是普通人的事情"}, {"start": 53.93, "end": 55.17, "text": "被别人知道吧"}, {"start": 59.74, "end": 61.14, "text": "作为我女朋友"}, {"start": 61.14, "end": 62.94, "text": "我就替你保密"}, {"start": 62.94, "end": 64.74, "text": "霍佳比苏家更是没诚"}, {"start": 65.06, "end": 65.66, "text": "怎么样"}, {"start": 69.74, "end": 70.5, "text": "没事"}, {"start": 70.5, "end": 71.18, "text": "等我一下"}, {"start": 73.55, "end": 74.31, "text": "你要干什么"}, {"start": 74.59, "end": 75.87, "text": "知道我不是普通人"}, {"start": 75.87, "end": 76.87, "text": "还敢威胁我"}, {"start": 76.87, "end": 77.95, "text": "你不是公职人员吗"}, {"start": 77.95, "end": 78.79, "text": "你应该保护我们"}, {"start": 78.83, "end": 79.67, "text": "怎么能打人"}, {"start": 79.67, "end": 80.63, "text": "我还能杀了你"}, {"start": 80.63, "end": 81.15, "text": "我错了"}, {"start": 81.15, "end": 81.67, "text": "对不起"}, {"start": 81.67, "end": 82.26, "text": "我"}, {"start": 82.26, "end": 85.36, "text": "闭嘴"}, {"start": 85.36, "end": 85.96, "text": "怎么了"}, {"start": 85.96, "end": 86.44, "text": "没事"}, {"start": 86.44, "end": 87.04, "text": "回宿舍"}, {"start": 89.82, "end": 90.66, "text": "你干了什么"}, {"start": 93.52, "end": 94.96, "text": "那个温辰烂用能力"}, {"start": 95.24, "end": 96.08, "text": "他打我"}, {"start": 96.08, "end": 97.2, "text": "我要举报他"}, {"start": 98.79, "end": 99.79, "text": "真可怜"}, {"start": 99.79, "end": 101.1, "text": "不过没事"}, {"start": 101.46, "end": 102.7, "text": "很快你就不记得了"}, {"start": 103.06, "end": 103.62, "text": "来"}, {"start": 103.62, "end": 104.18, "text": "看着我"}, {"start": 109.78, "end": 110.34, "text": "好了"}, {"start": 110.74, "end": 112.22, "text": "可以通知霍佳来台人了"}]}