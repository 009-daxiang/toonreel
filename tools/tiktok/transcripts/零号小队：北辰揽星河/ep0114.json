{"file": "零号小队：北辰揽星河-第114集.mp4", "ep": 114, "duration": 49.1, "segments": [{"start": 0.6, "end": 1.28, "text": "商业区"}, {"start": 1.84, "end": 3.28, "text": "我最近不想再看见树林"}, {"start": 5.29, "end": 6.05, "text": "去百域街"}, {"start": 11.2, "end": 11.72, "text": "给你的"}, {"start": 17.26, "end": 18.7, "text": "这把枪可以承受灵力"}, {"start": 19.86, "end": 20.94, "text": "每一处都正好"}, {"start": 21.46, "end": 23.18, "text": "他认真按我的习惯做过调整"}, {"start": 25.14, "end": 25.58, "text": "谢谢"}, {"start": 26.5, "end": 27.46, "text": "玉芙随身带着"}, {"start": 27.78, "end": 28.34, "text": "能保命"}, {"start": 29.04, "end": 30.2, "text": "回去就挂在脖子上"}, {"start": 31.1, "end": 32.22, "text": "你可以给他起个名字"}, {"start": 32.7, "end": 33.94, "text": "武器也能有名字"}, {"start": 34.06, "end": 34.46, "text": "队长"}, {"start": 34.94, "end": 36.5, "text": "帮我拿一下右侧口袋里的毛笔"}, {"start": 40.46, "end": 41.34, "text": "好漂亮"}, {"start": 41.97, "end": 42.85, "text": "师傅留给我的"}, {"start": 43.37, "end": 44.17, "text": "名字叫玄冥"}, {"start": 44.57, "end": 45.09, "text": "温辰"}, {"start": 45.37, "end": 46.37, "text": "你觉得他叫什么好"}, {"start": 46.77, "end": 47.85, "text": "武器是你的同伴"}, {"start": 48.09, "end": 48.85, "text": "名字自己取"}]}