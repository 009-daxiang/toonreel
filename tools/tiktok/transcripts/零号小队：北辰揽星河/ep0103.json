{"file": "零号小队：北辰揽星河-第103集.mp4", "ep": 103, "duration": 52.5, "segments": [{"start": 0.0, "end": 1.0, "text": "这么快"}, {"start": 5.19, "end": 6.49, "text": "陆家知道分寸"}, {"start": 6.49, "end": 7.79, "text": "也会牵制苏家"}, {"start": 7.79, "end": 9.19, "text": "由他们自己兜去"}, {"start": 9.19, "end": 10.29, "text": "接下来去哪儿"}, {"start": 10.29, "end": 11.99, "text": "找个地方请你吃饭"}, {"start": 11.99, "end": 13.29, "text": "那我就不客气了"}, {"start": 14.04, "end": 15.84, "text": "齐大师替孟家处理过项目"}, {"start": 15.84, "end": 17.54, "text": "他是真正有本事的人"}, {"start": 17.54, "end": 18.64, "text": "你知道些什么"}, {"start": 18.64, "end": 19.14, "text": "姐"}, {"start": 19.14, "end": 20.14, "text": "真的不能说"}, {"start": 21.64, "end": 23.54, "text": "和西州云雾山有关"}, {"start": 29.41, "end": 31.21, "text": "他的工作从不对外提起"}, {"start": 31.8, "end": 33.4, "text": "那温辰究竟是什么人"}, {"start": 33.96, "end": 34.86, "text": "听风哥哥"}, {"start": 34.86, "end": 36.16, "text": "你怎么认识姐姐的"}, {"start": 37.81, "end": 38.61, "text": "她说过"}, {"start": 38.61, "end": 39.61, "text": "别这么叫"}, {"start": 39.81, "end": 42.24, "text": "是想"}, {"start": 44.78, "end": 45.58, "text": "回家再说"}, {"start": 46.24, "end": 47.14, "text": "苏家以后"}, {"start": 47.24, "end": 48.24, "text": "不要再打扰她"}, {"start": 48.74, "end": 49.84, "text": "若能认回她"}, {"start": 50.24, "end": 52.34, "text": "苏家的地位必定水掌船高"}]}