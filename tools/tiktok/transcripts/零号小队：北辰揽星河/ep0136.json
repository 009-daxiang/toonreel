{"file": "零号小队：北辰揽星河-第136集.mp4", "ep": 136, "duration": 58.5, "segments": [{"start": 0.75, "end": 2.35, "text": "所有人把枪放下"}, {"start": 6.85, "end": 7.41, "text": "冒犯了"}, {"start": 8.97, "end": 10.37, "text": "是剧组那个人举报的吧"}, {"start": 10.73, "end": 12.09, "text": "是 张明举报的"}, {"start": 12.77, "end": 14.05, "text": "知道了 辛苦了"}, {"start": 14.37, "end": 14.85, "text": "回去吧"}, {"start": 15.75, "end": 16.23, "text": "收队"}, {"start": 17.49, "end": 18.97, "text": "大神 这是怎么了"}, {"start": 19.88, "end": 20.64, "text": "被人举报了"}, {"start": 20.92, "end": 22.16, "text": "那怎么还对你敬礼"}, {"start": 22.48, "end": 23.6, "text": "他们发现抓错人了"}, {"start": 23.88, "end": 25.36, "text": "郑主会 他到底是谁"}, {"start": 25.52, "end": 27.08, "text": "特殊部门的首席执行者"}, {"start": 27.52, "end": 28.16, "text": "遇到他"}, {"start": 28.36, "end": 29.84, "text": "现场以他的命令为先"}, {"start": 30.04, "end": 30.8, "text": "吓死我了"}, {"start": 31.36, "end": 32.28, "text": "还好有文臣"}, {"start": 32.64, "end": 36.1, "text": "就是他 对吧"}, {"start": 36.94, "end": 37.9, "text": "张明立刻辞退"}, {"start": 38.1, "end": 39.18, "text": "行业内停止合作"}, {"start": 39.62, "end": 40.74, "text": "举报枪械没错"}, {"start": 41.14, "end": 42.06, "text": "但背后辱骂"}, {"start": 42.3, "end": 43.42, "text": "也是他自己的选择"}, {"start": 44.16, "end": 45.08, "text": "你就是文臣"}, {"start": 47.26, "end": 49.22, "text": "怪不得苏林运到处给你造谣"}, {"start": 49.5, "end": 50.66, "text": "他是怕你威胁到他"}, {"start": 52.22, "end": 53.74, "text": "交个朋友 我叫沈阳"}, {"start": 53.86, "end": 54.34, "text": "您好"}, {"start": 56.59, "end": 57.23, "text": "差点忘了"}, {"start": 57.39, "end": 58.55, "text": "我还得去苏家代话"}]}