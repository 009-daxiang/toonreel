{"file": "零号小队：北辰揽星河-第36集.mp4", "ep": 36, "duration": 58.1, "segments": [{"start": 0.64, "end": 1.72, "text": "你儿子是"}, {"start": 1.96, "end": 2.68, "text": "霍燕"}, {"start": 3.2, "end": 4.96, "text": "我霍家不是你能惹的"}, {"start": 5.12, "end": 6.28, "text": "最好老是交代"}, {"start": 6.64, "end": 7.72, "text": "帝都霍家"}, {"start": 8.16, "end": 9.08, "text": "手里粘了人命"}, {"start": 9.08, "end": 10.36, "text": "也能压下去的豪门"}, {"start": 11.2, "end": 11.84, "text": "是他"}, {"start": 12.81, "end": 13.65, "text": "没干什么"}, {"start": 14.09, "end": 14.97, "text": "踹了一脚"}, {"start": 15.25, "end": 16.37, "text": "踩断了他胳膊"}, {"start": 17.59, "end": 18.87, "text": "他应该不记得了吧"}, {"start": 23.55, "end": 25.67, "text": "给我打断他的双手双脚"}, {"start": 25.79, "end": 33.26, "text": "把谁赶过来"}, {"start": 37.86, "end": 38.86, "text": "给我的是"}, {"start": 39.3, "end": 40.06, "text": "班手"}, {"start": 41.11, "end": 42.95, "text": "说好的清澈大学生呢"}, {"start": 43.19, "end": 45.43, "text": "手搓手枪还随身带班手"}, {"start": 48.7, "end": 49.22, "text": "让开"}, {"start": 49.34, "end": 51.22, "text": "让他们走"}, {"start": 53.3, "end": 54.38, "text": "让他们散开"}]}