{"file": "零号小队：北辰揽星河-第108集.mp4", "ep": 108, "duration": 52.0, "segments": [{"start": 1.39, "end": 2.35, "text": "我环环"}, {"start": 3.56, "end": 4.2, "text": "护身符"}, {"start": 5.2, "end": 5.92, "text": "这是补偿"}, {"start": 6.2, "end": 6.92, "text": "我应得的"}, {"start": 12.94, "end": 13.54, "text": "大家好"}, {"start": 16.27, "end": 17.55, "text": "这么多人一起盯我"}, {"start": 18.14, "end": 19.38, "text": "好了 人也见到了"}, {"start": 19.54, "end": 20.78, "text": "都散了 值班去"}, {"start": 21.54, "end": 23.06, "text": "北州分局局长驻长安"}, {"start": 23.22, "end": 24.46, "text": "十三处处长李斯尔"}, {"start": 24.54, "end": 25.58, "text": "十六处处长苏慕"}, {"start": 25.9, "end": 26.5, "text": "就是他"}, {"start": 28.04, "end": 28.64, "text": "驻局好"}, {"start": 29.89, "end": 30.65, "text": "麻烦驻局了"}, {"start": 30.97, "end": 32.53, "text": "谈不上 多待几天"}, {"start": 32.97, "end": 34.53, "text": "不行 还得回去上课"}, {"start": 38.3, "end": 39.5, "text": "训练计划我给你说一下"}, {"start": 39.94, "end": 41.38, "text": "不用 你看着来就好"}, {"start": 42.08, "end": 43.8, "text": "行 你这边有什么要求"}, {"start": 44.16, "end": 46.04, "text": "九号晚上回去 训练到八号"}, {"start": 46.4, "end": 48.12, "text": "最后一天 我带他们四处走走"}, {"start": 48.68, "end": 49.96, "text": "人族的锦绣山河"}, {"start": 50.28, "end": 51.24, "text": "还能维持多久"}]}