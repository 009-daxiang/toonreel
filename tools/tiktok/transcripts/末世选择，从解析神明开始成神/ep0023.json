{"file": "末世选择，从解析神明开始成神-第23集.mp4", "ep": 23, "duration": 61.2, "segments": [{"start": 0.21, "end": 2.78, "text": "三城死亡 选A 选A"}, {"start": 2.78, "end": 6.86, "text": "听着就吓人"}, {"start": 6.86, "end": 7.86, "text": "选A的话"}, {"start": 7.86, "end": 10.86, "text": "就必须有我们几个非凡者正面硬抗了"}, {"start": 10.86, "end": 12.06, "text": "同阶教两下"}, {"start": 12.06, "end": 13.86, "text": "人类非凡者往往处于弱势"}, {"start": 13.86, "end": 15.46, "text": "他说什么就是什么"}, {"start": 15.46, "end": 17.46, "text": "我不信 我选B"}, {"start": 18.78, "end": 19.58, "text": "我选A"}, {"start": 19.58, "end": 21.78, "text": "许烈酒的诡异有多难缠"}, {"start": 21.78, "end": 23.64, "text": "你们别装不知道"}, {"start": 23.64, "end": 24.84, "text": "管他呢"}, {"start": 24.84, "end": 26.24, "text": "我选A"}, {"start": 26.24, "end": 28.64, "text": "蛇蛇虽然挺可爱的"}, {"start": 28.64, "end": 30.04, "text": "但我选A"}, {"start": 30.04, "end": 31.04, "text": "A"}, {"start": 31.04, "end": 32.24, "text": "如果选B"}, {"start": 32.24, "end": 33.64, "text": "非凡者或许能活"}, {"start": 33.64, "end": 36.38, "text": "但普通人怎么办"}, {"start": 36.38, "end": 37.38, "text": "我选A"}, {"start": 37.38, "end": 38.7, "text": "队长都选了"}, {"start": 38.7, "end": 39.9, "text": "我也选A"}, {"start": 39.9, "end": 45.24, "text": "糟 都孤立我是吗"}, {"start": 45.24, "end": 46.44, "text": "选择完毕"}, {"start": 46.44, "end": 49.24, "text": "十秒后许烈酒诡异降临"}, {"start": 49.24, "end": 54.66, "text": "请做好准备"}, {"start": 54.66, "end": 56.06, "text": "所有普通人向后退"}, {"start": 56.06, "end": 58.77, "text": "远离战场"}, {"start": 58.77, "end": 60.77, "text": "非凡者们准备战斗"}]}