{"file": "末世选择，从解析神明开始成神-第24集.mp4", "ep": 24, "duration": 81.8, "segments": [{"start": 8.05, "end": 9.25, "text": "我是辅助途径"}, {"start": 9.61, "end": 10.45, "text": "就不参与了"}, {"start": 11.07, "end": 11.95, "text": "战斗离弱"}, {"start": 12.15, "end": 13.55, "text": "跑得倒是比谁都快"}, {"start": 14.41, "end": 15.49, "text": "好 林雨"}, {"start": 15.85, "end": 17.37, "text": "普通人就交给你保护了"}, {"start": 17.37, "end": 18.65, "text": "放心 我会的"}, {"start": 19.7, "end": 20.5, "text": "废物"}, {"start": 21.08, "end": 22.48, "text": "我一个假冒的非凡者"}, {"start": 22.48, "end": 23.48, "text": "难道去送死吗"}, {"start": 23.8, "end": 24.68, "text": "五个打一个"}, {"start": 24.68, "end": 25.76, "text": "你们肯定打得过"}, {"start": 28.23, "end": 29.59, "text": "我注射了基因强化液"}, {"start": 29.75, "end": 31.03, "text": "也许能发挥一点作用"}, {"start": 32.14, "end": 32.66, "text": "还有我"}, {"start": 32.66, "end": 33.22, "text": "林先生"}, {"start": 33.22, "end": 34.7, "text": "有什么事情您尽管吩咐"}, {"start": 34.7, "end": 36.34, "text": "我们接下来可全靠您了"}, {"start": 36.34, "end": 37.42, "text": "您是我们的恩人"}, {"start": 38.14, "end": 60.7, "text": "皮肤发白无血色"}, {"start": 60.7, "end": 61.82, "text": "是尸体类诡异"}, {"start": 62.7, "end": 64.18, "text": "身上怨念尚不算强"}, {"start": 64.18, "end": 65.38, "text": "应是出入系列球"}, {"start": 66.46, "end": 67.58, "text": "有实体有影子"}, {"start": 67.58, "end": 68.9, "text": "这鬼一时来送分的"}, {"start": 68.9, "end": 69.78, "text": "原来"}, {"start": 69.78, "end": 71.38, "text": "只是一只小院士"}, {"start": 72.65, "end": 73.69, "text": "替我大控制"}, {"start": 73.89, "end": 75.09, "text": "正面让老子来"}]}