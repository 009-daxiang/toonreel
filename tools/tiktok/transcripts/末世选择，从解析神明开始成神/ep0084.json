{"file": "末世选择，从解析神明开始成神-第84集.mp4", "ep": 84, "duration": 59.8, "segments": [{"start": 0.56, "end": 1.56, "text": "沈队长"}, {"start": 2.16, "end": 4.44, "text": "有危险"}, {"start": 4.44, "end": 5.44, "text": "不算危险"}, {"start": 5.44, "end": 6.44, "text": "但有个小差距"}, {"start": 7.3, "end": 8.9, "text": "东边有批生物在逃亡"}, {"start": 8.9, "end": 9.9, "text": "疑似人类"}, {"start": 10.1, "end": 11.7, "text": "正被未知危险追击"}, {"start": 11.9, "end": 13.3, "text": "约两小时后抵达"}, {"start": 13.9, "end": 15.25, "text": "沈队"}, {"start": 16.61, "end": 18.21, "text": "确定危险程度不高吗"}, {"start": 19.44, "end": 20.24, "text": "应该吧"}, {"start": 20.7, "end": 22.5, "text": "队伍幸存者消耗过半"}, {"start": 22.7, "end": 24.1, "text": "多多补充新人"}, {"start": 24.1, "end": 25.5, "text": "遇到强制选择时"}, {"start": 25.5, "end": 27.3, "text": "也有足够的消耗的时候"}, {"start": 27.3, "end": 28.5, "text": "若危险可控"}, {"start": 28.7, "end": 30.3, "text": "可以试试救下这批人"}, {"start": 31.5, "end": 32.9, "text": "如今人类越来越少"}, {"start": 33.3, "end": 34.5, "text": "利索能医时"}, {"start": 35.1, "end": 36.5, "text": "我们该多担心责任"}, {"start": 37.46, "end": 38.06, "text": "那么"}, {"start": 38.49, "end": 39.29, "text": "准备伏击"}, {"start": 39.69, "end": 40.49, "text": "主动出击"}, {"start": 41.86, "end": 43.06, "text": "原地等候的话"}, {"start": 43.46, "end": 45.26, "text": "幸存者没几个能活着逃荡"}, {"start": 46.04, "end": 46.84, "text": "主动营救"}, {"start": 47.44, "end": 48.64, "text": "才能救下更多人"}, {"start": 50.39, "end": 51.19, "text": "言之有理"}, {"start": 51.39, "end": 54.3, "text": "死性时刻才变"}, {"start": 55.02, "end": 55.82, "text": "再等下去"}, {"start": 56.22, "end": 57.42, "text": "白仙怕是要被黑仙"}, {"start": 57.42, "end": 58.22, "text": "彻底吞掉了"}, {"start": 58.62, "end": 59.35, "text": "出发"}]}