{"file": "末世选择，从解析神明开始成神-第69集.mp4", "ep": 69, "duration": 58.9, "segments": [{"start": 3.25, "end": 4.45, "text": "神秘的恩賜"}, {"start": 4.45, "end": 5.85, "text": "從來不是免費的"}, {"start": 8.05, "end": 9.69, "text": "如果我們自己不體面"}, {"start": 10.33, "end": 12.28, "text": "恐怕他會幫我們體面"}, {"start": 15.18, "end": 16.26, "text": "我覺得你說得對"}, {"start": 16.66, "end": 17.46, "text": "我們小隊"}, {"start": 17.66, "end": 19.22, "text": "主打的就是知恩圖報"}, {"start": 19.66, "end": 20.26, "text": "拼了"}, {"start": 22.75, "end": 24.87, "text": "不知道西血鬼的味道如何"}, {"start": 26.78, "end": 27.74, "text": "既然要報恩"}, {"start": 28.37, "end": 29.49, "text": "非凡者六名"}, {"start": 29.89, "end": 31.03, "text": "全部出動"}, {"start": 31.96, "end": 33.24, "text": "剩下的四個名額"}, {"start": 33.64, "end": 35.92, "text": "由趙叔 蘇曼 刀疤"}, {"start": 35.92, "end": 37.08, "text": "還有月生參與"}, {"start": 38.57, "end": 39.29, "text": "月生"}, {"start": 39.65, "end": 40.85, "text": "他一個柔弱女孩子"}, {"start": 40.97, "end": 42.13, "text": "帶他去殺西血鬼"}, {"start": 43.14, "end": 43.82, "text": "我"}, {"start": 44.02, "end": 45.34, "text": "戰鬥人員已經足夠"}, {"start": 45.82, "end": 47.26, "text": "我需要一個智商夠高"}, {"start": 47.26, "end": 49.22, "text": "且足夠冷靜的人參與配合"}, {"start": 49.8, "end": 50.56, "text": "我選"}, {"start": 55.77, "end": 56.89, "text": "順劫保佑"}, {"start": 57.25, "end": 58.81, "text": "願你們平安歸來"}]}