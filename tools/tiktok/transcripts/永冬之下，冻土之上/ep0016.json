{"file": "永冬之下，冻土之上-第16集.mp4", "ep": 16, "duration": 49.0, "segments": [{"start": 0.0, "end": 1.48, "text": "昨日梳二回去以后"}, {"start": 1.48, "end": 3.0, "text": "心里总觉得这桩婚"}, {"start": 3.0, "end": 4.2, "text": "退得不够干净"}, {"start": 4.4, "end": 6.2, "text": "本少爷便陪他过来看看"}, {"start": 8.0, "end": 9.08, "text": "顺便看看那个"}, {"start": 9.08, "end": 11.08, "text": "不知死活的穷酸书生"}, {"start": 11.56, "end": 13.44, "text": "昨晚动成了什么模样"}, {"start": 13.44, "end": 15.48, "text": "那穷书生昨日的冷淡模样"}, {"start": 15.48, "end": 16.64, "text": "到现在想起来"}, {"start": 16.64, "end": 18.04, "text": "心里仍旧堵得慌"}, {"start": 18.04, "end": 18.64, "text": "昨日"}, {"start": 18.64, "end": 19.56, "text": "他竟连看个妹妹"}, {"start": 19.56, "end": 20.4, "text": "都看我一眼"}, {"start": 20.56, "end": 21.88, "text": "一个连组宅都不要"}, {"start": 21.88, "end": 23.6, "text": "非要住进雪坑里的疯子"}, {"start": 24.46, "end": 25.58, "text": "我倒想看看"}, {"start": 25.58, "end": 26.54, "text": "你今天"}, {"start": 26.54, "end": 28.54, "text": "还能不能像昨日那样硬气"}, {"start": 28.66, "end": 30.1, "text": "赫三爷来得正好"}, {"start": 30.18, "end": 31.06, "text": "这就是那小子"}, {"start": 31.06, "end": 32.34, "text": "拿组宅换的东西"}, {"start": 32.34, "end": 33.58, "text": "我钱德贵做生意"}, {"start": 33.58, "end": 34.42, "text": "最讲信用"}, {"start": 34.42, "end": 35.22, "text": "东西"}, {"start": 35.22, "end": 36.06, "text": "只可惜"}, {"start": 36.06, "end": 36.86, "text": "这小子"}, {"start": 36.86, "end": 38.42, "text": "怕是没命收了我"}, {"start": 44.5, "end": 45.82, "text": "动印了有什么用"}, {"start": 45.82, "end": 47.3, "text": "里头的人"}, {"start": 47.3, "end": 48.86, "text": "怕是早就动印了"}]}