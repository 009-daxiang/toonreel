{"file": "永冬之下，冻土之上-第3集.mp4", "ep": 3, "duration": 62.4, "segments": [{"start": 0.3, "end": 1.02, "text": "好"}, {"start": 1.02, "end": 2.5, "text": "赖蛤蟆开窍了"}, {"start": 2.5, "end": 3.78, "text": "这可是你自己说的"}, {"start": 3.78, "end": 4.98, "text": "算你小子实相"}, {"start": 4.98, "end": 6.26, "text": "牟川啊牟川"}, {"start": 6.26, "end": 7.98, "text": "你就抱着这破魂书"}, {"start": 7.98, "end": 8.94, "text": "像野狗一样"}, {"start": 8.94, "end": 10.58, "text": "缩在这雪坑过一辈子吧"}, {"start": 11.23, "end": 12.47, "text": "这个疯子"}, {"start": 12.47, "end": 13.31, "text": "就让他洞江"}, {"start": 13.31, "end": 14.83, "text": "在自己挖的坑里吧"}, {"start": 14.83, "end": 16.03, "text": "等开春雪化了"}, {"start": 16.03, "end": 16.63, "text": "说不定还能"}, {"start": 16.63, "end": 17.95, "text": "捡回你几根骨头"}, {"start": 21.26, "end": 21.9, "text": "牟川哥"}, {"start": 21.9, "end": 23.1, "text": "这两个人太欺负人了"}, {"start": 23.1, "end": 24.26, "text": "你怎么不还嘴"}, {"start": 24.26, "end": 25.26, "text": "还什么嘴"}, {"start": 25.66, "end": 26.7, "text": "跟要死的人"}, {"start": 26.7, "end": 27.5, "text": "有什么好争的"}, {"start": 27.5, "end": 28.5, "text": "要死的人"}, {"start": 30.27, "end": 32.22, "text": "这场雪"}, {"start": 32.22, "end": 33.02, "text": "早晚把城里的"}, {"start": 33.02, "end": 34.42, "text": "高门大族全押他"}, {"start": 35.02, "end": 35.9, "text": "贤之"}, {"start": 35.9, "end": 36.78, "text": "你是说"}, {"start": 36.78, "end": 38.34, "text": "连城里那些大宅子"}, {"start": 38.34, "end": 39.06, "text": "也扛不住"}, {"start": 39.06, "end": 39.94, "text": "越大的宅子"}, {"start": 39.94, "end": 40.82, "text": "凉假越沉"}, {"start": 40.82, "end": 42.1, "text": "上头押的雪越多"}, {"start": 42.1, "end": 42.9, "text": "塌起来"}, {"start": 42.9, "end": 43.74, "text": "只会更快"}, {"start": 43.74, "end": 44.14, "text": "可"}, {"start": 44.14, "end": 45.34, "text": "那贺家宅子"}, {"start": 45.34, "end": 46.38, "text": "青砖南木"}, {"start": 46.38, "end": 47.66, "text": "听着皆是得狠呢"}, {"start": 47.66, "end": 48.74, "text": "再皆是得凉"}, {"start": 49.06, "end": 49.94, "text": "也是木头"}, {"start": 50.94, "end": 51.98, "text": "这不是咱们村的"}, {"start": 51.98, "end": 53.34, "text": "牟川大叔生吗"}, {"start": 53.74, "end": 54.3, "text": "怎么着"}, {"start": 54.3, "end": 55.5, "text": "被未婚妻甩了"}, {"start": 55.5, "end": 56.62, "text": "活不下去了"}, {"start": 57.02, "end": 57.78, "text": "打算提前"}, {"start": 57.78, "end": 59.18, "text": "给自己挖个坟头啊"}, {"start": 60.14, "end": 60.82, "text": "前掌柜"}, {"start": 61.65, "end": 62.33, "text": "找我有事"}]}