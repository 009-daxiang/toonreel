{"file": "永冬之下，冻土之上-第62集.mp4", "ep": 62, "duration": 53.8, "segments": [{"start": 0.0, "end": 1.36, "text": "如今血灾当前"}, {"start": 1.52, "end": 3.36, "text": "全城百姓的粮食都已见底"}, {"start": 3.56, "end": 6.12, "text": "本官命你立刻交出捕捉野兔的方法"}, {"start": 6.28, "end": 7.92, "text": "以解全城百姓之急"}, {"start": 8.2, "end": 9.24, "text": "凭什么告诉你们"}, {"start": 9.4, "end": 11.04, "text": "这法子是我想出来的"}, {"start": 11.56, "end": 12.6, "text": "你们不是人多吗"}, {"start": 12.76, "end": 15.0, "text": "想吃肉 自己凭本事抓去"}, {"start": 15.24, "end": 16.72, "text": "大胆 小兔崽子"}, {"start": 16.96, "end": 17.72, "text": "你活腻了"}, {"start": 18.52, "end": 19.56, "text": "石头 别冲动"}, {"start": 19.88, "end": 20.6, "text": "会出人命的"}, {"start": 21.3, "end": 21.82, "text": "让我来"}, {"start": 22.38, "end": 23.02, "text": "牟川"}, {"start": 23.3, "end": 24.58, "text": "本官再问你一遍"}, {"start": 24.82, "end": 26.94, "text": "这方法到底眼睁睁"}, {"start": 27.18, "end": 28.54, "text": "看着满城百姓"}, {"start": 28.86, "end": 30.02, "text": "活活饿死吗"}, {"start": 30.22, "end": 31.26, "text": "孙大人说得对"}, {"start": 31.42, "end": 33.74, "text": "牟川 你就是想独吞那些野兔"}, {"start": 33.9, "end": 37.15, "text": "不办法"}, {"start": 37.15, "end": 37.71, "text": "你拆了他都"}, {"start": 38.64, "end": 41.2, "text": "牟川 你就乖乖低头腐软吧"}, {"start": 41.2, "end": 42.0, "text": "你越惨"}, {"start": 42.36, "end": 44.04, "text": "本小姐心里就越痛快"}, {"start": 48.71, "end": 49.23, "text": "方法"}, {"start": 49.71, "end": 51.03, "text": "写在上面了 自己看"}, {"start": 52.41, "end": 53.69, "text": "你要是敢耍花招"}]}