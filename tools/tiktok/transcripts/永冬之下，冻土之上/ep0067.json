{"file": "永冬之下，冻土之上-第67集.mp4", "ep": 67, "duration": 100.5, "segments": [{"start": 0.0, "end": 0.8, "text": "从今天起"}, {"start": 0.8, "end": 1.6, "text": "想活命的"}, {"start": 1.6, "end": 2.6, "text": "就都听我安排"}, {"start": 2.8, "end": 3.4, "text": "会挖的"}, {"start": 3.4, "end": 4.2, "text": "去挖地穴"}, {"start": 4.2, "end": 5.16, "text": "趁着这两天"}, {"start": 5.16, "end": 6.8, "text": "我教你们用火先烤化洞土"}, {"start": 6.8, "end": 7.56, "text": "会砸煤的"}, {"start": 7.56, "end": 8.32, "text": "跟着周时"}, {"start": 8.32, "end": 10.12, "text": "把那批石煤洗了做成蜂窝煤"}, {"start": 10.12, "end": 11.08, "text": "会下甲层的"}, {"start": 11.08, "end": 12.0, "text": "去抓兔子"}, {"start": 12.0, "end": 12.8, "text": "但记住"}, {"start": 12.8, "end": 13.6, "text": "从今往后"}, {"start": 13.6, "end": 14.28, "text": "肉要吃"}, {"start": 14.28, "end": 15.24, "text": "骨汤和松针水"}, {"start": 15.24, "end": 16.24, "text": "一样都不能断"}, {"start": 21.15, "end": 21.79, "text": "先生"}, {"start": 22.3, "end": 23.46, "text": "那 那我们往后"}, {"start": 23.46, "end": 25.02, "text": "就一直住在这半山腰了"}, {"start": 25.02, "end": 25.9, "text": "住到雪化"}, {"start": 26.34, "end": 27.26, "text": "这场寒冬"}, {"start": 27.26, "end": 28.3, "text": "不会永远下去"}, {"start": 28.54, "end": 29.86, "text": "等那遮天的灰散金"}, {"start": 29.86, "end": 31.18, "text": "阳光重新照下来"}, {"start": 31.18, "end": 32.14, "text": "雪总会化的"}, {"start": 32.5, "end": 33.42, "text": "到那时"}, {"start": 33.46, "end": 34.34, "text": "我们就下山"}, {"start": 34.34, "end": 35.34, "text": "重新开荒"}, {"start": 35.62, "end": 37.06, "text": "从这片被埋掉的土地"}, {"start": 37.06, "end": 38.14, "text": "得靠活下来的人"}, {"start": 38.14, "end": 39.1, "text": "一寸一寸"}, {"start": 39.1, "end": 40.1, "text": "重新立起来"}, {"start": 85.72, "end": 86.56, "text": "牟川哥"}, {"start": 86.56, "end": 87.56, "text": "雪化了"}, {"start": 87.56, "end": 89.24, "text": "雪灾 雪灾过去了"}, {"start": 89.24, "end": 89.68, "text": "咱们"}, {"start": 89.68, "end": 90.88, "text": "咱们熬过来了"}, {"start": 94.58, "end": 95.14, "text": "走吧"}, {"start": 95.66, "end": 96.58, "text": "旧的世界"}, {"start": 96.58, "end": 97.62, "text": "已经埋在雪里了"}, {"start": 98.21, "end": 99.25, "text": "新的开荒"}, {"start": 99.25, "end": 100.37, "text": "才刚刚开始"}]}