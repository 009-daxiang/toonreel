{"file": "永冬之下，冻土之上-第24集.mp4", "ep": 24, "duration": 53.2, "segments": [{"start": 2.67, "end": 3.27, "text": "牧川哥"}, {"start": 3.27, "end": 4.47, "text": "这些人刚才还骂咱们"}, {"start": 4.47, "end": 5.11, "text": "现在转头就来"}, {"start": 5.11, "end": 6.15, "text": "偷学咱们挖雪屋"}, {"start": 6.15, "end": 7.19, "text": "脸皮怎么这么厚"}, {"start": 7.19, "end": 7.91, "text": "无妨"}, {"start": 7.91, "end": 9.11, "text": "没有核心的门道"}, {"start": 9.11, "end": 10.39, "text": "他们最多学个皮毛"}, {"start": 10.39, "end": 11.39, "text": "皮毛"}, {"start": 11.39, "end": 12.11, "text": "别看了"}, {"start": 12.11, "end": 12.91, "text": "过来帮忙"}, {"start": 12.91, "end": 14.19, "text": "屋子还得再修修"}, {"start": 14.19, "end": 16.3, "text": "咱们人多"}, {"start": 16.3, "end": 18.18, "text": "就在牧川那小子旁边见"}, {"start": 18.18, "end": 19.38, "text": "他选的地段好"}, {"start": 19.38, "end": 21.18, "text": "咱们照着他的样子来"}, {"start": 21.18, "end": 23.38, "text": "见个比他大十倍的"}, {"start": 23.38, "end": 23.82, "text": "对"}, {"start": 23.82, "end": 24.98, "text": "让他先得一几天"}, {"start": 24.98, "end": 26.46, "text": "等咱们把大王见好了"}, {"start": 26.46, "end": 27.26, "text": "长长亮亮的"}, {"start": 27.26, "end": 28.1, "text": "拆死他"}, {"start": 28.1, "end": 30.1, "text": "再挖大了"}, {"start": 30.1, "end": 31.14, "text": "你们看"}, {"start": 31.14, "end": 32.54, "text": "牧川那小子的门"}, {"start": 32.54, "end": 33.66, "text": "怎么是往里开的"}, {"start": 33.9, "end": 34.94, "text": "咱们平时住的屋子"}, {"start": 34.94, "end": 35.86, "text": "门不都是往外推的吗"}, {"start": 35.86, "end": 36.74, "text": "管他往里往外"}, {"start": 36.74, "end": 37.82, "text": "门能进人就行"}, {"start": 37.82, "end": 38.34, "text": "哪像他的"}, {"start": 38.34, "end": 39.46, "text": "扣扣扣的老鼠洞"}, {"start": 39.46, "end": 40.46, "text": "进出还得趴地上爬"}, {"start": 40.46, "end": 41.26, "text": "丢不丢人"}, {"start": 41.26, "end": 41.94, "text": "咱们这门"}, {"start": 41.94, "end": 43.54, "text": "得挖得宽畅气派点"}, {"start": 43.54, "end": 44.7, "text": "这才像的屋子吧"}, {"start": 44.7, "end": 45.18, "text": "长亮"}, {"start": 45.18, "end": 45.74, "text": "对"}, {"start": 45.74, "end": 47.06, "text": "咱们把门挖大点挖高点"}, {"start": 47.06, "end": 48.42, "text": "人能直着腰进出"}, {"start": 48.42, "end": 49.58, "text": "多长亮"}, {"start": 49.58, "end": 50.54, "text": "这才叫门"}, {"start": 50.54, "end": 51.3, "text": "牧川哥"}, {"start": 51.3, "end": 52.02, "text": "他们那门"}, {"start": 52.02, "end": 53.18, "text": "跟你说的正相法呀"}]}