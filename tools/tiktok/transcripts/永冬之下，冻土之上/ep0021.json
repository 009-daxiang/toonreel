{"file": "永冬之下，冻土之上-第21集.mp4", "ep": 21, "duration": 50.0, "segments": [{"start": 0.0, "end": 0.72, "text": "前掌柜家"}, {"start": 0.72, "end": 1.72, "text": "他家用的可都是上好的"}, {"start": 1.72, "end": 2.6, "text": "南木和砖瓦"}, {"start": 2.6, "end": 3.92, "text": "就说他家一点事都没有"}, {"start": 3.92, "end": 4.64, "text": "咱们去看看"}, {"start": 4.64, "end": 5.64, "text": "让他收留我们"}, {"start": 7.82, "end": 8.74, "text": "前掌柜"}, {"start": 8.74, "end": 9.26, "text": "您行行好"}, {"start": 9.26, "end": 9.7, "text": "干什么"}, {"start": 9.7, "end": 10.9, "text": "我们这些人的屋子"}, {"start": 10.9, "end": 11.9, "text": "都塌了"}, {"start": 11.9, "end": 12.82, "text": "这么冷的天"}, {"start": 12.82, "end": 13.42, "text": "到了晚上"}, {"start": 13.42, "end": 14.02, "text": "人在外头"}, {"start": 14.02, "end": 15.34, "text": "可真会冻死啊"}, {"start": 15.34, "end": 16.7, "text": "您家宅子这么大"}, {"start": 16.7, "end": 17.82, "text": "还有那么多空屋"}, {"start": 17.82, "end": 20.7, "text": "能不能让我们进去挤一挤"}, {"start": 20.7, "end": 21.98, "text": "是啊 前掌柜"}, {"start": 21.98, "end": 23.06, "text": "就住几天"}, {"start": 23.06, "end": 24.06, "text": "对 等雪厅就走"}, {"start": 24.06, "end": 25.18, "text": "我们马上走"}, {"start": 25.18, "end": 26.38, "text": "我们绝不白拆跳水"}, {"start": 26.38, "end": 27.26, "text": "什么活都能干"}, {"start": 27.26, "end": 29.02, "text": "什么活都能干"}, {"start": 29.02, "end": 30.46, "text": "住我家"}, {"start": 30.46, "end": 33.43, "text": "是 是啊"}, {"start": 33.43, "end": 35.18, "text": "凭什么"}, {"start": 35.18, "end": 36.38, "text": "我这宅子"}, {"start": 36.38, "end": 39.37, "text": "是老子花真金白银修起来的"}, {"start": 39.37, "end": 40.65, "text": "你们一群泥腿子"}, {"start": 40.65, "end": 41.89, "text": "说进来就进来"}, {"start": 41.89, "end": 42.97, "text": "弄脏了我的院子"}, {"start": 42.97, "end": 44.17, "text": "踩坏了我的地板"}, {"start": 44.17, "end": 45.49, "text": "谁赔"}, {"start": 45.49, "end": 46.89, "text": "可这天这么冷"}, {"start": 46.89, "end": 48.29, "text": "我们没地方去"}, {"start": 48.29, "end": 49.97, "text": "真会冻死人的"}]}