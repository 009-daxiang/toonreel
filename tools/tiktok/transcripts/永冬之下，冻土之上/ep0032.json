{"file": "永冬之下，冻土之上-第32集.mp4", "ep": 32, "duration": 50.4, "segments": [{"start": 0.0, "end": 1.68, "text": "完了 外头全是雪"}, {"start": 1.88, "end": 2.88, "text": "门被雪埋了"}, {"start": 3.68, "end": 5.2, "text": "埋 埋了多少"}, {"start": 5.9, "end": 6.82, "text": "都怪你"}, {"start": 7.02, "end": 8.5, "text": "非要把雪屋建在这儿"}, {"start": 8.58, "end": 9.62, "text": "这里是被封"}, {"start": 9.7, "end": 10.66, "text": "可被封的地方"}, {"start": 10.66, "end": 11.9, "text": "也是存雪的地方"}, {"start": 11.9, "end": 13.02, "text": "昨晚那么大的雪"}, {"start": 13.02, "end": 14.5, "text": "全往咱们这边堆了"}, {"start": 14.66, "end": 16.5, "text": "我 我哪知道"}, {"start": 16.74, "end": 18.62, "text": "我看牟川也把屋子建在这边"}, {"start": 18.78, "end": 20.1, "text": "我才跟着挖的"}, {"start": 20.7, "end": 22.1, "text": "你还有脸替牟川"}, {"start": 22.18, "end": 23.54, "text": "人间的门就开那么小"}, {"start": 23.54, "end": 24.9, "text": "你非说什么大门棋牌"}, {"start": 24.9, "end": 25.82, "text": "都这么高这么宽"}, {"start": 25.82, "end": 26.54, "text": "现在好了"}, {"start": 26.54, "end": 27.54, "text": "门往外开"}, {"start": 27.54, "end": 28.42, "text": "外面全是雪"}, {"start": 28.42, "end": 29.14, "text": "怎么推"}, {"start": 29.26, "end": 30.18, "text": "那怎么办"}, {"start": 30.66, "end": 31.26, "text": "怎么不会"}, {"start": 31.26, "end": 32.7, "text": "这么被活埋在这儿吗"}, {"start": 32.7, "end": 38.63, "text": "我不想"}, {"start": 38.63, "end": 39.83, "text": "不想死就挖"}, {"start": 40.38, "end": 41.14, "text": "门打不开"}, {"start": 41.14, "end": 42.06, "text": "就把门板砸了"}, {"start": 42.06, "end": 43.26, "text": "咱们从这里往外挖"}, {"start": 43.26, "end": 43.86, "text": "这么多人"}, {"start": 43.86, "end": 45.1, "text": "我就不信挖不出去"}, {"start": 45.58, "end": 46.58, "text": "快挖"}, {"start": 49.43, "end": 50.35, "text": "挖 挖"}]}