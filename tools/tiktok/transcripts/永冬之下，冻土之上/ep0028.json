{"file": "永冬之下，冻土之上-第28集.mp4", "ep": 28, "duration": 51.2, "segments": [{"start": 0.0, "end": 2.0, "text": "看看"}, {"start": 2.0, "end": 3.0, "text": "这才叫屋子"}, {"start": 3.0, "end": 4.0, "text": "哪像牧川那个破雪窝"}, {"start": 4.0, "end": 5.0, "text": "门洞就巴掌大一点"}, {"start": 5.0, "end": 6.0, "text": "就是"}, {"start": 6.0, "end": 7.0, "text": "一个书呆子"}, {"start": 7.0, "end": 8.0, "text": "咱们这么多人一起"}, {"start": 8.0, "end": 9.0, "text": "还能够如现在"}, {"start": 9.0, "end": 10.0, "text": "趴着爬"}, {"start": 10.0, "end": 11.0, "text": "走 进去看看"}, {"start": 17.13, "end": 18.13, "text": "怎么回事"}, {"start": 18.13, "end": 19.13, "text": "怎么屋里还这么冷"}, {"start": 19.13, "end": 21.47, "text": "这雪屋"}, {"start": 21.47, "end": 23.47, "text": "也没牧川说的那么暖和"}, {"start": 23.47, "end": 25.47, "text": "我还行死进来"}, {"start": 25.47, "end": 26.47, "text": "就不用挨动了呢"}, {"start": 26.47, "end": 27.47, "text": "光靠这破雪"}, {"start": 27.47, "end": 28.47, "text": "哪能暖和"}, {"start": 28.47, "end": 29.47, "text": "把火升起来"}, {"start": 30.47, "end": 31.47, "text": "可 可这是雪屋啊"}, {"start": 31.47, "end": 32.47, "text": "雪见了火不得化"}, {"start": 32.47, "end": 33.47, "text": "真在这里头点火"}, {"start": 33.47, "end": 35.47, "text": "屋顶塌下来怎么办"}, {"start": 35.47, "end": 36.47, "text": "牧川昨天晚上"}, {"start": 36.47, "end": 37.47, "text": "就在里头烧了一夜"}, {"start": 37.47, "end": 38.47, "text": "他那屋子塌了吗"}, {"start": 38.47, "end": 39.47, "text": "都是雪挖的"}, {"start": 39.47, "end": 41.47, "text": "他能烧 咱们凭什么不能烧"}, {"start": 41.47, "end": 48.65, "text": "真的"}, {"start": 48.65, "end": 49.65, "text": "我就说这法子"}, {"start": 49.65, "end": 50.65, "text": "没什么细心了"}, {"start": 50.65, "end": 51.65, "text": "什么都说"}]}