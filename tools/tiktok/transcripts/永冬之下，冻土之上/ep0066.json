{"file": "永冬之下，冻土之上-第66集.mp4", "ep": 66, "duration": 50.3, "segments": [{"start": 0.0, "end": 1.48, "text": "因为很快"}, {"start": 1.48, "end": 3.0, "text": "我们就需要更多的人手了"}, {"start": 10.27, "end": 11.27, "text": "先救还有气的"}, {"start": 11.59, "end": 16.56, "text": "牟川"}, {"start": 16.96, "end": 19.04, "text": "是本官 是我糊涂"}, {"start": 19.4, "end": 20.28, "text": "你若不救"}, {"start": 20.28, "end": 21.32, "text": "我们这些先人"}, {"start": 21.32, "end": 23.0, "text": "今日就全交代在这儿了"}, {"start": 23.48, "end": 24.88, "text": "何乐 少说话"}, {"start": 25.04, "end": 27.02, "text": "牟川先生"}, {"start": 27.02, "end": 28.18, "text": "孙大人快快请起"}, {"start": 28.46, "end": 29.82, "text": "我救你们 不图这个"}, {"start": 30.85, "end": 31.69, "text": "牟川先生"}, {"start": 31.89, "end": 33.49, "text": "我们当初有眼不识泰山"}, {"start": 33.49, "end": 35.09, "text": "处处为难你 羞辱你"}, {"start": 35.09, "end": 36.29, "text": "还想抢你的屋子"}, {"start": 36.29, "end": 37.37, "text": "抢你的活路"}, {"start": 37.61, "end": 38.77, "text": "可你不计前嫌"}, {"start": 38.77, "end": 40.25, "text": "救了我们全家的命"}, {"start": 40.41, "end": 41.05, "text": "以后"}, {"start": 41.05, "end": 43.09, "text": "你就是我们的再生父母"}, {"start": 43.09, "end": 45.09, "text": "再生父母"}, {"start": 45.41, "end": 46.09, "text": "都起来吧"}, {"start": 46.65, "end": 47.21, "text": "跪着"}, {"start": 47.45, "end": 48.41, "text": "是活不下去的"}]}