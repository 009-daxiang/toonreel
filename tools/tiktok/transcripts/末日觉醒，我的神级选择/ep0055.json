{"file": "末日觉醒，我的神级选择-第55集.mp4", "ep": 55, "duration": 64.0, "segments": [{"start": 0.0, "end": 2.44, "text": "先手后手多更快 更难被偷袭"}, {"start": 3.1, "end": 3.74, "text": "就他了"}, {"start": 4.1, "end": 5.26, "text": "选神经灵力"}, {"start": 5.46, "end": 7.46, "text": "你发放 请定做骗客"}, {"start": 9.89, "end": 11.49, "text": "连指纹的摩擦都分得起"}, {"start": 12.15, "end": 13.91, "text": "我只是在往超级战士上走"}, {"start": 15.89, "end": 17.53, "text": "我们对练吧 你说过的"}, {"start": 17.97, "end": 20.01, "text": "行 正好练练我的反应"}, {"start": 20.7, "end": 21.34, "text": "你先手"}, {"start": 21.86, "end": 23.46, "text": "我先手你就没机会了"}, {"start": 30.78, "end": 32.02, "text": "继续 别停"}, {"start": 32.34, "end": 34.7, "text": "实战是打到一方彻底输为止"}, {"start": 34.98, "end": 35.99, "text": "好"}, {"start": 37.4, "end": 37.92, "text": "不对"}, {"start": 38.54, "end": 39.22, "text": "脚快了"}, {"start": 39.8, "end": 40.8, "text": "身子收不回来"}, {"start": 41.76, "end": 42.8, "text": "手腕跟上"}, {"start": 43.4, "end": 44.08, "text": "别光动手"}, {"start": 45.64, "end": 46.6, "text": "多洗条全身"}, {"start": 47.28, "end": 48.4, "text": "别老使一两个地方"}, {"start": 52.55, "end": 53.23, "text": "差不多了"}, {"start": 54.15, "end": 55.11, "text": "再打药愚轻"}, {"start": 55.43, "end": 56.47, "text": "太晚也没效果"}]}