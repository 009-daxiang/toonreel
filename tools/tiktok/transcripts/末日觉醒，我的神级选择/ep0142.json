{"file": "末日觉醒，我的神级选择-第142集.mp4", "ep": 142, "duration": 54.9, "segments": [{"start": 0.0, "end": 1.0, "text": "战斗慢慢练"}, {"start": 1.2, "end": 2.4, "text": "往后素号操练我"}, {"start": 2.4, "end": 3.2, "text": "我操练你"}, {"start": 4.02, "end": 4.86, "text": "姜雪姐"}, {"start": 4.98, "end": 6.66, "text": "你打不过素号哥哥吗"}, {"start": 7.44, "end": 7.88, "text": "嗯"}, {"start": 8.36, "end": 9.68, "text": "他近战强的离谱"}, {"start": 10.08, "end": 11.52, "text": "我连他的边都摸不到"}, {"start": 11.8, "end": 12.92, "text": "只有挨打的份"}, {"start": 19.78, "end": 21.18, "text": "一身毛跟雪似的"}, {"start": 21.42, "end": 22.46, "text": "还这么有好奇"}, {"start": 22.78, "end": 24.42, "text": "往后就叫你奥雪吧"}, {"start": 28.89, "end": 30.17, "text": "奥雪这才三个月吧"}, {"start": 30.33, "end": 31.73, "text": "一口就能咬断紧追"}, {"start": 32.09, "end": 33.49, "text": "不愧是便衣胜手"}, {"start": 33.81, "end": 35.05, "text": "触发支线任务"}, {"start": 35.17, "end": 36.09, "text": "末世粮仓"}, {"start": 36.29, "end": 38.93, "text": "收集二十种不同的可食用作物种子"}, {"start": 39.09, "end": 40.73, "text": "完成集会丰厚奖励"}, {"start": 42.11, "end": 43.43, "text": "哥哥给他取名了"}, {"start": 43.63, "end": 44.43, "text": "奥雪"}, {"start": 44.67, "end": 45.47, "text": "真好听"}, {"start": 46.19, "end": 48.43, "text": "他现在最年的是你了"}, {"start": 49.4, "end": 51.32, "text": "他认主也认旧人"}, {"start": 51.72, "end": 52.48, "text": "你多陪他"}, {"start": 52.8, "end": 53.68, "text": "他招养起你"}, {"start": 54.04, "end": 54.48, "text": "嗯"}]}