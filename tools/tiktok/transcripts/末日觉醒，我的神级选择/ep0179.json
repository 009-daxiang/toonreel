{"file": "末日觉醒，我的神级选择-第179集.mp4", "ep": 179, "duration": 56.3, "segments": [{"start": 0.11, "end": 0.79, "text": "素豪"}, {"start": 1.07, "end": 2.67, "text": "沿海那几个大城的安全区"}, {"start": 2.67, "end": 3.55, "text": "开始转移了"}, {"start": 3.79, "end": 4.87, "text": "正用电牌告诉大家"}, {"start": 4.87, "end": 5.67, "text": "撤离路线"}, {"start": 5.67, "end": 6.51, "text": "让幸存者"}, {"start": 6.51, "end": 7.67, "text": "去集合点等收编"}, {"start": 8.4, "end": 9.04, "text": "往哪转"}, {"start": 9.68, "end": 11.44, "text": "北边往西乃的高地"}, {"start": 11.64, "end": 13.08, "text": "南边往云桂那片走"}, {"start": 13.52, "end": 14.68, "text": "云桂的高原能区"}, {"start": 14.88, "end": 16.16, "text": "可有片盆地 不行"}, {"start": 18.42, "end": 19.14, "text": "为啥"}, {"start": 19.54, "end": 20.62, "text": "盆地四面是山"}, {"start": 20.82, "end": 21.94, "text": "海拔看着不低"}, {"start": 22.42, "end": 23.78, "text": "可白雾一旦翻过山口"}, {"start": 23.78, "end": 24.5, "text": "倒灌进去"}, {"start": 24.94, "end": 25.62, "text": "整个盆地"}, {"start": 25.62, "end": 26.22, "text": "就成了一口"}, {"start": 26.22, "end": 27.18, "text": "灌满水的锅"}, {"start": 27.74, "end": 28.94, "text": "海拔不能光看高"}, {"start": 29.42, "end": 30.7, "text": "得看周围都不兜得住"}, {"start": 36.59, "end": 37.55, "text": "下车吃午饭"}, {"start": 37.79, "end": 38.35, "text": "歇会儿"}, {"start": 38.47, "end": 38.99, "text": "清清"}, {"start": 39.23, "end": 39.83, "text": "你看这个"}, {"start": 41.11, "end": 42.19, "text": "跟昨天那批一样"}, {"start": 42.71, "end": 43.31, "text": "这就是丧失"}, {"start": 43.31, "end": 44.43, "text": "往后进化的方向了"}, {"start": 44.87, "end": 46.31, "text": "从心脏往外掌黑壳"}, {"start": 46.39, "end": 47.43, "text": "五官慢慢消失"}, {"start": 48.59, "end": 49.43, "text": "等壳掌满"}, {"start": 49.63, "end": 50.31, "text": "手枪"}, {"start": 50.31, "end": 51.51, "text": "冲锋枪都打不动了"}, {"start": 51.99, "end": 53.47, "text": "连自我意识都没了"}, {"start": 53.79, "end": 54.95, "text": "进化得再强"}, {"start": 55.31, "end": 56.31, "text": "又有什么意思"}]}