{"file": "末日觉醒，我的神级选择-第43集.mp4", "ep": 43, "duration": 53.3, "segments": [{"start": 2.34, "end": 3.14, "text": "蘇浩同學"}, {"start": 3.34, "end": 4.1, "text": "你等一下"}, {"start": 4.5, "end": 5.3, "text": "你來拼命裡"}, {"start": 5.38, "end": 6.5, "text": "食物分配你怎麼看"}, {"start": 9.08, "end": 10.32, "text": "你支持配幾隻吧"}, {"start": 10.52, "end": 11.84, "text": "我們今晚大概不回來了"}, {"start": 12.28, "end": 13.24, "text": "剩下的食物"}, {"start": 13.72, "end": 14.68, "text": "你們自己處理"}, {"start": 22.69, "end": 23.49, "text": "我跟你走"}, {"start": 23.77, "end": 24.77, "text": "我什麼都聽你的"}, {"start": 24.81, "end": 25.77, "text": "什麼都肯做"}, {"start": 26.05, "end": 26.77, "text": "帶我一起"}, {"start": 26.85, "end": 28.01, "text": "我也想去西藏"}, {"start": 29.43, "end": 30.03, "text": "你瘋了"}, {"start": 30.39, "end": 30.91, "text": "他都要走了"}, {"start": 30.91, "end": 31.75, "text": "你跟去做什麼"}, {"start": 33.84, "end": 34.68, "text": "我收購了"}, {"start": 34.68, "end": 35.64, "text": "沒水西藏"}, {"start": 35.64, "end": 36.36, "text": "沒飯吃"}, {"start": 36.36, "end": 37.44, "text": "還提心吊膽"}, {"start": 37.56, "end": 39.36, "text": "你除了抱怨還會幹什麼"}, {"start": 39.36, "end": 40.76, "text": "看看人家蘇浩"}, {"start": 43.12, "end": 43.64, "text": "孫仁"}, {"start": 43.64, "end": 44.6, "text": "我還在六十九"}, {"start": 44.64, "end": 45.48, "text": "內在五十五"}, {"start": 45.48, "end": 46.56, "text": "一能六十四"}, {"start": 46.56, "end": 47.68, "text": "兩天前還編排"}, {"start": 47.68, "end": 48.44, "text": "我只會打架"}, {"start": 48.44, "end": 49.44, "text": "沒槍有什麼用"}, {"start": 50.17, "end": 51.41, "text": "現在倒是想跟對了"}, {"start": 52.09, "end": 52.93, "text": "一般豁死"}]}