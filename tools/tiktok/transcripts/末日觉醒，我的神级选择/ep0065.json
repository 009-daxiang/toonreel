{"file": "末日觉醒，我的神级选择-第65集.mp4", "ep": 65, "duration": 79.9, "segments": [{"start": 0.0, "end": 2.0, "text": "原来我还有空间不够的危机感"}, {"start": 2.94, "end": 3.94, "text": "这一翻倍"}, {"start": 4.14, "end": 4.74, "text": "舒坦"}, {"start": 5.34, "end": 6.14, "text": "囤获的命"}, {"start": 6.34, "end": 7.74, "text": "再开增长车那个"}, {"start": 8.59, "end": 10.59, "text": "请于三项中选择情依"}, {"start": 12.27, "end": 13.67, "text": "汉路者油电混合"}, {"start": 13.67, "end": 14.87, "text": "空车15吨半"}, {"start": 14.87, "end": 16.67, "text": "居民俩用装甲运用车"}, {"start": 16.67, "end": 19.47, "text": "能拖着一辆坦克在几乎任何地形形式"}, {"start": 19.67, "end": 21.47, "text": "抛跑底盘太低走不了土路"}, {"start": 21.47, "end": 22.87, "text": "防弹商务也就坐着"}, {"start": 22.87, "end": 24.07, "text": "我要的是又大又壮"}, {"start": 24.07, "end": 25.07, "text": "屁事耐造的"}, {"start": 25.07, "end": 25.87, "text": "选汉路者"}, {"start": 25.87, "end": 26.47, "text": "可改装"}, {"start": 26.47, "end": 28.07, "text": "请选车向车头车轮"}, {"start": 28.07, "end": 30.27, "text": "要防弹的折叠双层铝俱车箱"}, {"start": 30.27, "end": 31.47, "text": "三脚推撞车头"}, {"start": 31.47, "end": 32.07, "text": "防弹玻璃"}, {"start": 32.07, "end": 33.87, "text": "越野耐磨轮胎不要铝带"}, {"start": 33.87, "end": 34.87, "text": "车里带电力系统"}, {"start": 34.87, "end": 36.47, "text": "空调充放电插口"}, {"start": 36.67, "end": 37.67, "text": "改装完毕"}, {"start": 37.67, "end": 40.07, "text": "请指定一辆现实车辆作为载体"}, {"start": 40.27, "end": 41.27, "text": "就用许晴那辆"}, {"start": 41.27, "end": 41.87, "text": "有了它"}, {"start": 41.87, "end": 43.47, "text": "往后全国都能随便点"}, {"start": 43.47, "end": 44.27, "text": "可惜"}, {"start": 44.27, "end": 45.47, "text": "是头池油的巨手"}, {"start": 45.87, "end": 47.07, "text": "这点油未不保他"}, {"start": 47.4, "end": 48.0, "text": "先记下"}, {"start": 48.2, "end": 48.8, "text": "得搞油"}, {"start": 48.8, "end": 49.8, "text": "最后一个"}, {"start": 49.8, "end": 51.4, "text": "千人斩的奖励"}, {"start": 51.66, "end": 52.26, "text": "开"}, {"start": 52.26, "end": 56.3, "text": "于三项中选择情依"}, {"start": 56.5, "end": 58.5, "text": "千人斩就给这种货"}, {"start": 58.94, "end": 59.94, "text": "那万人斩呢"}, {"start": 60.34, "end": 60.94, "text": "不敢想"}, {"start": 60.94, "end": 62.14, "text": "精神力空刀"}, {"start": 62.14, "end": 62.94, "text": "隔空杀敌"}, {"start": 62.94, "end": 64.14, "text": "我精神八十一"}, {"start": 64.14, "end": 64.54, "text": "够"}, {"start": 64.54, "end": 65.34, "text": "更妙的是"}, {"start": 65.34, "end": 66.14, "text": "我有一一"}, {"start": 66.14, "end": 67.74, "text": "能一边耗一边给我回经历"}, {"start": 67.74, "end": 68.94, "text": "等于边用边冲"}, {"start": 68.94, "end": 70.34, "text": "续航根本不愁"}, {"start": 70.34, "end": 71.34, "text": "选预见"}, {"start": 71.34, "end": 75.38, "text": "一发散"}, {"start": 75.38, "end": 76.38, "text": "从今往后"}, {"start": 76.38, "end": 77.89, "text": "这刀"}, {"start": 77.89, "end": 80.05, "text": "离了手也能杀人"}]}