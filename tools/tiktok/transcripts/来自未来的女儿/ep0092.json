{"file": "来自未来的女儿-第92集.mp4", "ep": 92, "duration": 65.1, "segments": [{"start": 1.39, "end": 2.39, "text": "乖"}, {"start": 2.39, "end": 3.59, "text": "待会就能看到妈妈"}, {"start": 3.59, "end": 4.55, "text": "要输"}, {"start": 4.55, "end": 5.55, "text": "我就是叔叔"}, {"start": 5.55, "end": 10.49, "text": "宝宝要进"}, {"start": 10.49, "end": 11.49, "text": "云宝"}, {"start": 11.49, "end": 15.05, "text": "吃不吃饼"}, {"start": 15.05, "end": 16.05, "text": "宝宝不是饼饼啊"}, {"start": 16.05, "end": 17.05, "text": "爸爸说了"}, {"start": 17.05, "end": 19.85, "text": "宝宝进化"}, {"start": 19.85, "end": 20.85, "text": "云宝"}, {"start": 20.85, "end": 22.85, "text": "爸爸有说不能吃糖吗"}, {"start": 22.85, "end": 23.85, "text": "没有啊"}, {"start": 23.85, "end": 25.36, "text": "好"}, {"start": 25.36, "end": 27.36, "text": "那我们小点声"}, {"start": 27.36, "end": 28.36, "text": "悄悄去看妈妈"}, {"start": 28.36, "end": 29.36, "text": "好"}, {"start": 29.36, "end": 36.17, "text": "宝宝不是悄悄啊"}, {"start": 36.17, "end": 38.17, "text": "还好长得像她"}, {"start": 38.17, "end": 39.17, "text": "我的宝宝"}, {"start": 39.17, "end": 40.2, "text": "叫爸爸"}, {"start": 41.2, "end": 42.2, "text": "好"}, {"start": 42.2, "end": 45.54, "text": "爸爸给爸爸和奶奶"}, {"start": 45.54, "end": 46.54, "text": "小胖子"}, {"start": 46.54, "end": 51.06, "text": "你把床单弄脏了"}, {"start": 51.06, "end": 52.06, "text": "谢谢爸爸"}, {"start": 53.06, "end": 56.94, "text": "还真是云争的种"}, {"start": 56.94, "end": 57.94, "text": "人小骨头倒硬"}, {"start": 58.94, "end": 59.94, "text": "待会我就让你看着"}, {"start": 59.94, "end": 61.94, "text": "临经确是怎么在我面前"}, {"start": 61.94, "end": 62.94, "text": "苦苦哀求的"}, {"start": 62.94, "end": 63.94, "text": "乖乖在这"}]}