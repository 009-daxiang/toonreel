{"file": "来自未来的女儿-第97集.mp4", "ep": 97, "duration": 72.9, "segments": [{"start": 0.08, "end": 2.08, "text": "除擦伤和欲擒外無大礙"}, {"start": 2.32, "end": 4.0, "text": "沒有骨折和其他外傷"}, {"start": 4.4, "end": 8.1, "text": "不可能"}, {"start": 8.42, "end": 9.22, "text": "那個狗狸的孫子"}, {"start": 9.22, "end": 10.18, "text": "肯定打了我家寶寶"}, {"start": 10.18, "end": 13.34, "text": "整個是小狗狸的孫仔啊"}, {"start": 15.21, "end": 16.37, "text": "哥 我錯了"}, {"start": 16.77, "end": 17.57, "text": "我聞名點"}, {"start": 18.79, "end": 19.79, "text": "雲寶真乖"}, {"start": 20.23, "end": 22.83, "text": "姨姨 帥花狗狗哪裡啊"}, {"start": 24.94, "end": 26.46, "text": "狗狗在訓導員車上呢"}, {"start": 26.74, "end": 28.06, "text": "狗狗恩公啊"}, {"start": 28.26, "end": 29.82, "text": "寶寶好多謝謝"}, {"start": 30.62, "end": 31.9, "text": "我們寶寶還挺有文化"}, {"start": 32.06, "end": 33.02, "text": "都知道恩公了"}, {"start": 33.18, "end": 34.46, "text": "寶寶喜恩公"}, {"start": 34.74, "end": 36.9, "text": "肉麻 狗狗是恩公"}, {"start": 39.8, "end": 41.32, "text": "怎麼一股農裂喜業的味道"}, {"start": 41.76, "end": 42.92, "text": "平時不都是奶香嗎"}, {"start": 44.73, "end": 45.85, "text": "還有洗衣粉味"}, {"start": 46.53, "end": 47.33, "text": "那個畜生"}, {"start": 47.77, "end": 48.89, "text": "他居然敢逼我們不到"}, {"start": 48.89, "end": 49.65, "text": "兩歲的雲寶"}, {"start": 49.65, "end": 50.77, "text": "當苦力洗衣服"}, {"start": 50.89, "end": 52.73, "text": "寶寶這麼洗的哇"}, {"start": 53.01, "end": 54.57, "text": "寶寶刷刷刷"}, {"start": 54.85, "end": 56.21, "text": "寶寶拍拍拍"}, {"start": 56.37, "end": 57.77, "text": "寶寶抓抓抓"}, {"start": 58.5, "end": 59.62, "text": "寶寶還刷馬桶"}, {"start": 60.38, "end": 61.5, "text": "寶寶還晾衣服"}, {"start": 61.94, "end": 63.78, "text": "寶寶還在冷水裡搓衣服"}, {"start": 64.06, "end": 65.02, "text": "天塌了"}, {"start": 65.02, "end": 66.42, "text": "我可憐的寶寶"}, {"start": 69.6, "end": 70.32, "text": "寶寶平安"}, {"start": 70.4, "end": 71.24, "text": "豪法無損"}, {"start": 71.56, "end": 72.88, "text": "正在車上忽悠他書"}]}