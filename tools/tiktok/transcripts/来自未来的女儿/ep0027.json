{"file": "来自未来的女儿-第27集.mp4", "ep": 27, "duration": 72.4, "segments": [{"start": 5.39, "end": 6.47, "text": "要吐吐"}, {"start": 7.3, "end": 7.86, "text": "宝宝"}, {"start": 7.86, "end": 8.86, "text": "叔叔再换五十块"}, {"start": 8.86, "end": 9.98, "text": "我给你保证"}, {"start": 9.98, "end": 11.18, "text": "真菜"}, {"start": 11.18, "end": 13.44, "text": "麻烦让一让"}, {"start": 13.44, "end": 14.2, "text": "挺大人了"}, {"start": 14.2, "end": 19.94, "text": "还跟我们小孩计较"}, {"start": 19.94, "end": 20.42, "text": "宝宝"}, {"start": 20.42, "end": 21.38, "text": "看叔叔的"}, {"start": 21.38, "end": 24.06, "text": "宝宝姓云宝"}, {"start": 24.06, "end": 26.42, "text": "今年一岁八"}, {"start": 26.42, "end": 27.02, "text": "哦"}, {"start": 27.02, "end": 28.26, "text": "还没到两岁"}, {"start": 28.26, "end": 30.82, "text": "好小"}, {"start": 30.82, "end": 32.42, "text": "一杯咖啡就要两百多"}, {"start": 32.42, "end": 33.62, "text": "云妻怎么还不来"}, {"start": 33.62, "end": 34.9, "text": "我身上纷纹没有"}, {"start": 34.9, "end": 35.58, "text": "你再不来"}, {"start": 35.58, "end": 36.7, "text": "我今天连这家店的大门"}, {"start": 36.7, "end": 37.62, "text": "都出不去"}, {"start": 37.62, "end": 38.38, "text": "哥哥"}, {"start": 38.38, "end": 44.98, "text": "宝宝"}, {"start": 44.98, "end": 50.49, "text": "宝宝抓"}, {"start": 50.49, "end": 51.17, "text": "云宝"}, {"start": 51.17, "end": 52.17, "text": "待会儿我说按"}, {"start": 52.21, "end": 53.57, "text": "你就按红色按钮"}, {"start": 61.36, "end": 62.28, "text": "小孩"}, {"start": 62.28, "end": 64.71, "text": "你刚才说你姓沐"}, {"start": 64.71, "end": 66.07, "text": "哥哥不咒"}, {"start": 66.07, "end": 69.23, "text": "宝宝玩啊"}, {"start": 69.23, "end": 69.91, "text": "叔叔"}, {"start": 69.91, "end": 71.15, "text": "麻烦跟爷爷说"}, {"start": 71.15, "end": 72.27, "text": "我晚点回去"}]}