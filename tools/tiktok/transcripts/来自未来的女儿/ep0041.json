{"file": "来自未来的女儿-第41集.mp4", "ep": 41, "duration": 58.3, "segments": [{"start": 0.66, "end": 1.62, "text": "林靜萱"}, {"start": 2.1, "end": 3.06, "text": "两年不见"}, {"start": 3.65, "end": 4.61, "text": "你更漂亮了"}, {"start": 8.92, "end": 10.36, "text": "云宝一不高兴就打我"}, {"start": 10.8, "end": 11.68, "text": "原来是像你"}, {"start": 11.84, "end": 12.8, "text": "你是不是疯了"}, {"start": 13.04, "end": 14.08, "text": "你跟别的女人搞出孩子"}, {"start": 14.08, "end": 14.6, "text": "让我当妈"}, {"start": 14.6, "end": 15.12, "text": "你想都别想"}, {"start": 15.12, "end": 16.16, "text": "云宝可爱也不行"}, {"start": 17.38, "end": 17.9, "text": "这样呢"}, {"start": 18.38, "end": 19.01, "text": "行不行"}, {"start": 23.74, "end": 24.5, "text": "我错了我错了"}, {"start": 24.5, "end": 25.5, "text": "不闹了 我有正事"}, {"start": 25.5, "end": 26.18, "text": "别扯头发"}, {"start": 26.38, "end": 27.22, "text": "云宝看到不好看"}, {"start": 27.22, "end": 27.86, "text": "杀死你"}, {"start": 41.38, "end": 42.54, "text": "云宝是我们的孩子"}, {"start": 42.82, "end": 44.38, "text": "是我们在平行时空生的孩子"}, {"start": 44.58, "end": 45.38, "text": "她被人欺负了"}, {"start": 45.38, "end": 46.18, "text": "回来找我们"}, {"start": 46.42, "end": 48.35, "text": "我要下车"}, {"start": 48.55, "end": 49.3, "text": "你个神经病"}, {"start": 49.3, "end": 50.1, "text": "两年搞出个孩子"}, {"start": 50.1, "end": 50.74, "text": "还变成疯子"}, {"start": 50.74, "end": 52.02, "text": "我真是后悔死喜欢过你"}, {"start": 52.02, "end": 52.86, "text": "你承认喜欢我"}, {"start": 53.22, "end": 53.82, "text": "以前"}, {"start": 54.02, "end": 54.66, "text": "以前"}, {"start": 54.66, "end": 55.34, "text": "以前"}, {"start": 55.5, "end": 56.66, "text": "两年前的那天傍晚"}, {"start": 57.06, "end": 58.06, "text": "我准备和你表白"}]}