{"file": "来自未来的女儿-第83集.mp4", "ep": 83, "duration": 71.9, "segments": [{"start": 0.0, "end": 1.0, "text": "坐这里玩吧"}, {"start": 1.0, "end": 1.96, "text": "爷爷在开会"}, {"start": 1.96, "end": 3.0, "text": "等会一起回家"}, {"start": 3.0, "end": 3.84, "text": "爸爸"}, {"start": 3.84, "end": 5.44, "text": "宝宝画发发吧"}, {"start": 5.8, "end": 18.3, "text": "董事长夫人交代了"}, {"start": 18.3, "end": 19.42, "text": "开会超过三小时"}, {"start": 19.42, "end": 20.42, "text": "进去放些点心"}, {"start": 20.42, "end": 21.3, "text": "是啊 你去"}, {"start": 21.3, "end": 22.42, "text": "我不敢你去"}, {"start": 23.44, "end": 24.72, "text": "宝宝去玩"}, {"start": 24.88, "end": 31.02, "text": "你们好呀"}, {"start": 33.24, "end": 34.92, "text": "爷爷得快宝宝"}, {"start": 44.62, "end": 46.02, "text": "云宝怎么来了"}, {"start": 46.02, "end": 47.42, "text": "我的宝宝好像都"}, {"start": 47.42, "end": 48.9, "text": "宝宝长得还是这么好"}, {"start": 49.46, "end": 50.7, "text": "爷爷还在开会"}, {"start": 50.86, "end": 51.86, "text": "你再旁边坐一会儿"}, {"start": 51.86, "end": 52.5, "text": "好不好"}, {"start": 52.78, "end": 54.19, "text": "爷爷吃饭饭"}, {"start": 54.19, "end": 55.31, "text": "要休息"}, {"start": 56.95, "end": 57.67, "text": "好了"}, {"start": 58.15, "end": 59.51, "text": "今天的会议先到这儿"}, {"start": 59.51, "end": 60.63, "text": "大家都散了吧"}, {"start": 60.99, "end": 62.11, "text": "妈妈走啊"}, {"start": 62.11, "end": 63.83, "text": "宝宝说啊 宝宝说"}, {"start": 63.83, "end": 64.83, "text": "好好好"}, {"start": 64.83, "end": 65.71, "text": "云宝说"}, {"start": 65.71, "end": 66.91, "text": "大家先且留一留"}, {"start": 66.91, "end": 68.27, "text": "小云总 您说"}, {"start": 68.75, "end": 70.68, "text": "大家散娃"}]}