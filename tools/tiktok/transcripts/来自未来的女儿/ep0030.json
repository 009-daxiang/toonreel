{"file": "来自未来的女儿-第30集.mp4", "ep": 30, "duration": 82.9, "segments": [{"start": 1.2, "end": 3.52, "text": "叔叔 计划一亿吧"}, {"start": 4.04, "end": 5.85, "text": "宝宝 叔叔喜欢他"}, {"start": 6.13, "end": 6.85, "text": "他救过我"}, {"start": 6.85, "end": 8.01, "text": "在海拔四千米的地方"}, {"start": 8.01, "end": 8.89, "text": "给我留下地图"}, {"start": 8.89, "end": 9.65, "text": "分给我食物"}, {"start": 9.65, "end": 10.65, "text": "从来不求回报"}, {"start": 10.85, "end": 12.13, "text": "这样的人能坏到哪里去"}, {"start": 13.21, "end": 13.81, "text": "笨蛋"}, {"start": 13.93, "end": 15.05, "text": "有吗 笨蛋"}, {"start": 16.03, "end": 17.15, "text": "你要是不姓云"}, {"start": 17.15, "end": 18.55, "text": "你看他还帮不帮你"}, {"start": 21.39, "end": 22.23, "text": "你年纪小小"}, {"start": 22.23, "end": 23.23, "text": "别把人想那么坏"}, {"start": 23.47, "end": 24.79, "text": "你大哥子叔叔在后面跟着"}, {"start": 24.79, "end": 25.87, "text": "我们先送你回家"}, {"start": 26.15, "end": 27.51, "text": "在我家门口等我一下"}, {"start": 27.51, "end": 28.83, "text": "我有东西送给云宝"}, {"start": 30.93, "end": 32.89, "text": "云宝 你叔叔太傻了"}, {"start": 32.89, "end": 34.49, "text": "有事按我头像打电话"}, {"start": 35.25, "end": 36.21, "text": "好"}, {"start": 38.76, "end": 40.6, "text": "喂 云宝 是哥哥"}, {"start": 43.96, "end": 44.96, "text": "宝宝会打电话了"}, {"start": 44.96, "end": 46.4, "text": "我们快回老宅给爷爷奶奶看"}, {"start": 46.68, "end": 51.53, "text": "小屁孩"}, {"start": 51.81, "end": 52.85, "text": "心思还蛮多"}, {"start": 53.09, "end": 59.4, "text": "招鼻子甜甜的"}, {"start": 59.4, "end": 60.96, "text": "宝宝 是枝子花香"}, {"start": 62.0, "end": 63.48, "text": "不是要给爷爷奶奶看娃娃吗"}, {"start": 63.48, "end": 64.56, "text": "叔叔帮你拿娃娃"}, {"start": 66.74, "end": 68.22, "text": "奶奶的小乖宝"}, {"start": 68.22, "end": 69.74, "text": "奶奶 宝宝抓"}, {"start": 69.74, "end": 71.18, "text": "宝宝 你害我"}, {"start": 72.06, "end": 74.3, "text": "宝宝 爷爷在这"}, {"start": 75.66, "end": 77.82, "text": "我们宝宝一个人回来的"}]}