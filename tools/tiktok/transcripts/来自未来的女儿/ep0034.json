{"file": "来自未来的女儿-第34集.mp4", "ep": 34, "duration": 73.1, "segments": [{"start": 4.14, "end": 4.94, "text": "醒了"}, {"start": 5.98, "end": 6.58, "text": "我"}, {"start": 6.58, "end": 16.22, "text": "叔叔好了"}, {"start": 16.62, "end": 18.23, "text": "叔叔好了"}, {"start": 18.63, "end": 19.23, "text": "哥"}, {"start": 19.23, "end": 20.23, "text": "我怎么在医院"}, {"start": 20.23, "end": 21.03, "text": "文喜呢"}, {"start": 21.03, "end": 21.83, "text": "不说哈"}, {"start": 21.83, "end": 23.5, "text": "坏医下药药"}, {"start": 23.5, "end": 24.7, "text": "坏医抓"}, {"start": 25.1, "end": 26.18, "text": "下药"}, {"start": 26.58, "end": 27.62, "text": "是那杯水"}, {"start": 28.22, "end": 30.02, "text": "文喜竟然算计我"}, {"start": 31.32, "end": 32.32, "text": "二少好运气"}, {"start": 32.32, "end": 33.72, "text": "碰到了个灌犯女骗子"}, {"start": 33.72, "end": 34.72, "text": "还被录像了"}, {"start": 35.12, "end": 36.12, "text": "关键时刻"}, {"start": 36.12, "end": 37.32, "text": "是宝宝带人救了你"}, {"start": 37.32, "end": 38.32, "text": "宝宝厉害"}, {"start": 40.97, "end": 41.57, "text": "宝宝"}, {"start": 41.57, "end": 42.77, "text": "叔叔好爱你"}, {"start": 43.37, "end": 45.53, "text": "给我跪好了"}, {"start": 45.53, "end": 47.38, "text": "妈救我"}, {"start": 49.03, "end": 49.83, "text": "爸爸"}, {"start": 49.83, "end": 51.23, "text": "叔叔叫我"}, {"start": 51.23, "end": 52.43, "text": "叔叔太开心了"}, {"start": 52.43, "end": 53.23, "text": "他在笑"}, {"start": 53.23, "end": 53.83, "text": "爸爸"}, {"start": 53.83, "end": 55.03, "text": "妈妈回啊"}, {"start": 55.03, "end": 56.63, "text": "妈妈下个月五号回来"}, {"start": 56.63, "end": 57.83, "text": "宝宝撕到哪里了"}, {"start": 57.83, "end": 58.98, "text": "肉"}, {"start": 58.98, "end": 59.98, "text": "肉肉在奶奶家"}, {"start": 59.98, "end": 63.53, "text": "回宝宝家"}, {"start": 63.53, "end": 64.73, "text": "回明月弯"}, {"start": 64.73, "end": 68.86, "text": "意味着我要独自带娃"}, {"start": 68.86, "end": 69.66, "text": "妈"}, {"start": 69.66, "end": 70.46, "text": "差不多了"}, {"start": 70.46, "end": 72.06, "text": "你这几天看不顺眼云起"}, {"start": 72.06, "end": 73.06, "text": "就把他送我这来"}]}