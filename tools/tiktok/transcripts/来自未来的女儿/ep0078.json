{"file": "来自未来的女儿-第78集.mp4", "ep": 78, "duration": 75.7, "segments": [{"start": 2.96, "end": 5.36, "text": "乖 不怕 奶奶在"}, {"start": 5.36, "end": 6.36, "text": "她不敢"}, {"start": 6.36, "end": 7.56, "text": "死小孩"}, {"start": 7.56, "end": 15.69, "text": "妈 她为了个小孩党"}, {"start": 15.69, "end": 17.02, "text": "林边月"}, {"start": 17.02, "end": 19.22, "text": "她是个不满两岁的宝宝"}, {"start": 19.22, "end": 21.42, "text": "你这一巴掌把人打出个毫带怎么办"}, {"start": 21.42, "end": 22.62, "text": "你的家教呢"}, {"start": 22.62, "end": 25.69, "text": "几乎宝宝"}, {"start": 25.69, "end": 28.38, "text": "妈 明明是她自己手剑"}, {"start": 28.38, "end": 29.18, "text": "闭嘴"}, {"start": 29.18, "end": 29.98, "text": "林边月"}, {"start": 29.98, "end": 30.98, "text": "是我和你爸的问题"}, {"start": 30.98, "end": 32.38, "text": "没把你交好"}, {"start": 32.38, "end": 33.78, "text": "她这么小 手有点快"}, {"start": 33.78, "end": 35.38, "text": "你躲不就成了 怎么能还手"}, {"start": 35.38, "end": 42.03, "text": "你出去 这饭别吃了"}, {"start": 42.03, "end": 42.83, "text": "没事"}, {"start": 43.03, "end": 45.23, "text": "奶奶用被挡的没打到脸"}, {"start": 45.23, "end": 47.43, "text": "快一夜 说不起啊"}, {"start": 47.43, "end": 49.93, "text": "说不起"}, {"start": 49.93, "end": 51.13, "text": "小傻子"}, {"start": 51.13, "end": 52.53, "text": "对不起都不会说"}, {"start": 52.53, "end": 64.35, "text": "哇"}, {"start": 64.35, "end": 65.75, "text": "林边月"}, {"start": 65.75, "end": 67.78, "text": "你不是个孩子了"}, {"start": 67.78, "end": 68.98, "text": "云宝很聪明"}, {"start": 68.98, "end": 72.78, "text": "别听她胡说"}, {"start": 72.78, "end": 73.98, "text": "边月"}, {"start": 73.98, "end": 75.58, "text": "你跟个小孩子计较什么"}]}