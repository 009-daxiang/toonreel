{"file": "来自未来的女儿-第12集.mp4", "ep": 12, "duration": 86.6, "segments": [{"start": 1.2, "end": 2.16, "text": "这么能熬"}, {"start": 7.74, "end": 8.74, "text": "看云宝妈妈呢"}, {"start": 16.87, "end": 18.55, "text": "胡说什么"}, {"start": 18.83, "end": 19.59, "text": "起来练练"}, {"start": 19.59, "end": 20.39, "text": "哥 哥我错了"}, {"start": 21.03, "end": 21.59, "text": "倒水"}, {"start": 23.18, "end": 27.11, "text": "应该队友不是好人"}, {"start": 27.59, "end": 28.83, "text": "怎么就不是好人了"}, {"start": 29.67, "end": 33.26, "text": "哥 我的事不重要"}, {"start": 33.58, "end": 34.3, "text": "我都看到了"}, {"start": 34.62, "end": 35.54, "text": "你再看临经区"}, {"start": 36.1, "end": 37.46, "text": "早知道你俩不对劲"}, {"start": 37.66, "end": 38.98, "text": "高中就没来演去"}, {"start": 39.66, "end": 41.77, "text": "冯奈哥 陆哥都看出来了"}, {"start": 41.77, "end": 42.97, "text": "咱们不敢说而已"}, {"start": 42.97, "end": 43.89, "text": "你高中天天逃课"}, {"start": 43.89, "end": 44.93, "text": "去研究潜水装备"}, {"start": 44.93, "end": 45.73, "text": "事都不考"}, {"start": 45.73, "end": 46.93, "text": "零二小姐一转过来"}, {"start": 46.93, "end": 47.89, "text": "你整个人大变"}, {"start": 48.49, "end": 49.71, "text": "半年时间"}, {"start": 49.95, "end": 51.43, "text": "半年时间稳居第一"}, {"start": 51.43, "end": 52.31, "text": "一出成绩"}, {"start": 52.31, "end": 53.31, "text": "你就装作无一戒"}, {"start": 53.31, "end": 54.55, "text": "从榜单旁边走过"}, {"start": 54.55, "end": 55.91, "text": "还孔雀开评"}, {"start": 55.91, "end": 57.63, "text": "天天绕路去高一那边"}, {"start": 57.63, "end": 60.15, "text": "是谁主动参加化妆舞会的"}, {"start": 60.15, "end": 61.35, "text": "揉到人家小腰"}, {"start": 61.35, "end": 63.11, "text": "可把你勒死了"}, {"start": 63.11, "end": 64.83, "text": "你高兴的一个月没揍我"}, {"start": 64.83, "end": 66.31, "text": "我记得清清楚楚"}, {"start": 66.83, "end": 68.59, "text": "两个人隔着人群"}, {"start": 68.59, "end": 69.75, "text": "你看我一眼"}, {"start": 69.75, "end": 70.83, "text": "我看你一眼"}, {"start": 71.97, "end": 74.05, "text": "那交易屋有那么难学"}, {"start": 74.05, "end": 76.41, "text": "两人有时间就去排练"}, {"start": 76.41, "end": 78.17, "text": "天天揉着"}, {"start": 78.17, "end": 79.25, "text": "又不说话"}, {"start": 79.29, "end": 80.49, "text": "就拉小手"}, {"start": 80.49, "end": 81.45, "text": "一个劲的拉"}, {"start": 81.45, "end": 82.37, "text": "一个劲的拉"}, {"start": 82.37, "end": 83.57, "text": "连在一起都不放开"}, {"start": 85.17, "end": 86.53, "text": "你这叫脑袖承诺"}]}