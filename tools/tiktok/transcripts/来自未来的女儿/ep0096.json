{"file": "来自未来的女儿-第96集.mp4", "ep": 96, "duration": 62.8, "segments": [{"start": 0.0, "end": 3.29, "text": "哥哥 你害我"}, {"start": 3.29, "end": 4.33, "text": "走 桑叔"}, {"start": 4.69, "end": 19.04, "text": "干什么"}, {"start": 20.52, "end": 21.12, "text": "抱歉"}, {"start": 21.32, "end": 22.64, "text": "我不小心碰到了他而已"}, {"start": 22.84, "end": 24.16, "text": "交给你们 我放心"}, {"start": 26.54, "end": 27.78, "text": "今时不同往日"}, {"start": 28.38, "end": 29.26, "text": "我当爸爸了"}, {"start": 30.17, "end": 31.13, "text": "算你走运"}, {"start": 32.08, "end": 33.96, "text": "我让你欺负我宝宝"}, {"start": 35.62, "end": 37.34, "text": "快 把他给我嫁走"}, {"start": 39.68, "end": 40.28, "text": "宝宝"}, {"start": 41.1, "end": 42.26, "text": "叔叔对不起你"}, {"start": 42.5, "end": 43.18, "text": "叔叔"}, {"start": 43.18, "end": 45.62, "text": "叔叔乖娃 信宝宝不乖呀"}, {"start": 45.82, "end": 47.42, "text": "宝宝是学宝宝啊"}, {"start": 47.42, "end": 48.78, "text": "宝宝整整不进化"}, {"start": 49.78, "end": 51.14, "text": "哥 对不起"}, {"start": 51.14, "end": 53.18, "text": "我差点把云宝弄丢了"}, {"start": 55.3, "end": 55.98, "text": "云齐"}, {"start": 56.62, "end": 57.9, "text": "当着云宝的面哭"}, {"start": 58.26, "end": 59.62, "text": "小家伙会笑话你的"}, {"start": 59.78, "end": 60.86, "text": "叔叔乖娃"}, {"start": 61.02, "end": 62.78, "text": "宝宝不笑话"}]}