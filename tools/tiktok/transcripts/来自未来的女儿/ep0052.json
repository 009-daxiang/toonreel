{"file": "来自未来的女儿-第52集.mp4", "ep": 52, "duration": 69.3, "segments": [{"start": 4.78, "end": 5.74, "text": "宝宝棒"}, {"start": 5.74, "end": 6.66, "text": "宝宝真棒"}, {"start": 6.66, "end": 7.66, "text": "来 再来一口"}, {"start": 8.78, "end": 15.77, "text": "叔叔累"}, {"start": 15.77, "end": 17.53, "text": "叔叔为爸爸"}, {"start": 17.53, "end": 18.73, "text": "妈妈累"}, {"start": 18.73, "end": 19.97, "text": "妈妈不累"}, {"start": 19.97, "end": 22.13, "text": "宝宝 你不喜欢青菜对不对"}, {"start": 22.73, "end": 26.65, "text": "宝宝 叔叔来找你了"}, {"start": 27.13, "end": 30.98, "text": "我是不是没有给到云宝安全感"}, {"start": 31.38, "end": 32.86, "text": "这样好日子没有两天"}, {"start": 33.1, "end": 34.94, "text": "我刚见她 她也乖得不行"}, {"start": 34.94, "end": 36.22, "text": "现在可以坐我头上"}, {"start": 36.5, "end": 37.82, "text": "现在你叫她乖宝宝"}, {"start": 37.82, "end": 39.06, "text": "过几天叫她没习惯"}, {"start": 39.06, "end": 40.9, "text": "让开 云宝不在"}, {"start": 40.9, "end": 41.9, "text": "别跟我掏进火"}, {"start": 41.9, "end": 43.9, "text": "宝宝 膝盖还痛吗"}, {"start": 44.42, "end": 46.82, "text": "宝宝痛 妈妈糊糊"}, {"start": 47.06, "end": 48.74, "text": "好 妈妈糊糊"}, {"start": 49.3, "end": 51.06, "text": "我们宝宝是个香香软软"}, {"start": 51.06, "end": 52.54, "text": "白白津津胖宝宝"}, {"start": 53.1, "end": 55.1, "text": "宝宝 要是有人欺负你"}, {"start": 55.1, "end": 56.38, "text": "一定要给妈妈讲"}, {"start": 63.45, "end": 65.94, "text": "宝宝 妈妈会为你出气"}, {"start": 66.5, "end": 67.7, "text": "欺负宝宝的人"}, {"start": 68.02, "end": 69.22, "text": "妈妈会打回去"}]}