{"file": "来自未来的女儿-第13集.mp4", "ep": 13, "duration": 80.0, "segments": [{"start": 2.38, "end": 3.22, "text": "都过去了"}, {"start": 3.58, "end": 4.62, "text": "这些话不要再说"}, {"start": 4.78, "end": 5.42, "text": "为啥"}, {"start": 5.62, "end": 6.62, "text": "你俩不谈对象了"}, {"start": 6.78, "end": 7.7, "text": "那云宝怎么办"}, {"start": 8.82, "end": 9.7, "text": "她不喜欢我"}, {"start": 9.7, "end": 10.58, "text": "我也不喜欢她"}, {"start": 10.74, "end": 11.34, "text": "就这样"}, {"start": 11.5, "end": 12.42, "text": "以后各走各路"}, {"start": 12.54, "end": 13.66, "text": "不喜欢还生孩子"}, {"start": 13.82, "end": 14.3, "text": "渣男"}, {"start": 15.58, "end": 26.24, "text": "宝宝醒久了"}, {"start": 27.68, "end": 28.95, "text": "宝宝"}, {"start": 29.15, "end": 30.03, "text": "不要啃手手"}, {"start": 30.19, "end": 31.11, "text": "手手有细菌"}, {"start": 31.35, "end": 32.75, "text": "爸爸马上给宝宝冲奶奶"}, {"start": 33.31, "end": 40.16, "text": "上个闹钟"}, {"start": 40.4, "end": 41.48, "text": "明天得八点起"}, {"start": 41.84, "end": 43.16, "text": "不然这胖宝宝跟着我"}, {"start": 43.32, "end": 44.32, "text": "一天得饿三顿"}, {"start": 44.68, "end": 47.47, "text": "宝宝"}, {"start": 47.83, "end": 49.49, "text": "爸爸不喝"}, {"start": 49.49, "end": 50.13, "text": "宝宝喝"}, {"start": 50.53, "end": 51.21, "text": "云宝"}, {"start": 51.57, "end": 52.17, "text": "哥"}, {"start": 52.37, "end": 53.65, "text": "起床吃饭了"}, {"start": 54.62, "end": 55.7, "text": "叔叔也不知道做了"}, {"start": 55.7, "end": 56.7, "text": "什么黑暗料理"}, {"start": 57.66, "end": 59.34, "text": "嘿嘿 饭饭挖"}, {"start": 59.92, "end": 61.84, "text": "宝宝吃宝宝了"}]}