{"file": "来自未来的女儿-第101集.mp4", "ep": 101, "duration": 158.7, "segments": [{"start": 0.41, "end": 1.61, "text": "走 老实点"}, {"start": 15.78, "end": 17.46, "text": "爸 打我干吗"}, {"start": 19.16, "end": 20.04, "text": "恩公 哥哥"}, {"start": 20.04, "end": 21.24, "text": "宝宝不说了"}, {"start": 21.24, "end": 22.36, "text": "细薰仔"}, {"start": 22.36, "end": 23.68, "text": "花烟细薰仔"}, {"start": 25.7, "end": 26.74, "text": "爸 什么爸"}, {"start": 26.74, "end": 28.78, "text": "从今天起银行卡全停了"}, {"start": 30.58, "end": 32.26, "text": "别怕 有我在"}, {"start": 33.31, "end": 35.71, "text": "没有 我就是有点恶心"}, {"start": 36.51, "end": 38.27, "text": "初中一句仗义直言"}, {"start": 38.27, "end": 40.23, "text": "没想到能让人一想到这种地步"}, {"start": 41.64, "end": 44.78, "text": "妈妈不 宝宝护妈妈"}, {"start": 44.78, "end": 45.66, "text": "讨人厌"}, {"start": 45.9, "end": 47.06, "text": "我们去医院吧"}, {"start": 47.06, "end": 48.14, "text": "医院有好多好吃的"}, {"start": 48.14, "end": 49.38, "text": "爸 宝宝爱"}, {"start": 49.38, "end": 50.98, "text": "走 爸爸走 妈妈走"}, {"start": 50.98, "end": 53.1, "text": "爷爷走 奶奶走 叔叔走"}, {"start": 58.05, "end": 59.49, "text": "宝宝爱妈妈"}, {"start": 59.49, "end": 60.97, "text": "宝宝爱爸爸"}, {"start": 66.77, "end": 67.37, "text": "宝宝"}, {"start": 67.88, "end": 69.76, "text": "叔叔陪你去里面做游戏好不好"}, {"start": 69.96, "end": 71.36, "text": "宝宝 棒玩"}, {"start": 71.36, "end": 72.88, "text": "做游戏玩"}, {"start": 75.18, "end": 76.26, "text": "你一边待着去"}, {"start": 76.26, "end": 77.26, "text": "我陪宝宝玩"}, {"start": 80.36, "end": 81.72, "text": "云宝没把你踹疼吧"}, {"start": 82.74, "end": 83.46, "text": "心疼我"}, {"start": 84.2, "end": 85.08, "text": "皮厚就成"}, {"start": 87.73, "end": 88.33, "text": "老林"}, {"start": 88.85, "end": 89.25, "text": "你说这是"}, {"start": 89.25, "end": 90.65, "text": "老云 千什么都别说"}, {"start": 90.89, "end": 91.45, "text": "爸"}, {"start": 91.45, "end": 92.05, "text": "让开"}, {"start": 92.72, "end": 94.16, "text": "妖儿 你先别说话"}, {"start": 94.16, "end": 94.72, "text": "叔叔"}, {"start": 95.28, "end": 98.01, "text": "笨杖东西"}, {"start": 98.33, "end": 100.13, "text": "年纪不大 本事到大"}, {"start": 100.45, "end": 102.13, "text": "敢欺负我临不休的女儿"}, {"start": 102.45, "end": 103.53, "text": "这就打起来了"}, {"start": 104.01, "end": 105.25, "text": "我都还没动手呢"}, {"start": 105.57, "end": 110.4, "text": "多就行了"}, {"start": 110.4, "end": 110.96, "text": "小鬼头"}, {"start": 110.96, "end": 112.0, "text": "你给我安静戳在那儿"}, {"start": 113.49, "end": 114.01, "text": "叔叔"}, {"start": 115.68, "end": 116.56, "text": "都是我的问题"}, {"start": 117.68, "end": 118.96, "text": "是我勾引了精确"}, {"start": 119.48, "end": 120.4, "text": "才生下云宝"}, {"start": 125.71, "end": 126.59, "text": "精确喝多了"}, {"start": 126.59, "end": 127.39, "text": "我是清醒的"}, {"start": 128.43, "end": 129.99, "text": "我情难自尽才有了云宝"}, {"start": 131.99, "end": 132.75, "text": "叔叔 阿姨"}, {"start": 133.15, "end": 134.27, "text": "我是真的喜欢精确"}, {"start": 134.27, "end": 134.67, "text": "我爱你"}, {"start": 134.67, "end": 135.15, "text": "你说什么"}, {"start": 135.15, "end": 136.03, "text": "你说了"}, {"start": 136.03, "end": 136.59, "text": "回来"}, {"start": 136.59, "end": 137.31, "text": "灵精确"}, {"start": 137.31, "end": 138.43, "text": "站到角落面必思过"}, {"start": 138.75, "end": 139.27, "text": "保镖"}, {"start": 139.27, "end": 139.83, "text": "看着他们"}, {"start": 139.83, "end": 140.47, "text": "不许拉扯"}, {"start": 140.47, "end": 141.03, "text": "叫头歇耳"}, {"start": 141.75, "end": 142.91, "text": "也不许给他叫医生"}, {"start": 143.35, "end": 144.39, "text": "生出好儿子"}, {"start": 144.39, "end": 145.67, "text": "当妈的倒成缩头无归"}, {"start": 145.67, "end": 147.11, "text": "常依陪云宝做测试呢"}, {"start": 147.11, "end": 147.67, "text": "那我也去"}, {"start": 148.23, "end": 148.95, "text": "我宝宝在哪儿"}, {"start": 150.67, "end": 151.91, "text": "贵好反省 错在哪儿"}, {"start": 155.17, "end": 156.33, "text": "老弟基因好啊"}, {"start": 156.61, "end": 157.69, "text": "云宝长得像精确"}, {"start": 157.69, "end": 158.65, "text": "小时候一样俊"}]}