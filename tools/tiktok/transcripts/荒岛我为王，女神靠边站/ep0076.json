{"file": "荒岛我为王，女神靠边站-第76集.mp4", "ep": 76, "duration": 98.3, "segments": [{"start": 0.0, "end": 1.32, "text": "对账了 有双"}, {"start": 1.8, "end": 3.24, "text": "两条熏鱼 一包盐"}, {"start": 3.24, "end": 3.76, "text": "林诺"}, {"start": 4.08, "end": 4.84, "text": "三块肉干"}, {"start": 5.08, "end": 7.02, "text": "凭什么他两条鱼"}, {"start": 7.02, "end": 8.06, "text": "我就三块肉干"}, {"start": 8.06, "end": 9.26, "text": "那鱼比肉干大多了"}, {"start": 9.54, "end": 10.66, "text": "他一天马的柴"}, {"start": 10.66, "end": 11.86, "text": "你两天都搬不完"}, {"start": 11.86, "end": 13.54, "text": "我只认活 不认嘴"}, {"start": 13.9, "end": 14.82, "text": "下周我还来"}, {"start": 16.04, "end": 17.05, "text": "我也来"}, {"start": 17.05, "end": 18.33, "text": "下周我干双倍的活"}, {"start": 19.61, "end": 20.89, "text": "干活不是喊口号"}, {"start": 21.13, "end": 22.49, "text": "等你手上见真章吧"}, {"start": 22.73, "end": 31.27, "text": "真有盐啊"}, {"start": 32.26, "end": 33.66, "text": "林诺 你的呢"}, {"start": 33.66, "end": 34.54, "text": "我自己证的"}, {"start": 34.54, "end": 35.42, "text": "你们可别惦记"}, {"start": 35.42, "end": 37.26, "text": "两条鱼 几块肉干"}, {"start": 37.26, "end": 38.5, "text": "就把人都收买了"}, {"start": 39.55, "end": 40.95, "text": "一群软骨头"}, {"start": 41.43, "end": 42.51, "text": "你骨头硬"}, {"start": 42.51, "end": 43.71, "text": "能吃饱肚子吗"}, {"start": 46.16, "end": 47.04, "text": "老规矩"}, {"start": 47.04, "end": 48.0, "text": "一半入工账"}, {"start": 48.0, "end": 49.0, "text": "一半归自己"}, {"start": 49.0, "end": 50.12, "text": "又搁一刀"}, {"start": 50.56, "end": 52.0, "text": "火堆 柴 岗"}, {"start": 52.0, "end": 53.12, "text": "哪样不要人手"}, {"start": 53.12, "end": 54.6, "text": "嫌少 你自己担过"}, {"start": 54.6, "end": 55.32, "text": "行 行 行"}, {"start": 55.32, "end": 56.2, "text": "你说了算"}, {"start": 64.66, "end": 65.7, "text": "都围这儿干吗"}, {"start": 66.37, "end": 67.17, "text": "站岗呢"}, {"start": 68.18, "end": 69.02, "text": "我们"}, {"start": 69.02, "end": 70.54, "text": "就是过来看看"}, {"start": 71.37, "end": 73.29, "text": "看 能看饱肚子"}, {"start": 73.29, "end": 74.57, "text": "今天心情好"}, {"start": 74.57, "end": 75.41, "text": "请你们吃"}, {"start": 75.81, "end": 76.89, "text": "谁抢都算谁的"}, {"start": 76.89, "end": 77.45, "text": "接好了"}, {"start": 77.45, "end": 84.26, "text": "赶我"}, {"start": 84.26, "end": 85.14, "text": "小唐"}, {"start": 85.14, "end": 86.42, "text": "你抢东西不行"}, {"start": 86.42, "end": 87.5, "text": "吃东西"}, {"start": 87.5, "end": 88.62, "text": "倒是第一名"}, {"start": 88.94, "end": 89.78, "text": "你想骂"}, {"start": 89.78, "end": 91.22, "text": "回营地关起门骂"}, {"start": 91.22, "end": 92.62, "text": "别在这儿丢人"}, {"start": 94.14, "end": 95.18, "text": "随便你们抢"}, {"start": 95.18, "end": 95.98, "text": "我等船"}]}