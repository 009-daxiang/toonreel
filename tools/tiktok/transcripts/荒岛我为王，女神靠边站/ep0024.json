{"file": "荒岛我为王，女神靠边站-第24集.mp4", "ep": 24, "duration": 66.7, "segments": [{"start": 12.37, "end": 13.25, "text": "林大哥后"}, {"start": 13.85, "end": 15.37, "text": "大半夜不在营地里休息"}, {"start": 15.53, "end": 16.57, "text": "跑我这儿来干什么"}, {"start": 17.93, "end": 19.01, "text": "我是来投靠你的"}, {"start": 19.41, "end": 20.05, "text": "投靠"}, {"start": 21.9, "end": 22.7, "text": "你能给我什么"}, {"start": 23.4, "end": 24.28, "text": "营地里的事"}, {"start": 24.28, "end": 25.52, "text": "我比赵雅看得透彻"}, {"start": 25.96, "end": 27.08, "text": "有什么风吹草动"}, {"start": 27.08, "end": 28.36, "text": "或者谁动了别的心思"}, {"start": 28.36, "end": 29.28, "text": "我都能告诉你"}, {"start": 29.83, "end": 30.39, "text": "还有呢"}, {"start": 30.83, "end": 32.15, "text": "我还能帮你招募人手"}, {"start": 32.63, "end": 34.11, "text": "陈瑶我已经在拉拢了"}, {"start": 34.51, "end": 35.67, "text": "他是苏薇薇的闺蜜"}, {"start": 35.99, "end": 36.95, "text": "只要能拿下他"}, {"start": 37.15, "end": 38.03, "text": "其他人投诚"}, {"start": 38.03, "end": 39.03, "text": "只是时间问题"}, {"start": 39.94, "end": 40.58, "text": "他动摇了"}, {"start": 40.74, "end": 41.38, "text": "动摇了"}, {"start": 42.11, "end": 44.03, "text": "现在缺的只是一个台阶"}, {"start": 44.51, "end": 46.03, "text": "或者说 契机"}, {"start": 47.5, "end": 48.26, "text": "所以今天"}, {"start": 48.66, "end": 50.06, "text": "你是带着陈瑶来做交易的"}, {"start": 50.42, "end": 50.94, "text": "是"}, {"start": 54.28, "end": 54.92, "text": "自己来拿"}, {"start": 55.24, "end": 57.73, "text": "就不能递过来"}, {"start": 58.25, "end": 59.41, "text": "递过来了不值钱"}, {"start": 59.77, "end": 61.49, "text": "自己拿的才叫陈瑶"}]}