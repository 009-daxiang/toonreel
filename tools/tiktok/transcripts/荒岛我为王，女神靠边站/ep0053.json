{"file": "荒岛我为王，女神靠边站-第53集.mp4", "ep": 53, "duration": 77.7, "segments": [{"start": 3.19, "end": 9.01, "text": "香老师也没法子"}, {"start": 9.33, "end": 10.37, "text": "他只有热水"}, {"start": 10.85, "end": 11.61, "text": "没有药物"}, {"start": 16.94, "end": 17.54, "text": "难道"}, {"start": 18.1, "end": 19.18, "text": "真的要去求他"}, {"start": 20.21, "end": 20.93, "text": "薇薇姐"}, {"start": 21.25, "end": 22.85, "text": "要不让他来看看"}, {"start": 23.21, "end": 24.13, "text": "人都这样了"}, {"start": 24.49, "end": 25.05, "text": "面子"}, {"start": 26.38, "end": 27.58, "text": "面子值几个钱啊"}, {"start": 30.89, "end": 31.77, "text": "不用绕丸子"}, {"start": 32.21, "end": 33.65, "text": "发烧的人挺不过第二碗"}, {"start": 33.65, "end": 34.57, "text": "他那里有火"}, {"start": 34.57, "end": 35.41, "text": "有干净的水"}, {"start": 35.41, "end": 36.09, "text": "有吃的"}, {"start": 36.41, "end": 37.09, "text": "这里没有"}, {"start": 37.61, "end": 38.53, "text": "沉腰等不起"}, {"start": 39.17, "end": 39.85, "text": "你自己订"}, {"start": 40.25, "end": 45.57, "text": "好香"}, {"start": 49.89, "end": 50.89, "text": "有一年拍戏"}, {"start": 51.53, "end": 53.09, "text": "剧组困在山里七天"}, {"start": 54.5, "end": 55.66, "text": "族里有人高烧"}, {"start": 56.71, "end": 58.43, "text": "这篇主任当着全组的面"}, {"start": 59.03, "end": 60.35, "text": "跪着球来了救援"}, {"start": 61.05, "end": 62.33, "text": "人抬下山那天"}, {"start": 62.69, "end": 63.93, "text": "没有一个人笑话他"}, {"start": 65.94, "end": 67.78, "text": "求人不丢人"}, {"start": 68.82, "end": 69.42, "text": "再等等"}, {"start": 70.14, "end": 72.1, "text": "兴许沉腰自己能熬过去"}]}