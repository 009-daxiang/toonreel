{"file": "荒岛我为王，女神靠边站-第65集.mp4", "ep": 65, "duration": 77.9, "segments": [{"start": 0.0, "end": 1.4, "text": "算了吧 陈大小姐"}, {"start": 1.6, "end": 2.92, "text": "一病刚好就干活"}, {"start": 3.2, "end": 3.92, "text": "传出去"}, {"start": 4.08, "end": 5.32, "text": "他们会说我没人性的"}, {"start": 6.58, "end": 7.22, "text": "林峰"}, {"start": 8.22, "end": 10.06, "text": "赶紧出去的事我也有份"}, {"start": 10.58, "end": 12.22, "text": "欠你的我都记着"}, {"start": 13.03, "end": 14.31, "text": "就当我为自己赎罪"}, {"start": 16.74, "end": 17.82, "text": "最近可能有语人"}, {"start": 18.46, "end": 19.7, "text": "帮我把柴火搬进山洞"}, {"start": 19.7, "end": 20.54, "text": "防止收场"}, {"start": 36.73, "end": 37.41, "text": "搬好了"}, {"start": 39.46, "end": 39.98, "text": "行"}, {"start": 40.38, "end": 42.23, "text": "总算出来个烈的情感"}, {"start": 42.43, "end": 50.21, "text": "病刚好他就让你干活"}, {"start": 50.41, "end": 51.57, "text": "真是太没人性了"}, {"start": 51.69, "end": 52.69, "text": "林峰没有逼我"}, {"start": 52.85, "end": 53.89, "text": "是我自己要求的"}, {"start": 54.39, "end": 54.79, "text": "这"}, {"start": 54.99, "end": 56.23, "text": "是我自己就由自去"}, {"start": 57.94, "end": 58.78, "text": "从今天起"}, {"start": 59.02, "end": 60.14, "text": "工作表重新定"}, {"start": 60.62, "end": 63.58, "text": "柴果 取水 检查 延长"}, {"start": 64.06, "end": 64.82, "text": "一人一岗"}, {"start": 65.06, "end": 66.06, "text": "各计各的公分"}, {"start": 66.34, "end": 67.18, "text": "一切资源"}, {"start": 67.42, "end": 68.42, "text": "停公分换取"}, {"start": 68.9, "end": 70.66, "text": "谁要是寻思或者偏谈"}, {"start": 71.5, "end": 72.7, "text": "其他人可以投票"}, {"start": 73.3, "end": 74.5, "text": "将其逐出营地"}]}