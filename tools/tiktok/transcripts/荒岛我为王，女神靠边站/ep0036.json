{"file": "荒岛我为王，女神靠边站-第36集.mp4", "ep": 36, "duration": 67.9, "segments": [{"start": 0.78, "end": 2.3, "text": "怎么 不欢迎"}, {"start": 3.24, "end": 3.84, "text": "欢迎"}, {"start": 4.28, "end": 5.16, "text": "不过先说好"}, {"start": 5.36, "end": 6.36, "text": "今天的活不轻"}, {"start": 6.84, "end": 7.48, "text": "你说"}, {"start": 7.8, "end": 9.92, "text": "这一框鱼 瓜林 去内藏"}, {"start": 10.04, "end": 11.2, "text": "洗干净 穿穿"}, {"start": 11.4, "end": 12.88, "text": "天黑天弄完 能行吗"}, {"start": 13.84, "end": 23.3, "text": "累不累"}, {"start": 24.84, "end": 26.28, "text": "岛上还有不累的活吗"}, {"start": 26.84, "end": 30.66, "text": "你倒是跟我想的不一样"}, {"start": 31.1, "end": 32.06, "text": "你以为我会哭"}, {"start": 34.94, "end": 35.98, "text": "我以为你会先跟我谈"}, {"start": 35.98, "end": 36.9, "text": "额外的条件"}, {"start": 38.72, "end": 39.76, "text": "条件只有一个"}, {"start": 39.96, "end": 40.96, "text": "晚上我要吃鱼"}, {"start": 42.21, "end": 44.05, "text": "只要活做完 旅馆告"}, {"start": 44.65, "end": 48.33, "text": "慢点 没人给你抢"}, {"start": 48.77, "end": 51.34, "text": "我不怕这个"}, {"start": 52.14, "end": 53.22, "text": "我怕今天过去"}, {"start": 53.22, "end": 54.14, "text": "明天天亮了"}, {"start": 54.14, "end": 55.18, "text": "一切又是假的"}, {"start": 56.24, "end": 57.12, "text": "你听过一句话吗"}, {"start": 57.12, "end": 57.8, "text": "什么话"}, {"start": 58.16, "end": 59.36, "text": "天人也有两般意义"}, {"start": 59.36, "end": 60.64, "text": "道不虚行只在人"}, {"start": 60.84, "end": 61.8, "text": "只要付出劳动"}, {"start": 61.8, "end": 62.92, "text": "证明自己的价值"}, {"start": 63.12, "end": 63.8, "text": "在我这里"}, {"start": 64.0, "end": 65.32, "text": "就能得到公平的回报"}]}