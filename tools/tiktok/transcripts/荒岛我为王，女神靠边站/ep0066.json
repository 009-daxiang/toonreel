{"file": "荒岛我为王，女神靠边站-第66集.mp4", "ep": 66, "duration": 72.8, "segments": [{"start": 0.27, "end": 0.87, "text": "柳霜"}, {"start": 1.27, "end": 2.27, "text": "北坡那片林子"}, {"start": 2.27, "end": 3.27, "text": "你带个人去"}, {"start": 3.27, "end": 3.67, "text": "行"}, {"start": 4.27, "end": 5.27, "text": "方小曼跟我去"}, {"start": 6.27, "end": 8.43, "text": "能不能换个轻点的"}, {"start": 8.43, "end": 12.19, "text": "腿脚勤快点不吃亏"}, {"start": 12.19, "end": 13.19, "text": "跟紧我 少废话"}, {"start": 14.8, "end": 15.8, "text": "赵雅带小唐采果子"}, {"start": 16.8, "end": 17.8, "text": "外围采就行"}, {"start": 17.8, "end": 18.8, "text": "别往生灵里走"}, {"start": 18.8, "end": 19.8, "text": "好"}, {"start": 19.8, "end": 20.8, "text": "我跟我姐一组"}, {"start": 23.46, "end": 24.46, "text": "你手还没好利索"}, {"start": 24.46, "end": 25.46, "text": "冲火我来"}, {"start": 25.46, "end": 26.46, "text": "你跟着搭把手就行"}, {"start": 27.46, "end": 28.75, "text": "施燕"}, {"start": 28.75, "end": 29.75, "text": "你带温若琴开勋假"}, {"start": 29.75, "end": 30.75, "text": "翻肉收肉"}, {"start": 30.75, "end": 31.78, "text": "明白"}, {"start": 31.78, "end": 32.78, "text": "林诺 你脑子活跃"}, {"start": 32.78, "end": 33.78, "text": "你负责仓库"}, {"start": 33.78, "end": 34.78, "text": "轻点库存"}, {"start": 34.78, "end": 35.78, "text": "出货入货"}, {"start": 35.78, "end": 36.78, "text": "这些是你负责"}, {"start": 36.78, "end": 37.78, "text": "少了丢了 为你示威"}, {"start": 37.78, "end": 38.78, "text": "行"}, {"start": 38.78, "end": 39.78, "text": "这个我算得清"}, {"start": 40.82, "end": 41.82, "text": "给我也分点柴吧"}, {"start": 41.82, "end": 42.82, "text": "闲着骨头疼"}, {"start": 45.42, "end": 46.42, "text": "薇薇"}, {"start": 46.42, "end": 47.42, "text": "你搬石头"}, {"start": 47.42, "end": 48.42, "text": "东面延长"}, {"start": 48.42, "end": 49.42, "text": "江老师等着用人"}, {"start": 50.42, "end": 51.42, "text": "搬石头"}, {"start": 51.42, "end": 52.64, "text": "你让我去搬石头"}, {"start": 53.64, "end": 54.64, "text": "这活最累"}, {"start": 54.64, "end": 55.64, "text": "可公分也最多"}, {"start": 55.64, "end": 56.64, "text": "你不想搬"}, {"start": 56.64, "end": 57.64, "text": "可以跟小唐换"}, {"start": 58.64, "end": 62.33, "text": "他的活"}, {"start": 62.33, "end": 63.33, "text": "你干不了"}, {"start": 63.33, "end": 67.62, "text": "搬就搬"}]}