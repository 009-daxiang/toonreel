{"file": "荒岛我为王，女神靠边站-第69集.mp4", "ep": 69, "duration": 66.9, "segments": [{"start": 4.98, "end": 5.82, "text": "明天谁来"}, {"start": 6.38, "end": 6.98, "text": "林诺"}, {"start": 7.58, "end": 9.38, "text": "他当着全英帝抢的头一份"}, {"start": 9.98, "end": 10.98, "text": "抢来的活"}, {"start": 11.42, "end": 12.5, "text": "更得给我干好了"}, {"start": 13.82, "end": 15.02, "text": "陈瑶今天找的我"}, {"start": 15.54, "end": 16.78, "text": "往后一天来一个人"}, {"start": 16.78, "end": 18.1, "text": "都按你的规矩结账"}, {"start": 18.1, "end": 19.9, "text": "他盈里快没凉了"}, {"start": 20.18, "end": 21.26, "text": "撑不过半个月"}, {"start": 22.46, "end": 23.74, "text": "但他也没开口球"}, {"start": 23.86, "end": 24.38, "text": "行"}, {"start": 25.24, "end": 27.2, "text": "硬气的人按硬气的驾算"}, {"start": 27.48, "end": 28.16, "text": "什么驾"}, {"start": 29.06, "end": 29.9, "text": "活部队数"}, {"start": 30.42, "end": 31.26, "text": "空手走人"}, {"start": 33.86, "end": 34.9, "text": "明天那个"}, {"start": 35.06, "end": 36.26, "text": "要是赖着不走呢"}, {"start": 36.7, "end": 37.42, "text": "拎出去"}, {"start": 38.38, "end": 39.46, "text": "这种事不用问我"}, {"start": 41.68, "end": 42.4, "text": "那我呢"}, {"start": 43.36, "end": 44.12, "text": "我的账"}, {"start": 44.48, "end": 45.48, "text": "也是一天一节"}, {"start": 46.14, "end": 47.18, "text": "你走的是夜路"}, {"start": 47.86, "end": 48.82, "text": "算夜里的账"}, {"start": 54.5, "end": 55.66, "text": "明天你可别心软"}, {"start": 57.38, "end": 58.54, "text": "我什么时候心软过"}]}