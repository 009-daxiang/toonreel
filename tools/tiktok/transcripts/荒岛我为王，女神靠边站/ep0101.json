{"file": "荒岛我为王，女神靠边站-第101集.mp4", "ep": 101, "duration": 89.0, "segments": [{"start": 0.0, "end": 0.56, "text": "行"}, {"start": 1.0, "end": 1.84, "text": "晋山的"}, {"start": 1.96, "end": 3.04, "text": "每人計三份"}, {"start": 3.36, "end": 5.36, "text": "首頁首家的計一份"}, {"start": 5.64, "end": 10.62, "text": "三四百斤"}, {"start": 11.29, "end": 12.77, "text": "這夠吃一兩個月了吧"}, {"start": 13.48, "end": 14.52, "text": "先別急著吃"}, {"start": 15.0, "end": 16.48, "text": "先算算鹽夠不夠鹽吧"}, {"start": 16.8, "end": 18.24, "text": "我今天差點讓豬頂了"}, {"start": 18.36, "end": 19.16, "text": "該計幾份"}, {"start": 19.32, "end": 20.4, "text": "計你一生尖叫"}, {"start": 21.24, "end": 21.76, "text": "這"}, {"start": 29.21, "end": 30.61, "text": "明天全倒吃肉"}, {"start": 31.78, "end": 32.9, "text": "鹽夠的帶鹽"}, {"start": 32.9, "end": 34.5, "text": "不夠的帶嘴來就行"}, {"start": 42.86, "end": 43.7, "text": "血止住了"}, {"start": 43.9, "end": 44.98, "text": "明天還得換藥"}, {"start": 49.73, "end": 50.49, "text": "有事嗎"}, {"start": 58.1, "end": 58.7, "text": "這鹽"}, {"start": 58.82, "end": 60.18, "text": "煮水放溫了洗傷口"}, {"start": 60.54, "end": 61.46, "text": "殺菌消鹽"}, {"start": 61.94, "end": 63.3, "text": "你用公分換的鹽"}, {"start": 66.22, "end": 67.06, "text": "計它賬上"}, {"start": 68.02, "end": 68.78, "text": "不用計"}, {"start": 69.75, "end": 70.67, "text": "你也救過我"}, {"start": 77.54, "end": 78.5, "text": "它轉性了"}, {"start": 81.3, "end": 82.1, "text": "大概是它開始"}, {"start": 82.1, "end": 83.26, "text": "自己跟自己算賬"}]}