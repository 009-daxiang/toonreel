{"file": "末日疯子：尸潮之下-第112集.mp4", "ep": 112, "duration": 61.1, "segments": [{"start": 0.0, "end": 2.0, "text": "没有 我 我一直一个人"}, {"start": 2.0, "end": 4.0, "text": "死了 他死了"}, {"start": 4.0, "end": 6.0, "text": "我女朋友死了 他死了"}, {"start": 6.0, "end": 8.0, "text": "我一直藏在树上"}, {"start": 8.0, "end": 10.0, "text": "你一直跟着我们 跟了多久"}, {"start": 10.0, "end": 12.0, "text": "两天 我没有恶意"}, {"start": 12.0, "end": 14.0, "text": "我看到你们好像知道怎么走"}, {"start": 14.0, "end": 16.74, "text": "就偷偷跟了起来"}, {"start": 16.74, "end": 17.74, "text": "你想加入我们"}, {"start": 17.74, "end": 18.74, "text": "可以吗"}, {"start": 18.74, "end": 20.74, "text": "别掉队 别发出不必要的声音"}, {"start": 20.74, "end": 21.74, "text": "否则死"}, {"start": 21.74, "end": 24.73, "text": "这人能跟着我们这么久"}, {"start": 24.73, "end": 26.73, "text": "想来也是有些实力的"}, {"start": 26.73, "end": 28.76, "text": "我们现在人太少"}, {"start": 28.76, "end": 36.49, "text": "多一个人也是多一分力"}, {"start": 36.49, "end": 39.35, "text": "小玲 拿瓶子来"}, {"start": 39.35, "end": 46.82, "text": "一瓶留着"}, {"start": 46.82, "end": 50.79, "text": "走吧"}, {"start": 50.79, "end": 53.56, "text": "服务区还没到吗"}, {"start": 53.56, "end": 55.56, "text": "那个 是服务区吗"}, {"start": 55.56, "end": 60.89, "text": "先靠近看看吧"}]}