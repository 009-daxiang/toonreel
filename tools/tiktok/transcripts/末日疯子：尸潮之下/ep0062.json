{"file": "末日疯子：尸潮之下-第62集.mp4", "ep": 62, "duration": 63.6, "segments": [{"start": 3.41, "end": 4.41, "text": "再不开门"}, {"start": 4.41, "end": 6.01, "text": "老子就把这玩意儿点了"}, {"start": 6.01, "end": 7.41, "text": "大家一起玩玩"}, {"start": 7.41, "end": 10.21, "text": "反正老子也受够了这鸟日子了"}, {"start": 11.81, "end": 16.78, "text": "杀了他吗"}, {"start": 16.78, "end": 18.77, "text": "朕还没点火"}, {"start": 18.77, "end": 22.12, "text": "你敢杀吗"}, {"start": 22.12, "end": 26.85, "text": "你们都在这里保持警戒"}, {"start": 26.85, "end": 28.05, "text": "盯住其他人"}, {"start": 28.05, "end": 28.65, "text": "我下去"}, {"start": 28.65, "end": 29.45, "text": "什么"}, {"start": 29.45, "end": 31.28, "text": "他们人多"}, {"start": 31.28, "end": 32.48, "text": "还有汽油"}, {"start": 32.48, "end": 36.02, "text": "按我说的做"}, {"start": 36.02, "end": 37.22, "text": "如果外面失控"}, {"start": 37.22, "end": 38.62, "text": "或者我发出信号"}, {"start": 38.62, "end": 39.42, "text": "季妃凡"}, {"start": 39.42, "end": 41.62, "text": "你和李维安负责远程压制"}, {"start": 41.62, "end": 43.42, "text": "其他人守住门窗"}, {"start": 43.42, "end": 44.82, "text": "准备应对冲击"}, {"start": 45.94, "end": 52.58, "text": "就派个娘们出来"}, {"start": 52.58, "end": 53.58, "text": "小牛"}, {"start": 53.58, "end": 54.78, "text": "你们那人都死绝了"}, {"start": 54.78, "end": 56.78, "text": "让你出来顶雕"}, {"start": 56.78, "end": 58.38, "text": "还真敢出来"}, {"start": 58.38, "end": 59.98, "text": "算你有点胆"}, {"start": 59.98, "end": 60.78, "text": "怎么"}, {"start": 60.78, "end": 61.78, "text": "把门打开"}, {"start": 61.78, "end": 63.78, "text": "让哥几个进去上来上来啊"}]}