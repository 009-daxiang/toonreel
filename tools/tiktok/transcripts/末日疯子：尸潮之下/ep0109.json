{"file": "末日疯子：尸潮之下-第109集.mp4", "ep": 109, "duration": 46.1, "segments": [{"start": 1.39, "end": 2.11, "text": "孩子给我"}, {"start": 2.51, "end": 3.43, "text": "只是抱一会儿"}, {"start": 3.51, "end": 4.51, "text": "我没那么不中用"}, {"start": 4.95, "end": 6.16, "text": "谢了"}, {"start": 6.56, "end": 12.3, "text": "你干什么"}, {"start": 12.3, "end": 14.14, "text": "没事 这里有个洞"}, {"start": 14.26, "end": 15.66, "text": "我们至少走了三公里了"}, {"start": 15.74, "end": 16.58, "text": "必须歇一会儿了"}, {"start": 16.66, "end": 17.42, "text": "不然撑不住"}, {"start": 17.9, "end": 18.7, "text": "怎么样 清水"}, {"start": 19.3, "end": 19.74, "text": "可以"}, {"start": 20.38, "end": 21.98, "text": "先找一些干燥异彩端的树枝"}, {"start": 22.06, "end": 22.7, "text": "放在周围"}, {"start": 22.78, "end": 23.54, "text": "如果有动静"}, {"start": 23.62, "end": 25.1, "text": "也可以给我们一个反应的时间"}, {"start": 25.5, "end": 26.1, "text": "这种行吗"}, {"start": 26.34, "end": 26.7, "text": "行"}, {"start": 26.9, "end": 27.9, "text": "干扣的落叶也可以"}, {"start": 27.98, "end": 28.54, "text": "越多越好"}, {"start": 28.62, "end": 29.22, "text": "不开一些"}, {"start": 29.7, "end": 30.7, "text": "余慧 你跟我来"}, {"start": 33.52, "end": 35.28, "text": "这里我准备做一个预警"}, {"start": 35.84, "end": 37.2, "text": "我们用任性好的藤蔓"}, {"start": 37.28, "end": 37.96, "text": "在离地面"}, {"start": 38.04, "end": 39.28, "text": "大约小腿高度的位置"}, {"start": 40.24, "end": 41.4, "text": "拉几条隐蔽的线"}, {"start": 42.18, "end": 42.86, "text": "不用太紧"}, {"start": 43.18, "end": 44.06, "text": "要能轻易碰断"}, {"start": 45.33, "end": 45.89, "text": "我明白了"}]}