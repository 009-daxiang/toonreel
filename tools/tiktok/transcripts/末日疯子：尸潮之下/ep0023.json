{"file": "末日疯子：尸潮之下-第23集.mp4", "ep": 23, "duration": 66.1, "segments": [{"start": 0.11, "end": 3.11, "text": "别看下面 抓绳子 切紧墙"}, {"start": 3.11, "end": 5.34, "text": "冷静 慢慢挪"}, {"start": 6.37, "end": 19.82, "text": "再乱动 我们都得死"}, {"start": 19.82, "end": 20.82, "text": "外面全是疯子"}, {"start": 20.82, "end": 21.82, "text": "我们得另想办法"}, {"start": 21.82, "end": 27.25, "text": "先休息会儿吧"}, {"start": 27.25, "end": 29.25, "text": "卫安雪梅 这是你"}, {"start": 29.25, "end": 30.25, "text": "你是有吗"}, {"start": 30.25, "end": 31.25, "text": "她叫清水"}, {"start": 31.25, "end": 34.75, "text": "她毫不犹豫就决定翻窗"}, {"start": 34.75, "end": 36.88, "text": "就好像"}, {"start": 36.88, "end": 40.89, "text": "我就习惯了"}, {"start": 40.89, "end": 41.89, "text": "接下来"}, {"start": 41.89, "end": 43.89, "text": "我们还能往哪儿走"}, {"start": 43.89, "end": 44.89, "text": "外面全是疯子"}, {"start": 45.95, "end": 46.95, "text": "不走"}, {"start": 46.95, "end": 48.95, "text": "让雨慧和小林拿着她的车钥匙"}, {"start": 48.95, "end": 50.95, "text": "去地下车库开车来接应我们"}, {"start": 50.95, "end": 56.82, "text": "我和卫安一找到林浩"}, {"start": 56.82, "end": 58.82, "text": "被困行政楼二楼东侧储藏室"}, {"start": 58.82, "end": 60.82, "text": "林浩的车在地下停车场"}, {"start": 60.82, "end": 61.82, "text": "黑色SUV"}, {"start": 61.82, "end": 62.82, "text": "需要你们去接应我们"}, {"start": 62.82, "end": 64.82, "text": "要是我会从高处扔向你们"}, {"start": 64.82, "end": 65.82, "text": "位置"}]}