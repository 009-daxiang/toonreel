{"file": "末日疯子：尸潮之下-第9集.mp4", "ep": 9, "duration": 50.1, "segments": [{"start": 0.02, "end": 1.38, "text": "你可以选择留下"}, {"start": 1.96, "end": 3.16, "text": "这些堵门的家具"}, {"start": 3.48, "end": 4.56, "text": "我们搬开一些"}, {"start": 4.72, "end": 5.8, "text": "你躲到里面去"}, {"start": 6.16, "end": 7.36, "text": "或许能多藏一阵"}, {"start": 7.96, "end": 9.52, "text": "小林 清水说得对"}, {"start": 9.88, "end": 11.76, "text": "留在这里没有明天的"}, {"start": 12.16, "end": 13.88, "text": "我们一起走 好不好"}, {"start": 14.28, "end": 15.2, "text": "互相照应"}, {"start": 15.6, "end": 17.68, "text": "总比一个人在这里等着好"}, {"start": 18.0, "end": 19.68, "text": "怕得要死 我也怕"}, {"start": 20.12, "end": 21.82, "text": "但我想试试"}, {"start": 22.38, "end": 23.81, "text": "试试看能不能活到"}, {"start": 23.81, "end": 24.97, "text": "找到我爸妈那天"}, {"start": 25.61, "end": 29.32, "text": "我跟你们走"}, {"start": 29.92, "end": 30.6, "text": "晚上行动"}, {"start": 30.92, "end": 32.08, "text": "现在我们先搜查"}, {"start": 32.08, "end": 32.96, "text": "附近的请示"}, {"start": 35.27, "end": 36.23, "text": "请示长和我一起"}, {"start": 36.47, "end": 37.51, "text": "宇惠和小林留在这里"}, {"start": 37.51, "end": 38.19, "text": "观察情况"}, {"start": 38.35, "end": 39.19, "text": "一旦有什么不对"}, {"start": 39.39, "end": 40.27, "text": "立刻手机联系"}, {"start": 41.21, "end": 41.73, "text": "知道了"}, {"start": 42.17, "end": 43.97, "text": "武器 食物 手机"}, {"start": 44.21, "end": 45.25, "text": "优先寻找这几样"}, {"start": 45.49, "end": 46.13, "text": "不要紧张"}, {"start": 46.41, "end": 47.37, "text": "不要发出大动静"}, {"start": 47.85, "end": 48.65, "text": "握紧把手"}, {"start": 48.97, "end": 49.81, "text": "对准掩握"}]}