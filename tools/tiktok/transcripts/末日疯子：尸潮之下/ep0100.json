{"file": "末日疯子：尸潮之下-第100集.mp4", "ep": 100, "duration": 54.2, "segments": [{"start": 2.32, "end": 3.04, "text": "进去吗"}, {"start": 4.3, "end": 4.74, "text": "进"}, {"start": 5.26, "end": 6.06, "text": "可能有出口"}, {"start": 6.38, "end": 19.66, "text": "运货得福"}, {"start": 20.18, "end": 22.25, "text": "四清水"}, {"start": 22.53, "end": 24.09, "text": "小林他们还在山林里"}, {"start": 24.45, "end": 25.81, "text": "是迷失了方向"}, {"start": 26.29, "end": 26.93, "text": "还是"}, {"start": 27.37, "end": 29.19, "text": "他们肯定还在山林"}, {"start": 29.55, "end": 30.07, "text": "我们得"}, {"start": 30.35, "end": 31.31, "text": "得想办法告诉他们"}, {"start": 31.31, "end": 31.95, "text": "出口在这里"}, {"start": 31.95, "end": 32.71, "text": "告诉他们"}, {"start": 32.99, "end": 34.43, "text": "隔着一片山怎么告诉我"}, {"start": 34.63, "end": 35.07, "text": "喊吗"}, {"start": 35.07, "end": 36.27, "text": "还是写个牌子挂树上"}, {"start": 36.43, "end": 36.83, "text": "烟"}, {"start": 36.95, "end": 37.95, "text": "烧东西用烟"}, {"start": 38.15, "end": 39.31, "text": "如果他们在附近的山上"}, {"start": 39.43, "end": 40.75, "text": "也许能看到烟雾的方向"}, {"start": 40.99, "end": 41.63, "text": "点火"}, {"start": 42.21, "end": 43.21, "text": "我引来疯子吧"}, {"start": 43.41, "end": 44.41, "text": "确定不是找死"}, {"start": 44.81, "end": 46.96, "text": "说别管他们了"}, {"start": 47.08, "end": 48.0, "text": "他绝不会同意"}, {"start": 48.46, "end": 49.78, "text": "可能就此分道阳标"}, {"start": 50.1, "end": 51.1, "text": "我浑身使伤"}, {"start": 51.42, "end": 52.7, "text": "一个人在这公路上"}, {"start": 52.9, "end": 54.02, "text": "存活纪律太低"}]}