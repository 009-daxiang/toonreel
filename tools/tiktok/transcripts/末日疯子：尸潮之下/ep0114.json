{"file": "末日疯子：尸潮之下-第114集.mp4", "ep": 114, "duration": 45.1, "segments": [{"start": 0.0, "end": 0.88, "text": "兩輩子了"}, {"start": 1.28, "end": 2.48, "text": "我吃過腐爛的肉"}, {"start": 2.48, "end": 3.68, "text": "喝過汪濁的水"}, {"start": 4.04, "end": 5.04, "text": "啃過樹皮"}, {"start": 5.28, "end": 6.16, "text": "攪過草根"}, {"start": 8.03, "end": 8.79, "text": "這燙"}, {"start": 9.07, "end": 9.55, "text": "我"}, {"start": 16.24, "end": 17.08, "text": "對不起我"}, {"start": 17.24, "end": 18.4, "text": "我對不起你"}, {"start": 20.02, "end": 20.82, "text": "上輩子"}, {"start": 21.02, "end": 22.9, "text": "第一個隊友死的時候我也這麼苦"}, {"start": 23.71, "end": 24.55, "text": "後來第四個"}, {"start": 24.55, "end": 25.15, "text": "第五個"}, {"start": 25.91, "end": 26.83, "text": "我再也沒哭過"}, {"start": 27.79, "end": 28.51, "text": "隊長說"}, {"start": 29.11, "end": 30.19, "text": "連累時奢侈品"}, {"start": 30.19, "end": 30.91, "text": "是弱點"}, {"start": 31.03, "end": 32.19, "text": "是無用的分泌物"}, {"start": 37.9, "end": 38.9, "text": "我們可以做燃燒瓶"}, {"start": 39.22, "end": 39.98, "text": "最好灌汽油"}, {"start": 40.26, "end": 41.78, "text": "還需要綿線和布條做隱形"}, {"start": 42.06, "end": 42.62, "text": "汽油"}, {"start": 42.86, "end": 43.74, "text": "雞肥飯包裡還有"}, {"start": 43.74, "end": 44.62, "text": "雞肥飯"}]}