{"file": "末日疯子：尸潮之下-第22集.mp4", "ep": 22, "duration": 66.1, "segments": [{"start": 0.0, "end": 2.4, "text": "可如果那边窗户打不开"}, {"start": 2.4, "end": 3.24, "text": "或者里面"}, {"start": 3.68, "end": 4.2, "text": "毒"}, {"start": 4.6, "end": 6.08, "text": "过来帮忙 扶稳箱子"}, {"start": 6.24, "end": 6.72, "text": "李浩"}, {"start": 6.92, "end": 8.64, "text": "把那些皮带和绳子连接起来"}, {"start": 9.04, "end": 10.08, "text": "检查是否结实"}, {"start": 16.43, "end": 17.15, "text": "我先出去"}, {"start": 17.71, "end": 18.11, "text": "记住"}, {"start": 18.11, "end": 19.23, "text": "你第二笔紧贴墙壁"}, {"start": 19.23, "end": 20.27, "text": "重心成潮内"}, {"start": 20.27, "end": 21.03, "text": "一点点挪"}, {"start": 21.35, "end": 22.07, "text": "不要往下看"}, {"start": 22.55, "end": 23.39, "text": "到了管道那里"}, {"start": 23.39, "end": 24.87, "text": "抓紧 才稳支架"}, {"start": 24.87, "end": 25.95, "text": "翻到隔壁窗台"}, {"start": 26.11, "end": 26.67, "text": "明白吗"}, {"start": 27.27, "end": 29.11, "text": "我过去后会把绳子固定"}, {"start": 29.51, "end": 30.51, "text": "你们抓着绳子挪"}, {"start": 30.95, "end": 31.71, "text": "如果失手"}, {"start": 31.95, "end": 32.79, "text": "至少能拉住"}, {"start": 34.48, "end": 35.04, "text": "绳子"}, {"start": 35.32, "end": 35.92, "text": "可以了"}, {"start": 36.4, "end": 37.52, "text": "李慧安 该你了"}, {"start": 37.84, "end": 38.92, "text": "慢一点 不要慌"}, {"start": 40.54, "end": 40.98, "text": "快点"}, {"start": 45.37, "end": 45.81, "text": "抓紧"}, {"start": 46.17, "end": 47.17, "text": "脚踩那个三脚架"}, {"start": 48.0, "end": 48.48, "text": "踩实"}, {"start": 48.48, "end": 49.24, "text": "然后翻过去"}, {"start": 49.56, "end": 50.28, "text": "到隔壁窗台"}, {"start": 50.28, "end": 50.8, "text": "小心点"}]}