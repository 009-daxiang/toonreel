{"file": "doommadman-ep1.mp4", "ep": 1, "duration": 216.1, "segments": [{"start": 0.0, "end": 1.0, "text": "我叫清水"}, {"start": 1.86, "end": 3.7, "text": "出生在丧失遍野的末世"}, {"start": 3.86, "end": 5.86, "text": "董事企就要学着打丧失"}, {"start": 6.78, "end": 8.18, "text": "我也曾想结束生命"}, {"start": 8.76, "end": 11.32, "text": "可陈阿姨描绘的那个鲜花遍野的世界"}, {"start": 11.64, "end": 12.64, "text": "向一道光"}, {"start": 12.88, "end": 14.4, "text": "给了我撑下去的希望"}, {"start": 16.48, "end": 18.04, "text": "就是为了看到那个世界"}, {"start": 18.32, "end": 19.96, "text": "丧失进化突破基地时"}, {"start": 20.12, "end": 22.08, "text": "我掩护陈阿姨登上撤离的飞机"}, {"start": 22.68, "end": 24.28, "text": "而我却葬身在诗巢"}, {"start": 24.52, "end": 33.46, "text": "血的味道"}, {"start": 33.78, "end": 37.95, "text": "秦师长 我"}, {"start": 38.11, "end": 39.31, "text": "清水 快抄 快抄"}, {"start": 39.31, "end": 40.23, "text": "老师要过来了"}, {"start": 40.51, "end": 49.33, "text": "好吓人啊 隔壁咋了"}, {"start": 49.33, "end": 50.17, "text": "咋就这么恐怖啊"}, {"start": 50.29, "end": 51.25, "text": "可不会发生什么了吧"}, {"start": 51.25, "end": 51.93, "text": "谁去看看"}, {"start": 53.04, "end": 53.96, "text": "清水 你疯了"}, {"start": 54.12, "end": 55.12, "text": "我们还在考试呢"}, {"start": 55.44, "end": 56.6, "text": "我真得教训你一下了"}, {"start": 56.92, "end": 62.27, "text": "小主席 我要吃 我要吃"}, {"start": 63.14, "end": 69.25, "text": "把你们眼睛给我"}, {"start": 70.01, "end": 70.81, "text": "跑啊"}, {"start": 71.01, "end": 78.69, "text": "生病吧"}, {"start": 87.77, "end": 88.81, "text": "同学 别怕"}, {"start": 89.09, "end": 90.29, "text": "你们真可爱"}, {"start": 103.54, "end": 104.14, "text": "这么急"}, {"start": 105.22, "end": 106.58, "text": "有病还撞到人怎么办"}, {"start": 106.82, "end": 107.38, "text": "清水"}, {"start": 107.62, "end": 108.58, "text": "刚刚那些是什么"}, {"start": 108.58, "end": 110.85, "text": "嗓子"}, {"start": 110.85, "end": 112.37, "text": "丧失会像他们一样说话吗"}, {"start": 112.61, "end": 113.85, "text": "给宇会和小林发短信"}, {"start": 113.97, "end": 114.97, "text": "让他们不要乱跑"}, {"start": 115.41, "end": 115.81, "text": "好"}, {"start": 115.81, "end": 116.85, "text": "待在寝室锁号门"}, {"start": 117.13, "end": 140.28, "text": "大赌门干什么"}, {"start": 143.65, "end": 144.97, "text": "他们绝对不是丧失"}, {"start": 145.37, "end": 147.29, "text": "会说话 力量大 跑得快"}, {"start": 147.65, "end": 149.05, "text": "甚至可能还留着智商"}, {"start": 149.81, "end": 150.49, "text": "你们自己看"}, {"start": 150.81, "end": 164.94, "text": "开什么玩笑"}, {"start": 165.26, "end": 166.06, "text": "这是假的吧"}, {"start": 166.26, "end": 173.66, "text": "特别"}, {"start": 173.74, "end": 174.78, "text": "我比任何人都希望"}, {"start": 174.78, "end": 175.62, "text": "这一切是假的"}, {"start": 176.86, "end": 177.54, "text": "是真的"}, {"start": 177.98, "end": 178.94, "text": "这一切都是真的"}, {"start": 179.14, "end": 180.26, "text": "外面全是那种疯子"}, {"start": 180.86, "end": 190.15, "text": "没人和我玩"}, {"start": 190.15, "end": 191.9, "text": "我要发现你们了"}, {"start": 191.9, "end": 192.62, "text": "发现你们了"}, {"start": 192.74, "end": 193.74, "text": "就在这栋楼里哦"}, {"start": 193.74, "end": 194.54, "text": "专门开始啦"}, {"start": 194.66, "end": 195.54, "text": "去哪儿呢"}, {"start": 196.02, "end": 202.82, "text": "有没有人救救我"}, {"start": 203.06, "end": 204.18, "text": "我躲在教学楼的厕所里"}, {"start": 204.18, "end": 205.1, "text": "外面全是那群疯子"}, {"start": 205.1, "end": 205.82, "text": "这东西不是人"}, {"start": 205.82, "end": 206.7, "text": "比丧失还恐怖"}, {"start": 206.82, "end": 208.26, "text": "奉劝大家赶紧锁好寝室门"}, {"start": 208.26, "end": 209.58, "text": "别出门 千万别出声"}, {"start": 210.1, "end": 211.34, "text": "不知道这玩意到底是什么"}, {"start": 211.74, "end": 212.5, "text": "但我试过"}, {"start": 212.7, "end": 213.86, "text": "同脑子能弄死他们"}, {"start": 214.38, "end": 214.7, "text": "等"}]}