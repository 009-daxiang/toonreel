{"file": "末日疯子：尸潮之下-第36集.mp4", "ep": 36, "duration": 69.1, "segments": [{"start": 31.32, "end": 32.24, "text": "真的是你"}, {"start": 32.24, "end": 33.08, "text": "你还活着"}, {"start": 33.08, "end": 33.72, "text": "彪哥"}, {"start": 33.72, "end": 34.6, "text": "是我"}, {"start": 34.6, "end": 35.6, "text": "我是小昊"}, {"start": 35.6, "end": 36.4, "text": "你怎么"}, {"start": 36.4, "end": 37.52, "text": "你怎么在这里"}, {"start": 37.52, "end": 39.4, "text": "还 还攻击我们"}, {"start": 39.4, "end": 45.78, "text": "主要最近身体不太好"}, {"start": 45.78, "end": 47.7, "text": "我带着她和平安来这边度假"}, {"start": 47.7, "end": 48.74, "text": "结果"}, {"start": 48.74, "end": 51.15, "text": "去善下她看风景的时候"}, {"start": 51.15, "end": 52.07, "text": "他们来了"}, {"start": 52.07, "end": 58.83, "text": "芒依变成了怪物"}, {"start": 58.83, "end": 60.54, "text": "那些都是疯子"}, {"start": 60.54, "end": 61.5, "text": "你没有杀人"}, {"start": 61.5, "end": 62.98, "text": "你是为了保护舒遥姐"}, {"start": 62.98, "end": 64.83, "text": "我明白的"}, {"start": 64.83, "end": 65.95, "text": "你先安抚一下她"}, {"start": 65.95, "end": 67.55, "text": "我们继续检查之后再聊"}]}