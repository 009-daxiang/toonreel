{"file": "末日疯子：尸潮之下-第4集.mp4", "ep": 4, "duration": 69.9, "segments": [{"start": 4.85, "end": 5.49, "text": "谁来"}, {"start": 7.84, "end": 8.52, "text": "我来吧"}, {"start": 9.53, "end": 10.05, "text": "别怕"}, {"start": 14.66, "end": 15.38, "text": "开门"}, {"start": 15.58, "end": 16.78, "text": "快开门呀"}, {"start": 16.94, "end": 18.46, "text": "见人给我开门"}, {"start": 18.9, "end": 20.1, "text": "开门别怕别怕"}, {"start": 20.1, "end": 21.5, "text": "我只是有点饿了"}, {"start": 22.06, "end": 22.86, "text": "快开门"}, {"start": 22.86, "end": 24.26, "text": "想往哪里跑"}, {"start": 24.46, "end": 26.54, "text": "不如等我来割开你们的喉咙"}, {"start": 28.39, "end": 28.99, "text": "别慌"}, {"start": 39.93, "end": 41.33, "text": "我要把你的眼睛"}, {"start": 41.33, "end": 43.01, "text": "把你塞进肚子里"}, {"start": 43.45, "end": 44.61, "text": "别怕快开门"}, {"start": 52.21, "end": 52.77, "text": "玉慧"}, {"start": 53.13, "end": 55.29, "text": "绳子要断了"}, {"start": 55.57, "end": 56.41, "text": "裂开是正常的"}, {"start": 56.41, "end": 57.25, "text": "但是不至于断"}, {"start": 57.25, "end": 57.89, "text": "你慢慢下来"}, {"start": 57.89, "end": 58.81, "text": "我们能抓住你的腿"}, {"start": 58.81, "end": 59.89, "text": "我们会抓住你的"}]}