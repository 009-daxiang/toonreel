{"file": "全民双人求生：升级木屋校花贴贴-第31集.mp4", "ep": 31, "duration": 42.1, "segments": [{"start": 0.0, "end": 1.32, "text": "届时需要将其抓住"}, {"start": 1.32, "end": 2.32, "text": "可以进行收服"}, {"start": 3.16, "end": 3.84, "text": "收服"}, {"start": 4.08, "end": 5.2, "text": "抓住就能收服吗"}, {"start": 6.08, "end": 7.12, "text": "攻击野兽"}, {"start": 7.12, "end": 8.68, "text": "在其眼眼一瞎的时候"}, {"start": 8.68, "end": 10.2, "text": "你可以用巷圈收服"}, {"start": 10.56, "end": 12.6, "text": "越是强大的生物收服难度越大"}, {"start": 12.6, "end": 13.24, "text": "当然"}, {"start": 13.24, "end": 14.6, "text": "若是你从小眷养"}, {"start": 14.6, "end": 16.36, "text": "又需要巷圈也能收服野兽"}, {"start": 16.36, "end": 17.92, "text": "当然如果你有特殊办法"}, {"start": 17.92, "end": 19.6, "text": "让强大的生物顺从于你"}, {"start": 19.6, "end": 20.76, "text": "那也是你的本事"}, {"start": 20.76, "end": 21.72, "text": "特殊提示"}, {"start": 21.72, "end": 23.12, "text": "不管是巷圈收服"}, {"start": 23.12, "end": 24.52, "text": "还是从小眷养"}, {"start": 24.52, "end": 26.24, "text": "任何方式的收服成功后"}, {"start": 26.24, "end": 28.04, "text": "他们都会绝对忠诚于你"}, {"start": 28.72, "end": 29.48, "text": "学长"}, {"start": 29.48, "end": 30.44, "text": "如果是鸟类的话"}, {"start": 30.44, "end": 31.44, "text": "说不定很弱"}, {"start": 31.44, "end": 32.96, "text": "不用巷圈也能收服"}, {"start": 32.96, "end": 34.0, "text": "或许可以试试"}, {"start": 34.0, "end": 35.16, "text": "说不定后面有用"}, {"start": 35.8, "end": 36.52, "text": "也是"}, {"start": 36.52, "end": 37.48, "text": "反正有两粒"}, {"start": 37.48, "end": 39.52, "text": "试试看"}, {"start": 39.52, "end": 40.76, "text": "学长"}, {"start": 40.76, "end": 42.12, "text": "真的会有鸟过来吗"}]}