{"file": "全民双人求生：升级木屋校花贴贴-第65集.mp4", "ep": 65, "duration": 46.1, "segments": [{"start": 0.0, "end": 6.06, "text": "我摸到一个箱子"}, {"start": 6.06, "end": 7.06, "text": "一星的资源箱"}, {"start": 7.06, "end": 8.06, "text": "有两块肉"}, {"start": 9.06, "end": 10.06, "text": "楼上垃圾"}, {"start": 10.06, "end": 12.06, "text": "我都摸到二星资源箱了"}, {"start": 12.06, "end": 13.06, "text": "二十单位的木头呢"}, {"start": 13.06, "end": 14.06, "text": "别说箱子了"}, {"start": 14.06, "end": 15.06, "text": "我找了一天了"}, {"start": 15.06, "end": 17.06, "text": "连根毛都没找到"}, {"start": 17.06, "end": 18.06, "text": "真有箱子吗"}, {"start": 18.06, "end": 19.06, "text": "我的字体怎么了"}, {"start": 19.06, "end": 20.06, "text": "为啥在流血"}, {"start": 20.06, "end": 22.06, "text": "当你的字体开始渗血"}, {"start": 22.06, "end": 25.69, "text": "证明你的位置"}, {"start": 25.69, "end": 27.69, "text": "已经被方圆二十里的猎者发现"}, {"start": 27.69, "end": 29.69, "text": "尽力活下来吧"}, {"start": 29.69, "end": 30.69, "text": "还会这样"}, {"start": 30.69, "end": 31.69, "text": "兄弟"}, {"start": 31.69, "end": 36.78, "text": "你这命不好啊"}, {"start": 36.78, "end": 39.04, "text": "不过话说回来了"}, {"start": 39.04, "end": 40.04, "text": "猎者到底是啥"}, {"start": 40.04, "end": 41.04, "text": "有多强啊"}, {"start": 41.04, "end": 42.04, "text": "那可是要命的好吧"}, {"start": 42.04, "end": 43.04, "text": "哥们"}, {"start": 43.04, "end": 44.04, "text": "自求多福"}]}