{"file": "东北异事之出马诡堂-第84集.mp4", "ep": 84, "duration": 115.8, "segments": [{"start": 2.22, "end": 4.22, "text": "毕竟你家仙家第一次上绳说话"}, {"start": 4.22, "end": 5.62, "text": "喝点酒好下来些"}, {"start": 6.02, "end": 13.07, "text": "今日这堂"}, {"start": 13.27, "end": 14.87, "text": "闹事的仇先少不了"}, {"start": 14.87, "end": 15.67, "text": "小子"}, {"start": 16.07, "end": 17.87, "text": "把你的鬼匠摆开"}, {"start": 17.87, "end": 19.27, "text": "来一个安一个"}, {"start": 19.67, "end": 20.5, "text": "明白"}, {"start": 20.9, "end": 22.0, "text": "出来吧"}, {"start": 22.0, "end": 23.0, "text": "干活了"}, {"start": 23.4, "end": 29.22, "text": "仙家小何时开口"}, {"start": 29.62, "end": 32.18, "text": "在下胡天山"}, {"start": 32.18, "end": 33.78, "text": "胡家我为教主"}, {"start": 33.78, "end": 34.38, "text": "好"}, {"start": 34.38, "end": 36.18, "text": "那就请胡家教主"}, {"start": 36.18, "end": 37.38, "text": "替胡家报名"}, {"start": 37.78, "end": 38.78, "text": "胡天爸"}, {"start": 39.18, "end": 40.38, "text": "胡天龙"}, {"start": 40.98, "end": 42.38, "text": "胡天妹"}, {"start": 44.42, "end": 46.42, "text": "胡家男女必须一般多"}, {"start": 46.82, "end": 48.42, "text": "差一个就得翻堂"}, {"start": 48.88, "end": 50.28, "text": "胡家报完了"}, {"start": 50.28, "end": 52.48, "text": "请皇家教主上绳说话了"}, {"start": 54.8, "end": 56.8, "text": "皇家教主皇天宝"}, {"start": 56.8, "end": 58.4, "text": "皇家男先九位"}, {"start": 58.4, "end": 59.6, "text": "女先九位"}, {"start": 59.6, "end": 62.0, "text": "今日老仙家落马登坑"}, {"start": 62.0, "end": 63.2, "text": "这是喜事"}, {"start": 63.2, "end": 66.2, "text": "但还望皇家教主报名时仔细写"}, {"start": 66.4, "end": 67.6, "text": "若是翻堂"}, {"start": 67.6, "end": 69.0, "text": "对地马不好"}, {"start": 69.0, "end": 69.8, "text": "放心"}, {"start": 70.0, "end": 71.6, "text": "我腾地马还来不及"}, {"start": 71.6, "end": 73.0, "text": "怎会加害于他"}, {"start": 74.26, "end": 75.46, "text": "外务行"}, {"start": 75.46, "end": 76.46, "text": "白鹰一位"}, {"start": 76.66, "end": 78.26, "text": "报一位归一位"}, {"start": 78.26, "end": 80.06, "text": "接下来就要请卑王了"}, {"start": 80.06, "end": 81.66, "text": "这是众中之众"}, {"start": 82.1, "end": 83.5, "text": "请卑王"}, {"start": 84.89, "end": 86.89, "text": "必府上来为何不说话"}, {"start": 87.09, "end": 88.89, "text": "心中有什么话尽管说"}, {"start": 89.09, "end": 90.69, "text": "不要给地马憋坏了"}, {"start": 96.56, "end": 97.56, "text": "你会什么"}, {"start": 97.56, "end": 98.76, "text": "有什么本事"}, {"start": 105.53, "end": 107.33, "text": "这不是撒泼打滚吗"}, {"start": 109.84, "end": 110.84, "text": "没事了"}, {"start": 111.04, "end": 112.64, "text": "已经拉下去了"}, {"start": 113.61, "end": 114.81, "text": "您就是卑王"}]}