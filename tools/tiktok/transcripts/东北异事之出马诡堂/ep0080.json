{"file": "东北异事之出马诡堂-第80集.mp4", "ep": 80, "duration": 76.9, "segments": [{"start": 0.0, "end": 0.56, "text": "说吧"}, {"start": 1.24, "end": 1.92, "text": "你不说"}, {"start": 2.24, "end": 3.04, "text": "我也查得到"}, {"start": 4.23, "end": 5.27, "text": "去年秋天"}, {"start": 5.59, "end": 7.15, "text": "他说带我来西施三新"}, {"start": 7.35, "end": 7.99, "text": "哪个他"}, {"start": 8.9, "end": 9.74, "text": "城里那个"}, {"start": 10.78, "end": 12.06, "text": "他媳妇跟他离了"}, {"start": 14.0, "end": 15.4, "text": "他恨我当初找上门"}, {"start": 15.88, "end": 16.76, "text": "过了一个月"}, {"start": 16.96, "end": 18.92, "text": "我以为他约我是回心转意了"}, {"start": 19.24, "end": 20.84, "text": "我特意穿了红裙子"}, {"start": 21.12, "end": 22.96, "text": "没想到到了西施"}, {"start": 22.96, "end": 24.2, "text": "住进了这间房"}, {"start": 25.28, "end": 26.56, "text": "他拿刀把我捅了"}, {"start": 26.64, "end": 27.68, "text": "又把我剁开"}, {"start": 29.28, "end": 30.56, "text": "装了两个箱子"}, {"start": 32.05, "end": 33.13, "text": "一块一块的"}, {"start": 33.25, "end": 34.21, "text": "情况我知道了"}, {"start": 34.21, "end": 34.93, "text": "你的诉求就是"}, {"start": 34.93, "end": 36.25, "text": "见自己儿子一面是不"}, {"start": 36.76, "end": 37.24, "text": "行"}, {"start": 37.52, "end": 38.36, "text": "你怨气太大"}, {"start": 38.36, "end": 39.64, "text": "我先把你送进鬼堂"}, {"start": 39.64, "end": 40.72, "text": "不然你离不开这里"}, {"start": 41.52, "end": 42.56, "text": "谢谢小师傅"}, {"start": 42.68, "end": 43.52, "text": "先别谢我"}, {"start": 43.68, "end": 44.76, "text": "你先等两天吧"}, {"start": 44.92, "end": 46.12, "text": "我先上一趟隐秀山"}, {"start": 46.12, "end": 46.88, "text": "再去你家"}, {"start": 53.06, "end": 53.7, "text": "妹子"}, {"start": 54.18, "end": 54.94, "text": "你哭啥"}, {"start": 56.76, "end": 57.68, "text": "不好意思"}, {"start": 58.45, "end": 60.05, "text": "观音坐下的童女"}, {"start": 60.17, "end": 61.25, "text": "偷跑下街来"}, {"start": 61.37, "end": 62.01, "text": "你确定"}, {"start": 62.41, "end": 63.45, "text": "那岂不是很厉害"}, {"start": 63.57, "end": 64.85, "text": "他身上带着纸"}, {"start": 65.17, "end": 66.53, "text": "人家奉命出马"}, {"start": 66.65, "end": 67.69, "text": "得立堂口"}, {"start": 68.34, "end": 68.98, "text": "不会我的缘"}, {"start": 68.98, "end": 70.1, "text": "就是要给他立堂吧"}, {"start": 71.98, "end": 73.46, "text": "你小子还不算太傻"}, {"start": 73.7, "end": 74.54, "text": "那可不行"}, {"start": 75.02, "end": 75.9, "text": "什么不行"}]}