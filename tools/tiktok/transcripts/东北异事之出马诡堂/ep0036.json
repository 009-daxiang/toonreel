{"file": "东北异事之出马诡堂-第36集.mp4", "ep": 36, "duration": 55.5, "segments": [{"start": 0.4, "end": 1.6, "text": "她明明是女孩"}, {"start": 1.6, "end": 2.8, "text": "咋能是童子呢"}, {"start": 2.8, "end": 4.24, "text": "她的原神是童子"}, {"start": 4.24, "end": 6.24, "text": "本是神仙坐下的仙童"}, {"start": 6.24, "end": 8.24, "text": "偷跑出来误投了女神"}, {"start": 8.24, "end": 9.84, "text": "她侍奉的是正神"}, {"start": 9.84, "end": 11.0, "text": "她不回去干活"}, {"start": 11.0, "end": 12.28, "text": "难道让正神干活"}, {"start": 12.28, "end": 13.84, "text": "上面也有上面的规矩"}, {"start": 13.84, "end": 15.12, "text": "她这是违反规定"}, {"start": 15.12, "end": 16.24, "text": "那化解不了"}, {"start": 16.24, "end": 17.52, "text": "她真的会死"}, {"start": 17.52, "end": 19.08, "text": "她父母咋办"}, {"start": 19.08, "end": 20.93, "text": "化解不了"}, {"start": 20.93, "end": 22.19, "text": "十八岁过完生日"}, {"start": 22.19, "end": 23.03, "text": "她就会死"}, {"start": 23.03, "end": 24.71, "text": "要是事情没那么急"}, {"start": 24.71, "end": 26.71, "text": "咱们替她还一个替神仙上去"}, {"start": 26.71, "end": 28.07, "text": "替正神干点咋活"}, {"start": 28.07, "end": 29.63, "text": "等童子寿命到了"}, {"start": 29.79, "end": 32.64, "text": "自然就上去受罚"}, {"start": 32.64, "end": 34.24, "text": "那就赶紧给她还替神"}, {"start": 34.24, "end": 35.72, "text": "拖一天少一天"}, {"start": 35.72, "end": 36.24, "text": "走"}, {"start": 36.24, "end": 41.98, "text": "那还等啥"}, {"start": 41.98, "end": 43.26, "text": "是刘大师吧"}, {"start": 43.26, "end": 44.5, "text": "快进屋暖和暖和"}, {"start": 44.5, "end": 46.42, "text": "看来她媳妇刚跟她动过手"}, {"start": 46.42, "end": 50.21, "text": "又领来两个招摇状骗的"}, {"start": 50.21, "end": 51.21, "text": "乔老弟"}, {"start": 51.21, "end": 52.33, "text": "你媳妇不信这个"}, {"start": 52.33, "end": 53.69, "text": "我们也没必要自讨苦吃"}, {"start": 53.69, "end": 54.49, "text": "先走了"}]}