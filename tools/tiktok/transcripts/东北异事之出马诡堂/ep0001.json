{"file": "东北异事之出马诡堂-第1集.mp4", "ep": 1, "duration": 81.7, "segments": [{"start": 2.1, "end": 2.78, "text": "爹"}, {"start": 3.18, "end": 4.06, "text": "小侠肚子疼"}, {"start": 4.14, "end": 5.14, "text": "还兜不住尿"}, {"start": 5.22, "end": 6.62, "text": "你他们瞎嚷嚷什么"}, {"start": 6.7, "end": 7.66, "text": "那是快生了"}, {"start": 7.74, "end": 8.9, "text": "快去请张婆子"}, {"start": 9.14, "end": 10.02, "text": "外面等着"}, {"start": 10.5, "end": 13.9, "text": "去看看什么动静"}, {"start": 14.1, "end": 14.86, "text": "顺便把金额子"}, {"start": 14.94, "end": 15.58, "text": "给老子拿进来"}, {"start": 15.66, "end": 16.66, "text": "别被风吹跑了"}, {"start": 17.14, "end": 19.1, "text": "爹 爹 院子里全是蛇"}, {"start": 19.46, "end": 22.51, "text": "九月的天"}, {"start": 22.59, "end": 23.75, "text": "哪来这么多长虫"}, {"start": 23.83, "end": 26.02, "text": "是冲着屋里的孩子来的"}, {"start": 26.26, "end": 28.02, "text": "爹 怎么办 怎么办"}, {"start": 28.26, "end": 29.06, "text": "喊什么喊"}, {"start": 29.26, "end": 29.74, "text": "去"}, {"start": 29.98, "end": 31.22, "text": "把老子的剪刀拿过来"}, {"start": 31.3, "end": 32.9, "text": "哪条靠近老子杀哪条"}, {"start": 33.3, "end": 36.17, "text": "这剪刀炸了一辈子指人"}, {"start": 36.25, "end": 37.09, "text": "沾满阴气"}, {"start": 37.25, "end": 38.41, "text": "恶鬼剑了都躲"}, {"start": 39.0, "end": 40.52, "text": "我倒要看看你们想干啥"}, {"start": 40.6, "end": 52.9, "text": "这无常索命"}, {"start": 53.1, "end": 54.06, "text": "这些长虫"}, {"start": 54.38, "end": 55.5, "text": "是在拦他们"}, {"start": 58.7, "end": 59.74, "text": "杰子出来一下"}, {"start": 61.48, "end": 62.0, "text": "爹"}, {"start": 62.24, "end": 62.92, "text": "这蛇"}, {"start": 63.2, "end": 64.24, "text": "都是你杀的"}, {"start": 64.72, "end": 65.4, "text": "别废话"}, {"start": 65.64, "end": 66.36, "text": "找几个编织袋"}, {"start": 66.44, "end": 67.44, "text": "赶紧把院子收拾吧"}, {"start": 67.56, "end": 77.69, "text": "又咋了"}, {"start": 78.62, "end": 79.98, "text": "爹 忙"}]}