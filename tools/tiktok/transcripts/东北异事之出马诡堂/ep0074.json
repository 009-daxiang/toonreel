{"file": "东北异事之出马诡堂-第74集.mp4", "ep": 74, "duration": 113.1, "segments": [{"start": 0.75, "end": 2.27, "text": "没 没有了啊"}, {"start": 8.5, "end": 9.22, "text": "小蝶"}, {"start": 9.58, "end": 11.02, "text": "完了 真诈实了"}, {"start": 11.3, "end": 12.58, "text": "老弟 你退啥呀"}, {"start": 12.7, "end": 13.94, "text": "你不专业的吗"}, {"start": 14.14, "end": 14.78, "text": "对呀"}, {"start": 15.22, "end": 16.14, "text": "我跑啥"}, {"start": 16.42, "end": 17.34, "text": "我专业的"}, {"start": 19.39, "end": 20.07, "text": "站住"}, {"start": 20.55, "end": 21.71, "text": "可是刘家老爷子"}, {"start": 25.2, "end": 26.6, "text": "他被人堵了嗓子"}, {"start": 26.68, "end": 27.64, "text": "说不了话"}, {"start": 30.93, "end": 31.49, "text": "别动"}, {"start": 32.06, "end": 33.22, "text": "借你身子传话"}, {"start": 34.26, "end": 35.46, "text": "你还敢来"}, {"start": 36.18, "end": 37.7, "text": "你还有脸来"}, {"start": 37.7, "end": 38.54, "text": "老爷子"}, {"start": 39.1, "end": 40.1, "text": "有事说事"}, {"start": 44.95, "end": 46.75, "text": "老爷子 动手没用"}, {"start": 47.27, "end": 48.23, "text": "我是你爸"}, {"start": 48.39, "end": 50.49, "text": "我给的"}, {"start": 53.26, "end": 54.54, "text": "在我这儿说这些没用"}, {"start": 54.54, "end": 55.38, "text": "你想告状"}, {"start": 55.38, "end": 56.58, "text": "我给你找地方告"}, {"start": 56.7, "end": 57.46, "text": "你不说"}, {"start": 57.46, "end": 58.42, "text": "我也帮不了你"}, {"start": 58.42, "end": 59.26, "text": "看事二百"}, {"start": 59.26, "end": 60.18, "text": "解决三千"}, {"start": 60.18, "end": 61.62, "text": "名码标价 不还价"}, {"start": 62.27, "end": 63.19, "text": "你数三个数"}, {"start": 63.51, "end": 64.87, "text": "三个数之后我走人"}, {"start": 65.27, "end": 66.27, "text": "你愿意闹就闹"}, {"start": 66.51, "end": 67.55, "text": "看最后谁吃亏"}, {"start": 67.91, "end": 69.07, "text": "我就要一口气"}, {"start": 69.83, "end": 71.39, "text": "我要他当着所有人的面"}, {"start": 71.39, "end": 72.87, "text": "给我磕头认错"}, {"start": 75.01, "end": 76.41, "text": "那你得把话说明白"}, {"start": 77.23, "end": 78.19, "text": "说不明白"}, {"start": 78.19, "end": 79.11, "text": "就当我没来"}, {"start": 79.11, "end": 80.19, "text": "他赌钱欠了几十万"}, {"start": 80.19, "end": 81.39, "text": "回来跟我要我没给"}, {"start": 81.39, "end": 82.79, "text": "后来我跟隔壁村的老太太"}, {"start": 82.79, "end": 83.71, "text": "打会儿过日子"}, {"start": 83.71, "end": 85.03, "text": "他跑到人家门口骂街"}, {"start": 85.03, "end": 86.59, "text": "说人家涂我的房子"}, {"start": 86.59, "end": 87.43, "text": "后来呢"}, {"start": 87.43, "end": 88.67, "text": "他把我堵在屋里"}, {"start": 88.67, "end": 90.39, "text": "拿药瓶子逼我写东西"}, {"start": 90.39, "end": 92.23, "text": "说房子得提前给他"}, {"start": 92.23, "end": 92.99, "text": "我不写"}, {"start": 92.99, "end": 94.39, "text": "他就把我摁在床上"}, {"start": 94.39, "end": 96.31, "text": "一勺一勺的为我吃药"}, {"start": 96.31, "end": 98.59, "text": "我死都死的不通鬼"}, {"start": 98.59, "end": 100.15, "text": "老子去世那天"}, {"start": 100.15, "end": 101.31, "text": "他在牌桌上"}, {"start": 101.31, "end": 102.67, "text": "别人给他打电话"}, {"start": 102.67, "end": 104.71, "text": "他说等他打完这一把"}, {"start": 106.19, "end": 107.55, "text": "去下面问问"}, {"start": 107.59, "end": 109.27, "text": "他说的到底是不是真的"}, {"start": 109.27, "end": 110.55, "text": "我要他磕头"}, {"start": 110.55, "end": 112.03, "text": "当着全院人的面"}]}