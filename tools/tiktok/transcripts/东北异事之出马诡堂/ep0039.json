{"file": "东北异事之出马诡堂-第39集.mp4", "ep": 39, "duration": 56.8, "segments": [{"start": 0.0, "end": 0.8, "text": "真敬"}, {"start": 1.4, "end": 2.4, "text": "生辰八字给我"}, {"start": 3.13, "end": 4.13, "text": "他今晚还会来"}, {"start": 4.13, "end": 6.33, "text": "敲锣打鼓八台大教把你接走"}, {"start": 6.33, "end": 7.41, "text": "我给你画道符文"}, {"start": 7.41, "end": 8.45, "text": "顺前放枕头下"}, {"start": 8.45, "end": 9.53, "text": "上面放一把剪刀"}, {"start": 9.53, "end": 10.13, "text": "记住"}, {"start": 10.13, "end": 11.21, "text": "做梦的时候"}, {"start": 11.21, "end": 12.53, "text": "不管谁跟你说什么"}, {"start": 12.53, "end": 13.73, "text": "一个字都别回答"}, {"start": 17.62, "end": 18.22, "text": "老刘"}, {"start": 18.22, "end": 19.02, "text": "这是咋回事"}, {"start": 20.84, "end": 21.44, "text": "别出声"}, {"start": 22.04, "end": 22.64, "text": "听我的"}, {"start": 23.17, "end": 24.37, "text": "娘子"}, {"start": 24.37, "end": 25.57, "text": "我来接你了"}, {"start": 25.57, "end": 27.97, "text": "我们终于要成亲了"}, {"start": 30.69, "end": 32.49, "text": "娘子跟我走吧"}, {"start": 32.89, "end": 34.89, "text": "我带你奔向更好的生活"}, {"start": 34.89, "end": 36.29, "text": "你怎么不睁眼看我"}, {"start": 36.69, "end": 38.29, "text": "是这张脸看腻了吗"}, {"start": 42.37, "end": 43.17, "text": "娘子"}, {"start": 43.57, "end": 44.97, "text": "这张脸你喜欢不"}, {"start": 46.71, "end": 47.91, "text": "再不说话"}, {"start": 47.91, "end": 49.71, "text": "我把你碎尸万段"}, {"start": 51.19, "end": 52.19, "text": "忍住呀"}, {"start": 52.39, "end": 53.79, "text": "一个字都不能答"}, {"start": 53.79, "end": 55.39, "text": "答了就被他带走了"}]}