{"file": "东北异事之出马诡堂-第40集.mp4", "ep": 40, "duration": 60.2, "segments": [{"start": 1.38, "end": 1.9, "text": "住手"}, {"start": 5.58, "end": 6.26, "text": "林月玲"}, {"start": 6.78, "end": 8.14, "text": "你背着我找小白脸"}, {"start": 8.77, "end": 10.25, "text": "我今天让你魂飞破叹"}, {"start": 16.03, "end": 17.71, "text": "这伙鬼怎么越打越多"}, {"start": 19.96, "end": 21.44, "text": "鬼将鬼兵何在"}, {"start": 25.38, "end": 26.66, "text": "有本事咱俩单挑"}, {"start": 27.02, "end": 27.54, "text": "好啊"}, {"start": 28.06, "end": 29.7, "text": "你一个人挑战我们一群吧"}, {"start": 29.98, "end": 31.02, "text": "跟我比人多"}, {"start": 31.34, "end": 32.14, "text": "你还嫩了点"}, {"start": 32.46, "end": 34.18, "text": "你们这是仗事欺人"}, {"start": 37.8, "end": 38.8, "text": "鬼王印一盖"}, {"start": 39.04, "end": 40.28, "text": "千军万浪"}, {"start": 42.13, "end": 42.77, "text": "说说吧"}, {"start": 43.5, "end": 45.3, "text": "你为啥一直缠着林月玲"}, {"start": 45.7, "end": 46.74, "text": "我叫孙承义"}, {"start": 47.02, "end": 48.1, "text": "光序年间的人"}, {"start": 48.5, "end": 49.62, "text": "本是教书先生"}, {"start": 49.98, "end": 51.46, "text": "跟林月玲私定终身"}, {"start": 51.86, "end": 53.02, "text": "可临家瞧不上我"}, {"start": 53.18, "end": 54.06, "text": "把她锁在家里"}, {"start": 54.38, "end": 55.26, "text": "另找了夫家"}, {"start": 55.54, "end": 56.22, "text": "我受不了"}, {"start": 56.78, "end": 57.58, "text": "抹了脖子"}, {"start": 57.98, "end": 59.14, "text": "死在荒郊野岭"}]}