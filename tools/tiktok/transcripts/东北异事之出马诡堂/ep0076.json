{"file": "东北异事之出马诡堂-第76集.mp4", "ep": 76, "duration": 80.3, "segments": [{"start": 0.0, "end": 1.76, "text": "瘦衣穿在里头压阳气"}, {"start": 1.76, "end": 2.72, "text": "即使做起"}, {"start": 2.72, "end": 3.84, "text": "无股市买路前"}, {"start": 3.84, "end": 4.88, "text": "一样都不能少"}, {"start": 4.88, "end": 5.76, "text": "沈子"}, {"start": 5.76, "end": 7.24, "text": "瘦鞋一双一双地烧"}, {"start": 7.24, "end": 8.36, "text": "一个中头一双"}, {"start": 8.36, "end": 9.12, "text": "别停"}, {"start": 9.12, "end": 10.68, "text": "那鞋是干啥用的"}, {"start": 11.22, "end": 12.26, "text": "给我指路"}, {"start": 12.26, "end": 14.22, "text": "鞋子烧完我就得回来"}, {"start": 16.59, "end": 17.59, "text": "上来吧"}, {"start": 17.59, "end": 18.75, "text": "抱紧肌脖子"}, {"start": 24.04, "end": 24.72, "text": "走"}, {"start": 25.2, "end": 26.48, "text": "这是金鸡山"}, {"start": 26.48, "end": 27.44, "text": "别往下看"}, {"start": 27.44, "end": 28.36, "text": "别看它们"}, {"start": 28.36, "end": 31.06, "text": "抓稳了"}, {"start": 31.06, "end": 32.62, "text": "小铁过来"}, {"start": 32.62, "end": 34.3, "text": "让爷爷看看你"}, {"start": 34.85, "end": 36.01, "text": "都是假的"}, {"start": 36.01, "end": 37.69, "text": "睁了眼你就回不去了"}, {"start": 37.69, "end": 38.61, "text": "爷爷"}, {"start": 38.81, "end": 40.25, "text": "等我回来给你上香"}, {"start": 41.05, "end": 42.57, "text": "地府东城到了"}, {"start": 42.57, "end": 43.8, "text": "二姑奶"}, {"start": 43.8, "end": 45.32, "text": "证书的事咋样了"}, {"start": 45.32, "end": 46.43, "text": "来了"}, {"start": 46.43, "end": 47.35, "text": "走吧"}, {"start": 47.35, "end": 49.63, "text": "罚恶司那边我打过招呼了"}, {"start": 49.63, "end": 50.79, "text": "郑成良的案子"}, {"start": 50.79, "end": 52.99, "text": "我接了"}, {"start": 52.99, "end": 54.39, "text": "活人不能进"}, {"start": 54.39, "end": 55.31, "text": "你进去"}, {"start": 55.31, "end": 56.59, "text": "就成案卷上的人了"}, {"start": 56.59, "end": 57.9, "text": "要多久"}, {"start": 57.9, "end": 58.94, "text": "说不好"}, {"start": 58.94, "end": 60.02, "text": "判官的比"}, {"start": 60.02, "end": 65.42, "text": "比人的命还慢"}, {"start": 65.42, "end": 66.46, "text": "小翠"}, {"start": 66.46, "end": 67.34, "text": "我等得起"}, {"start": 67.34, "end": 75.93, "text": "你看气棺子"}, {"start": 75.93, "end": 77.66, "text": "棺子倒了"}, {"start": 77.66, "end": 79.58, "text": "就是阳气快撑不住了"}]}