{"file": "东北异事之出马诡堂-第6集.mp4", "ep": 6, "duration": 63.8, "segments": [{"start": 2.1, "end": 4.02, "text": "天生撬开了一半"}, {"start": 4.02, "end": 5.62, "text": "被怨鬼一铺"}, {"start": 5.62, "end": 6.82, "text": "全开了"}, {"start": 6.82, "end": 8.5, "text": "这孩子"}, {"start": 8.5, "end": 10.26, "text": "怕是要闹病啊"}, {"start": 10.26, "end": 12.62, "text": "我得给他爷爷透个信"}, {"start": 12.62, "end": 13.62, "text": "铁哥"}, {"start": 13.62, "end": 14.42, "text": "铁哥"}, {"start": 14.42, "end": 15.82, "text": "你身上咋这么烫"}, {"start": 15.82, "end": 17.1, "text": "你发烧了"}, {"start": 17.1, "end": 20.68, "text": "胖子"}, {"start": 20.68, "end": 22.69, "text": "我后背发尘"}, {"start": 22.69, "end": 24.61, "text": "想怕这个人"}, {"start": 27.98, "end": 29.14, "text": "找人整一下吧"}, {"start": 29.14, "end": 30.02, "text": "时候到了"}, {"start": 30.02, "end": 31.58, "text": "你想拦也拦不住"}, {"start": 31.58, "end": 33.76, "text": "老刘"}, {"start": 33.76, "end": 35.68, "text": "这孩子以后"}, {"start": 35.68, "end": 36.84, "text": "先退烧"}, {"start": 36.84, "end": 38.44, "text": "别的事以后再说"}, {"start": 41.25, "end": 50.18, "text": "这孩子终究是要跨过这道坎"}, {"start": 50.18, "end": 51.3, "text": "别说话"}, {"start": 51.3, "end": 53.26, "text": "睡吧"}, {"start": 53.26, "end": 55.49, "text": "先家要是还在"}, {"start": 55.49, "end": 57.13, "text": "就请高抬贵手"}, {"start": 57.13, "end": 59.71, "text": "别为难这孩子了"}, {"start": 59.71, "end": 60.59, "text": "小天"}, {"start": 60.59, "end": 61.63, "text": "你知道"}, {"start": 61.63, "end": 63.23, "text": "你还有个二公奶吗"}]}