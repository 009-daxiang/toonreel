{"file": "东北异事之出马诡堂-第43集.mp4", "ep": 43, "duration": 68.7, "segments": [{"start": 0.85, "end": 2.13, "text": "是刘大仙吗"}, {"start": 2.13, "end": 3.29, "text": "我闺女死了"}, {"start": 3.29, "end": 4.93, "text": "死前眼睛睁的老大"}, {"start": 4.93, "end": 6.01, "text": "怎么都逼不上"}, {"start": 6.01, "end": 7.33, "text": "你方便来看看不"}, {"start": 7.33, "end": 7.81, "text": "叔"}, {"start": 7.81, "end": 8.77, "text": "我不是干这活的"}, {"start": 8.77, "end": 9.81, "text": "你找错人了"}, {"start": 9.81, "end": 10.73, "text": "我是出马仙"}, {"start": 10.73, "end": 11.69, "text": "不是阴阳先生"}, {"start": 12.33, "end": 13.13, "text": "为啥不去"}, {"start": 13.13, "end": 14.05, "text": "一看就有冤屈"}, {"start": 14.05, "end": 15.45, "text": "找老仙问问不就行了"}, {"start": 15.45, "end": 16.85, "text": "我从来不出白活"}, {"start": 16.85, "end": 17.73, "text": "小田你记住"}, {"start": 17.73, "end": 19.25, "text": "以后必须有三不看"}, {"start": 19.25, "end": 20.29, "text": "第一不看寿命"}, {"start": 20.29, "end": 21.17, "text": "那是天机"}, {"start": 21.17, "end": 22.41, "text": "泄露天机会折瘦"}, {"start": 22.41, "end": 23.65, "text": "第二不看江死之人"}, {"start": 23.65, "end": 24.69, "text": "阎王让他三耕死"}, {"start": 24.69, "end": 25.77, "text": "谁敢留他到虎耕"}, {"start": 25.77, "end": 27.13, "text": "第三不看不信之人"}, {"start": 27.13, "end": 28.01, "text": "他会排斥你"}, {"start": 28.01, "end": 29.13, "text": "甚至无中生有"}, {"start": 29.13, "end": 30.21, "text": "这三条"}, {"start": 30.21, "end": 31.93, "text": "我得记一辈子"}, {"start": 31.93, "end": 41.7, "text": "我家没人信这个"}, {"start": 41.7, "end": 43.32, "text": "还处理一下吗"}, {"start": 43.32, "end": 44.6, "text": "这个事没问题"}, {"start": 44.6, "end": 45.4, "text": "我接了"}, {"start": 47.95, "end": 49.75, "text": "是刘大师吧"}, {"start": 49.75, "end": 52.25, "text": "跟我来"}, {"start": 52.25, "end": 53.25, "text": "老人家"}, {"start": 53.25, "end": 54.33, "text": "唐丹在哪"}, {"start": 54.33, "end": 56.65, "text": "有仙家存在过的气息"}, {"start": 56.65, "end": 59.92, "text": "如今只剩孤魂野鬼"}, {"start": 59.92, "end": 61.03, "text": "老刘"}, {"start": 61.03, "end": 63.24, "text": "看出啥来了"}, {"start": 63.24, "end": 64.8, "text": "我们想去见见死者"}, {"start": 64.8, "end": 65.95, "text": "方便吗"}, {"start": 65.95, "end": 66.43, "text": "行"}, {"start": 66.43, "end": 67.59, "text": "跟着我来吧"}]}