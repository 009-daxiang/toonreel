{"file": "东北异事之出马诡堂-第25集.mp4", "ep": 25, "duration": 58.1, "segments": [{"start": 0.0, "end": 0.8, "text": "孤爺爺"}, {"start": 1.28, "end": 2.48, "text": "是我大垂啊"}, {"start": 3.89, "end": 4.65, "text": "大垂啊"}, {"start": 4.77, "end": 6.49, "text": "怎么才上来跟孤爺爺说话"}, {"start": 6.49, "end": 7.17, "text": "孤爺爺"}, {"start": 7.57, "end": 8.77, "text": "您可以去告状"}, {"start": 8.93, "end": 9.93, "text": "请上方大印"}, {"start": 10.21, "end": 11.65, "text": "不能做违规的事啊"}, {"start": 11.77, "end": 12.89, "text": "小跑肉身毁了"}, {"start": 13.05, "end": 13.89, "text": "元神还在"}, {"start": 14.01, "end": 15.05, "text": "还能继续修行"}, {"start": 15.41, "end": 16.61, "text": "他已经丢了半条命"}, {"start": 16.61, "end": 17.65, "text": "日后必遭报应"}, {"start": 17.85, "end": 18.93, "text": "死罪可免"}, {"start": 19.17, "end": 20.21, "text": "活罪难逃"}, {"start": 20.65, "end": 22.09, "text": "五年内他头疼不止"}, {"start": 22.33, "end": 24.69, "text": "月圆之夜浑身像被巨物碾压"}, {"start": 24.85, "end": 25.33, "text": "其二"}, {"start": 25.81, "end": 26.65, "text": "供奉我孙儿"}, {"start": 26.65, "end": 28.53, "text": "初一时务三跪酒拜上乡忏悔"}, {"start": 28.53, "end": 29.05, "text": "其三"}, {"start": 29.37, "end": 30.37, "text": "我要一车金元宝"}, {"start": 30.49, "end": 31.21, "text": "再烧个庙"}, {"start": 31.21, "end": 32.49, "text": "今晚过时不厚"}, {"start": 32.49, "end": 33.69, "text": "你硬还是不硬"}, {"start": 33.69, "end": 34.97, "text": "屡家老小子"}, {"start": 34.97, "end": 35.49, "text": "我硬"}, {"start": 35.93, "end": 36.53, "text": "我硬"}, {"start": 39.49, "end": 40.97, "text": "刚才那句话不是我说的"}, {"start": 41.25, "end": 42.97, "text": "是黄大垂借着我的嘴说的"}, {"start": 42.97, "end": 43.65, "text": "吕先生"}, {"start": 43.77, "end": 45.45, "text": "这一车金元宝你能凑齐吗"}, {"start": 45.45, "end": 47.01, "text": "我认识个人可以帮你联系"}, {"start": 47.01, "end": 48.45, "text": "加急的话 价格贵点"}, {"start": 48.45, "end": 49.45, "text": "多少钱都行"}, {"start": 49.69, "end": 50.81, "text": "只要我儿子好"}, {"start": 50.93, "end": 52.41, "text": "老东西嘴上说的好"}, {"start": 52.41, "end": 54.01, "text": "心里只觉得儿子不争气"}, {"start": 54.01, "end": 55.65, "text": "被个畜生折磨成这样"}, {"start": 55.77, "end": 57.21, "text": "为啥不直接弄死他"}]}