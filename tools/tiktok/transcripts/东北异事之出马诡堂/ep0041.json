{"file": "东北异事之出马诡堂-第41集.mp4", "ep": 41, "duration": 60.7, "segments": [{"start": 0.0, "end": 1.36, "text": "我好不容易再找到他"}, {"start": 1.36, "end": 2.68, "text": "为啥不能常相守"}, {"start": 3.95, "end": 5.19, "text": "你叫孙承益"}, {"start": 5.43, "end": 7.67, "text": "没想到被你看穿了真没意思"}, {"start": 7.83, "end": 8.43, "text": "咋的"}, {"start": 8.43, "end": 9.27, "text": "砍死我"}, {"start": 9.51, "end": 10.71, "text": "这老娘们儿欠我的"}, {"start": 10.71, "end": 12.07, "text": "我找她理所应当"}, {"start": 12.19, "end": 13.23, "text": "孙铁牛"}, {"start": 13.43, "end": 14.55, "text": "你要不要脸"}, {"start": 15.06, "end": 16.9, "text": "你上一世就是个土匪"}, {"start": 17.3, "end": 18.7, "text": "你烧杀抢掠"}, {"start": 18.82, "end": 20.9, "text": "林月玲上一世是农家夫人"}, {"start": 21.06, "end": 23.22, "text": "被你抢抢上山当押寨夫人"}, {"start": 23.42, "end": 25.06, "text": "现在你说她欠你的"}, {"start": 25.84, "end": 27.04, "text": "你哪儿来的脸"}, {"start": 27.04, "end": 28.32, "text": "那是上一世的事"}, {"start": 28.44, "end": 29.88, "text": "这一世她答应过我"}, {"start": 29.92, "end": 32.8, "text": "她答应的是教书先生孙承益"}, {"start": 32.8, "end": 34.52, "text": "不是土匪孙铁牛"}, {"start": 34.68, "end": 42.85, "text": "我家堂堂上的鬼仙"}, {"start": 46.78, "end": 47.78, "text": "孙铁牛"}, {"start": 48.14, "end": 50.38, "text": "下地府偿还百年孽债吧"}, {"start": 53.8, "end": 54.48, "text": "小翠"}, {"start": 55.01, "end": 55.93, "text": "你咋还在这儿"}, {"start": 56.17, "end": 57.25, "text": "卑王派遣"}, {"start": 57.57, "end": 59.89, "text": "从今天起我护在你身边"}]}