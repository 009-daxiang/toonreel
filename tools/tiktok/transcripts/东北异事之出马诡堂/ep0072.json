{"file": "东北异事之出马诡堂-第72集.mp4", "ep": 72, "duration": 105.7, "segments": [{"start": 0.0, "end": 1.48, "text": "放之下的事情就是这样"}, {"start": 1.48, "end": 2.16, "text": "老刘"}, {"start": 2.16, "end": 3.0, "text": "你觉得"}, {"start": 3.0, "end": 4.24, "text": "我应该救吴如梅吗"}, {"start": 4.24, "end": 5.72, "text": "这怨灵一旦发狂"}, {"start": 5.72, "end": 7.48, "text": "就不止杀吴如梅一人了"}, {"start": 7.48, "end": 9.23, "text": "你背的因果会更"}, {"start": 9.23, "end": 10.03, "text": "那我不管呢"}, {"start": 10.03, "end": 11.31, "text": "那只有两种结局"}, {"start": 11.31, "end": 12.87, "text": "一是怨气慢慢散了"}, {"start": 12.87, "end": 14.11, "text": "或者越来越大"}, {"start": 14.11, "end": 14.98, "text": "你自己选"}, {"start": 14.98, "end": 15.98, "text": "我承受不住"}, {"start": 16.63, "end": 18.27, "text": "我不愿让无辜的人惨死"}, {"start": 18.67, "end": 20.07, "text": "还是因为我心软"}, {"start": 20.07, "end": 21.66, "text": "死人有天大的委屈"}, {"start": 21.66, "end": 23.34, "text": "自有低伏管辖判案"}, {"start": 23.34, "end": 24.66, "text": "如果他去报仇"}, {"start": 24.66, "end": 25.9, "text": "人间就乱了"}, {"start": 25.9, "end": 27.94, "text": "我们这行跟执法者一样"}, {"start": 27.94, "end": 28.86, "text": "不要因为心软"}, {"start": 28.86, "end": 30.14, "text": "造成更大的后果"}, {"start": 30.18, "end": 31.18, "text": "我记住了"}, {"start": 31.18, "end": 31.9, "text": "我算过了"}, {"start": 31.9, "end": 33.02, "text": "放之下等不及了"}, {"start": 33.02, "end": 33.74, "text": "今天凌晨"}, {"start": 33.74, "end": 34.62, "text": "他就登门杀吴如梅"}, {"start": 34.62, "end": 35.42, "text": "我现在过去"}, {"start": 36.5, "end": 37.74, "text": "你咋回来了"}, {"start": 37.74, "end": 39.22, "text": "我怀疑放之下会来"}, {"start": 39.22, "end": 41.99, "text": "今晚我帮你们守夜"}, {"start": 41.99, "end": 43.39, "text": "吓唬谁呢"}, {"start": 43.39, "end": 44.99, "text": "那小妮子有那个胆"}, {"start": 44.99, "end": 46.03, "text": "她要是厉害一点"}, {"start": 46.03, "end": 46.95, "text": "死的就不是她了"}, {"start": 46.95, "end": 47.55, "text": "是我"}, {"start": 47.55, "end": 48.03, "text": "妈"}, {"start": 48.03, "end": 48.95, "text": "你少说两句"}, {"start": 51.03, "end": 60.58, "text": "你倒是不知所谓"}, {"start": 60.58, "end": 61.26, "text": "之下"}, {"start": 61.26, "end": 64.94, "text": "住手"}, {"start": 64.94, "end": 65.7, "text": "不行"}, {"start": 65.7, "end": 70.79, "text": "这怨气太重了"}, {"start": 70.79, "end": 71.11, "text": "桀花"}, {"start": 71.11, "end": 71.63, "text": "桀花"}, {"start": 71.63, "end": 78.1, "text": "快出来"}, {"start": 78.1, "end": 78.54, "text": "吴艾"}, {"start": 78.54, "end": 79.7, "text": "扶到床上去"}, {"start": 79.7, "end": 81.5, "text": "她害你自有报应"}, {"start": 81.5, "end": 83.02, "text": "可你害了活人性命"}, {"start": 83.02, "end": 84.54, "text": "就再不能入轮回"}, {"start": 84.54, "end": 85.98, "text": "为何要把自己搭上"}, {"start": 85.98, "end": 87.38, "text": "你说的倒是轻松"}, {"start": 87.38, "end": 88.62, "text": "你被你自己妈杀了"}, {"start": 88.62, "end": 90.07, "text": "试试"}, {"start": 90.07, "end": 90.67, "text": "之下"}, {"start": 90.67, "end": 91.71, "text": "小时候你发烧"}, {"start": 91.71, "end": 92.87, "text": "哥背着你跑去刮损"}, {"start": 92.87, "end": 93.87, "text": "一晚上没喝眼"}, {"start": 93.87, "end": 94.55, "text": "哥总想"}, {"start": 94.55, "end": 96.31, "text": "为什么生病的不是我"}, {"start": 96.31, "end": 97.03, "text": "别因为妈"}, {"start": 97.03, "end": 98.71, "text": "浪费你往生的机会"}, {"start": 98.71, "end": 99.71, "text": "哥还想遇见你"}, {"start": 99.71, "end": 100.55, "text": "你头胎就头到"}, {"start": 100.55, "end": 101.43, "text": "你嫂子肚子里"}, {"start": 101.43, "end": 102.67, "text": "把哥养你"}, {"start": 102.67, "end": 103.07, "text": "承诺"}, {"start": 103.07, "end": 103.51, "text": "哥"}, {"start": 103.51, "end": 104.51, "text": "我知道了"}]}