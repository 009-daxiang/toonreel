{"file": "东北异事之出马诡堂-第21集.mp4", "ep": 21, "duration": 53.9, "segments": [{"start": 0.0, "end": 1.92, "text": "我那傻弟弟不想让这孩子出"}, {"start": 1.92, "end": 2.92, "text": "疯了一部分"}, {"start": 2.92, "end": 4.36, "text": "立完堂口会全部通开"}, {"start": 4.36, "end": 4.92, "text": "好"}, {"start": 4.92, "end": 6.68, "text": "恭请鬼王回府"}, {"start": 7.27, "end": 7.91, "text": "二姑奶"}, {"start": 8.39, "end": 8.91, "text": "再见"}, {"start": 9.27, "end": 14.98, "text": "都是上堂口的鬼将"}, {"start": 17.24, "end": 18.52, "text": "这就是我的堂单"}, {"start": 20.81, "end": 22.45, "text": "你二姑奶把你身上的窍"}, {"start": 22.45, "end": 23.37, "text": "全通了一遍"}, {"start": 23.85, "end": 24.73, "text": "从今天起"}, {"start": 25.09, "end": 26.53, "text": "你就是鬼堂的接班人"}, {"start": 26.93, "end": 27.37, "text": "走"}, {"start": 27.81, "end": 29.89, "text": "跟我去灵县长长见识"}, {"start": 30.69, "end": 31.25, "text": "爷爷"}, {"start": 32.1, "end": 33.26, "text": "这堂口我接了"}, {"start": 33.99, "end": 34.83, "text": "我总觉得"}, {"start": 35.03, "end": 35.95, "text": "我还会回来"}, {"start": 36.47, "end": 36.83, "text": "给"}, {"start": 37.11, "end": 37.55, "text": "看看"}, {"start": 38.35, "end": 39.59, "text": "黄皮子换命"}, {"start": 39.59, "end": 40.67, "text": "黄皮子换命"}, {"start": 41.07, "end": 42.91, "text": "这声音是我身体里冒出来的"}, {"start": 43.76, "end": 45.92, "text": "这是咱们到灵县要办的第一件事"}, {"start": 46.7, "end": 47.22, "text": "小铁"}, {"start": 47.74, "end": 48.58, "text": "欢迎入行"}, {"start": 49.28, "end": 50.2, "text": "这才刚入行"}, {"start": 50.92, "end": 52.84, "text": "就要去看一个被黄皮子所命的人"}]}