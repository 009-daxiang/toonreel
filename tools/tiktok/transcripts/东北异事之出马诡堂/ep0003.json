{"file": "东北异事之出马诡堂-第3集.mp4", "ep": 3, "duration": 76.7, "segments": [{"start": 2.86, "end": 4.46, "text": "来 喝一杯"}, {"start": 4.46, "end": 6.74, "text": "坐"}, {"start": 6.74, "end": 8.54, "text": "这酒是你爹给你留的"}, {"start": 8.54, "end": 10.43, "text": "喝了就暖和了"}, {"start": 10.43, "end": 12.43, "text": "不行 不能喝"}, {"start": 12.43, "end": 13.83, "text": "喝了我就回不去了"}, {"start": 13.83, "end": 15.63, "text": "业障 给我住手"}, {"start": 15.63, "end": 17.23, "text": "喝 为什么不喝"}, {"start": 17.23, "end": 19.99, "text": "快给我喝"}, {"start": 19.99, "end": 21.79, "text": "妈 咋在哭"}, {"start": 21.79, "end": 24.04, "text": "外面出啥事了"}, {"start": 24.04, "end": 29.36, "text": "小蝶 你爹没了"}, {"start": 29.36, "end": 32.16, "text": "那是啥 爹和爷爷呢"}, {"start": 32.16, "end": 37.36, "text": "这咋还睁着眼睛呢"}, {"start": 37.36, "end": 40.1, "text": "老周呢 还没回来"}, {"start": 40.1, "end": 42.9, "text": "那么潜的水坑 咋能淹死呢"}, {"start": 44.06, "end": 47.11, "text": "蝶子 爹就出门一天"}, {"start": 47.11, "end": 50.98, "text": "你咋就"}, {"start": 50.98, "end": 53.18, "text": "横死之人 停领一晚"}, {"start": 53.18, "end": 57.18, "text": "明天一早 概官入土"}, {"start": 57.18, "end": 59.38, "text": "这本来是我给自己准备的"}, {"start": 59.38, "end": 60.98, "text": "都怪爹疏忽"}, {"start": 60.98, "end": 63.18, "text": "还是让他们找到了机会"}, {"start": 63.18, "end": 65.58, "text": "而啊 爹对不起你"}, {"start": 65.58, "end": 68.58, "text": "火喷鞭 咋围了一圈黑影"}, {"start": 68.58, "end": 76.16, "text": "他们到底是什么"}]}