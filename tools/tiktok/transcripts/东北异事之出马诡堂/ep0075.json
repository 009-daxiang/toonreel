{"file": "东北异事之出马诡堂-第75集.mp4", "ep": 75, "duration": 115.1, "segments": [{"start": 0.0, "end": 0.96, "text": "还有一件事"}, {"start": 2.03, "end": 3.03, "text": "他媳妇的死"}, {"start": 3.66, "end": 4.58, "text": "也是他气的"}, {"start": 5.25, "end": 5.97, "text": "说清楚"}, {"start": 6.17, "end": 7.89, "text": "那年讨债的追到家里"}, {"start": 8.17, "end": 9.09, "text": "他躲出去了"}, {"start": 9.72, "end": 11.64, "text": "人家把他媳妇堵在堂屋里骂"}, {"start": 12.0, "end": 13.28, "text": "人第二天就没了"}, {"start": 14.5, "end": 14.98, "text": "爸"}, {"start": 15.3, "end": 16.26, "text": "我错了"}, {"start": 16.46, "end": 18.1, "text": "我给你割头"}, {"start": 18.34, "end": 19.42, "text": "你打死我吧"}, {"start": 19.42, "end": 20.58, "text": "打死我我也认"}, {"start": 20.58, "end": 21.62, "text": "下面查过了"}, {"start": 21.62, "end": 22.58, "text": "话都是真的"}, {"start": 22.58, "end": 23.46, "text": "英国两清"}, {"start": 23.46, "end": 23.94, "text": "老爷子"}, {"start": 23.94, "end": 25.1, "text": "你还有啥放不下的"}, {"start": 25.26, "end": 25.9, "text": "春香"}, {"start": 27.26, "end": 28.3, "text": "我走了快十年"}, {"start": 28.3, "end": 29.66, "text": "我就想再看她一眼"}, {"start": 32.56, "end": 33.36, "text": "春香姨"}, {"start": 33.72, "end": 35.24, "text": "我替我爸来看看你"}, {"start": 37.14, "end": 38.06, "text": "进屋吧"}, {"start": 40.94, "end": 42.74, "text": "昨晚上我梦见她了"}, {"start": 43.58, "end": 44.78, "text": "她跟我说疼"}, {"start": 45.54, "end": 47.18, "text": "她真是这么走的"}, {"start": 47.97, "end": 49.33, "text": "她以前跟我说"}, {"start": 49.77, "end": 51.89, "text": "等老了就回乡下住"}, {"start": 52.53, "end": 53.05, "text": "春香姨"}, {"start": 53.05, "end": 54.05, "text": "我给你割个头"}, {"start": 54.25, "end": 55.73, "text": "往后你的事就是我的事"}, {"start": 56.21, "end": 57.45, "text": "我给你养老送中"}, {"start": 57.77, "end": 61.36, "text": "往后清明"}, {"start": 62.03, "end": 64.47, "text": "你陪我去她坟上说说话"}, {"start": 67.1, "end": 67.94, "text": "你眼睛咋了"}, {"start": 69.12, "end": 70.0, "text": "我爸打的"}, {"start": 70.76, "end": 71.68, "text": "我晚上烧的纸儿"}, {"start": 71.68, "end": 72.52, "text": "她还嫌丑"}, {"start": 73.0, "end": 74.36, "text": "让我重烧两个好看的"}, {"start": 75.46, "end": 76.54, "text": "人到了那边"}, {"start": 76.74, "end": 77.74, "text": "也是要脸的"}, {"start": 79.17, "end": 79.73, "text": "小子"}, {"start": 79.73, "end": 80.49, "text": "烧个话"}, {"start": 80.49, "end": 82.05, "text": "一个月内上引秀山"}, {"start": 82.05, "end": 83.73, "text": "那有你的缘分在等你"}, {"start": 84.58, "end": 85.34, "text": "谁烧的"}, {"start": 85.34, "end": 86.02, "text": "你甭问"}, {"start": 86.02, "end": 86.98, "text": "去了就知道"}, {"start": 90.92, "end": 92.64, "text": "我爸不行了"}, {"start": 93.0, "end": 97.67, "text": "毒气没下气"}, {"start": 97.67, "end": 100.07, "text": "医生说不肿了"}, {"start": 102.03, "end": 103.63, "text": "证书受数还有三年"}, {"start": 103.63, "end": 105.23, "text": "是被人告到地府去了"}, {"start": 105.23, "end": 106.51, "text": "阴差把魂拘了"}, {"start": 106.79, "end": 108.86, "text": "小铁"}, {"start": 109.18, "end": 111.54, "text": "你把老郑给我领回来"}, {"start": 111.7, "end": 113.94, "text": "这会儿得走音"}]}