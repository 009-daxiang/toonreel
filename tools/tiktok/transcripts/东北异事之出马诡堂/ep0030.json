{"file": "东北异事之出马诡堂-第30集.mp4", "ep": 30, "duration": 68.6, "segments": [{"start": 1.23, "end": 2.03, "text": "哥"}, {"start": 2.43, "end": 4.43, "text": "是高俊对不住你"}, {"start": 5.09, "end": 7.69, "text": "以后逢年过节我都去看你"}, {"start": 7.69, "end": 10.09, "text": "再不行我再加给你立个牌位"}, {"start": 10.09, "end": 12.09, "text": "出一食物给你上购"}, {"start": 12.09, "end": 12.69, "text": "李明"}, {"start": 12.69, "end": 13.69, "text": "你若信我"}, {"start": 13.69, "end": 15.09, "text": "此事我定给你个公道"}, {"start": 15.09, "end": 16.89, "text": "高俊这条命就放他收金吧"}, {"start": 16.89, "end": 18.89, "text": "你已经把他的腿磨出实病了"}, {"start": 18.89, "end": 20.09, "text": "以后有他罪受"}, {"start": 21.58, "end": 22.78, "text": "他还有个要求"}, {"start": 22.78, "end": 23.98, "text": "要个房子"}, {"start": 23.98, "end": 25.58, "text": "在人间游荡没地方呆"}, {"start": 30.62, "end": 32.42, "text": "以后看得多了就麻木了"}, {"start": 33.05, "end": 34.45, "text": "他们都说鬼可怕"}, {"start": 34.85, "end": 36.65, "text": "但更可怕的是人心"}, {"start": 40.15, "end": 42.74, "text": "老刘"}, {"start": 42.94, "end": 44.14, "text": "那是人家的事"}, {"start": 44.58, "end": 45.78, "text": "咱们管不着"}, {"start": 46.38, "end": 48.39, "text": "刘师傅"}, {"start": 48.39, "end": 49.59, "text": "你说我有结结囊种"}, {"start": 49.59, "end": 50.79, "text": "我查了还真有"}, {"start": 50.79, "end": 52.59, "text": "可这玩意儿是我有你才说的"}, {"start": 52.59, "end": 53.99, "text": "还是你说我才有的"}, {"start": 54.19, "end": 55.79, "text": "你家祖坟签过是吧"}, {"start": 55.79, "end": 56.19, "text": "对呀"}, {"start": 56.19, "end": 58.39, "text": "难道我长囊种跟祖坟有关系"}, {"start": 58.39, "end": 59.19, "text": "没关系"}, {"start": 59.19, "end": 61.19, "text": "但你这脑子跟祖坟有关系"}, {"start": 61.19, "end": 61.79, "text": "实在不行"}, {"start": 61.79, "end": 63.39, "text": "下次去医院挂个脑科吧"}, {"start": 64.39, "end": 65.79, "text": "挂个脑科"}]}