{"file": "东北异事之出马诡堂-第95集.mp4", "ep": 95, "duration": 65.9, "segments": [{"start": 1.84, "end": 3.64, "text": "占了两天了"}, {"start": 3.64, "end": 5.94, "text": "谁过去看谁"}, {"start": 7.62, "end": 9.02, "text": "哪位师傅在呀"}, {"start": 9.02, "end": 10.65, "text": "出来护护我呀"}, {"start": 10.65, "end": 12.65, "text": "我可是肉体繁胎呀"}, {"start": 12.65, "end": 18.3, "text": "沈海英"}, {"start": 18.3, "end": 19.5, "text": "把刀放下"}, {"start": 19.5, "end": 20.7, "text": "再不听话"}, {"start": 20.7, "end": 22.1, "text": "大嘴巴子抽你"}, {"start": 22.1, "end": 25.22, "text": "哎呦对嘛"}, {"start": 25.22, "end": 26.42, "text": "这真行啊"}, {"start": 26.42, "end": 28.82, "text": "小铁几句话就让海英放下刀了"}, {"start": 28.82, "end": 31.22, "text": "小铁这堂子上老馅儿真厉害呀"}, {"start": 31.22, "end": 51.43, "text": "香被劫了"}, {"start": 51.43, "end": 53.23, "text": "有人在挡我的香"}, {"start": 53.23, "end": 57.38, "text": "他有堂口"}, {"start": 57.38, "end": 59.18, "text": "挡住了你的香"}, {"start": 59.58, "end": 60.78, "text": "你出去"}, {"start": 60.78, "end": 62.38, "text": "哪来的野路子"}, {"start": 62.38, "end": 63.78, "text": "走就走"}]}