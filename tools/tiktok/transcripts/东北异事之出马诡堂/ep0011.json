{"file": "东北异事之出马诡堂-第11集.mp4", "ep": 11, "duration": 111.0, "segments": [{"start": 0.0, "end": 0.88, "text": "我要出趟門"}, {"start": 2.32, "end": 3.8, "text": "等你十八歲生日那天"}, {"start": 3.8, "end": 5.0, "text": "爺爺就回來"}, {"start": 5.0, "end": 7.08, "text": "到時候給你個特別的生日禮物"}, {"start": 7.08, "end": 7.92, "text": "爺爺"}, {"start": 7.92, "end": 9.56, "text": "你總出遠門到底去哪兒"}, {"start": 9.56, "end": 11.2, "text": "我跟著你不行嗎"}, {"start": 11.2, "end": 12.68, "text": "幹咱們這行"}, {"start": 12.68, "end": 14.2, "text": "別幹什麼都跑跟問點"}, {"start": 14.2, "end": 14.96, "text": "我知道"}, {"start": 14.96, "end": 15.84, "text": "你走了我就回家"}, {"start": 15.84, "end": 16.52, "text": "不來紮紙鋪"}, {"start": 16.52, "end": 17.28, "text": "不私自接活"}, {"start": 17.28, "end": 20.1, "text": "不出遠門不亂跑"}, {"start": 20.1, "end": 22.25, "text": "爺爺從來沒失過約"}, {"start": 22.25, "end": 26.85, "text": "這次咋心裡這麼不踏實"}, {"start": 26.85, "end": 28.57, "text": "菜熱了三回"}, {"start": 28.57, "end": 30.01, "text": "天都黑了"}, {"start": 30.01, "end": 35.74, "text": "爺爺咋還不回來"}, {"start": 35.74, "end": 36.82, "text": "小鐵"}, {"start": 36.82, "end": 39.91, "text": "是爺爺錯了"}, {"start": 39.91, "end": 42.87, "text": "爺爺沒辦法再陪著你了"}, {"start": 42.87, "end": 48.5, "text": "小鐵以後要健康長大"}, {"start": 48.5, "end": 49.58, "text": "爺爺"}, {"start": 49.58, "end": 50.9, "text": "爺爺你別嚇我"}, {"start": 50.9, "end": 56.79, "text": "你怎麼了"}, {"start": 56.79, "end": 57.86, "text": "是夢"}, {"start": 57.86, "end": 59.66, "text": "可這夢咋這麼真"}, {"start": 59.66, "end": 60.66, "text": "爺爺"}, {"start": 60.66, "end": 64.83, "text": "你到底在哪兒"}, {"start": 64.83, "end": 66.35, "text": "請問這裡是周建社家嗎"}, {"start": 66.35, "end": 66.71, "text": "對"}, {"start": 66.71, "end": 67.91, "text": "我是他孫子"}, {"start": 67.91, "end": 68.63, "text": "咋了"}, {"start": 68.63, "end": 69.75, "text": "你家大人呢"}, {"start": 69.75, "end": 71.07, "text": "讓他們出來一下"}, {"start": 71.07, "end": 72.19, "text": "家裡就剩我一個"}, {"start": 72.19, "end": 74.18, "text": "姐"}, {"start": 74.18, "end": 76.14, "text": "你爺爺就一個溺水小孩"}, {"start": 76.14, "end": 77.54, "text": "把孩子拖上來"}, {"start": 77.54, "end": 78.78, "text": "自己體力不支"}, {"start": 78.78, "end": 79.42, "text": "走了"}, {"start": 79.42, "end": 87.09, "text": "都是因為我們家孩子"}, {"start": 87.09, "end": 88.49, "text": "你在虛情假意什麼"}, {"start": 88.49, "end": 91.01, "text": "不是你家孩子是我爺爺死"}, {"start": 91.01, "end": 92.09, "text": "你還我爺爺"}, {"start": 92.09, "end": 93.41, "text": "你怎麼不去死啊"}, {"start": 95.01, "end": 96.05, "text": "柔家小的逆死"}, {"start": 96.05, "end": 96.85, "text": "老的也逆死"}, {"start": 96.85, "end": 98.45, "text": "沒准都是周鐵客"}, {"start": 98.45, "end": 99.45, "text": "你們說什麼"}, {"start": 99.45, "end": 100.65, "text": "再說一遍"}, {"start": 109.0, "end": 110.44, "text": "你到底要改什麼"}]}