{"file": "东北异事之出马诡堂-第63集.mp4", "ep": 63, "duration": 95.1, "segments": [{"start": 2.58, "end": 4.5, "text": "老刘 开车慢点"}, {"start": 11.56, "end": 12.48, "text": "这是讨风"}, {"start": 12.6, "end": 13.56, "text": "这都什么年代了"}, {"start": 13.56, "end": 14.88, "text": "还有黄皮子讨风"}, {"start": 15.04, "end": 16.56, "text": "修行哪能投机去抢"}, {"start": 16.96, "end": 18.36, "text": "说他向人讨风失败"}, {"start": 18.36, "end": 19.08, "text": "他得怨我"}, {"start": 19.08, "end": 20.0, "text": "说他向神"}, {"start": 20.2, "end": 21.0, "text": "将来遭了雷劫"}, {"start": 21.0, "end": 22.12, "text": "还不得算我头上"}, {"start": 22.28, "end": 23.16, "text": "不理他就是了"}, {"start": 24.98, "end": 25.78, "text": "有话好好说"}, {"start": 25.78, "end": 27.1, "text": "你先下来 我不走了"}, {"start": 27.66, "end": 30.37, "text": "你到底想干啥"}, {"start": 33.6, "end": 34.64, "text": "别碰他真身"}, {"start": 34.64, "end": 35.44, "text": "他刚得到"}, {"start": 35.44, "end": 36.68, "text": "还不会开口说话"}, {"start": 36.8, "end": 38.12, "text": "现在原神出窍了"}, {"start": 38.12, "end": 39.72, "text": "这样你就能跟他沟通了"}, {"start": 39.72, "end": 40.72, "text": "但要粘了人气"}, {"start": 40.72, "end": 41.64, "text": "他就回不去了"}, {"start": 41.64, "end": 43.76, "text": "小相同 帮帮我"}, {"start": 44.48, "end": 45.76, "text": "敢问老仙明慧"}, {"start": 45.76, "end": 47.44, "text": "今日来我 有何所求"}, {"start": 47.44, "end": 48.64, "text": "无名高山"}, {"start": 48.64, "end": 50.44, "text": "小相同 莫惊慌"}, {"start": 50.44, "end": 52.96, "text": "今日前来 确有一事相求"}, {"start": 55.18, "end": 57.14, "text": "老仙 我也不会致病啊"}, {"start": 57.14, "end": 59.1, "text": "要不我带您老去宠物医院看看"}, {"start": 59.82, "end": 61.3, "text": "黄大锤我舌头怎么麻了"}, {"start": 61.3, "end": 62.26, "text": "你礼貌吗"}, {"start": 62.26, "end": 63.66, "text": "小相同说的也在里"}, {"start": 63.66, "end": 64.78, "text": "可我求的不是这个"}, {"start": 64.78, "end": 65.74, "text": "还往仙家名誓"}, {"start": 65.74, "end": 68.22, "text": "我与妻女同住周家村后山"}, {"start": 68.22, "end": 69.74, "text": "前些日子出动找吃事"}, {"start": 69.74, "end": 70.9, "text": "被老鹰盯上"}, {"start": 70.9, "end": 72.06, "text": "尾巴被叼住"}, {"start": 72.06, "end": 74.3, "text": "我脑瞎了他一只眼才掉下来"}, {"start": 74.3, "end": 75.82, "text": "这真身不能要了"}, {"start": 75.86, "end": 78.06, "text": "后山 那是藏山"}, {"start": 78.06, "end": 79.02, "text": "传说里那个贪官"}, {"start": 79.02, "end": 80.46, "text": "带着金银宰宝躲进去"}, {"start": 80.46, "end": 81.38, "text": "再没出来过的地方"}, {"start": 81.38, "end": 82.54, "text": "我回不去了"}, {"start": 82.54, "end": 83.42, "text": "只求在这山中"}, {"start": 83.42, "end": 85.18, "text": "给他们母女重新安排个地方"}, {"start": 85.18, "end": 85.98, "text": "不用你养"}, {"start": 85.98, "end": 90.42, "text": "行 这忙我帮"}, {"start": 90.42, "end": 91.86, "text": "别急 天这么黑"}, {"start": 91.86, "end": 92.7, "text": "看不见路"}, {"start": 92.7, "end": 94.42, "text": "我先回去拿个手电筒"}]}