{"file": "东北异事之出马诡堂-第4集.mp4", "ep": 4, "duration": 100.2, "segments": [{"start": 1.23, "end": 3.23, "text": "別怕,有爺爺在,睡吧"}, {"start": 3.23, "end": 5.23, "text": "這把剪刀跟了我一輩子"}, {"start": 5.23, "end": 7.23, "text": "震得住那些東西"}, {"start": 7.23, "end": 14.44, "text": "這剪刀"}, {"start": 14.44, "end": 16.44, "text": "他們怕他"}, {"start": 16.44, "end": 19.37, "text": "爹嚇葬了"}, {"start": 19.37, "end": 22.46, "text": "爺爺和媽呢"}, {"start": 22.46, "end": 23.46, "text": "爺爺我媽呢"}, {"start": 23.46, "end": 24.46, "text": "小俠"}, {"start": 24.46, "end": 27.29, "text": "他去外地打工了"}, {"start": 27.29, "end": 28.29, "text": "去很遠的地方"}, {"start": 28.29, "end": 29.29, "text": "那他啥時候回來"}, {"start": 29.29, "end": 30.29, "text": "等你長大了"}, {"start": 30.29, "end": 31.29, "text": "他就回來了"}, {"start": 31.29, "end": 32.29, "text": "這婆娘就這樣"}, {"start": 32.29, "end": 33.29, "text": "扔下孩子走了"}, {"start": 33.29, "end": 35.29, "text": "我該怎麼跟小鐵開口"}, {"start": 36.29, "end": 37.29, "text": "鐵哥"}, {"start": 37.29, "end": 38.29, "text": "老實說明天考試"}, {"start": 38.29, "end": 39.29, "text": "咱倆逃課不好吧"}, {"start": 40.54, "end": 41.54, "text": "那咋了"}, {"start": 42.54, "end": 44.54, "text": "你去前面路邊攤處等我"}, {"start": 44.54, "end": 45.54, "text": "我去趟廁所"}, {"start": 45.54, "end": 50.03, "text": "不好意思哥們"}, {"start": 50.03, "end": 51.03, "text": "我不知道裡面有人"}, {"start": 51.03, "end": 55.94, "text": "隔著一處幹啥呢"}, {"start": 55.94, "end": 56.94, "text": "裡面有"}, {"start": 56.94, "end": 62.42, "text": "剛才不是在隔間裡嗎"}, {"start": 62.42, "end": 65.98, "text": "胖子"}, {"start": 65.98, "end": 66.98, "text": "快走"}, {"start": 66.98, "end": 67.98, "text": "有鬼"}, {"start": 69.52, "end": 70.52, "text": "啥鬼啊鐵哥"}, {"start": 70.52, "end": 71.52, "text": "鬼不存在的"}, {"start": 71.52, "end": 76.26, "text": "騙你的"}, {"start": 76.26, "end": 77.26, "text": "膽小鬼"}, {"start": 80.44, "end": 81.44, "text": "周鐵"}, {"start": 81.44, "end": 82.44, "text": "你小子又跑哪耍去了"}, {"start": 82.44, "end": 83.44, "text": "劉叔"}, {"start": 83.44, "end": 84.44, "text": "我倆這不回來了嗎"}, {"start": 84.44, "end": 85.44, "text": "放我們進去吧"}, {"start": 89.1, "end": 90.1, "text": "你倆進來可以"}, {"start": 90.1, "end": 91.16, "text": "他不行"}, {"start": 91.16, "end": 92.42, "text": "劉叔"}, {"start": 92.42, "end": 93.42, "text": "就我倆呀"}, {"start": 93.42, "end": 94.42, "text": "他"}, {"start": 94.42, "end": 95.42, "text": "誰呀"}, {"start": 95.42, "end": 96.42, "text": "你身後那個"}, {"start": 96.42, "end": 97.54, "text": "廁所的會議人"}, {"start": 97.54, "end": 98.54, "text": "跟你回來了"}]}