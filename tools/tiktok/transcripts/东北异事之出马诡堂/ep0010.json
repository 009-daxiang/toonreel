{"file": "东北异事之出马诡堂-第10集.mp4", "ep": 10, "duration": 81.2, "segments": [{"start": 0.0, "end": 1.32, "text": "整栋楼就我一个"}, {"start": 1.72, "end": 2.72, "text": "正好清静"}, {"start": 12.38, "end": 13.06, "text": "谁呀"}, {"start": 13.06, "end": 14.5, "text": "大半夜不睡觉搞什么"}, {"start": 14.86, "end": 18.93, "text": "五日处决"}, {"start": 18.93, "end": 20.29, "text": "强盗杀人犯王真"}, {"start": 20.29, "end": 21.09, "text": "不是幻觉"}, {"start": 21.29, "end": 23.25, "text": "那牌子上的字我看得清清楚楚"}, {"start": 23.81, "end": 42.69, "text": "三楼"}, {"start": 42.69, "end": 43.77, "text": "是鬼大墙"}, {"start": 44.05, "end": 45.77, "text": "爷爷讲过走不出去的"}, {"start": 56.52, "end": 58.08, "text": "老子什么都不怕"}, {"start": 58.32, "end": 59.56, "text": "半天进来"}, {"start": 63.2, "end": 64.32, "text": "我想回家"}, {"start": 65.93, "end": 66.53, "text": "爷爷"}, {"start": 67.01, "end": 67.97, "text": "宿舍有鬼"}, {"start": 68.17, "end": 69.49, "text": "拿着铁链追我"}, {"start": 70.14, "end": 71.58, "text": "我再也不去上学了"}, {"start": 71.58, "end": 72.38, "text": "别害怕"}, {"start": 72.62, "end": 73.62, "text": "很快就好了"}, {"start": 74.06, "end": 75.82, "text": "爷爷会把这些都处理好的"}, {"start": 75.82, "end": 76.5, "text": "孙儿啊"}, {"start": 77.44, "end": 78.52, "text": "这书咱不念了"}, {"start": 78.52, "end": 79.84, "text": "明天跟爷爷学扎址"}]}