{"file": "东北异事之出马诡堂-第2集.mp4", "ep": 2, "duration": 96.7, "segments": [{"start": 0.0, "end": 1.48, "text": "感谢仙家救助"}, {"start": 1.48, "end": 4.08, "text": "蓝无常留我孙儿一命"}, {"start": 4.08, "end": 6.24, "text": "我会将蛇蛇好好安葬"}, {"start": 6.24, "end": 10.05, "text": "仙家若有所需可入梦告知"}, {"start": 10.05, "end": 12.9, "text": "爹 这黑忙咋回事"}, {"start": 12.9, "end": 14.82, "text": "他是来救咱家娃的"}, {"start": 14.82, "end": 16.98, "text": "别废话 快把蛇蛇埋了"}, {"start": 16.98, "end": 19.1, "text": "爹 这医院子得拉多少趟啊"}, {"start": 19.1, "end": 19.74, "text": "别闲累"}, {"start": 19.74, "end": 20.82, "text": "好好拉到后山娃坑埋了"}, {"start": 20.82, "end": 26.19, "text": "别留印子"}, {"start": 26.19, "end": 29.32, "text": "发烧了 快跟我去县城"}, {"start": 29.32, "end": 31.75, "text": "刚出生就被无常盯上了"}, {"start": 31.75, "end": 35.28, "text": "这娃的命怕是轻啊"}, {"start": 35.28, "end": 36.56, "text": "无常所命"}, {"start": 36.56, "end": 37.56, "text": "仙家住"}, {"start": 37.56, "end": 38.68, "text": "体弱多病"}, {"start": 38.68, "end": 40.08, "text": "命格轻"}, {"start": 40.08, "end": 41.6, "text": "大妹子能看出这娃的毛病"}, {"start": 41.6, "end": 42.4, "text": "能不能破解一下"}, {"start": 42.4, "end": 43.6, "text": "多少钱都行"}, {"start": 43.6, "end": 44.56, "text": "娃娶名妹"}, {"start": 44.56, "end": 45.28, "text": "娶了"}, {"start": 45.28, "end": 45.96, "text": "姓周"}, {"start": 45.96, "end": 46.68, "text": "叫天顺"}, {"start": 46.68, "end": 47.6, "text": "改名吧"}, {"start": 47.6, "end": 48.76, "text": "单名一个铁"}, {"start": 48.76, "end": 49.84, "text": "铁鼠扬金"}, {"start": 49.84, "end": 50.68, "text": "这娃八字轻"}, {"start": 50.68, "end": 51.6, "text": "命格吉音"}, {"start": 51.6, "end": 52.8, "text": "正好压制"}, {"start": 52.8, "end": 53.88, "text": "这娃"}, {"start": 53.88, "end": 57.74, "text": "可以接下你饭碗啊"}, {"start": 57.74, "end": 59.02, "text": "人却没了"}, {"start": 59.02, "end": 61.27, "text": "难道是我出现幻觉了"}, {"start": 61.27, "end": 65.34, "text": "感谢仙人指点没击"}, {"start": 65.34, "end": 65.9, "text": "小铁"}, {"start": 65.9, "end": 67.02, "text": "爷爷去县城送货"}, {"start": 67.02, "end": 68.02, "text": "回来给你带玩具"}, {"start": 68.02, "end": 69.5, "text": "在家听话别乱跑"}, {"start": 69.5, "end": 71.06, "text": "天黑前爷爷就回来"}, {"start": 71.06, "end": 72.78, "text": "爷爷我要个小汽车"}, {"start": 72.78, "end": 74.06, "text": "你又做什么"}, {"start": 74.06, "end": 75.26, "text": "我去县城找活"}, {"start": 75.26, "end": 78.25, "text": "你总说我天天躺着啥也不干"}, {"start": 78.25, "end": 79.17, "text": "周杰"}, {"start": 79.17, "end": 83.86, "text": "你别以为我"}, {"start": 83.86, "end": 84.9, "text": "爹走了"}, {"start": 84.9, "end": 86.42, "text": "妈也走了"}, {"start": 86.42, "end": 88.17, "text": "又剩我一个"}, {"start": 88.17, "end": 89.13, "text": "好疼"}, {"start": 89.13, "end": 90.09, "text": "这感觉"}, {"start": 90.09, "end": 93.62, "text": "像有人钻住了我的心"}, {"start": 93.62, "end": 94.3, "text": "妈"}, {"start": 94.3, "end": 95.22, "text": "是你回来了吗"}, {"start": 95.22, "end": 95.82, "text": "妈"}]}