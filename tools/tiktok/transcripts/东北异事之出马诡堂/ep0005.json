{"file": "东北异事之出马诡堂-第5集.mp4", "ep": 5, "duration": 72.5, "segments": [{"start": 5.42, "end": 6.9, "text": "你没感觉到后背发尘"}, {"start": 7.02, "end": 7.86, "text": "腰发紧吗"}, {"start": 8.1, "end": 8.7, "text": "刘叔"}, {"start": 8.86, "end": 10.06, "text": "做久了腰酸而已"}, {"start": 10.18, "end": 10.78, "text": "再说了"}, {"start": 10.9, "end": 11.78, "text": "小孩哪有腰"}, {"start": 12.22, "end": 15.07, "text": "你自己摸摸这块地方"}, {"start": 15.07, "end": 16.03, "text": "是不是比别人凉"}, {"start": 16.47, "end": 17.19, "text": "是有点"}, {"start": 17.67, "end": 18.75, "text": "刘叔 你别吓我"}, {"start": 19.75, "end": 20.39, "text": "我问你"}, {"start": 20.95, "end": 21.94, "text": "你是不是见着一个"}, {"start": 21.94, "end": 22.86, "text": "穿灰色长袖"}, {"start": 22.86, "end": 24.02, "text": "体型雍肿的男人"}, {"start": 24.66, "end": 25.8, "text": "你咋知道的"}, {"start": 26.44, "end": 27.96, "text": "我还知道他现在在哪儿"}, {"start": 27.96, "end": 28.64, "text": "你信不信"}, {"start": 29.2, "end": 30.4, "text": "就在你后背趴着呢"}, {"start": 31.04, "end": 32.59, "text": "刘叔 你赶紧把他弄下去"}, {"start": 32.79, "end": 33.55, "text": "我害怕"}, {"start": 33.99, "end": 39.07, "text": "赶紧从孩子身上下来"}, {"start": 39.07, "end": 39.75, "text": "要不然"}, {"start": 40.27, "end": 41.67, "text": "别怪老头子我动手了"}, {"start": 43.14, "end": 44.02, "text": "我数三个数"}, {"start": 49.03, "end": 49.95, "text": "你跟他干啥"}, {"start": 50.79, "end": 52.23, "text": "这孩子本来就体质虚"}, {"start": 52.59, "end": 53.15, "text": "你要啥"}, {"start": 53.51, "end": 54.31, "text": "烧个纸庙"}, {"start": 55.09, "end": 55.77, "text": "少废话"}, {"start": 55.89, "end": 57.21, "text": "你死跟孩子有什么关系"}, {"start": 57.65, "end": 58.49, "text": "行 你走吧"}, {"start": 59.23, "end": 60.75, "text": "等我烧金颗子的时候喊你"}, {"start": 63.58, "end": 64.54, "text": "烧完你再回来"}, {"start": 64.7, "end": 65.54, "text": "别怪我抽你"}, {"start": 65.78, "end": 66.22, "text": "刘叔"}, {"start": 66.86, "end": 67.94, "text": "你咋能跟他说话"}, {"start": 68.5, "end": 69.5, "text": "你到底是干啥的"}, {"start": 69.7, "end": 70.3, "text": "回去睡觉"}, {"start": 70.58, "end": 71.18, "text": "别问那么多"}]}