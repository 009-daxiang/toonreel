{"file": "东北异事之出马诡堂-第44集.mp4", "ep": 44, "duration": 100.1, "segments": [{"start": 0.53, "end": 2.13, "text": "这屋子冷得不像话"}, {"start": 8.57, "end": 9.41, "text": "她的窍"}, {"start": 9.73, "end": 10.69, "text": "全部被封了"}, {"start": 10.69, "end": 11.41, "text": "咋整的"}, {"start": 11.41, "end": 12.33, "text": "她立完堂口"}, {"start": 12.33, "end": 13.65, "text": "正常应该全身通窍"}, {"start": 13.65, "end": 14.85, "text": "可立完没多久就死了"}, {"start": 14.85, "end": 15.81, "text": "眼睛睁得老大"}, {"start": 15.81, "end": 16.77, "text": "全身窍还被封"}, {"start": 16.77, "end": 18.09, "text": "若她死前就被封了窍"}, {"start": 18.09, "end": 18.89, "text": "八九不立时"}, {"start": 18.89, "end": 20.09, "text": "是给她立堂口的人干的"}, {"start": 21.58, "end": 23.02, "text": "那她堂单上的老线呢"}, {"start": 23.02, "end": 23.86, "text": "堂单上有老线"}, {"start": 23.86, "end": 24.62, "text": "带过的气息"}, {"start": 24.62, "end": 25.82, "text": "要是气不过去讨说法"}, {"start": 25.82, "end": 26.66, "text": "那就麻烦了"}, {"start": 26.86, "end": 28.07, "text": "大师"}, {"start": 28.23, "end": 28.91, "text": "咋样"}, {"start": 29.07, "end": 30.07, "text": "好处理吗"}, {"start": 30.47, "end": 31.27, "text": "好处理"}, {"start": 31.88, "end": 32.48, "text": "走的时候"}, {"start": 32.48, "end": 33.88, "text": "我把堂单带走就行"}, {"start": 34.54, "end": 35.78, "text": "你闺女岁数不大"}, {"start": 35.78, "end": 36.82, "text": "咋突然就"}, {"start": 37.1, "end": 38.46, "text": "燕红之前精神不好"}, {"start": 38.46, "end": 39.66, "text": "隔段时间就发疯"}, {"start": 39.66, "end": 40.78, "text": "还走丢过一次"}, {"start": 40.98, "end": 42.18, "text": "我在林村找着她"}, {"start": 42.18, "end": 43.82, "text": "碰见个面声的女人"}, {"start": 43.82, "end": 45.7, "text": "说燕红这疯病能治"}, {"start": 45.7, "end": 46.74, "text": "立个堂口就行"}, {"start": 46.74, "end": 48.74, "text": "我瞒着儿子带燕红去立了堂"}, {"start": 48.74, "end": 50.54, "text": "立上之后燕红确实好了"}, {"start": 50.54, "end": 51.58, "text": "可没过两天"}, {"start": 51.58, "end": 53.14, "text": "半夜我听见一声惨叫"}, {"start": 53.14, "end": 54.14, "text": "燕红瞪大眼"}, {"start": 54.14, "end": 55.54, "text": "疯狂抓脑自己脖子"}, {"start": 55.54, "end": 57.42, "text": "眼睛直勾勾盯着那堂单"}, {"start": 57.42, "end": 58.58, "text": "没一会儿就走了"}, {"start": 58.98, "end": 60.18, "text": "那女人住哪儿"}, {"start": 60.18, "end": 61.14, "text": "就在林村"}, {"start": 61.14, "end": 62.02, "text": "姓陈"}, {"start": 62.02, "end": 63.7, "text": "人都叫她陈大神"}, {"start": 66.92, "end": 68.2, "text": "我们来找陈大神"}, {"start": 68.56, "end": 69.72, "text": "他好像不在家"}, {"start": 70.24, "end": 71.12, "text": "我就是"}, {"start": 71.12, "end": 71.96, "text": "进来吧"}, {"start": 72.84, "end": 73.68, "text": "陈大神"}, {"start": 73.68, "end": 75.6, "text": "今天来是想让你看看我儿子"}, {"start": 75.6, "end": 76.72, "text": "他最近老做噩梦"}, {"start": 76.72, "end": 77.6, "text": "岁数不大"}, {"start": 77.6, "end": 78.88, "text": "煞气倒不清"}, {"start": 78.88, "end": 79.88, "text": "姓名"}, {"start": 80.24, "end": 81.44, "text": "生辰霸字"}, {"start": 82.06, "end": 83.54, "text": "真能装毒子"}, {"start": 83.54, "end": 85.34, "text": "几十年修为的小黄仙"}, {"start": 85.34, "end": 86.78, "text": "都敢装大尾巴郎了"}, {"start": 87.34, "end": 88.5, "text": "我不知道啊"}, {"start": 88.5, "end": 89.46, "text": "爹你知道不"}, {"start": 89.46, "end": 90.58, "text": "我也不知道啊"}, {"start": 90.58, "end": 91.94, "text": "你生那天我可巴黎子呢"}, {"start": 91.94, "end": 92.94, "text": "你妈生完就走了"}, {"start": 92.94, "end": 93.94, "text": "你奶爸你带大的"}, {"start": 93.94, "end": 95.18, "text": "你奶前两年也走了"}, {"start": 95.18, "end": 96.46, "text": "没人告诉我呀"}, {"start": 96.46, "end": 97.26, "text": "这"}, {"start": 97.26, "end": 99.26, "text": "没有生辰霸字我可怎么看"}]}