end": 178.66, "text": "宿主在无法翻盘的级面下"}, {"start": 178.66, "end": 180.22, "text": "系统将判定任务失败"}, {"start": 180.22, "end": 182.18, "text": "先使你将当场心脏病发作"}, {"start": 182.18, "end": 183.38, "text": "一分钟内猝死"}, {"start": 184.97, "end": 186.05, "text": "那也比现在这种"}, {"start": 186.05, "end": 190.44, "text": "司法好受得多"}, {"start": 190.44, "end": 191.68, "text": "那就"}, {"start": 191.68, "end": 192.68, "text": "试试看吧"}]}