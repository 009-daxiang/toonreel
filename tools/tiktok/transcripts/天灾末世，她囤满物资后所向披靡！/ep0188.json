{"file": "天灾末世，她囤满物资后所向披靡！-第188集.mp4", "ep": 188, "duration": 47.0, "segments": [{"start": 0.0, "end": 0.68, "text": "我进去了"}, {"start": 1.08, "end": 1.6, "text": "好"}, {"start": 5.45, "end": 6.01, "text": "大姐"}, {"start": 6.33, "end": 6.85, "text": "你来了"}, {"start": 7.33, "end": 8.33, "text": "特意跑一趟干什么"}, {"start": 8.69, "end": 9.81, "text": "我抽空去开回来就行"}, {"start": 10.09, "end": 10.85, "text": "那都麻烦"}, {"start": 11.13, "end": 11.77, "text": "我给你送"}, {"start": 14.66, "end": 15.26, "text": "那你快进来"}, {"start": 19.36, "end": 19.76, "text": "清香"}, {"start": 20.04, "end": 20.6, "text": "你先等等"}, {"start": 20.88, "end": 21.64, "text": "我开完户就回来"}, {"start": 25.24, "end": 25.76, "text": "不用了"}, {"start": 26.08, "end": 26.76, "text": "我先到处走"}, {"start": 26.96, "end": 27.64, "text": "等下跟你们队长"}, {"start": 27.8, "end": 28.56, "text": "打个招呼就行"}, {"start": 28.88, "end": 29.44, "text": "你去忙"}, {"start": 33.35, "end": 33.75, "text": "大姐"}, {"start": 34.07, "end": 34.91, "text": "这是管理部证件"}, {"start": 35.03, "end": 35.59, "text": "有失量身份"}, {"start": 35.75, "end": 36.23, "text": "没人来你"}, {"start": 36.47, "end": 37.07, "text": "这个见着我们"}, {"start": 37.23, "end": 37.91, "text": "这个见着队长"}, {"start": 43.66, "end": 44.7, "text": "到处都是"}, {"start": 45.56, "end": 46.48, "text": "每一次"}]}