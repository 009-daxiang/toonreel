{"file": "天灾末世，她囤满物资后所向披靡！-第120集.mp4", "ep": 120, "duration": 47.0, "segments": [{"start": 0.0, "end": 1.4, "text": "你才居然撞上他了"}, {"start": 3.71, "end": 4.71, "text": "天生反骨"}, {"start": 5.41, "end": 6.81, "text": "随时会炸的活地雷"}, {"start": 7.21, "end": 8.21, "text": "杀了干净"}, {"start": 8.97, "end": 10.37, "text": "可这半丧失的身子"}, {"start": 10.77, "end": 11.57, "text": "我必须要"}, {"start": 11.97, "end": 12.57, "text": "行"}, {"start": 13.17, "end": 14.37, "text": "我同意你加入"}, {"start": 14.77, "end": 15.37, "text": "等等"}, {"start": 15.57, "end": 16.37, "text": "美女小姐姐"}, {"start": 16.57, "end": 17.57, "text": "我加入你们"}, {"start": 17.77, "end": 18.37, "text": "给我什么待遇"}, {"start": 18.57, "end": 19.37, "text": "最好的待遇"}, {"start": 19.57, "end": 20.77, "text": "跟着我 三餐有肉"}, {"start": 23.19, "end": 24.19, "text": "你基地有女人吗"}, {"start": 24.39, "end": 24.99, "text": "不 我是说"}, {"start": 25.19, "end": 26.19, "text": "你基地里有多少人"}, {"start": 26.39, "end": 26.79, "text": "就我"}, {"start": 26.99, "end": 27.79, "text": "还有徐少阳"}, {"start": 27.99, "end": 28.59, "text": "外面那个"}, {"start": 29.19, "end": 30.19, "text": "就你们俩"}, {"start": 30.59, "end": 31.39, "text": "她"}, {"start": 31.79, "end": 32.79, "text": "不是你男朋友吧"}, {"start": 32.79, "end": 33.39, "text": "不是"}, {"start": 34.28, "end": 34.88, "text": "那好"}, {"start": 35.93, "end": 36.73, "text": "我加入你"}, {"start": 37.13, "end": 40.7, "text": "初始才十九"}, {"start": 41.33, "end": 42.93, "text": "加满四十都不够六十"}, {"start": 45.18, "end": 46.98, "text": "徐少阳可是紫色的一百"}]}