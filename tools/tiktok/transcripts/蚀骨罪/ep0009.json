{"file": "蚀骨罪-第9集.mp4", "ep": 9, "duration": 74.7, "segments": [{"start": 4.34, "end": 5.46, "text": "转过身来"}, {"start": 6.85, "end": 7.85, "text": "再说一遍"}, {"start": 8.46, "end": 9.46, "text": "转过身来"}, {"start": 9.78, "end": 13.47, "text": "清 杰 宫 阿姨"}, {"start": 15.88, "end": 16.88, "text": "有好戏看了"}, {"start": 17.08, "end": 17.88, "text": "你闭嘴"}, {"start": 18.28, "end": 19.32, "text": "别打扰我看戏"}, {"start": 21.3, "end": 22.3, "text": "许久不见"}, {"start": 22.66, "end": 25.72, "text": "怎么不打声招呼吗"}, {"start": 25.92, "end": 28.97, "text": "沈先生"}, {"start": 29.82, "end": 30.82, "text": "什么时候出来的"}, {"start": 32.13, "end": 33.33, "text": "我知道你想说什么"}, {"start": 34.16, "end": 34.8, "text": "可以"}, {"start": 36.12, "end": 38.4, "text": "只要你把这瓶酒全部喝下去"}, {"start": 38.94, "end": 40.46, "text": "我就答应你的请求"}, {"start": 40.62, "end": 46.5, "text": "我的耐心有限"}, {"start": 46.66, "end": 54.03, "text": "求求你放我一会"}, {"start": 55.04, "end": 55.8, "text": "只要不让我喝酒"}, {"start": 55.8, "end": 57.0, "text": "让我干什么都行"}, {"start": 57.16, "end": 58.16, "text": "不过一瓶酒"}, {"start": 58.71, "end": 60.91, "text": "就为了不喝轻而易举就下跪"}, {"start": 61.11, "end": 65.26, "text": "曾经的张扬满身的"}, {"start": 65.26, "end": 67.14, "text": "傲气死死捍卫的尊严呢"}, {"start": 70.87, "end": 71.59, "text": "尊严"}, {"start": 72.76, "end": 74.52, "text": "尊严能让我活下去吗"}]}