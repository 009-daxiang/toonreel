{"file": "蚀骨罪-第16集.mp4", "ep": 16, "duration": 55.9, "segments": [{"start": 1.36, "end": 2.72, "text": "我只是行动痴怀"}, {"start": 3.2, "end": 4.24, "text": "并不是瘸子"}, {"start": 4.4, "end": 5.28, "text": "神经病吧你"}, {"start": 5.28, "end": 6.04, "text": "赶快走"}, {"start": 7.9, "end": 8.46, "text": "拿来"}, {"start": 8.46, "end": 9.3, "text": "你拿什么"}, {"start": 9.66, "end": 10.58, "text": "钱啊"}, {"start": 11.4, "end": 12.88, "text": "我这车被你做过了"}, {"start": 13.28, "end": 13.96, "text": "汇起"}, {"start": 14.36, "end": 15.08, "text": "得洗"}, {"start": 15.08, "end": 16.0, "text": "洗车不要钱"}, {"start": 16.32, "end": 16.92, "text": "一百块"}, {"start": 17.16, "end": 19.04, "text": "可是我"}, {"start": 19.04, "end": 20.24, "text": "我 我跟毛啊"}, {"start": 20.44, "end": 21.48, "text": "一百块 拿来"}, {"start": 32.26, "end": 33.26, "text": "你这闹哪一出"}, {"start": 33.26, "end": 34.62, "text": "快点 我快点"}, {"start": 34.94, "end": 40.43, "text": "给你救救你"}, {"start": 40.43, "end": 47.48, "text": "真他妈见鬼了"}, {"start": 47.68, "end": 49.14, "text": "今天没一件事顺的"}, {"start": 49.5, "end": 50.02, "text": "快"}, {"start": 50.66, "end": 52.06, "text": "这些人是来找你的吧"}, {"start": 52.42, "end": 53.02, "text": "你偷了"}, {"start": 53.02, "end": 54.42, "text": "还是抢了人家什么东西"}, {"start": 54.42, "end": 55.34, "text": "被人这么追"}]}