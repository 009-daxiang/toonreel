{"file": "蚀骨罪-第39集.mp4", "ep": 39, "duration": 56.0, "segments": [{"start": 0.0, "end": 0.8, "text": "会唱歌吧"}, {"start": 1.28, "end": 2.16, "text": "一手一个信封"}, {"start": 2.72, "end": 3.6, "text": "唱满五十首"}, {"start": 4.0, "end": 4.8, "text": "拿东西走人"}, {"start": 5.28, "end": 5.96, "text": "唱不满"}, {"start": 6.36, "end": 7.24, "text": "你知道后果"}, {"start": 8.04, "end": 8.92, "text": "是因为"}, {"start": 9.48, "end": 10.12, "text": "剑痛"}, {"start": 10.56, "end": 11.44, "text": "你怎么回来了"}, {"start": 11.8, "end": 12.56, "text": "病还没好"}, {"start": 13.12, "end": 13.8, "text": "孟姐"}, {"start": 14.6, "end": 15.68, "text": "我休息够了"}, {"start": 17.17, "end": 17.89, "text": "能不能"}, {"start": 18.73, "end": 19.93, "text": "拜托孟姐帮我看看"}, {"start": 19.93, "end": 21.21, "text": "有没有我能接的活"}, {"start": 22.24, "end": 22.64, "text": "我"}, {"start": 22.96, "end": 24.21, "text": "什么都能做"}, {"start": 27.44, "end": 28.08, "text": "我去看看"}, {"start": 29.38, "end": 30.06, "text": "孟姐"}, {"start": 30.62, "end": 31.78, "text": "谢谢你"}, {"start": 32.14, "end": 34.01, "text": "看错了"}, {"start": 34.66, "end": 35.46, "text": "她脸红了"}, {"start": 35.86, "end": 37.92, "text": "只是举手之狼而已啊"}, {"start": 38.86, "end": 39.66, "text": "一个人"}, {"start": 40.61, "end": 42.17, "text": "到底要有多么的卑微"}, {"start": 42.84, "end": 43.84, "text": "这内心的深处"}, {"start": 43.84, "end": 45.36, "text": "要有多么惶恐无助"}, {"start": 45.72, "end": 47.56, "text": "才能够因为这点举手之狼"}, {"start": 47.88, "end": 49.32, "text": "就脸红得不好意思"}, {"start": 49.32, "end": 50.76, "text": "忐忑不安的道歉"}, {"start": 50.96, "end": 53.74, "text": "神到底对这个傻女人"}, {"start": 53.74, "end": 54.58, "text": "做了什么"}]}