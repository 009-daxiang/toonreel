{"file": "蚀骨罪-第33集.mp4", "ep": 33, "duration": 51.6, "segments": [{"start": 3.18, "end": 4.02, "text": "你躲我"}, {"start": 4.22, "end": 6.56, "text": "我沒有躲 沈先生"}, {"start": 6.84, "end": 7.92, "text": "你的嗓子怎麼回事"}, {"start": 7.92, "end": 8.64, "text": "咬成這樣"}, {"start": 8.88, "end": 10.2, "text": "生病嗓子疼"}, {"start": 10.53, "end": 11.37, "text": "你怕我"}, {"start": 13.64, "end": 15.36, "text": "這傷疤哪兒來的"}, {"start": 15.52, "end": 16.36, "text": "可破的"}, {"start": 16.48, "end": 29.6, "text": "還是香橫那個混蛋刀"}, {"start": 41.88, "end": 42.8, "text": "你來做什麼"}, {"start": 43.33, "end": 45.37, "text": "一個電話讓我半小時買流石送過來的人"}, {"start": 45.37, "end": 46.73, "text": "反過來問我來幹什麼"}]}