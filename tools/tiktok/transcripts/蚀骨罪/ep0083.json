{"file": "蚀骨罪-第83集.mp4", "ep": 83, "duration": 55.1, "segments": [{"start": 0.37, "end": 1.57, "text": "我独一的时候"}, {"start": 1.97, "end": 3.17, "text": "实验课上第一次对着"}, {"start": 3.17, "end": 4.57, "text": "佛尔玛林里捞出来的标本"}, {"start": 4.57, "end": 6.37, "text": "做摘出深藏的手术练习"}, {"start": 7.38, "end": 8.78, "text": "刀口都没有那么长"}, {"start": 8.98, "end": 14.94, "text": "你心里不是已经猜到了吗"}, {"start": 15.14, "end": 16.72, "text": "你怪不了他们"}, {"start": 17.5, "end": 18.5, "text": "难道你不知道"}, {"start": 19.17, "end": 20.17, "text": "你对简童的态度"}, {"start": 20.17, "end": 21.57, "text": "你表现出来的意愿"}, {"start": 21.77, "end": 23.17, "text": "决定了那个可怜的女人"}, {"start": 23.17, "end": 24.57, "text": "这三年里的处境吗"}, {"start": 24.57, "end": 26.17, "text": "你今天看到的这道疤痕"}, {"start": 28.23, "end": 29.23, "text": "也许只是简童"}, {"start": 29.23, "end": 31.63, "text": "三年牢狱之灾中的冰山一角"}, {"start": 31.63, "end": 33.03, "text": "她还是简大小姐的时候"}, {"start": 33.03, "end": 34.83, "text": "你尚且不知道她所经历的事情"}, {"start": 35.23, "end": 36.99, "text": "她被关在那么个"}, {"start": 36.99, "end": 37.99, "text": "不见天日的地方"}, {"start": 38.75, "end": 39.75, "text": "你就更不知道她这三年"}, {"start": 39.75, "end": 40.75, "text": "是怎么过的"}, {"start": 42.27, "end": 43.67, "text": "我亲手把她送进去的"}, {"start": 43.87, "end": 46.38, "text": "她少了一颗身"}]}