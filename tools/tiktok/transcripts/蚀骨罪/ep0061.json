{"file": "蚀骨罪-第61集.mp4", "ep": 61, "duration": 58.7, "segments": [{"start": 0.37, "end": 1.09, "text": "剑头"}, {"start": 1.98, "end": 2.78, "text": "你说吧"}, {"start": 3.42, "end": 5.3, "text": "你到底要多少钱才肯不乱说"}, {"start": 5.82, "end": 6.34, "text": "说吧"}, {"start": 6.86, "end": 7.74, "text": "开口就开架"}, {"start": 8.59, "end": 9.83, "text": "反正你这种女人"}, {"start": 10.39, "end": 11.47, "text": "钱就是一切"}, {"start": 12.72, "end": 14.56, "text": "我已经做好大初学的准备了"}, {"start": 14.88, "end": 19.02, "text": "你要我道歉"}, {"start": 19.22, "end": 20.54, "text": "你要我向你道歉"}, {"start": 21.73, "end": 22.69, "text": "你还是说吧"}, {"start": 22.85, "end": 23.77, "text": "你要多少钱"}, {"start": 24.09, "end": 26.48, "text": "我只要道歉"}, {"start": 26.96, "end": 29.14, "text": "我要是不道歉呢"}, {"start": 29.86, "end": 30.86, "text": "你是不是已经想好"}, {"start": 30.86, "end": 31.94, "text": "要到处乱说了"}, {"start": 33.44, "end": 34.88, "text": "做错了是道歉"}, {"start": 35.0, "end": 36.32, "text": "难道不是应该的吗"}, {"start": 37.4, "end": 39.28, "text": "如果今天换做其他人"}, {"start": 39.52, "end": 40.92, "text": "齐穆穆还会这样吗"}, {"start": 41.54, "end": 42.02, "text": "不"}, {"start": 50.54, "end": 51.54, "text": "我齐穆穆"}, {"start": 51.9, "end": 53.82, "text": "就是赔上身上所有钱"}, {"start": 54.14, "end": 55.58, "text": "也不会给你道歉"}]}