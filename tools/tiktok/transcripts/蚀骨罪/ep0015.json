{"file": "蚀骨罪-第15集.mp4", "ep": 15, "duration": 68.0, "segments": [{"start": 10.32, "end": 11.16, "text": "必须走"}, {"start": 11.16, "end": 12.55, "text": "他那么恨我"}, {"start": 12.91, "end": 14.23, "text": "他不会放过我的"}, {"start": 28.37, "end": 29.05, "text": "去哪里"}, {"start": 32.21, "end": 32.89, "text": "走不走"}, {"start": 33.13, "end": 34.05, "text": "不走就下车"}, {"start": 34.59, "end": 35.83, "text": "我还要赶下一趟生意"}, {"start": 35.83, "end": 36.71, "text": "不好意思"}, {"start": 36.91, "end": 38.74, "text": "我还没有想好去哪里"}, {"start": 39.39, "end": 40.63, "text": "没想好就拦我车"}, {"start": 41.03, "end": 42.19, "text": "你故意耍我的吧"}, {"start": 42.63, "end": 43.87, "text": "你爸妈怎么教你的"}, {"start": 43.87, "end": 45.11, "text": "一点道德心都没有"}, {"start": 45.47, "end": 46.11, "text": "下车"}, {"start": 46.43, "end": 47.76, "text": "现在就下车"}, {"start": 48.04, "end": 48.76, "text": "混气"}, {"start": 49.0, "end": 50.64, "text": "今天怎么碰上你这种倒霉蛋"}, {"start": 52.02, "end": 52.74, "text": "对不起"}, {"start": 53.1, "end": 54.38, "text": "我现在就下车"}, {"start": 57.65, "end": 58.57, "text": "你神经病吧"}, {"start": 58.81, "end": 59.81, "text": "我开车门而已"}, {"start": 60.05, "end": 61.1, "text": "倒霉"}, {"start": 61.42, "end": 62.9, "text": "今天怎么遇上个女疯子"}, {"start": 63.94, "end": 64.78, "text": "摸摸蹭蹭"}, {"start": 64.78, "end": 65.54, "text": "快点吧"}, {"start": 66.21, "end": 67.45, "text": "你不会是裙子吧"}]}