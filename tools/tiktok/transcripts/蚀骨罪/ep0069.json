{"file": "蚀骨罪-第69集.mp4", "ep": 69, "duration": 56.8, "segments": [{"start": 0.3, "end": 2.3, "text": "你额头上的伤"}, {"start": 2.3, "end": 5.36, "text": "你和别人说了"}, {"start": 5.36, "end": 6.36, "text": "琴木母"}, {"start": 6.36, "end": 9.19, "text": "你是S大优等生"}, {"start": 9.19, "end": 11.19, "text": "我只是一个高中没毕业的清洁工"}, {"start": 11.19, "end": 13.22, "text": "我们是两个世界的人"}, {"start": 13.22, "end": 15.22, "text": "只是因为工作住在同一个宿舍"}, {"start": 15.22, "end": 16.22, "text": "以后"}, {"start": 16.22, "end": 18.61, "text": "各自安好"}, {"start": 18.61, "end": 19.61, "text": "各过各的吧"}, {"start": 19.61, "end": 36.45, "text": "终于安静了"}, {"start": 36.45, "end": 39.38, "text": "我到底是哪里惹到了"}, {"start": 39.38, "end": 41.38, "text": "这位品学兼优的大学生"}, {"start": 41.38, "end": 42.86, "text": "说出来"}, {"start": 42.86, "end": 43.92, "text": "我改还不"}, {"start": 43.92, "end": 53.56, "text": "你没事吧"}, {"start": 53.56, "end": 55.56, "text": "我不是故意的"}, {"start": 55.56, "end": 56.56, "text": "你别生气好不好"}]}