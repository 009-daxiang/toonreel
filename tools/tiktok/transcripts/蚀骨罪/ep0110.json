{"file": "蚀骨罪-第110集.mp4", "ep": 110, "duration": 62.3, "segments": [{"start": 0.4, "end": 1.4, "text": "当然"}, {"start": 1.4, "end": 9.98, "text": "不可以吗"}, {"start": 9.98, "end": 12.21, "text": "天死不早了"}, {"start": 12.21, "end": 13.21, "text": "看了先生"}, {"start": 13.21, "end": 14.21, "text": "请你离开"}, {"start": 14.21, "end": 16.21, "text": "伤口留着不治会烂掉的"}, {"start": 16.21, "end": 19.38, "text": "不可以碰那里"}, {"start": 19.38, "end": 20.51, "text": "哪里都可以"}, {"start": 20.51, "end": 22.51, "text": "回头那里不行"}, {"start": 22.51, "end": 28.06, "text": "你说你为我求情"}, {"start": 28.06, "end": 30.18, "text": "你求情了吗"}, {"start": 30.18, "end": 31.18, "text": "你想表现你的善良"}, {"start": 31.18, "end": 33.18, "text": "简童最不善良的就是你"}, {"start": 33.18, "end": 35.18, "text": "你看看我的嗓子"}, {"start": 35.18, "end": 36.18, "text": "你听听"}, {"start": 36.18, "end": 37.18, "text": "医生说我的嗓子"}, {"start": 37.18, "end": 38.18, "text": "要修养好久才能好"}, {"start": 38.18, "end": 39.18, "text": "就算好了"}, {"start": 39.18, "end": 41.18, "text": "也恢复不到从前了"}, {"start": 41.18, "end": 43.98, "text": "你不是说你帮我求情了吗"}, {"start": 43.98, "end": 44.98, "text": "我那么肯求你"}, {"start": 44.98, "end": 45.98, "text": "我甚至"}, {"start": 45.98, "end": 49.3, "text": "你却表面上说帮我求情"}, {"start": 49.3, "end": 51.3, "text": "其实你根本什么都没做"}, {"start": 51.3, "end": 52.3, "text": "你不是活着吗"}, {"start": 52.3, "end": 53.3, "text": "简童"}, {"start": 53.3, "end": 55.3, "text": "你还盼着我死"}, {"start": 55.3, "end": 58.32, "text": "齐穆穆"}, {"start": 58.32, "end": 59.32, "text": "你是不是觉得"}, {"start": 59.32, "end": 60.32, "text": "你会受到这些"}, {"start": 60.32, "end": 62.32, "text": "都是因为我害的"}]}