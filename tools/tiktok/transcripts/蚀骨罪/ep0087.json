{"file": "蚀骨罪-第87集.mp4", "ep": 87, "duration": 65.3, "segments": [{"start": 0.18, "end": 1.66, "text": "沈总 几点了"}, {"start": 3.05, "end": 3.73, "text": "五点半"}, {"start": 4.6, "end": 6.04, "text": "那我得去上班了"}, {"start": 7.61, "end": 8.89, "text": "今天准你病假"}, {"start": 9.29, "end": 10.42, "text": "我不需要"}, {"start": 10.74, "end": 12.09, "text": "你不需要"}, {"start": 12.61, "end": 13.33, "text": "剑鸿"}, {"start": 14.05, "end": 15.01, "text": "你的身体"}, {"start": 15.17, "end": 16.05, "text": "缺了什么"}, {"start": 16.05, "end": 16.97, "text": "你不知道我"}, {"start": 17.29, "end": 18.85, "text": "你不需要休息"}, {"start": 19.13, "end": 22.08, "text": "他说出来了"}, {"start": 22.2, "end": 23.82, "text": "他当着我的面"}, {"start": 23.82, "end": 26.18, "text": "说出了我最不想被人知道的事"}, {"start": 26.5, "end": 28.73, "text": "而这事的事做勇者"}, {"start": 28.85, "end": 30.84, "text": "沈总"}, {"start": 30.96, "end": 32.85, "text": "我缺了什么"}, {"start": 33.01, "end": 34.32, "text": "我当然知道"}, {"start": 34.48, "end": 35.76, "text": "不需要您提醒"}, {"start": 36.0, "end": 36.84, "text": "这一切"}, {"start": 37.04, "end": 39.46, "text": "感谢您的后代"}, {"start": 40.19, "end": 41.51, "text": "都是您的功劳"}, {"start": 41.67, "end": 42.5, "text": "你不需要"}, {"start": 42.5, "end": 44.46, "text": "一而再再而三地提醒我"}, {"start": 44.7, "end": 45.7, "text": "我曾经怎样"}, {"start": 45.7, "end": 46.86, "text": "接受了您的后代"}, {"start": 46.86, "end": 47.86, "text": "您的关照"}, {"start": 49.15, "end": 49.83, "text": "剑鸿"}, {"start": 50.46, "end": 51.62, "text": "不管你想不相信"}, {"start": 52.71, "end": 53.59, "text": "这件事情"}, {"start": 53.79, "end": 54.67, "text": "有些误会"}, {"start": 54.67, "end": 55.71, "text": "误会"}, {"start": 56.1, "end": 57.7, "text": "沈总不会想要说"}, {"start": 58.27, "end": 59.79, "text": "这件事与您无关"}, {"start": 60.11, "end": 61.27, "text": "您不知情吧"}, {"start": 61.78, "end": 62.7, "text": "沈总"}, {"start": 63.72, "end": 65.08, "text": "您自己信吗"}]}