{"file": "蚀骨罪-第106集.mp4", "ep": 106, "duration": 59.0, "segments": [{"start": 5.74, "end": 6.82, "text": "是简童"}, {"start": 6.82, "end": 9.77, "text": "说什么会替我求情"}, {"start": 9.77, "end": 11.53, "text": "根本就是骗子"}, {"start": 11.53, "end": 12.65, "text": "卫善"}, {"start": 12.65, "end": 13.45, "text": "没有她"}, {"start": 13.45, "end": 15.41, "text": "怎么会说这些嘴"}, {"start": 19.96, "end": 21.04, "text": "简童啊"}, {"start": 21.04, "end": 21.76, "text": "怎么"}, {"start": 21.76, "end": 23.2, "text": "喜欢这个"}, {"start": 23.2, "end": 24.28, "text": "我说简童"}, {"start": 24.28, "end": 25.68, "text": "我看你也别在这公关部"}, {"start": 25.68, "end": 26.92, "text": "丢人现眼了"}, {"start": 26.92, "end": 28.6, "text": "你这都多久没事干了"}, {"start": 28.6, "end": 29.52, "text": "珍妮"}, {"start": 29.52, "end": 30.84, "text": "你就不要拿你这点钱"}, {"start": 30.84, "end": 32.4, "text": "在简童面前晃了"}, {"start": 32.4, "end": 34.32, "text": "人简童赚的是大钱"}, {"start": 34.32, "end": 34.96, "text": "你这点"}, {"start": 34.96, "end": 37.4, "text": "根本就入不了人家的法眼啊"}, {"start": 37.4, "end": 38.48, "text": "那倒是"}, {"start": 38.48, "end": 40.76, "text": "谁能像她那样能屈能伸啊"}, {"start": 41.44, "end": 42.56, "text": "那钱再多"}, {"start": 42.56, "end": 47.22, "text": "我可不想要"}, {"start": 47.22, "end": 50.38, "text": "站住"}, {"start": 50.38, "end": 51.18, "text": "简童"}, {"start": 51.18, "end": 52.38, "text": "你什么意思"}, {"start": 52.38, "end": 53.22, "text": "我和你说话呢"}, {"start": 53.22, "end": 54.7, "text": "你话都不回一句就走"}, {"start": 54.7, "end": 56.06, "text": "你看不起我"}, {"start": 56.06, "end": 57.62, "text": "时间到了"}, {"start": 57.62, "end": 58.62, "text": "我下班了"}]}