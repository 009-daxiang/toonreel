{"file": "蚀骨罪-第93集.mp4", "ep": 93, "duration": 58.5, "segments": [{"start": 0.0, "end": 0.68, "text": "喂喂喂"}, {"start": 0.68, "end": 1.6, "text": "有话好说"}, {"start": 1.6, "end": 2.32, "text": "咱们兄弟"}, {"start": 2.32, "end": 3.24, "text": "没什么不能说的"}, {"start": 3.24, "end": 3.92, "text": "白玉行"}, {"start": 4.74, "end": 6.18, "text": "我和那女人之间的事"}, {"start": 6.34, "end": 7.22, "text": "你最清楚"}, {"start": 10.22, "end": 11.82, "text": "那你又为什么关心她死活"}, {"start": 11.82, "end": 13.38, "text": "就算是我不要的东西"}, {"start": 14.15, "end": 15.27, "text": "我没点头之前"}, {"start": 16.03, "end": 18.11, "text": "生死也必须掌控在我手中"}, {"start": 19.3, "end": 20.06, "text": "这样说"}, {"start": 21.05, "end": 21.65, "text": "玉行"}, {"start": 21.93, "end": 22.93, "text": "你明白了吗"}, {"start": 24.44, "end": 25.04, "text": "阿修"}, {"start": 25.62, "end": 26.46, "text": "你真的觉得"}, {"start": 26.58, "end": 27.58, "text": "你就那么恨她吗"}, {"start": 28.1, "end": 29.3, "text": "她弄死了夏威明"}, {"start": 29.91, "end": 31.83, "text": "每个人都该为自己做过的是赎罪"}, {"start": 32.07, "end": 32.91, "text": "赎罪"}, {"start": 33.23, "end": 33.91, "text": "阿修"}, {"start": 34.39, "end": 35.59, "text": "你是在说服我"}, {"start": 35.67, "end": 36.99, "text": "还是在说服你自己"}, {"start": 46.64, "end": 47.4, "text": "我说"}, {"start": 47.4, "end": 49.34, "text": "是萧先生"}, {"start": 49.34, "end": 55.56, "text": "有关萧先生"}, {"start": 56.13, "end": 57.69, "text": "可是剪同却鼓护萧"}]}