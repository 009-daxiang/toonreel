{"file": "蚀骨罪-第28集.mp4", "ep": 28, "duration": 57.9, "segments": [{"start": 6.19, "end": 6.95, "text": "简童"}, {"start": 6.95, "end": 7.59, "text": "姐"}, {"start": 8.59, "end": 9.79, "text": "那些是不是真的"}, {"start": 10.45, "end": 11.85, "text": "大家都在傳你做的事"}, {"start": 12.05, "end": 13.21, "text": "简童姐 你告訴我"}, {"start": 13.21, "end": 14.57, "text": "這是騙人的對不對"}, {"start": 15.13, "end": 16.19, "text": "是真的"}, {"start": 16.59, "end": 18.14, "text": "我沒想到你是這種人"}, {"start": 18.46, "end": 19.58, "text": "虧我還為你名不平"}, {"start": 19.58, "end": 20.26, "text": "你怎麼能做出"}, {"start": 20.26, "end": 21.34, "text": "這麼不要臉的事"}, {"start": 21.66, "end": 22.86, "text": "我真是看錯你了"}, {"start": 23.3, "end": 26.91, "text": "你還笑"}, {"start": 27.83, "end": 28.59, "text": "简童"}, {"start": 28.59, "end": 29.47, "text": "你是不是為了錢"}, {"start": 29.47, "end": 30.35, "text": "什麼都做得出來"}, {"start": 30.35, "end": 31.47, "text": "錢就這麼重要嗎"}, {"start": 31.47, "end": 32.59, "text": "錢不重要的話"}, {"start": 32.95, "end": 33.99, "text": "你來東皇做什麼"}, {"start": 34.58, "end": 35.22, "text": "這不對"}, {"start": 35.58, "end": 37.06, "text": "我來東皇就是做服務生"}, {"start": 37.06, "end": 38.18, "text": "端端盤子而已"}, {"start": 38.54, "end": 39.3, "text": "我家裡的情況"}, {"start": 39.3, "end": 40.54, "text": "你又不是不知道"}, {"start": 40.54, "end": 41.18, "text": "我只是為了"}, {"start": 41.18, "end": 42.7, "text": "轉學費和生活費"}, {"start": 43.39, "end": 44.63, "text": "我才不會像你一樣"}, {"start": 44.63, "end": 45.99, "text": "一連底線都沒有"}, {"start": 46.31, "end": 47.31, "text": "我的底線"}, {"start": 47.86, "end": 49.14, "text": "是不沾一滴酒"}, {"start": 50.14, "end": 51.1, "text": "我的底線"}, {"start": 51.82, "end": 52.62, "text": "是活著"}]}