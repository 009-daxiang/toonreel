{"file": "蚀骨罪-第59集.mp4", "ep": 59, "duration": 56.1, "segments": [{"start": 0.62, "end": 1.62, "text": "孟姐"}, {"start": 1.62, "end": 3.62, "text": "这个简童自投来了我们公关部"}, {"start": 3.62, "end": 4.62, "text": "就一堆麻烦事"}, {"start": 4.62, "end": 6.62, "text": "他又没有样貌身材"}, {"start": 6.62, "end": 7.62, "text": "成天穿得密不透风"}, {"start": 7.62, "end": 9.62, "text": "美语间团着一团仇云"}, {"start": 9.62, "end": 11.62, "text": "客户会喜欢吗"}, {"start": 11.62, "end": 13.71, "text": "不如"}, {"start": 13.71, "end": 15.71, "text": "把他调到别的部门去吧"}, {"start": 15.71, "end": 18.1, "text": "许经理"}, {"start": 18.1, "end": 20.1, "text": "简童是我亲手插进公关部的"}, {"start": 20.1, "end": 21.1, "text": "怎么"}, {"start": 21.1, "end": 24.1, "text": "许经理是对我的抉择有意义"}, {"start": 24.1, "end": 26.1, "text": "还是对我的眼光有意义"}, {"start": 26.1, "end": 28.15, "text": "没有没有"}, {"start": 28.15, "end": 29.15, "text": "既然孟姐看好他"}, {"start": 29.15, "end": 31.15, "text": "那我多花些时间教导他就是了"}, {"start": 34.3, "end": 35.3, "text": "这个傻女人"}, {"start": 35.3, "end": 37.3, "text": "终于也知道心疼自己了"}, {"start": 37.3, "end": 38.3, "text": "还好"}, {"start": 38.3, "end": 39.3, "text": "还知道累"}, {"start": 39.3, "end": 40.3, "text": "还有得求"}, {"start": 40.3, "end": 46.22, "text": "等一下"}]}