{"file": "蚀骨罪-第92集.mp4", "ep": 92, "duration": 58.4, "segments": [{"start": 1.02, "end": 4.26, "text": "小女朋友"}, {"start": 5.77, "end": 6.69, "text": "你在说谁"}, {"start": 9.81, "end": 10.29, "text": "谁"}, {"start": 11.98, "end": 12.78, "text": "不就是简童吗"}, {"start": 12.94, "end": 13.62, "text": "沈修建"}, {"start": 13.82, "end": 14.82, "text": "你别说她不是"}, {"start": 15.22, "end": 16.1, "text": "她要不是你小女朋友"}, {"start": 16.1, "end": 16.98, "text": "你干吗管她死活"}, {"start": 17.1, "end": 18.46, "text": "她发烧关你屁事"}, {"start": 18.62, "end": 19.78, "text": "你别说是可怜她"}, {"start": 20.62, "end": 21.7, "text": "你沈大总裁"}, {"start": 21.7, "end": 23.3, "text": "什么时候这么有同情心了"}, {"start": 23.5, "end": 24.66, "text": "不是你小女朋友"}, {"start": 24.78, "end": 25.94, "text": "你大半夜亲自开车"}, {"start": 25.94, "end": 26.82, "text": "送她去医院"}, {"start": 27.74, "end": 28.7, "text": "可拉倒吧"}, {"start": 30.66, "end": 31.46, "text": "沈总"}, {"start": 32.02, "end": 32.86, "text": "要没事"}, {"start": 32.86, "end": 33.82, "text": "我先出去"}, {"start": 33.98, "end": 34.86, "text": "她就放在你这儿"}, {"start": 35.62, "end": 36.74, "text": "你把人给我看好了"}, {"start": 37.84, "end": 38.64, "text": "她醒了"}, {"start": 38.8, "end": 39.76, "text": "你就跟她说"}, {"start": 40.12, "end": 41.08, "text": "她昏过去了"}, {"start": 41.44, "end": 42.8, "text": "你找了熟人来给她掉水"}, {"start": 43.0, "end": 45.78, "text": "你放手"}, {"start": 45.94, "end": 47.52, "text": "沈小姐 我警告你"}, {"start": 47.88, "end": 48.4, "text": "再不放手"}, {"start": 48.4, "end": 49.56, "text": "老子纵别你"}, {"start": 53.66, "end": 54.82, "text": "你要纵别我"}, {"start": 55.77, "end": 56.29, "text": "来"}, {"start": 56.98, "end": 57.9, "text": "避话避话"}]}