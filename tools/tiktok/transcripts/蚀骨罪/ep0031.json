{"file": "蚀骨罪-第31集.mp4", "ep": 31, "duration": 71.6, "segments": [{"start": 0.0, "end": 2.4, "text": "在监狱里大冷的冬天"}, {"start": 2.4, "end": 4.8, "text": "高压水枪对着我的身体冲"}, {"start": 4.8, "end": 8.74, "text": "回到牢房里也会有人上来痛做我一顿"}, {"start": 8.74, "end": 11.35, "text": "再难过的我都惊受过了"}, {"start": 11.35, "end": 14.51, "text": "这些都已经根本算不上什么了"}, {"start": 14.51, "end": 16.31, "text": "可是 孟姐"}, {"start": 16.31, "end": 17.98, "text": "她死了"}, {"start": 17.98, "end": 19.78, "text": "她死了 孟姐"}, {"start": 19.78, "end": 21.98, "text": "她一给丢了"}, {"start": 21.98, "end": 24.66, "text": "我就是一个害人精"}, {"start": 24.66, "end": 26.26, "text": "我不能死"}, {"start": 26.26, "end": 31.08, "text": "必须代替她活着"}, {"start": 31.08, "end": 32.74, "text": "我必须代替她"}, {"start": 32.74, "end": 35.14, "text": "实现去儿海的那场梦"}, {"start": 35.14, "end": 48.8, "text": "只剩下我自己"}, {"start": 48.8, "end": 50.56, "text": "我用自己还"}, {"start": 50.56, "end": 55.38, "text": "好不好"}, {"start": 55.38, "end": 56.54, "text": "她呢"}, {"start": 56.54, "end": 57.94, "text": "沈总 您问的谁"}, {"start": 57.94, "end": 59.14, "text": "简童"}, {"start": 59.14, "end": 61.58, "text": "她人呢"}, {"start": 61.58, "end": 63.18, "text": "简童今天请假"}, {"start": 63.18, "end": 64.98, "text": "去叫她来谁允许她请假"}, {"start": 64.98, "end": 66.62, "text": "五百万转到了吗"}, {"start": 66.62, "end": 67.82, "text": "沈总"}, {"start": 67.82, "end": 69.22, "text": "简童病了"}, {"start": 69.22, "end": 71.42, "text": "医生说再晚一点神仙也救不了她"}]}