{"file": "蚀骨罪-第91集.mp4", "ep": 91, "duration": 58.7, "segments": [{"start": 0.44, "end": 2.04, "text": "老子是医生 医生"}, {"start": 2.04, "end": 3.0, "text": "不是护士"}, {"start": 5.02, "end": 6.62, "text": "原来你连护士的活都不会"}, {"start": 7.1, "end": 7.62, "text": "靠"}, {"start": 8.06, "end": 9.1, "text": "掉个水这么简单的事"}, {"start": 9.1, "end": 9.82, "text": "老子不会"}, {"start": 13.3, "end": 13.98, "text": "白玉行"}, {"start": 14.46, "end": 15.3, "text": "你先别戳"}, {"start": 16.02, "end": 16.78, "text": "你说实话"}, {"start": 17.18, "end": 18.5, "text": "你到底会不会扎针"}, {"start": 20.85, "end": 21.53, "text": "白玉行"}, {"start": 21.81, "end": 22.85, "text": "你不会你要说"}, {"start": 23.01, "end": 23.89, "text": "我找会的来"}, {"start": 24.21, "end": 24.93, "text": "别逞能"}, {"start": 25.41, "end": 26.25, "text": "谁逞能"}, {"start": 26.37, "end": 27.37, "text": "你妹的沈修姐"}, {"start": 27.49, "end": 28.45, "text": "要不是你突然吓我"}, {"start": 28.45, "end": 29.05, "text": "我能戳哀"}, {"start": 29.65, "end": 30.37, "text": "你别说话"}, {"start": 30.86, "end": 32.3, "text": "老子要是不能一针戳进去"}, {"start": 32.3, "end": 33.26, "text": "明天就写辞职信"}, {"start": 33.26, "end": 34.34, "text": "回去帮老头子做事"}, {"start": 34.34, "end": 34.86, "text": "行了吧"}, {"start": 40.02, "end": 40.7, "text": "我说吧"}, {"start": 40.86, "end": 41.98, "text": "老子是天才"}, {"start": 42.22, "end": 43.22, "text": "这么简单的活"}, {"start": 43.22, "end": 44.02, "text": "我能不会干"}, {"start": 44.38, "end": 45.1, "text": "沈修姐"}, {"start": 45.22, "end": 45.9, "text": "我跟你说"}, {"start": 46.02, "end": 47.46, "text": "老子给你当私人医生"}, {"start": 47.46, "end": 48.42, "text": "就是屈才"}, {"start": 48.54, "end": 49.66, "text": "你就偷着乐吧"}, {"start": 50.47, "end": 51.39, "text": "我给你加薪"}, {"start": 53.57, "end": 54.85, "text": "沈修姐 你故意的吧"}, {"start": 55.09, "end": 56.81, "text": "老子帮你把小女朋友给治好了"}, {"start": 56.93, "end": 58.09, "text": "你还故意贬损我"}]}