{"file": "蚀骨罪-第64集.mp4", "ep": 64, "duration": 56.1, "segments": [{"start": 0.0, "end": 0.68, "text": "你贼义"}, {"start": 1.35, "end": 2.55, "text": "但人心不可稀罗"}, {"start": 3.11, "end": 4.07, "text": "时刻而止"}, {"start": 6.02, "end": 6.62, "text": "剑通"}, {"start": 7.18, "end": 8.86, "text": "到底是什么人 什么事"}, {"start": 9.1, "end": 11.02, "text": "才能把一个骄傲到骨子里的女人"}, {"start": 11.02, "end": 12.1, "text": "变成这副模样"}, {"start": 18.15, "end": 19.67, "text": "听说秦睦睦跟他住"}, {"start": 19.67, "end": 20.75, "text": "矛盾可多了"}, {"start": 20.75, "end": 22.67, "text": "最后生病还不是人家秦睦睦"}, {"start": 22.67, "end": 23.59, "text": "天天照顾他"}, {"start": 28.29, "end": 28.85, "text": "剑通"}, {"start": 29.33, "end": 30.45, "text": "出来 跟我走"}, {"start": 30.93, "end": 32.61, "text": "601有客人点名让你过去"}, {"start": 37.68, "end": 39.6, "text": "进去之后客人的要求要满足"}, {"start": 39.6, "end": 40.6, "text": "不要得罪客人"}, {"start": 41.35, "end": 41.87, "text": "记住"}, {"start": 42.43, "end": 44.71, "text": "多的是人挤破头要进攻关部"}, {"start": 45.15, "end": 46.43, "text": "你做得不好就出去"}, {"start": 46.79, "end": 47.95, "text": "谁的面子都没有"}, {"start": 48.46, "end": 49.58, "text": "知道了许经理"}, {"start": 50.85, "end": 52.77, "text": "这个客人姓什么"}, {"start": 52.77, "end": 53.81, "text": "不该问的别多问"}, {"start": 54.41, "end": 54.77, "text": "进去"}]}