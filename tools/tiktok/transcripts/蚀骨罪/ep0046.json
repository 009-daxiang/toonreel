{"file": "蚀骨罪-第46集.mp4", "ep": 46, "duration": 69.5, "segments": [{"start": 1.39, "end": 2.11, "text": "不想"}, {"start": 4.39, "end": 5.19, "text": "既然饿了"}, {"start": 5.55, "end": 6.47, "text": "就下去吃饭"}, {"start": 7.63, "end": 8.39, "text": "姓沈的"}, {"start": 8.99, "end": 9.99, "text": "你还要不要脸"}, {"start": 10.43, "end": 11.79, "text": "用不着了就赶人走"}, {"start": 12.78, "end": 13.98, "text": "要走你自己走"}, {"start": 14.8, "end": 15.6, "text": "拽我干嘛"}, {"start": 16.92, "end": 17.72, "text": "姓白的"}, {"start": 18.08, "end": 19.56, "text": "你不要不识好人心"}, {"start": 20.24, "end": 21.84, "text": "老子拽你走是为了你好"}, {"start": 23.91, "end": 25.51, "text": "你当沈秀景的面说那种话"}, {"start": 26.03, "end": 27.23, "text": "你意思不就是沈秀景"}, {"start": 27.23, "end": 28.23, "text": "对简童有意思"}, {"start": 28.51, "end": 30.54, "text": "你脑子有病吧"}, {"start": 30.74, "end": 32.38, "text": "沈秀景"}, {"start": 32.54, "end": 33.38, "text": "简童"}, {"start": 33.97, "end": 35.97, "text": "夏威明的一条命摆在那"}, {"start": 37.94, "end": 39.46, "text": "三年前的简家大小姐"}, {"start": 39.82, "end": 40.98, "text": "那是整个上海滩上"}, {"start": 40.98, "end": 42.26, "text": "一朵孤傲的红玫瑰"}, {"start": 42.78, "end": 44.34, "text": "多少公子哥前譜后绩"}, {"start": 44.34, "end": 45.86, "text": "就为了跟他聊上一句话"}, {"start": 46.34, "end": 48.1, "text": "你再看看现在躺床上的那个人"}, {"start": 48.34, "end": 49.54, "text": "他真的是简童吗"}, {"start": 49.94, "end": 52.55, "text": "第一眼见到的时候不惊讶吗"}, {"start": 56.29, "end": 57.69, "text": "把人弄成这模样了"}, {"start": 58.98, "end": 60.82, "text": "沈秀景会对他有意思"}, {"start": 61.26, "end": 62.22, "text": "你懂个屁"}, {"start": 63.85, "end": 64.81, "text": "不会好好说话"}, {"start": 65.13, "end": 66.97, "text": "说你懂个屁都是抬举你了"}, {"start": 67.45, "end": 68.05, "text": "行了"}, {"start": 68.41, "end": 69.37, "text": "我请你吃夜宵"}]}