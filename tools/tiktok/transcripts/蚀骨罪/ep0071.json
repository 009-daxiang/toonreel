{"file": "蚀骨罪-第71集.mp4", "ep": 71, "duration": 57.0, "segments": [{"start": 0.0, "end": 0.96, "text": "不忙就好"}, {"start": 3.81, "end": 5.69, "text": "肖公子是什么意思"}, {"start": 5.93, "end": 7.09, "text": "问我忙不忙"}, {"start": 7.09, "end": 8.09, "text": "然后走了"}, {"start": 8.33, "end": 10.26, "text": "他是打算约我吗"}, {"start": 12.67, "end": 13.39, "text": "齐牧牧"}, {"start": 13.51, "end": 15.03, "text": "六楼603暴乡"}, {"start": 15.27, "end": 16.19, "text": "有人指定你去"}, {"start": 16.35, "end": 16.99, "text": "赶紧去"}, {"start": 17.35, "end": 18.51, "text": "603"}, {"start": 19.07, "end": 20.79, "text": "那不是安妮负责的吗"}, {"start": 20.91, "end": 21.67, "text": "指定你去"}, {"start": 21.75, "end": 22.35, "text": "别摸走"}, {"start": 22.75, "end": 23.27, "text": "哦"}, {"start": 25.7, "end": 26.22, "text": "杜总"}, {"start": 26.3, "end": 27.5, "text": "今天只管尽情玩"}, {"start": 27.58, "end": 28.18, "text": "我买单"}, {"start": 30.5, "end": 31.9, "text": "家里老爷子还等着"}, {"start": 32.02, "end": 32.82, "text": "我先走一步"}, {"start": 33.58, "end": 34.78, "text": "待会这扇门里"}, {"start": 34.9, "end": 36.62, "text": "会进来一位妙龄家人"}, {"start": 36.9, "end": 38.1, "text": "这丫头有趣的很"}, {"start": 38.7, "end": 40.18, "text": "我亲自为杜总挑的"}, {"start": 40.76, "end": 42.44, "text": "杜总可别辜负我的美艺"}, {"start": 42.8, "end": 44.72, "text": "肖公子人中龙凤"}, {"start": 44.88, "end": 45.88, "text": "果然不假"}]}