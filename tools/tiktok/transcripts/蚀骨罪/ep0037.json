{"file": "蚀骨罪-第37集.mp4", "ep": 37, "duration": 55.1, "segments": [{"start": 5.78, "end": 6.98, "text": "沈总 白先生"}, {"start": 8.63, "end": 9.19, "text": "沈总"}, {"start": 10.09, "end": 10.85, "text": "简同他"}, {"start": 10.85, "end": 11.53, "text": "死不了"}, {"start": 11.85, "end": 13.21, "text": "最近下面的人不安分"}, {"start": 13.21, "end": 14.13, "text": "乱传闲话"}, {"start": 14.49, "end": 15.45, "text": "我正要去处理"}, {"start": 15.93, "end": 16.81, "text": "谁的闲话"}, {"start": 17.79, "end": 18.51, "text": "简同的"}, {"start": 19.29, "end": 20.41, "text": "那天606包厢的事"}, {"start": 20.41, "end": 21.33, "text": "被人传出去了"}, {"start": 21.73, "end": 22.53, "text": "现在整个东黄"}, {"start": 22.53, "end": 23.25, "text": "没人不知道"}, {"start": 24.04, "end": 25.4, "text": "我猜是露娜"}, {"start": 25.6, "end": 26.8, "text": "606的包房公主"}, {"start": 27.36, "end": 28.92, "text": "那天他正好在门外偷看"}, {"start": 29.24, "end": 31.61, "text": "简同的嗓子是怎么回事"}, {"start": 31.73, "end": 32.41, "text": "是真真"}, {"start": 33.3, "end": 35.38, "text": "他把简同拉进自己客人的包厢"}, {"start": 35.86, "end": 36.98, "text": "让简同连着唱了"}, {"start": 36.98, "end": 38.22, "text": "将近五十首歌"}, {"start": 38.5, "end": 39.54, "text": "还都是高音"}, {"start": 40.26, "end": 42.14, "text": "唱完简同的嗓子就哑透了"}, {"start": 43.08, "end": 43.84, "text": "这件事"}, {"start": 44.28, "end": 45.2, "text": "趁朕还当笑话"}, {"start": 45.2, "end": 45.92, "text": "讲给公关部"}, {"start": 45.92, "end": 46.72, "text": "其他人听"}, {"start": 48.26, "end": 48.9, "text": "要出事"}, {"start": 50.74, "end": 51.94, "text": "把露娜和真真叫来"}, {"start": 52.3, "end": 53.74, "text": "我在606包厢等他们"}]}