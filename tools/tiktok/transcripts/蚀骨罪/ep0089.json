{"file": "蚀骨罪-第89集.mp4", "ep": 89, "duration": 62.6, "segments": [{"start": 0.0, "end": 0.76, "text": "明白了"}, {"start": 0.76, "end": 2.04, "text": "等简童到了东黄"}, {"start": 2.04, "end": 3.28, "text": "我把安眠药摊在热水里"}, {"start": 3.28, "end": 4.2, "text": "让他喝下去"}, {"start": 4.2, "end": 5.0, "text": "还有"}, {"start": 5.0, "end": 6.22, "text": "我要给他安排会儿"}, {"start": 6.94, "end": 7.7, "text": "知道了"}, {"start": 8.02, "end": 8.94, "text": "可人在东黄"}, {"start": 8.94, "end": 9.9, "text": "又在公关部"}, {"start": 9.9, "end": 11.06, "text": "总不能亮着吧"}, {"start": 11.06, "end": 11.9, "text": "时间久了"}, {"start": 11.9, "end": 12.74, "text": "会有闲话"}, {"start": 12.74, "end": 14.1, "text": "谁说闲话发热掉"}, {"start": 14.1, "end": 15.26, "text": "这也需要我教你"}, {"start": 17.51, "end": 18.59, "text": "反正你是大老板"}, {"start": 18.59, "end": 19.67, "text": "你说的算"}, {"start": 19.67, "end": 20.87, "text": "拿整个东黄去玩"}, {"start": 20.87, "end": 21.79, "text": "也是你的事"}, {"start": 27.24, "end": 28.2, "text": "简童"}, {"start": 28.2, "end": 29.4, "text": "到我办公室来一趟"}, {"start": 34.38, "end": 35.26, "text": "傻妞"}, {"start": 35.26, "end": 36.38, "text": "别怪我"}, {"start": 36.38, "end": 38.3, "text": "大老板的命令我不敢不停"}, {"start": 38.3, "end": 39.58, "text": "但你确实该歇了"}, {"start": 40.28, "end": 41.12, "text": "能"}, {"start": 41.12, "end": 42.94, "text": "先喝点水"}, {"start": 42.94, "end": 47.77, "text": "谢谢孟姐"}, {"start": 47.77, "end": 48.85, "text": "我真口渴呢"}, {"start": 48.85, "end": 50.21, "text": "孟姐你人真好"}, {"start": 50.21, "end": 52.17, "text": "你要是知道水里有什么"}, {"start": 52.17, "end": 54.3, "text": "就不会说我人好了"}, {"start": 54.3, "end": 55.14, "text": "孟姐"}, {"start": 55.14, "end": 55.78, "text": "还有吗"}, {"start": 55.78, "end": 56.26, "text": "有"}, {"start": 56.26, "end": 57.26, "text": "有有有"}]}