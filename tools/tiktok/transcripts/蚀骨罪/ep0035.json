{"file": "蚀骨罪-第35集.mp4", "ep": 35, "duration": 57.6, "segments": [{"start": 1.68, "end": 2.52, "text": "秦牧牧"}, {"start": 3.0, "end": 4.48, "text": "你很看不起简童吗"}, {"start": 5.0, "end": 6.16, "text": "他做的那些事情"}, {"start": 6.32, "end": 7.68, "text": "已经在东黄传开了"}, {"start": 8.16, "end": 9.04, "text": "他为了钱"}, {"start": 9.52, "end": 10.48, "text": "大家都在骂他"}, {"start": 10.64, "end": 11.44, "text": "很怎样"}, {"start": 11.8, "end": 12.64, "text": "很不要脸"}, {"start": 12.92, "end": 13.8, "text": "还是很贱"}, {"start": 15.76, "end": 17.24, "text": "你是艾斯达的学生"}, {"start": 17.76, "end": 19.49, "text": "你是不是觉得自己"}, {"start": 19.49, "end": 20.89, "text": "出于泥而不染"}, {"start": 21.37, "end": 22.77, "text": "自己清白干净"}, {"start": 23.25, "end": 29.05, "text": "你是不是觉得简童低见"}, {"start": 29.45, "end": 31.05, "text": "不配和你住一个无言下"}, {"start": 31.45, "end": 32.73, "text": "所以即使他病了"}, {"start": 33.01, "end": 34.29, "text": "你都能忽视得彻底"}, {"start": 34.77, "end": 36.71, "text": "孟姐"}, {"start": 37.19, "end": 38.45, "text": "秦牧牧"}, {"start": 39.17, "end": 40.37, "text": "你比不上简童"}, {"start": 41.18, "end": 42.34, "text": "我考上艾斯达"}, {"start": 42.78, "end": 44.1, "text": "我一个艾斯达的学生"}, {"start": 44.34, "end": 45.02, "text": "会比不上一个"}, {"start": 45.02, "end": 46.62, "text": "为了钱什么都肯做的女人"}, {"start": 47.31, "end": 48.95, "text": "别把自己想得那么高尚"}, {"start": 49.47, "end": 51.07, "text": "那天在606包乡的事情"}, {"start": 51.07, "end": 51.91, "text": "你没忘吧"}, {"start": 52.54, "end": 54.62, "text": "要不是简童心软帮你解围"}, {"start": 54.82, "end": 56.66, "text": "你以为你现在还能站在这里"}, {"start": 56.66, "end": 57.62, "text": "说风凉话"}]}