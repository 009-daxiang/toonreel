{"file": "蚀骨罪-第109集.mp4", "ep": 109, "duration": 64.4, "segments": [{"start": 10.32, "end": 11.56, "text": "先生请进"}, {"start": 11.76, "end": 12.56, "text": "您先坐"}, {"start": 16.55, "end": 17.71, "text": "先生尝尝"}, {"start": 22.62, "end": 23.42, "text": "很好吃"}, {"start": 24.41, "end": 25.45, "text": "你做得很用心"}, {"start": 26.26, "end": 27.54, "text": "以前有一个人"}, {"start": 27.9, "end": 29.66, "text": "特别喜欢吃葱油拌面"}, {"start": 30.49, "end": 31.33, "text": "我就想"}, {"start": 31.98, "end": 33.3, "text": "等我学会之后"}, {"start": 33.99, "end": 35.43, "text": "一定要做给他吃"}, {"start": 35.63, "end": 38.53, "text": "那后来呢"}, {"start": 39.4, "end": 40.56, "text": "先生您是第一个"}, {"start": 40.56, "end": 42.2, "text": "吃我煮的葱油拌面的人"}, {"start": 43.07, "end": 43.91, "text": "那你自己呢"}, {"start": 44.39, "end": 45.47, "text": "你不应该是第二个吗"}, {"start": 46.02, "end": 46.74, "text": "我啊"}, {"start": 47.42, "end": 49.06, "text": "一吃葱浑身就痒痒"}, {"start": 49.83, "end": 51.23, "text": "可能是心理作用吧"}, {"start": 51.47, "end": 52.31, "text": "跟你交换"}, {"start": 53.14, "end": 54.1, "text": "记住我的名字"}, {"start": 54.62, "end": 55.42, "text": "我叫凯恩"}, {"start": 56.13, "end": 56.81, "text": "这钱"}, {"start": 57.44, "end": 59.6, "text": "就是你记住我名字的交换筹码"}, {"start": 60.16, "end": 62.72, "text": "只要记住你的名字"}, {"start": 63.81, "end": 64.37, "text": "当然"}]}