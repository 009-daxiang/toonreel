{"file": "蚀骨罪-第86集.mp4", "ep": 86, "duration": 65.9, "segments": [{"start": 0.0, "end": 0.72, "text": "镜头"}, {"start": 1.32, "end": 2.32, "text": "你别承认"}, {"start": 2.99, "end": 5.03, "text": "三年前你能应咬着牙不承认"}, {"start": 5.59, "end": 7.43, "text": "三年后出来也别承认"}, {"start": 7.79, "end": 12.03, "text": "受不了心理的折磨了"}, {"start": 12.43, "end": 15.89, "text": "三年前"}, {"start": 16.67, "end": 18.47, "text": "我跪在神家天门前"}, {"start": 19.02, "end": 20.3, "text": "整整一个月夜"}, {"start": 20.42, "end": 22.67, "text": "你不给我五分钟"}, {"start": 23.44, "end": 24.16, "text": "今天"}, {"start": 24.66, "end": 26.06, "text": "还有什么可解释"}, {"start": 26.9, "end": 27.9, "text": "劳我做了"}, {"start": 28.34, "end": 29.36, "text": "惩罚"}, {"start": 29.69, "end": 30.41, "text": "我受了"}, {"start": 31.1, "end": 33.34, "text": "解释与不解释已经多余了"}, {"start": 34.04, "end": 34.88, "text": "还是说"}, {"start": 35.36, "end": 37.42, "text": "沈总您又想把我丢进那里去"}, {"start": 38.02, "end": 39.02, "text": "这一次多久"}, {"start": 39.49, "end": 40.21, "text": "三年"}, {"start": 40.53, "end": 41.17, "text": "五年"}, {"start": 41.41, "end": 42.25, "text": "十年"}, {"start": 42.68, "end": 43.16, "text": "是"}, {"start": 44.45, "end": 46.17, "text": "解释不解释都已经多余"}, {"start": 46.37, "end": 48.51, "text": "你亲口承认了"}, {"start": 48.87, "end": 50.19, "text": "你欠下一条人命"}, {"start": 51.24, "end": 52.92, "text": "那你准备拿什么还这条命"}, {"start": 55.1, "end": 56.22, "text": "用我下半辈子"}, {"start": 56.42, "end": 56.98, "text": "够了吗"}, {"start": 57.38, "end": 58.1, "text": "还不清"}, {"start": 58.22, "end": 59.62, "text": "下下辈子继续还"}, {"start": 59.82, "end": 60.82, "text": "要是还不清"}, {"start": 60.98, "end": 61.9, "text": "就继续还"}, {"start": 62.29, "end": 63.73, "text": "总有还清的那一天"}]}