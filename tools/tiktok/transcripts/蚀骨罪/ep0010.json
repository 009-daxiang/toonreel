{"file": "蚀骨罪-第10集.mp4", "ep": 10, "duration": 60.4, "segments": [{"start": 0.0, "end": 0.88, "text": "剑童姐"}, {"start": 1.48, "end": 2.96, "text": "出狱了你想做什么"}, {"start": 5.46, "end": 6.66, "text": "我想去儿海"}, {"start": 7.58, "end": 8.66, "text": "儿海的水"}, {"start": 9.02, "end": 10.18, "text": "成侧干净"}, {"start": 11.22, "end": 12.82, "text": "那里的水鸟很可爱"}, {"start": 14.44, "end": 15.68, "text": "我想努力赚钱"}, {"start": 15.96, "end": 18.22, "text": "去那里开一个小小的民宿"}, {"start": 18.42, "end": 19.62, "text": "不为赚很多钱"}, {"start": 20.19, "end": 22.03, "text": "只要日子温暴有余"}, {"start": 22.23, "end": 23.03, "text": "剑童姐"}, {"start": 24.02, "end": 25.46, "text": "其实我没有去过儿海"}, {"start": 25.82, "end": 27.06, "text": "那些儿海的魅力"}, {"start": 27.22, "end": 29.34, "text": "都是我从电视和报纸上看到的"}, {"start": 29.54, "end": 30.34, "text": "我知道"}, {"start": 30.7, "end": 31.82, "text": "就算出狱了"}, {"start": 32.02, "end": 33.46, "text": "我也没钱去开民宿"}, {"start": 33.94, "end": 34.9, "text": "我就是想"}, {"start": 35.06, "end": 36.33, "text": "在死之前"}, {"start": 36.61, "end": 38.25, "text": "所以做着不可能的"}, {"start": 38.53, "end": 45.61, "text": "添了一条命"}, {"start": 45.81, "end": 46.61, "text": "那个在监狱里"}, {"start": 46.61, "end": 48.09, "text": "唯一护着我的女孩"}, {"start": 48.21, "end": 48.93, "text": "因为我"}, {"start": 48.93, "end": 50.13, "text": "死在了那个地方"}, {"start": 50.51, "end": 52.43, "text": "我欠的债不是下为你"}, {"start": 52.7, "end": 53.62, "text": "是阿露"}, {"start": 53.62, "end": 54.7, "text": "我还不能死"}, {"start": 54.7, "end": 56.53, "text": "我还欠阿露一个儿海"}, {"start": 56.65, "end": 57.53, "text": "沈先生"}, {"start": 57.96, "end": 59.24, "text": "只要不让我喝酒"}, {"start": 59.52, "end": 60.48, "text": "怎样都行"}]}