{"file": "蚀骨罪-第82集.mp4", "ep": 82, "duration": 44.8, "segments": [{"start": 0.08, "end": 0.76, "text": "淺童"}, {"start": 1.94, "end": 3.02, "text": "你终于肯承认了"}, {"start": 3.26, "end": 5.47, "text": "什么"}, {"start": 5.75, "end": 6.55, "text": "你的请求"}, {"start": 6.83, "end": 7.47, "text": "我答应了"}, {"start": 7.63, "end": 8.31, "text": "沈总"}, {"start": 8.71, "end": 9.95, "text": "我曾亏欠一条命"}, {"start": 10.27, "end": 11.67, "text": "但与夏威明无关"}, {"start": 11.87, "end": 12.51, "text": "淺童"}, {"start": 12.83, "end": 13.39, "text": "淺童"}, {"start": 13.79, "end": 14.83, "text": "白月行 你在哪儿"}, {"start": 14.95, "end": 15.75, "text": "赶紧过来"}, {"start": 17.69, "end": 18.25, "text": "你做什么"}, {"start": 18.37, "end": 19.89, "text": "我检查一下她的心肺律动"}, {"start": 20.41, "end": 24.18, "text": "她没什么大事"}, {"start": 24.5, "end": 26.02, "text": "休息好了白药吃了就没事"}, {"start": 26.65, "end": 27.93, "text": "就是少了一颗肾而已"}, {"start": 28.09, "end": 28.97, "text": "你不信的话"}, {"start": 29.17, "end": 30.01, "text": "自己看看呗"}, {"start": 37.5, "end": 38.42, "text": "当初给她操刀的"}, {"start": 38.42, "end": 39.46, "text": "医生技术很差"}, {"start": 39.9, "end": 41.66, "text": "差到连行医植兆都没有"}, {"start": 41.94, "end": 44.3, "text": "很可能连麻醉药都没有"}]}