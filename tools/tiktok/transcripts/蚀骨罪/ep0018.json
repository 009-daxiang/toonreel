{"file": "蚀骨罪-第18集.mp4", "ep": 18, "duration": 63.6, "segments": [{"start": 0.0, "end": 0.8, "text": "等一下"}, {"start": 0.8, "end": 3.88, "text": "沒有錢"}, {"start": 4.74, "end": 6.14, "text": "你怎麼能夠逃走"}, {"start": 15.34, "end": 16.94, "text": "沈修錦你太強大"}, {"start": 16.94, "end": 18.34, "text": "你的敵人那麼多"}, {"start": 19.19, "end": 21.19, "text": "你的女人不能成為你的弱點"}, {"start": 21.82, "end": 23.02, "text": "威名太弱"}, {"start": 23.02, "end": 23.82, "text": "她不行"}, {"start": 24.25, "end": 25.45, "text": "我簡通行"}, {"start": 34.74, "end": 35.94, "text": "去看看她的行李"}, {"start": 36.44, "end": 38.64, "text": "現金和銀行卡全部沒收"}, {"start": 38.64, "end": 40.43, "text": "你想做什麼"}, {"start": 40.43, "end": 41.83, "text": "既然已經被我盯上了"}, {"start": 42.23, "end": 44.69, "text": "簡通你走不掉了"}, {"start": 44.89, "end": 45.82, "text": "這是"}, {"start": 45.82, "end": 48.48, "text": "沈先生"}, {"start": 48.68, "end": 50.08, "text": "你帶我來這裡做什麼"}, {"start": 50.28, "end": 51.28, "text": "你說呢"}, {"start": 51.71, "end": 53.51, "text": "簡大小姐"}, {"start": 53.91, "end": 54.91, "text": "求求你"}, {"start": 54.91, "end": 56.68, "text": "放過我吧"}, {"start": 56.88, "end": 58.08, "text": "我給您道歉"}, {"start": 58.08, "end": 59.08, "text": "給您跪下"}, {"start": 59.08, "end": 59.94, "text": "給您頭"}, {"start": 59.94, "end": 60.54, "text": "住嘴"}, {"start": 60.74, "end": 63.34, "text": "你要跪什麼"}]}