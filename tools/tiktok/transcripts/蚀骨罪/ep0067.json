{"file": "蚀骨罪-第67集.mp4", "ep": 67, "duration": 60.6, "segments": [{"start": 0.0, "end": 0.68, "text": "孟姐"}, {"start": 0.92, "end": 3.2, "text": "麻烦帮我把这张支票存进那张卡里"}, {"start": 3.52, "end": 4.32, "text": "十万"}, {"start": 5.0, "end": 6.0, "text": "你刚接了一单"}, {"start": 6.4, "end": 7.64, "text": "他为什么给你这么多钱"}, {"start": 7.64, "end": 8.36, "text": "你做了什么"}, {"start": 8.64, "end": 9.2, "text": "孟姐"}, {"start": 9.52, "end": 10.8, "text": "他只是要求一个稳"}, {"start": 11.12, "end": 12.04, "text": "一个稳"}, {"start": 12.52, "end": 14.04, "text": "以后不要见这个人了"}, {"start": 14.2, "end": 18.71, "text": "这是怎么回事"}, {"start": 19.27, "end": 20.35, "text": "不小心撞到门"}, {"start": 20.59, "end": 21.31, "text": "没事"}, {"start": 22.06, "end": 23.06, "text": "你不说也可以"}, {"start": 23.3, "end": 24.26, "text": "我打给沈总"}, {"start": 24.42, "end": 25.06, "text": "孟姐"}, {"start": 25.5, "end": 27.06, "text": "沈总不会在意我怎么样的"}, {"start": 27.22, "end": 27.78, "text": "行"}, {"start": 28.35, "end": 29.39, "text": "不打给沈总"}, {"start": 29.63, "end": 30.59, "text": "我叫许经理来"}, {"start": 30.59, "end": 31.55, "text": "别叫许经理"}, {"start": 32.03, "end": 34.15, "text": "我说是我撞到了门把手上"}, {"start": 34.51, "end": 35.47, "text": "那天淋了雨"}, {"start": 35.71, "end": 36.71, "text": "头晕眼化"}, {"start": 37.03, "end": 38.35, "text": "你额头上的伤还没好"}, {"start": 38.51, "end": 39.23, "text": "回去休养"}, {"start": 39.35, "end": 39.87, "text": "我不"}, {"start": 40.27, "end": 40.83, "text": "孟姐"}, {"start": 41.35, "end": 42.67, "text": "如果你真的心疼我"}, {"start": 42.83, "end": 44.19, "text": "就多给我介绍些活吧"}, {"start": 44.19, "end": 45.11, "text": "你先出去吧"}, {"start": 55.19, "end": 55.91, "text": "谁给他的钱"}, {"start": 55.91, "end": 57.15, "text": "是不是"}, {"start": 57.15, "end": 58.91, "text": "这次他又做了什么"}, {"start": 59.27, "end": 60.59, "text": "你要帮着他隐瞒什么"}]}