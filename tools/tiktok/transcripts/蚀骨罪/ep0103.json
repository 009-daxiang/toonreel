{"file": "蚀骨罪-第103集.mp4", "ep": 103, "duration": 43.4, "segments": [{"start": 0.37, "end": 1.17, "text": "多少钱"}, {"start": 4.11, "end": 6.07, "text": "萧大少没给钱"}, {"start": 6.39, "end": 9.29, "text": "我乐意白给萧大少看"}, {"start": 10.68, "end": 12.8, "text": "萧大少那样多精帅气的公子哥"}, {"start": 12.8, "end": 13.76, "text": "谁不喜欢"}, {"start": 14.04, "end": 15.44, "text": "沈总不是知道的吗"}, {"start": 16.09, "end": 17.01, "text": "我不值钱"}, {"start": 17.62, "end": 19.1, "text": "可萧大少人温柔"}, {"start": 19.26, "end": 20.46, "text": "我倒贴都愿意"}, {"start": 20.78, "end": 21.7, "text": "沈修锦"}, {"start": 22.18, "end": 23.86, "text": "在你眼里我是个女婊子"}, {"start": 24.06, "end": 25.82, "text": "所以你才能问我多少钱"}, {"start": 25.94, "end": 26.62, "text": "好"}, {"start": 27.38, "end": 28.94, "text": "那我就是个女婊子"}, {"start": 29.06, "end": 30.5, "text": "萧大少的文"}, {"start": 30.98, "end": 33.66, "text": "至今都让我回味无穷"}, {"start": 35.14, "end": 36.86, "text": "我就盼着冠罪萧大少一次"}, {"start": 36.86, "end": 37.98, "text": "好喝萧大少"}]}