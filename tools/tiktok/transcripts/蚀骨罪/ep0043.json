{"file": "蚀骨罪-第43集.mp4", "ep": 43, "duration": 55.8, "segments": [{"start": 0.21, "end": 1.17, "text": "对不起 安然"}, {"start": 2.19, "end": 3.78, "text": "我爱你们"}, {"start": 3.94, "end": 5.94, "text": "她把我当成了另一个女人了吧"}, {"start": 6.69, "end": 7.93, "text": "那个额头有疤"}, {"start": 8.45, "end": 9.73, "text": "说着同样的话"}, {"start": 10.45, "end": 12.73, "text": "已经无法轻而听到道歉的女人"}, {"start": 13.87, "end": 14.47, "text": "卢晨"}, {"start": 15.17, "end": 15.89, "text": "放开她"}, {"start": 19.86, "end": 21.02, "text": "原来是你呀"}, {"start": 21.42, "end": 23.22, "text": "让这个女人怕到发疯"}, {"start": 23.62, "end": 25.22, "text": "怕到失去理智"}, {"start": 25.82, "end": 26.34, "text": "过来"}, {"start": 30.61, "end": 32.45, "text": "看来你是永远也学不惯"}, {"start": 32.45, "end": 33.89, "text": "她现在没空应付你"}, {"start": 34.62, "end": 35.3, "text": "陕修静"}, {"start": 35.82, "end": 36.74, "text": "你没看到吗"}, {"start": 37.26, "end": 38.18, "text": "她在陪我"}, {"start": 41.42, "end": 43.38, "text": "是谁给了你胆子不听我话"}, {"start": 44.91, "end": 45.55, "text": "还是你"}, {"start": 46.61, "end": 48.33, "text": "还想回到那个笼子里去"}, {"start": 53.44, "end": 54.24, "text": "离她远点"}]}