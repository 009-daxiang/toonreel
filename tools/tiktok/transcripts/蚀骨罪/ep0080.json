{"file": "蚀骨罪-第80集.mp4", "ep": 80, "duration": 70.3, "segments": [{"start": 0.0, "end": 0.8, "text": "你说什么"}, {"start": 1.16, "end": 2.16, "text": "玩命的活"}, {"start": 4.64, "end": 5.6, "text": "兴许的"}, {"start": 6.0, "end": 6.92, "text": "谁给他的权利"}, {"start": 6.92, "end": 8.44, "text": "给简同安排这种金主"}, {"start": 13.5, "end": 14.54, "text": "谁让你自作主张"}, {"start": 14.54, "end": 15.62, "text": "给简同安排工作的"}, {"start": 15.98, "end": 16.74, "text": "他还病着"}, {"start": 17.34, "end": 18.46, "text": "经过我允许了吗"}, {"start": 18.9, "end": 19.5, "text": "孟姐"}, {"start": 20.02, "end": 21.78, "text": "我好歹是公关部的经理"}, {"start": 23.11, "end": 23.87, "text": "不会连调度"}, {"start": 23.87, "end": 25.19, "text": "自己手下员工的权利"}, {"start": 25.19, "end": 25.87, "text": "都没有吧"}, {"start": 27.41, "end": 28.05, "text": "许经理"}, {"start": 28.65, "end": 29.89, "text": "明天你不用来上班了"}, {"start": 30.21, "end": 31.13, "text": "后天也不用来"}, {"start": 31.53, "end": 32.81, "text": "大后天同样不需要来"}, {"start": 33.13, "end": 34.01, "text": "你允许"}, {"start": 34.41, "end": 35.17, "text": "明白吗"}, {"start": 35.81, "end": 36.41, "text": "苏梦"}, {"start": 39.29, "end": 40.97, "text": "你把一个正在生病的员工"}, {"start": 40.97, "end": 43.05, "text": "调到六楼杜丽群的包厢里去了"}, {"start": 44.09, "end": 45.81, "text": "外人不知道杜丽群的德性"}, {"start": 46.92, "end": 47.8, "text": "你也不知道"}, {"start": 48.28, "end": 49.64, "text": "杜丽群玩的疯"}, {"start": 50.16, "end": 51.84, "text": "手底下死过多少人了"}, {"start": 53.65, "end": 54.73, "text": "你让他给杜丽群"}, {"start": 54.73, "end": 56.17, "text": "表演真人逆水"}, {"start": 56.86, "end": 58.54, "text": "简同是真的逆水了"}, {"start": 59.14, "end": 61.1, "text": "那容器出了故障打不开"}, {"start": 61.71, "end": 62.79, "text": "你知道最后是谁"}, {"start": 62.79, "end": 63.95, "text": "把她救出来的吗"}]}