{"file": "蚀骨罪-第107集.mp4", "ep": 107, "duration": 55.5, "segments": [{"start": 0.59, "end": 2.31, "text": "你这话又是什么意思"}, {"start": 2.31, "end": 3.91, "text": "我又说错什么了吗"}, {"start": 3.91, "end": 4.91, "text": "算了"}, {"start": 4.91, "end": 6.75, "text": "如果我哪里得罪了你"}, {"start": 6.75, "end": 8.31, "text": "我给你道歉"}, {"start": 9.7, "end": 11.38, "text": "珍妮"}, {"start": 11.38, "end": 12.53, "text": "你要干吗"}, {"start": 12.53, "end": 13.65, "text": "许经理"}, {"start": 13.65, "end": 15.13, "text": "简同他看不起我"}, {"start": 15.13, "end": 16.09, "text": "吵吵吵"}, {"start": 16.09, "end": 17.41, "text": "成天只知道吵"}, {"start": 17.41, "end": 18.29, "text": "珍妮"}, {"start": 18.29, "end": 19.97, "text": "你前两天刚和安妮吵过"}, {"start": 19.97, "end": 21.69, "text": "现在又和简同吵"}, {"start": 21.69, "end": 23.01, "text": "在东黄做事"}, {"start": 23.01, "end": 25.01, "text": "安分守己是第一"}, {"start": 25.01, "end": 26.63, "text": "别再挑事"}, {"start": 26.63, "end": 40.26, "text": "简小姐"}, {"start": 40.26, "end": 41.66, "text": "我们又见面吗"}, {"start": 41.66, "end": 44.9, "text": "是你啊"}, {"start": 45.74, "end": 50.65, "text": "先生有事可以先走"}, {"start": 50.65, "end": 52.64, "text": "先生是有什么事吗"}, {"start": 52.64, "end": 54.0, "text": "我有这个荣幸"}, {"start": 54.0, "end": 55.48, "text": "邀请简小姐上车吗"}]}