{"file": "末世轮回：我以尸躯化神明-第85集.mp4", "ep": 85, "duration": 44.1, "segments": [{"start": 0.0, "end": 1.0, "text": "二队队长"}, {"start": 1.0, "end": 1.8, "text": "无心"}, {"start": 2.3, "end": 3.6, "text": "真是知人之面"}, {"start": 3.6, "end": 4.4, "text": "不知心啊"}, {"start": 4.4, "end": 5.3, "text": "什么心人"}, {"start": 5.3, "end": 6.0, "text": "这么好看"}, {"start": 6.0, "end": 7.4, "text": "让人都要犯罪了"}, {"start": 7.4, "end": 8.3, "text": "确实漂亮"}, {"start": 8.3, "end": 9.6, "text": "来了第一天昏迷时"}, {"start": 9.6, "end": 10.7, "text": "身上没几块布"}, {"start": 10.7, "end": 11.3, "text": "那身材"}, {"start": 11.3, "end": 12.5, "text": "烙得很"}, {"start": 12.5, "end": 13.5, "text": "这件事"}, {"start": 13.5, "end": 15.04, "text": "不是这样"}, {"start": 21.96, "end": 23.06, "text": "发生什么了"}, {"start": 23.06, "end": 24.52, "text": "你们没找到物资"}, {"start": 25.21, "end": 26.31, "text": "找到了"}, {"start": 26.31, "end": 27.41, "text": "苏神"}, {"start": 27.41, "end": 28.31, "text": "带我们去仓库"}, {"start": 28.98, "end": 30.08, "text": "还有冰柜在那"}, {"start": 30.08, "end": 31.2, "text": "那在哪呢"}, {"start": 31.2, "end": 38.71, "text": "用这个不扛放"}, {"start": 39.31, "end": 41.21, "text": "大家一人一贯"}]}