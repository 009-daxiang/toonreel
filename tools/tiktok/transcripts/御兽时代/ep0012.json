{"file": "御兽时代-第12集.mp4", "ep": 12, "duration": 137.7, "segments": [{"start": 36.21, "end": 37.49, "text": "成长等级又生二段"}, {"start": 37.49, "end": 38.09, "text": "过去"}, {"start": 38.09, "end": 39.49, "text": "不仅半天就生到又生二段"}, {"start": 39.49, "end": 40.73, "text": "竟然还觉醒了新的技能"}, {"start": 40.73, "end": 42.21, "text": "空间系宠授本该六阶以上"}, {"start": 42.21, "end": 43.61, "text": "搏筋自制才能觉醒技能"}, {"start": 43.61, "end": 45.17, "text": "可青铜低级又生二段的选舞"}, {"start": 45.17, "end": 46.25, "text": "竟然直接打破常理"}, {"start": 46.25, "end": 47.21, "text": "不仅自成空间"}, {"start": 47.21, "end": 48.85, "text": "而且还能存放活物与人类"}, {"start": 48.85, "end": 50.13, "text": "在野外可以安心睡觉"}, {"start": 50.13, "end": 51.33, "text": "还能潜入绝地"}, {"start": 51.33, "end": 52.45, "text": "空间系果然"}, {"start": 53.7, "end": 54.58, "text": "薇薇"}, {"start": 54.58, "end": 56.5, "text": "你知道精英班的挑战内容吗"}, {"start": 56.5, "end": 62.4, "text": "林沐"}, {"start": 62.4, "end": 65.02, "text": "你想参加转班挑战"}, {"start": 65.02, "end": 66.98, "text": "难道你们不想"}, {"start": 66.98, "end": 67.94, "text": "想是想"}, {"start": 67.94, "end": 68.98, "text": "但感觉没戏"}, {"start": 68.98, "end": 69.82, "text": "确实"}, {"start": 69.82, "end": 70.94, "text": "我看了挑战内容"}, {"start": 71.02, "end": 71.9, "text": "超级难"}, {"start": 71.9, "end": 73.06, "text": "我感觉那个挑战"}, {"start": 73.06, "end": 74.78, "text": "根本就是为了难为人而存在的"}, {"start": 75.99, "end": 78.11, "text": "你们倒是先说说挑战内容啊"}, {"start": 78.11, "end": 80.6, "text": "挑战内容是打雷台"}, {"start": 80.6, "end": 81.76, "text": "击败雷主"}, {"start": 81.76, "end": 83.44, "text": "或者在雷主的攻势下"}, {"start": 83.44, "end": 84.68, "text": "坚持一刻钟不败"}, {"start": 84.68, "end": 86.04, "text": "就算过关"}, {"start": 86.04, "end": 87.24, "text": "雷主很强吗"}, {"start": 87.24, "end": 88.12, "text": "雷主的宠授"}, {"start": 88.12, "end": 90.12, "text": "是一只又生三段的兵甲狼"}, {"start": 90.12, "end": 91.76, "text": "能攻击预售室本人吗"}, {"start": 91.76, "end": 93.16, "text": "当然不能"}, {"start": 93.16, "end": 95.51, "text": "知道了"}, {"start": 95.51, "end": 96.11, "text": "你干吗去"}, {"start": 96.11, "end": 96.87, "text": "马上上课了"}, {"start": 96.87, "end": 98.19, "text": "第一届可是礼班的课"}, {"start": 98.19, "end": 101.41, "text": "去挑战"}, {"start": 101.41, "end": 102.17, "text": "我靠"}, {"start": 102.17, "end": 103.29, "text": "去挑战"}, {"start": 103.29, "end": 104.57, "text": "林沐这么自信吗"}, {"start": 104.65, "end": 105.57, "text": "想那么多干吗"}, {"start": 105.57, "end": 106.61, "text": "去看看不就知道了"}, {"start": 106.61, "end": 114.34, "text": "我也去"}, {"start": 114.34, "end": 115.38, "text": "你们干什么"}, {"start": 115.38, "end": 116.34, "text": "马上上课了"}, {"start": 116.34, "end": 117.38, "text": "你们还往外跑"}, {"start": 117.38, "end": 118.62, "text": "这是打算造反了"}, {"start": 118.62, "end": 119.3, "text": "礼班"}, {"start": 119.3, "end": 120.34, "text": "林沐去转班挑战了"}, {"start": 120.34, "end": 121.46, "text": "我们想去看看"}, {"start": 121.46, "end": 122.74, "text": "转班挑战"}, {"start": 122.74, "end": 123.54, "text": "你们没骗我"}, {"start": 123.54, "end": 123.9, "text": "礼班"}, {"start": 123.9, "end": 124.74, "text": "我们吃了熊心包子蛋"}, {"start": 124.74, "end": 125.38, "text": "也不敢骗你啊"}, {"start": 125.38, "end": 126.02, "text": "林沐真的去了"}, {"start": 126.02, "end": 127.1, "text": "你就让我们去看看吧"}, {"start": 127.1, "end": 128.62, "text": "学校学生们分批觉醒"}, {"start": 128.62, "end": 129.58, "text": "转班挑战至今"}, {"start": 129.58, "end": 130.82, "text": "还无人能够成功"}, {"start": 130.82, "end": 131.74, "text": "我倒要看看"}, {"start": 131.74, "end": 133.58, "text": "林沐到底能不能创造奇迹"}, {"start": 133.58, "end": 134.22, "text": "好"}, {"start": 134.22, "end": 135.22, "text": "那就去看看"}]}