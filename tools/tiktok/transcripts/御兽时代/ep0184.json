{"file": "御兽时代-第184集.mp4", "ep": 184, "duration": 54.3, "segments": [{"start": 0.32, "end": 1.32, "text": "我们想清楚了"}, {"start": 4.43, "end": 5.63, "text": "这是军备采购单"}, {"start": 6.19, "end": 7.55, "text": "人均约120万"}, {"start": 8.26, "end": 9.26, "text": "若资金紧张"}, {"start": 9.7, "end": 10.46, "text": "我先垫上"}, {"start": 20.2, "end": 20.88, "text": "还怕吗"}, {"start": 21.08, "end": 21.6, "text": "不怕"}, {"start": 22.08, "end": 22.8, "text": "入校之前"}, {"start": 22.88, "end": 25.08, "text": "我跟着高阶导师去过一次低阶秘境"}, {"start": 25.32, "end": 26.4, "text": "还见到过通灵草"}, {"start": 27.71, "end": 28.63, "text": "通灵草"}, {"start": 29.51, "end": 31.43, "text": "那可是炼制通灵单的核心材料"}, {"start": 31.51, "end": 32.03, "text": "没错"}, {"start": 32.03, "end": 32.83, "text": "一枚通灵单"}, {"start": 32.83, "end": 33.91, "text": "可以把宠寿高级技能"}, {"start": 33.91, "end": 35.31, "text": "从入门修炼到熟炼的时间"}, {"start": 35.31, "end": 36.23, "text": "直接缩短一半"}, {"start": 36.47, "end": 37.23, "text": "大厦商城"}, {"start": 37.23, "end": 38.79, "text": "常年挂着千万悬赏收购"}, {"start": 39.94, "end": 40.9, "text": "通灵草"}, {"start": 41.68, "end": 42.8, "text": "价值千万"}, {"start": 42.84, "end": 44.44, "text": "逆天改命的破街神草"}, {"start": 45.46, "end": 46.42, "text": "若是能在秘境中"}, {"start": 46.42, "end": 47.46, "text": "奪得这等神药"}, {"start": 48.02, "end": 49.02, "text": "不仅小白的水物"}, {"start": 49.02, "end": 49.94, "text": "能光速大成"}, {"start": 50.46, "end": 52.02, "text": "更将彻底跨越阶层"}]}