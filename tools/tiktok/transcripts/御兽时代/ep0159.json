{"file": "御兽时代-第159集.mp4", "ep": 159, "duration": 53.0, "segments": [{"start": 0.0, "end": 3.36, "text": "继分榜第38名 朱映诚登台"}, {"start": 10.48, "end": 11.36, "text": "又生八段"}, {"start": 11.56, "end": 13.28, "text": "朱映诚的宠寿是又生八段"}, {"start": 13.28, "end": 14.22, "text": "快看"}, {"start": 14.22, "end": 15.38, "text": "挑战者召唤出来的"}, {"start": 15.38, "end": 19.98, "text": "竟然也是又生八段"}, {"start": 22.9, "end": 24.1, "text": "自38名起"}, {"start": 24.46, "end": 25.94, "text": "全员都是又生八段"}, {"start": 26.38, "end": 28.18, "text": "竞争果然越来越残酷了"}, {"start": 28.18, "end": 30.26, "text": "继分榜第四名 碧云景"}, {"start": 30.46, "end": 32.02, "text": "上台接受挑战"}, {"start": 32.34, "end": 33.54, "text": "挑战者古希"}, {"start": 33.62, "end": 34.82, "text": "上台挑战"}, {"start": 46.02, "end": 47.46, "text": "这两人召唤出的宠寿"}, {"start": 47.46, "end": 49.1, "text": "已经不仅仅是又生八段了"}, {"start": 49.26, "end": 50.9, "text": "是极其罕见的西游宠寿"}]}