{"file": "御兽时代-第103集.mp4", "ep": 103, "duration": 59.0, "segments": [{"start": 1.1, "end": 2.06, "text": "战力榜第四"}, {"start": 2.42, "end": 3.94, "text": "孝草榜第八的王昊来了"}, {"start": 7.25, "end": 7.81, "text": "若鱼"}, {"start": 7.97, "end": 8.85, "text": "能来给等你啊"}, {"start": 9.17, "end": 9.97, "text": "王昊学长"}, {"start": 10.13, "end": 11.65, "text": "我好像跟你说过很多次了"}, {"start": 11.81, "end": 12.73, "text": "我们没那么熟"}, {"start": 12.89, "end": 14.09, "text": "请你称呼我的全名"}, {"start": 15.35, "end": 16.39, "text": "能亏我个记性"}, {"start": 16.55, "end": 17.55, "text": "也寄头蒙寄他来"}, {"start": 17.75, "end": 18.71, "text": "武汤我一定寄了"}, {"start": 18.99, "end": 20.11, "text": "我记得你上一次"}, {"start": 20.27, "end": 21.15, "text": "也是这么说的"}, {"start": 21.87, "end": 22.35, "text": "死吧"}, {"start": 22.47, "end": 23.43, "text": "打开我最近费忙"}, {"start": 23.51, "end": 24.87, "text": "死咖港贵我都蒙寄他了"}, {"start": 24.95, "end": 25.67, "text": "实在对不起"}, {"start": 25.75, "end": 26.99, "text": "我保证武汤再压吧为了"}, {"start": 27.23, "end": 28.27, "text": "林若鱼 我想"}, {"start": 28.39, "end": 28.99, "text": "王昊"}, {"start": 29.51, "end": 30.79, "text": "我现在有很重要的事"}, {"start": 31.07, "end": 32.07, "text": "不希望被人打扰"}, {"start": 32.19, "end": 32.79, "text": "明白吗"}, {"start": 34.18, "end": 35.78, "text": "好 我不打扰"}, {"start": 38.23, "end": 39.07, "text": "能让林大笑话"}, {"start": 39.15, "end": 40.47, "text": "一反常态如此冷烈"}, {"start": 40.94, "end": 42.3, "text": "他等的人绝对不一般"}, {"start": 46.5, "end": 47.18, "text": "看天空"}, {"start": 47.46, "end": 48.3, "text": "那是亲民客"}, {"start": 48.5, "end": 49.7, "text": "应该是有心声道了"}, {"start": 51.57, "end": 53.09, "text": "若鱼 我演花了吗"}, {"start": 53.29, "end": 54.69, "text": "林大笑话竟然笑了"}, {"start": 55.09, "end": 55.73, "text": "林墨"}, {"start": 56.09, "end": 56.85, "text": "你来了呀"}]}