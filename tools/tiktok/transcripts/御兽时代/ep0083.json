{"file": "御兽时代-第83集.mp4", "ep": 83, "duration": 59.7, "segments": [{"start": 0.02, "end": 1.1, "text": "情願學復勒"}, {"start": 1.1, "end": 3.26, "text": "權貴的簡子森都舉到一堆了"}, {"start": 3.26, "end": 5.46, "text": "派命直接決定資源砸個墳"}, {"start": 5.46, "end": 7.5, "text": "林墨要是創得過第六關"}, {"start": 7.5, "end": 9.54, "text": "如雪明池就能殺盡總有"}, {"start": 9.54, "end": 10.62, "text": "對他以後的發展"}, {"start": 10.62, "end": 11.7, "text": "那影視巴斯得半"}, {"start": 11.7, "end": 12.74, "text": "豪出打的恨"}, {"start": 12.74, "end": 15.86, "text": "林墨在施戰裡頭確實能越級作戰"}, {"start": 15.86, "end": 18.42, "text": "但他從來沒跟有生氣段戰鬥過"}, {"start": 18.42, "end": 19.94, "text": "我也不敢確定哦"}, {"start": 19.94, "end": 21.5, "text": "我對他有信心"}, {"start": 21.5, "end": 22.46, "text": "三個月六段"}, {"start": 22.46, "end": 24.1, "text": "三分鐘破第五關"}, {"start": 24.1, "end": 26.54, "text": "這小子已經打破了兩次常力"}, {"start": 26.54, "end": 27.46, "text": "這次"}, {"start": 27.62, "end": 30.46, "text": "我也覺得林墨能創造第三個奇蹟"}, {"start": 30.46, "end": 31.3, "text": "通知一下"}, {"start": 31.3, "end": 33.74, "text": "紅色光店裡頭有好多人推出一進了"}, {"start": 33.74, "end": 35.46, "text": "紅色共17,226人"}, {"start": 35.46, "end": 37.02, "text": "已推出10,350人"}, {"start": 37.02, "end": 38.42, "text": "在場6,876人"}, {"start": 38.42, "end": 41.49, "text": "白色光點34,550人"}, {"start": 41.49, "end": 43.09, "text": "開靠都24分鐘了"}, {"start": 43.09, "end": 44.85, "text": "第一關都還沒果到"}, {"start": 44.85, "end": 45.97, "text": "這一萬多好人"}, {"start": 45.97, "end": 48.09, "text": "基本就跟高登學復墨被撒自緣分了"}, {"start": 48.09, "end": 49.01, "text": "我一二囉"}, {"start": 49.01, "end": 50.17, "text": "陪一半的淘汰率"}, {"start": 50.17, "end": 51.33, "text": "與手勢偷一道坎"}, {"start": 51.33, "end": 54.46, "text": "歷來都牢殘苦勒"}, {"start": 54.46, "end": 55.5, "text": "藍色第六關"}, {"start": 55.5, "end": 57.06, "text": "林墨他踏進第六關了"}]}