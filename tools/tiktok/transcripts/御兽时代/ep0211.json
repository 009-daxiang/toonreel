{"file": "御兽时代-第211集.mp4", "ep": 211, "duration": 65.9, "segments": [{"start": 6.28, "end": 6.92, "text": "景山林"}, {"start": 15.46, "end": 17.58, "text": "是刚才黑夜里的两头九段凶手"}, {"start": 17.98, "end": 18.74, "text": "截断前路"}, {"start": 21.13, "end": 21.69, "text": "不能退"}, {"start": 22.33, "end": 23.61, "text": "若雨还在山崖挖草"}, {"start": 23.97, "end": 24.69, "text": "退无可退"}, {"start": 29.94, "end": 31.66, "text": "价值九位树的逆天之宝"}, {"start": 32.35, "end": 34.87, "text": "今晚就看你能不能引这帮畜生咬死同种"}, {"start": 35.43, "end": 46.62, "text": "你强行麻痹独自"}]}