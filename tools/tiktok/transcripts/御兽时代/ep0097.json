{"file": "御兽时代-第97集.mp4", "ep": 97, "duration": 68.2, "segments": [{"start": 0.62, "end": 2.02, "text": "谢谢啊 谢谢啊"}, {"start": 4.84, "end": 6.52, "text": "你们都围在我家楼下干吗"}, {"start": 6.76, "end": 7.36, "text": "你讲"}, {"start": 7.52, "end": 8.96, "text": "同学 你就是林墨吧"}, {"start": 9.24, "end": 9.92, "text": "完蛋"}, {"start": 10.43, "end": 11.95, "text": "她就是林墨 快追"}, {"start": 16.86, "end": 18.54, "text": "林墨同学 我是穿您日报的"}, {"start": 18.54, "end": 20.18, "text": "请问拿到状元后 心情如何"}, {"start": 20.34, "end": 21.14, "text": "林墨同学"}, {"start": 21.14, "end": 22.26, "text": "我是穿您商城的"}, {"start": 22.26, "end": 23.26, "text": "想请你代言"}, {"start": 23.66, "end": 24.7, "text": "你们找林墨"}, {"start": 24.7, "end": 25.82, "text": "围着我做什么"}, {"start": 25.98, "end": 27.46, "text": "我什么时候说过我是林墨"}, {"start": 28.5, "end": 29.74, "text": "你不是林墨 你跑什么"}, {"start": 30.06, "end": 31.38, "text": "你们追我我能不跑吗"}, {"start": 31.38, "end": 32.66, "text": "那林墨呢 我怎么知道"}, {"start": 42.38, "end": 42.98, "text": "小墨"}, {"start": 43.81, "end": 45.33, "text": "你真的是今年的状元"}, {"start": 45.92, "end": 47.84, "text": "是 我就是今年的状元"}, {"start": 48.24, "end": 50.04, "text": "老婆 状元"}, {"start": 50.32, "end": 51.76, "text": "我们儿子是状元"}, {"start": 51.76, "end": 54.08, "text": "儿子亲口说的 不会有假"}, {"start": 55.01, "end": 57.21, "text": "我去买菜 今天好好庆祝一下"}, {"start": 57.21, "end": 59.17, "text": "买什么菜 儿子成状元了"}, {"start": 59.17, "end": 61.05, "text": "去大侠商城吃最贵的大餐"}, {"start": 61.49, "end": 63.53, "text": "应该是黄金会员卡的事有结果了"}, {"start": 64.01, "end": 66.25, "text": "只是不知道结果到底如何"}]}