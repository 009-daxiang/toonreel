{"file": "御兽时代-第130集.mp4", "ep": 130, "duration": 59.4, "segments": [{"start": 11.7, "end": 12.5, "text": "胡老师"}, {"start": 12.5, "end": 13.3, "text": "好多野狼"}, {"start": 13.3, "end": 14.62, "text": "我们该怎么办啊"}, {"start": 14.62, "end": 15.54, "text": "快向学府求救"}, {"start": 15.54, "end": 16.5, "text": "要死人了"}, {"start": 19.26, "end": 20.78, "text": "学府实讯必有考量"}, {"start": 20.78, "end": 22.14, "text": "这绝非偶发意外"}, {"start": 22.14, "end": 23.02, "text": "而是魔力新生的"}, {"start": 23.02, "end": 24.54, "text": "第一道生死杀局"}, {"start": 24.54, "end": 25.98, "text": "我打算去对付这些野狼"}, {"start": 25.98, "end": 31.04, "text": "你们要和我一起吗"}, {"start": 31.04, "end": 33.16, "text": "每一届象牙堂里走出的菜鸟"}, {"start": 33.16, "end": 35.36, "text": "面对真正的荒野与煎麻立爪"}, {"start": 35.36, "end": 36.88, "text": "皆是这般不堪一击"}, {"start": 36.88, "end": 37.68, "text": "难道就真没有"}, {"start": 37.68, "end": 44.06, "text": "一人敢拔刀迎战吗"}, {"start": 44.06, "end": 45.34, "text": "沉稳如山"}, {"start": 45.34, "end": 47.14, "text": "战术站位无可挑剔"}, {"start": 47.14, "end": 48.18, "text": "这小子"}, {"start": 48.18, "end": 49.86, "text": "简直是个绝世奇才"}]}