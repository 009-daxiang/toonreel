{"file": "御兽时代-第160集.mp4", "ep": 160, "duration": 54.3, "segments": [{"start": 1.78, "end": 8.29, "text": "双头狼 冰水双属性"}, {"start": 8.29, "end": 9.29, "text": "黄金低级又升八段"}, {"start": 9.29, "end": 11.29, "text": "凤伟蝶 毒系黄金中基"}, {"start": 11.29, "end": 12.29, "text": "独占蝶舞至换"}, {"start": 12.29, "end": 14.29, "text": "伪制三大高级技能"}, {"start": 14.29, "end": 16.77, "text": "原是最顶级的稀有战创"}, {"start": 16.77, "end": 17.77, "text": "是蝶舞"}, {"start": 17.77, "end": 29.1, "text": "不带剧毒减速"}, {"start": 29.1, "end": 30.1, "text": "千万不要占到"}, {"start": 30.1, "end": 31.1, "text": "李墨"}, {"start": 31.1, "end": 38.86, "text": "碧云锦还有挑战你的机会"}, {"start": 38.86, "end": 40.86, "text": "若是遇上你有胜算吗"}, {"start": 40.86, "end": 41.86, "text": "不好说"}, {"start": 41.86, "end": 42.86, "text": "胜负要打过才知道"}, {"start": 42.86, "end": 43.86, "text": "免贼这种决定怪物"}, {"start": 43.86, "end": 49.16, "text": "竟然说打过才知道"}, {"start": 49.16, "end": 51.16, "text": "难道他手握取胜的底牌"}]}