{"file": "御兽时代-第63集.mp4", "ep": 63, "duration": 70.9, "segments": [{"start": 2.06, "end": 2.98, "text": "李莫同学"}, {"start": 2.98, "end": 4.46, "text": "不知道你有沒有興趣"}, {"start": 4.46, "end": 5.5, "text": "当我们大厦商城"}, {"start": 5.5, "end": 6.58, "text": "今年的代言人"}, {"start": 7.1, "end": 7.86, "text": "代言人"}, {"start": 8.38, "end": 9.81, "text": "可我现在还不是壮远"}, {"start": 10.99, "end": 12.31, "text": "等你成为壮远"}, {"start": 12.55, "end": 13.99, "text": "想找你代言的公司"}, {"start": 13.99, "end": 15.23, "text": "怕是会把你家的门槛"}, {"start": 15.23, "end": 15.99, "text": "都踏破"}, {"start": 16.51, "end": 19.04, "text": "所以"}, {"start": 19.56, "end": 20.92, "text": "我想代表我们公司"}, {"start": 21.62, "end": 23.06, "text": "提前锁定这个机会"}, {"start": 23.62, "end": 31.74, "text": "先说说你的条件吧"}, {"start": 33.23, "end": 35.31, "text": "代言费八百万七线一年"}, {"start": 35.79, "end": 36.67, "text": "同时你将成为"}, {"start": 36.67, "end": 38.35, "text": "我们大厦商城白鹰会员"}, {"start": 38.55, "end": 39.99, "text": "龙国所有门店通用"}, {"start": 40.43, "end": 41.79, "text": "在原有优惠基础上"}, {"start": 42.11, "end": 43.59, "text": "额外享受九折福利"}, {"start": 43.79, "end": 45.03, "text": "会员有效期三年"}, {"start": 46.26, "end": 47.86, "text": "去年壮员的代言费是多少"}, {"start": 48.18, "end": 49.14, "text": "去年的壮员代言"}, {"start": 49.14, "end": 50.26, "text": "被别家公司拿下"}, {"start": 50.46, "end": 51.98, "text": "最终签约价一千二百万"}, {"start": 53.59, "end": 54.91, "text": "我们商城预算有限"}, {"start": 55.07, "end": 56.51, "text": "如果跟风高价征价"}, {"start": 56.63, "end": 57.67, "text": "最终只会亏本"}, {"start": 58.19, "end": 58.71, "text": "所以"}, {"start": 59.07, "end": 60.27, "text": "你一定要考虑清楚"}, {"start": 61.05, "end": 62.77, "text": "因为一旦选择和我们合作"}, {"start": 63.09, "end": 64.25, "text": "你在代言费方面"}, {"start": 64.49, "end": 65.57, "text": "肯定是会吃亏的"}, {"start": 66.58, "end": 67.66, "text": "你们的这个代言费"}, {"start": 67.94, "end": 68.74, "text": "不能再加了吗"}]}