{"file": "御兽时代-第200集.mp4", "ep": 200, "duration": 64.2, "segments": [{"start": 14.51, "end": 15.35, "text": "有没有受伤"}, {"start": 15.35, "end": 16.03, "text": "毫发无损"}, {"start": 16.03, "end": 16.95, "text": "让你担心了"}, {"start": 16.95, "end": 18.35, "text": "你要是再不回来"}, {"start": 18.35, "end": 20.71, "text": "某人怕是要持剑杀出去了"}, {"start": 20.71, "end": 22.27, "text": "说一下今晚的收获"}, {"start": 22.27, "end": 23.59, "text": "我从萧敏小队手中"}, {"start": 23.59, "end": 25.39, "text": "缴获5具高阶凶兽尸体"}, {"start": 25.39, "end": 27.31, "text": "外加一株千万级的生结草"}, {"start": 27.31, "end": 28.43, "text": "按照我们的规矩"}, {"start": 28.43, "end": 30.67, "text": "扣除盈盈固定百分之五奶妈氛锐"}, {"start": 30.67, "end": 31.91, "text": "其余收获归我个人"}, {"start": 31.91, "end": 32.83, "text": "你们有没有意义"}, {"start": 32.83, "end": 34.19, "text": "全城都是你孤身涉险"}, {"start": 34.19, "end": 34.95, "text": "处理收割"}, {"start": 34.95, "end": 36.03, "text": "我们没有任何意见"}, {"start": 36.03, "end": 37.35, "text": "这百分之五我不能要"}, {"start": 37.35, "end": 38.67, "text": "生结草价值千万"}, {"start": 38.67, "end": 39.55, "text": "我寸功未力"}, {"start": 39.55, "end": 40.39, "text": "受之有愧"}, {"start": 40.55, "end": 41.87, "text": "说好的规矩绝不能废"}, {"start": 41.87, "end": 42.75, "text": "奶妈的存在本身"}, {"start": 42.75, "end": 43.95, "text": "就是战队的底气"}, {"start": 43.95, "end": 45.15, "text": "队伍无伤用不上你"}, {"start": 45.15, "end": 46.47, "text": "才是小队最大的姓氏"}, {"start": 46.47, "end": 47.39, "text": "安心拿着"}, {"start": 47.39, "end": 48.39, "text": "谢谢队长"}, {"start": 48.39, "end": 49.67, "text": "都抓紧进帐篷休息吧"}, {"start": 49.67, "end": 50.75, "text": "今晚我来职业"}]}