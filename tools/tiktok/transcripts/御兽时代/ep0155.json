{"file": "御兽时代-第155集.mp4", "ep": 155, "duration": 53.9, "segments": [{"start": 0.02, "end": 2.42, "text": "绑上每人最多接受三次挑战"}, {"start": 2.42, "end": 4.18, "text": "手绑三次即彻底锁绑"}, {"start": 4.18, "end": 5.18, "text": "不可再战"}, {"start": 5.18, "end": 5.94, "text": "第三"}, {"start": 5.94, "end": 7.46, "text": "若多人挑战同一人"}, {"start": 7.46, "end": 9.06, "text": "按自身硬实力排汇"}, {"start": 9.06, "end": 10.54, "text": "强者优先"}, {"start": 10.54, "end": 11.38, "text": "第四"}, {"start": 11.38, "end": 13.18, "text": "绑上成员一颗互相挑战"}, {"start": 13.18, "end": 15.1, "text": "并享有最高优先权"}, {"start": 15.1, "end": 16.9, "text": "十分钟后挑战赛正式开启"}, {"start": 16.9, "end": 23.8, "text": "地交挑战书"}, {"start": 23.8, "end": 26.4, "text": "一共收到4800多份挑战申请"}, {"start": 26.4, "end": 29.04, "text": "绑上人均收到240份血战书"}, {"start": 29.04, "end": 30.32, "text": "按照实力排序"}, {"start": 30.32, "end": 31.84, "text": "前600位挑战者"}, {"start": 31.84, "end": 32.8, "text": "立刻出列"}, {"start": 32.8, "end": 38.0, "text": "到西侧区域备战"}, {"start": 38.0, "end": 39.2, "text": "没能入选的"}, {"start": 39.2, "end": 41.0, "text": "一个月之后还有机会"}, {"start": 41.0, "end": 43.2, "text": "入选的挑战者也不要骄傲"}, {"start": 43.2, "end": 45.56, "text": "积分榜前200位的真正添交"}, {"start": 45.56, "end": 47.4, "text": "还没有挑选他们的对手"}, {"start": 47.4, "end": 48.2, "text": "现在"}, {"start": 48.2, "end": 50.28, "text": "请榜单再次人员上前"}, {"start": 50.28, "end": 52.28, "text": "提交终极挑战书"}]}