{"file": "御兽时代-第60集.mp4", "ep": 60, "duration": 64.2, "segments": [{"start": 0.3, "end": 2.1, "text": "既然两位也是种子"}, {"start": 2.1, "end": 4.5, "text": "同样享受百分之十的收购优带"}, {"start": 5.87, "end": 7.87, "text": "请依次取出凶兽尸体吧"}, {"start": 13.94, "end": 15.54, "text": "总价104万"}, {"start": 15.54, "end": 18.14, "text": "上幅优带后十幅114万"}, {"start": 18.14, "end": 20.14, "text": "晓得 哪个假窝人"}, {"start": 29.5, "end": 31.1, "text": "总价224万"}, {"start": 31.1, "end": 33.5, "text": "优带上以后十幅246万"}, {"start": 34.15, "end": 34.95, "text": "没意见"}, {"start": 34.95, "end": 36.75, "text": "莫哥 该你了"}, {"start": 37.28, "end": 40.08, "text": "另一次在山里头待了足足二十五天"}, {"start": 40.48, "end": 41.68, "text": "快让我开下宴"}, {"start": 41.68, "end": 43.48, "text": "看他傻子才叫大风骚"}, {"start": 47.98, "end": 49.38, "text": "在小兰山深处"}, {"start": 49.38, "end": 51.98, "text": "孤身斩杀的七十八具凶兽尸体"}, {"start": 51.98, "end": 55.58, "text": "包括整整十多具幼生六段的罕见高级凶兽"}, {"start": 56.05, "end": 57.05, "text": "这笔金额"}, {"start": 57.45, "end": 60.05, "text": "应该足以颠覆在场所有人的认知吧"}]}