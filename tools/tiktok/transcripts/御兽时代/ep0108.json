{"file": "御兽时代-第108集.mp4", "ep": 108, "duration": 71.5, "segments": [{"start": 0.24, "end": 2.48, "text": "什么事啊 突然这么高兴"}, {"start": 3.74, "end": 5.26, "text": "重收的技能升级了"}, {"start": 5.76, "end": 7.16, "text": "那我送你回宿舍吧"}, {"start": 7.16, "end": 8.2, "text": "你休息一会"}, {"start": 8.2, "end": 9.52, "text": "跟舍友熟悉一下"}, {"start": 9.52, "end": 10.76, "text": "晚上我们一起吃饭"}, {"start": 11.26, "end": 12.9, "text": "哪有让你送我的道理"}, {"start": 12.9, "end": 13.7, "text": "我送你"}, {"start": 14.32, "end": 15.92, "text": "顺便认认你们宿舍的门"}, {"start": 15.92, "end": 17.12, "text": "方便以后去找你"}, {"start": 18.04, "end": 18.84, "text": "贫嘴"}, {"start": 18.84, "end": 19.68, "text": "晚上见"}, {"start": 37.71, "end": 39.47, "text": "后天技能成功进阶为"}, {"start": 39.47, "end": 41.71, "text": "归缩 高级 未入门"}, {"start": 42.94, "end": 44.58, "text": "等这个技能练到入门"}, {"start": 44.58, "end": 45.78, "text": "手上还有一张"}, {"start": 45.78, "end": 47.5, "text": "超级归缩等待覆盖呢"}, {"start": 50.58, "end": 51.46, "text": "接下来"}, {"start": 51.62, "end": 53.06, "text": "还是一直练习归缩"}, {"start": 53.06, "end": 53.78, "text": "明白吗"}, {"start": 65.73, "end": 67.17, "text": "看来你已经完全好了"}, {"start": 67.7, "end": 69.06, "text": "去预售空间训练吧"}]}