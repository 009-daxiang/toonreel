{"file": "御兽时代-第48集.mp4", "ep": 48, "duration": 75.0, "segments": [{"start": 2.99, "end": 4.43, "text": "小白 隐匿"}, {"start": 4.43, "end": 9.86, "text": "傷口開裂依然瘋狂反撥"}, {"start": 9.86, "end": 12.12, "text": "兇手一旦拼命"}, {"start": 12.12, "end": 13.92, "text": "完全就是不要命的打法"}, {"start": 13.92, "end": 18.51, "text": "嘿 我在這裡"}, {"start": 18.51, "end": 37.26, "text": "後面的甲殼太硬了"}, {"start": 37.26, "end": 43.43, "text": "小白 水刃攻擊 打他的腿關節"}, {"start": 43.43, "end": 47.2, "text": "果然關節防禦最弱"}, {"start": 47.2, "end": 48.48, "text": "小白 繼續"}, {"start": 48.48, "end": 61.58, "text": "果然 幼生六段的兇手"}, {"start": 61.58, "end": 62.74, "text": "不是那麼好對付的"}, {"start": 62.74, "end": 67.21, "text": "這一戰足足消耗了九次極限水刃"}, {"start": 67.21, "end": 70.13, "text": "若非水靈石大幅提高了成長質量與能量上限"}, {"start": 70.13, "end": 71.93, "text": "面對這種漢不為死的強敵"}, {"start": 71.93, "end": 73.41, "text": "勝負還真未可治"}]}