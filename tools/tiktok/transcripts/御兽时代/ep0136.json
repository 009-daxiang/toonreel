{"file": "御兽时代-第136集.mp4", "ep": 136, "duration": 85.3, "segments": [{"start": 2.26, "end": 3.82, "text": "定位器隨身攜帶"}, {"start": 3.82, "end": 5.02, "text": "切勿遺失"}, {"start": 5.02, "end": 6.82, "text": "我在鄭重告知所有人"}, {"start": 6.82, "end": 8.62, "text": "學府野外實戰訓練"}, {"start": 8.62, "end": 10.46, "text": "設有真實死亡雲鵝"}, {"start": 10.46, "end": 13.83, "text": "很多突發致命危機"}, {"start": 13.83, "end": 15.99, "text": "學府救援也未必來得及感到"}, {"start": 15.99, "end": 17.47, "text": "在這篇秘靈裡"}, {"start": 17.47, "end": 18.87, "text": "你們唯一的靠山"}, {"start": 18.87, "end": 19.87, "text": "只有自己"}, {"start": 19.87, "end": 20.87, "text": "胡老師"}, {"start": 20.87, "end": 22.87, "text": "我 我現在還能退出訓練嗎"}, {"start": 22.87, "end": 23.87, "text": "可以退出"}, {"start": 23.87, "end": 25.71, "text": "但主動放棄時算"}, {"start": 25.71, "end": 27.27, "text": "等同於放棄學籍"}, {"start": 27.27, "end": 28.47, "text": "直接退學"}, {"start": 28.47, "end": 31.55, "text": "考核內容很簡單"}, {"start": 31.55, "end": 33.59, "text": "天亮前趕到東邊集結點"}, {"start": 33.87, "end": 35.31, "text": "抵達順序決定積分"}, {"start": 35.31, "end": 36.83, "text": "遲到者積分為零"}, {"start": 36.83, "end": 39.18, "text": "出發"}, {"start": 39.18, "end": 40.18, "text": "林沫"}, {"start": 40.18, "end": 43.13, "text": "我們幾個繼續一起吧"}, {"start": 43.13, "end": 44.25, "text": "你們覺得"}, {"start": 44.25, "end": 45.25, "text": "學府會設置一個"}, {"start": 45.25, "end": 48.7, "text": "有明顯BUB的關卡嗎"}, {"start": 48.7, "end": 49.7, "text": "不會"}, {"start": 49.7, "end": 51.26, "text": "那就相信我的判斷"}, {"start": 51.26, "end": 56.02, "text": "本輪獨行才是最有機"}, {"start": 56.02, "end": 57.66, "text": "我聽林沫的 自己走"}, {"start": 57.66, "end": 63.16, "text": "我也自己走"}, {"start": 63.16, "end": 64.65, "text": "那我們一起走"}, {"start": 64.65, "end": 73.14, "text": "好"}, {"start": 73.14, "end": 74.26, "text": "夜幕籠招秘靈"}, {"start": 74.26, "end": 75.1, "text": "視野獸組"}, {"start": 75.1, "end": 75.9, "text": "危機伺服"}, {"start": 75.9, "end": 76.9, "text": "暴團看似安穩"}, {"start": 76.9, "end": 78.22, "text": "實則最容易被集體拖累"}, {"start": 78.22, "end": 78.94, "text": "措施先機"}, {"start": 78.94, "end": 80.26, "text": "陷入大範圍兇受圍堵"}, {"start": 80.26, "end": 81.7, "text": "本輪獨行看似冒險"}, {"start": 81.7, "end": 83.7, "text": "實則是最穩妥的破局方式"}]}