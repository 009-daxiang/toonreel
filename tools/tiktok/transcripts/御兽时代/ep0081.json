{"file": "御兽时代-第81集.mp4", "ep": 81, "duration": 98.1, "segments": [{"start": 18.26, "end": 19.06, "text": "去休息吧"}, {"start": 19.06, "end": 20.26, "text": "休息好了 我们继续"}, {"start": 22.63, "end": 25.03, "text": "下一关是幼生七段的最强雷角石"}, {"start": 25.23, "end": 26.91, "text": "越级战斗容不得丝毫大义"}, {"start": 27.15, "end": 28.39, "text": "必须利用修整时间"}, {"start": 28.39, "end": 29.83, "text": "将状态调整至巅峰"}, {"start": 30.23, "end": 34.31, "text": "可惜了"}, {"start": 34.71, "end": 35.79, "text": "大家也不用太失望"}, {"start": 35.79, "end": 37.15, "text": "考不上青园固然可惜"}, {"start": 37.27, "end": 38.47, "text": "但依利莫德层级"}, {"start": 38.47, "end": 40.15, "text": "选一所比起运高一档的血腹"}, {"start": 40.15, "end": 40.91, "text": "还是扩一点"}, {"start": 41.03, "end": 41.91, "text": "李市长说得对"}, {"start": 42.03, "end": 43.11, "text": "是我们期望太高了"}, {"start": 43.43, "end": 44.11, "text": "去年的状元"}, {"start": 44.11, "end": 45.39, "text": "也只是通过第四关而已"}, {"start": 45.51, "end": 46.59, "text": "在对传令来说"}, {"start": 46.59, "end": 48.15, "text": "已经是个很大的进步了"}, {"start": 48.8, "end": 50.48, "text": "总就还是擦了一步嘛"}, {"start": 51.06, "end": 52.66, "text": "任园园通过第三关的"}, {"start": 52.66, "end": 53.74, "text": "用时势多少"}, {"start": 54.26, "end": 55.54, "text": "三分四十七秒四六"}, {"start": 55.78, "end": 57.86, "text": "而元纪录是五分五十四秒七七"}, {"start": 58.22, "end": 60.66, "text": "人缘缘的天赋是加速重售恢复"}, {"start": 60.98, "end": 62.34, "text": "前三关消耗不大"}, {"start": 62.42, "end": 64.02, "text": "便能无缝进入第四关"}, {"start": 64.42, "end": 65.38, "text": "六校顾海宁"}, {"start": 65.54, "end": 66.34, "text": "四校功序"}, {"start": 66.46, "end": 67.38, "text": "九校吕清阳"}, {"start": 67.5, "end": 69.58, "text": "一校傅城里相继进入第三关"}, {"start": 71.36, "end": 73.64, "text": "一校孙磊也成功进入第三关"}, {"start": 73.92, "end": 74.6, "text": "冬小子"}, {"start": 74.92, "end": 76.4, "text": "一小几年不得了啊"}, {"start": 76.72, "end": 77.56, "text": "算上李莫"}, {"start": 77.56, "end": 78.76, "text": "你们已经有三个学生"}, {"start": 78.76, "end": 79.76, "text": "进入第三关了"}, {"start": 80.54, "end": 81.3, "text": "云七八"}, {"start": 81.62, "end": 82.66, "text": "这两个学生的势力"}, {"start": 82.66, "end": 84.46, "text": "比其他宗旨还是擦了一些嘞"}, {"start": 85.16, "end": 85.84, "text": "丽师长"}, {"start": 86.0, "end": 87.28, "text": "我突然想到一个可能"}, {"start": 88.38, "end": 88.94, "text": "什么"}, {"start": 89.46, "end": 91.54, "text": "李莫在底屋管停留了这么久"}, {"start": 91.7, "end": 92.82, "text": "几枚退出秘境"}, {"start": 92.82, "end": 94.06, "text": "也没进入下一关"}, {"start": 94.18, "end": 95.7, "text": "那她会不会实在修正"}]}