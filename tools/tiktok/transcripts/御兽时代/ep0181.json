{"file": "御兽时代-第181集.mp4", "ep": 181, "duration": 53.2, "segments": [{"start": 2.13, "end": 3.13, "text": "秘境"}, {"start": 3.13, "end": 4.85, "text": "黎墨你简直是我亲哥"}, {"start": 4.85, "end": 5.85, "text": "我立刻投入特训"}, {"start": 5.85, "end": 6.89, "text": "绝对不会偷对我后腿"}, {"start": 8.02, "end": 9.74, "text": "最后还是找了这家伙"}, {"start": 9.74, "end": 15.1, "text": "李盈盈已经同意入队"}, {"start": 15.1, "end": 16.78, "text": "五人小队全部极其"}, {"start": 16.78, "end": 20.46, "text": "半天就把人找齐"}, {"start": 20.46, "end": 21.9, "text": "还找到了稀缺治疗系"}, {"start": 21.9, "end": 23.1, "text": "你们进秘境之前"}, {"start": 23.1, "end": 24.7, "text": "一定要把保护收获分配规则"}, {"start": 24.7, "end": 27.03, "text": "学生明白"}, {"start": 27.03, "end": 27.91, "text": "谢谢胡老师"}, {"start": 27.91, "end": 39.98, "text": "这样"}, {"start": 39.98, "end": 42.18, "text": "玄武就突破至幼生九段巅峰了"}, {"start": 42.18, "end": 43.54, "text": "距离正式预受师"}, {"start": 43.54, "end": 44.54, "text": "警察离门一角"}, {"start": 44.54, "end": 46.46, "text": "体内空间也再次翻倍了"}, {"start": 46.46, "end": 48.06, "text": "扩张至64平方米"}, {"start": 48.06, "end": 49.78, "text": "简直堪比一套宽敞舒适的"}, {"start": 49.78, "end": 50.78, "text": "两居室"}]}