{"file": "御兽时代-第91集.mp4", "ep": 91, "duration": 84.1, "segments": [{"start": 2.83, "end": 3.79, "text": "李市长"}, {"start": 3.79, "end": 5.67, "text": "这个就是我们学校头的李墨"}, {"start": 5.67, "end": 6.79, "text": "李墨同学"}, {"start": 6.79, "end": 7.79, "text": "你好呀"}, {"start": 7.79, "end": 9.59, "text": "校得我为傻子来遭逆不"}, {"start": 9.59, "end": 11.01, "text": "李市长好"}, {"start": 11.01, "end": 11.81, "text": "猜到"}, {"start": 11.81, "end": 13.21, "text": "好够玩"}, {"start": 13.21, "end": 14.21, "text": "怎么执行"}, {"start": 14.21, "end": 15.85, "text": "不愧是拿得到状元嘞"}, {"start": 17.93, "end": 18.73, "text": "李市长"}, {"start": 18.73, "end": 20.29, "text": "李墨闯过了几关啊"}, {"start": 20.29, "end": 23.77, "text": "东小张"}, {"start": 23.77, "end": 25.57, "text": "李墨是你们小头的学生"}, {"start": 25.57, "end": 27.69, "text": "这个结果还是你来宣布吗"}, {"start": 28.33, "end": 31.01, "text": "李墨成功闯过密禁第七关"}, {"start": 31.81, "end": 33.41, "text": "第七关"}, {"start": 33.41, "end": 36.11, "text": "成成两万多考生半数哲计第一关"}, {"start": 36.39, "end": 37.91, "text": "我只不在了第四关"}, {"start": 37.91, "end": 40.15, "text": "李墨竟他居然直接杀穿了第七关"}, {"start": 40.79, "end": 41.87, "text": "以前的状元"}, {"start": 41.87, "end": 43.47, "text": "死里面都要给分奖礼"}, {"start": 43.47, "end": 44.59, "text": "但是你的奖礼"}, {"start": 44.59, "end": 46.03, "text": "我们一帮人商量了半天"}, {"start": 46.03, "end": 47.75, "text": "好不容易才相处三个方案"}, {"start": 47.75, "end": 49.03, "text": "但到底用哪个方案"}, {"start": 49.03, "end": 50.35, "text": "我们始终顶不下来"}, {"start": 50.35, "end": 51.83, "text": "所以想来闻闻你的意见"}, {"start": 51.83, "end": 53.35, "text": "不知道是哪三个方案"}, {"start": 53.35, "end": 54.11, "text": "头一个方案"}, {"start": 54.11, "end": 55.71, "text": "世界拉一千万龙城里"}, {"start": 55.71, "end": 56.59, "text": "奖礼你"}, {"start": 56.59, "end": 57.59, "text": "第二个方案"}, {"start": 57.59, "end": 59.71, "text": "给你只一千万的余手资源"}, {"start": 59.71, "end": 60.75, "text": "傻子中类的资源"}, {"start": 60.75, "end": 62.03, "text": "都由你自己选"}, {"start": 62.03, "end": 62.95, "text": "第三个方案"}, {"start": 62.95, "end": 64.79, "text": "给你一套始终心的大屏城"}, {"start": 64.79, "end": 66.35, "text": "再加上八百万龙城笔"}, {"start": 67.97, "end": 68.97, "text": "市中心大屏城"}, {"start": 68.97, "end": 70.05, "text": "市值至少三百万"}, {"start": 70.05, "end": 71.05, "text": "且千金难求"}, {"start": 71.61, "end": 72.97, "text": "防御寿潮对位安全"}, {"start": 72.97, "end": 74.17, "text": "一套房价八百万"}, {"start": 74.17, "end": 75.77, "text": "总价值远畅前两个方案"}, {"start": 75.77, "end": 76.69, "text": "势力显然是想借"}, {"start": 76.69, "end": 78.05, "text": "安顿父母的方式"}, {"start": 78.05, "end": 79.17, "text": "让我留在川寧"}, {"start": 79.17, "end": 80.33, "text": "你好想想一下"}, {"start": 80.33, "end": 81.17, "text": "选拉一个"}]}