{"file": "御兽时代-第34集.mp4", "ep": 34, "duration": 55.4, "segments": [{"start": 15.57, "end": 16.49, "text": "幼生四段"}, {"start": 16.89, "end": 19.53, "text": "水灵石和暗影石让技能质感产生了质变"}, {"start": 20.24, "end": 20.96, "text": "名称"}, {"start": 20.96, "end": 21.56, "text": "玄武"}, {"start": 21.56, "end": 22.4, "text": "绿甲规"}, {"start": 22.4, "end": 23.08, "text": "资质"}, {"start": 23.08, "end": 24.0, "text": "青铜高级"}, {"start": 24.0, "end": 24.84, "text": "八平方米"}, {"start": 24.84, "end": 25.8, "text": "高2.5米"}, {"start": 26.0, "end": 27.76, "text": "连玄武也升到了幼生五段"}, {"start": 27.96, "end": 29.36, "text": "资质跨入青铜高级"}, {"start": 29.88, "end": 31.84, "text": "体内空间变成了一间移动卧室"}, {"start": 34.46, "end": 36.22, "text": "青园学府去年的录取门槛"}, {"start": 36.22, "end": 37.22, "text": "是幼生六段"}, {"start": 37.22, "end": 38.42, "text": "且技能达到熟练"}, {"start": 38.42, "end": 40.14, "text": "大城市的那些顶级天才"}, {"start": 40.14, "end": 42.14, "text": "有着穿您无法起集的顶尖科技"}, {"start": 42.14, "end": 43.42, "text": "与特技资源扶持"}, {"start": 43.42, "end": 44.86, "text": "成长速度简直惊人"}, {"start": 45.84, "end": 47.76, "text": "地域和资源的差距我无法改变"}, {"start": 48.28, "end": 49.76, "text": "但我有神级预售空间"}, {"start": 50.28, "end": 51.16, "text": "我唯一能做的"}, {"start": 51.68, "end": 53.16, "text": "就是拼尽全力的努力"}]}