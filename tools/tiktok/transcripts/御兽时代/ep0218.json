{"file": "御兽时代-第218集.mp4", "ep": 218, "duration": 88.8, "segments": [{"start": 5.39, "end": 6.95, "text": "随手部下的障碍法"}, {"start": 7.35, "end": 8.31, "text": "竟然真的掉出了"}, {"start": 8.31, "end": 9.91, "text": "王者复制重收弹的线索"}, {"start": 12.66, "end": 13.42, "text": "李维先生"}, {"start": 13.82, "end": 14.5, "text": "帮我预约一件"}, {"start": 14.5, "end": 16.42, "text": "三天后的绝密会见客人的密室"}, {"start": 17.49, "end": 18.53, "text": "好的 林同学"}, {"start": 18.65, "end": 19.57, "text": "借时评此卡"}, {"start": 19.57, "end": 21.17, "text": "全天后随时入室"}, {"start": 31.81, "end": 33.65, "text": "一共练成十一份鸡品成药"}, {"start": 33.89, "end": 35.01, "text": "扣除一份佣金"}, {"start": 35.29, "end": 37.17, "text": "这十份成药全数交割"}, {"start": 37.9, "end": 39.1, "text": "多谢李经理费心"}, {"start": 39.58, "end": 61.71, "text": "临时改期定点深夜十点"}, {"start": 62.15, "end": 63.63, "text": "刻意避开人流与监管"}, {"start": 64.11, "end": 65.27, "text": "实际太过奇迹"}, {"start": 65.79, "end": 66.95, "text": "王号的悬赏杀手"}, {"start": 66.95, "end": 68.31, "text": "很可能就在外头犹豫"}, {"start": 68.99, "end": 70.47, "text": "深夜归途凶险万分"}, {"start": 70.95, "end": 72.15, "text": "不过王者资质的逆天"}, {"start": 72.15, "end": 73.19, "text": "诱惑摆在眼前"}, {"start": 73.63, "end": 74.55, "text": "我不入虎穴"}, {"start": 74.91, "end": 75.83, "text": "燕德虎子"}]}