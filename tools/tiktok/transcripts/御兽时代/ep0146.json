{"file": "御兽时代-第146集.mp4", "ep": 146, "duration": 71.2, "segments": [{"start": 0.0, "end": 1.0, "text": "借助他的勢力"}, {"start": 1.24, "end": 2.44, "text": "又有什么可羞耻的"}, {"start": 3.24, "end": 4.44, "text": "就算这算是懦弱"}, {"start": 4.92, "end": 5.8, "text": "也好过某些人"}, {"start": 5.8, "end": 7.0, "text": "连这条路都走不通"}, {"start": 7.28, "end": 8.0, "text": "你说对不对"}, {"start": 8.52, "end": 9.0, "text": "弄"}, {"start": 9.2, "end": 17.66, "text": "那就来养某"}, {"start": 18.22, "end": 19.42, "text": "阿拉战力王底斯"}, {"start": 19.82, "end": 21.46, "text": "擂台之上只要行到机会"}, {"start": 21.58, "end": 22.82, "text": "堂堂正正废掉呢"}, {"start": 23.14, "end": 24.78, "text": "就算林若语也忽不住弄"}, {"start": 25.98, "end": 28.37, "text": "黎墨"}, {"start": 28.57, "end": 29.41, "text": "弄个小慈敗"}, {"start": 35.46, "end": 35.94, "text": "黎墨"}, {"start": 36.26, "end": 36.82, "text": "你没事"}, {"start": 36.98, "end": 37.82, "text": "真的太好了"}, {"start": 38.02, "end": 38.9, "text": "一晚上都没回来"}, {"start": 38.9, "end": 39.9, "text": "我们担心得够呛"}, {"start": 40.72, "end": 41.44, "text": "回来就好"}, {"start": 41.8, "end": 43.7, "text": "你们也没受伤吧"}, {"start": 50.82, "end": 51.34, "text": "怎么了"}, {"start": 54.39, "end": 55.79, "text": "不过楚月莹没能回来"}, {"start": 56.46, "end": 57.86, "text": "她遇到了金池剑鹏"}, {"start": 58.42, "end": 59.34, "text": "人和虫兽"}, {"start": 59.98, "end": 60.54, "text": "都没了"}, {"start": 65.53, "end": 65.93, "text": "这"}, {"start": 66.8, "end": 68.68, "text": "大概就是所谓的人生无常吧"}]}