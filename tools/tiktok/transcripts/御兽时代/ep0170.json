{"file": "御兽时代-第170集.mp4", "ep": 170, "duration": 60.1, "segments": [{"start": 3.51, "end": 4.31, "text": "吳主任"}, {"start": 4.51, "end": 6.11, "text": "看来还是我的眼光更好一点"}, {"start": 6.11, "end": 6.71, "text": "副校长"}, {"start": 6.71, "end": 8.71, "text": "天赋等级宠授等级全方位落后"}, {"start": 8.71, "end": 10.31, "text": "黎墨在战前毫无优势"}, {"start": 10.31, "end": 12.31, "text": "你为何一开始就组定他能赢"}, {"start": 12.31, "end": 14.11, "text": "你忽略了最关键的一环"}, {"start": 14.11, "end": 15.71, "text": "那就是欲受失本人"}, {"start": 15.71, "end": 17.11, "text": "黎墨 F级天赋"}, {"start": 17.11, "end": 18.71, "text": "从小城一路丝杀到绑手"}, {"start": 18.71, "end": 20.31, "text": "心性隐忍 战术决断"}, {"start": 20.31, "end": 21.51, "text": "都属于万中无一"}, {"start": 21.51, "end": 23.71, "text": "他懂得无限放大自己的优势"}, {"start": 24.11, "end": 26.71, "text": "对战局拥有狼一样的恐怖敏锐度"}, {"start": 26.71, "end": 27.51, "text": "吳主任"}, {"start": 27.51, "end": 28.91, "text": "身为战斗系执掌者"}, {"start": 28.91, "end": 30.11, "text": "只中天赋与接位"}, {"start": 30.11, "end": 31.91, "text": "未免落了下城偏迫"}, {"start": 31.91, "end": 33.31, "text": "谢谢校长甜点"}, {"start": 33.31, "end": 37.04, "text": "我受教了"}, {"start": 37.04, "end": 37.84, "text": "桑主任"}, {"start": 37.84, "end": 39.24, "text": "你事才那般堵定"}, {"start": 39.24, "end": 42.04, "text": "当真仅仅是因为看穿了战局细节"}, {"start": 42.04, "end": 43.24, "text": "不全是"}, {"start": 43.24, "end": 45.93, "text": "还有一个原因我之前就告诉过你"}, {"start": 45.93, "end": 47.13, "text": "女人的直觉"}, {"start": 47.13, "end": 47.73, "text": "没错"}, {"start": 47.73, "end": 49.13, "text": "就是女人的直觉"}, {"start": 49.13, "end": 50.13, "text": "战斗刚开打"}, {"start": 50.13, "end": 51.53, "text": "那股感觉就无比强烈"}, {"start": 51.53, "end": 53.9, "text": "黎墨绝对输不了"}]}