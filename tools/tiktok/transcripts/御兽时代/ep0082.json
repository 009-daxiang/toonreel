{"file": "御兽时代-第82集.mp4", "ep": 82, "duration": 55.0, "segments": [{"start": 0.0, "end": 1.04, "text": "高快点"}, {"start": 1.04, "end": 2.16, "text": "猜一下李某那个环境"}, {"start": 2.16, "end": 3.6, "text": "看看第六关的铜道开没开"}, {"start": 3.6, "end": 4.48, "text": "高快点"}, {"start": 4.48, "end": 5.28, "text": "报告市长"}, {"start": 5.28, "end": 6.16, "text": "已经打开了"}, {"start": 6.16, "end": 7.92, "text": "时间是李某进入第五关之后的"}, {"start": 7.92, "end": 10.01, "text": "三分零六秒四十二"}, {"start": 10.01, "end": 11.85, "text": "隐私三分零六秒四二三"}, {"start": 11.85, "end": 12.81, "text": "莫婚我"}, {"start": 12.81, "end": 13.89, "text": "是的"}, {"start": 13.89, "end": 15.25, "text": "三分零六秒四二"}, {"start": 15.25, "end": 16.25, "text": "绝对没错"}, {"start": 16.25, "end": 17.65, "text": "好巴适"}, {"start": 17.65, "end": 18.81, "text": "我们传景中算有人"}, {"start": 18.81, "end": 20.49, "text": "通靠靠近情愿雪赋喽"}, {"start": 20.49, "end": 22.49, "text": "灵力突破隐私真称喽"}, {"start": 22.49, "end": 23.77, "text": "情愿雪赋"}, {"start": 23.77, "end": 25.41, "text": "李某整理主道了"}, {"start": 25.41, "end": 26.41, "text": "传送门一开"}, {"start": 26.41, "end": 28.41, "text": "就说明雷头熊手已经找熟死喽"}, {"start": 28.41, "end": 29.53, "text": "三分零六秒"}, {"start": 29.57, "end": 30.69, "text": "就把巅峰溜断了"}, {"start": 30.69, "end": 31.69, "text": "雷卒式给摘了"}, {"start": 31.69, "end": 33.57, "text": "李某因此拼四大师的奔死"}, {"start": 33.57, "end": 34.33, "text": "昂其老口"}, {"start": 34.33, "end": 36.33, "text": "走进情愿雪赋的大门"}, {"start": 36.33, "end": 37.38, "text": "东小丈"}, {"start": 37.38, "end": 38.46, "text": "恭喜啊"}, {"start": 38.46, "end": 39.06, "text": "老东"}, {"start": 39.06, "end": 39.86, "text": "我要是你"}, {"start": 39.86, "end": 41.86, "text": "这辈子思都无憾喽"}, {"start": 41.86, "end": 42.86, "text": "谢谢你们"}, {"start": 42.86, "end": 43.66, "text": "等考试结束了"}, {"start": 43.66, "end": 44.26, "text": "我主动"}, {"start": 44.26, "end": 45.3, "text": "请大家吃饭嘛"}, {"start": 45.3, "end": 46.9, "text": "饭肯定是要吃嘞"}, {"start": 46.9, "end": 47.9, "text": "不过东小丈"}, {"start": 47.9, "end": 50.52, "text": "我现在更好奇的是"}, {"start": 50.52, "end": 51.4, "text": "李某他到底"}, {"start": 51.4, "end": 52.88, "text": "果不果得到第六关嘛"}]}