{"file": "御兽时代-第144集.mp4", "ep": 144, "duration": 62.6, "segments": [{"start": 5.55, "end": 6.87, "text": "農教李墨子吧"}, {"start": 7.67, "end": 8.47, "text": "你是谁"}, {"start": 9.67, "end": 10.55, "text": "小司总"}, {"start": 10.67, "end": 12.03, "text": "農竟然把您当我"}, {"start": 12.23, "end": 13.63, "text": "我必须要认识你吗"}, {"start": 13.83, "end": 14.51, "text": "好"}, {"start": 14.67, "end": 15.79, "text": "那我就告诉你"}, {"start": 15.95, "end": 17.03, "text": "我叫王浩"}, {"start": 17.27, "end": 18.19, "text": "想起来了"}, {"start": 18.51, "end": 19.71, "text": "你找我有什么事吗"}, {"start": 19.99, "end": 25.74, "text": "离开岭若雨"}, {"start": 26.06, "end": 27.14, "text": "能配不脏议"}, {"start": 27.46, "end": 28.18, "text": "小侧"}, {"start": 28.18, "end": 32.22, "text": "我娘能离开岭若雨"}, {"start": 32.22, "end": 33.3, "text": "弄耳朵龙吗"}, {"start": 36.5, "end": 37.7, "text": "如果我说不能"}, {"start": 38.77, "end": 39.89, "text": "那我保证"}, {"start": 40.21, "end": 41.57, "text": "我会让你在青园学府"}, {"start": 41.57, "end": 42.49, "text": "滴不下去"}, {"start": 43.37, "end": 44.57, "text": "你刚来青园"}, {"start": 44.57, "end": 45.69, "text": "可能爱不了解"}, {"start": 45.89, "end": 46.85, "text": "很了保证"}, {"start": 47.25, "end": 49.13, "text": "一个淡丽榜排名靠前的火伤"}, {"start": 49.13, "end": 50.53, "text": "到底有多大的能量"}, {"start": 50.89, "end": 52.11, "text": "是向点"}, {"start": 52.11, "end": 54.03, "text": "离开岭若雨"}, {"start": 54.23, "end": 55.92, "text": "否则弄一定会偶辉"}]}