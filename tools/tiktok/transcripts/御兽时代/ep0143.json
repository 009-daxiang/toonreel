{"file": "御兽时代-第143集.mp4", "ep": 143, "duration": 55.1, "segments": [{"start": 12.69, "end": 13.49, "text": "金翅箭棚"}, {"start": 13.97, "end": 15.25, "text": "风系五阶高级种族"}, {"start": 15.81, "end": 16.25, "text": "辞职"}, {"start": 16.69, "end": 17.45, "text": "搏金低级"}, {"start": 18.14, "end": 19.86, "text": "而且一出生就自带高级玉丰"}, {"start": 20.1, "end": 20.9, "text": "高级猎空爪"}, {"start": 21.18, "end": 22.82, "text": "和高级风盾三个天赋技能"}, {"start": 24.05, "end": 26.01, "text": "五阶重售诞生搏金辞职的概率"}, {"start": 26.52, "end": 28.48, "text": "比一阶诞生黄金还要渺渺千万倍"}, {"start": 28.84, "end": 30.91, "text": "用自带三项高阶技能"}, {"start": 31.35, "end": 33.19, "text": "更是打破种族常理的绝世级品"}, {"start": 33.82, "end": 34.98, "text": "你的名字里有个棚字"}, {"start": 35.54, "end": 36.14, "text": "能玉丰"}, {"start": 36.46, "end": 38.22, "text": "还是工人速度最快的贵手之一"}, {"start": 38.7, "end": 39.98, "text": "那你以后就叫昆棚好了"}, {"start": 40.7, "end": 41.5, "text": "希望有一天"}, {"start": 42.02, "end": 43.26, "text": "你也能展翅营风起"}, {"start": 43.74, "end": 44.54, "text": "五阶九万里"}, {"start": 45.9, "end": 47.38, "text": "这枚压在担心的透明意识"}, {"start": 47.38, "end": 48.54, "text": "不断散发奇异能量"}, {"start": 48.98, "end": 50.74, "text": "昆棚的逆天资质多半与他有关"}, {"start": 51.38, "end": 52.74, "text": "回城必须查明他的底细"}]}