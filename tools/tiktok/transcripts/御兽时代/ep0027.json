{"file": "御兽时代-第27集.mp4", "ep": 27, "duration": 99.2, "segments": [{"start": 3.38, "end": 4.26, "text": "不用担心"}, {"start": 4.78, "end": 6.78, "text": "不是让你们和我的铁鼓狼打架"}, {"start": 6.78, "end": 8.62, "text": "接下来要做的事情很简单"}, {"start": 8.62, "end": 9.66, "text": "每五人一组"}, {"start": 9.98, "end": 11.78, "text": "依次站到我的铁鼓狼面前来"}, {"start": 11.78, "end": 13.58, "text": "坚持的时间越久越好"}, {"start": 13.78, "end": 14.46, "text": "明白了吗"}, {"start": 15.56, "end": 17.64, "text": "我会让铁鼓狼释放威慑技能"}, {"start": 17.96, "end": 19.84, "text": "你们让宠寿做好抵抗准备"}, {"start": 21.54, "end": 22.1, "text": "林墨"}, {"start": 22.22, "end": 23.82, "text": "你是班长负责记录"}, {"start": 24.02, "end": 24.5, "text": "明白"}, {"start": 27.55, "end": 28.11, "text": "准备"}, {"start": 28.31, "end": 29.19, "text": "我要开始了"}, {"start": 29.55, "end": 30.91, "text": "铁鼓狼威慑"}, {"start": 41.52, "end": 43.04, "text": "七八只幼生一断的幼寿"}, {"start": 43.32, "end": 44.8, "text": "坚持时间竟然比幼生二断"}, {"start": 44.8, "end": 45.44, "text": "还要长得多"}, {"start": 46.34, "end": 47.5, "text": "坚持时间的长短"}, {"start": 47.78, "end": 49.42, "text": "竟然和等级资质完全无关"}, {"start": 50.51, "end": 51.15, "text": "下一组"}, {"start": 52.0, "end": 52.44, "text": "墨哥"}, {"start": 52.52, "end": 52.92, "text": "加油"}, {"start": 53.24, "end": 53.64, "text": "加油"}, {"start": 55.38, "end": 55.94, "text": "徐老师"}, {"start": 56.02, "end": 56.42, "text": "等一下"}, {"start": 56.58, "end": 57.5, "text": "我申请参加测评"}, {"start": 57.94, "end": 58.38, "text": "好吧"}, {"start": 58.7, "end": 60.3, "text": "让你的京风湖做好准备"}, {"start": 65.3, "end": 66.22, "text": "做好准备的话"}, {"start": 66.42, "end": 67.14, "text": "我就开始了"}, {"start": 67.66, "end": 68.22, "text": "铁鼓狼"}, {"start": 68.66, "end": 69.14, "text": "威慑"}, {"start": 70.53, "end": 72.25, "text": "高级威慑与七十压破灵魂"}, {"start": 72.57, "end": 74.17, "text": "能令弱小生物本能沉浮"}, {"start": 74.53, "end": 76.29, "text": "作用于人类身上是肉体重复"}, {"start": 76.97, "end": 78.29, "text": "但作用于宠寿身上"}, {"start": 78.77, "end": 80.61, "text": "则是催枯拉朽的精神风暴"}, {"start": 81.13, "end": 82.05, "text": "这不是测实力"}, {"start": 82.29, "end": 83.21, "text": "测的是意志"}, {"start": 83.49, "end": 84.41, "text": "宠寿的意志"}, {"start": 84.57, "end": 85.41, "text": "面对强敌"}, {"start": 85.57, "end": 87.25, "text": "是转身救逃还是迎难而上"}, {"start": 87.61, "end": 88.61, "text": "全看这股意志"}, {"start": 89.21, "end": 90.61, "text": "真正对上强敌的时候"}, {"start": 90.97, "end": 92.25, "text": "没人能意志帮他兜底"}, {"start": 92.53, "end": 93.05, "text": "小白"}, {"start": 93.57, "end": 94.73, "text": "依靠你自己的意志"}, {"start": 95.05, "end": 96.83, "text": "看看你究竟能坚持多久"}]}