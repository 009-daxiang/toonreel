{"file": "御兽时代-第190集.mp4", "ep": 190, "duration": 52.0, "segments": [{"start": 0.82, "end": 1.7, "text": "用墙广手殿"}, {"start": 2.3, "end": 4.37, "text": "就地扎营"}, {"start": 4.65, "end": 6.17, "text": "若与你们三个共用一顶帐篷"}, {"start": 6.29, "end": 6.97, "text": "关闭手殿"}, {"start": 7.13, "end": 8.29, "text": "暂时收回部分重设"}, {"start": 8.57, "end": 8.97, "text": "端木"}, {"start": 9.13, "end": 10.37, "text": "命令黑富人环绕帐篷"}, {"start": 10.53, "end": 11.45, "text": "布置环形警戒"}, {"start": 11.97, "end": 14.36, "text": "不是吧 领老大"}, {"start": 14.52, "end": 15.92, "text": "木柴你都提前准备好了"}, {"start": 16.2, "end": 22.72, "text": "剑微之柱"}, {"start": 23.04, "end": 24.56, "text": "林墨连木柴都能背棋"}, {"start": 24.72, "end": 25.92, "text": "真是太让人安心了"}, {"start": 26.48, "end": 27.14, "text": "是啊"}, {"start": 27.34, "end": 28.1, "text": "你能找到她"}, {"start": 28.26, "end": 29.34, "text": "确实是天大的幸运"}, {"start": 29.7, "end": 31.1, "text": "有件事你们或许不知道"}, {"start": 31.46, "end": 33.46, "text": "其实是我主动倒追的她"}, {"start": 33.46, "end": 34.26, "text": "她确实很强"}, {"start": 34.26, "end": 35.06, "text": "可让你来倒追"}, {"start": 35.06, "end": 35.98, "text": "这也太不可思议了"}, {"start": 35.98, "end": 37.42, "text": "什么样的男人值得你主动啊"}, {"start": 37.74, "end": 38.54, "text": "在我看来"}, {"start": 38.7, "end": 39.98, "text": "为她做什么都是值得的"}, {"start": 47.05, "end": 48.17, "text": "又生酒断铁甲鞋"}, {"start": 48.49, "end": 50.01, "text": "单独一头还造不成致命危机"}]}