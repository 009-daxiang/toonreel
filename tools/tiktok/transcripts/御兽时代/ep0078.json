{"file": "御兽时代-第78集.mp4", "ep": 78, "duration": 66.3, "segments": [{"start": 11.15, "end": 12.43, "text": "果然是幼生五段"}, {"start": 12.95, "end": 13.51, "text": "小白"}, {"start": 13.71, "end": 14.55, "text": "速战速决"}, {"start": 22.35, "end": 24.07, "text": "林墨第三关用时五十一秒二七"}, {"start": 24.07, "end": 25.83, "text": "元丹关记录五分五十四秒七七"}, {"start": 25.83, "end": 27.71, "text": "现三关总用时一分四十七秒二一"}, {"start": 27.71, "end": 29.59, "text": "元总用时记录四十一分四十秒七六"}, {"start": 29.99, "end": 31.99, "text": "第三关是幼生死断的分水灵"}, {"start": 31.99, "end": 33.43, "text": "林墨练修正的作用"}, {"start": 33.43, "end": 34.15, "text": "东小藏"}, {"start": 34.31, "end": 35.31, "text": "我打蛋猜贼"}, {"start": 35.43, "end": 36.79, "text": "林墨练冲手已经达到"}, {"start": 36.79, "end": 37.83, "text": "幼生流短了吧"}, {"start": 37.99, "end": 38.43, "text": "四"}, {"start": 38.59, "end": 40.11, "text": "前几天刚刚突破"}, {"start": 40.67, "end": 42.07, "text": "三个月六段"}, {"start": 42.31, "end": 44.07, "text": "在川寧简直是奇迹"}, {"start": 44.31, "end": 45.75, "text": "我记得青园省最快记录"}, {"start": 45.75, "end": 47.03, "text": "第一关是五秒多吧"}, {"start": 47.15, "end": 47.79, "text": "查一下"}, {"start": 48.35, "end": 49.67, "text": "省记录第一关五秒六一"}, {"start": 49.67, "end": 50.79, "text": "第二关二十秒三七"}, {"start": 50.79, "end": 52.03, "text": "第三关四十七秒一九"}, {"start": 52.03, "end": 53.79, "text": "三关总时场一分三十八秒八三"}, {"start": 53.91, "end": 55.03, "text": "第一关破省记录"}, {"start": 55.03, "end": 56.27, "text": "后两关极度接近"}, {"start": 56.39, "end": 58.79, "text": "省城顶尖考生岂不是七段甚至八段"}, {"start": 58.91, "end": 60.31, "text": "林墨已六段做到这一步"}, {"start": 60.51, "end": 61.31, "text": "何等军人"}, {"start": 61.59, "end": 62.55, "text": "以林墨的实力"}, {"start": 62.55, "end": 64.27, "text": "有没有机会冲击青园学府"}]}