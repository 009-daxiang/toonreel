{"file": "御兽时代-第180集.mp4", "ep": 180, "duration": 96.3, "segments": [{"start": 0.0, "end": 0.5, "text": "坐"}, {"start": 0.9, "end": 2.1, "text": "你对秘境了解多少"}, {"start": 2.66, "end": 4.56, "text": "只知道秘境里面天才地宝众多"}, {"start": 4.66, "end": 6.36, "text": "对玉兽师和虫兽增益很大"}, {"start": 6.56, "end": 7.86, "text": "就是凶险程度很高"}, {"start": 8.7, "end": 9.5, "text": "协会统计"}, {"start": 9.8, "end": 12.2, "text": "近十年秘境参与者生还率只有五成"}, {"start": 12.4, "end": 14.4, "text": "未开发新秘境死亡率会更高"}, {"start": 14.9, "end": 16.4, "text": "如果给你一个秘境名额"}, {"start": 16.5, "end": 17.3, "text": "你敢去吗"}, {"start": 17.7, "end": 18.1, "text": "敢"}, {"start": 18.7, "end": 20.0, "text": "必须组建五人小队进场"}, {"start": 20.1, "end": 21.1, "text": "两条硬性要求"}, {"start": 21.2, "end": 22.6, "text": "队员虫兽不能有成熟期"}, {"start": 22.8, "end": 24.0, "text": "除稀缺医疗位之外"}, {"start": 24.0, "end": 26.0, "text": "其余人虫兽不得低于幼生六段"}, {"start": 26.3, "end": 27.4, "text": "抓紧去找你的队员"}, {"start": 29.84, "end": 31.64, "text": "新生榜第一亲自给我打电话"}, {"start": 31.84, "end": 32.84, "text": "我可受宠若惊"}, {"start": 34.2, "end": 35.8, "text": "你的虫树达到幼生六段了吗"}, {"start": 36.4, "end": 37.4, "text": "前几天刚突破"}, {"start": 37.5, "end": 38.3, "text": "问这个干什么"}, {"start": 38.7, "end": 39.9, "text": "有个进入秘境的机会"}, {"start": 40.1, "end": 41.3, "text": "我想邀请你一起组队"}, {"start": 41.7, "end": 42.8, "text": "但丑话说在前头"}, {"start": 43.0, "end": 44.2, "text": "会有极高死亡风险"}, {"start": 44.3, "end": 44.9, "text": "秘境"}, {"start": 45.3, "end": 46.1, "text": "只要你邀我"}, {"start": 46.1, "end": 47.3, "text": "刀山火海我也去"}, {"start": 47.5, "end": 48.2, "text": "在哪碰头"}, {"start": 51.02, "end": 51.72, "text": "来之前"}, {"start": 52.12, "end": 54.32, "text": "顺便替我邀请一下治疗系的李盈盈"}, {"start": 55.04, "end": 56.04, "text": "我需要她当对抑"}, {"start": 56.76, "end": 57.36, "text": "没问题"}, {"start": 57.76, "end": 58.96, "text": "我现在就去找她沟通"}, {"start": 62.25, "end": 62.85, "text": "林墨"}, {"start": 62.95, "end": 63.45, "text": "怎么了"}, {"start": 64.53, "end": 66.33, "text": "学府批了一个高阶秘境名额"}, {"start": 66.63, "end": 67.33, "text": "五人小队"}, {"start": 67.53, "end": 67.93, "text": "来吗"}, {"start": 69.26, "end": 70.56, "text": "你来主公我来兜底"}, {"start": 70.76, "end": 71.46, "text": "什么时候集合"}, {"start": 72.87, "end": 73.77, "text": "到时候通知你"}, {"start": 74.37, "end": 75.27, "text": "对一李盈盈"}, {"start": 75.47, "end": 76.37, "text": "攻防人员员"}, {"start": 76.57, "end": 77.37, "text": "战力零弱雨"}, {"start": 77.87, "end": 78.47, "text": "再加上我"}, {"start": 78.97, "end": 80.17, "text": "小队私人已经确定"}, {"start": 80.77, "end": 82.47, "text": "本该优先考虑生死兄弟孙磊"}, {"start": 82.87, "end": 84.27, "text": "但孙磊战虫刚入武段"}, {"start": 84.47, "end": 85.87, "text": "被学府规则掐死在外"}, {"start": 86.37, "end": 87.47, "text": "少宁防御扎实"}, {"start": 87.57, "end": 88.47, "text": "端木爆发迅猛"}, {"start": 88.67, "end": 89.97, "text": "寢室之中出去孔志浩"}, {"start": 90.07, "end": 91.17, "text": "就剩他们两人达标"}, {"start": 91.47, "end": 93.17, "text": "可现在谨慎最后一个名额"}, {"start": 93.17, "end": 94.37, "text": "必须好好全衡局舍"}]}