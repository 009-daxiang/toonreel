{"file": "御兽时代-第88集.mp4", "ep": 88, "duration": 64.1, "segments": [{"start": 23.09, "end": 24.05, "text": "晋身肉薄"}, {"start": 24.05, "end": 25.41, "text": "小白 快退開"}, {"start": 25.41, "end": 27.25, "text": "幻境無風導致隱匿受限"}, {"start": 27.25, "end": 28.25, "text": "拉開不了距離"}, {"start": 28.25, "end": 29.45, "text": "必須用狠招"}, {"start": 29.45, "end": 30.57, "text": "與其被活活追死"}, {"start": 30.57, "end": 31.49, "text": "不如以傷換傷"}, {"start": 31.49, "end": 32.57, "text": "背掉他的行動力"}, {"start": 32.57, "end": 34.09, "text": "小白 只不迎擊"}, {"start": 34.09, "end": 42.21, "text": "站他前腿"}, {"start": 42.21, "end": 51.2, "text": "雷角師的左前腿"}, {"start": 51.2, "end": 52.24, "text": "已經近乎斷裂了"}, {"start": 52.24, "end": 52.92, "text": "現在"}, {"start": 52.92, "end": 54.12, "text": "他巨大的體型優勢"}, {"start": 54.12, "end": 55.68, "text": "已經徹底淪為雷錐"}, {"start": 55.68, "end": 56.52, "text": "以傷換傷"}, {"start": 56.52, "end": 57.92, "text": "成功限制了他的速度"}, {"start": 57.92, "end": 59.08, "text": "但小白失血過多"}, {"start": 59.08, "end": 60.08, "text": "撐不了太久"}, {"start": 60.08, "end": 62.08, "text": "所以 必須速戰速決"}]}