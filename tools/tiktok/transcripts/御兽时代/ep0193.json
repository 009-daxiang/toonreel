{"file": "御兽时代-第193集.mp4", "ep": 193, "duration": 84.7, "segments": [{"start": 0.0, "end": 10.13, "text": "新战际水雾初次实战"}, {"start": 10.13, "end": 11.13, "text": "虽还未入门"}, {"start": 11.13, "end": 12.13, "text": "两米的视野盲区"}, {"start": 12.13, "end": 14.13, "text": "足以给刺客创造拖身机会"}, {"start": 14.13, "end": 52.7, "text": "我的妈呀"}, {"start": 52.7, "end": 53.7, "text": "又生九段的霸主"}, {"start": 53.7, "end": 54.7, "text": "半分钟就给融了"}, {"start": 54.7, "end": 56.7, "text": "全靠黎墨隐怪破防"}, {"start": 56.7, "end": 57.7, "text": "加上若雨的雷机控场"}, {"start": 57.7, "end": 59.7, "text": "换做我们根本没法靠近"}, {"start": 59.7, "end": 63.07, "text": "现在分配第一笔收获"}, {"start": 63.07, "end": 64.07, "text": "按之前约定"}, {"start": 64.07, "end": 65.07, "text": "扣除发起人两成"}, {"start": 65.07, "end": 66.07, "text": "我和若雨各拿三成"}, {"start": 66.07, "end": 67.07, "text": "圆圆 盈盈"}, {"start": 67.07, "end": 68.07, "text": "各拿一成五"}, {"start": 68.07, "end": 69.07, "text": "端木拿一成"}, {"start": 69.07, "end": 70.07, "text": "大家有没有意义"}, {"start": 70.07, "end": 71.07, "text": "没意见"}, {"start": 71.07, "end": 72.36, "text": "接下来我们说说"}, {"start": 72.36, "end": 73.36, "text": "下一步计划"}, {"start": 73.36, "end": 74.36, "text": "这一片"}, {"start": 74.36, "end": 75.36, "text": "应该不止这一出"}, {"start": 75.36, "end": 76.36, "text": "凶兽巢穴"}, {"start": 76.36, "end": 79.38, "text": "老大的意思是"}, {"start": 79.38, "end": 80.38, "text": "把方圆几公里内"}, {"start": 80.38, "end": 81.38, "text": "所有的九段老巢"}, {"start": 81.38, "end": 82.38, "text": "挨个拔掉"}]}