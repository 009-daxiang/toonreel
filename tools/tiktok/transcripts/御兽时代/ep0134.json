{"file": "御兽时代-第134集.mp4", "ep": 134, "duration": 68.1, "segments": [{"start": 0.0, "end": 1.6, "text": "第一阶段小组成绩"}, {"start": 1.6, "end": 3.0, "text": "第一名林墨小组"}, {"start": 3.0, "end": 4.0, "text": "几分三十"}, {"start": 4.0, "end": 5.6, "text": "第二名吴文斌小组"}, {"start": 5.6, "end": 6.4, "text": "几分二十五"}, {"start": 6.4, "end": 7.8, "text": "第三名李涛小组"}, {"start": 7.8, "end": 8.6, "text": "几分二十"}, {"start": 8.6, "end": 10.0, "text": "第四名胡玉龙小组"}, {"start": 10.0, "end": 11.0, "text": "几分十五"}, {"start": 11.0, "end": 12.8, "text": "其余调队的六个小组"}, {"start": 12.8, "end": 14.6, "text": "几分全部为零"}, {"start": 14.6, "end": 18.11, "text": "我有一件"}, {"start": 18.11, "end": 20.11, "text": "我认为这次成绩不公平"}, {"start": 20.11, "end": 21.11, "text": "应该取消"}, {"start": 21.11, "end": 22.11, "text": "入林前"}, {"start": 22.11, "end": 23.11, "text": "您说二十多公里"}, {"start": 23.11, "end": 24.11, "text": "才到训练场地"}, {"start": 24.11, "end": 25.91, "text": "路途根本不算训练"}, {"start": 25.91, "end": 27.31, "text": "成绩自然无效"}, {"start": 27.31, "end": 28.31, "text": "对呀"}, {"start": 28.31, "end": 29.57, "text": "阅阅中说得对"}, {"start": 29.57, "end": 30.77, "text": "这根本不公平"}, {"start": 33.02, "end": 34.02, "text": "那我问你"}, {"start": 34.02, "end": 35.02, "text": "什么是实战"}, {"start": 35.02, "end": 36.62, "text": "我"}, {"start": 36.62, "end": 39.9, "text": "你们天真以为"}, {"start": 39.9, "end": 41.9, "text": "凶兽厮杀会等你们整装待发"}, {"start": 41.9, "end": 44.9, "text": "以为致命袭击会提前打招呼"}, {"start": 44.9, "end": 45.9, "text": "真正的野外实战"}, {"start": 45.9, "end": 47.9, "text": "是一只足虫就能致命"}, {"start": 47.9, "end": 49.9, "text": "是体力透之时凶兽突袭"}, {"start": 49.9, "end": 51.9, "text": "是绝境之中别无退路"}, {"start": 51.9, "end": 52.9, "text": "倘若今天不是时训"}, {"start": 52.9, "end": 54.9, "text": "是真正的生死战场"}, {"start": 54.9, "end": 55.9, "text": "就凭你们未缩逃避"}, {"start": 55.9, "end": 57.9, "text": "青言放弃的模样"}, {"start": 57.9, "end": 58.9, "text": "有几个人能活着"}, {"start": 58.9, "end": 62.95, "text": "站在这里抱怨不公"}, {"start": 62.95, "end": 63.95, "text": "除了林墨"}, {"start": 63.95, "end": 65.95, "text": "剩下所有人回去好好复盘"}]}