{"file": "御兽时代-第201集.mp4", "ep": 201, "duration": 64.0, "segments": [{"start": 0.0, "end": 1.08, "text": "兩世成人"}, {"start": 1.52, "end": 3.92, "text": "這是我第一次親手奪下五條人命"}, {"start": 4.96, "end": 7.52, "text": "慘之破碎的畫面不斷在腦海出現"}, {"start": 9.13, "end": 10.53, "text": "就算一直再堅韌"}, {"start": 10.97, "end": 12.73, "text": "那份不忍與血腥衝擊"}, {"start": 13.05, "end": 14.65, "text": "依舊難以輕易平息"}, {"start": 30.05, "end": 31.45, "text": "全員原地修整一小時"}, {"start": 31.45, "end": 32.01, "text": "老大"}, {"start": 32.13, "end": 33.09, "text": "我不是質疑你"}, {"start": 33.25, "end": 34.45, "text": "但咱們為啥非要廢死進"}, {"start": 34.45, "end": 36.09, "text": "翻過這鬼地方爬這座主風啊"}, {"start": 36.61, "end": 37.45, "text": "估計有載"}, {"start": 37.65, "end": 39.49, "text": "天地異寶多生於極顯決定"}, {"start": 39.65, "end": 40.81, "text": "碰碰運氣總沒錯"}, {"start": 41.01, "end": 42.69, "text": "昨夜小坤碰穿雲破霧"}, {"start": 43.05, "end": 44.69, "text": "以爵士鷹鵬在主風險牙上"}, {"start": 44.69, "end": 46.09, "text": "�鎖定了一株靈心果樹"}, {"start": 46.37, "end": 47.45, "text": "枝頭瘦果累累"}, {"start": 47.45, "end": 48.49, "text": "足足十枚以上"}, {"start": 48.49, "end": 49.93, "text": "一枚釋迦六至八百萬"}, {"start": 49.93, "end": 51.49, "text": "十枚總價值接近八千萬"}, {"start": 51.49, "end": 53.29, "text": "更難得是可以提升戰重營制"}, {"start": 53.29, "end": 54.29, "text": "突破智慧智果"}, {"start": 54.29, "end": 55.13, "text": "無論如何"}, {"start": 55.13, "end": 55.97, "text": "一定要拿到"}]}