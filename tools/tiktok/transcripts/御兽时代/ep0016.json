{"file": "御兽时代-第16集.mp4", "ep": 16, "duration": 65.7, "segments": [{"start": 0.59, "end": 2.31, "text": "用隐移既能拖时间"}, {"start": 3.73, "end": 4.45, "text": "莫哥"}, {"start": 4.45, "end": 5.97, "text": "这办法你都能想得到"}, {"start": 6.82, "end": 8.14, "text": "原来是钻规则控子"}, {"start": 8.14, "end": 9.3, "text": "投机取巧"}, {"start": 9.3, "end": 10.02, "text": "走吧"}, {"start": 10.02, "end": 11.3, "text": "靠作弊进来的"}, {"start": 11.3, "end": 12.78, "text": "迟早第一个被淘汰"}, {"start": 13.5, "end": 14.66, "text": "两事为人"}, {"start": 14.66, "end": 16.3, "text": "别人爱怎么看就怎么看"}, {"start": 16.3, "end": 17.49, "text": "与我何干"}, {"start": 23.44, "end": 24.24, "text": "现在"}, {"start": 24.24, "end": 26.08, "text": "把你们的宠寿都召唤出来吧"}, {"start": 39.47, "end": 40.87, "text": "为了方便搬机管理"}, {"start": 40.87, "end": 42.51, "text": "按惯例先选个班长"}, {"start": 42.51, "end": 45.03, "text": "方式是宠寿决斗用实力说话"}, {"start": 47.09, "end": 48.13, "text": "当选班长"}, {"start": 48.77, "end": 51.37, "text": "每月在原有五万资源补贴基础上"}, {"start": 51.37, "end": 56.24, "text": "再加五万额外补助"}, {"start": 56.24, "end": 56.84, "text": "莫哥"}, {"start": 56.84, "end": 58.58, "text": "咱俩也去试试呗"}, {"start": 58.58, "end": 59.5, "text": "不急"}, {"start": 59.5, "end": 60.74, "text": "先看看"}, {"start": 60.74, "end": 61.54, "text": "好"}, {"start": 61.54, "end": 62.42, "text": "各位同学"}, {"start": 62.42, "end": 63.9, "text": "请移步到雷台区域"}]}