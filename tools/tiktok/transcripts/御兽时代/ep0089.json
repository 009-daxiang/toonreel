{"file": "御兽时代-第89集.mp4", "ep": 89, "duration": 98.8, "segments": [{"start": 6.57, "end": 7.17, "text": "小白"}, {"start": 7.57, "end": 8.29, "text": "加快速度"}, {"start": 19.02, "end": 20.42, "text": "雷教师彻底厉静了"}, {"start": 20.62, "end": 21.34, "text": "就现在"}, {"start": 21.5, "end": 23.02, "text": "小白最大威力"}, {"start": 38.91, "end": 39.47, "text": "退出"}, {"start": 40.5, "end": 41.5, "text": "通过第七关了"}, {"start": 41.9, "end": 43.1, "text": "不过小白失血严重"}, {"start": 43.34, "end": 44.82, "text": "必须争分多秒接受治疗"}, {"start": 45.26, "end": 52.33, "text": "林墨退出秘境了"}, {"start": 52.69, "end": 53.69, "text": "过关被的"}, {"start": 54.05, "end": 54.61, "text": "过了"}, {"start": 54.69, "end": 56.61, "text": "用十八分三十一秒二六"}, {"start": 57.18, "end": 57.98, "text": "李市长"}, {"start": 58.14, "end": 58.86, "text": "过了"}, {"start": 59.18, "end": 60.82, "text": "林墨真来过了"}, {"start": 60.98, "end": 61.5, "text": "好"}, {"start": 61.78, "end": 62.54, "text": "太好了"}, {"start": 62.66, "end": 64.22, "text": "脸僧良己泥兮"}, {"start": 64.42, "end": 65.46, "text": "传宁创造了"}, {"start": 65.46, "end": 66.62, "text": "专心的李市"}, {"start": 66.74, "end": 68.1, "text": "越两级战斗都赢了"}, {"start": 68.38, "end": 70.02, "text": "F级天赋三个月六段加"}, {"start": 70.14, "end": 71.02, "text": "熟练级技能"}, {"start": 71.18, "end": 72.14, "text": "这怎么可能"}, {"start": 72.3, "end": 73.78, "text": "我现在严重怀疑"}, {"start": 73.94, "end": 75.74, "text": "觉醒府镇指定是出毛病了"}, {"start": 75.86, "end": 77.26, "text": "压根儿就不是F级"}, {"start": 80.07, "end": 80.71, "text": "诸位"}, {"start": 81.3, "end": 82.5, "text": "先磨想那么多了"}, {"start": 83.2, "end": 84.92, "text": "天赋到底是傻子登级"}, {"start": 85.2, "end": 86.84, "text": "等林墨且情愿学父"}, {"start": 86.96, "end": 87.96, "text": "自然就消贷"}, {"start": 88.4, "end": 89.96, "text": "我们燕霞嘴要尽泪"}, {"start": 90.12, "end": 91.4, "text": "是好生想一想"}, {"start": 91.68, "end": 92.52, "text": "该给林墨"}, {"start": 92.68, "end": 93.92, "text": "整个傻子将领"}]}