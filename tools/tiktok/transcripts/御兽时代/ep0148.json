{"file": "御兽时代-第148集.mp4", "ep": 148, "duration": 67.5, "segments": [{"start": 1.36, "end": 2.72, "text": "去当一个在危难时"}, {"start": 2.72, "end": 5.04, "text": "只能躲在别人身后的普通公心园"}, {"start": 9.06, "end": 10.5, "text": "不愿意参加今晚训练的"}, {"start": 10.94, "end": 12.7, "text": "现在就来找我办退学手续"}, {"start": 16.14, "end": 17.02, "text": "各自去休息"}, {"start": 17.5, "end": 19.54, "text": "今晚零点整 时训重启"}, {"start": 19.9, "end": 34.07, "text": "无论风云变换"}, {"start": 34.47, "end": 36.51, "text": "自身的绝对战力与成长质量"}, {"start": 36.95, "end": 39.15, "text": "才是应对一切意外的根本底牌"}, {"start": 39.39, "end": 44.88, "text": "可别再丢了"}, {"start": 45.66, "end": 47.3, "text": "放心吧 这次保证不丢"}, {"start": 50.64, "end": 51.76, "text": "考核内容变更"}, {"start": 52.36, "end": 54.72, "text": "天亮六点前 全员原路返回"}, {"start": 54.88, "end": 57.28, "text": "赶到最初进入原始森林的初始坐标点"}, {"start": 58.84, "end": 60.48, "text": "快速行军至少需五个多小时"}, {"start": 60.64, "end": 61.92, "text": "途中若是遇上凶手劫击"}, {"start": 61.92, "end": 63.0, "text": "六个小时根本不够"}, {"start": 63.28, "end": 64.32, "text": "就别说密林运回"}, {"start": 64.32, "end": 65.32, "text": "方位早就乱了"}]}