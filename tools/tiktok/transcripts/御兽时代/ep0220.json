{"file": "御兽时代-第220集.mp4", "ep": 220, "duration": 86.1, "segments": [{"start": 5.14, "end": 5.86, "text": "碧云景"}, {"start": 6.47, "end": 7.27, "text": "你有什么事吗"}, {"start": 7.63, "end": 9.15, "text": "我要向你发起雷台挑战"}, {"start": 9.55, "end": 10.55, "text": "今天下午三点"}, {"start": 10.79, "end": 11.95, "text": "你准时到场即可"}, {"start": 12.31, "end": 12.79, "text": "可以"}, {"start": 13.31, "end": 13.87, "text": "我有空"}, {"start": 14.47, "end": 14.91, "text": "好"}, {"start": 15.43, "end": 16.35, "text": "那就下午三点"}, {"start": 16.59, "end": 17.59, "text": "前广场雷台"}, {"start": 17.95, "end": 18.75, "text": "不见不散"}, {"start": 19.54, "end": 20.82, "text": "鞋冰水双戏装头郎"}, {"start": 20.82, "end": 22.38, "text": "苦修一个月有备而来吗"}, {"start": 23.29, "end": 23.81, "text": "可惜"}, {"start": 24.33, "end": 25.37, "text": "现在的小白早已"}, {"start": 25.37, "end": 26.53, "text": "跨入右生八段了"}, {"start": 29.76, "end": 30.24, "text": "这是一份"}, {"start": 30.24, "end": 31.36, "text": "宠授进化所需物品的"}, {"start": 31.36, "end": 31.88, "text": "登记表"}, {"start": 32.08, "end": 32.8, "text": "填好交给我"}, {"start": 33.91, "end": 34.67, "text": "雪府将出面"}, {"start": 34.67, "end": 35.63, "text": "集中评价团购"}, {"start": 35.63, "end": 36.31, "text": "辅助主裁"}, {"start": 36.51, "end": 37.71, "text": "但也切记量力而能"}, {"start": 37.83, "end": 38.63, "text": "不要浩高物源"}, {"start": 38.63, "end": 39.99, "text": "选无法落地的残骗"}, {"start": 40.27, "end": 48.76, "text": "你尽在支持"}, {"start": 49.08, "end": 50.07, "text": "你尽不可"}, {"start": 50.07, "end": 53.97, "text": "我还能到哪里"}, {"start": 53.97, "end": 55.61, "text": "去找选我的进化资料呢"}, {"start": 55.81, "end": 58.36, "text": "非常不错"}, {"start": 58.36, "end": 59.28, "text": "大家辛苦了"}, {"start": 60.55, "end": 61.11, "text": "唐局主角"}, {"start": 61.11, "end": 61.71, "text": "我来卸妆了"}, {"start": 62.03, "end": 62.39, "text": "林墨"}, {"start": 62.39, "end": 62.91, "text": "编剧叫你对下"}, {"start": 62.91, "end": 63.55, "text": "下集剧本"}, {"start": 66.26, "end": 67.22, "text": "大家都过来"}, {"start": 67.34, "end": 68.38, "text": "一起合个影"}, {"start": 73.61, "end": 74.57, "text": "感谢大家陪伴"}, {"start": 74.85, "end": 76.33, "text": "你 结束了"}, {"start": 76.77, "end": 78.13, "text": "希望大家喜欢我们的故事"}, {"start": 78.65, "end": 79.49, "text": "麻烦大家帮忙"}, {"start": 79.49, "end": 80.13, "text": "多多点赞"}, {"start": 80.13, "end": 81.13, "text": "收藏分享哦"}, {"start": 81.49, "end": 82.25, "text": "让我们"}, {"start": 82.41, "end": 83.77, "text": "下一季再见"}]}