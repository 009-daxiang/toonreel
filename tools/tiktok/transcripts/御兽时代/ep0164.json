{"file": "御兽时代-第164集.mp4", "ep": 164, "duration": 87.1, "segments": [{"start": 13.49, "end": 14.69, "text": "金斑巨象"}, {"start": 14.69, "end": 16.29, "text": "金属手信五階低级"}, {"start": 16.29, "end": 18.69, "text": "掌握高级箭踏与高级冲撞"}, {"start": 18.69, "end": 19.89, "text": "幼生九段"}, {"start": 19.89, "end": 31.05, "text": "幼灵虎"}, {"start": 31.05, "end": 32.98, "text": "而且是黄金终极自治"}, {"start": 32.98, "end": 34.34, "text": "不仅如此"}, {"start": 34.34, "end": 35.74, "text": "他的成长等级"}, {"start": 35.74, "end": 37.74, "text": "竟然达到了幼生七段"}, {"start": 37.74, "end": 39.14, "text": "前几天才六段"}, {"start": 39.14, "end": 40.34, "text": "竟然这么快就突破了"}, {"start": 40.34, "end": 44.27, "text": "幼生七段"}, {"start": 44.27, "end": 46.47, "text": "比你们之前说的幼生六段高了一段"}, {"start": 46.47, "end": 48.27, "text": "你们两个现在怎么说"}, {"start": 48.27, "end": 50.07, "text": "我还是看好沐云亭"}, {"start": 50.07, "end": 51.87, "text": "两段差距有如天切"}, {"start": 51.87, "end": 53.47, "text": "单纯从属性来说"}, {"start": 53.47, "end": 54.47, "text": "幼灵虎是水"}, {"start": 54.47, "end": 55.47, "text": "金斑巨象是金"}, {"start": 55.47, "end": 57.07, "text": "金速攻防更具压倒性优势"}, {"start": 57.07, "end": 58.07, "text": "先看比赛吧"}, {"start": 58.07, "end": 58.87, "text": "不出意外"}, {"start": 58.87, "end": 60.67, "text": "这两个小家伙的战斗应该会很精彩"}, {"start": 60.67, "end": 61.47, "text": "骆主任"}, {"start": 61.47, "end": 62.87, "text": "麻烦你充当一下裁判"}, {"start": 62.87, "end": 65.47, "text": "可不要让这两个小家伙的宠授受伤太重了"}, {"start": 65.47, "end": 71.98, "text": "明白"}, {"start": 71.98, "end": 73.38, "text": "本场由我担任裁判"}, {"start": 73.38, "end": 75.38, "text": "唯一禁令严禁攻击御授师本人"}, {"start": 75.38, "end": 75.98, "text": "战斗"}, {"start": 75.98, "end": 76.78, "text": "开始"}, {"start": 76.78, "end": 80.3, "text": "冲撞"}]}