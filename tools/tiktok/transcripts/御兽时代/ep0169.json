{"file": "御兽时代-第169集.mp4", "ep": 169, "duration": 69.1, "segments": [{"start": 5.62, "end": 7.62, "text": "我好像没有回答你问题的义务"}, {"start": 7.62, "end": 13.09, "text": "被九段巨象正面抽中起会毫无损伤"}, {"start": 13.09, "end": 16.09, "text": "小白此刻纯靠超强意志带伤强撑"}, {"start": 16.09, "end": 18.89, "text": "但暴露底牌给潜在敌人"}, {"start": 18.89, "end": 20.89, "text": "绝非智者所为"}, {"start": 20.89, "end": 24.87, "text": "骆主任"}, {"start": 24.87, "end": 27.77, "text": "还请让比赛继续"}, {"start": 27.77, "end": 28.77, "text": "沐云婷"}, {"start": 28.77, "end": 31.09, "text": "带你的宠授去治伤吧"}, {"start": 31.09, "end": 32.09, "text": "下一位挑战者"}, {"start": 32.09, "end": 34.09, "text": "第三名傅子豪"}, {"start": 34.09, "end": 35.09, "text": "我放弃挑战"}, {"start": 35.09, "end": 36.09, "text": "碧云婷"}, {"start": 36.09, "end": 37.09, "text": "你呢"}, {"start": 37.09, "end": 39.89, "text": "我也选择认输"}, {"start": 39.89, "end": 40.89, "text": "无人在战"}, {"start": 40.89, "end": 41.89, "text": "我宣布"}, {"start": 41.89, "end": 43.89, "text": "本届新生战力榜第一名"}, {"start": 43.89, "end": 45.89, "text": "林墨"}, {"start": 45.89, "end": 57.21, "text": "明日上午所有人前往教务处登记领取奖励"}, {"start": 57.21, "end": 58.21, "text": "从下月开始"}, {"start": 58.21, "end": 60.21, "text": "每月开放一轮挑战"}, {"start": 60.21, "end": 63.21, "text": "榜单成员每月必须接受前三次挑战"}, {"start": 63.21, "end": 65.21, "text": "今日到此戒赛"}, {"start": 65.21, "end": 67.21, "text": "做好明日大课准备"}]}