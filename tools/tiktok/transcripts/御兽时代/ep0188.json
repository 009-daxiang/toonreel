{"file": "御兽时代-第188集.mp4", "ep": 188, "duration": 57.1, "segments": [{"start": 0.02, "end": 2.02, "text": "嘿 您都听好了"}, {"start": 2.02, "end": 3.02, "text": "头一仗啊"}, {"start": 3.02, "end": 5.02, "text": "大伙得抱团一块进退"}, {"start": 5.02, "end": 8.02, "text": "要撤就得人权凑齐了"}, {"start": 8.02, "end": 9.02, "text": "再者说啊"}, {"start": 9.02, "end": 10.02, "text": "第二仗"}, {"start": 10.02, "end": 11.02, "text": "每队都有自个落脚的地劲"}, {"start": 11.02, "end": 12.02, "text": "回内地"}, {"start": 12.02, "end": 14.02, "text": "占三分钟末念走"}, {"start": 14.02, "end": 15.02, "text": "才能够传送出去"}, {"start": 15.02, "end": 16.02, "text": "嘿呦"}, {"start": 16.02, "end": 17.02, "text": "您可别麻糊了"}, {"start": 17.02, "end": 18.02, "text": "要是记不住那地劲"}, {"start": 18.02, "end": 19.02, "text": "就算学府也救不了你"}, {"start": 19.02, "end": 21.02, "text": "早先真有人隔里边"}, {"start": 21.02, "end": 22.02, "text": "把命搭进去了"}, {"start": 22.02, "end": 23.02, "text": "得嘞"}, {"start": 23.02, "end": 24.02, "text": "你照着榜单的牌子"}, {"start": 24.02, "end": 25.02, "text": "头一波"}, {"start": 25.02, "end": 26.02, "text": "赶紧往里进"}, {"start": 26.02, "end": 32.27, "text": "难怪学府不限制期限"}, {"start": 32.27, "end": 33.27, "text": "这破地方待久了"}, {"start": 33.27, "end": 35.27, "text": "十个人有九个都得封吧"}, {"start": 35.27, "end": 39.06, "text": "全部召唤重售戒备"}, {"start": 39.06, "end": 41.06, "text": "牢牢记住此处环境特征"}, {"start": 41.06, "end": 47.64, "text": "罗盘只真在疯狂打转"}, {"start": 47.64, "end": 49.64, "text": "定位功能彻底废了"}, {"start": 49.64, "end": 52.15, "text": "异度空间法则纹乱"}, {"start": 52.15, "end": 53.15, "text": "蓝青的罗盘失灵"}, {"start": 53.15, "end": 54.15, "text": "本就理所应当"}]}