{"file": "御兽时代-第131集.mp4", "ep": 131, "duration": 103.9, "segments": [{"start": 4.11, "end": 5.11, "text": "好小子"}, {"start": 5.11, "end": 8.64, "text": "遇判精准反应极快"}, {"start": 8.64, "end": 11.64, "text": "就连被围候的高空避险战术都算无余测"}, {"start": 11.64, "end": 12.64, "text": "远超同龄新生"}, {"start": 12.64, "end": 17.52, "text": "开局大开大合斩首拉满仇益"}, {"start": 17.52, "end": 18.52, "text": "右敌聚集"}, {"start": 18.52, "end": 20.52, "text": "此刻又精准控任割侯"}, {"start": 20.52, "end": 22.52, "text": "节省体力高效杀敌"}, {"start": 22.52, "end": 24.52, "text": "生死一顺不仅算计周密"}, {"start": 24.52, "end": 25.52, "text": "打法沉稳"}, {"start": 25.52, "end": 26.52, "text": "更独自包拦所有杀机"}, {"start": 26.52, "end": 28.52, "text": "护住了全场荒乱的新生"}, {"start": 28.52, "end": 29.52, "text": "这份心性与战术"}, {"start": 29.52, "end": 31.52, "text": "绝非普通缺子可比"}, {"start": 31.52, "end": 32.52, "text": "都停下"}, {"start": 32.52, "end": 53.04, "text": "不要乱跑"}, {"start": 53.04, "end": 54.04, "text": "狼群已经撤离"}, {"start": 54.04, "end": 55.52, "text": "接下来一小时自由修整"}, {"start": 56.52, "end": 57.52, "text": "同样是本界新生"}, {"start": 57.52, "end": 59.52, "text": "其余人欲敌只会慌乱逃窜"}, {"start": 59.52, "end": 61.0, "text": "坐以待毙"}, {"start": 61.0, "end": 62.0, "text": "如同风中遥夜的营火"}, {"start": 62.0, "end": 63.0, "text": "唯有凌墨"}, {"start": 63.0, "end": 64.0, "text": "凌危不乱致勇双拳"}, {"start": 64.0, "end": 65.0, "text": "且去当空耗月"}, {"start": 65.0, "end": 67.0, "text": "沉稳耀眼自带风茫"}, {"start": 67.0, "end": 69.0, "text": "二者根本不再同意疼刺"}, {"start": 69.0, "end": 70.0, "text": "你的虫瘦呢"}, {"start": 70.0, "end": 72.0, "text": "这个时候把虫瘦收回去"}, {"start": 72.0, "end": 73.0, "text": "你就不怕那些野狼"}, {"start": 73.0, "end": 74.0, "text": "再杀个回狼枪"}, {"start": 75.0, "end": 76.0, "text": "胡老师"}, {"start": 76.0, "end": 77.0, "text": "您不用烤掉我了"}, {"start": 77.0, "end": 78.0, "text": "一来您说安全"}, {"start": 78.0, "end": 79.1, "text": "那就必然安全"}, {"start": 79.1, "end": 80.1, "text": "二而就算狼群真杀回来"}, {"start": 80.1, "end": 81.1, "text": "我也完全来得及"}, {"start": 81.1, "end": 82.1, "text": "爬树二次召唤"}, {"start": 82.1, "end": 83.1, "text": "这些狼群"}, {"start": 83.1, "end": 84.1, "text": "想得倒是周到"}, {"start": 84.1, "end": 85.1, "text": "休息吧"}, {"start": 85.1, "end": 86.1, "text": "这次野外训练的成绩"}, {"start": 86.1, "end": 87.1, "text": "真的很重要"}, {"start": 87.1, "end": 88.1, "text": "好好把握"}, {"start": 88.1, "end": 89.1, "text": "新生战力榜的重要性"}, {"start": 89.1, "end": 90.1, "text": "众人皆知"}, {"start": 90.1, "end": 91.1, "text": "无需反复强调"}, {"start": 91.1, "end": 94.15, "text": "胡老师特意在三提醒"}, {"start": 94.15, "end": 95.15, "text": "绝对不止关乎"}, {"start": 95.15, "end": 96.15, "text": "绑单排名这么简单"}, {"start": 96.15, "end": 98.15, "text": "背后竟然另有隐情"}]}