{"file": "御兽时代-第21集.mp4", "ep": 21, "duration": 70.1, "segments": [{"start": 2.7, "end": 3.66, "text": "限量不足"}, {"start": 3.9, "end": 5.3, "text": "这般谁爱上谁上"}, {"start": 7.5, "end": 8.7, "text": "提缸技能熟练度"}, {"start": 8.82, "end": 9.66, "text": "还是那句话"}, {"start": 9.82, "end": 10.7, "text": "菜就多练"}, {"start": 11.3, "end": 12.38, "text": "技能释放到极限"}, {"start": 12.38, "end": 13.5, "text": "就收回空间恢复"}, {"start": 13.7, "end": 14.86, "text": "恢复好再接着练"}, {"start": 16.62, "end": 17.58, "text": "衡量熟练度的"}, {"start": 17.58, "end": 18.74, "text": "无非是释放速度"}, {"start": 19.02, "end": 20.34, "text": "持续次数和威力"}, {"start": 23.55, "end": 24.59, "text": "小白现在极限"}, {"start": 24.75, "end": 26.31, "text": "只能连续发射三次水人"}, {"start": 27.79, "end": 28.75, "text": "只能辛苦他了"}, {"start": 28.75, "end": 41.56, "text": "在预售空间里训练两次"}, {"start": 41.92, "end": 43.52, "text": "效果竟相当于外界的三次"}, {"start": 43.96, "end": 45.44, "text": "神级空间的高速成长"}, {"start": 45.44, "end": 46.2, "text": "还真是方便"}, {"start": 46.8, "end": 48.0, "text": "恢复速度远超外界"}, {"start": 48.6, "end": 49.64, "text": "并且还能时时刻刻"}, {"start": 49.64, "end": 51.16, "text": "享受1.5倍的训练加成"}, {"start": 51.36, "end": 52.48, "text": "领事长"}, {"start": 56.82, "end": 57.62, "text": "看得李墨"}, {"start": 58.06, "end": 59.62, "text": "进了精英班就成天偷懒"}, {"start": 60.28, "end": 61.76, "text": "连宠寿都舍不得放出来"}, {"start": 62.66, "end": 63.86, "text": "巴不得他偷懒"}, {"start": 64.02, "end": 65.38, "text": "等月末综合测评"}, {"start": 65.74, "end": 66.62, "text": "有的是人把他"}, {"start": 66.62, "end": 68.06, "text": "从班长的位置上拽下来"}]}