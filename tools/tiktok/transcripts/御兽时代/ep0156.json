{"file": "御兽时代-第156集.mp4", "ep": 156, "duration": 53.2, "segments": [{"start": 0.05, "end": 10.05, "text": "招生同考第一人沐云婷吗"}, {"start": 10.05, "end": 11.05, "text": "果然冲着我来了"}, {"start": 12.05, "end": 13.05, "text": "两百名榜上学员"}, {"start": 13.05, "end": 15.62, "text": "竟有46人"}, {"start": 15.62, "end": 17.62, "text": "同时指名挑战绑守林墨"}, {"start": 17.62, "end": 18.62, "text": "我欣赏你们的近距心"}, {"start": 18.62, "end": 19.62, "text": "但不得不说"}, {"start": 19.62, "end": 21.62, "text": "绝大多数人很愚蠢"}, {"start": 21.62, "end": 22.62, "text": "按规则"}, {"start": 22.62, "end": 23.62, "text": "除去前四席"}, {"start": 23.62, "end": 24.62, "text": "其余挑战者"}, {"start": 24.62, "end": 25.62, "text": "直接丧失所有资格"}, {"start": 26.62, "end": 27.62, "text": "获得挑战第一名"}, {"start": 27.62, "end": 31.82, "text": "林墨资格的"}, {"start": 31.82, "end": 32.82, "text": "仅有三人"}, {"start": 32.82, "end": 33.82, "text": "第二名沐云婷"}, {"start": 33.82, "end": 34.82, "text": "第三名傅子豪"}, {"start": 34.82, "end": 36.82, "text": "第四名碧云婷"}, {"start": 36.82, "end": 37.82, "text": "自第二百位"}, {"start": 37.82, "end": 38.82, "text": "开始迎战"}, {"start": 39.82, "end": 40.82, "text": "认输"}, {"start": 40.82, "end": 41.88, "text": "失去战力"}, {"start": 41.88, "end": 43.88, "text": "或跌出泪台者"}, {"start": 43.88, "end": 44.88, "text": "喷腹"}, {"start": 44.88, "end": 45.88, "text": "第一战"}, {"start": 45.88, "end": 47.88, "text": "第二百位喬少之"}, {"start": 47.88, "end": 49.88, "text": "对阵第一挑战者"}, {"start": 49.88, "end": 50.88, "text": "邓林"}]}