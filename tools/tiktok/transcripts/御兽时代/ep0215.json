{"file": "御兽时代-第215集.mp4", "ep": 215, "duration": 59.1, "segments": [{"start": 21.01, "end": 22.29, "text": "终于回到石林了"}, {"start": 22.29, "end": 22.97, "text": "林老大"}, {"start": 22.97, "end": 24.33, "text": "快看照片领路吧"}, {"start": 24.33, "end": 35.44, "text": "怎么了"}, {"start": 35.44, "end": 37.52, "text": "之前派的照片存在手机里"}, {"start": 37.52, "end": 39.15, "text": "但是"}, {"start": 39.15, "end": 40.19, "text": "手机没电了"}, {"start": 40.19, "end": 40.95, "text": "没电了"}, {"start": 40.95, "end": 41.43, "text": "林老大"}, {"start": 41.43, "end": 41.95, "text": "想个办法"}, {"start": 41.95, "end": 43.15, "text": "我们现在怎么办"}, {"start": 43.15, "end": 43.95, "text": "没有退路"}, {"start": 43.95, "end": 45.47, "text": "只能靠我脑海里残存的记忆"}, {"start": 45.47, "end": 46.39, "text": "硬闯石林迷宫"}, {"start": 46.39, "end": 46.95, "text": "丁硬"}, {"start": 46.95, "end": 48.15, "text": "两只战捧的极限时间"}, {"start": 48.15, "end": 48.55, "text": "还剩多少"}, {"start": 48.55, "end": 50.23, "text": "如果在三天内出去问题就不大"}, {"start": 50.23, "end": 51.27, "text": "超过十天"}, {"start": 51.27, "end": 52.07, "text": "剧毒攻心"}, {"start": 52.07, "end": 54.41, "text": "战捧将彻底永久残废"}, {"start": 54.41, "end": 55.74, "text": "三天"}, {"start": 55.74, "end": 56.98, "text": "那就抓紧出发吧"}]}