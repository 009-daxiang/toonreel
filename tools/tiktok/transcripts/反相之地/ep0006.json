{"file": "反相之地-第6集.mp4", "ep": 6, "duration": 880.6, "segments": [{"start": 65.78, "end": 67.22, "text": "最近熬夜打游戏打太多了"}, {"start": 67.22, "end": 68.22, "text": "势力很模糊"}, {"start": 68.22, "end": 69.22, "text": "想佩服眼睛"}, {"start": 69.22, "end": 70.22, "text": "行 过来测一下"}, {"start": 71.69, "end": 72.57, "text": "下巴放好"}, {"start": 72.57, "end": 73.77, "text": "盯住里面最远的房子"}, {"start": 77.51, "end": 78.59, "text": "我这"}, {"start": 78.59, "end": 79.59, "text": "我看到这个图片里面"}, {"start": 79.59, "end": 80.59, "text": "有两个人在打架"}, {"start": 82.23, "end": 83.71, "text": "同学 你这可能是非文证"}, {"start": 83.71, "end": 84.71, "text": "以后少打点游戏"}, {"start": 86.77, "end": 88.17, "text": "出口只能一个人出去"}, {"start": 88.17, "end": 89.05, "text": "你是假的"}, {"start": 89.05, "end": 89.97, "text": "你别往前走了"}, {"start": 89.97, "end": 90.49, "text": "行不行"}, {"start": 92.58, "end": 93.58, "text": "我瞧瞧你了"}, {"start": 93.58, "end": 94.34, "text": "让我出去吧"}, {"start": 94.34, "end": 95.14, "text": "你是假的"}, {"start": 98.06, "end": 99.1, "text": "你是假的"}, {"start": 99.1, "end": 99.7, "text": "我走"}, {"start": 109.7, "end": 110.7, "text": "你们到底是谁啊"}, {"start": 115.62, "end": 116.7, "text": "怎么又是你啊"}, {"start": 116.7, "end": 118.42, "text": "你可以不要往前走了吗"}, {"start": 118.42, "end": 119.9, "text": "我想活着"}, {"start": 119.9, "end": 121.13, "text": "我想回去"}, {"start": 121.13, "end": 122.49, "text": "我求求你了"}, {"start": 137.41, "end": 138.57, "text": "我还想活着"}, {"start": 138.57, "end": 140.13, "text": "你为什么要这么对我"}, {"start": 140.13, "end": 141.41, "text": "我才是真的"}, {"start": 141.41, "end": 142.89, "text": "我才是增量"}, {"start": 142.89, "end": 144.77, "text": "求求你别走了"}, {"start": 144.77, "end": 146.61, "text": "求求你别走了"}, {"start": 146.61, "end": 148.13, "text": "求求你了"}, {"start": 148.13, "end": 163.52, "text": "刚结束"}, {"start": 163.52, "end": 165.32, "text": "请观众们不要转移视线"}, {"start": 165.32, "end": 166.32, "text": "不要宣传"}, {"start": 166.32, "end": 167.92, "text": "否则后果自负"}, {"start": 167.92, "end": 454.55, "text": "宣传请示"}, {"start": 454.55, "end": 456.66, "text": "给大家读读你的作文吧"}, {"start": 456.66, "end": 457.5, "text": "长大以后"}, {"start": 457.54, "end": 458.74, "text": "我会成为"}, {"start": 458.74, "end": 459.42, "text": "富翁"}, {"start": 459.42, "end": 460.78, "text": "会变得非常自由"}, {"start": 460.78, "end": 462.66, "text": "买很多好吃的和饮料"}, {"start": 462.66, "end": 464.02, "text": "我以后会住在一片"}, {"start": 464.02, "end": 512.22, "text": "一望无际草原上的白房子里"}, {"start": 512.22, "end": 546.95, "text": "怎么感觉还是那么远啊"}, {"start": 546.95, "end": 548.51, "text": "这相机没少花钱吧"}, {"start": 548.51, "end": 550.15, "text": "攒了一年才买的"}, {"start": 550.15, "end": 551.31, "text": "暑假一起旅游去"}, {"start": 551.31, "end": 553.23, "text": "正好拍点东西"}, {"start": 553.23, "end": 554.11, "text": "下次吧"}, {"start": 554.11, "end": 555.39, "text": "以后时间多的是"}, {"start": 555.39, "end": 561.44, "text": "不要多管了"}, {"start": 561.44, "end": 577.24, "text": "是吧"}, {"start": 577.24, "end": 579.16, "text": "你这相机怎么天天拍我们啊"}, {"start": 579.16, "end": 580.52, "text": "什么时候出去旅游啊"}, {"start": 582.88, "end": 584.92, "text": "拍啥不是记录生活吗"}, {"start": 584.92, "end": 586.24, "text": "先把学业顾好"}, {"start": 586.28, "end": 587.72, "text": "等以后工作有钱了"}, {"start": 587.72, "end": 589.4, "text": "随便去旅游"}, {"start": 589.4, "end": 590.84, "text": "这相机都买了一年了"}, {"start": 590.84, "end": 592.2, "text": "总得出去拍一次吧"}, {"start": 592.2, "end": 592.84, "text": "对啊"}, {"start": 592.84, "end": 594.04, "text": "以后机会多的是"}, {"start": 603.08, "end": 609.11, "text": "你们到底是谁啊"}, {"start": 609.11, "end": 610.19, "text": "怎么又是你啊"}, {"start": 610.19, "end": 611.91, "text": "你可以不要往前走了吗"}, {"start": 611.91, "end": 613.55, "text": "我想活着"}, {"start": 613.55, "end": 614.83, "text": "我想回水"}, {"start": 614.83, "end": 617.79, "text": "求求你了"}, {"start": 618.79, "end": 663.4, "text": "一上双"}, {"start": 663.4, "end": 665.28, "text": "与头望迷离"}, {"start": 665.28, "end": 665.88, "text": "真棒"}, {"start": 665.88, "end": 667.96, "text": "小增亮以后一定会很有才华"}, {"start": 667.96, "end": 672.36, "text": "妈妈"}, {"start": 672.36, "end": 674.0, "text": "老师又让我流淌了"}, {"start": 674.0, "end": 674.8, "text": "没事"}, {"start": 674.8, "end": 676.16, "text": "增亮快吃饭吧"}, {"start": 677.52, "end": 681.02, "text": "一定考全年级第一"}, {"start": 681.02, "end": 686.08, "text": "增亮"}, {"start": 686.08, "end": 687.36, "text": "陪妈妈逛逛吧"}, {"start": 687.36, "end": 689.48, "text": "妈妈还不知道大学长啥样呢"}, {"start": 689.48, "end": 690.34, "text": "妈"}, {"start": 690.34, "end": 690.86, "text": "以后吧"}, {"start": 690.86, "end": 691.94, "text": "我还得去弄床铺呢"}, {"start": 691.94, "end": 692.38, "text": "正好"}, {"start": 692.38, "end": 693.74, "text": "妈帮你一块去铺床啊"}, {"start": 693.74, "end": 694.22, "text": "不用了"}, {"start": 694.22, "end": 695.06, "text": "我都长大了"}, {"start": 695.06, "end": 696.66, "text": "那陪妈妈在附近逛逛吧"}, {"start": 696.66, "end": 698.38, "text": "妈妈头一回来大城市"}, {"start": 698.38, "end": 699.02, "text": "以后吧"}, {"start": 699.14, "end": 700.06, "text": "等我以后买了房"}, {"start": 700.06, "end": 701.06, "text": "天天接你来住"}, {"start": 705.59, "end": 706.43, "text": "妈你别哭啊"}, {"start": 706.43, "end": 707.71, "text": "你哭啥呀"}, {"start": 707.71, "end": 707.99, "text": "妈"}, {"start": 707.99, "end": 708.83, "text": "以后有的是时间"}, {"start": 708.83, "end": 723.18, "text": "你先回去吧"}, {"start": 723.18, "end": 724.38, "text": "我还想活着"}, {"start": 724.38, "end": 725.9, "text": "你为什么要这么对我"}, {"start": 725.9, "end": 727.18, "text": "我才是真的"}, {"start": 727.18, "end": 728.66, "text": "我才是增亮"}, {"start": 728.66, "end": 730.26, "text": "求求你 别走啦"}, {"start": 825.43, "end": 825.91, "text": "子涵"}, {"start": 825.91, "end": 826.95, "text": "你的眼睛咋样了"}, {"start": 826.95, "end": 827.99, "text": "医生说是非闻症"}, {"start": 827.99, "end": 829.03, "text": "让我少关灯玩游戏"}, {"start": 829.03, "end": 830.23, "text": "那你少打点游戏啊"}, {"start": 830.23, "end": 831.43, "text": "好啊好啊"}, {"start": 831.43, "end": 837.1, "text": "大爷 你谁啊"}, {"start": 837.1, "end": 838.42, "text": "你怎么进我们宿舍了"}, {"start": 838.42, "end": 845.19, "text": "吃不玩了"}, {"start": 845.19, "end": 848.32, "text": "我是增亮"}, {"start": 848.32, "end": 849.12, "text": "啥意思大爷"}, {"start": 849.12, "end": 849.96, "text": "你咋知道我有个事"}, {"start": 849.96, "end": 851.81, "text": "有叫增亮的"}, {"start": 851.81, "end": 854.48, "text": "我真的是增亮"}, {"start": 854.48, "end": 856.32, "text": "刮台风那天"}, {"start": 856.32, "end": 857.56, "text": "我和潘子"}, {"start": 857.56, "end": 860.34, "text": "小龙进了另一个世界"}, {"start": 860.34, "end": 862.38, "text": "我以为我们永远回不来了"}, {"start": 862.38, "end": 864.14, "text": "如果你真的是增亮"}, {"start": 864.14, "end": 865.78, "text": "你怎么变得这么老了"}]}