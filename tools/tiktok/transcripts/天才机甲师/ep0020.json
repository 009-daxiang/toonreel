{"file": "天才机甲师-第20集.mp4", "ep": 20, "duration": 172.2, "segments": [{"start": 2.74, "end": 3.7, "text": "天公大厅"}, {"start": 3.94, "end": 5.42, "text": "全联邦唯一能同时塞进"}, {"start": 5.42, "end": 6.94, "text": "五台S机机甲的地方"}, {"start": 7.3, "end": 8.5, "text": "从地面到穷顶"}, {"start": 8.7, "end": 9.7, "text": "两百米进空"}, {"start": 10.02, "end": 11.3, "text": "你在竞技场造的大卫"}, {"start": 11.3, "end": 12.46, "text": "和维纳斯白的这儿"}, {"start": 12.82, "end": 14.38, "text": "还没诛券的脚踝稿"}, {"start": 25.62, "end": 27.82, "text": "那边是量产机的维护平台"}, {"start": 28.1, "end": 29.66, "text": "联邦所有C级到A级的"}, {"start": 29.66, "end": 30.5, "text": "制式机甲"}, {"start": 30.74, "end": 32.54, "text": "都在这儿统一维修保养"}, {"start": 33.3, "end": 41.06, "text": "头顶是舰队机型的维护轨道"}, {"start": 41.54, "end": 43.26, "text": "还有可变形的舰队"}, {"start": 45.7, "end": 47.86, "text": "天上飞的都在这儿了"}, {"start": 48.74, "end": 50.1, "text": "没有他们的侦测"}, {"start": 50.78, "end": 52.7, "text": "地面部队就是虾子"}, {"start": 60.86, "end": 62.62, "text": "曙光是引起了一家级"}, {"start": 62.62, "end": 64.9, "text": "联邦第一台精神干扰型机甲"}, {"start": 64.9, "end": 66.94, "text": "少次了四名S机驾驶员"}, {"start": 66.94, "end": 68.58, "text": "十年前就被永久封存"}, {"start": 68.58, "end": 69.46, "text": "任何人不得考虑"}, {"start": 69.46, "end": 71.14, "text": "卓妍 那小子来了"}, {"start": 71.74, "end": 73.7, "text": "昨天擂台上狂城内啊"}, {"start": 73.9, "end": 75.82, "text": "今天怎么怂得坐轮椅了"}, {"start": 75.82, "end": 77.58, "text": "老陆 少欺负新来的"}, {"start": 77.58, "end": 79.22, "text": "你的推进系统再不升级"}, {"start": 79.22, "end": 80.9, "text": "下次冲刺还得少转动气"}, {"start": 80.9, "end": 82.27, "text": "到时候别又让我加班"}, {"start": 82.27, "end": 83.14, "text": "给你擦屁股"}, {"start": 83.14, "end": 84.78, "text": "老陆 别吓着人家"}, {"start": 84.82, "end": 86.58, "text": "卓妍 吃了吗"}, {"start": 86.58, "end": 88.14, "text": "食堂今天红烧肉不出"}, {"start": 89.05, "end": 90.93, "text": "这不是昨天比赛的评委们吗"}, {"start": 91.51, "end": 92.43, "text": "卓妍 选手"}, {"start": 92.91, "end": 94.59, "text": "昨天还在擂台隔斗"}, {"start": 94.59, "end": 96.07, "text": "今天怎么坐上轮椅了"}, {"start": 96.99, "end": 97.99, "text": "谁受伤了"}, {"start": 98.35, "end": 100.07, "text": "我就是 懒得走路"}, {"start": 100.07, "end": 101.83, "text": "妖哥 这是陈宇"}, {"start": 101.83, "end": 102.79, "text": "军宣传出继承"}, {"start": 102.79, "end": 103.67, "text": "你小心点"}, {"start": 103.67, "end": 104.47, "text": "这人为了抢镜头"}, {"start": 104.47, "end": 105.51, "text": "什么都干得出来"}, {"start": 105.51, "end": 106.39, "text": "卓妍 选手"}, {"start": 106.39, "end": 108.19, "text": "你决赛那招太酷了"}, {"start": 108.19, "end": 109.71, "text": "以后能预约个专访吗"}, {"start": 109.99, "end": 110.27, "text": "停啊"}, {"start": 110.27, "end": 112.15, "text": "妖哥 你还真急啊"}, {"start": 112.59, "end": 113.55, "text": "这人为了抢独家"}, {"start": 113.55, "end": 115.15, "text": "能在鸡甲角底下蹲一天"}, {"start": 115.19, "end": 116.67, "text": "上回差点被青龙猜贬"}, {"start": 129.19, "end": 130.94, "text": "别追 让他去"}, {"start": 139.49, "end": 141.25, "text": "玉寒城岛域双S级重组入侵"}, {"start": 141.25, "end": 142.49, "text": "目标代号千毒恶斯"}, {"start": 142.49, "end": 143.29, "text": "捕食者阿迦特"}, {"start": 143.29, "end": 144.57, "text": "两大S级同时出现"}, {"start": 146.27, "end": 148.31, "text": "青龙悬无 即刻出击"}, {"start": 148.31, "end": 150.11, "text": "给我把虫子定死在海岸线外"}, {"start": 150.47, "end": 167.58, "text": "快就被入侵了"}, {"start": 167.58, "end": 168.3, "text": "启明"}, {"start": 168.3, "end": 170.78, "text": "初要去天资中心做入职定籍"}, {"start": 170.78, "end": 171.98, "text": "我得去指挥中心"}]}