{"file": "天才机甲师-第33集.mp4", "ep": 33, "duration": 72.5, "segments": [{"start": 0.0, "end": 0.5, "text": "行"}, {"start": 1.2, "end": 2.08, "text": "那你小心点"}, {"start": 2.44, "end": 11.59, "text": "我去"}, {"start": 11.99, "end": 13.15, "text": "苍月你来真的"}, {"start": 13.51, "end": 14.83, "text": "你让我用全力的"}, {"start": 15.07, "end": 27.14, "text": "已经是A级了"}, {"start": 27.3, "end": 29.02, "text": "守没了"}, {"start": 29.3, "end": 33.42, "text": "毕竟那方中了三倍不及"}, {"start": 33.9, "end": 35.5, "text": "你为什么还不还手"}, {"start": 36.08, "end": 37.04, "text": "我怎么舍得"}, {"start": 37.44, "end": 38.56, "text": "有嘴话事"}, {"start": 43.06, "end": 43.7, "text": "打爽了吗"}, {"start": 44.85, "end": 45.41, "text": "你干吗"}, {"start": 45.49, "end": 46.21, "text": "我洗澡了"}, {"start": 46.49, "end": 47.65, "text": "你身上的气味变了"}, {"start": 47.85, "end": 48.89, "text": "有点像高阶虫族"}, {"start": 49.73, "end": 51.21, "text": "可能是在太尾北辰里沾的"}, {"start": 51.49, "end": 52.53, "text": "只要精神一连接"}, {"start": 52.65, "end": 54.09, "text": "那股子虫族频率就往上穿"}, {"start": 54.17, "end": 54.93, "text": "原来如此"}, {"start": 55.33, "end": 56.25, "text": "陪练当得不错"}, {"start": 56.61, "end": 57.85, "text": "虽然有点自不良利"}, {"start": 58.29, "end": 58.93, "text": "但谢谢"}, {"start": 60.46, "end": 60.98, "text": "班下"}, {"start": 61.14, "end": 61.98, "text": "数据拿到了"}, {"start": 62.18, "end": 63.38, "text": "今晚总装银棋"}, {"start": 70.18, "end": 71.38, "text": "赶在她生育之前"}]}