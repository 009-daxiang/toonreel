{"file": "天才机甲师-第34集.mp4", "ep": 34, "duration": 78.7, "segments": [{"start": 17.26, "end": 18.86, "text": "太尾北城主炮正在调装"}, {"start": 18.86, "end": 20.14, "text": "推进器涡轮已就位"}, {"start": 20.14, "end": 20.94, "text": "预计今天完工"}, {"start": 20.94, "end": 21.42, "text": "走"}, {"start": 21.82, "end": 22.42, "text": "看看去"}, {"start": 24.02, "end": 25.62, "text": "等塞进主炮和推进器"}, {"start": 26.02, "end": 27.06, "text": "这家伙打起来"}, {"start": 27.06, "end": 28.1, "text": "比阿修罗还猛"}, {"start": 28.66, "end": 29.26, "text": "妖哥"}, {"start": 29.84, "end": 31.04, "text": "今天是什么日子"}, {"start": 31.04, "end": 31.76, "text": "你知道吧"}, {"start": 32.38, "end": 32.98, "text": "当然"}, {"start": 34.61, "end": 35.65, "text": "也是他的生日"}, {"start": 45.12, "end": 46.12, "text": "今天我休息"}, {"start": 46.44, "end": 47.56, "text": "有事明天再说"}, {"start": 49.98, "end": 51.22, "text": "休息还在训练"}, {"start": 51.77, "end": 52.61, "text": "生日快乐"}, {"start": 52.77, "end": 57.13, "text": "你怎么知道的"}, {"start": 57.45, "end": 59.09, "text": "翻档案不小心看见呢"}, {"start": 61.18, "end": 61.94, "text": "我去看阿修罗"}, {"start": 61.94, "end": 62.9, "text": "两只预计虫子"}, {"start": 62.9, "end": 63.86, "text": "体长不到40米"}, {"start": 63.86, "end": 64.42, "text": "没必要"}, {"start": 64.66, "end": 65.86, "text": "试试这个合不合身"}, {"start": 65.86, "end": 67.42, "text": "S级穿带时机甲赢机"}, {"start": 67.42, "end": 68.54, "text": "专攻小体型目标"}, {"start": 68.54, "end": 69.42, "text": "你这一个月"}, {"start": 69.42, "end": 70.54, "text": "就是在做这个"}, {"start": 71.2, "end": 71.92, "text": "生日礼物"}, {"start": 71.92, "end": 72.44, "text": "试试看"}, {"start": 77.14, "end": 77.78, "text": "跟上我"}]}