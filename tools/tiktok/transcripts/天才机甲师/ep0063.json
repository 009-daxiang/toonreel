{"file": "天才机甲师-第63集.mp4", "ep": 63, "duration": 129.0, "segments": [{"start": 0.0, "end": 28.33, "text": "他们全静了"}, {"start": 28.33, "end": 30.13, "text": "开走你的中天北黄"}, {"start": 30.13, "end": 31.55, "text": "从正义名过去"}, {"start": 31.55, "end": 32.75, "text": "让我看看"}, {"start": 32.75, "end": 33.63, "text": "你造的机甲"}, {"start": 33.63, "end": 35.75, "text": "丝丝与自己的戒备是什么样子"}, {"start": 35.75, "end": 36.35, "text": "是"}, {"start": 36.35, "end": 75.32, "text": "狂青网络列机被欠"}, {"start": 75.32, "end": 77.32, "text": "灭约性逻辑病毒全线引爆了"}, {"start": 77.32, "end": 78.32, "text": "趁现在"}, {"start": 78.32, "end": 80.32, "text": "所有火力集中隔路幕后"}, {"start": 80.32, "end": 94.22, "text": "你迟到了"}, {"start": 94.22, "end": 95.22, "text": "路上有人盯着"}, {"start": 95.22, "end": 96.22, "text": "绕了个案子"}, {"start": 96.22, "end": 101.63, "text": "泽格莉斯"}, {"start": 101.63, "end": 103.63, "text": "你反派的那一刻精神所"}, {"start": 103.63, "end": 104.63, "text": "就该烧穿你的脑子"}, {"start": 104.63, "end": 105.7, "text": "为什么你还活着"}, {"start": 105.7, "end": 106.7, "text": "他忘了一件事"}, {"start": 106.7, "end": 108.7, "text": "你掌管身体的情况下"}, {"start": 108.7, "end": 109.7, "text": "精神走不下"}, {"start": 109.7, "end": 110.73, "text": "老妖婆"}, {"start": 110.73, "end": 112.73, "text": "你看看现在是谁在说"}, {"start": 112.73, "end": 117.02, "text": "玉皇"}, {"start": 117.02, "end": 119.09, "text": "现在确实没法掌控重组"}, {"start": 119.09, "end": 122.34, "text": "你们两个都给我死"}]}