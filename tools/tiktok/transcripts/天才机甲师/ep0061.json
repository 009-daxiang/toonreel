{"file": "天才机甲师-第61集.mp4", "ep": 61, "duration": 127.2, "segments": [{"start": 1.49, "end": 3.49, "text": "让你清掉乾少战"}, {"start": 3.49, "end": 6.49, "text": "你回来的比预计慢了整整一刻中"}, {"start": 6.49, "end": 9.1, "text": "遇到了灵苍月"}, {"start": 9.1, "end": 11.9, "text": "那为什么不杀了她"}, {"start": 11.9, "end": 12.9, "text": "杀了她"}, {"start": 12.9, "end": 14.9, "text": "人类舰队会立刻撤退"}, {"start": 14.9, "end": 15.9, "text": "留她活着"}, {"start": 15.9, "end": 17.9, "text": "她才会带着全部主力来复仇"}, {"start": 17.9, "end": 18.9, "text": "三天后"}, {"start": 18.9, "end": 19.9, "text": "翼王打尽"}, {"start": 19.9, "end": 20.9, "text": "你胸口的伤势"}, {"start": 20.9, "end": 21.9, "text": "最后一道"}, {"start": 21.9, "end": 23.9, "text": "灵苍月拼死反铺"}, {"start": 23.9, "end": 25.9, "text": "泽哥利斯的神经脉冲残留"}, {"start": 25.9, "end": 27.9, "text": "确实是她的力量"}, {"start": 27.9, "end": 29.9, "text": "她在你身上留了这道伤"}, {"start": 29.9, "end": 30.9, "text": "你都没杀她"}, {"start": 30.9, "end": 31.99, "text": "留她活着"}, {"start": 31.99, "end": 36.05, "text": "三天后能杀更多人"}, {"start": 36.05, "end": 37.05, "text": "聂琳"}, {"start": 37.05, "end": 39.04, "text": "女皇陛下"}, {"start": 39.04, "end": 40.04, "text": "三天后"}, {"start": 40.04, "end": 42.04, "text": "人类远征舰队会发动总攻"}, {"start": 42.04, "end": 43.04, "text": "等他们全部穿过天列"}, {"start": 43.04, "end": 45.04, "text": "然后关上天列切断退路"}, {"start": 45.04, "end": 46.04, "text": "我要在沃诺阁的上空"}, {"start": 46.04, "end": 47.04, "text": "把人类最后的舰队"}, {"start": 47.04, "end": 48.04, "text": "烧成灰剂"}, {"start": 48.04, "end": 50.04, "text": "你和格鲁姆打头阵"}, {"start": 50.04, "end": 51.04, "text": "让我亲眼看看"}, {"start": 51.04, "end": 53.04, "text": "你们俩一起能杀多少人类"}, {"start": 53.04, "end": 66.14, "text": "施主任偏了0.1赫兹"}, {"start": 66.14, "end": 68.14, "text": "母心池的侦测阵令会发现你"}, {"start": 68.14, "end": 69.66, "text": "别吵"}, {"start": 69.66, "end": 77.64, "text": "我在孝顺"}, {"start": 77.64, "end": 78.64, "text": "这么晚"}, {"start": 78.64, "end": 80.67, "text": "还在走廊里干什么"}, {"start": 80.67, "end": 82.67, "text": "检查防御节点"}, {"start": 82.67, "end": 83.67, "text": "明天打头阵"}, {"start": 83.67, "end": 88.87, "text": "总得先摸清站位"}, {"start": 88.87, "end": 89.87, "text": "你的石海上"}, {"start": 89.87, "end": 91.87, "text": "只有泽哥利斯的气息"}, {"start": 91.87, "end": 94.16, "text": "别在我眼皮底下做多余的事"}, {"start": 94.16, "end": 95.16, "text": "她没发现"}, {"start": 95.16, "end": 97.16, "text": "她的探测只查了你的石海"}, {"start": 97.16, "end": 98.16, "text": "看不出破绽"}, {"start": 98.16, "end": 100.16, "text": "不过你刚才中断植入的时候"}, {"start": 100.16, "end": 101.16, "text": "病毒的前刀马还差"}, {"start": 101.16, "end": 102.16, "text": "最后一段没掐进去"}, {"start": 102.16, "end": 106.05, "text": "那就现在切换"}, {"start": 106.05, "end": 110.09, "text": "成了"}, {"start": 110.09, "end": 111.44, "text": "三天后"}, {"start": 111.44, "end": 113.44, "text": "母心池的每一条指令"}, {"start": 113.44, "end": 115.54, "text": "都会带着我的病毒跑"}, {"start": 115.54, "end": 117.54, "text": "等中天北皇一起动"}, {"start": 117.54, "end": 120.54, "text": "整个风群网络从内部崩溃"}, {"start": 120.54, "end": 121.54, "text": "你说过了"}, {"start": 121.54, "end": 124.56, "text": "你紧张的时候话也挺多"}, {"start": 124.56, "end": 125.56, "text": "闭嘴"}]}