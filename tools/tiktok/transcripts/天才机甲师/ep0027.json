{"file": "天才机甲师-第27集.mp4", "ep": 27, "duration": 88.2, "segments": [{"start": 0.0, "end": 1.8, "text": "恭喜获得神秘獎勵"}, {"start": 1.8, "end": 4.48, "text": "液態金屬神經元編織技術"}, {"start": 4.48, "end": 7.84, "text": "該技術可將神經鏈接反視率降低為0"}, {"start": 7.84, "end": 10.2, "text": "解決駕駛員的精神狂躁症"}, {"start": 10.2, "end": 17.93, "text": "蒼月的狂躁症有辦法了"}, {"start": 17.93, "end": 18.77, "text": "放了"}, {"start": 18.77, "end": 19.93, "text": "這活我接了"}, {"start": 19.93, "end": 22.53, "text": "曙光機的改個名叫太威北辰"}, {"start": 22.53, "end": 24.17, "text": "這名字不錯"}, {"start": 24.17, "end": 25.21, "text": "我有三個條件"}, {"start": 25.21, "end": 25.73, "text": "第一"}, {"start": 25.73, "end": 27.13, "text": "太威北辰設計從頭再來"}, {"start": 27.13, "end": 28.93, "text": "我需要軍工部最高修理改造全線"}, {"start": 28.93, "end": 31.09, "text": "圖紙零件全部對我開放"}, {"start": 31.09, "end": 33.09, "text": "你不問我也一定會給你"}, {"start": 33.09, "end": 33.89, "text": "第二"}, {"start": 33.97, "end": 35.89, "text": "我想造一台穿戴型機甲"}, {"start": 35.89, "end": 38.45, "text": "專門適配有精神反視問題的駕駛員"}, {"start": 38.45, "end": 39.85, "text": "零件和材料單獨皮"}, {"start": 39.85, "end": 41.57, "text": "不走常規採購"}, {"start": 41.57, "end": 43.18, "text": "北藏約單"}, {"start": 43.18, "end": 44.1, "text": "準了"}, {"start": 44.1, "end": 45.82, "text": "零件從倉庫直接掉"}, {"start": 45.82, "end": 47.14, "text": "寄我賬上"}, {"start": 47.14, "end": 48.38, "text": "最後一個條件"}, {"start": 48.38, "end": 50.26, "text": "十九車間以後獨立運作"}, {"start": 50.26, "end": 51.7, "text": "不停填寺中心調配"}, {"start": 51.7, "end": 52.22, "text": "好"}, {"start": 52.22, "end": 53.06, "text": "批了"}, {"start": 53.06, "end": 56.3, "text": "我本來把你預分配在一車間"}, {"start": 56.3, "end": 57.86, "text": "十九車間也挺好"}, {"start": 57.86, "end": 59.86, "text": "顧世軒私作主張打壓人才的事"}, {"start": 59.86, "end": 61.54, "text": "我會親自找他算賬"}, {"start": 61.54, "end": 63.66, "text": "你先做好曙光機的改造"}, {"start": 63.7, "end": 64.66, "text": "先放了"}, {"start": 64.66, "end": 66.34, "text": "那我先走了"}, {"start": 66.34, "end": 67.34, "text": "王靈"}, {"start": 67.34, "end": 69.34, "text": "這小子挺有你當年的風範"}, {"start": 70.53, "end": 71.49, "text": "大家聽我說"}, {"start": 71.49, "end": 73.89, "text": "曙光試驗期改造項目正式啟動"}, {"start": 73.89, "end": 75.01, "text": "由我處要"}, {"start": 75.01, "end": 76.61, "text": "帶領十九車間的大家"}, {"start": 76.61, "end": 78.65, "text": "將曙光改造成S級機甲"}, {"start": 78.65, "end": 79.97, "text": "他以後的名字就叫"}, {"start": 79.97, "end": 81.01, "text": "太威北辰"}, {"start": 81.01, "end": 81.53, "text": "好耶"}, {"start": 81.53, "end": 82.17, "text": "又有活兒幹了"}, {"start": 82.17, "end": 83.65, "text": "房組長既然把大項目交給我們"}, {"start": 83.65, "end": 86.73, "text": "什麼就得好好幹"}, {"start": 86.73, "end": 88.21, "text": "恭喜啊 楚組長"}]}