{"file": "天才机甲师-第49集.mp4", "ep": 49, "duration": 135.4, "segments": [{"start": 0.0, "end": 1.2, "text": "再生核心都炸了"}, {"start": 1.44, "end": 2.04, "text": "还能动"}, {"start": 2.92, "end": 3.44, "text": "这一击"}, {"start": 3.84, "end": 4.8, "text": "打穿你的喉咙"}, {"start": 11.66, "end": 13.18, "text": "丽维同生命信号归零"}, {"start": 13.42, "end": 14.82, "text": "其与天列之间的超空间"}, {"start": 14.82, "end": 15.5, "text": "链路崩溃中"}, {"start": 15.5, "end": 16.34, "text": "丽维同死了"}, {"start": 16.62, "end": 18.06, "text": "这条链路也会跟着他掉"}, {"start": 18.86, "end": 20.5, "text": "但如果利用链路参与频率"}, {"start": 21.18, "end": 22.3, "text": "反向注入线阵"}, {"start": 22.82, "end": 23.9, "text": "或许能把天列"}, {"start": 23.9, "end": 25.34, "text": "固化成一条双向通道"}, {"start": 25.58, "end": 26.22, "text": "太威遇"}, {"start": 26.22, "end": 26.82, "text": "全攻率"}, {"start": 26.82, "end": 28.02, "text": "太威遇百分之百攻率"}, {"start": 28.02, "end": 29.54, "text": "将导致神经原链不过改"}, {"start": 29.78, "end": 30.42, "text": "执行中"}, {"start": 30.58, "end": 32.42, "text": "太威遇攻率百分之九十"}, {"start": 33.18, "end": 33.9, "text": "百分之百"}, {"start": 34.06, "end": 34.98, "text": "已超过安全域"}, {"start": 34.98, "end": 35.7, "text": "扛中"}, {"start": 39.98, "end": 41.7, "text": "天列空间褶皱与雾化"}, {"start": 41.7, "end": 42.7, "text": "坐标锁定"}, {"start": 44.03, "end": 44.75, "text": "是天列"}, {"start": 44.75, "end": 45.83, "text": "真的是天列"}, {"start": 48.8, "end": 49.72, "text": "太威北城还在"}, {"start": 49.72, "end": 50.92, "text": "但机体损伤严重"}, {"start": 50.92, "end": 51.48, "text": "天列"}, {"start": 51.76, "end": 52.64, "text": "天列稳住了"}, {"start": 52.76, "end": 53.96, "text": "变成双向通道了"}, {"start": 53.96, "end": 54.8, "text": "绿维塔虽然积极"}, {"start": 54.8, "end": 56.24, "text": "但四大卫城的重朝还没退"}, {"start": 56.24, "end": 57.4, "text": "天血城外墙已失守"}, {"start": 57.4, "end": 58.16, "text": "元帅战死"}, {"start": 58.16, "end": 59.04, "text": "指揮链断了"}, {"start": 59.2, "end": 60.72, "text": "谁还有权限调动权军"}, {"start": 66.82, "end": 67.34, "text": "我来"}, {"start": 68.07, "end": 69.67, "text": "重群精神网络正在瓦解"}, {"start": 69.87, "end": 70.67, "text": "各卫城的重朝"}, {"start": 70.67, "end": 71.51, "text": "会在三分钟内"}, {"start": 71.51, "end": 72.51, "text": "赐线指挥真空"}, {"start": 72.87, "end": 73.35, "text": "路横"}, {"start": 73.47, "end": 74.43, "text": "玉恒城海岸线"}, {"start": 74.51, "end": 75.51, "text": "你那边的重群还有多少"}, {"start": 75.51, "end": 76.03, "text": "不清"}, {"start": 76.03, "end": 76.87, "text": "右臂没了"}, {"start": 76.87, "end": 77.71, "text": "左臂还在"}, {"start": 78.31, "end": 78.83, "text": "够了"}, {"start": 78.99, "end": 80.35, "text": "把他们往海岸防线外侧引"}, {"start": 80.35, "end": 81.27, "text": "别让他们进城"}, {"start": 81.27, "end": 81.9, "text": "收到"}, {"start": 81.9, "end": 82.54, "text": "桌岩"}, {"start": 82.82, "end": 84.5, "text": "天血城至高点还能撑多久"}, {"start": 86.33, "end": 87.69, "text": "但要存量百分之二十"}, {"start": 87.97, "end": 88.97, "text": "只能再打一混"}, {"start": 88.97, "end": 89.77, "text": "打完这一轮"}, {"start": 89.77, "end": 90.77, "text": "撤至第二防线"}, {"start": 90.85, "end": 92.61, "text": "后卫舰队正在清空车会轨道"}, {"start": 96.58, "end": 97.1, "text": "北山"}, {"start": 97.34, "end": 98.78, "text": "天血城户队还能防多久"}, {"start": 99.02, "end": 102.42, "text": "十五分钟"}, {"start": 102.66, "end": 103.54, "text": "十五分钟后户队"}, {"start": 103.54, "end": 105.06, "text": "强度会跌到百分之五以下"}, {"start": 105.66, "end": 106.22, "text": "十五分钟"}, {"start": 106.22, "end": 107.58, "text": "够舰队完成撤离野兴"}, {"start": 107.78, "end": 108.3, "text": "撑住"}, {"start": 110.27, "end": 110.83, "text": "长风"}, {"start": 113.7, "end": 114.9, "text": "守住药塞入口"}, {"start": 115.1, "end": 117.26, "text": "舰队撤离轨道经过天资上框"}, {"start": 117.26, "end": 118.62, "text": "不能没有船群出航"}, {"start": 118.9, "end": 124.83, "text": "袁帅他"}, {"start": 124.83, "end": 125.55, "text": "我知道"}, {"start": 127.02, "end": 128.9, "text": "联邦袁帅临天效与战死"}, {"start": 129.26, "end": 130.54, "text": "按战时继承体力"}, {"start": 130.66, "end": 132.02, "text": "由我接任职会权"}, {"start": 132.42, "end": 133.26, "text": "有意义吗"}, {"start": 134.51, "end": 135.39, "text": "没有 袁帅"}]}