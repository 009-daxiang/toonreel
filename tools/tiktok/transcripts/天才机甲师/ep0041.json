{"file": "天才机甲师-第41集.mp4", "ep": 41, "duration": 105.7, "segments": [{"start": 0.0, "end": 2.0, "text": "常规探测不行 就用非常规的"}, {"start": 2.0, "end": 3.0, "text": "我能看到天烈"}, {"start": 3.0, "end": 5.0, "text": "是因为太威北城的重群共鸣"}, {"start": 5.0, "end": 6.0, "text": "把我的意识拔到了近地轨道"}, {"start": 6.0, "end": 8.0, "text": "如果再做一次深度连接"}, {"start": 8.0, "end": 9.0, "text": "主动激发共鸣"}, {"start": 9.0, "end": 10.0, "text": "也许能穿透那层褶皱"}, {"start": 10.0, "end": 12.0, "text": "拿到里面的实施情况"}, {"start": 12.0, "end": 14.0, "text": "上次共鸣是在主炮违庄"}, {"start": 14.0, "end": 16.0, "text": "反应对出力不到六成的情况下出发的"}, {"start": 16.0, "end": 18.0, "text": "要让信号强度翻三倍"}, {"start": 18.0, "end": 20.0, "text": "必须等主炮武器系统全部就位"}, {"start": 20.0, "end": 22.0, "text": "反应成满功率运转"}, {"start": 22.0, "end": 24.0, "text": "武器系统还要多久"}, {"start": 24.0, "end": 25.13, "text": "明天"}, {"start": 25.13, "end": 27.35, "text": "在哪测试武器"}, {"start": 27.35, "end": 29.35, "text": "城外沙漠 荒武区"}, {"start": 29.35, "end": 31.35, "text": "方云三百公里没有活物"}, {"start": 31.35, "end": 32.35, "text": "那片区域我熟"}, {"start": 32.35, "end": 33.35, "text": "二十年前河报试验"}, {"start": 33.35, "end": 34.35, "text": "就是在那里做的"}, {"start": 34.35, "end": 35.35, "text": "地表是洁经沙梯"}, {"start": 35.35, "end": 37.35, "text": "能承受高能量冲击"}, {"start": 37.35, "end": 39.35, "text": "地底没有军草污染记录"}, {"start": 39.35, "end": 40.35, "text": "就定那"}, {"start": 40.35, "end": 41.35, "text": "明晚之前主炮就位"}, {"start": 41.35, "end": 42.35, "text": "做完武器当量测试"}, {"start": 42.35, "end": 43.35, "text": "立刻进行第二次"}, {"start": 43.35, "end": 44.35, "text": "重群共鸣验"}, {"start": 44.35, "end": 45.35, "text": "方老 让你的人"}, {"start": 45.35, "end": 46.35, "text": "准备好接收数据"}, {"start": 46.35, "end": 47.35, "text": "研究组已经就位"}, {"start": 47.35, "end": 49.35, "text": "就等你的信号"}, {"start": 49.35, "end": 51.31, "text": "苍月"}, {"start": 51.31, "end": 52.31, "text": "明天武器测试"}, {"start": 52.31, "end": 53.31, "text": "你护航"}, {"start": 53.31, "end": 54.31, "text": "明白"}, {"start": 54.31, "end": 55.44, "text": "我呢"}, {"start": 55.44, "end": 56.44, "text": "你伤美好"}, {"start": 56.44, "end": 57.44, "text": "留守基地"}, {"start": 57.44, "end": 58.44, "text": "不是"}, {"start": 61.02, "end": 62.02, "text": "那样测试如果成功"}, {"start": 62.02, "end": 64.02, "text": "泰威北辰就是联邦"}, {"start": 64.02, "end": 65.02, "text": "第一台真正意义上的"}, {"start": 65.02, "end": 67.02, "text": "反攻型SG机甲"}, {"start": 67.02, "end": 68.02, "text": "方老 测试结束后"}, {"start": 68.02, "end": 69.02, "text": "是不是该在云端餐厅"}, {"start": 69.02, "end": 70.02, "text": "摆一座"}, {"start": 70.02, "end": 72.02, "text": "难得你主动提庆功宴"}, {"start": 72.02, "end": 73.02, "text": "仗还没打完"}, {"start": 73.02, "end": 74.02, "text": "不算庆功"}, {"start": 74.02, "end": 75.02, "text": "先让这小子"}, {"start": 75.02, "end": 76.02, "text": "和他那帮"}, {"start": 76.02, "end": 77.02, "text": "十九车间的弟兄"}, {"start": 77.02, "end": 78.02, "text": "吃顿好的"}, {"start": 78.02, "end": 79.02, "text": "后面有的适应仗要"}, {"start": 79.02, "end": 80.02, "text": "好 吃饱喝足"}, {"start": 80.02, "end": 81.02, "text": "干起仗来才有力气"}, {"start": 81.02, "end": 82.34, "text": "听见没"}, {"start": 82.34, "end": 84.34, "text": "云端餐厅"}, {"start": 84.34, "end": 85.34, "text": "那地方老子"}, {"start": 85.34, "end": 86.34, "text": "两年没进去了"}, {"start": 86.34, "end": 87.34, "text": "你测试顺利"}, {"start": 87.34, "end": 88.34, "text": "回来兄弟陪你喝"}, {"start": 89.62, "end": 90.62, "text": "你伤还没好"}, {"start": 90.62, "end": 91.62, "text": "能喝"}, {"start": 91.62, "end": 92.62, "text": "当然"}, {"start": 92.62, "end": 93.62, "text": "我可是海量"}, {"start": 95.88, "end": 96.88, "text": "药哥"}, {"start": 96.88, "end": 98.88, "text": "重拳频率突破百分之五百了"}, {"start": 98.88, "end": 99.88, "text": "天赐中心服务器"}, {"start": 99.88, "end": 100.88, "text": "直接崩了两台"}, {"start": 100.88, "end": 102.78, "text": "人天之前"}, {"start": 102.78, "end": 103.78, "text": "主炮必须完工"}]}