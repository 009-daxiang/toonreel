{"file": "天才机甲师-第47集.mp4", "ep": 47, "duration": 101.9, "segments": [{"start": 30.26, "end": 34.69, "text": "大衛浴清出來了"}, {"start": 34.69, "end": 35.69, "text": "儲藥 我進去"}, {"start": 35.69, "end": 36.69, "text": "主砲冷卻還有兩分鐘"}, {"start": 36.69, "end": 37.69, "text": "別跟他硬碰"}, {"start": 37.69, "end": 39.69, "text": "去看反傷戶最薄的地方"}, {"start": 39.69, "end": 45.74, "text": "戶隊有裂口了"}, {"start": 45.74, "end": 46.74, "text": "下額才可加縫"}, {"start": 46.74, "end": 47.74, "text": "看到了"}, {"start": 47.74, "end": 55.3, "text": "這一下夠激"}, {"start": 55.3, "end": 56.3, "text": "你什麼時候學會的"}, {"start": 56.3, "end": 57.3, "text": "剛學會的"}, {"start": 57.3, "end": 59.3, "text": "主砲冷卻完畢了"}, {"start": 59.3, "end": 64.28, "text": "蒼月 按住他"}, {"start": 64.28, "end": 95.85, "text": "蒼哥坐在氣裡已激活"}, {"start": 95.85, "end": 99.54, "text": "阿"}]}