{"file": "天才机甲师-第44集.mp4", "ep": 44, "duration": 177.3, "segments": [{"start": 5.01, "end": 5.89, "text": "全体注意"}, {"start": 6.29, "end": 7.09, "text": "巨星冲突"}, {"start": 7.09, "end": 8.21, "text": "三钉战号力为坦"}, {"start": 8.21, "end": 9.89, "text": "能量拼击SS级"}, {"start": 10.17, "end": 12.09, "text": "天穷基地所有人员立即归位"}, {"start": 13.3, "end": 14.42, "text": "SS级"}, {"start": 14.74, "end": 15.82, "text": "操"}, {"start": 15.82, "end": 16.58, "text": "楚耀"}, {"start": 17.1, "end": 19.14, "text": "太危北辰还剩多少弹药"}, {"start": 19.14, "end": 20.66, "text": "主炮还能打两发满攻略"}, {"start": 20.66, "end": 21.7, "text": "太危域也能用"}, {"start": 21.7, "end": 22.54, "text": "够了"}, {"start": 23.14, "end": 25.42, "text": "给我把他从天上打下来"}, {"start": 25.82, "end": 31.3, "text": "别去了"}, {"start": 31.58, "end": 32.74, "text": "回车间"}, {"start": 42.82, "end": 43.38, "text": "昌玉"}, {"start": 43.86, "end": 44.74, "text": "我先用太危域"}, {"start": 44.74, "end": 45.94, "text": "探化他的风讯网络"}, {"start": 45.94, "end": 47.34, "text": "以火力全开炸他头部"}, {"start": 47.34, "end": 47.98, "text": "收到"}, {"start": 48.26, "end": 52.77, "text": "在"}, {"start": 58.26, "end": 59.18, "text": "导弹全中"}, {"start": 59.7, "end": 60.5, "text": "立破防"}, {"start": 63.48, "end": 65.68, "text": "交出机甲和人类除药"}, {"start": 65.92, "end": 67.44, "text": "拆解武器"}, {"start": 67.68, "end": 69.31, "text": "御皇"}, {"start": 70.22, "end": 71.58, "text": "你们活命"}, {"start": 71.58, "end": 72.66, "text": "放弃"}, {"start": 72.9, "end": 80.14, "text": "昌玉"}, {"start": 80.42, "end": 81.26, "text": "你进身"}, {"start": 81.54, "end": 83.1, "text": "他的反伤护盾还在"}, {"start": 89.3, "end": 90.42, "text": "他的精神烈怒"}, {"start": 90.62, "end": 92.54, "text": "挡不住物理护盾"}, {"start": 92.78, "end": 95.31, "text": "这一炮我先打他的副炎"}, {"start": 95.67, "end": 96.43, "text": "你不道"}, {"start": 108.77, "end": 109.73, "text": "但他还没死"}, {"start": 109.73, "end": 123.52, "text": "世纪那次强了不止十倍"}, {"start": 123.52, "end": 123.92, "text": "不懂"}, {"start": 123.92, "end": 136.85, "text": "现在方命增援"}]}