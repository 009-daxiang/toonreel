{"file": "天才机甲师-第48集.mp4", "ep": 48, "duration": 71.4, "segments": [{"start": 3.6, "end": 5.2, "text": "阿修羅的指揮權限"}, {"start": 5.2, "end": 6.76, "text": "你爹比你高一級"}, {"start": 7.04, "end": 9.42, "text": "你幹什麼"}, {"start": 9.62, "end": 13.34, "text": "替你斷後"}, {"start": 17.79, "end": 18.35, "text": "主要"}, {"start": 18.98, "end": 20.82, "text": "兩位美人的主套還能打幾發"}, {"start": 20.82, "end": 21.5, "text": "只剩一發"}, {"start": 21.7, "end": 23.3, "text": "地位他的下鵝裂縫正在餘和"}, {"start": 23.3, "end": 24.9, "text": "不打穿載車核心殺不了他"}, {"start": 25.18, "end": 27.02, "text": "把他重新炸開"}, {"start": 39.66, "end": 40.26, "text": "小子"}, {"start": 40.93, "end": 43.05, "text": "以後替我和他母親照顧好蒼月"}, {"start": 43.74, "end": 44.38, "text": "比起我"}, {"start": 44.62, "end": 45.78, "text": "他更不能失去你的"}, {"start": 46.3, "end": 46.86, "text": "袁帥"}, {"start": 50.18, "end": 50.78, "text": "老婆"}, {"start": 51.96, "end": 52.96, "text": "我來陪你了"}]}