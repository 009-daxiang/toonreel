{"file": "天才机甲师-第51集.mp4", "ep": 51, "duration": 165.1, "segments": [{"start": 10.42, "end": 12.02, "text": "袁帅的奸章"}, {"start": 12.87, "end": 14.75, "text": "只剩着最后一队"}, {"start": 15.41, "end": 16.29, "text": "从今天起"}, {"start": 16.57, "end": 18.01, "text": "我接任联邦袁帅"}, {"start": 18.41, "end": 19.29, "text": "第一道命令"}, {"start": 19.61, "end": 21.33, "text": "所有工厂转产军工"}, {"start": 21.49, "end": 23.61, "text": "所有粮仓定量供饮前线"}, {"start": 23.89, "end": 25.69, "text": "天权城基甲产量翻三倍"}, {"start": 26.05, "end": 29.69, "text": "天权城粮食配级缩减至暂时标准百分之七十"}, {"start": 30.13, "end": 31.25, "text": "立为探死了"}, {"start": 31.25, "end": 32.69, "text": "冲族女红还活着"}, {"start": 32.97, "end": 34.65, "text": "下一波冲朝只会更狠"}, {"start": 34.65, "end": 35.85, "text": "我们不能坐以待毙"}, {"start": 35.85, "end": 37.45, "text": "我父亲用命炸开了一条路"}, {"start": 37.45, "end": 38.45, "text": "不是让我们接着手"}, {"start": 38.45, "end": 40.65, "text": "为了死去的和活着的所有人"}, {"start": 40.81, "end": 41.49, "text": "这一战"}, {"start": 41.73, "end": 42.97, "text": "我们必须反攻回去"}, {"start": 42.97, "end": 43.41, "text": "是"}, {"start": 43.41, "end": 44.41, "text": "倒回去"}, {"start": 48.15, "end": 48.71, "text": "楚耀"}, {"start": 49.55, "end": 50.39, "text": "走上前来"}, {"start": 53.45, "end": 55.77, "text": "经联邦首脑周景行特批"}, {"start": 55.93, "end": 58.89, "text": "先任命楚耀为军工研究所所长"}, {"start": 59.09, "end": 60.53, "text": "授予首席贤"}, {"start": 63.34, "end": 64.1, "text": "授争"}, {"start": 64.86, "end": 65.94, "text": "你应得的"}, {"start": 68.4, "end": 68.92, "text": "还有"}, {"start": 69.5, "end": 72.14, "text": "授予主剑联邦上将军贤"}, {"start": 77.16, "end": 77.56, "text": "好"}, {"start": 77.92, "end": 78.84, "text": "感谢各位的信任"}, {"start": 78.84, "end": 79.92, "text": "接下来一个半月"}, {"start": 79.92, "end": 80.92, "text": "我会带领全基地"}, {"start": 80.92, "end": 82.8, "text": "修复并升级舞台S级基甲"}, {"start": 83.0, "end": 83.88, "text": "太威北辰"}, {"start": 83.96, "end": 86.0, "text": "将改造为SS级中天北皇"}, {"start": 86.28, "end": 87.08, "text": "SS级"}, {"start": 87.24, "end": 88.4, "text": "联邦从来没有过"}, {"start": 89.49, "end": 90.13, "text": "传令"}, {"start": 91.87, "end": 92.99, "text": "从今天起"}, {"start": 93.11, "end": 95.31, "text": "联邦进入全民战时状态"}, {"start": 118.41, "end": 119.33, "text": "两个月后"}, {"start": 119.61, "end": 121.49, "text": "舱星远征舰队升空"}, {"start": 121.65, "end": 122.33, "text": "目标"}, {"start": 122.33, "end": 124.05, "text": "重组母星沃诺阁"}, {"start": 124.05, "end": 125.21, "text": "女皇塔冠"}, {"start": 125.21, "end": 126.17, "text": "打下那里"}, {"start": 126.17, "end": 127.81, "text": "结束这场战争"}, {"start": 136.6, "end": 138.72, "text": "太威北辰大船立维弹"}, {"start": 139.23, "end": 141.55, "text": "时辰护顿被炸开的窗口气"}, {"start": 142.45, "end": 143.57, "text": "下一头呢"}, {"start": 143.69, "end": 145.21, "text": "太威北辰是实验级"}, {"start": 145.29, "end": 147.49, "text": "他的任务就是验证太威欲可行"}, {"start": 147.77, "end": 148.81, "text": "现在验证完了"}, {"start": 149.05, "end": 150.09, "text": "中天北皇"}, {"start": 150.21, "end": 151.17, "text": "代号地星"}, {"start": 151.37, "end": 153.61, "text": "一台行走的重组精神干扰发射器"}, {"start": 153.61, "end": 155.17, "text": "他的子卫规领域不孝雄历"}, {"start": 155.17, "end": 156.73, "text": "一旦启动方圆五百里"}, {"start": 156.73, "end": 159.25, "text": "所有S级以下重组精神网络全部崩溃"}, {"start": 159.25, "end": 159.97, "text": "全部干碎"}, {"start": 159.97, "end": 160.81, "text": "没有窗口气"}, {"start": 160.81, "end": 161.29, "text": "好"}, {"start": 161.85, "end": 163.69, "text": "全员配合中天北皇研发"}, {"start": 163.81, "end": 165.05, "text": "务必提前完工"}]}