{"file": "天才机甲师-第13集.mp4", "ep": 13, "duration": 160.2, "segments": [{"start": 0.21, "end": 1.57, "text": "御师们 仙主们"}, {"start": 1.57, "end": 3.05, "text": "办决赛第二场"}, {"start": 3.05, "end": 6.33, "text": "楚耀对夏侯军"}, {"start": 10.49, "end": 11.57, "text": "三届亚军"}, {"start": 12.05, "end": 14.25, "text": "这一剑我只拿冠军"}, {"start": 14.57, "end": 15.69, "text": "你就是那个打赢了"}, {"start": 15.69, "end": 16.77, "text": "依泛的赘序"}, {"start": 17.13, "end": 18.17, "text": "打得不错"}, {"start": 18.78, "end": 19.62, "text": "可惜"}, {"start": 19.82, "end": 21.06, "text": "我的神才"}, {"start": 21.22, "end": 22.5, "text": "没有弱点"}, {"start": 25.29, "end": 26.53, "text": "翅膀挺多"}, {"start": 26.81, "end": 27.77, "text": "飞得起来吗"}, {"start": 28.33, "end": 29.97, "text": "我的神才有三样东西"}, {"start": 29.97, "end": 30.89, "text": "你打不破"}, {"start": 31.29, "end": 32.37, "text": "神才之盾"}, {"start": 32.69, "end": 34.17, "text": "能量偏早不顿"}, {"start": 35.17, "end": 36.56, "text": "神才之毛"}, {"start": 37.0, "end": 38.52, "text": "等离子突射刃"}, {"start": 39.0, "end": 42.66, "text": "神才之眼"}, {"start": 42.98, "end": 45.1, "text": "三百六十度无死奖赶之"}, {"start": 45.46, "end": 55.02, "text": "差距也太大了"}, {"start": 55.3, "end": 55.94, "text": "追训能打到"}, {"start": 55.94, "end": 57.34, "text": "半决赛已经是奇迹了"}, {"start": 57.34, "end": 58.38, "text": "六一全开"}, {"start": 58.38, "end": 59.78, "text": "指控权完全压制"}, {"start": 59.78, "end": 60.7, "text": "第一位型机架"}, {"start": 60.7, "end": 61.7, "text": "没有胜货"}, {"start": 61.7, "end": 62.62, "text": "六一"}, {"start": 62.62, "end": 63.3, "text": "毕竟限制下"}, {"start": 63.3, "end": 64.26, "text": "为了装六一连接触"}, {"start": 64.26, "end": 65.06, "text": "必须减重"}, {"start": 65.06, "end": 65.66, "text": "根部装甲"}, {"start": 65.66, "end": 66.62, "text": "不会超过三厘"}, {"start": 67.02, "end": 76.9, "text": "那一招"}, {"start": 76.9, "end": 78.3, "text": "有到决赛在对付"}, {"start": 78.7, "end": 80.93, "text": "行"}, {"start": 81.59, "end": 82.43, "text": "不用那招"}, {"start": 82.43, "end": 83.39, "text": "照样赢你"}, {"start": 83.39, "end": 85.07, "text": "每一次辅充都有偏道延迟"}, {"start": 85.27, "end": 86.47, "text": "装完半斤太大了"}, {"start": 86.67, "end": 87.51, "text": "翅膀根部"}, {"start": 87.51, "end": 88.91, "text": "就是神才的最大弱点"}, {"start": 88.91, "end": 89.75, "text": "忘记了吗"}, {"start": 89.99, "end": 90.67, "text": "也好"}, {"start": 90.83, "end": 91.79, "text": "省我时间"}, {"start": 107.03, "end": 107.79, "text": "夏侯军"}, {"start": 108.11, "end": 109.71, "text": "你的神才确实没有弱点"}, {"start": 110.03, "end": 110.59, "text": "除了"}, {"start": 110.95, "end": 111.79, "text": "这一天"}, {"start": 118.05, "end": 118.89, "text": "三届来"}, {"start": 119.42, "end": 120.58, "text": "每次都差一点"}, {"start": 121.11, "end": 122.95, "text": "我以为六一无死奖就没了"}, {"start": 123.11, "end": 124.3, "text": "原来方向"}, {"start": 124.3, "end": 125.78, "text": "从一空开始就错了"}, {"start": 126.34, "end": 127.02, "text": "我输了"}, {"start": 127.62, "end": 128.22, "text": "楚耀"}, {"start": 128.81, "end": 129.89, "text": "替我赢到最后"}, {"start": 146.29, "end": 151.1, "text": "击败了禪连三斤"}, {"start": 151.1, "end": 151.9, "text": "请为他送上"}, {"start": 151.9, "end": 153.02, "text": "最热烈的掌声"}, {"start": 153.42, "end": 157.5, "text": "看来未来的军工部"}, {"start": 157.5, "end": 160.07, "text": "的天才"}]}