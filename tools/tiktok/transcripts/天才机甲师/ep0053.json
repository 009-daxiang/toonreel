{"file": "天才机甲师-第53集.mp4", "ep": 53, "duration": 108.7, "segments": [{"start": 6.77, "end": 8.77, "text": "十年前允兴战役就死了"}, {"start": 8.77, "end": 20.72, "text": "现在战在你们面前的"}, {"start": 20.72, "end": 23.88, "text": "是从此拿回兄弟的尸体拼出来的武器"}, {"start": 23.88, "end": 24.88, "text": "开始"}, {"start": 24.88, "end": 29.58, "text": "被他SS集合他的计时人"}, {"start": 29.58, "end": 36.02, "text": "完毫无损地带回去"}, {"start": 36.02, "end": 38.02, "text": "死为群立场被压制了"}, {"start": 38.02, "end": 43.32, "text": "这家伙现在不受影响"}, {"start": 43.32, "end": 44.32, "text": "他是独立一身"}, {"start": 44.32, "end": 46.32, "text": "不再放弃网络里"}, {"start": 46.32, "end": 47.32, "text": "你不能离开振兴"}, {"start": 47.32, "end": 49.32, "text": "中天北皇才是他的目标"}, {"start": 49.32, "end": 50.32, "text": "你一走"}, {"start": 50.32, "end": 51.67, "text": "振兴就散"}, {"start": 51.67, "end": 53.67, "text": "想抓他"}, {"start": 53.67, "end": 57.3, "text": "先夸过老子的鸡脚"}, {"start": 57.3, "end": 59.3, "text": "干碎你"}, {"start": 59.3, "end": 60.3, "text": "元帅"}, {"start": 60.3, "end": 69.89, "text": "老顾没给你丢人"}, {"start": 69.89, "end": 70.89, "text": "藏医的丫头"}, {"start": 70.89, "end": 72.89, "text": "交给你了小子"}, {"start": 72.89, "end": 73.89, "text": "不说"}, {"start": 73.89, "end": 74.89, "text": "顾常辉"}, {"start": 74.89, "end": 79.22, "text": "确认阵亡"}, {"start": 79.22, "end": 104.5, "text": "振兴收集"}, {"start": 104.5, "end": 105.5, "text": "继续推进"}]}