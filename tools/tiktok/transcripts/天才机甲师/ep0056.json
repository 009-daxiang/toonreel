{"file": "天才机甲师-第56集.mp4", "ep": 56, "duration": 106.2, "segments": [{"start": 5.3, "end": 6.38, "text": "重庆在耗龙推路"}, {"start": 6.38, "end": 7.26, "text": "后方也被包了"}, {"start": 7.26, "end": 7.94, "text": "冷月"}, {"start": 7.94, "end": 9.82, "text": "可从四面八方压过来了"}, {"start": 9.82, "end": 10.74, "text": "数量比登陆士"}, {"start": 10.74, "end": 11.82, "text": "半了不止一倍"}, {"start": 11.82, "end": 13.34, "text": "舰队损伤已过四成"}, {"start": 13.34, "end": 14.66, "text": "今天打不下灌塔"}, {"start": 14.66, "end": 15.26, "text": "再不走"}, {"start": 15.26, "end": 16.86, "text": "连回去报信的船都没了"}, {"start": 18.28, "end": 19.24, "text": "全舰队听令"}, {"start": 19.24, "end": 20.32, "text": "放弃灌塔进攻"}, {"start": 20.32, "end": 21.24, "text": "后队改前队"}, {"start": 21.24, "end": 22.24, "text": "白虎营断后"}, {"start": 22.24, "end": 23.72, "text": "撤至天辣下方登陆点"}, {"start": 23.72, "end": 24.76, "text": "重建地面防线"}, {"start": 24.76, "end": 25.92, "text": "断后交给我"}, {"start": 26.4, "end": 27.64, "text": "我一定会救你的"}, {"start": 27.64, "end": 33.62, "text": "中天北方"}, {"start": 33.62, "end": 34.74, "text": "切换自动驾驶"}, {"start": 34.74, "end": 35.38, "text": "开路"}, {"start": 47.34, "end": 48.06, "text": "汇报"}, {"start": 48.06, "end": 48.94, "text": "防线不属"}, {"start": 53.05, "end": 53.89, "text": "聂玲"}, {"start": 54.09, "end": 55.21, "text": "女王陛下"}, {"start": 55.77, "end": 57.21, "text": "您亲自送人来了"}, {"start": 57.82, "end": 59.18, "text": "这个人类的精神壁垒"}, {"start": 59.18, "end": 60.5, "text": "连您都打不穿"}, {"start": 60.78, "end": 61.9, "text": "倒是稀罕"}, {"start": 61.9, "end": 63.74, "text": "所以我把这个人类交给你"}, {"start": 63.98, "end": 64.98, "text": "看看能不能"}, {"start": 64.98, "end": 66.34, "text": "神经反射很活跃"}, {"start": 66.34, "end": 67.78, "text": "体质远超普通人类"}, {"start": 67.78, "end": 69.26, "text": "能扛住您在领域里的折磨"}, {"start": 69.26, "end": 70.1, "text": "底子确实好"}, {"start": 70.1, "end": 71.58, "text": "但精神壁垒封得太死"}, {"start": 71.58, "end": 72.98, "text": "连我的知魂针都探不进去"}, {"start": 72.98, "end": 73.82, "text": "不用探"}, {"start": 73.82, "end": 75.46, "text": "把泽哥利斯塞进去"}, {"start": 75.46, "end": 76.26, "text": "让他来"}, {"start": 76.26, "end": 77.78, "text": "重组的胚胎只有一个"}, {"start": 78.22, "end": 79.86, "text": "您确定要用在这个人类身上"}, {"start": 79.86, "end": 81.94, "text": "那老东西睡了十几个计员"}, {"start": 81.94, "end": 83.1, "text": "也该醒醒了"}, {"start": 83.3, "end": 84.46, "text": "等他知道新身体"}, {"start": 84.46, "end": 85.74, "text": "失去卑贱的人类"}, {"start": 85.74, "end": 87.1, "text": "看看他什么表情"}, {"start": 87.1, "end": 88.22, "text": "他不是向来瞧不起"}, {"start": 88.22, "end": 89.18, "text": "半重体吗"}, {"start": 89.74, "end": 90.34, "text": "是"}, {"start": 90.54, "end": 91.14, "text": "遵命"}, {"start": 100.51, "end": 102.71, "text": "检测到重组基因训练"}, {"start": 102.71, "end": 104.63, "text": "代号泽哥利斯"}]}