{"file": "天才机甲师-第43集.mp4", "ep": 43, "duration": 143.0, "segments": [{"start": 1.42, "end": 2.06, "text": "妈的"}, {"start": 2.26, "end": 3.22, "text": "老子在十九车间"}, {"start": 3.22, "end": 4.38, "text": "吃了三个月营养凝胶"}, {"start": 4.38, "end": 5.74, "text": "头一回知道肉是啥味儿"}, {"start": 6.42, "end": 7.5, "text": "半下你多吃点"}, {"start": 8.02, "end": 9.5, "text": "这蛋糕是真的鸡蛋做的"}, {"start": 9.74, "end": 13.98, "text": "我 我减肥"}, {"start": 13.98, "end": 14.86, "text": "你捡个屁"}, {"start": 15.06, "end": 16.22, "text": "瘦的跟竹竿似的"}, {"start": 16.22, "end": 17.26, "text": "风一吹就倒"}, {"start": 17.7, "end": 19.02, "text": "那叫标准体型"}, {"start": 19.18, "end": 20.42, "text": "标准还做体型"}, {"start": 23.98, "end": 24.34, "text": "干"}, {"start": 24.66, "end": 25.9, "text": "老子受伤了也得干"}, {"start": 26.18, "end": 27.62, "text": "今天谁不喝谁是孙子"}, {"start": 28.74, "end": 29.98, "text": "军医不是让你敬酒"}, {"start": 30.34, "end": 31.94, "text": "军医还让我敬养呢"}, {"start": 32.1, "end": 33.62, "text": "老子躺了四十八小时"}, {"start": 33.62, "end": 34.74, "text": "骨头都快瘦了"}, {"start": 34.74, "end": 35.66, "text": "你也多喝点"}, {"start": 35.82, "end": 37.38, "text": "老子的白虎快修好了嘛"}, {"start": 37.38, "end": 38.1, "text": "又逼断了"}, {"start": 38.1, "end": 39.02, "text": "推进器也烧了"}, {"start": 39.02, "end": 40.82, "text": "推进器是你自己用过载的"}, {"start": 40.82, "end": 41.7, "text": "你不修谁修"}, {"start": 41.7, "end": 43.26, "text": "全基地除了你谁敢碰那玩意儿"}, {"start": 43.26, "end": 44.5, "text": "他要是肯听医主"}, {"start": 44.5, "end": 45.78, "text": "推进器根本不会烧"}, {"start": 46.34, "end": 47.46, "text": "若言你站哪边的"}, {"start": 47.7, "end": 48.86, "text": "我站数据这边"}, {"start": 49.18, "end": 50.98, "text": "酒精会让你的神经反应速度"}, {"start": 50.98, "end": 52.18, "text": "下降百分之十二"}, {"start": 52.42, "end": 53.62, "text": "明天你要是摸白虎"}, {"start": 53.62, "end": 54.62, "text": "我第一个打报告"}, {"start": 55.06, "end": 55.62, "text": "老陆"}, {"start": 56.26, "end": 56.86, "text": "听听"}, {"start": 57.14, "end": 58.42, "text": "若言连你的反应速度"}, {"start": 58.42, "end": 59.14, "text": "都算好了"}, {"start": 59.14, "end": 59.94, "text": "他连我什么时候"}, {"start": 59.94, "end": 60.86, "text": "死都算好了"}, {"start": 60.86, "end": 61.98, "text": "我算那个干吗"}, {"start": 62.26, "end": 63.62, "text": "少说点不吉利的话"}, {"start": 65.75, "end": 66.55, "text": "老顾"}, {"start": 66.83, "end": 68.75, "text": "打着绷带杯子都举不稳"}, {"start": 68.75, "end": 69.39, "text": "还喝"}, {"start": 87.3, "end": 87.9, "text": "怎么"}, {"start": 88.38, "end": 89.14, "text": "不认识了"}, {"start": 91.06, "end": 91.54, "text": "就"}, {"start": 91.94, "end": 93.7, "text": "就是没见过你穿裙子"}, {"start": 95.68, "end": 96.52, "text": "不好看吗"}, {"start": 96.8, "end": 99.55, "text": "好看"}, {"start": 100.07, "end": 100.91, "text": "太好看了"}, {"start": 101.07, "end": 101.55, "text": "那"}, {"start": 102.86, "end": 103.54, "text": "挑出我"}, {"start": 117.67, "end": 118.63, "text": "你看看人家"}, {"start": 118.63, "end": 119.35, "text": "再看看你"}, {"start": 119.35, "end": 120.15, "text": "闭嘴"}, {"start": 120.15, "end": 120.87, "text": "你也没对象"}, {"start": 121.15, "end": 128.79, "text": "他在看这个二龙仔"}, {"start": 129.91, "end": 130.47, "text": "仓鱼"}, {"start": 130.55, "end": 132.55, "text": "打完这一仗"}, {"start": 134.79, "end": 135.31, "text": "警报"}, {"start": 135.67, "end": 136.99, "text": "神盾防空网被击穿"}, {"start": 137.23, "end": 138.95, "text": "捕捉到SS级能量巨变"}]}