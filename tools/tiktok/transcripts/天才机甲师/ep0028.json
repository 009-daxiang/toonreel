{"file": "天才机甲师-第28集.mp4", "ep": 28, "duration": 113.4, "segments": [{"start": 0.62, "end": 2.02, "text": "恭喜啊 楚主掌"}, {"start": 2.42, "end": 3.62, "text": "方所长特批"}, {"start": 3.82, "end": 5.62, "text": "从一车间调三个资深研究员"}, {"start": 5.62, "end": 6.62, "text": "给你打下手"}, {"start": 6.82, "end": 7.62, "text": "楚主掌"}, {"start": 7.82, "end": 9.02, "text": "面子不小啊"}, {"start": 9.62, "end": 10.82, "text": "耀哥好 我又来了"}, {"start": 11.42, "end": 14.71, "text": "顾主任 还有事吗"}, {"start": 15.11, "end": 16.11, "text": "就这破地方"}, {"start": 16.11, "end": 17.31, "text": "你还想改造曙光"}, {"start": 17.71, "end": 19.11, "text": "方老年纪大了老糊涂"}, {"start": 19.11, "end": 20.11, "text": "你也跟着做梦"}, {"start": 20.51, "end": 21.51, "text": "区区一个避机机"}, {"start": 21.51, "end": 22.11, "text": "顾主任"}, {"start": 22.51, "end": 23.31, "text": "方老已经特批了"}, {"start": 23.31, "end": 24.31, "text": "十九车间独立运作"}, {"start": 24.71, "end": 25.71, "text": "我现在想要军工部"}, {"start": 25.71, "end": 26.91, "text": "最高修理改造全线"}, {"start": 27.31, "end": 28.91, "text": "你那边图纸材料零件库"}, {"start": 29.11, "end": 30.11, "text": "全部对我开放"}, {"start": 30.51, "end": 31.5, "text": "你"}, {"start": 31.9, "end": 32.7, "text": "方老韩说"}, {"start": 33.1, "end": 34.5, "text": "你私自篡改我分配车间的事"}, {"start": 34.5, "end": 35.7, "text": "他会亲自找你算账"}, {"start": 35.9, "end": 36.7, "text": "我们要开工了"}, {"start": 36.9, "end": 37.9, "text": "慢走 不送"}, {"start": 38.81, "end": 40.41, "text": "一车间组长就这特性"}, {"start": 40.41, "end": 42.04, "text": "靠他伯父顾名理上位的"}, {"start": 42.04, "end": 42.84, "text": "懂个屁的技术"}, {"start": 42.84, "end": 44.04, "text": "天津第一关系户"}, {"start": 44.04, "end": 45.44, "text": "多少工程师被他逼走了"}, {"start": 45.87, "end": 46.87, "text": "从今天起"}, {"start": 47.07, "end": 49.27, "text": "十九车间正式挂牌曙光工作室"}, {"start": 49.27, "end": 50.27, "text": "大家收拾东西"}, {"start": 50.27, "end": 51.27, "text": "搬去零号机库"}, {"start": 51.47, "end": 52.67, "text": "有场硬仗要打了"}, {"start": 59.72, "end": 63.62, "text": "有五个进化形态"}, {"start": 63.62, "end": 64.82, "text": "从D到S"}, {"start": 65.22, "end": 66.62, "text": "银钱也得留借口"}, {"start": 68.0, "end": 70.2, "text": "使用液态神经元传导技术"}, {"start": 70.2, "end": 71.4, "text": "反视率降为零"}, {"start": 71.8, "end": 73.4, "text": "正好治疗他的狂躁症"}, {"start": 73.8, "end": 74.8, "text": "银钱"}, {"start": 75.0, "end": 76.0, "text": "新机甲"}, {"start": 76.4, "end": 77.2, "text": "给苍月的"}, {"start": 79.17, "end": 80.97, "text": "要哥对嫂子可真好"}, {"start": 81.56, "end": 82.56, "text": "进度怎么样了"}, {"start": 83.36, "end": 84.78, "text": "小点事"}, {"start": 85.04, "end": 86.84, "text": "这玩意还在设计保密阶段"}, {"start": 87.24, "end": 89.86, "text": "这个传导结构"}, {"start": 90.26, "end": 91.46, "text": "不是硬插管"}, {"start": 92.34, "end": 93.74, "text": "机甲自己过滤砸剥"}, {"start": 93.74, "end": 95.54, "text": "驾驶员不会被精神反视"}, {"start": 96.29, "end": 97.29, "text": "这批零件"}, {"start": 97.29, "end": 98.89, "text": "有几样是精运清单上的"}, {"start": 98.89, "end": 99.89, "text": "黑事都难够"}, {"start": 99.89, "end": 100.89, "text": "所以才找你"}, {"start": 101.09, "end": 101.89, "text": "搬下启明"}, {"start": 101.89, "end": 102.89, "text": "你们配合我研究"}, {"start": 102.89, "end": 103.49, "text": "苏慕"}, {"start": 103.49, "end": 104.49, "text": "你去找零件"}, {"start": 104.49, "end": 105.89, "text": "我们尽量在一个月内成型"}, {"start": 107.19, "end": 107.99, "text": "我吗"}, {"start": 109.04, "end": 109.44, "text": "对"}, {"start": 112.12, "end": 113.32, "text": "以后就跟着要哥混了"}]}