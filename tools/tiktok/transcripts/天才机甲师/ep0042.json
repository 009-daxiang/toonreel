{"file": "天才机甲师-第42集.mp4", "ep": 42, "duration": 107.0, "segments": [{"start": 7.7, "end": 10.18, "text": "目标锁定 十公里外沙岩山体"}, {"start": 10.18, "end": 11.7, "text": "反物质此鬼炮充能"}, {"start": 11.7, "end": 14.58, "text": "百分之九十七 百分之九十八 百分之九十九"}, {"start": 14.58, "end": 15.58, "text": "发射"}, {"start": 23.9, "end": 26.22, "text": "比计算质高了至少百分之十五"}, {"start": 26.22, "end": 28.45, "text": "山头没了 满意了"}, {"start": 29.31, "end": 30.31, "text": "相当满意"}, {"start": 31.54, "end": 33.58, "text": "通测 开启重庆共鸣"}, {"start": 34.1, "end": 35.46, "text": "目标 天列"}, {"start": 35.66, "end": 40.47, "text": "警告 遭遇高频空间折咒"}, {"start": 40.47, "end": 43.11, "text": "信号全部被折睡 无法穿透"}, {"start": 43.39, "end": 45.55, "text": "宗明强度已达安全与直"}, {"start": 45.55, "end": 48.19, "text": "继续推进 将引发精神反噬"}, {"start": 52.82, "end": 53.62, "text": "没成功"}, {"start": 54.1, "end": 55.82, "text": "天列外面裹了一层空间折咒"}, {"start": 55.82, "end": 57.02, "text": "共鸣信号全被弹回来了"}, {"start": 57.02, "end": 58.34, "text": "暂时探不到里面"}, {"start": 58.81, "end": 60.01, "text": "那就等下次"}, {"start": 60.6, "end": 61.76, "text": "邦老那边不急"}, {"start": 65.29, "end": 66.13, "text": "蓝月花"}, {"start": 66.68, "end": 67.76, "text": "只在黄昏开"}, {"start": 67.88, "end": 68.88, "text": "天亮就凋谢"}, {"start": 69.5, "end": 70.98, "text": "我妈生前最喜欢的话"}, {"start": 72.77, "end": 74.73, "text": "她和蓝煎囚长的一模一样"}, {"start": 75.91, "end": 77.51, "text": "你知道她的花语是什么吗"}, {"start": 78.04, "end": 78.84, "text": "是什么"}, {"start": 84.34, "end": 86.96, "text": "你真好看 花语是"}, {"start": 87.97, "end": 89.13, "text": "永恒不变的爱"}, {"start": 89.61, "end": 91.05, "text": "与无怨无悔的等待"}, {"start": 94.14, "end": 95.26, "text": "晚上有清宫宴"}, {"start": 96.41, "end": 97.89, "text": "我给你准备了一个惊喜"}, {"start": 98.37, "end": 99.41, "text": "记得换身衣服"}, {"start": 99.61, "end": 101.34, "text": "她刚才"}]}