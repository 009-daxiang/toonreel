{"file": "天才机甲师-第59集.mp4", "ep": 59, "duration": 113.6, "segments": [{"start": 1.94, "end": 2.66, "text": "退后"}, {"start": 2.9, "end": 3.86, "text": "一刀下去"}, {"start": 4.54, "end": 6.02, "text": "你就再也不用挣扎了"}, {"start": 6.46, "end": 8.34, "text": "为什么不让我杀了你软肋"}, {"start": 9.26, "end": 10.82, "text": "因为我还没死"}, {"start": 10.98, "end": 11.66, "text": "你是谁"}, {"start": 11.98, "end": 12.9, "text": "你很在"}, {"start": 13.54, "end": 14.82, "text": "每一招都往死里打"}, {"start": 15.02, "end": 16.14, "text": "这不是他的打法"}, {"start": 17.1, "end": 17.5, "text": "你"}, {"start": 18.02, "end": 18.86, "text": "不是楚耀"}, {"start": 18.86, "end": 19.86, "text": "眼力不错"}, {"start": 20.34, "end": 21.42, "text": "你更该死了"}, {"start": 21.5, "end": 41.5, "text": "弓组的力量太恐怖"}, {"start": 42.06, "end": 43.46, "text": "连系统都被封锁了"}, {"start": 43.74, "end": 44.86, "text": "我只能靠自己"}, {"start": 45.42, "end": 47.02, "text": "上古重组纯血之高"}, {"start": 47.18, "end": 48.78, "text": "现在被一个半人半虫的杂种"}, {"start": 48.78, "end": 49.74, "text": "打上了精神锁"}, {"start": 49.94, "end": 51.18, "text": "他让你控制这具身体"}, {"start": 51.18, "end": 52.14, "text": "你就乖乖照办"}, {"start": 52.3, "end": 53.18, "text": "他让你当狗"}, {"start": 53.18, "end": 54.1, "text": "你就摇尾吧"}, {"start": 54.1, "end": 55.82, "text": "十几个计员攒下来的脸面"}, {"start": 55.82, "end": 57.26, "text": "被一个杂种踩在脚底下"}, {"start": 57.26, "end": 58.14, "text": "你不嫌丢人"}, {"start": 58.14, "end": 59.78, "text": "你以为机枪法对我有用"}, {"start": 59.78, "end": 60.78, "text": "我跟你作比交易"}, {"start": 61.14, "end": 62.54, "text": "我帮你冲破纳塔的精神锁"}, {"start": 62.54, "end": 63.22, "text": "作为交换"}, {"start": 63.22, "end": 65.46, "text": "这具身体的掌控权暂时归我"}, {"start": 65.58, "end": 66.86, "text": "你一个接下球"}, {"start": 66.86, "end": 68.5, "text": "凭什么跟我谈交易"}, {"start": 68.62, "end": 69.3, "text": "凭我脑子里"}, {"start": 69.3, "end": 70.86, "text": "装着灭约性逻辑病毒"}, {"start": 71.1, "end": 72.62, "text": "能让整个重组风群网络"}, {"start": 72.62, "end": 73.98, "text": "从母星池开始崩溃"}, {"start": 74.3, "end": 75.34, "text": "凭我能让你"}, {"start": 75.46, "end": 76.9, "text": "早点杀了纳塔杀"}, {"start": 77.38, "end": 79.66, "text": "凭我能给你真正的自由"}, {"start": 82.39, "end": 84.79, "text": "恭喜成功改造S级中天本王"}, {"start": 84.95, "end": 86.75, "text": "获得神级迁移毛点"}, {"start": 87.07, "end": 88.39, "text": "灭绝性逻辑病毒"}, {"start": 88.39, "end": 89.71, "text": "以你现在的身体"}, {"start": 89.91, "end": 91.23, "text": "连战都战不起来"}, {"start": 96.86, "end": 97.5, "text": "陪我"}, {"start": 97.5, "end": 109.2, "text": "不分"}, {"start": 109.2, "end": 110.0, "text": "别想独占"}, {"start": 110.0, "end": 113.59, "text": "大家一起死"}]}