{"file": "天才机甲师-第15集.mp4", "ep": 15, "duration": 67.1, "segments": [{"start": 0.59, "end": 1.79, "text": "维纳斯 出攻"}, {"start": 1.79, "end": 2.39, "text": "警告"}, {"start": 2.39, "end": 6.02, "text": "追击无法引起的匹配"}, {"start": 6.02, "end": 12.62, "text": "你一直在用三百斤敷衷跟我打"}, {"start": 12.62, "end": 22.42, "text": "结构损伤百分之四十七"}, {"start": 22.42, "end": 24.42, "text": "这一启动紧急彻底程序"}, {"start": 24.42, "end": 31.28, "text": "前面的比赛里"}, {"start": 31.28, "end": 32.48, "text": "他不光挂了三百斤配重"}, {"start": 32.48, "end": 33.38, "text": "还故意用男先格斗"}, {"start": 33.38, "end": 34.38, "text": "赴卫抽水月牵面"}, {"start": 34.38, "end": 35.38, "text": "有意思"}, {"start": 35.38, "end": 36.78, "text": "这小子从一开始"}, {"start": 36.78, "end": 38.08, "text": "就在藏这一手"}, {"start": 38.08, "end": 38.88, "text": "周首长"}, {"start": 38.88, "end": 39.88, "text": "您不是说故意"}, {"start": 49.3, "end": 50.3, "text": "维纳斯"}, {"start": 50.3, "end": 51.3, "text": "你的实力"}, {"start": 51.3, "end": 52.3, "text": "我认可了"}]}