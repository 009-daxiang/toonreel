{"file": "天才机甲师-第36集.mp4", "ep": 36, "duration": 79.4, "segments": [{"start": 2.19, "end": 3.35, "text": "是天玄城的方向"}, {"start": 3.67, "end": 6.15, "text": "S加急圣甲虫突破天玄城外围防线"}, {"start": 6.15, "end": 7.75, "text": "白虎正与目标竞战禅斗"}, {"start": 7.75, "end": 8.31, "text": "禁告"}, {"start": 8.31, "end": 9.63, "text": "白虎右臂装甲损伤"}, {"start": 9.63, "end": 10.63, "text": "不许害你赵王人"}, {"start": 10.63, "end": 11.47, "text": "我们先回基地"}, {"start": 12.07, "end": 20.87, "text": "常规动能武器全部失效"}, {"start": 21.19, "end": 23.67, "text": "圣甲虫外壳能反射一切物理冲击"}, {"start": 23.67, "end": 25.75, "text": "天隋城的防线撑不过半小时"}, {"start": 25.95, "end": 32.87, "text": "不许手甲线碎了"}, {"start": 32.87, "end": 38.43, "text": "朱雀的电磁炮也是动能武器"}, {"start": 39.54, "end": 40.34, "text": "我打不穿"}, {"start": 41.42, "end": 42.1, "text": "静怡"}, {"start": 42.1, "end": 43.3, "text": "天隋城退守"}, {"start": 43.3, "end": 44.1, "text": "退守"}, {"start": 44.54, "end": 46.1, "text": "天隋城后面就是天虚"}, {"start": 46.1, "end": 46.94, "text": "退到哪儿去"}, {"start": 47.58, "end": 49.1, "text": "他的甲壳反弹物理动能对吧"}, {"start": 49.1, "end": 51.18, "text": "那我就造一把根本不和他发生物理碰撞的刀"}, {"start": 51.18, "end": 52.26, "text": "反物质高频振动刀"}, {"start": 52.26, "end": 52.98, "text": "代号斩液"}, {"start": 52.98, "end": 55.26, "text": "原理是用高频振动直接烟灭接触片的分子链"}, {"start": 55.26, "end": 56.74, "text": "不告冲击力不靠的穿透"}, {"start": 56.74, "end": 58.18, "text": "甲壳会像纸一样被切开"}, {"start": 58.18, "end": 59.02, "text": "宫时多久"}, {"start": 59.02, "end": 59.62, "text": "24小时"}, {"start": 59.62, "end": 60.14, "text": "方老"}, {"start": 60.14, "end": 62.66, "text": "24小时内能调查天穷基地的所有资源吗"}, {"start": 62.66, "end": 64.06, "text": "24小时太久了"}, {"start": 64.06, "end": 65.3, "text": "陆晓和若言等不了"}, {"start": 65.3, "end": 66.74, "text": "天隋城的民众也等不了"}, {"start": 66.74, "end": 67.06, "text": "元帅"}, {"start": 67.06, "end": 68.46, "text": "我请求阿修罗先出击"}, {"start": 68.46, "end": 69.22, "text": "拖住圣甲主"}, {"start": 69.22, "end": 69.78, "text": "刀一好"}, {"start": 69.86, "end": 70.42, "text": "立刻送过来"}, {"start": 70.42, "end": 71.82, "text": "你一个人拖得住吗"}, {"start": 71.82, "end": 72.46, "text": "拖得住"}, {"start": 72.46, "end": 73.62, "text": "你有把握用这把刀"}, {"start": 73.62, "end": 74.18, "text": "要"}, {"start": 74.18, "end": 75.54, "text": "阿修罗担任出击"}, {"start": 75.54, "end": 76.1, "text": "准了"}, {"start": 76.1, "end": 76.66, "text": "出药"}, {"start": 76.66, "end": 77.02, "text": "跟我走"}, {"start": 77.02, "end": 77.78, "text": "走了"}, {"start": 77.78, "end": 79.18, "text": "前线就交给你们"}]}