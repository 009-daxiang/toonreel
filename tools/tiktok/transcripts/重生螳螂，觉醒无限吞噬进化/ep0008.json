{"file": "重生螳螂，觉醒无限吞噬进化-第8集.mp4", "ep": 8, "duration": 61.5, "segments": [{"start": 0.0, "end": 4.27, "text": "四品剑雀"}, {"start": 4.27, "end": 15.08, "text": "居然捉到了一只四品剑雀"}, {"start": 15.08, "end": 17.08, "text": "五品雄姓唐狼"}, {"start": 17.08, "end": 20.08, "text": "这就是凌主要找的梦中秦唐啊"}, {"start": 23.1, "end": 26.1, "text": "雄壮的少年狼"}, {"start": 26.1, "end": 28.1, "text": "你 凌主"}, {"start": 28.1, "end": 30.1, "text": "我不是凌主"}, {"start": 30.1, "end": 32.1, "text": "是坐下侍卫美赤"}, {"start": 32.1, "end": 34.19, "text": "你们怎么称呼"}, {"start": 34.19, "end": 37.53, "text": "我叫等待"}, {"start": 37.53, "end": 38.53, "text": "美赤"}, {"start": 38.53, "end": 40.53, "text": "有何贵感"}, {"start": 40.53, "end": 42.53, "text": "繁染的季节到了"}, {"start": 42.53, "end": 45.53, "text": "凌主叫我来找些青壮唐狼"}, {"start": 45.53, "end": 48.53, "text": "你会得到凌主的青睐"}, {"start": 48.53, "end": 51.72, "text": "而她将由我亲自指导"}, {"start": 51.72, "end": 59.32, "text": "欢呼啦"}, {"start": 59.32, "end": 60.42, "text": "我俩没兴趣"}, {"start": 60.42, "end": 61.42, "text": "找别的唐狼吧"}]}