{"file": "重生螳螂，觉醒无限吞噬进化-第80集.mp4", "ep": 80, "duration": 58.4, "segments": [{"start": 0.0, "end": 0.88, "text": "追来了"}, {"start": 0.88, "end": 2.66, "text": "快跑啊"}, {"start": 2.66, "end": 4.3, "text": "可能有我族强者出现"}, {"start": 4.3, "end": 6.3, "text": "收刀族准备行魔败礼"}, {"start": 12.62, "end": 14.3, "text": "果然是我唐郎族"}, {"start": 14.3, "end": 19.73, "text": "全体母"}, {"start": 19.73, "end": 21.81, "text": "红鹰将军都行此大礼"}, {"start": 21.81, "end": 23.49, "text": "真令我感动啊"}, {"start": 23.49, "end": 24.49, "text": "快起来"}, {"start": 24.49, "end": 25.69, "text": "史克郎"}, {"start": 25.69, "end": 26.81, "text": "怎么是你"}, {"start": 26.81, "end": 28.65, "text": "有没有看到高级强者"}, {"start": 28.65, "end": 30.25, "text": "草原这么匱乏"}, {"start": 30.25, "end": 32.62, "text": "哪个高级强者瞧得上啊"}, {"start": 32.62, "end": 34.14, "text": "那贾崇大营"}, {"start": 34.14, "end": 35.54, "text": "是你摧毁的"}, {"start": 35.54, "end": 36.66, "text": "不然呢"}, {"start": 36.66, "end": 39.3, "text": "两只八品连我一刀都扛不住"}, {"start": 39.34, "end": 43.55, "text": "不过那个白药倒是挺能跑"}, {"start": 43.55, "end": 45.86, "text": "你真是离谱"}, {"start": 45.86, "end": 47.74, "text": "剩下的尸体你们去收"}, {"start": 47.74, "end": 48.74, "text": "我先回营"}, {"start": 48.74, "end": 50.02, "text": "这几天有够累的"}, {"start": 50.02, "end": 55.31, "text": "贾崇大营"}, {"start": 55.31, "end": 57.03, "text": "竟然真把大营灭了"}]}