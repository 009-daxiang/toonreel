{"file": "重生螳螂，觉醒无限吞噬进化-第61集.mp4", "ep": 61, "duration": 74.5, "segments": [{"start": 0.34, "end": 1.58, "text": "这个真不知道"}, {"start": 2.06, "end": 4.74, "text": "情报小队和统领将军应该会知道"}, {"start": 5.36, "end": 6.32, "text": "你可知道"}, {"start": 6.32, "end": 8.56, "text": "如何能获得一些其他种族的情报"}, {"start": 9.92, "end": 11.88, "text": "你加入咱们唐郎红鹰大营"}, {"start": 11.88, "end": 13.76, "text": "可以直接进入情报小队"}, {"start": 14.2, "end": 16.88, "text": "有情报就能定点刷经验"}, {"start": 17.46, "end": 18.14, "text": "可以"}, {"start": 18.38, "end": 19.9, "text": "那我就加入唐郎族"}, {"start": 20.14, "end": 21.1, "text": "从此以后"}, {"start": 21.26, "end": 23.34, "text": "咱们共同抵御他族入侵"}, {"start": 23.5, "end": 25.42, "text": "捍卫我们唐郎族的荣耀"}, {"start": 25.66, "end": 27.18, "text": "让唐郎的刀光"}, {"start": 27.18, "end": 29.5, "text": "闪烁在整个崇明草原"}, {"start": 30.49, "end": 31.69, "text": "境界太高了"}, {"start": 31.89, "end": 33.49, "text": "为了唐郎族荣耀"}, {"start": 34.38, "end": 35.06, "text": "那个"}, {"start": 35.38, "end": 36.9, "text": "四品遮天飞黄的尸体"}, {"start": 36.9, "end": 37.74, "text": "您还要吗"}, {"start": 37.94, "end": 38.54, "text": "不要了"}, {"start": 38.66, "end": 39.5, "text": "随便你处置"}, {"start": 48.18, "end": 48.98, "text": "巡逻小队"}, {"start": 49.14, "end": 50.06, "text": "小统领青线"}, {"start": 50.06, "end": 51.1, "text": "求见统领将军"}, {"start": 51.42, "end": 52.1, "text": "进来吧"}, {"start": 53.76, "end": 54.64, "text": "外来者"}, {"start": 55.08, "end": 55.6, "text": "是的"}, {"start": 55.88, "end": 57.28, "text": "从东方密林跃过山脉"}, {"start": 57.28, "end": 58.2, "text": "一路闯过来的"}, {"start": 58.6, "end": 59.88, "text": "我们遭遇飞黄突袭"}, {"start": 60.24, "end": 61.52, "text": "多亏史克堂救下我们"}, {"start": 62.03, "end": 63.03, "text": "他想加入大营"}, {"start": 63.62, "end": 64.26, "text": "可以"}, {"start": 64.78, "end": 67.46, "text": "新加入可以自主选择足兵职业"}, {"start": 67.82, "end": 69.1, "text": "我想加入情报小队"}, {"start": 70.01, "end": 72.01, "text": "情报小队需要前往前线"}, {"start": 72.25, "end": 73.41, "text": "而且数量较少"}, {"start": 73.69, "end": 74.57, "text": "非常危险"}]}