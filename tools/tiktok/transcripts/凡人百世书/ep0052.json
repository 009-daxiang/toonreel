{"file": "凡人百世书-第52集.mp4", "ep": 52, "duration": 99.4, "segments": [{"start": 1.62, "end": 3.22, "text": "弟弟到底去了哪里"}, {"start": 3.58, "end": 5.42, "text": "难道真的被先人接走了"}, {"start": 6.38, "end": 7.54, "text": "我会继续找"}, {"start": 8.02, "end": 10.44, "text": "活要见人 死要见尸"}, {"start": 10.88, "end": 11.68, "text": "禀陛下"}, {"start": 11.68, "end": 13.32, "text": "非将军斩杀胡人大帅"}, {"start": 13.32, "end": 15.12, "text": "胡人八十万大军全线崩溃"}, {"start": 15.12, "end": 15.76, "text": "封赏"}, {"start": 16.08, "end": 17.92, "text": "沉默禁封边关守驾"}, {"start": 18.44, "end": 21.59, "text": "这般封赏实在不公"}, {"start": 21.71, "end": 23.23, "text": "您立下赫赫边关攻击"}, {"start": 23.47, "end": 24.91, "text": "镇守边关履历其功"}, {"start": 24.91, "end": 25.95, "text": "攻击无人能击"}, {"start": 26.15, "end": 27.59, "text": "为何得不到应有尊崇"}, {"start": 27.75, "end": 29.11, "text": "封侯非我义"}, {"start": 29.51, "end": 30.51, "text": "那您图什么"}, {"start": 30.99, "end": 32.45, "text": "图一个心安"}, {"start": 34.34, "end": 36.06, "text": "老将军守边五十年"}, {"start": 36.69, "end": 37.81, "text": "战功无数"}, {"start": 38.05, "end": 38.93, "text": "封侯了吗"}, {"start": 40.14, "end": 41.14, "text": "他都不在乎"}, {"start": 41.66, "end": 42.58, "text": "我在乎什么"}, {"start": 48.72, "end": 49.32, "text": "霍鲁"}, {"start": 49.6, "end": 50.84, "text": "你都多大的人了"}, {"start": 50.84, "end": 51.84, "text": "还不成家"}, {"start": 52.12, "end": 53.4, "text": "娘想抱孙子了"}, {"start": 53.56, "end": 54.76, "text": "你不为自己想"}, {"start": 54.76, "end": 56.28, "text": "也得为陈家想啊"}, {"start": 56.64, "end": 57.16, "text": "娘"}, {"start": 57.9, "end": 58.66, "text": "都依你"}, {"start": 65.98, "end": 72.22, "text": "如果那一事"}, {"start": 72.22, "end": 74.02, "text": "我的家人后代营品了"}, {"start": 74.02, "end": 77.1, "text": "可惜没有"}, {"start": 78.04, "end": 79.12, "text": "子衣门没了"}, {"start": 79.5, "end": 80.74, "text": "仇人也老死了"}, {"start": 81.34, "end": 82.42, "text": "早已无事人费"}, {"start": 82.42, "end": 88.09, "text": "说娘梦见好几次了"}, {"start": 88.37, "end": 89.77, "text": "她坐在仙鹤上"}, {"start": 89.77, "end": 91.01, "text": "宠娘婚手"}, {"start": 91.01, "end": 91.57, "text": "娘"}, {"start": 92.01, "end": 93.37, "text": "她忙仙人忙"}, {"start": 93.49, "end": 94.33, "text": "忙好"}, {"start": 94.45, "end": 95.56, "text": "忙好"}, {"start": 95.64, "end": 96.96, "text": "有出息"}]}