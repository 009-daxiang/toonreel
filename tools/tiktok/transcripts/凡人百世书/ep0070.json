{"file": "凡人百世书-第70集.mp4", "ep": 70, "duration": 95.6, "segments": [{"start": 7.22, "end": 9.22, "text": "让哀家亲自买"}, {"start": 9.22, "end": 22.89, "text": "陛下"}, {"start": 22.89, "end": 24.89, "text": "这就是你想看到的吗"}, {"start": 24.89, "end": 26.89, "text": "当今皇帝得不配位"}, {"start": 26.89, "end": 27.89, "text": "得皇道吉日"}, {"start": 27.89, "end": 29.89, "text": "行三请三让之礼"}, {"start": 29.89, "end": 30.89, "text": "正式传位于"}, {"start": 30.89, "end": 32.89, "text": "中山敬王叶玄德"}, {"start": 32.89, "end": 33.89, "text": "否则前期的努力"}, {"start": 33.89, "end": 34.89, "text": "全部白费"}, {"start": 34.89, "end": 40.75, "text": "禀太后"}, {"start": 40.75, "end": 42.75, "text": "传国玉玺不知所踪"}, {"start": 42.75, "end": 43.75, "text": "找"}, {"start": 43.75, "end": 44.75, "text": "禀太后"}, {"start": 44.75, "end": 45.75, "text": "皇宫内已经搜查"}, {"start": 45.75, "end": 46.75, "text": "传国玉玺消失了"}, {"start": 46.75, "end": 48.75, "text": "照常举行"}, {"start": 48.75, "end": 51.06, "text": "皇帝失德"}, {"start": 51.06, "end": 52.06, "text": "上成天意"}, {"start": 52.06, "end": 53.06, "text": "下顺明心"}, {"start": 53.06, "end": 55.06, "text": "退位让贤"}, {"start": 55.06, "end": 56.06, "text": "中山敬王叶玄德"}, {"start": 56.06, "end": 57.06, "text": "仁德兼备"}, {"start": 57.06, "end": 59.06, "text": "一成大统"}, {"start": 59.06, "end": 62.47, "text": "吾皇万岁万岁"}, {"start": 62.47, "end": 64.47, "text": "万万岁万岁"}, {"start": 64.47, "end": 65.47, "text": "万万岁"}, {"start": 65.47, "end": 67.47, "text": "吾皇万岁万岁"}, {"start": 67.47, "end": 68.47, "text": "万万岁"}, {"start": 68.47, "end": 70.47, "text": "这句傀儡杨相进出"}, {"start": 70.47, "end": 72.47, "text": "哀家十分喜欢"}, {"start": 72.47, "end": 74.59, "text": "叶哥"}, {"start": 74.59, "end": 75.66, "text": "我"}, {"start": 75.66, "end": 76.66, "text": "这"}, {"start": 76.66, "end": 77.66, "text": "这真的不行"}, {"start": 77.66, "end": 79.91, "text": "怕辜负您和太后的期盼"}, {"start": 79.91, "end": 81.91, "text": "陛下安心就好"}, {"start": 81.91, "end": 82.91, "text": "太后对你有信心"}, {"start": 82.91, "end": 83.91, "text": "一切由我"}, {"start": 83.91, "end": 86.45, "text": "先天高手"}, {"start": 86.45, "end": 88.45, "text": "受元两百到三百岁"}, {"start": 88.45, "end": 89.45, "text": "但我活不了那么久"}, {"start": 89.45, "end": 90.45, "text": "多次使用密法"}, {"start": 90.45, "end": 91.45, "text": "燃烧潜力"}, {"start": 91.45, "end": 93.45, "text": "身体早就透支了"}, {"start": 93.45, "end": 95.45, "text": "怕是只剩下几十年的瘦"}]}