{"file": "凡人百世书-第10集.mp4", "ep": 10, "duration": 126.8, "segments": [{"start": 1.74, "end": 2.46, "text": "等等"}, {"start": 2.7, "end": 4.38, "text": "你刚才说杀的干净"}, {"start": 4.38, "end": 5.82, "text": "你 你还想杀谁"}, {"start": 6.18, "end": 7.3, "text": "你觉得呢"}, {"start": 8.1, "end": 8.86, "text": "你疯了"}, {"start": 8.86, "end": 10.26, "text": "你他娘疯了"}, {"start": 10.54, "end": 11.78, "text": "我是内门护法"}, {"start": 11.78, "end": 13.3, "text": "我是不是只罚长老"}, {"start": 13.3, "end": 15.14, "text": "杀了我 你也活不了"}, {"start": 21.71, "end": 23.79, "text": "你这个疯子 疯子"}, {"start": 23.79, "end": 25.87, "text": "我左轨也不会放过你"}, {"start": 25.87, "end": 27.87, "text": "紫衣门也不会放过你"}, {"start": 29.9, "end": 31.78, "text": "想知道我为什么杀你吗"}, {"start": 32.02, "end": 33.74, "text": "记不记得陈家村"}, {"start": 34.3, "end": 37.18, "text": "我上辈子叫陈墨"}, {"start": 39.78, "end": 43.58, "text": "大人 有东西"}, {"start": 43.58, "end": 45.75, "text": "这是赤裹"}, {"start": 45.75, "end": 46.83, "text": "我听人说过"}, {"start": 46.83, "end": 48.19, "text": "这玩意儿能助人突破瓶颈"}, {"start": 48.19, "end": 49.39, "text": "是难得的宝贝"}, {"start": 49.39, "end": 51.03, "text": "武天德拼死带回来的"}, {"start": 51.03, "end": 52.47, "text": "但现在归我了"}, {"start": 67.49, "end": 69.21, "text": "终于晋升一流武者"}, {"start": 69.21, "end": 71.29, "text": "在紫衣门也算高端战历了"}, {"start": 71.8, "end": 73.12, "text": "养精三脉的自治"}, {"start": 73.12, "end": 74.72, "text": "一流基本就是极限"}, {"start": 74.72, "end": 76.8, "text": "再往上 后天"}, {"start": 77.08, "end": 80.26, "text": "一流了"}, {"start": 80.5, "end": 82.23, "text": "托师姐的福"}, {"start": 82.51, "end": 84.36, "text": "是你自己的本事"}, {"start": 84.36, "end": 89.62, "text": "她的气息和内门那些护法"}, {"start": 89.62, "end": 90.7, "text": "完全不一样"}, {"start": 90.7, "end": 92.62, "text": "更明实 更厚重"}, {"start": 92.94, "end": 94.86, "text": "像是一座大山压在面前"}, {"start": 96.34, "end": 96.9, "text": "你"}, {"start": 97.87, "end": 99.19, "text": "小后天而已"}, {"start": 100.85, "end": 102.33, "text": "师姐天赋惊人"}, {"start": 102.49, "end": 103.93, "text": "小后天算不得什么"}, {"start": 104.25, "end": 105.77, "text": "待我突破大后天"}, {"start": 106.05, "end": 107.93, "text": "才能年轻一辈无敌"}, {"start": 108.64, "end": 111.16, "text": "暗狼卫 发展得如何"}, {"start": 111.64, "end": 112.76, "text": "托师姐的福"}, {"start": 112.76, "end": 114.56, "text": "现在有三流武者十七人"}, {"start": 114.72, "end": 116.2, "text": "还有五位刚突破二流"}, {"start": 116.4, "end": 117.52, "text": "都是能办事"}, {"start": 118.43, "end": 119.59, "text": "继续好好干"}, {"start": 119.83, "end": 121.47, "text": "以后少不了你的好处"}, {"start": 122.05, "end": 123.29, "text": "愿为师姐效劳"}, {"start": 124.34, "end": 125.1, "text": "行了"}, {"start": 125.1, "end": 126.74, "text": "随我去拜见大长老"}]}