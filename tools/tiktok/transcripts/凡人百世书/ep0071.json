{"file": "凡人百世书-第71集.mp4", "ep": 71, "duration": 87.3, "segments": [{"start": 0.0, "end": 0.68, "text": "不过够了"}, {"start": 1.62, "end": 3.46, "text": "我要的就是这几十年的时间"}, {"start": 3.86, "end": 4.94, "text": "做该做的事"}, {"start": 5.95, "end": 6.59, "text": "快了"}, {"start": 8.84, "end": 9.6, "text": "你怎么来了"}, {"start": 10.6, "end": 11.6, "text": "雪山冰莲"}, {"start": 11.92, "end": 14.04, "text": "可顾本培园修复暗伤"}, {"start": 16.09, "end": 17.45, "text": "这是传说中的东西"}, {"start": 18.05, "end": 19.29, "text": "我只在古籍里见过"}, {"start": 21.54, "end": 22.38, "text": "你去雪山了"}, {"start": 23.24, "end": 24.28, "text": "我看你气息不稳"}, {"start": 25.16, "end": 26.28, "text": "难道是遇到了雪崩"}, {"start": 27.02, "end": 28.18, "text": "一点小意外而已"}, {"start": 29.56, "end": 31.28, "text": "最了解你的始终是你的对手"}, {"start": 31.76, "end": 32.6, "text": "他早就知道"}, {"start": 32.76, "end": 34.24, "text": "我用密法强行突破的事"}, {"start": 34.48, "end": 35.28, "text": "只是没有点破"}, {"start": 35.28, "end": 36.8, "text": "而是冒死去采了一株雪莲"}, {"start": 37.04, "end": 37.84, "text": "希望能帮到我"}, {"start": 37.84, "end": 39.44, "text": "你的身体透支得很厉害"}, {"start": 39.84, "end": 42.36, "text": "这株药或许能修复你的身体损伤"}, {"start": 42.52, "end": 43.4, "text": "增添寿命"}, {"start": 43.84, "end": 44.52, "text": "你为什么"}, {"start": 44.84, "end": 45.44, "text": "别问"}, {"start": 46.65, "end": 47.29, "text": "冠山玉"}, {"start": 49.36, "end": 49.84, "text": "拿走"}, {"start": 50.94, "end": 51.58, "text": "我不需要"}, {"start": 52.25, "end": 53.01, "text": "你我之间"}, {"start": 53.37, "end": 54.29, "text": "到此为止"}, {"start": 56.41, "end": 57.13, "text": "叶雪"}, {"start": 57.45, "end": 58.41, "text": "你好得很"}, {"start": 58.65, "end": 59.41, "text": "这个女人"}, {"start": 59.57, "end": 60.53, "text": "当真是人结"}, {"start": 60.81, "end": 61.77, "text": "面对如此危局"}, {"start": 61.77, "end": 62.89, "text": "她竟也不慌不忙"}, {"start": 62.89, "end": 63.89, "text": "连发树道证令"}, {"start": 63.89, "end": 65.01, "text": "一套组合权下来"}, {"start": 65.09, "end": 66.97, "text": "各路叛军的兵风被声声挡住"}, {"start": 67.17, "end": 68.21, "text": "她还发动了母族"}, {"start": 68.21, "end": 70.13, "text": "散进家裁组成了一支幼生军"}, {"start": 70.13, "end": 70.73, "text": "而现在"}, {"start": 70.73, "end": 72.17, "text": "太后缺的只是一个统帅"}, {"start": 72.17, "end": 73.17, "text": "我的机会来了"}, {"start": 75.23, "end": 76.39, "text": "没想到此去的废地"}, {"start": 76.39, "end": 77.35, "text": "居然还活着"}, {"start": 77.35, "end": 78.47, "text": "要讨伐太后"}, {"start": 78.71, "end": 80.43, "text": "这简直是千古未文之事"}, {"start": 80.71, "end": 82.31, "text": "太后又应该如何应对"}, {"start": 85.28, "end": 87.2, "text": "跳梁小丑罢了"}]}