{"file": "凡人百世书-第53集.mp4", "ep": 53, "duration": 98.7, "segments": [{"start": 0.0, "end": 1.0, "text": "自此之后"}, {"start": 1.72, "end": 3.72, "text": "无人永不敢难下"}, {"start": 5.07, "end": 7.07, "text": "陈破库功盖天下"}, {"start": 7.43, "end": 8.63, "text": "李英风侯"}, {"start": 9.11, "end": 11.11, "text": "将军终于要封侯了"}, {"start": 11.43, "end": 12.55, "text": "等了几十年"}, {"start": 12.75, "end": 14.15, "text": "动算等到了"}, {"start": 14.87, "end": 15.39, "text": "将军"}, {"start": 15.95, "end": 17.11, "text": "胡人被打跑了"}, {"start": 17.31, "end": 18.83, "text": "以后不会再有大战了"}, {"start": 19.74, "end": 20.58, "text": "您的心愿"}, {"start": 21.18, "end": 22.54, "text": "我替您完成了"}, {"start": 25.3, "end": 26.42, "text": "那就是陈破晴"}, {"start": 26.62, "end": 27.82, "text": "发泼胡人的那位"}, {"start": 28.02, "end": 28.82, "text": "非将军"}, {"start": 28.82, "end": 29.98, "text": "真正的非将军"}, {"start": 30.1, "end": 30.9, "text": "陈老将军"}, {"start": 31.02, "end": 31.82, "text": "请上座"}, {"start": 32.06, "end": 32.58, "text": "陛下"}, {"start": 32.98, "end": 34.94, "text": "老臣有一事相求"}, {"start": 35.1, "end": 35.94, "text": "老将军"}, {"start": 35.94, "end": 37.14, "text": "但说无妨"}, {"start": 37.46, "end": 40.06, "text": "老臣听闻皇宫身处有一块石碑"}, {"start": 40.06, "end": 41.62, "text": "是初代国主所领"}, {"start": 42.07, "end": 43.95, "text": "老臣一生痴迷武道"}, {"start": 44.11, "end": 45.15, "text": "想去看一看"}, {"start": 45.15, "end": 46.03, "text": "不知可否"}, {"start": 46.03, "end": 47.55, "text": "此乃皇室禁地"}, {"start": 47.67, "end": 49.15, "text": "外人不得入内"}, {"start": 49.51, "end": 51.15, "text": "臣老将军见谅"}, {"start": 52.62, "end": 54.34, "text": "太平本是将军定"}, {"start": 54.74, "end": 56.54, "text": "不许将军见太平"}, {"start": 57.3, "end": 58.14, "text": "这句话"}, {"start": 58.5, "end": 60.02, "text": "我听过很多次"}, {"start": 60.26, "end": 64.87, "text": "今天终于落了"}, {"start": 64.99, "end": 65.59, "text": "老将军"}, {"start": 65.67, "end": 68.11, "text": "你 九六毒"}, {"start": 68.43, "end": 69.15, "text": "谁干的"}, {"start": 69.82, "end": 71.46, "text": "太后 你不是你"}, {"start": 75.54, "end": 77.14, "text": "陈兄 别怪我"}, {"start": 77.38, "end": 78.7, "text": "我本不想出手"}, {"start": 78.94, "end": 81.26, "text": "乃和天下只知有你非将军"}, {"start": 81.42, "end": 82.94, "text": "却不知我大元帅"}, {"start": 91.43, "end": 93.62, "text": "我见过"}, {"start": 93.62, "end": 94.46, "text": "你姓什么"}, {"start": 94.46, "end": 96.78, "text": "哀家姓关 归名子萱"}, {"start": 97.22, "end": 98.58, "text": "先父关陪德"}]}