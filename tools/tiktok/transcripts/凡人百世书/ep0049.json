{"file": "凡人百世书-第49集.mp4", "ep": 49, "duration": 102.7, "segments": [{"start": 0.18, "end": 1.38, "text": "难道就像后天一样"}, {"start": 1.82, "end": 4.14, "text": "先天会不会也有小千天大先天"}, {"start": 4.5, "end": 5.14, "text": "听说了吗"}, {"start": 5.26, "end": 6.02, "text": "关口告急"}, {"start": 6.54, "end": 8.02, "text": "五人十八步联合在一起"}, {"start": 8.22, "end": 9.62, "text": "八十万大军扣关南下"}, {"start": 9.74, "end": 10.62, "text": "围攻关口"}, {"start": 18.71, "end": 19.47, "text": "李将军呢"}, {"start": 19.95, "end": 22.18, "text": "陈将军"}, {"start": 22.34, "end": 23.82, "text": "我问你李将军呢"}, {"start": 24.14, "end": 24.86, "text": "李将军"}, {"start": 25.38, "end": 26.42, "text": "朕死了"}, {"start": 26.74, "end": 27.74, "text": "死了"}, {"start": 28.1, "end": 31.11, "text": "七天前胡人攻城"}, {"start": 31.23, "end": 32.51, "text": "李将军上城墙杜战"}, {"start": 32.63, "end": 33.51, "text": "被流史射中"}, {"start": 33.63, "end": 34.39, "text": "伤势太重"}, {"start": 34.51, "end": 35.31, "text": "没挺过来"}, {"start": 35.43, "end": 36.63, "text": "林忠前他还在喊"}, {"start": 36.71, "end": 37.79, "text": "不叫胡马杜研杀"}, {"start": 37.91, "end": 38.55, "text": "陈将军回来了"}, {"start": 38.67, "end": 39.27, "text": "陈将军"}, {"start": 39.51, "end": 40.35, "text": "李将军他"}, {"start": 43.65, "end": 44.29, "text": "朴杜"}, {"start": 44.97, "end": 47.65, "text": "见信时老夫孔已不再认识"}, {"start": 47.93, "end": 48.89, "text": "不要难过"}, {"start": 49.37, "end": 51.13, "text": "将军百战杀场死"}, {"start": 51.25, "end": 52.41, "text": "此生足矣"}, {"start": 53.05, "end": 54.09, "text": "唯一遗憾"}, {"start": 54.33, "end": 56.17, "text": "是没能再见你一命"}, {"start": 71.87, "end": 72.55, "text": "怀说怎么了"}, {"start": 72.63, "end": 73.31, "text": "陈将军"}, {"start": 73.83, "end": 74.55, "text": "怀说他"}, {"start": 74.75, "end": 75.63, "text": "失踪了"}, {"start": 75.83, "end": 76.99, "text": "那一战打得太惨"}, {"start": 77.11, "end": 78.15, "text": "尸体都找不全"}, {"start": 78.35, "end": 79.95, "text": "有人看见他被胡人围住"}, {"start": 80.07, "end": 81.23, "text": "后来就找不着了"}, {"start": 81.35, "end": 82.56, "text": "找不着了"}, {"start": 82.72, "end": 83.48, "text": "活不见人"}, {"start": 83.6, "end": 84.68, "text": "死不见尸"}, {"start": 87.66, "end": 88.26, "text": "朴鲁"}, {"start": 88.62, "end": 90.1, "text": "娘这几天一直做梦"}, {"start": 90.22, "end": 91.98, "text": "梦见有仙人骑着仙鹤"}, {"start": 92.22, "end": 93.38, "text": "从天上飞下来"}, {"start": 93.5, "end": 94.62, "text": "把你弟弟接走了"}, {"start": 94.74, "end": 96.26, "text": "那仙鹤好白好大"}, {"start": 96.38, "end": 97.3, "text": "你弟弟坐在上面"}, {"start": 97.42, "end": 98.86, "text": "还冲娘回首对不对"}, {"start": 99.06, "end": 100.66, "text": "他被仙人接走了对不对"}, {"start": 102.02, "end": 102.5, "text": "娘"}]}