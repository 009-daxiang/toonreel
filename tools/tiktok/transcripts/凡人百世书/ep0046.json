{"file": "凡人百世书-第46集.mp4", "ep": 46, "duration": 102.1, "segments": [{"start": 0.0, "end": 0.76, "text": "什么修伟"}, {"start": 0.96, "end": 2.24, "text": "半步大后天"}, {"start": 2.56, "end": 4.24, "text": "半步大后天确实不算"}, {"start": 4.4, "end": 5.12, "text": "但我身负磨到"}, {"start": 5.12, "end": 6.52, "text": "咬枪骨真气战力翻倍"}, {"start": 6.52, "end": 8.0, "text": "别过后座真正的半步大天"}, {"start": 8.0, "end": 9.0, "text": "我也敢碰一碰"}, {"start": 9.81, "end": 10.73, "text": "陈破禄"}, {"start": 11.13, "end": 12.17, "text": "可敢一战"}, {"start": 15.43, "end": 16.99, "text": "我还以为你不敢来呢"}, {"start": 17.11, "end": 18.31, "text": "本来是不想来的"}, {"start": 18.63, "end": 19.75, "text": "但你这么热情"}, {"start": 20.11, "end": 21.23, "text": "不来好像不太礼貌"}, {"start": 21.35, "end": 22.31, "text": "废话少说"}, {"start": 22.43, "end": 23.23, "text": "动手吧"}, {"start": 23.79, "end": 30.38, "text": "一招"}, {"start": 30.62, "end": 31.88, "text": "一招就赢了"}, {"start": 32.0, "end": 33.12, "text": "他不是小后天吗"}, {"start": 33.24, "end": 34.12, "text": "怎么这么强"}, {"start": 34.32, "end": 35.84, "text": "武状怨就这"}, {"start": 36.28, "end": 42.4, "text": "情书"}, {"start": 42.64, "end": 43.84, "text": "写得还挺肉麻"}, {"start": 45.49, "end": 46.17, "text": "破禄"}, {"start": 46.37, "end": 47.73, "text": "你也该成个家了"}, {"start": 48.61, "end": 49.13, "text": "将军"}, {"start": 49.41, "end": 50.25, "text": "魔将还小"}, {"start": 50.69, "end": 51.81, "text": "已经不小了"}, {"start": 51.97, "end": 52.85, "text": "你看到王藤"}, {"start": 52.85, "end": 53.89, "text": "才比你大几岁"}, {"start": 54.01, "end": 55.61, "text": "听说已经定了三方情事"}, {"start": 55.61, "end": 56.09, "text": "将军"}, {"start": 56.21, "end": 57.01, "text": "您是知道的"}, {"start": 57.64, "end": 58.24, "text": "将军"}, {"start": 58.64, "end": 59.4, "text": "天牢出事了"}, {"start": 59.48, "end": 60.2, "text": "有人捷御"}, {"start": 60.32, "end": 61.96, "text": "捷代还是前任魔教教主"}, {"start": 62.78, "end": 63.74, "text": "周承丰"}, {"start": 63.9, "end": 64.3, "text": "对"}, {"start": 64.58, "end": 65.98, "text": "据说是个女先天出手"}, {"start": 66.1, "end": 67.74, "text": "杀进天牢把人救出来了"}, {"start": 68.34, "end": 69.02, "text": "然后呢"}, {"start": 70.13, "end": 70.69, "text": "然后"}, {"start": 71.01, "end": 71.93, "text": "他们跑了"}, {"start": 72.29, "end": 73.77, "text": "那个女先天太强了"}, {"start": 74.05, "end": 75.29, "text": "根本挡不住"}, {"start": 75.53, "end": 76.45, "text": "现在估计"}, {"start": 76.61, "end": 77.73, "text": "搜不到了"}, {"start": 78.17, "end": 78.93, "text": "去哪儿"}, {"start": 79.21, "end": 79.89, "text": "去看看"}, {"start": 85.69, "end": 87.01, "text": "两人速度极快"}, {"start": 87.13, "end": 88.57, "text": "周承丰真还活着"}, {"start": 89.17, "end": 90.17, "text": "真想追上去"}, {"start": 90.37, "end": 91.45, "text": "牵手杀了他"}, {"start": 91.65, "end": 93.26, "text": "但才小后天"}, {"start": 93.7, "end": 95.26, "text": "真碰死不了先天"}, {"start": 95.54, "end": 97.47, "text": "时运不济啊"}, {"start": 98.56, "end": 99.12, "text": "算了"}, {"start": 99.36, "end": 100.12, "text": "以后再说"}, {"start": 100.36, "end": 101.56, "text": "我有的是时间"}]}