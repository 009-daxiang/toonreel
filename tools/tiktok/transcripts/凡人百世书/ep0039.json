{"file": "凡人百世书-第39集.mp4", "ep": 39, "duration": 90.3, "segments": [{"start": 0.0, "end": 1.0, "text": "陈破头"}, {"start": 1.0, "end": 2.0, "text": "在"}, {"start": 2.0, "end": 3.0, "text": "抬起头来"}, {"start": 3.0, "end": 5.6, "text": "三年前你还在山里打猎"}, {"start": 5.6, "end": 8.4, "text": "三年后你就能杀穿狄阵"}, {"start": 8.4, "end": 10.4, "text": "说说看你是怎么做到的"}, {"start": 10.4, "end": 11.4, "text": "回将军"}, {"start": 11.4, "end": 14.0, "text": "三年前我无意中得到了一份传承"}, {"start": 14.0, "end": 15.0, "text": "什么传承"}, {"start": 15.0, "end": 16.4, "text": "魔教教主的传承"}, {"start": 16.4, "end": 17.6, "text": "魔教教主"}, {"start": 17.6, "end": 18.4, "text": "你确定"}, {"start": 18.4, "end": 19.6, "text": "我还得到了一首诗"}, {"start": 19.6, "end": 21.0, "text": "据说藏着魔教阵教神功"}, {"start": 21.0, "end": 22.2, "text": "玄魔宫的下落"}, {"start": 22.2, "end": 24.5, "text": "今日便献给老将军"}, {"start": 24.5, "end": 25.9, "text": "青山埋谷处"}, {"start": 25.9, "end": 27.3, "text": "白谷化联台"}, {"start": 27.3, "end": 28.9, "text": "连开七半落"}, {"start": 28.9, "end": 30.1, "text": "魔心自天来"}, {"start": 31.1, "end": 32.3, "text": "年轻人"}, {"start": 32.3, "end": 33.5, "text": "你倒是坦诚"}, {"start": 33.5, "end": 35.1, "text": "魔教玄魔宫的下落"}, {"start": 35.1, "end": 36.3, "text": "你愿意说出来"}, {"start": 36.3, "end": 37.7, "text": "是信得过老夫"}, {"start": 37.7, "end": 39.7, "text": "你知道老夫今年多大了吗"}, {"start": 39.7, "end": 40.7, "text": "听闻将军"}, {"start": 40.7, "end": 41.9, "text": "已经百岁"}, {"start": 41.9, "end": 43.7, "text": "就是大后天巅峰"}, {"start": 43.7, "end": 45.1, "text": "困了三十年"}, {"start": 45.1, "end": 46.7, "text": "如果找到你说的玄魔宫"}, {"start": 46.7, "end": 48.3, "text": "确实有可能突破先天"}, {"start": 48.3, "end": 49.9, "text": "多活一百年"}, {"start": 49.9, "end": 51.1, "text": "但你想过没有"}, {"start": 51.1, "end": 52.7, "text": "老夫如果闭关去突破"}, {"start": 52.7, "end": 53.7, "text": "需要多久"}, {"start": 53.7, "end": 54.7, "text": "短则三五年"}, {"start": 54.7, "end": 56.1, "text": "长则十年二十年"}, {"start": 56.1, "end": 57.9, "text": "这期间这关口怎么办"}, {"start": 57.9, "end": 59.3, "text": "老夫躲起来闭关"}, {"start": 59.3, "end": 60.1, "text": "谁来守关"}, {"start": 60.1, "end": 61.3, "text": "多活一百年"}, {"start": 61.3, "end": 62.5, "text": "看着关口失守"}, {"start": 62.5, "end": 64.5, "text": "看着狐人南下生灵涂炭"}, {"start": 64.5, "end": 66.53, "text": "这命老夫要来合用"}, {"start": 66.53, "end": 68.53, "text": "不过你若有需要"}, {"start": 68.53, "end": 70.53, "text": "老夫倒是可以帮你找"}, {"start": 70.53, "end": 71.53, "text": "将军 你"}, {"start": 71.53, "end": 72.53, "text": "你年轻"}, {"start": 72.53, "end": 73.73, "text": "十八岁就一流了"}, {"start": 73.73, "end": 75.13, "text": "比老夫当年强多了"}, {"start": 75.13, "end": 76.13, "text": "到时候"}, {"start": 76.13, "end": 78.53, "text": "你来替老夫守着这万里边关"}, {"start": 78.53, "end": 80.53, "text": "那东西老夫帮你找"}, {"start": 80.53, "end": 82.27, "text": "将军"}, {"start": 82.27, "end": 83.07, "text": "行了"}, {"start": 83.07, "end": 83.87, "text": "起来吧"}, {"start": 83.87, "end": 87.7, "text": "跪着怪累的"}, {"start": 87.7, "end": 89.03, "text": "将军"}, {"start": 89.03, "end": 90.23, "text": "当初周统领"}]}