{"file": "凡人百世书-第66集.mp4", "ep": 66, "duration": 102.9, "segments": [{"start": 0.96, "end": 2.88, "text": "几位爱卿怎么不说话"}, {"start": 2.88, "end": 3.68, "text": "回太后"}, {"start": 4.08, "end": 5.32, "text": "微臣虽眼着"}, {"start": 5.32, "end": 6.6, "text": "但那是老鼠无疑"}, {"start": 6.6, "end": 7.76, "text": "臣也认为是鼠"}, {"start": 8.28, "end": 9.04, "text": "好"}, {"start": 9.52, "end": 10.4, "text": "很好"}, {"start": 10.96, "end": 12.04, "text": "那几个人"}, {"start": 12.56, "end": 13.52, "text": "交给你了"}, {"start": 13.52, "end": 14.36, "text": "必不辱命"}, {"start": 24.03, "end": 24.63, "text": "做得好"}, {"start": 24.63, "end": 25.51, "text": "还有件事"}, {"start": 25.95, "end": 27.15, "text": "选一个听话的"}, {"start": 27.15, "end": 28.07, "text": "又让人挑不出"}, {"start": 28.07, "end": 29.31, "text": "毛病的宗室傀儡"}, {"start": 29.31, "end": 29.79, "text": "太后"}, {"start": 30.19, "end": 31.11, "text": "此事须谨慎"}, {"start": 31.47, "end": 32.07, "text": "臣以为"}, {"start": 32.07, "end": 32.91, "text": "可从偏远的王室"}, {"start": 32.91, "end": 33.99, "text": "支脉中物色人选"}, {"start": 34.31, "end": 35.27, "text": "那些人无权无势"}, {"start": 35.27, "end": 35.95, "text": "更好控制"}, {"start": 35.95, "end": 36.67, "text": "有理"}, {"start": 37.31, "end": 38.19, "text": "你去办吧"}, {"start": 40.78, "end": 66.58, "text": "他究竟藏着什么秘密"}, {"start": 66.58, "end": 67.82, "text": "你一直知道我在"}, {"start": 70.08, "end": 71.36, "text": "为什么不点破"}, {"start": 71.56, "end": 72.52, "text": "你想跟"}, {"start": 72.52, "end": 73.36, "text": "就跟着吧"}, {"start": 75.74, "end": 76.54, "text": "叶玄"}, {"start": 76.54, "end": 77.5, "text": "这些杀手"}, {"start": 77.5, "end": 79.34, "text": "好像是你大哥叶广派来的"}, {"start": 79.34, "end": 80.46, "text": "你打算怎么办"}, {"start": 80.46, "end": 81.42, "text": "不怎么办"}, {"start": 81.42, "end": 82.06, "text": "他是我大哥"}, {"start": 82.06, "end": 82.94, "text": "我能怎么办"}, {"start": 82.94, "end": 88.58, "text": "我"}, {"start": 88.58, "end": 90.34, "text": "叶广想杀叶玄"}, {"start": 92.3, "end": 93.18, "text": "好"}, {"start": 93.18, "end": 94.46, "text": "很好"}, {"start": 94.46, "end": 96.58, "text": "一个不团结的镇南王府"}, {"start": 96.58, "end": 98.3, "text": "才是我所需要的"}, {"start": 98.3, "end": 100.1, "text": "叶玄越是被排挤"}, {"start": 100.1, "end": 101.78, "text": "就越会倒向自己"}]}