{"file": "凡人百世书-第11集.mp4", "ep": 11, "duration": 102.3, "segments": [{"start": 0.05, "end": 1.85, "text": "掌门要过九十寿探了"}, {"start": 2.25, "end": 4.17, "text": "皆是会宴请天下豪杰"}, {"start": 4.41, "end": 5.57, "text": "各派都会来人"}, {"start": 6.37, "end": 7.53, "text": "也会在宴会上"}, {"start": 7.69, "end": 9.45, "text": "确认下一任掌门人选"}, {"start": 10.89, "end": 12.21, "text": "李墨 你说说"}, {"start": 12.45, "end": 13.33, "text": "这事怎么看"}, {"start": 13.57, "end": 14.53, "text": "弟子斗胆说一句"}, {"start": 15.01, "end": 16.69, "text": "掌门之位有得者居职"}, {"start": 16.69, "end": 17.81, "text": "晚儿师姐的天赋"}, {"start": 17.81, "end": 18.77, "text": "放炎整个宗门"}, {"start": 18.77, "end": 19.53, "text": "无人能解"}, {"start": 19.69, "end": 20.45, "text": "若是掌门"}, {"start": 20.57, "end": 21.77, "text": "执意传位给侯师兄"}, {"start": 21.85, "end": 22.73, "text": "只怕难以服众"}, {"start": 22.73, "end": 23.77, "text": "你的意思是"}, {"start": 23.89, "end": 25.49, "text": "若是掌门宣布的是晚儿师姐"}, {"start": 25.61, "end": 26.49, "text": "那就皆大欢喜"}, {"start": 26.49, "end": 27.21, "text": "如果不是"}, {"start": 27.53, "end": 28.65, "text": "那就抢先动手"}, {"start": 28.65, "end": 29.69, "text": "你先下去吧"}, {"start": 30.17, "end": 31.49, "text": "大长老还在举其不定"}, {"start": 31.93, "end": 33.21, "text": "那就由我来添一把火"}, {"start": 33.21, "end": 34.13, "text": "让紫衣门乱起来"}, {"start": 34.13, "end": 34.85, "text": "诸位弟兄"}, {"start": 35.25, "end": 35.81, "text": "今晚"}, {"start": 36.01, "end": 37.69, "text": "我将带你们去搏一场大富贵"}, {"start": 37.85, "end": 38.65, "text": "可愿同去"}, {"start": 39.01, "end": 40.21, "text": "无所愿意"}, {"start": 40.37, "end": 40.89, "text": "无等"}, {"start": 41.17, "end": 42.45, "text": "愿为师姐扫清障碍"}, {"start": 42.57, "end": 43.69, "text": "请大长老早做决断"}, {"start": 43.69, "end": 44.37, "text": "这些年"}, {"start": 44.45, "end": 45.73, "text": "林墨替我办了很多事"}, {"start": 45.73, "end": 46.49, "text": "我一直以为"}, {"start": 46.49, "end": 47.53, "text": "他只是为了往上爬"}, {"start": 47.53, "end": 48.61, "text": "为了资源为了利益"}, {"start": 48.61, "end": 49.29, "text": "可现在"}, {"start": 49.29, "end": 50.81, "text": "他带着二十多号人跪在这儿"}, {"start": 50.81, "end": 52.01, "text": "说愿意为我去死"}, {"start": 52.41, "end": 52.97, "text": "林墨"}, {"start": 53.37, "end": 54.17, "text": "你想好了"}, {"start": 56.05, "end": 56.97, "text": "弟子想好了"}, {"start": 58.94, "end": 59.42, "text": "好"}, {"start": 59.58, "end": 60.66, "text": "若大事可成"}, {"start": 60.74, "end": 62.22, "text": "我定然不会亏待你的"}, {"start": 62.34, "end": 62.9, "text": "师父"}, {"start": 63.1, "end": 63.54, "text": "请您承受"}, {"start": 63.54, "end": 64.9, "text": "我儿子我一手带大的"}, {"start": 65.02, "end": 66.66, "text": "二十四岁的小后天"}, {"start": 66.74, "end": 68.02, "text": "紫衣本利派机以来"}, {"start": 68.02, "end": 68.9, "text": "从未有过"}, {"start": 69.06, "end": 70.5, "text": "未来的先天强者"}, {"start": 70.5, "end": 71.74, "text": "甚至可能更高"}, {"start": 72.02, "end": 73.66, "text": "侯芳杰凭什么跟他争"}, {"start": 73.66, "end": 74.58, "text": "掌门之位"}, {"start": 74.7, "end": 75.9, "text": "有得者居日"}, {"start": 76.34, "end": 77.34, "text": "他徒儿做的"}, {"start": 77.66, "end": 79.06, "text": "我徒儿怎么做不得"}, {"start": 80.03, "end": 80.59, "text": "林墨"}, {"start": 80.75, "end": 81.99, "text": "这些年你做的事"}, {"start": 82.11, "end": 83.15, "text": "我都看在眼里"}, {"start": 83.67, "end": 84.63, "text": "以后有什么事"}, {"start": 84.71, "end": 85.71, "text": "你放手去做"}, {"start": 85.91, "end": 86.95, "text": "需要什么资源"}, {"start": 86.95, "end": 87.83, "text": "直接开口"}, {"start": 87.95, "end": 88.95, "text": "若是成了"}, {"start": 89.15, "end": 90.63, "text": "不会亏待你"}, {"start": 91.31, "end": 92.11, "text": "谢大长老"}, {"start": 92.78, "end": 94.26, "text": "大长老也是有私心的"}, {"start": 94.66, "end": 95.58, "text": "若是事成"}, {"start": 95.58, "end": 96.98, "text": "他会先过一把掌门的影"}, {"start": 96.98, "end": 97.98, "text": "再传给林婉儿"}, {"start": 97.98, "end": 98.98, "text": "凝历双收"}, {"start": 98.98, "end": 99.78, "text": "好的狠"}, {"start": 100.31, "end": 101.27, "text": "各怀心思"}, {"start": 101.27, "end": 102.27, "text": "这样最好"}]}