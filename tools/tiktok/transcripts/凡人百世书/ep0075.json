{"file": "凡人百世书-第75集.mp4", "ep": 75, "duration": 93.9, "segments": [{"start": 0.0, "end": 0.72, "text": "王藤"}, {"start": 1.12, "end": 3.28, "text": "你踩着燕门将士的尸骨"}, {"start": 3.28, "end": 5.72, "text": "爬上了天下兵马大元帅的位置"}, {"start": 5.72, "end": 7.28, "text": "今天该还了"}, {"start": 7.28, "end": 8.32, "text": "老匹夫"}, {"start": 8.32, "end": 9.84, "text": "你以为你能杀我"}, {"start": 16.74, "end": 19.42, "text": "这一枪是替非将军还的"}, {"start": 20.68, "end": 21.48, "text": "兄弟们"}, {"start": 21.84, "end": 23.0, "text": "再讨完了"}, {"start": 25.2, "end": 25.76, "text": "将军"}, {"start": 26.12, "end": 26.8, "text": "将军"}, {"start": 30.91, "end": 33.55, "text": "该去见二位非将军了"}, {"start": 45.18, "end": 45.78, "text": "元帅"}, {"start": 46.18, "end": 46.98, "text": "这是死路"}, {"start": 47.38, "end": 48.46, "text": "咱们是不是走错了"}, {"start": 50.36, "end": 50.96, "text": "没错"}, {"start": 51.0, "end": 52.4, "text": "我是讨债的恶鬼"}, {"start": 53.14, "end": 54.42, "text": "不需要你们保护"}, {"start": 61.88, "end": 62.36, "text": "走"}, {"start": 67.54, "end": 68.14, "text": "父亲"}, {"start": 68.46, "end": 69.14, "text": "祖父"}, {"start": 69.66, "end": 70.5, "text": "玄儿"}, {"start": 71.16, "end": 72.6, "text": "父以你为王"}, {"start": 72.88, "end": 74.44, "text": "这天下之主"}, {"start": 74.92, "end": 75.52, "text": "我看"}, {"start": 76.53, "end": 77.69, "text": "儿臣是来告别的"}, {"start": 78.09, "end": 78.85, "text": "孩儿致不在此"}, {"start": 78.85, "end": 79.45, "text": "玄儿"}, {"start": 79.45, "end": 81.33, "text": "这阵南王之位本就是你的"}, {"start": 81.33, "end": 82.13, "text": "你若想要"}, {"start": 82.13, "end": 83.33, "text": "随时可以拿回去"}, {"start": 83.33, "end": 83.85, "text": "父亲"}, {"start": 84.21, "end": 85.21, "text": "儿臣想要的"}, {"start": 85.21, "end": 86.37, "text": "从来不是这样"}, {"start": 87.03, "end": 88.15, "text": "我所做的一切"}, {"start": 88.47, "end": 90.19, "text": "只是为了给自己一个交代"}, {"start": 90.77, "end": 92.21, "text": "也是为己事的恩怨"}, {"start": 92.63, "end": 93.91, "text": "大上一个句号"}]}