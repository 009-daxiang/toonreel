{"file": "凡人百世书-第55集.mp4", "ep": 55, "duration": 61.1, "segments": [{"start": 0.0, "end": 1.6, "text": "宿主第四世结束"}, {"start": 2.67, "end": 4.47, "text": "这一世你打虎成名"}, {"start": 4.47, "end": 5.83, "text": "得礼龙城赏食"}, {"start": 5.83, "end": 6.95, "text": "献孙子兵法"}, {"start": 6.95, "end": 7.87, "text": "大破胡人"}, {"start": 7.87, "end": 8.87, "text": "封游击将军"}, {"start": 8.87, "end": 9.87, "text": "狂黄宫禁地"}, {"start": 9.87, "end": 10.95, "text": "斩胡人大帅"}, {"start": 10.95, "end": 12.87, "text": "天下皆知非将军之名"}, {"start": 12.87, "end": 15.07, "text": "最后被太后刺毒酒而死"}, {"start": 15.07, "end": 15.63, "text": "停驾"}, {"start": 15.63, "end": 16.51, "text": "白银三星"}, {"start": 16.51, "end": 17.03, "text": "积分"}, {"start": 17.03, "end": 17.67, "text": "三千"}, {"start": 17.67, "end": 18.91, "text": "你终于知道了真相"}, {"start": 18.91, "end": 20.67, "text": "仇恨的源头原来是一个女人"}, {"start": 20.67, "end": 21.35, "text": "可笑吗"}, {"start": 21.35, "end": 22.11, "text": "可悲吗"}, {"start": 22.11, "end": 22.75, "text": "下一世"}, {"start": 22.75, "end": 23.67, "text": "你要怎么选"}, {"start": 23.67, "end": 24.83, "text": "怎么选"}, {"start": 24.83, "end": 25.83, "text": "当然是"}, {"start": 25.83, "end": 26.35, "text": "杀"}, {"start": 26.35, "end": 27.35, "text": "积分突破一千"}, {"start": 28.15, "end": 30.47, "text": "特殊非人血脉五千点觉醒"}, {"start": 30.59, "end": 32.79, "text": "典术消耗既成前世修为"}, {"start": 32.79, "end": 34.43, "text": "我要想覆灭太后"}, {"start": 34.43, "end": 36.39, "text": "甚至对抗苍兰皇室"}, {"start": 36.39, "end": 41.34, "text": "得解一个人"}, {"start": 41.34, "end": 44.26, "text": "可以和皇室抗衡"}, {"start": 44.26, "end": 45.3, "text": "孙子"}, {"start": 45.3, "end": 47.1, "text": "世家血脉加一千点"}, {"start": 47.1, "end": 48.34, "text": "物性和滋质"}, {"start": 48.34, "end": 50.87, "text": "各加一千点"}, {"start": 50.87, "end": 52.11, "text": "家典完成"}, {"start": 52.11, "end": 53.95, "text": "第五世即将开启"}, {"start": 53.95, "end": 56.84, "text": "祝宿主好运"}, {"start": 56.84, "end": 60.72, "text": "官子嫌好脖子等着"}]}