{"file": "凡人百世书-第64集.mp4", "ep": 64, "duration": 89.2, "segments": [{"start": 0.34, "end": 1.74, "text": "关姑娘武功高强"}, {"start": 2.14, "end": 3.06, "text": "在下认输"}, {"start": 3.68, "end": 4.72, "text": "关山越赢了"}, {"start": 4.72, "end": 6.16, "text": "草郎第一天才是关"}, {"start": 6.45, "end": 8.37, "text": "太后的娘家果然名不虚传"}, {"start": 8.69, "end": 9.49, "text": "我赢了"}, {"start": 9.61, "end": 10.73, "text": "总觉得哪里不对"}, {"start": 11.05, "end": 12.65, "text": "她像是在故意让我打中的"}, {"start": 13.88, "end": 14.48, "text": "叶玄"}, {"start": 14.68, "end": 15.76, "text": "你好生加油"}, {"start": 15.92, "end": 17.24, "text": "下次一定要胜过月儿"}, {"start": 17.24, "end": 18.08, "text": "把她娶了"}, {"start": 18.36, "end": 19.08, "text": "太后"}, {"start": 19.52, "end": 21.12, "text": "孙儿现在不想嫁人"}, {"start": 22.7, "end": 23.34, "text": "罢了"}, {"start": 23.54, "end": 24.46, "text": "你们还小"}, {"start": 27.79, "end": 28.87, "text": "关姑娘求见"}, {"start": 29.11, "end": 30.15, "text": "这大晚上的"}, {"start": 30.43, "end": 31.31, "text": "她来干什么"}, {"start": 31.84, "end": 32.6, "text": "让她进来"}, {"start": 33.44, "end": 34.52, "text": "你今天让我的"}, {"start": 34.76, "end": 35.76, "text": "关姑娘说笑了"}, {"start": 36.12, "end": 37.32, "text": "是在下既不如人"}, {"start": 37.48, "end": 38.48, "text": "输得心腹口福"}, {"start": 38.72, "end": 39.8, "text": "我练武十年"}, {"start": 40.0, "end": 41.84, "text": "对昭氏的敏感超过任何人"}, {"start": 42.04, "end": 42.92, "text": "你那个破绽"}, {"start": 43.08, "end": 44.24, "text": "分明是故意卖你"}, {"start": 44.6, "end": 45.32, "text": "下次"}, {"start": 45.56, "end": 46.76, "text": "我要你出权力"}, {"start": 49.41, "end": 50.89, "text": "我不会因为你是男子"}, {"start": 51.21, "end": 52.01, "text": "就让着你"}, {"start": 52.37, "end": 53.93, "text": "你也不许因为我是女子"}, {"start": 54.13, "end": 54.93, "text": "就让着我"}, {"start": 55.7, "end": 56.3, "text": "叶玄"}, {"start": 57.75, "end": 59.23, "text": "今天你必须出权力"}, {"start": 59.47, "end": 62.76, "text": "这不是看不起我"}, {"start": 62.96, "end": 63.96, "text": "每次都故意输"}, {"start": 64.08, "end": 65.0, "text": "你到底打不打"}, {"start": 65.28, "end": 66.56, "text": "再这样我真生气了"}, {"start": 66.8, "end": 71.65, "text": "挺好看的啊"}, {"start": 71.77, "end": 72.85, "text": "怎么这个叶玄"}, {"start": 72.85, "end": 74.17, "text": "就是不肯认真跟我打"}, {"start": 74.17, "end": 74.73, "text": "叶玄"}, {"start": 74.85, "end": 75.65, "text": "我要挑战你"}, {"start": 75.65, "end": 76.61, "text": "是"}, {"start": 76.61, "end": 77.21, "text": "出来打一场"}, {"start": 77.21, "end": 78.97, "text": "关姑娘凭什么天天找你"}, {"start": 80.34, "end": 80.9, "text": "叶玄"}, {"start": 81.06, "end": 81.86, "text": "我要挑战你"}, {"start": 81.86, "end": 82.62, "text": "叶玄"}]}