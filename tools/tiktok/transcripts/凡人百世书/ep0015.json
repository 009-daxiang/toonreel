{"file": "凡人百世书-第15集.mp4", "ep": 15, "duration": 105.3, "segments": [{"start": 17.9, "end": 18.82, "text": "本就如此"}, {"start": 40.75, "end": 44.86, "text": "回来了"}, {"start": 47.62, "end": 48.06, "text": "爹"}, {"start": 50.32, "end": 51.28, "text": "你肯定饿了吧"}, {"start": 51.48, "end": 52.04, "text": "快吃"}, {"start": 53.9, "end": 54.38, "text": "哥"}, {"start": 54.54, "end": 56.34, "text": "你说等桃树开花就回来看我"}, {"start": 56.5, "end": 58.3, "text": "桃树年年开花你一直没回来"}, {"start": 58.5, "end": 59.74, "text": "我还以为你骗我呢"}, {"start": 60.22, "end": 61.06, "text": "没骗你"}, {"start": 61.06, "end": 62.62, "text": "就是有点忙"}, {"start": 63.1, "end": 67.55, "text": "哥哥这次回来"}, {"start": 67.79, "end": 69.59, "text": "好像不打算走了"}, {"start": 75.26, "end": 75.78, "text": "哥"}, {"start": 75.9, "end": 78.48, "text": "是不是有什么事"}, {"start": 78.96, "end": 79.56, "text": "没事"}, {"start": 79.84, "end": 91.29, "text": "找到了吗"}, {"start": 91.77, "end": 92.65, "text": "病太上长老"}, {"start": 92.89, "end": 94.17, "text": "黎墨提前转移了家人"}, {"start": 94.17, "end": 94.89, "text": "踪迹全屋"}, {"start": 94.89, "end": 95.93, "text": "斩草除根"}, {"start": 95.93, "end": 96.65, "text": "继续查"}, {"start": 96.77, "end": 97.41, "text": "黎墨呢"}, {"start": 97.41, "end": 98.17, "text": "还在追查"}, {"start": 98.17, "end": 98.85, "text": "暂时没有消息"}, {"start": 98.85, "end": 99.25, "text": "去查"}, {"start": 99.25, "end": 99.69, "text": "是"}, {"start": 100.45, "end": 102.29, "text": "二十五岁的大后天"}, {"start": 102.29, "end": 104.85, "text": "这丫头比我想象的还能跑"}]}