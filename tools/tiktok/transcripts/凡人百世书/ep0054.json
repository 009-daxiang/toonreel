{"file": "凡人百世书-第54集.mp4", "ep": 54, "duration": 80.2, "segments": [{"start": 0.05, "end": 0.93, "text": "关子萱"}, {"start": 1.09, "end": 1.85, "text": "小花"}, {"start": 2.05, "end": 3.49, "text": "当年那个被土匪惦屋"}, {"start": 3.49, "end": 5.21, "text": "而被陈家村救助的女孩"}, {"start": 5.21, "end": 6.69, "text": "是关佩德的女孩"}, {"start": 7.13, "end": 8.29, "text": "原来如此"}, {"start": 8.29, "end": 9.89, "text": "原来如此啊"}, {"start": 11.25, "end": 13.05, "text": "我竟然为这幕后真凶"}, {"start": 13.05, "end": 15.05, "text": "守了一辈子江山"}, {"start": 15.37, "end": 16.41, "text": "陈老将军"}, {"start": 16.77, "end": 17.77, "text": "你笑什么"}, {"start": 18.4, "end": 19.28, "text": "没什么"}, {"start": 21.46, "end": 23.42, "text": "我一定会回来的"}, {"start": 32.56, "end": 33.44, "text": "后葬"}, {"start": 33.72, "end": 35.04, "text": "以国公之礼"}, {"start": 36.11, "end": 37.91, "text": "真是不值啊"}, {"start": 38.31, "end": 40.79, "text": "陈家村的那些老老少少"}, {"start": 40.79, "end": 42.55, "text": "我第一世的爹娘"}, {"start": 42.55, "end": 43.91, "text": "他们救了一个人"}, {"start": 43.91, "end": 45.91, "text": "把他当成亲人一样照顾"}, {"start": 45.91, "end": 46.83, "text": "结果呢"}, {"start": 46.83, "end": 48.07, "text": "本来的是灭门之患"}, {"start": 48.07, "end": 49.07, "text": "一百多条人命"}, {"start": 49.07, "end": 50.11, "text": "就为了守一个秘密"}, {"start": 50.11, "end": 50.71, "text": "而我"}, {"start": 50.71, "end": 52.27, "text": "竟然为这样一个蛇蝎美人"}, {"start": 52.27, "end": 53.55, "text": "守了一辈子的江山"}, {"start": 53.55, "end": 54.71, "text": "大胡人保边境"}, {"start": 54.71, "end": 55.87, "text": "让关口顾若金汤"}, {"start": 55.87, "end": 56.91, "text": "护的是他的江山"}, {"start": 56.91, "end": 57.75, "text": "他坐在皇宫里"}, {"start": 57.75, "end": 58.75, "text": "想扶我在边关"}, {"start": 58.75, "end": 59.63, "text": "拼死拼活"}, {"start": 59.63, "end": 61.03, "text": "最后他却一杯酒"}, {"start": 61.03, "end": 62.03, "text": "把我毒死"}, {"start": 62.03, "end": 63.27, "text": "我把他打死"}, {"start": 63.27, "end": 64.35, "text": "最后他却一杯酒"}, {"start": 64.35, "end": 65.23, "text": "把我毒死"}, {"start": 65.23, "end": 65.95, "text": "好"}, {"start": 65.95, "end": 66.99, "text": "很好"}, {"start": 66.99, "end": 67.95, "text": "下一世"}, {"start": 67.95, "end": 69.15, "text": "我什么都不要"}, {"start": 69.15, "end": 70.67, "text": "我只要他死"}, {"start": 70.67, "end": 72.15, "text": "所有跟他有关的人"}, {"start": 72.15, "end": 73.31, "text": "一个不留"}, {"start": 73.31, "end": 74.67, "text": "苍兰皇室敢拦我"}, {"start": 74.67, "end": 76.43, "text": "我就把皇室也杀光"}, {"start": 76.43, "end": 78.31, "text": "他可击拳不留"}, {"start": 79.3, "end": 80.38, "text": "开始结算吧"}]}