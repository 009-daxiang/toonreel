{"file": "凡人百世书-第37集.mp4", "ep": 37, "duration": 95.6, "segments": [{"start": 0.0, "end": 1.16, "text": "在下燕门关手将"}, {"start": 1.16, "end": 2.68, "text": "仗下征兵官 姓赵"}, {"start": 2.88, "end": 4.24, "text": "听说你打死了蒙虎"}, {"start": 4.24, "end": 4.92, "text": "特来看看"}, {"start": 4.92, "end": 6.12, "text": "燕门关手将"}, {"start": 6.28, "end": 7.92, "text": "那可是这一代最大的官"}, {"start": 12.19, "end": 12.99, "text": "年轻人"}, {"start": 12.99, "end": 13.79, "text": "有没有兴趣"}, {"start": 13.79, "end": 15.31, "text": "成为将军仗下的前兵"}, {"start": 15.31, "end": 15.83, "text": "大人"}, {"start": 15.83, "end": 16.87, "text": "能否容我两个月"}, {"start": 17.66, "end": 18.22, "text": "为何"}, {"start": 18.54, "end": 19.82, "text": "我想将家中安顿好"}, {"start": 19.98, "end": 21.46, "text": "再全心全意为大人效力"}, {"start": 22.42, "end": 22.94, "text": "好"}, {"start": 23.14, "end": 24.7, "text": "那两个月后我再来"}, {"start": 24.98, "end": 25.88, "text": "两个月"}, {"start": 26.16, "end": 27.36, "text": "足够我突破了"}, {"start": 33.3, "end": 34.7, "text": "这就是第一雄官"}, {"start": 35.18, "end": 36.54, "text": "陈破空跟我来"}, {"start": 41.44, "end": 42.32, "text": "以后你住这儿"}, {"start": 42.32, "end": 43.6, "text": "跟兄弟们熟悉熟悉"}, {"start": 43.76, "end": 44.72, "text": "明天开始训练"}, {"start": 46.44, "end": 47.12, "text": "新来的"}, {"start": 47.68, "end": 48.32, "text": "陈破龙"}, {"start": 48.64, "end": 49.4, "text": "请多关照"}, {"start": 52.1, "end": 53.22, "text": "打虎英雄"}, {"start": 53.78, "end": 54.7, "text": "听说你一个人"}, {"start": 54.7, "end": 56.06, "text": "打死了一头老虎"}, {"start": 56.5, "end": 57.1, "text": "一笑"}, {"start": 57.46, "end": 59.1, "text": "打老虎和打仗可不一样"}, {"start": 59.26, "end": 59.66, "text": "来"}, {"start": 59.86, "end": 61.34, "text": "让兄弟们看看你的本事"}, {"start": 62.67, "end": 63.75, "text": "血连七杀"}, {"start": 63.95, "end": 64.59, "text": "第一刀"}, {"start": 64.79, "end": 65.59, "text": "连开"}, {"start": 66.23, "end": 67.27, "text": "你这刀法哪儿学的"}, {"start": 67.27, "end": 68.03, "text": "教教我们"}, {"start": 68.31, "end": 68.91, "text": "陈破雄"}, {"start": 69.03, "end": 70.03, "text": "周统领教你过去"}, {"start": 71.05, "end": 72.93, "text": "昨天那一刀我听说了"}, {"start": 73.37, "end": 74.37, "text": "你这刀法"}, {"start": 74.73, "end": 76.01, "text": "江湖上学的"}, {"start": 77.06, "end": 77.98, "text": "好刀法"}, {"start": 78.5, "end": 79.1, "text": "但是"}, {"start": 79.46, "end": 80.94, "text": "你知道江湖博杀"}, {"start": 80.94, "end": 82.06, "text": "和战场厮杀"}, {"start": 82.26, "end": 83.18, "text": "有什么区别吗"}, {"start": 83.18, "end": 83.82, "text": "战场上"}, {"start": 84.1, "end": 84.78, "text": "你面对的是"}, {"start": 84.78, "end": 86.06, "text": "成百上千的敌人"}, {"start": 86.5, "end": 88.14, "text": "没有时间让你耍花招呼"}, {"start": 88.72, "end": 89.6, "text": "你那一刀"}, {"start": 89.72, "end": 90.76, "text": "杀人没问题"}, {"start": 91.08, "end": 92.12, "text": "要是上了战场"}, {"start": 92.44, "end": 93.44, "text": "补出半个时辰"}, {"start": 93.44, "end": 94.76, "text": "你就会被人捅成筛子"}]}