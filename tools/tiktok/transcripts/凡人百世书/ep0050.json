{"file": "凡人百世书-第50集.mp4", "ep": 50, "duration": 103.7, "segments": [{"start": 1.84, "end": 3.04, "text": "他被仙人接走了"}, {"start": 4.39, "end": 5.51, "text": "我就知道"}, {"start": 5.75, "end": 6.87, "text": "我就知道"}, {"start": 7.19, "end": 8.91, "text": "我儿子是有福气的"}, {"start": 8.91, "end": 10.23, "text": "坏说死了我不信"}, {"start": 10.43, "end": 11.91, "text": "我要见人死要见事"}, {"start": 11.91, "end": 12.83, "text": "我会找到他的"}, {"start": 13.15, "end": 13.95, "text": "不管多久"}, {"start": 14.27, "end": 14.95, "text": "不管多运"}, {"start": 14.95, "end": 15.51, "text": "将军"}, {"start": 16.1, "end": 16.86, "text": "我回来了"}, {"start": 19.9, "end": 20.7, "text": "我来晚了"}, {"start": 22.19, "end": 22.87, "text": "您放心"}, {"start": 23.39, "end": 23.95, "text": "关口"}, {"start": 24.23, "end": 24.91, "text": "我守着"}, {"start": 25.15, "end": 29.7, "text": "时辰不捧"}, {"start": 29.9, "end": 30.66, "text": "他回来了"}, {"start": 30.9, "end": 32.06, "text": "杀身回来了"}, {"start": 32.06, "end": 33.66, "text": "要送陈将军回来了"}, {"start": 36.81, "end": 38.25, "text": "非将军没有死"}, {"start": 38.77, "end": 40.49, "text": "非将军永远活着"}, {"start": 40.73, "end": 41.53, "text": "杀"}, {"start": 41.53, "end": 46.1, "text": "是开始"}, {"start": 53.05, "end": 54.25, "text": "定国功夫"}, {"start": 54.71, "end": 55.55, "text": "王堂"}, {"start": 57.67, "end": 61.95, "text": "不会吧"}, {"start": 61.95, "end": 63.47, "text": "真是冤家路窄啊"}, {"start": 64.17, "end": 65.01, "text": "陈将军"}, {"start": 65.21, "end": 66.21, "text": "好久不见"}, {"start": 66.61, "end": 67.77, "text": "侯爷别来无恙"}, {"start": 68.97, "end": 70.21, "text": "你现在什么修为"}, {"start": 71.13, "end": 71.89, "text": "仙天"}, {"start": 76.19, "end": 77.79, "text": "我这些年拼命苦修"}, {"start": 77.79, "end": 79.19, "text": "如今是大前天"}, {"start": 79.31, "end": 80.43, "text": "原以为初彩"}, {"start": 80.43, "end": 82.07, "text": "十年前你一招败我"}, {"start": 82.07, "end": 83.91, "text": "十年后你已经是仙天"}, {"start": 84.07, "end": 84.83, "text": "而我"}, {"start": 84.95, "end": 86.63, "text": "连你的背影都看不到"}, {"start": 86.95, "end": 87.67, "text": "算了"}, {"start": 88.74, "end": 90.57, "text": "现在不是虚旧的时候"}, {"start": 90.69, "end": 92.53, "text": "胡人八十万大军还在关外"}, {"start": 92.81, "end": 94.01, "text": "将军可有计策"}, {"start": 95.49, "end": 96.89, "text": "秦贼先秦王"}, {"start": 97.05, "end": 98.05, "text": "你的意思是"}, {"start": 98.41, "end": 99.77, "text": "你率三十万大军"}, {"start": 100.05, "end": 101.57, "text": "从正面全线押上"}, {"start": 101.97, "end": 103.45, "text": "吸引胡人的注意力"}]}