{"file": "凡人百世书-第41集.mp4", "ep": 41, "duration": 93.0, "segments": [{"start": 6.06, "end": 7.26, "text": "如果能融合成功"}, {"start": 7.26, "end": 8.26, "text": "产生的会是什么"}, {"start": 8.26, "end": 9.86, "text": "真气之上是真远"}, {"start": 9.86, "end": 11.06, "text": "真远之上呢"}, {"start": 11.06, "end": 13.1, "text": "难道是法力"}, {"start": 13.1, "end": 14.5, "text": "现在小孩太远了"}, {"start": 14.5, "end": 15.7, "text": "我连先天都不是"}, {"start": 15.7, "end": 16.9, "text": "想什么休息啊"}, {"start": 19.32, "end": 20.12, "text": "霍鲁"}, {"start": 20.12, "end": 21.12, "text": "墨将在"}, {"start": 21.74, "end": 23.74, "text": "老夫已经上书朝廷"}, {"start": 23.74, "end": 25.74, "text": "举荐你为游击将军"}, {"start": 26.14, "end": 28.49, "text": "这一战打好了"}, {"start": 29.05, "end": 30.65, "text": "这位置就是你的"}, {"start": 30.85, "end": 33.85, "text": "谢将军栽培"}, {"start": 33.85, "end": 35.05, "text": "不是栽培"}, {"start": 35.05, "end": 36.48, "text": "是你应得的"}, {"start": 36.48, "end": 38.48, "text": "胡人这次来势凶凶"}, {"start": 38.48, "end": 40.28, "text": "怕是要打一场硬仗"}, {"start": 40.68, "end": 41.48, "text": "霍鲁吗"}, {"start": 41.48, "end": 42.28, "text": "墨将"}, {"start": 42.28, "end": 43.48, "text": "时刻准备着"}, {"start": 43.48, "end": 52.7, "text": "这一尊杀绳根本挡不住"}, {"start": 56.22, "end": 57.02, "text": "报将军"}, {"start": 57.02, "end": 57.82, "text": "此战"}, {"start": 57.82, "end": 58.82, "text": "斩敌三万"}, {"start": 58.82, "end": 60.22, "text": "缴获牛羊马匹无数"}, {"start": 60.22, "end": 61.62, "text": "胡人元气大伤"}, {"start": 61.62, "end": 63.22, "text": "二十年不敢南下"}, {"start": 63.22, "end": 63.82, "text": "霍鲁"}, {"start": 63.82, "end": 65.62, "text": "你当真不负你之名"}, {"start": 65.62, "end": 66.22, "text": "听说了吗"}, {"start": 66.22, "end": 67.22, "text": "关口打了大圣仗"}, {"start": 67.22, "end": 68.02, "text": "杀敌三万"}, {"start": 68.02, "end": 68.62, "text": "何止"}, {"start": 68.62, "end": 70.02, "text": "听说那个叫陈霍鲁的先锋"}, {"start": 70.02, "end": 71.22, "text": "一个人杀穿了敌军大营"}, {"start": 71.22, "end": 72.82, "text": "二十一岁的小后天"}, {"start": 72.82, "end": 73.82, "text": "了不得啊"}, {"start": 73.82, "end": 75.22, "text": "凡圣上口谕"}, {"start": 75.22, "end": 77.82, "text": "李仓园加封护国扫北将军"}, {"start": 77.82, "end": 79.02, "text": "赏金千两"}, {"start": 79.02, "end": 80.22, "text": "赐芒袍玉带"}, {"start": 80.22, "end": 81.62, "text": "陈破陆连升三级"}, {"start": 81.62, "end": 82.82, "text": "封游击将军"}, {"start": 82.82, "end": 84.42, "text": "兼燕灵卫统领"}, {"start": 84.42, "end": 85.22, "text": "封侯呢"}, {"start": 85.22, "end": 86.02, "text": "这么大的功劳"}, {"start": 86.02, "end": 86.82, "text": "怎么没人封侯"}, {"start": 86.82, "end": 88.02, "text": "李将军守边三十年"}, {"start": 88.02, "end": 89.02, "text": "打了多少胜仗"}, {"start": 89.02, "end": 90.02, "text": "怎么连个侯都不给"}, {"start": 90.02, "end": 91.42, "text": "听说朝廷那帮人"}, {"start": 91.42, "end": 92.82, "text": "光顾着自己亲功了"}]}