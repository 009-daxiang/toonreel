{"file": "凡人百世书-第20集.mp4", "ep": 20, "duration": 101.8, "segments": [{"start": 0.0, "end": 0.84, "text": "就比如你"}, {"start": 0.84, "end": 2.12, "text": "現在才二流巔峰"}, {"start": 2.12, "end": 3.64, "text": "即便選上也不夠格"}, {"start": 3.64, "end": 4.72, "text": "什麼時候突破後天"}, {"start": 4.72, "end": 5.56, "text": "什麼時候轉正"}, {"start": 5.56, "end": 6.88, "text": "那長老院怎麼考察"}, {"start": 6.88, "end": 7.84, "text": "總不能一個個看吧"}, {"start": 7.84, "end": 8.64, "text": "人的名"}, {"start": 8.64, "end": 9.48, "text": "數得贏"}, {"start": 9.48, "end": 11.6, "text": "真正的人才是遮不住的"}, {"start": 11.6, "end": 13.2, "text": "你想讓長老院注意到"}, {"start": 13.2, "end": 15.0, "text": "就得在江湖上闖出名堂來"}, {"start": 15.0, "end": 15.92, "text": "讓所有人都知道"}, {"start": 15.92, "end": 16.96, "text": "你林春秋的名字"}, {"start": 16.96, "end": 17.88, "text": "到時候"}, {"start": 17.88, "end": 18.8, "text": "不用你去求"}, {"start": 18.8, "end": 20.64, "text": "長老院自然會把你列為候選"}, {"start": 20.64, "end": 22.0, "text": "那圖子現在該怎麼做"}, {"start": 22.0, "end": 23.12, "text": "你先突破一流"}, {"start": 23.12, "end": 23.88, "text": "突破之後"}, {"start": 23.88, "end": 24.76, "text": "出去闖一闖"}, {"start": 24.76, "end": 25.88, "text": "把名聲打出去"}, {"start": 25.88, "end": 26.84, "text": "另外在這之前"}, {"start": 26.84, "end": 29.14, "text": "你抽空去一趟血刃堂"}, {"start": 29.14, "end": 30.06, "text": "去血刃堂"}, {"start": 30.06, "end": 31.38, "text": "去看看現任堂主"}, {"start": 31.38, "end": 33.57, "text": "以晚輩的身份探望一下"}, {"start": 33.57, "end": 35.01, "text": "你是不是覺得"}, {"start": 35.01, "end": 36.01, "text": "咱們聖教是摩門"}, {"start": 36.01, "end": 37.17, "text": "就該六親不認"}, {"start": 37.17, "end": 38.25, "text": "傻小子"}, {"start": 38.25, "end": 39.33, "text": "外面叫我們摩門"}, {"start": 39.33, "end": 41.17, "text": "你還真把自己當摩頭了"}, {"start": 41.17, "end": 43.13, "text": "就算是摩頭也得遵失重點"}, {"start": 43.13, "end": 44.13, "text": "不然把你扶持上來"}, {"start": 44.13, "end": 45.29, "text": "你反手把人家給塗了"}, {"start": 45.29, "end": 45.97, "text": "人家塗啥"}, {"start": 45.97, "end": 46.61, "text": "另外"}, {"start": 46.61, "end": 47.97, "text": "聖教為什麼被叫成摩門"}, {"start": 47.97, "end": 48.93, "text": "你知道嗎"}, {"start": 48.93, "end": 50.57, "text": "是因為跟朝廷作對"}, {"start": 50.57, "end": 52.21, "text": "咱們聖教從立教那天起"}, {"start": 52.21, "end": 53.45, "text": "就一直在造反"}, {"start": 53.45, "end": 54.85, "text": "雖然一直沒有成功"}, {"start": 54.85, "end": 55.85, "text": "但朝廷也始終不能"}, {"start": 55.85, "end": 56.97, "text": "將我們根處"}, {"start": 56.97, "end": 57.97, "text": "倘若你真的成了"}, {"start": 57.97, "end": 59.21, "text": "血刃堂主"}, {"start": 59.21, "end": 60.65, "text": "統領上萬步重"}, {"start": 60.65, "end": 61.81, "text": "就萬萬錯不得"}, {"start": 61.81, "end": 62.73, "text": "弟子明白了"}, {"start": 62.73, "end": 71.74, "text": "去吧"}, {"start": 71.74, "end": 73.38, "text": "這些人二十歲不到"}, {"start": 73.38, "end": 74.92, "text": "就已經是醫療了"}, {"start": 74.92, "end": 75.96, "text": "天下英雄"}, {"start": 75.96, "end": 78.0, "text": "當真如過江之機"}, {"start": 78.0, "end": 78.96, "text": "不過"}, {"start": 78.96, "end": 80.72, "text": "這樣才有意思"}, {"start": 80.72, "end": 82.16, "text": "太容易到手的東西"}, {"start": 82.16, "end": 83.48, "text": "反而不值得證明"}, {"start": 83.48, "end": 86.94, "text": "敢問可是林公子"}, {"start": 86.94, "end": 88.34, "text": "他也是聖教的人"}, {"start": 88.34, "end": 90.06, "text": "而且看這氣息醫療"}, {"start": 90.06, "end": 91.46, "text": "十八歲的醫療"}, {"start": 91.46, "end": 92.66, "text": "這份修煉速度"}, {"start": 92.66, "end": 94.66, "text": "比知林婉兒恐怕也不遑多讓"}, {"start": 94.66, "end": 96.98, "text": "林公子最近怎麼不來玩了"}, {"start": 97.02, "end": 99.51, "text": "樓家可是想你緊呢"}, {"start": 99.51, "end": 100.51, "text": "修煉繁忙"}, {"start": 100.51, "end": 101.51, "text": "臭不開心"}]}