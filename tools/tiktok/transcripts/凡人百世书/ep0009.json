{"file": "凡人百世书-第9集.mp4", "ep": 9, "duration": 109.6, "segments": [{"start": 8.3, "end": 9.14, "text": "这四年来"}, {"start": 9.3, "end": 10.46, "text": "我打着大长老的旗号"}, {"start": 10.46, "end": 11.58, "text": "暗中招募心腹"}, {"start": 11.58, "end": 13.46, "text": "成立暗狼组为领暖而办事"}, {"start": 13.46, "end": 14.58, "text": "在资源的堆积下"}, {"start": 14.58, "end": 15.86, "text": "我也是二流点锋"}, {"start": 15.86, "end": 17.42, "text": "距离一流仅有一线之革"}, {"start": 17.42, "end": 18.38, "text": "这一线之革"}, {"start": 18.38, "end": 20.14, "text": "却不知要何年才能突破"}, {"start": 20.54, "end": 22.3, "text": "大人"}, {"start": 22.3, "end": 23.54, "text": "无护法那边有消息了"}, {"start": 23.74, "end": 24.38, "text": "说"}, {"start": 24.38, "end": 26.34, "text": "吴天德三天前领了密令出宗"}, {"start": 26.34, "end": 27.42, "text": "刚刚收来消息"}, {"start": 27.42, "end": 29.06, "text": "他已完成任务 正往回赶"}, {"start": 29.06, "end": 29.46, "text": "不过"}, {"start": 29.46, "end": 30.22, "text": "不过什么"}, {"start": 30.22, "end": 31.14, "text": "他受了伤"}, {"start": 31.14, "end": 32.54, "text": "随行弟子死伤大半"}, {"start": 32.54, "end": 33.9, "text": "此刻身边只有三四人"}, {"start": 33.9, "end": 35.58, "text": "正从清风侠方向返回"}, {"start": 36.5, "end": 37.66, "text": "通知暗狼组"}, {"start": 37.66, "end": 38.62, "text": "全员出动"}, {"start": 38.62, "end": 39.14, "text": "是"}, {"start": 42.69, "end": 44.01, "text": "从第一事被灭门"}, {"start": 44.01, "end": 45.57, "text": "到这一时折腹九年"}, {"start": 45.57, "end": 46.57, "text": "今天"}, {"start": 46.57, "end": 47.77, "text": "该报仇了"}, {"start": 49.67, "end": 50.91, "text": "还有多久到宗门"}, {"start": 50.91, "end": 51.67, "text": "护法"}, {"start": 51.67, "end": 52.43, "text": "过了这峡谷"}, {"start": 52.43, "end": 53.71, "text": "再有半个时辰就到了"}, {"start": 53.71, "end": 59.68, "text": "我对劲"}, {"start": 60.06, "end": 61.14, "text": "太安静了"}, {"start": 61.34, "end": 62.7, "text": "崇明升怎么停了"}, {"start": 63.47, "end": 64.39, "text": "快停下"}, {"start": 64.71, "end": 80.39, "text": "谁"}, {"start": 80.71, "end": 82.43, "text": "谁他们敢埋伏老子"}, {"start": 82.67, "end": 84.44, "text": "知不知道我是谁"}, {"start": 84.44, "end": 86.04, "text": "紫衣门内门护法"}, {"start": 86.04, "end": 87.36, "text": "你们活腻了"}, {"start": 87.48, "end": 91.9, "text": "是谁"}, {"start": 92.06, "end": 96.09, "text": "是狂狼"}, {"start": 96.09, "end": 96.77, "text": "林沫"}, {"start": 97.45, "end": 98.09, "text": "林沫"}, {"start": 98.21, "end": 99.01, "text": "你疯了"}, {"start": 99.01, "end": 99.73, "text": "同门相残"}, {"start": 99.73, "end": 101.17, "text": "你知不知道这是死罪"}, {"start": 101.17, "end": 102.45, "text": "同门相残"}, {"start": 102.69, "end": 103.97, "text": "只要杀得干净"}, {"start": 103.97, "end": 105.13, "text": "谁能知道"}, {"start": 106.69, "end": 107.93, "text": "你为什么要杀我"}, {"start": 107.93, "end": 109.69, "text": "我跟你无怨无仇"}]}