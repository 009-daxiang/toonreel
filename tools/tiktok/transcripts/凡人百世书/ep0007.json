{"file": "凡人百世书-第7集.mp4", "ep": 7, "duration": 107.5, "segments": [{"start": 0.69, "end": 1.21, "text": "林沫"}, {"start": 1.45, "end": 1.97, "text": "是"}, {"start": 2.45, "end": 3.37, "text": "跟我走一趟"}, {"start": 3.73, "end": 4.85, "text": "林师姐要见你"}, {"start": 5.13, "end": 6.05, "text": "林师姐"}, {"start": 6.62, "end": 7.46, "text": "林婉儿"}, {"start": 12.01, "end": 12.97, "text": "见过林师姐"}, {"start": 14.67, "end": 15.35, "text": "过来坐"}, {"start": 18.59, "end": 20.23, "text": "一年就突破三流了"}, {"start": 21.0, "end": 21.6, "text": "不错"}, {"start": 23.15, "end": 24.79, "text": "跟师姐比差远了"}, {"start": 26.76, "end": 27.88, "text": "咱们是一个村的"}, {"start": 28.0, "end": 29.4, "text": "说起来也算是同乡"}, {"start": 29.8, "end": 31.04, "text": "以前在村里的时候"}, {"start": 31.04, "end": 32.04, "text": "我见过你几次"}, {"start": 33.05, "end": 34.21, "text": "师姐记性好"}, {"start": 34.69, "end": 35.97, "text": "现在我进了内门"}, {"start": 36.05, "end": 37.37, "text": "拜在大掌老门下"}, {"start": 37.85, "end": 39.41, "text": "你在外门也混得不错"}, {"start": 40.69, "end": 41.89, "text": "以后有什么打算"}, {"start": 42.25, "end": 44.13, "text": "这是想收编我"}, {"start": 44.33, "end": 45.45, "text": "能有什么打算"}, {"start": 45.77, "end": 47.77, "text": "好好练功争取进内门呗"}, {"start": 48.33, "end": 49.53, "text": "进内门之后呢"}, {"start": 50.31, "end": 51.31, "text": "之后"}, {"start": 52.09, "end": 53.13, "text": "还没想那么远"}, {"start": 53.25, "end": 54.37, "text": "你倒是时成"}, {"start": 54.73, "end": 56.01, "text": "这是一瓶聚气单"}, {"start": 56.21, "end": 57.49, "text": "对三流舞者有好处"}, {"start": 57.65, "end": 59.09, "text": "你拿回去好好练功"}, {"start": 59.25, "end": 61.17, "text": "三年后外门有一场大笔"}, {"start": 61.33, "end": 62.61, "text": "前三名可以进内门"}, {"start": 62.85, "end": 64.21, "text": "我希望你能进前三"}, {"start": 64.53, "end": 65.13, "text": "好"}, {"start": 65.61, "end": 67.01, "text": "我入了大掌老门下"}, {"start": 67.41, "end": 69.53, "text": "以后在内门也需要一些人手"}, {"start": 69.85, "end": 70.81, "text": "你是我同乡"}, {"start": 71.05, "end": 72.17, "text": "你若能进内门"}, {"start": 72.25, "end": 73.05, "text": "以后跟着我"}, {"start": 73.33, "end": 74.49, "text": "少不了你的好处"}, {"start": 74.81, "end": 75.77, "text": "多谢师姐抬举"}, {"start": 75.97, "end": 77.05, "text": "以后但有差钱"}, {"start": 77.57, "end": 78.53, "text": "回去练功吧"}, {"start": 78.97, "end": 81.05, "text": "三年后等你的好消息"}, {"start": 82.87, "end": 83.67, "text": "临死前"}, {"start": 83.99, "end": 85.31, "text": "看到的最后一张脸"}, {"start": 85.59, "end": 86.75, "text": "就是这张脸"}, {"start": 92.41, "end": 93.61, "text": "实力二流顶尖"}, {"start": 93.97, "end": 94.89, "text": "而我才三流"}, {"start": 94.97, "end": 96.08, "text": "差得太远了"}, {"start": 96.44, "end": 97.68, "text": "我还需要继续折腹"}, {"start": 98.84, "end": 100.2, "text": "只有三天时间了"}, {"start": 100.6, "end": 101.28, "text": "骗了"}]}