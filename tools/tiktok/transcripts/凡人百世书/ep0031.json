{"file": "凡人百世书-第31集.mp4", "ep": 31, "duration": 92.9, "segments": [{"start": 20.87, "end": 21.91, "text": "一百年前"}, {"start": 22.34, "end": 24.02, "text": "陈家村你还记得吗"}, {"start": 24.58, "end": 25.66, "text": "陈家村"}, {"start": 26.06, "end": 28.26, "text": "你是说那个小村子"}, {"start": 28.42, "end": 29.3, "text": "为什么"}, {"start": 29.58, "end": 30.9, "text": "为什么要吐村"}, {"start": 34.28, "end": 36.2, "text": "因为有人要我们这么做"}, {"start": 36.48, "end": 37.2, "text": "谁"}, {"start": 37.4, "end": 39.51, "text": "都是报应啊"}, {"start": 41.18, "end": 42.9, "text": "听信了那位贵人的话"}, {"start": 43.02, "end": 44.14, "text": "否则紫衣门"}, {"start": 44.14, "end": 45.9, "text": "即便不能大富大贵"}, {"start": 46.06, "end": 47.86, "text": "也能平安传承下去"}, {"start": 49.24, "end": 49.92, "text": "朝廷"}, {"start": 50.16, "end": 51.12, "text": "朝廷的军队"}, {"start": 51.24, "end": 52.12, "text": "他们怎么会来"}, {"start": 52.24, "end": 53.56, "text": "是来救紫衣门的"}, {"start": 53.92, "end": 54.64, "text": "他们"}, {"start": 54.96, "end": 55.92, "text": "怕也没用"}, {"start": 56.24, "end": 57.52, "text": "他们来了那就打"}, {"start": 57.64, "end": 58.88, "text": "趋趋朝廷走狗"}, {"start": 59.0, "end": 60.52, "text": "我圣教什么时候怕过"}, {"start": 60.92, "end": 73.85, "text": "都会圣教"}, {"start": 82.62, "end": 83.86, "text": "土儿快走"}]}