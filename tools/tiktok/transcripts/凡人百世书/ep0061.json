{"file": "凡人百世书-第61集.mp4", "ep": 61, "duration": 90.3, "segments": [{"start": 0.0, "end": 1.92, "text": "保护九公子"}, {"start": 1.92, "end": 3.08, "text": "杀了他"}, {"start": 3.08, "end": 18.32, "text": "这不可能"}, {"start": 18.32, "end": 19.44, "text": "他是人是鬼"}, {"start": 19.44, "end": 20.28, "text": "还有谁"}, {"start": 29.1, "end": 29.7, "text": "走吧"}, {"start": 32.88, "end": 34.4, "text": "震南王世子叶璇"}, {"start": 34.4, "end": 36.44, "text": "三片书叶杀三个一流巅峰"}, {"start": 36.44, "end": 37.88, "text": "一刀斩杀小后天"}, {"start": 37.88, "end": 39.04, "text": "这是什么妖孽"}, {"start": 39.04, "end": 40.92, "text": "他绝对是蒼兰第一天才"}, {"start": 41.32, "end": 43.2, "text": "你们难道忘了官家那位"}, {"start": 43.2, "end": 44.04, "text": "官家"}, {"start": 44.04, "end": 44.96, "text": "哪个官家"}, {"start": 44.96, "end": 46.2, "text": "太后的娘家"}, {"start": 46.2, "end": 47.76, "text": "官家出了个妖孽女子"}, {"start": 47.76, "end": 49.04, "text": "据说可不比叶璇差"}, {"start": 49.04, "end": 49.8, "text": "真的假的"}, {"start": 49.8, "end": 50.68, "text": "当然是真的"}, {"start": 50.68, "end": 51.64, "text": "那姑娘叫什么来着"}, {"start": 51.64, "end": 52.32, "text": "官山月"}, {"start": 52.32, "end": 53.48, "text": "对 官山月"}, {"start": 53.48, "end": 54.52, "text": "那她俩谁更厉害"}, {"start": 54.52, "end": 55.12, "text": "不知道"}, {"start": 55.24, "end": 56.84, "text": "但我估计早晚要碰一碰"}, {"start": 57.08, "end": 68.88, "text": "生气了 太后"}, {"start": 68.88, "end": 69.96, "text": "震南不生气吗"}, {"start": 69.96, "end": 71.08, "text": "这是皇帝"}, {"start": 71.08, "end": 71.96, "text": "他凭什么当着"}, {"start": 71.96, "end": 73.56, "text": "那么多人的灭绪之战"}, {"start": 75.08, "end": 76.12, "text": "陛下息怒"}, {"start": 76.12, "end": 77.28, "text": "小心隔墙有耳子"}, {"start": 77.28, "end": 78.6, "text": "隔墙有耳"}, {"start": 78.6, "end": 80.44, "text": "这连说句话都得提心吊胆"}, {"start": 80.44, "end": 81.16, "text": "这皇帝当的"}, {"start": 81.16, "end": 82.8, "text": "还有什么意思"}, {"start": 82.8, "end": 83.68, "text": "朕这些年"}, {"start": 83.68, "end": 85.24, "text": "想做什么都做不成"}, {"start": 85.24, "end": 86.94, "text": "想用谁也用不了"}, {"start": 86.94, "end": 88.78, "text": "好不容易出了个沉迫处"}, {"start": 88.78, "end": 90.18, "text": "以为能制衡他"}]}