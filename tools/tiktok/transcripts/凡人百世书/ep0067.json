{"file": "凡人百世书-第67集.mp4", "ep": 67, "duration": 93.5, "segments": [{"start": 0.69, "end": 1.69, "text": "就是她了"}, {"start": 1.69, "end": 4.32, "text": "她是王氏之邁的后代"}, {"start": 4.32, "end": 6.32, "text": "身上留着太祖的血"}, {"start": 6.32, "end": 7.32, "text": "但如今"}, {"start": 7.32, "end": 8.32, "text": "却靠知习范离为生"}, {"start": 8.32, "end": 9.32, "text": "她"}, {"start": 9.32, "end": 11.32, "text": "无权无势毫无根基"}, {"start": 11.32, "end": 12.32, "text": "为人老实募能"}, {"start": 12.32, "end": 14.32, "text": "最适合做掌控的傀儡了"}, {"start": 14.32, "end": 16.32, "text": "如果给你一个做皇帝的机会"}, {"start": 16.32, "end": 17.32, "text": "你愿意吗"}, {"start": 17.32, "end": 25.18, "text": "哀家封你为中山敬王"}, {"start": 25.18, "end": 28.18, "text": "伺服底拨皇金万辆"}, {"start": 29.18, "end": 30.18, "text": "小子"}, {"start": 30.18, "end": 31.18, "text": "老夫劝你"}, {"start": 31.18, "end": 33.18, "text": "哪来的就回哪去"}, {"start": 33.18, "end": 35.18, "text": "这不是你该来的地方"}, {"start": 35.18, "end": 37.21, "text": "是传已久的朕教神功"}, {"start": 40.48, "end": 42.48, "text": "他是教主传人"}, {"start": 42.48, "end": 43.48, "text": "从今天起"}, {"start": 43.48, "end": 45.48, "text": "我就是教主"}, {"start": 45.48, "end": 48.61, "text": "无等世子追随教主大人"}, {"start": 48.61, "end": 49.61, "text": "叶玄"}, {"start": 49.61, "end": 50.61, "text": "我突破大后天了"}, {"start": 50.61, "end": 55.51, "text": "你也突破了"}, {"start": 55.51, "end": 58.57, "text": "她才是真正的天才"}, {"start": 58.57, "end": 59.57, "text": "没有几十七类"}, {"start": 59.57, "end": 60.6, "text": "更没有密法刺激"}, {"start": 60.6, "end": 61.6, "text": "纯靠天父"}, {"start": 61.6, "end": 62.6, "text": "硬生生追伤"}, {"start": 62.6, "end": 63.6, "text": "当年非将军一个人"}, {"start": 63.6, "end": 64.6, "text": "杀了上百敌将"}, {"start": 64.6, "end": 66.6, "text": "我爹亲眼看见的"}, {"start": 66.6, "end": 67.6, "text": "后来被毒死了"}, {"start": 67.6, "end": 68.6, "text": "朝廷说是暴兵"}, {"start": 68.6, "end": 69.6, "text": "谁信"}, {"start": 69.6, "end": 70.6, "text": "小子"}, {"start": 70.6, "end": 72.82, "text": "怕什么 都多少年"}, {"start": 72.82, "end": 73.82, "text": "将军"}]}