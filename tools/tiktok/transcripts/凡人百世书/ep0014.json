{"file": "凡人百世书-第14集.mp4", "ep": 14, "duration": 119.0, "segments": [{"start": 1.42, "end": 2.38, "text": "這一刻"}, {"start": 2.62, "end": 4.06, "text": "我等了整整十年"}, {"start": 4.82, "end": 6.86, "text": "今天就是紫衣門面門之事"}, {"start": 7.46, "end": 11.79, "text": "你就是那個傳信的"}, {"start": 13.14, "end": 14.22, "text": "幹得不錯"}, {"start": 14.9, "end": 16.02, "text": "從今往後"}, {"start": 16.3, "end": 18.14, "text": "紫衣門便不存在了"}, {"start": 18.26, "end": 18.94, "text": "殺"}, {"start": 19.54, "end": 21.26, "text": "我們打進來了"}, {"start": 21.46, "end": 22.48, "text": "那鬼"}, {"start": 22.48, "end": 23.76, "text": "他們被人打開了"}, {"start": 23.76, "end": 24.32, "text": "快"}, {"start": 24.32, "end": 25.44, "text": "快擋住他們"}, {"start": 30.42, "end": 32.64, "text": "十年的隱忍"}, {"start": 32.64, "end": 33.48, "text": "十年的謀劃"}, {"start": 33.48, "end": 34.48, "text": "十年的扯腐"}, {"start": 34.72, "end": 36.12, "text": "今天終於實現了"}, {"start": 36.82, "end": 37.26, "text": "爹"}, {"start": 39.3, "end": 40.98, "text": "前世的孩兒你們看到了嗎"}, {"start": 41.38, "end": 41.98, "text": "今天"}, {"start": 42.3, "end": 43.58, "text": "我替你們報仇了"}, {"start": 48.67, "end": 60.04, "text": "紫衣門有先天老公"}, {"start": 60.04, "end": 60.76, "text": "很好"}, {"start": 61.23, "end": 62.99, "text": "本座閉關三十年"}, {"start": 63.11, "end": 63.95, "text": "一出關"}, {"start": 64.03, "end": 65.91, "text": "就看到你們在自相殘殺"}, {"start": 65.91, "end": 66.79, "text": "快撤"}, {"start": 67.07, "end": 68.55, "text": "他引來了摩門"}, {"start": 70.01, "end": 71.33, "text": "你有何話說"}, {"start": 72.84, "end": 73.76, "text": "太上長老"}, {"start": 73.76, "end": 75.28, "text": "總容門下奪權"}, {"start": 75.52, "end": 77.36, "text": "一支門派遭此大難"}, {"start": 77.48, "end": 78.56, "text": "該當何罪"}, {"start": 79.04, "end": 80.04, "text": "一個不留"}, {"start": 80.68, "end": 82.84, "text": "大長老一脈皆為叛逆"}, {"start": 82.88, "end": 83.92, "text": "查清之後"}, {"start": 83.92, "end": 85.08, "text": "紫衣門竟然有先天"}, {"start": 85.08, "end": 86.32, "text": "三十年閉關的老怪物"}, {"start": 86.32, "end": 107.0, "text": "偏偏在今天出關"}, {"start": 107.0, "end": 107.8, "text": "咱們怎麼辦"}, {"start": 108.0, "end": 111.26, "text": "你去哪兒"}, {"start": 111.5, "end": 112.14, "text": "大人"}, {"start": 112.14, "end": 113.3, "text": "你不是說要帶我們"}, {"start": 113.3, "end": 115.26, "text": "撥一場大富貴吧"}]}