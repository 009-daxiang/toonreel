{"file": "凡人百世书-第8集.mp4", "ep": 8, "duration": 132.8, "segments": [{"start": 2.41, "end": 3.21, "text": "最后一刻"}, {"start": 3.81, "end": 5.37, "text": "我总算成功突破二流"}, {"start": 5.89, "end": 6.77, "text": "终于有了与那些"}, {"start": 6.77, "end": 8.21, "text": "天才一交长短的资格"}, {"start": 12.35, "end": 13.03, "text": "哇操"}, {"start": 13.03, "end": 14.31, "text": "林墨也二流了"}, {"start": 15.07, "end": 16.18, "text": "他的"}, {"start": 16.18, "end": 16.9, "text": "不知道啊"}, {"start": 16.9, "end": 18.26, "text": "前两天还是三流呢"}, {"start": 18.74, "end": 20.54, "text": "二流确实比三流强太多了"}, {"start": 20.98, "end": 22.1, "text": "玄清弓也不一般"}, {"start": 22.62, "end": 23.7, "text": "同样是二流初期"}, {"start": 24.1, "end": 25.46, "text": "我的真气量质量更高"}, {"start": 25.62, "end": 26.42, "text": "第二场"}, {"start": 26.54, "end": 27.98, "text": "对手是周圆凯"}, {"start": 28.34, "end": 30.06, "text": "外院四位真天才之一"}, {"start": 30.7, "end": 31.22, "text": "林兄"}, {"start": 31.58, "end": 32.34, "text": "请指教"}, {"start": 33.3, "end": 36.3, "text": "好那里"}, {"start": 37.06, "end": 37.98, "text": "你这是什么功夫"}, {"start": 38.26, "end": 61.74, "text": "小子那里明明不如我"}, {"start": 61.9, "end": 62.86, "text": "但就是打不垮"}, {"start": 63.14, "end": 64.42, "text": "这是什么鬼功夫"}, {"start": 65.5, "end": 66.58, "text": "击战之四十招"}, {"start": 66.66, "end": 67.38, "text": "这小子的那里"}, {"start": 67.38, "end": 68.26, "text": "竟还没耗尽"}, {"start": 68.54, "end": 69.9, "text": "看我一击破你"}, {"start": 70.54, "end": 71.22, "text": "找到了"}, {"start": 71.58, "end": 72.58, "text": "受死吧"}, {"start": 72.9, "end": 73.38, "text": "输了"}, {"start": 73.38, "end": 74.18, "text": "别动"}, {"start": 80.02, "end": 81.22, "text": "不许他能跟外院第一天"}, {"start": 81.22, "end": 82.62, "text": "才审刘云一交长相"}, {"start": 82.9, "end": 91.25, "text": "得了四大天才"}, {"start": 95.14, "end": 95.86, "text": "林师弟"}, {"start": 96.6, "end": 97.4, "text": "你很强"}, {"start": 98.19, "end": 98.75, "text": "还好"}, {"start": 99.41, "end": 100.65, "text": "你的打法我看懂了"}, {"start": 101.13, "end": 102.53, "text": "就是硬扛着往前冲"}, {"start": 104.8, "end": 105.52, "text": "但这招"}, {"start": 106.72, "end": 107.44, "text": "对我没用"}, {"start": 108.46, "end": 108.98, "text": "试试"}, {"start": 109.14, "end": 110.02, "text": "因为我的剑"}, {"start": 110.22, "end": 111.18, "text": "你扛不住"}, {"start": 120.3, "end": 121.02, "text": "实至名归"}, {"start": 121.02, "end": 121.54, "text": "承让"}, {"start": 121.7, "end": 124.46, "text": "只要拼尽全力"}, {"start": 124.46, "end": 125.98, "text": "能扛周圆凯四十多招"}, {"start": 126.53, "end": 127.73, "text": "但在审刘云面前"}, {"start": 128.25, "end": 129.37, "text": "我只扛了三剑"}, {"start": 131.8, "end": 132.72, "text": "多谢指教"}]}