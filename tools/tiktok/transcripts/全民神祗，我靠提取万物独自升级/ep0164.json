{"file": "全民神祗，我靠提取万物独自升级-第164集.mp4", "ep": 164, "duration": 62.0, "segments": [{"start": 0.0, "end": 2.32, "text": "黑金任與魔咎數量85萬"}, {"start": 2.32, "end": 4.32, "text": "青銅中階至白銀高階"}, {"start": 4.32, "end": 6.2, "text": "刺生古人械數量120萬"}, {"start": 6.2, "end": 8.6, "text": "星紅飛刺骨魚數量60萬"}, {"start": 8.6, "end": 10.2, "text": "均已形成穩定族群"}, {"start": 14.02, "end": 16.34, "text": "災厄火靈數量8500"}, {"start": 16.34, "end": 18.66, "text": "等階白銀巔峰至黃金六星"}, {"start": 18.66, "end": 20.26, "text": "特性物理免疫"}, {"start": 20.26, "end": 21.38, "text": "疾寒毒火區"}, {"start": 21.38, "end": 22.42, "text": "元靈火編"}, {"start": 23.6, "end": 24.52, "text": "災厄聚合"}, {"start": 25.04, "end": 26.8, "text": "附屬火靈可強行融合為"}, {"start": 26.8, "end": 28.12, "text": "災厄元素靈主"}, {"start": 28.12, "end": 30.48, "text": "短暫獲得跨越大皆位的毀滅力量"}, {"start": 31.24, "end": 33.44, "text": "沒想到近出現了元素生命體"}, {"start": 48.46, "end": 50.58, "text": "特性重組統具無視精神干擾"}, {"start": 50.58, "end": 51.82, "text": "完美操控千萬重群"}, {"start": 51.82, "end": 54.34, "text": "世界名甲重組王者黃金九星"}, {"start": 54.34, "end": 56.06, "text": "特性重組統具"}, {"start": 56.06, "end": 56.82, "text": "戰鬥推演"}, {"start": 56.82, "end": 58.66, "text": "可快速分析對方陣營與弱點"}, {"start": 58.66, "end": 61.9, "text": "基因所免疫刺生波強酸毒蟹及高強輻射"}]}