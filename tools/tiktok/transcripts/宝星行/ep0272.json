{"file": "宝星行-第272集.mp4", "ep": 272, "duration": 47.7, "segments": [{"start": 0.0, "end": 1.28, "text": "和員工後勤中心"}, {"start": 2.02, "end": 3.3, "text": "繼續正常經營"}, {"start": 3.54, "end": 6.36, "text": "這下公司有自己的接待和培訓中心了"}, {"start": 6.62, "end": 7.9, "text": "後勤也能統一安排"}, {"start": 8.42, "end": 9.54, "text": "謝謝老闆"}, {"start": 9.8, "end": 10.82, "text": "我們一定把心"}, {"start": 12.64, "end": 13.92, "text": "他願意幫員工"}, {"start": 14.42, "end": 15.7, "text": "卻沒有越過規則"}, {"start": 16.54, "end": 18.84, "text": "更沒有拿收購逼任何人低頭"}, {"start": 19.88, "end": 21.66, "text": "青絲跟著這樣的老闆工作"}, {"start": 22.18, "end": 22.94, "text": "我放心了"}, {"start": 23.46, "end": 24.22, "text": "張豆您好"}, {"start": 24.74, "end": 25.26, "text": "我是羅燕"}, {"start": 25.5, "end": 26.28, "text": "青絲的媽媽"}, {"start": 26.54, "end": 27.82, "text": "謝謝您為我出氣"}, {"start": 28.06, "end": 29.1, "text": "我真的受寵若驚"}, {"start": 29.34, "end": 30.12, "text": "羅阿姨客氣了"}, {"start": 30.38, "end": 31.4, "text": "你看起來真年輕"}, {"start": 31.66, "end": 32.42, "text": "像青絲的姐姐"}, {"start": 32.42, "end": 33.44, "text": "交割後"}, {"start": 33.7, "end": 35.5, "text": "羅燕保留原有百分之0.5股份"}, {"start": 36.0, "end": 38.04, "text": "並加入員工權益與運營監督小組"}, {"start": 38.3, "end": 40.1, "text": "酒店仍由專業經理團隊管理"}, {"start": 40.62, "end": 42.92, "text": "賀總的問題交給審計和有關部門處理"}, {"start": 43.42, "end": 44.2, "text": "謝謝公司信任"}, {"start": 44.7, "end": 46.24, "text": "我會把掌握的材料如實體交"}, {"start": 46.5, "end": 47.78, "text": "也會配合專業團隊做"}]}