{"file": "宝星行-第240集.mp4", "ep": 240, "duration": 47.8, "segments": [{"start": 0.11, "end": 2.11, "text": "那我先把形体展示方案练好"}, {"start": 2.11, "end": 3.11, "text": "等什么机会啊"}, {"start": 3.11, "end": 4.11, "text": "他又不会亏待我们"}, {"start": 4.11, "end": 5.11, "text": "好好享受生活就好了"}, {"start": 5.11, "end": 6.11, "text": "老板给我们机会"}, {"start": 6.11, "end": 7.11, "text": "也尊重工作边界"}, {"start": 7.11, "end": 8.11, "text": "我们就把他当真正带团队的人"}, {"start": 8.11, "end": 9.11, "text": "公司照顾员工"}, {"start": 9.11, "end": 11.11, "text": "员工也得靠能力把岗位做好"}, {"start": 11.11, "end": 12.11, "text": "不能把福利当成理所当然"}, {"start": 12.11, "end": 13.11, "text": "工作岗起步"}, {"start": 13.11, "end": 14.11, "text": "大家先把事业做好"}, {"start": 14.11, "end": 15.11, "text": "老板对我们这么信任"}, {"start": 15.11, "end": 16.11, "text": "我们一定把工作干好"}, {"start": 16.11, "end": 17.11, "text": "用业绩回报公司"}, {"start": 17.11, "end": 18.11, "text": "团队需要帮忙就叫我"}, {"start": 18.11, "end": 20.11, "text": "我也得拿出真本事"}, {"start": 20.11, "end": 22.14, "text": "这就对了"}, {"start": 22.14, "end": 23.14, "text": "都认真点"}, {"start": 23.14, "end": 26.67, "text": "吃饭了吃饭了"}, {"start": 26.67, "end": 28.18, "text": "放下的面条好吃不"}, {"start": 28.18, "end": 32.61, "text": "好吃"}, {"start": 32.61, "end": 33.61, "text": "真好吃"}, {"start": 33.61, "end": 34.61, "text": "好吃"}, {"start": 34.61, "end": 35.61, "text": "清香的手艺真不错"}, {"start": 35.61, "end": 38.09, "text": "老板喜欢就多吃点"}, {"start": 38.09, "end": 40.09, "text": "改天我也下厨"}, {"start": 40.09, "end": 44.45, "text": "我也会做饭"}, {"start": 44.45, "end": 45.67, "text": "尝尝水果"}, {"start": 45.67, "end": 47.67, "text": "还有个正式宣布一下"}]}