{"file": "宝星行-第60集.mp4", "ep": 60, "duration": 52.5, "segments": [{"start": 0.0, "end": 1.68, "text": "两维绅 八两维绊"}, {"start": 1.68, "end": 3.28, "text": "这六斤多重的重量"}, {"start": 3.28, "end": 5.16, "text": "毫无疑问是绝世归宝"}, {"start": 5.16, "end": 5.96, "text": "发财了"}, {"start": 7.74, "end": 9.54, "text": "伤势总算稳住了"}, {"start": 9.54, "end": 10.74, "text": "结婚就叫灰灰"}, {"start": 10.74, "end": 11.74, "text": "知道吗"}, {"start": 11.74, "end": 13.14, "text": "灰灰"}, {"start": 13.14, "end": 19.03, "text": "附近还有这种生肋职务吗"}, {"start": 19.03, "end": 20.31, "text": "时间不早了"}, {"start": 20.31, "end": 22.94, "text": "该回去了"}, {"start": 22.94, "end": 23.62, "text": "灰灰"}, {"start": 23.62, "end": 25.18, "text": "你乖乖地藏在家里"}, {"start": 25.18, "end": 26.89, "text": "出来得小心"}, {"start": 26.89, "end": 28.21, "text": "下次我会来看你"}, {"start": 28.21, "end": 31.74, "text": "给你带好吃的"}, {"start": 31.74, "end": 34.88, "text": "十天时间到了"}, {"start": 34.88, "end": 36.16, "text": "看来是失败了"}, {"start": 36.16, "end": 36.92, "text": "范总"}, {"start": 36.92, "end": 38.16, "text": "张通还没回来"}, {"start": 38.16, "end": 39.28, "text": "或许他会有收获"}, {"start": 39.28, "end": 39.84, "text": "怎么"}, {"start": 39.88, "end": 41.0, "text": "还有别人没回来吗"}, {"start": 41.0, "end": 41.6, "text": "是的"}, {"start": 41.6, "end": 42.44, "text": "还有一人"}, {"start": 42.44, "end": 43.88, "text": "十天前才过来的"}, {"start": 43.88, "end": 44.84, "text": "也是一名寻宝人"}, {"start": 44.84, "end": 45.36, "text": "谁啊"}, {"start": 45.36, "end": 46.72, "text": "世界上有名的寻宝人"}, {"start": 46.72, "end": 47.32, "text": "我都认识"}, {"start": 47.32, "end": 48.48, "text": "他名叫张通"}, {"start": 48.48, "end": 49.44, "text": "我们华国人"}, {"start": 49.44, "end": 50.4, "text": "今年二十二岁"}, {"start": 50.4, "end": 51.2, "text": "张通"}, {"start": 51.2, "end": 52.24, "text": "没听说过"}, {"start": 52.24, "end": 53.08, "text": "我也不认识"}]}