{"file": "宝星行-第258集.mp4", "ep": 258, "duration": 47.9, "segments": [{"start": 0.08, "end": 0.8, "text": "贺总去"}, {"start": 3.81, "end": 4.97, "text": "什么不好的消息"}, {"start": 5.09, "end": 6.33, "text": "大惊小怪的"}, {"start": 6.45, "end": 6.93, "text": "说"}, {"start": 7.13, "end": 9.21, "text": "这个和罗燕有关"}, {"start": 9.49, "end": 10.53, "text": "三楼包厢里"}, {"start": 10.65, "end": 12.33, "text": "罗燕的女儿柳青丝来吃饭"}, {"start": 12.45, "end": 13.13, "text": "正带着一个"}, {"start": 13.13, "end": 14.41, "text": "欺盖不凡的少年"}, {"start": 14.53, "end": 16.05, "text": "请她出手对付咱们呢"}, {"start": 17.01, "end": 18.57, "text": "罗燕的女儿找人帮她"}, {"start": 18.73, "end": 20.01, "text": "一个普通主播而已"}, {"start": 20.01, "end": 20.97, "text": "能认识什么任务"}, {"start": 20.97, "end": 22.37, "text": "贺总 不可不妨"}, {"start": 22.45, "end": 23.65, "text": "那少年虽然年轻"}, {"start": 23.73, "end": 25.25, "text": "但身边跟着几名公司员工"}, {"start": 25.25, "end": 26.69, "text": "还有个负责联络的胖助理"}, {"start": 26.69, "end": 28.25, "text": "带着一群年轻员工"}, {"start": 28.53, "end": 30.81, "text": "难道是哪家新公司的负责人"}, {"start": 31.09, "end": 32.45, "text": "看着二十一二岁"}, {"start": 32.73, "end": 34.49, "text": "可能是创业公司的老板"}, {"start": 34.49, "end": 35.85, "text": "带团队来谈业务"}, {"start": 36.65, "end": 38.45, "text": "二十来岁的矛头小子"}, {"start": 38.45, "end": 40.13, "text": "模特公司的太子爷"}, {"start": 40.13, "end": 41.85, "text": "一个刚创业的年轻人"}, {"start": 41.85, "end": 44.21, "text": "也敢插手酒店股权和内部管理"}, {"start": 44.53, "end": 46.17, "text": "未免太不知深浅"}, {"start": 46.33, "end": 47.89, "text": "到底是导演还是模特"}]}