{"file": "宝星行-第58集.mp4", "ep": 58, "duration": 53.4, "segments": [{"start": 0.0, "end": 1.0, "text": "旺財"}, {"start": 1.0, "end": 2.16, "text": "打起精神"}, {"start": 2.16, "end": 4.16, "text": "這裡是大象的臨地"}, {"start": 4.16, "end": 7.28, "text": "隨時可能遇到巨獸"}, {"start": 7.28, "end": 8.28, "text": "松鼠"}, {"start": 8.28, "end": 11.28, "text": "在這外星球竟然能看到認識的動物"}, {"start": 11.28, "end": 12.28, "text": "真是很親切啊"}, {"start": 12.28, "end": 14.28, "text": "這兩天見到的鳥鳥"}, {"start": 14.28, "end": 16.28, "text": "沒有一種是我認識的"}, {"start": 16.28, "end": 17.28, "text": "跑得挺快"}, {"start": 17.28, "end": 18.31, "text": "我上去看看"}, {"start": 18.31, "end": 19.31, "text": "空間好大"}, {"start": 19.31, "end": 21.31, "text": "裡面堆滿了各種各樣的堅果"}, {"start": 21.31, "end": 23.31, "text": "簡直就是賦予人家的糧倉"}, {"start": 23.31, "end": 25.38, "text": "這果子外殼極其堅硬"}, {"start": 25.38, "end": 27.73, "text": "難道這是一種異星的椰子"}, {"start": 27.73, "end": 28.73, "text": "旺財"}, {"start": 28.73, "end": 30.69, "text": "過來試毒"}, {"start": 31.69, "end": 33.9, "text": "清涼香甜"}, {"start": 33.9, "end": 35.9, "text": "真就是極品椰子水的味道"}, {"start": 35.9, "end": 36.9, "text": "裡面的水可以喝"}, {"start": 36.9, "end": 37.9, "text": "這堅硬的外殼帶回去"}, {"start": 37.9, "end": 39.9, "text": "還能做水缸和浴缸"}, {"start": 39.9, "end": 40.9, "text": "冬天絕對用得著"}, {"start": 40.9, "end": 42.86, "text": "真可愛"}, {"start": 42.86, "end": 43.86, "text": "過來"}, {"start": 43.86, "end": 44.86, "text": "給你好東西吃"}, {"start": 44.86, "end": 46.6, "text": "好吃吧"}, {"start": 46.6, "end": 47.6, "text": "放心"}, {"start": 47.6, "end": 48.73, "text": "我不會傷害你的"}, {"start": 48.73, "end": 50.73, "text": "太膽小了"}, {"start": 50.73, "end": 51.73, "text": "旺財"}, {"start": 51.73, "end": 52.73, "text": "我們繼續往上探索"}]}