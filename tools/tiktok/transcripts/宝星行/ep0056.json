{"file": "宝星行-第56集.mp4", "ep": 56, "duration": 53.3, "segments": [{"start": 1.52, "end": 2.6, "text": "走 不跟他纠缠"}, {"start": 2.6, "end": 4.16, "text": "上游大概是大象的领地"}, {"start": 4.16, "end": 6.4, "text": "刚才那副白骨八成就是成年巨象的"}, {"start": 6.4, "end": 7.84, "text": "我们往下边走"}, {"start": 7.84, "end": 15.66, "text": "好浓郁的杀气"}, {"start": 15.66, "end": 17.46, "text": "比上次那只白狼强横得多"}, {"start": 17.46, "end": 19.24, "text": "汪才"}, {"start": 19.24, "end": 20.08, "text": "一人一只"}, {"start": 20.08, "end": 20.92, "text": "准备动手"}, {"start": 20.92, "end": 30.8, "text": "通天开山"}, {"start": 30.8, "end": 35.96, "text": "行了 松口吧"}, {"start": 35.96, "end": 36.92, "text": "早死透了"}, {"start": 36.92, "end": 38.56, "text": "要这么急你不嫌累啊"}, {"start": 38.56, "end": 40.82, "text": "干得漂亮"}, {"start": 40.82, "end": 42.1, "text": "练出通天进之后"}, {"start": 42.1, "end": 43.58, "text": "战力确实脱胎换骨"}, {"start": 43.58, "end": 45.5, "text": "今晚奖励你一条整抱腿"}, {"start": 45.5, "end": 50.3, "text": "这 怎么可能"}, {"start": 50.3, "end": 52.94, "text": "翠天无比"}]}