{"file": "宝星行-第87集.mp4", "ep": 87, "duration": 50.8, "segments": [{"start": 0.0, "end": 1.0, "text": "不手续与牌照"}, {"start": 1.0, "end": 2.0, "text": "祝您用车愉快"}, {"start": 2.0, "end": 3.0, "text": "辛苦了"}, {"start": 3.0, "end": 7.14, "text": "回吧"}, {"start": 7.14, "end": 8.14, "text": "赵秘书"}, {"start": 8.14, "end": 10.14, "text": "这辆红色910以后归你开"}, {"start": 10.14, "end": 11.14, "text": "罗胖开奥迪A8"}, {"start": 11.14, "end": 12.14, "text": "油费和保养"}, {"start": 12.14, "end": 13.14, "text": "全部找公司报销"}, {"start": 13.14, "end": 14.14, "text": "150万的保时捷"}, {"start": 14.14, "end": 15.14, "text": "给我时代步"}, {"start": 15.14, "end": 16.46, "text": "谢谢老板"}, {"start": 16.46, "end": 17.46, "text": "我一定会全力"}, {"start": 17.46, "end": 19.46, "text": "协助你达理好拍卖行"}, {"start": 19.46, "end": 20.46, "text": "走 上车"}, {"start": 20.46, "end": 21.46, "text": "带你兜风去"}, {"start": 21.46, "end": 22.46, "text": "是"}, {"start": 22.46, "end": 23.46, "text": "老板"}, {"start": 23.46, "end": 24.46, "text": "旺财 上车顶"}, {"start": 27.22, "end": 28.22, "text": "坐稳了"}, {"start": 29.22, "end": 30.22, "text": "2000多万的移动城堡"}, {"start": 30.22, "end": 31.22, "text": "车上的神豪帅得离谱"}, {"start": 31.22, "end": 32.22, "text": "副驾车的美女"}, {"start": 32.22, "end": 33.22, "text": "更是清国清晨"}, {"start": 33.22, "end": 34.22, "text": "但这都不算啥"}, {"start": 35.22, "end": 36.22, "text": "你车顶上那只狗"}, {"start": 36.22, "end": 38.22, "text": "那狗是汗在车顶上的吗"}, {"start": 38.22, "end": 39.22, "text": "200号士速竟然稳如泰山"}, {"start": 39.22, "end": 41.22, "text": "这特罖是神犬吧"}, {"start": 41.22, "end": 42.89, "text": "老板"}, {"start": 42.89, "end": 43.89, "text": "你说什么"}, {"start": 43.89, "end": 44.89, "text": "风太大没听清"}, {"start": 44.89, "end": 45.89, "text": "我说"}, {"start": 45.89, "end": 46.89, "text": "跟着你"}, {"start": 46.89, "end": 47.89, "text": "是我这辈子最正确的决定"}, {"start": 47.89, "end": 48.89, "text": "那就抓紧了"}, {"start": 48.89, "end": 50.89, "text": "带你去看看我长大的地方"}]}