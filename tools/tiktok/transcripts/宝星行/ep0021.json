{"file": "宝星行-第21集.mp4", "ep": 21, "duration": 53.4, "segments": [{"start": 0.0, "end": 1.44, "text": "就永远只属于我一个人"}, {"start": 1.44, "end": 3.44, "text": "四千五百万的别墅到手"}, {"start": 3.44, "end": 6.4, "text": "地下室藏着通往一星的无尽宝藏"}, {"start": 6.4, "end": 7.72, "text": "明天下午"}, {"start": 7.72, "end": 10.6, "text": "那些身家百异的珠宝巨额们"}, {"start": 10.6, "end": 12.6, "text": "准备好你们的支票本吧"}, {"start": 12.6, "end": 14.06, "text": "快六点了"}, {"start": 14.06, "end": 15.98, "text": "答应了赵芊今晚一起吃饭"}, {"start": 15.98, "end": 17.98, "text": "也是时候去接她下班了"}, {"start": 17.98, "end": 19.54, "text": "三轮车太热烈"}, {"start": 19.54, "end": 24.47, "text": "换个交通工具"}, {"start": 24.47, "end": 25.23, "text": "不好意思"}, {"start": 25.23, "end": 26.47, "text": "到下班时间了"}, {"start": 26.47, "end": 29.3, "text": "大家让开吧"}, {"start": 29.3, "end": 30.22, "text": "下班了"}, {"start": 30.22, "end": 33.21, "text": "没得看了"}, {"start": 33.21, "end": 34.57, "text": "这不是陆大少吗"}, {"start": 34.57, "end": 36.69, "text": "价值三百万的法拉利296"}, {"start": 36.69, "end": 37.49, "text": "好帅啊"}, {"start": 37.49, "end": 39.1, "text": "泡泡表白"}, {"start": 39.1, "end": 42.16, "text": "太幸福了"}, {"start": 42.16, "end": 43.74, "text": "赵芊同学"}, {"start": 43.74, "end": 45.11, "text": "我喜欢你"}, {"start": 45.11, "end": 46.15, "text": "做我女朋友吧"}, {"start": 46.15, "end": 47.75, "text": "怎么又来表白"}, {"start": 47.75, "end": 48.98, "text": "那万没了吗"}, {"start": 48.98, "end": 50.58, "text": "法拉利了不起吗"}, {"start": 50.58, "end": 52.58, "text": "我今天也赚了一百多万"}]}