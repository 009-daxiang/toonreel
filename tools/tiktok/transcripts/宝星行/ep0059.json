{"file": "宝星行-第59集.mp4", "ep": 59, "duration": 52.5, "segments": [{"start": 2.06, "end": 3.06, "text": "放開他"}, {"start": 7.97, "end": 8.97, "text": "別怕"}, {"start": 8.97, "end": 9.97, "text": "我不會傷害你"}, {"start": 9.97, "end": 10.97, "text": "讓我看看你的傷"}, {"start": 10.97, "end": 13.44, "text": "這麼小的傢伙"}, {"start": 13.44, "end": 14.44, "text": "竟不有多出藥傷"}, {"start": 14.44, "end": 16.44, "text": "得趕緊止血處理"}, {"start": 16.44, "end": 21.5, "text": "松手指路"}, {"start": 21.5, "end": 28.53, "text": "你讓我去那邊"}, {"start": 28.53, "end": 29.53, "text": "這是人身"}, {"start": 29.53, "end": 31.53, "text": "一般的人身只有3到7片葉子"}, {"start": 31.53, "end": 33.53, "text": "這株人身竟然有64片葉子"}, {"start": 33.53, "end": 34.53, "text": "數量差太多了"}, {"start": 34.53, "end": 36.53, "text": "這難道就是傳說中的千年人身"}, {"start": 36.53, "end": 37.53, "text": "主體蒼老"}, {"start": 37.53, "end": 38.53, "text": "色澤極案"}, {"start": 38.53, "end": 40.53, "text": "盧晚竟然有1000多個"}, {"start": 40.53, "end": 42.66, "text": "主婿長達4米多"}, {"start": 42.66, "end": 44.66, "text": "老生的虛越簡潔"}, {"start": 44.66, "end": 45.69, "text": "年分越長"}, {"start": 45.69, "end": 47.69, "text": "這絕對是千年以上的老生"}, {"start": 47.69, "end": 51.25, "text": "中3100克"}, {"start": 51.25, "end": 52.25, "text": "7200克"}]}