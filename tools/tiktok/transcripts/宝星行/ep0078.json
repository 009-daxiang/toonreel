{"file": "宝星行-第78集.mp4", "ep": 78, "duration": 50.8, "segments": [{"start": 0.0, "end": 2.24, "text": "他既然离职了那就死无对证"}, {"start": 2.24, "end": 3.04, "text": "行"}, {"start": 3.04, "end": 4.52, "text": "合同不认证是吧"}, {"start": 4.52, "end": 6.16, "text": "那我只问你一句话"}, {"start": 6.16, "end": 8.36, "text": "我买的那套4500万的别墅"}, {"start": 8.36, "end": 10.2, "text": "公司账目上的销售佣金"}, {"start": 10.2, "end": 11.92, "text": "到底发到谁的账户上"}, {"start": 11.92, "end": 12.72, "text": "这"}, {"start": 12.72, "end": 14.32, "text": "这是公司内部机密"}, {"start": 14.32, "end": 16.04, "text": "无可奉告"}, {"start": 16.04, "end": 16.88, "text": "赵倩"}, {"start": 16.88, "end": 17.68, "text": "拿出手机"}, {"start": 17.68, "end": 19.08, "text": "直接拨打110报警"}, {"start": 19.08, "end": 20.52, "text": "就说有人利用职务之便"}, {"start": 20.52, "end": 22.44, "text": "涉嫌职务侵占和巨额炸箭"}, {"start": 22.44, "end": 26.06, "text": "让精真制度直接查天蓝庄员的财务流水"}, {"start": 26.06, "end": 26.9, "text": "是 老板"}, {"start": 26.9, "end": 27.7, "text": "别报警"}, {"start": 27.7, "end": 31.08, "text": "我都可以提交调查"}, {"start": 31.16, "end": 32.72, "text": "合同漏血佣金条款后"}, {"start": 32.72, "end": 34.24, "text": "我利用审批权宪把那笔佣金"}, {"start": 34.24, "end": 35.52, "text": "转进了自己的账户"}, {"start": 35.52, "end": 36.8, "text": "我愿意退回款货"}, {"start": 36.8, "end": 38.68, "text": "也接受公司和有关部门调查"}, {"start": 38.68, "end": 40.16, "text": "他就把事情全说了"}, {"start": 45.42, "end": 47.52, "text": "退款也免不了你的罪"}, {"start": 47.52, "end": 49.12, "text": "转账合同和审批记录"}, {"start": 49.12, "end": 50.76, "text": "都会交给公司与有关部门"}]}