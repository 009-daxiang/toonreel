{"file": "宝星行-第213集.mp4", "ep": 213, "duration": 52.8, "segments": [{"start": 0.0, "end": 0.72, "text": "别动手"}, {"start": 0.72, "end": 1.6, "text": "现场有监控"}, {"start": 1.6, "end": 2.36, "text": "谁闹事"}, {"start": 2.36, "end": 3.52, "text": "谁就对后果负责"}, {"start": 3.52, "end": 5.12, "text": "同桌四个美女全在看着我"}, {"start": 5.12, "end": 6.48, "text": "这可是绝佳的展现机会"}, {"start": 6.48, "end": 7.72, "text": "必须冲在最前面"}, {"start": 7.72, "end": 9.24, "text": "就凭你也想拦我"}, {"start": 9.24, "end": 10.32, "text": "今天就一句话"}, {"start": 10.32, "end": 11.76, "text": "你们立刻当面赔礼道歉"}, {"start": 11.76, "end": 13.88, "text": "顺便把我们隔壁包乡的单全买了"}, {"start": 13.88, "end": 14.8, "text": "这事就算过去"}, {"start": 14.8, "end": 17.4, "text": "这还是看在你们包乡美女多的份上"}, {"start": 17.4, "end": 17.84, "text": "对"}, {"start": 17.84, "end": 18.76, "text": "买单道歉"}, {"start": 18.76, "end": 20.6, "text": "我们刘雪拼命一个月才拿几个钱"}, {"start": 20.6, "end": 21.48, "text": "你们这帮搞娱乐的"}, {"start": 21.48, "end": 22.92, "text": "开个破汇发五十万奖金"}, {"start": 22.92, "end": 23.92, "text": "吵得人头疼"}, {"start": 23.92, "end": 24.8, "text": "赶紧放老实点"}, {"start": 24.8, "end": 26.32, "text": "马上给我走"}, {"start": 26.32, "end": 27.92, "text": "否则后果自负"}, {"start": 27.92, "end": 29.76, "text": "敢在老子面前装硬气"}, {"start": 29.76, "end": 30.64, "text": "你们分明就是"}, {"start": 30.64, "end": 31.76, "text": "干了见不得人的构荡"}, {"start": 31.76, "end": 32.76, "text": "在这儿分赃"}, {"start": 32.76, "end": 34.32, "text": "兄弟们给我上"}, {"start": 34.32, "end": 35.52, "text": "不知天高地厚"}, {"start": 38.98, "end": 39.38, "text": "倒"}, {"start": 40.5, "end": 40.86, "text": "退"}, {"start": 43.95, "end": 45.59, "text": "就这种三角猫祸色"}, {"start": 45.59, "end": 48.39, "text": "还敢吹牛说调打你胖爷"}, {"start": 48.39, "end": 50.15, "text": "你们一家搞娱乐公司"}, {"start": 50.15, "end": 51.71, "text": "从哪儿请来这种级别的高手"}, {"start": 51.71, "end": 52.83, "text": "你们敢对执勤人员动"}]}