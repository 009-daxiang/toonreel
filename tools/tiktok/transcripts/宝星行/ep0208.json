{"file": "宝星行-第208集.mp4", "ep": 208, "duration": 49.8, "segments": [{"start": 0.0, "end": 2.0, "text": "也不得擅自監控私人通信"}, {"start": 4.32, "end": 5.32, "text": "老闆 少喝點烈酒"}, {"start": 5.32, "end": 7.32, "text": "先吃點鮑魚 顛顛肚子"}, {"start": 8.32, "end": 10.32, "text": "今天高興 放開了喝"}, {"start": 10.32, "end": 12.32, "text": "大肆找時期內會兒"}, {"start": 12.32, "end": 14.32, "text": "為了幾千塊的時期工資四處碰壁"}, {"start": 14.32, "end": 16.32, "text": "如今隨手創辦一家公司"}, {"start": 16.32, "end": 18.32, "text": "手握數百億"}, {"start": 18.32, "end": 20.32, "text": "身邊頂級笑話環繞"}, {"start": 20.32, "end": 22.32, "text": "昔日許下的願望"}, {"start": 22.32, "end": 24.32, "text": "總算是徹底實現了"}, {"start": 25.32, "end": 26.32, "text": "各位美女別客氣"}, {"start": 26.32, "end": 28.32, "text": "跟著通哥混"}, {"start": 28.32, "end": 29.32, "text": "以後咱們天保拍賣行"}, {"start": 29.32, "end": 31.32, "text": "就是全球第一"}, {"start": 31.32, "end": 33.32, "text": "只要有我羅經理在"}, {"start": 33.32, "end": 35.32, "text": "保證大家吃香的喝辣的"}, {"start": 35.32, "end": 37.67, "text": "各位同仁"}, {"start": 37.67, "end": 39.67, "text": "今天我們天保拍賣行"}, {"start": 39.67, "end": 40.67, "text": "首戰告捷"}, {"start": 40.67, "end": 41.67, "text": "單日營業額"}, {"start": 41.67, "end": 43.67, "text": "狂破630億告官"}, {"start": 43.67, "end": 44.67, "text": "下面"}, {"start": 44.67, "end": 46.67, "text": "讓我們用最熱烈的掌聲"}, {"start": 46.67, "end": 48.67, "text": "請我們年輕有為的董事長"}, {"start": 48.67, "end": 49.67, "text": "發表演講"}]}