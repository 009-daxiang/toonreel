{"file": "宝星行-第200集.mp4", "ep": 200, "duration": 48.5, "segments": [{"start": 0.0, "end": 1.08, "text": "老闆太神奇了"}, {"start": 1.08, "end": 2.08, "text": "竟然能弄到"}, {"start": 2.08, "end": 3.56, "text": "能飞天蹲地的寶物"}, {"start": 3.56, "end": 4.84, "text": "钱只是个数字"}, {"start": 5.79, "end": 6.83, "text": "真正的大戏"}, {"start": 7.7, "end": 8.42, "text": "在门外"}, {"start": 8.74, "end": 9.98, "text": "飞珠太重要了"}, {"start": 10.3, "end": 11.14, "text": "绝不得被他拦住"}, {"start": 11.14, "end": 13.06, "text": "老闆 多谢你的寶物"}, {"start": 13.3, "end": 14.98, "text": "我先走一步了"}, {"start": 15.26, "end": 18.45, "text": "人员先确认交易和出境手续"}, {"start": 18.97, "end": 19.73, "text": "追不上了"}, {"start": 20.13, "end": 22.29, "text": "飞珠的加速度比测试时还快"}, {"start": 23.5, "end": 24.26, "text": "这件样品"}, {"start": 24.26, "end": 26.34, "text": "可能涉及飞行安全和出口管制"}, {"start": 26.5, "end": 28.14, "text": "请你说明交易审查情况"}, {"start": 28.54, "end": 29.46, "text": "若程序有问题"}, {"start": 29.46, "end": 30.66, "text": "就依法补充核验"}, {"start": 30.82, "end": 31.9, "text": "承担相应责任"}, {"start": 32.26, "end": 32.86, "text": "五队长"}, {"start": 33.59, "end": 35.03, "text": "交易双方手续齐全"}, {"start": 35.7, "end": 37.14, "text": "若涉及出口管制"}, {"start": 37.26, "end": 39.86, "text": "请依法说明依据并启动审查"}, {"start": 40.34, "end": 41.14, "text": "我会配合"}, {"start": 42.08, "end": 42.88, "text": "五队长"}, {"start": 43.66, "end": 45.14, "text": "说话可得讲证据"}, {"start": 45.38, "end": 47.02, "text": "那件东西公开拍卖"}, {"start": 47.1, "end": 48.54, "text": "不是你之前亲口允许的"}]}