{"file": "宝星行-第1集.mp4", "ep": 1, "duration": 127.8, "segments": [{"start": 0.66, "end": 1.66, "text": "这是帝王律"}, {"start": 1.66, "end": 2.66, "text": "我就挖个红鼠"}, {"start": 2.66, "end": 3.66, "text": "怎么挖出这东西了"}, {"start": 3.66, "end": 4.66, "text": "欠我四千五的房租"}, {"start": 4.66, "end": 5.66, "text": "就拿块破石头铁"}, {"start": 5.66, "end": 6.66, "text": "你先别挂"}, {"start": 6.66, "end": 7.66, "text": "我擦干净再看"}, {"start": 7.66, "end": 8.66, "text": "玻璃也有绿的"}, {"start": 8.66, "end": 9.66, "text": "别糊弄我"}, {"start": 9.66, "end": 10.66, "text": "明天钱必须到账"}, {"start": 10.66, "end": 11.66, "text": "行 明天还你"}, {"start": 11.66, "end": 12.66, "text": "面试跑了几十家"}, {"start": 12.66, "end": 13.66, "text": "车费全搭进去了"}, {"start": 13.66, "end": 14.66, "text": "半毛钱没正常"}, {"start": 14.66, "end": 16.66, "text": "还不如回来挖地"}, {"start": 16.66, "end": 18.97, "text": "在地底下"}, {"start": 18.97, "end": 19.97, "text": "哪来的太阳"}, {"start": 20.97, "end": 28.98, "text": "真通知另一个地方"}, {"start": 29.98, "end": 31.26, "text": "怎么这么沉"}, {"start": 31.26, "end": 32.26, "text": "这边的重力"}, {"start": 32.26, "end": 34.26, "text": "起码有家里的两倍"}, {"start": 34.26, "end": 37.19, "text": "爷爷从三岁就逼我练通天泉"}, {"start": 37.19, "end": 38.19, "text": "十九年没断过"}, {"start": 38.19, "end": 39.19, "text": "今天要是没这身力气"}, {"start": 39.19, "end": 40.19, "text": "连门都出不去"}, {"start": 40.19, "end": 41.19, "text": "趁到外星球了"}, {"start": 41.19, "end": 44.59, "text": "狗头巾"}, {"start": 46.62, "end": 47.62, "text": "起来"}, {"start": 47.62, "end": 49.97, "text": "幻物图件里见过"}, {"start": 49.97, "end": 51.97, "text": "这种天然金块就长这样"}, {"start": 51.97, "end": 52.97, "text": "家里挖出翡翠"}, {"start": 52.97, "end": 53.97, "text": "这里还有金子"}, {"start": 53.97, "end": 54.97, "text": "这条路可得寄牢了"}, {"start": 54.97, "end": 55.97, "text": "拿回地球"}, {"start": 55.97, "end": 56.97, "text": "四十多金总有吧"}, {"start": 56.97, "end": 57.97, "text": "这么大一块天然狗头巾"}, {"start": 57.97, "end": 58.97, "text": "七百万"}, {"start": 58.97, "end": 59.97, "text": "兴许都有人买"}, {"start": 59.97, "end": 60.97, "text": "能充下来这么大的"}, {"start": 60.97, "end": 61.97, "text": "上面肯定还有"}, {"start": 61.97, "end": 66.14, "text": "金子还能一把一把捡"}, {"start": 66.14, "end": 67.14, "text": "这地方"}, {"start": 67.14, "end": 68.14, "text": "就叫保兴吧"}, {"start": 70.52, "end": 73.06, "text": "坏了"}, {"start": 73.06, "end": 74.06, "text": "这也是翡翠"}, {"start": 74.06, "end": 78.35, "text": "阳绿"}, {"start": 78.35, "end": 79.96, "text": "这块有"}, {"start": 79.96, "end": 80.96, "text": "这一整块大石头"}, {"start": 80.96, "end": 81.96, "text": "全是翡翠"}, {"start": 81.96, "end": 82.96, "text": "早知道带个带子"}, {"start": 82.96, "end": 83.96, "text": "光顾着带刀了"}, {"start": 85.96, "end": 86.96, "text": "走 走"}, {"start": 88.31, "end": 89.31, "text": "今天够了"}, {"start": 89.31, "end": 97.99, "text": "先回去"}, {"start": 97.99, "end": 104.78, "text": "回来了"}, {"start": 104.78, "end": 109.14, "text": "四十多金"}, {"start": 109.14, "end": 110.14, "text": "还真让我猜着了"}, {"start": 110.14, "end": 111.14, "text": "以前先兜里有土"}, {"start": 111.14, "end": 113.14, "text": "现在连土都不敢扔了"}, {"start": 113.14, "end": 114.14, "text": "先买金子"}, {"start": 118.63, "end": 119.63, "text": "翡翠也带一块"}, {"start": 119.63, "end": 120.63, "text": "看看城里收什么价"}, {"start": 120.63, "end": 125.58, "text": "最后帮我跑一趟"}, {"start": 125.58, "end": 126.58, "text": "明天回来就给你退休"}]}