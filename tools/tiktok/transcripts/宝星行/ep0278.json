{"file": "宝星行-第278集.mp4", "ep": 278, "duration": 46.7, "segments": [{"start": 0.0, "end": 1.44, "text": "就回校教论文马上得走"}, {"start": 1.44, "end": 2.12, "text": "没时间去了"}, {"start": 2.12, "end": 2.76, "text": "恋爱"}, {"start": 2.76, "end": 3.56, "text": "哪个姑娘啊"}, {"start": 3.56, "end": 4.56, "text": "你小子可以啊"}, {"start": 4.56, "end": 5.6, "text": "是摩督本地人"}, {"start": 5.6, "end": 7.08, "text": "我们公司副总的女儿"}, {"start": 7.08, "end": 8.2, "text": "长相八十分吧"}, {"start": 8.2, "end": 9.76, "text": "但大小姐脾气大得很"}, {"start": 9.76, "end": 11.12, "text": "性格很糟糕"}, {"start": 11.12, "end": 12.4, "text": "最麻烦的是"}, {"start": 12.4, "end": 13.32, "text": "她怀孕了"}, {"start": 13.32, "end": 14.6, "text": "我得放肆成婚"}, {"start": 14.6, "end": 16.04, "text": "现在正交头烂额呢"}, {"start": 16.04, "end": 17.72, "text": "天天被女方家瞧不起"}, {"start": 17.72, "end": 18.88, "text": "哪有心情吹水"}, {"start": 19.4, "end": 20.64, "text": "放肆成婚"}, {"start": 20.64, "end": 22.0, "text": "摩督副总的女儿"}, {"start": 22.0, "end": 23.16, "text": "杨波这小子还没毕业"}, {"start": 23.16, "end": 24.32, "text": "就入坠吃软饭"}, {"start": 24.32, "end": 25.64, "text": "没房没车没地位"}, {"start": 25.64, "end": 27.52, "text": "在摩督被女方指着鼻子骂"}, {"start": 27.52, "end": 30.4, "text": "这一辈子都要抬不起头了呀"}, {"start": 30.4, "end": 31.04, "text": "老杨"}, {"start": 31.04, "end": 32.08, "text": "什么时候办婚事"}, {"start": 32.08, "end": 36.76, "text": "大娘"}, {"start": 36.76, "end": 37.64, "text": "必须去"}, {"start": 37.64, "end": 38.64, "text": "我和张通说一声"}, {"start": 38.64, "end": 40.6, "text": "到时我们开超跑去摩督"}, {"start": 40.6, "end": 41.44, "text": "兄弟"}, {"start": 41.44, "end": 44.96, "text": "绝对给你"}, {"start": 44.96, "end": 46.68, "text": "撑起最大的排庙"}]}