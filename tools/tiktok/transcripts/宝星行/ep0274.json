{"file": "宝星行-第274集.mp4", "ep": 274, "duration": 48.0, "segments": [{"start": 0.0, "end": 1.16, "text": "也不能不知截至"}, {"start": 2.06, "end": 4.5, "text": "買幾套喚喜的衣服和包包就夠了"}, {"start": 4.9, "end": 6.1, "text": "金店和珠寶店"}, {"start": 6.26, "end": 7.22, "text": "咱們就不去了"}, {"start": 8.54, "end": 9.46, "text": "青絲說得對"}, {"start": 9.74, "end": 11.06, "text": "不能浪費老闆的錢"}, {"start": 11.3, "end": 11.86, "text": "懂事"}, {"start": 12.89, "end": 14.33, "text": "不過珠寶的事不用急"}, {"start": 15.17, "end": 17.13, "text": "回頭我給你們弄更頂級的"}, {"start": 17.86, "end": 19.22, "text": "寶星機緣無數"}, {"start": 19.66, "end": 21.7, "text": "頂級的宇宙寶石隨處可循"}, {"start": 22.42, "end": 24.86, "text": "商場裡這些工業加工品根本比不上"}, {"start": 25.41, "end": 26.21, "text": "天啊"}, {"start": 26.57, "end": 28.53, "text": "一人帶八個頂級笑話逛街"}, {"start": 28.85, "end": 30.49, "text": "這是哪家的超級大少啊"}, {"start": 30.69, "end": 31.97, "text": "比王聰聰還要高調"}, {"start": 31.97, "end": 33.05, "text": "王聰聰算什麼"}, {"start": 33.21, "end": 34.29, "text": "他配跟這位比嗎"}, {"start": 34.57, "end": 35.29, "text": "這位姓張"}, {"start": 35.41, "end": 36.13, "text": "外號飛哥"}, {"start": 36.21, "end": 36.97, "text": "才二十二歲"}, {"start": 37.09, "end": 38.01, "text": "大四還沒畢業"}, {"start": 38.17, "end": 39.01, "text": "創業兩個月"}, {"start": 39.09, "end": 40.21, "text": "狂賺七百多億"}, {"start": 40.57, "end": 43.37, "text": "狂賺七百多億"}, {"start": 43.85, "end": 44.73, "text": "難道是傳說中"}, {"start": 44.81, "end": 46.49, "text": "那個就跳樓女孩的蒙面飛人"}, {"start": 46.85, "end": 47.49, "text": "就是她"}]}