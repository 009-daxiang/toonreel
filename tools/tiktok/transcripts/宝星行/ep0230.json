{"file": "宝星行-第230集.mp4", "ep": 230, "duration": 47.7, "segments": [{"start": 0.0, "end": 1.0, "text": "能一时无忧"}, {"start": 1.6, "end": 2.9, "text": "但若是嫁个男人"}, {"start": 3.2, "end": 5.3, "text": "要伺候公公婆婆和丈夫"}, {"start": 5.6, "end": 6.5, "text": "多累啊"}, {"start": 7.23, "end": 9.23, "text": "还是现在的生活幸福甜蜜"}, {"start": 9.53, "end": 11.43, "text": "这个我们认识没多久"}, {"start": 11.73, "end": 13.13, "text": "互相之间还很不了解"}, {"start": 13.73, "end": 14.43, "text": "所以"}, {"start": 14.53, "end": 15.73, "text": "这事我不能答应你"}, {"start": 16.03, "end": 17.03, "text": "将来再说好吗"}, {"start": 17.23, "end": 18.63, "text": "你已经很了解我了呀"}, {"start": 19.23, "end": 20.83, "text": "你不是知道了我的情况吗"}, {"start": 21.03, "end": 22.23, "text": "上次和你说过了"}, {"start": 22.23, "end": 23.43, "text": "我也没谈过男朋友"}, {"start": 23.43, "end": 24.43, "text": "没恋爱经验"}, {"start": 24.53, "end": 26.13, "text": "我是对你的为人不了解"}, {"start": 26.43, "end": 27.73, "text": "对你的性格不了解"}, {"start": 28.29, "end": 29.69, "text": "比如你会不会很吃醋"}, {"start": 30.42, "end": 32.52, "text": "比如你是不是有很强的掌控欲"}, {"start": 32.72, "end": 34.02, "text": "我不喜欢吃醋的"}, {"start": 34.32, "end": 35.82, "text": "也没很强的掌控欲"}, {"start": 37.01, "end": 39.22, "text": "你被人性"}, {"start": 39.52, "end": 41.22, "text": "若自己成了他的男朋友"}, {"start": 41.52, "end": 42.42, "text": "他能不吃醋"}, {"start": 43.15, "end": 44.75, "text": "能不想掌控我的财富"}, {"start": 45.77, "end": 47.57, "text": "我才不想这么早谈女朋友"}]}