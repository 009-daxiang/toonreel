{"file": "宝星行-第291集.mp4", "ep": 291, "duration": 51.5, "segments": [{"start": 0.0, "end": 1.0, "text": "越来越迷人了"}, {"start": 1.0, "end": 1.4, "text": "青丝"}, {"start": 1.4, "end": 2.4, "text": "你整个人都在发光"}, {"start": 2.4, "end": 3.0, "text": "这车"}, {"start": 3.0, "end": 3.8, "text": "这位就是你老板"}, {"start": 3.8, "end": 4.8, "text": "这是我老板张通"}, {"start": 4.8, "end": 5.4, "text": "天大老板"}, {"start": 5.4, "end": 5.8, "text": "老板"}, {"start": 5.8, "end": 6.8, "text": "这是我闺蜜许兰"}, {"start": 6.8, "end": 7.4, "text": "你好"}, {"start": 7.4, "end": 8.0, "text": "许小姐"}, {"start": 8.0, "end": 9.0, "text": "张先生你好"}, {"start": 9.0, "end": 10.4, "text": "能接待您是我的荣幸"}, {"start": 11.61, "end": 12.61, "text": "这女人还真信了"}, {"start": 12.61, "end": 13.81, "text": "柳青丝的玩笑话"}, {"start": 13.81, "end": 14.41, "text": "老板"}, {"start": 14.41, "end": 15.21, "text": "你这么帅"}, {"start": 15.21, "end": 16.01, "text": "这么有钱"}, {"start": 16.01, "end": 16.81, "text": "换哪个女人"}, {"start": 16.81, "end": 17.81, "text": "不想沾沾光呀"}, {"start": 17.81, "end": 18.81, "text": "放心"}, {"start": 18.81, "end": 20.61, "text": "我会替你看紧门户的"}, {"start": 20.61, "end": 21.61, "text": "少凭嘴"}, {"start": 21.61, "end": 22.61, "text": "看房"}, {"start": 24.58, "end": 25.78, "text": "张先生您看"}, {"start": 25.78, "end": 26.78, "text": "建筑面积整整"}, {"start": 26.78, "end": 27.98, "text": "一千四百多平米"}, {"start": 27.98, "end": 28.98, "text": "内部装有专梯"}, {"start": 28.98, "end": 30.18, "text": "配有五十人会议亭"}, {"start": 30.18, "end": 31.38, "text": "和楼顶辽望塔"}, {"start": 31.38, "end": 32.98, "text": "后花园一千多平"}, {"start": 32.98, "end": 34.38, "text": "自带无边界孔池"}, {"start": 34.38, "end": 35.38, "text": "直升机庭周平"}, {"start": 35.38, "end": 36.78, "text": "和私人游艇码头"}, {"start": 36.78, "end": 38.78, "text": "更有巴车位的地下恒温车库"}, {"start": 38.78, "end": 39.58, "text": "太美了"}, {"start": 39.58, "end": 40.58, "text": "四面环水"}, {"start": 40.58, "end": 41.98, "text": "推开窗就是万抢避云"}, {"start": 41.98, "end": 42.38, "text": "老板"}, {"start": 42.38, "end": 43.38, "text": "我太喜欢这里了"}, {"start": 43.38, "end": 44.18, "text": "事业开阔"}, {"start": 44.18, "end": 45.18, "text": "与事隔绝"}, {"start": 45.18, "end": 46.38, "text": "确实跳不出毛病"}, {"start": 46.38, "end": 46.98, "text": "张斗"}, {"start": 46.98, "end": 47.78, "text": "这套是全武城"}, {"start": 47.78, "end": 48.78, "text": "无可替代的楼王"}, {"start": 48.78, "end": 49.58, "text": "之前有好几位"}, {"start": 49.58, "end": 50.78, "text": "上市企业董事来看过"}, {"start": 50.78, "end": 51.58, "text": "价格吗"}]}