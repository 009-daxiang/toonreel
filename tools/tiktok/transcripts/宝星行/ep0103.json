{"file": "宝星行-第103集.mp4", "ep": 103, "duration": 52.6, "segments": [{"start": 0.0, "end": 0.8, "text": "零力两惊人"}, {"start": 1.04, "end": 2.4, "text": "是空中的顶级补尸者"}, {"start": 2.4, "end": 3.56, "text": "藏怪木丛根本没用"}, {"start": 3.56, "end": 4.96, "text": "他们在高处看得一清二楚"}, {"start": 4.96, "end": 5.4, "text": "王财"}, {"start": 5.4, "end": 5.92, "text": "别愣着"}, {"start": 5.92, "end": 6.84, "text": "往大山裂封跑"}, {"start": 6.84, "end": 7.36, "text": "快"}, {"start": 10.6, "end": 11.2, "text": "快开"}, {"start": 11.92, "end": 16.57, "text": "好强的冲击"}, {"start": 16.57, "end": 17.81, "text": "正面硬拼太吃亏"}, {"start": 18.01, "end": 19.25, "text": "得尽快撤冲山放"}, {"start": 23.62, "end": 24.66, "text": "变毛新兽"}, {"start": 27.53, "end": 28.21, "text": "糟了"}, {"start": 35.36, "end": 36.56, "text": "你想摔死我"}, {"start": 36.92, "end": 38.72, "text": "做你们的春秋大梦去吧"}, {"start": 44.28, "end": 45.4, "text": "看傻了吧"}, {"start": 47.53, "end": 48.57, "text": "既然逃不开"}, {"start": 48.93, "end": 49.69, "text": "那就来"}]}