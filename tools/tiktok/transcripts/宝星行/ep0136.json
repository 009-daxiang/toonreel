{"file": "宝星行-第136集.mp4", "ep": 136, "duration": 53.5, "segments": [{"start": 0.0, "end": 0.96, "text": "竟然给我拍照"}, {"start": 0.96, "end": 2.24, "text": "发群中让我出丑"}, {"start": 2.24, "end": 3.04, "text": "你还说不认识"}, {"start": 3.04, "end": 4.24, "text": "赵倩爱上的那个人"}, {"start": 4.84, "end": 5.84, "text": "我怎么卑鄙了"}, {"start": 6.12, "end": 7.6, "text": "我说的句句属实"}, {"start": 8.4, "end": 9.04, "text": "张通"}, {"start": 9.44, "end": 9.92, "text": "你"}, {"start": 10.28, "end": 11.68, "text": "你是怎么追到赵倩的"}, {"start": 12.16, "end": 13.48, "text": "不会是用了卑鄙手段吧"}, {"start": 15.13, "end": 15.69, "text": "追"}, {"start": 16.44, "end": 17.36, "text": "我可没追过他"}, {"start": 17.69, "end": 18.65, "text": "你放屁"}, {"start": 18.89, "end": 20.49, "text": "难道还是他倒追你不成"}, {"start": 21.85, "end": 23.41, "text": "其实赵倩不是我女朋友"}, {"start": 23.69, "end": 24.25, "text": "真的"}, {"start": 24.57, "end": 25.93, "text": "难道刚才是在演戏"}, {"start": 26.09, "end": 27.33, "text": "就是想要打击我"}, {"start": 27.53, "end": 28.45, "text": "我就知道"}, {"start": 28.69, "end": 29.41, "text": "女神怎么可能"}, {"start": 29.41, "end": 30.65, "text": "看上一个卖水果的"}, {"start": 32.26, "end": 33.86, "text": "赵倩仅仅是我的秘书"}, {"start": 34.26, "end": 34.94, "text": "你懂的"}, {"start": 37.39, "end": 38.35, "text": "你胡说八道"}, {"start": 38.63, "end": 39.64, "text": "打死你"}, {"start": 40.32, "end": 41.84, "text": "我怎么就胡说八道了"}, {"start": 42.92, "end": 43.92, "text": "你一个卖水果的"}, {"start": 43.92, "end": 45.08, "text": "怎么就可能有秘书"}, {"start": 45.7, "end": 46.74, "text": "这么荒唐的事"}, {"start": 46.94, "end": 47.86, "text": "谁会相信"}, {"start": 49.26, "end": 49.98, "text": "卖水果的"}, {"start": 49.98, "end": 51.3, "text": "怎么就不能有秘书了"}, {"start": 51.9, "end": 52.78, "text": "谁规定的"}, {"start": 53.18, "end": 53.58, "text": "反正"}]}