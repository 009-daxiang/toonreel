{"file": "宝星行-第167集.mp4", "ep": 167, "duration": 53.5, "segments": [{"start": 0.0, "end": 2.44, "text": "原东南战区列英特战大队中队长王豪"}, {"start": 3.16, "end": 4.72, "text": "从今天起你就是天保安保部门的队长"}, {"start": 4.72, "end": 5.36, "text": "包括牛膏在内"}, {"start": 5.36, "end": 6.12, "text": "这使人归你调配"}, {"start": 6.12, "end": 6.76, "text": "换上安保制服"}, {"start": 6.76, "end": 7.48, "text": "即刻上岗之情"}, {"start": 7.48, "end": 8.48, "text": "保证完成任务"}, {"start": 8.48, "end": 9.08, "text": "全员换装"}, {"start": 9.08, "end": 9.6, "text": "登岗"}, {"start": 9.6, "end": 10.88, "text": "十个特战兵王战港"}, {"start": 10.88, "end": 13.36, "text": "这排面简直吊打全市所有商业大厦"}, {"start": 13.36, "end": 14.12, "text": "李云经理"}, {"start": 14.12, "end": 15.68, "text": "财务部门由你全权统筹"}, {"start": 15.68, "end": 17.32, "text": "账目必须做到分毫不差"}, {"start": 17.32, "end": 19.2, "text": "罗芳老师负责珠宝玉旗鉴定"}, {"start": 19.2, "end": 20.88, "text": "证文老师主公古玩子画"}, {"start": 20.88, "end": 22.52, "text": "各位待遇一律案顶格执行"}, {"start": 22.52, "end": 23.24, "text": "至于罗胖"}, {"start": 23.24, "end": 24.72, "text": "你负责同管人事招聘"}, {"start": 24.72, "end": 25.72, "text": "请张董放心"}, {"start": 25.72, "end": 27.56, "text": "财务流水绝对严肆合奉"}, {"start": 27.56, "end": 28.68, "text": "定不负张总统"}, {"start": 28.68, "end": 29.88, "text": "人事经理"}, {"start": 29.88, "end": 31.04, "text": "胖言我现在也是高管了"}, {"start": 31.04, "end": 31.96, "text": "下午的笑话面试"}, {"start": 31.96, "end": 33.84, "text": "看我怎么大闲神手"}, {"start": 33.84, "end": 34.4, "text": "老板"}, {"start": 34.4, "end": 35.88, "text": "下午面试的前台和文员"}, {"start": 35.88, "end": 37.4, "text": "足足有三百多人递交了简历"}, {"start": 37.4, "end": 38.32, "text": "大厅可能做不下"}, {"start": 38.32, "end": 39.2, "text": "是啊老板"}, {"start": 39.2, "end": 40.8, "text": "听说各大高校的笑话赶过来了"}, {"start": 40.8, "end": 41.52, "text": "竞争大着呢"}, {"start": 41.52, "end": 42.0, "text": "通哥"}, {"start": 42.0, "end": 43.0, "text": "你这左拥右报的"}, {"start": 43.0, "end": 44.48, "text": "简直比古代皇帝还要享受啊"}, {"start": 44.48, "end": 44.84, "text": "罗经理"}, {"start": 44.84, "end": 46.12, "text": "咱们老板年纪情就应极一自产"}, {"start": 46.12, "end": 46.92, "text": "这匪夀和豪车"}, {"start": 46.92, "end": 47.96, "text": "到底是怎么打拼出来的"}, {"start": 47.96, "end": 49.04, "text": "跟兄弟透露透露呗"}, {"start": 49.04, "end": 50.4, "text": "这你就不懂了吧"}, {"start": 50.4, "end": 52.0, "text": "我们老板那是天降福星"}, {"start": 52.0, "end": 53.32, "text": "堵实全靠一双神眼"}, {"start": 53.32, "end": 53.52, "text": "去"}]}