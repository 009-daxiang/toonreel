{"file": "宝星行-第39集.mp4", "ep": 39, "duration": 53.4, "segments": [{"start": 0.0, "end": 1.08, "text": "消耗到底算什么"}, {"start": 1.08, "end": 1.72, "text": "好"}, {"start": 1.72, "end": 2.88, "text": "请老板爽快"}, {"start": 2.88, "end": 4.32, "text": "就按三百万一斤成交"}, {"start": 5.79, "end": 6.43, "text": "张先生"}, {"start": 6.43, "end": 7.59, "text": "总中一千一百斤整"}, {"start": 7.59, "end": 9.07, "text": "合计三十三亿元人民币"}, {"start": 9.07, "end": 11.03, "text": "款项已经全额打入您的个人收款账户"}, {"start": 11.03, "end": 11.67, "text": "请查收"}, {"start": 11.67, "end": 13.41, "text": "顶您的账户已会入人"}, {"start": 13.41, "end": 17.82, "text": "三千三两三两百五厘"}, {"start": 17.82, "end": 19.06, "text": "诸位老板刘布"}, {"start": 19.06, "end": 21.78, "text": "必人近期会筹办一家私人拍卖行"}, {"start": 21.78, "end": 24.46, "text": "后续会有源源不断的集品匪翠明料"}, {"start": 24.46, "end": 26.1, "text": "与西式奇珍面试"}, {"start": 26.1, "end": 28.3, "text": "到时还请各位赏光"}, {"start": 28.3, "end": 29.46, "text": "一定到场"}, {"start": 29.46, "end": 30.9, "text": "只要张先生有货"}, {"start": 30.9, "end": 32.9, "text": "我秦朝诸保随教随道"}, {"start": 32.94, "end": 35.02, "text": "现在缅甸老坑几乎挖空了"}, {"start": 35.02, "end": 37.22, "text": "张先生能提供如此高质量的明料"}, {"start": 37.22, "end": 38.54, "text": "简直是我们的旧行"}, {"start": 38.54, "end": 39.9, "text": "必须通知我们"}, {"start": 39.9, "end": 41.38, "text": "我建了一个通天保务群"}, {"start": 41.38, "end": 43.02, "text": "大家先进群"}, {"start": 43.02, "end": 44.02, "text": "后续拍卖信息"}, {"start": 44.02, "end": 45.18, "text": "时时在群内公布"}, {"start": 48.9, "end": 49.5, "text": "张通"}, {"start": 49.5, "end": 50.38, "text": "恭喜你"}, {"start": 50.38, "end": 52.42, "text": "一天之内狂赚四十四亿"}, {"start": 52.42, "end": 53.42, "text": "你在整个高端中"}]}