{"file": "宝星行-第10集.mp4", "ep": 10, "duration": 53.2, "segments": [{"start": 0.0, "end": 0.64, "text": "买房的"}, {"start": 0.64, "end": 1.48, "text": "买房"}, {"start": 1.48, "end": 2.0, "text": "兄弟"}, {"start": 2.0, "end": 3.28, "text": "吹牛也不打草稿"}, {"start": 3.28, "end": 4.56, "text": "知道这里是什么地方吗"}, {"start": 4.56, "end": 5.52, "text": "天蓝一号"}, {"start": 5.52, "end": 7.36, "text": "乡城最顶级的富人区"}, {"start": 7.36, "end": 8.4, "text": "里面的独栋别墅"}, {"start": 8.4, "end": 9.76, "text": "最低两千万一套"}, {"start": 9.76, "end": 11.0, "text": "你登个收费品的三轮车"}, {"start": 11.0, "end": 11.76, "text": "来买房"}, {"start": 11.76, "end": 13.0, "text": "买房看的是银行卡"}, {"start": 13.0, "end": 14.0, "text": "不是看交通工具"}, {"start": 14.0, "end": 15.2, "text": "赶紧把车取走"}, {"start": 15.2, "end": 16.36, "text": "别挡在售楼处大门口"}, {"start": 16.36, "end": 17.48, "text": "影响侍容"}, {"start": 17.48, "end": 18.72, "text": "要是开辆大奔来"}, {"start": 18.72, "end": 20.28, "text": "我二话不说给你敬礼"}, {"start": 20.28, "end": 21.28, "text": "开三轮车"}, {"start": 21.28, "end": 22.92, "text": "连大门台阶你都别想碰"}, {"start": 22.92, "end": 24.0, "text": "行"}, {"start": 24.0, "end": 25.8, "text": "狗眼看人低得我见多了"}, {"start": 25.8, "end": 26.8, "text": "不差你这一个"}, {"start": 26.8, "end": 28.16, "text": "待会我全款拿下别书"}, {"start": 28.16, "end": 29.44, "text": "办完手续"}, {"start": 29.44, "end": 30.28, "text": "看你这个看门狗"}, {"start": 30.28, "end": 36.16, "text": "怎么给我背笑脸"}, {"start": 36.16, "end": 37.08, "text": "绝了"}, {"start": 37.08, "end": 38.36, "text": "这身材这颜值"}, {"start": 38.36, "end": 39.08, "text": "鸟杀网上所有"}, {"start": 39.08, "end": 40.08, "text": "擦边网红十条街"}, {"start": 40.08, "end": 41.16, "text": "听说这是乡中大学的"}, {"start": 41.16, "end": 42.56, "text": "顶榴笑花照倩"}, {"start": 42.56, "end": 43.48, "text": "绿光园为了卖这批"}, {"start": 43.48, "end": 44.32, "text": "滞销的顶接别兽"}, {"start": 44.32, "end": 45.0, "text": "吓了血身"}, {"start": 45.0, "end": 46.6, "text": "请他来当特摇形象模特"}, {"start": 46.6, "end": 47.6, "text": "可惜啊"}, {"start": 47.6, "end": 48.8, "text": "听说在学校里追他的人"}, {"start": 48.8, "end": 50.04, "text": "能排到橘子周头"}, {"start": 50.04, "end": 51.16, "text": "富二代送豪车钻戒"}, {"start": 51.16, "end": 52.16, "text": "全被他拒绝了"}, {"start": 52.16, "end": 53.16, "text": "高冷得很"}]}