{"file": "宝星行-第290集.mp4", "ep": 290, "duration": 48.7, "segments": [{"start": 0.0, "end": 0.6, "text": "我们马上到"}, {"start": 0.6, "end": 1.6, "text": "我要发财"}, {"start": 1.6, "end": 4.29, "text": "许兰"}, {"start": 4.29, "end": 5.89, "text": "大呼小叫的成何体统"}, {"start": 5.89, "end": 6.89, "text": "发什么神经"}, {"start": 6.89, "end": 7.89, "text": "何经理"}, {"start": 7.89, "end": 9.89, "text": "我闺蜜带大老板来买别墅了"}, {"start": 9.89, "end": 10.89, "text": "点名要五成最贵的那套"}, {"start": 10.89, "end": 11.89, "text": "最贵的那套"}, {"start": 11.89, "end": 13.89, "text": "汤迅湖湖新岛的独岛庄员"}, {"start": 13.89, "end": 14.89, "text": "挂牌8800万"}, {"start": 14.89, "end": 16.89, "text": "顶级老总来看了都肉疼"}, {"start": 16.89, "end": 17.89, "text": "你闺蜜带个客人就能买"}, {"start": 17.89, "end": 18.89, "text": "就是"}, {"start": 18.89, "end": 19.89, "text": "全五成有几个"}, {"start": 19.89, "end": 21.89, "text": "掏出八千桌外买四岁的"}, {"start": 21.89, "end": 22.89, "text": "八成是拿你寻开心呢"}, {"start": 22.89, "end": 23.89, "text": "你那闺蜜是干什么的"}, {"start": 23.89, "end": 25.89, "text": "能认识这好通天人物"}, {"start": 25.89, "end": 27.89, "text": "他做大主播和首席拍卖师"}, {"start": 27.89, "end": 28.89, "text": "平时接触的全是顶级富豪"}, {"start": 28.89, "end": 30.89, "text": "人品极好从不说大话"}, {"start": 30.89, "end": 31.89, "text": "网红模特"}, {"start": 31.89, "end": 32.89, "text": "那就更悬了"}, {"start": 32.89, "end": 33.89, "text": "负一代都不舍得买"}, {"start": 33.89, "end": 34.89, "text": "哪个不学无数的二世存"}, {"start": 34.89, "end": 35.89, "text": "能掏出尽异现潮"}, {"start": 35.89, "end": 36.89, "text": "行了别做白日梦了"}, {"start": 36.89, "end": 37.89, "text": "回岗位去"}, {"start": 37.89, "end": 38.89, "text": "五成什么时候有"}, {"start": 38.89, "end": 42.81, "text": "这种级别的神豪了"}, {"start": 42.81, "end": 43.81, "text": "两千多万的拉菲利"}, {"start": 43.81, "end": 44.81, "text": "天哪"}, {"start": 44.81, "end": 45.81, "text": "所有人立刻迎上去"}, {"start": 45.81, "end": 46.81, "text": "这是真正的大神仙"}, {"start": 46.81, "end": 47.81, "text": "许兰好久不见"}]}