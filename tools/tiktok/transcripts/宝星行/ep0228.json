{"file": "宝星行-第228集.mp4", "ep": 228, "duration": 46.6, "segments": [{"start": 0.46, "end": 1.74, "text": "是范芊香"}, {"start": 2.0, "end": 3.28, "text": "深耕半夜的"}, {"start": 3.54, "end": 5.84, "text": "千宝集团的大小姐怎么突然跑过来了"}, {"start": 6.1, "end": 6.86, "text": "去开门吧"}, {"start": 7.12, "end": 7.88, "text": "请她进来"}, {"start": 8.4, "end": 11.2, "text": "张大董事长夜生活过得可真是多自多彩啊"}, {"start": 11.46, "end": 14.02, "text": "深耕半夜不请自来该不会打扰了你的好事吧"}, {"start": 14.28, "end": 16.34, "text": "范大美女大驾光临寒舍蓬避声灰"}, {"start": 16.58, "end": 17.1, "text": "怎么会打扰"}, {"start": 17.36, "end": 17.62, "text": "赵倩"}, {"start": 17.86, "end": 18.38, "text": "奉茶"}, {"start": 19.22, "end": 20.24, "text": "范总请用茶"}, {"start": 20.74, "end": 21.26, "text": "快听"}, {"start": 21.76, "end": 24.08, "text": "这白富美大半夜开跑车送上门来"}, {"start": 24.58, "end": 26.12, "text": "绝对是想盗追我们老板"}, {"start": 27.53, "end": 28.81, "text": "豪门千金又如何"}, {"start": 29.07, "end": 30.87, "text": "我们老板一个人就是顶隔豪门"}, {"start": 30.91, "end": 31.67, "text": "他想的美"}, {"start": 32.58, "end": 33.08, "text": "张通"}, {"start": 33.79, "end": 34.81, "text": "我今天来找你"}, {"start": 35.07, "end": 35.83, "text": "不谈虚的"}, {"start": 36.61, "end": 38.41, "text": "我们范家名下的常康医药"}, {"start": 38.91, "end": 39.69, "text": "遇到大麻烦了"}, {"start": 40.77, "end": 41.53, "text": "只有你能救"}, {"start": 42.05, "end": 42.55, "text": "张通"}, {"start": 42.81, "end": 43.59, "text": "我喜欢你"}, {"start": 43.85, "end": 44.87, "text": "真的很喜欢"}, {"start": 45.13, "end": 46.15, "text": "你可以做我男朋友吗"}]}