{"file": "宝星行-第234集.mp4", "ep": 234, "duration": 47.8, "segments": [{"start": 0.0, "end": 2.44, "text": "情况下还能发出如此犀利的反击"}, {"start": 2.44, "end": 3.72, "text": "它真不简单"}, {"start": 3.72, "end": 5.48, "text": "老板会不会被它说动"}, {"start": 5.48, "end": 7.08, "text": "研究案科学程序走"}, {"start": 7.08, "end": 8.64, "text": "合作案合同谈"}, {"start": 8.64, "end": 10.8, "text": "别拿胃验验证的效果当筹码"}, {"start": 10.8, "end": 12.92, "text": "同天全对体能的强化能够测量"}, {"start": 12.92, "end": 14.72, "text": "保兴也还有无数位置线索"}, {"start": 14.72, "end": 16.2, "text": "与其相信尚未完成的药物"}, {"start": 16.2, "end": 17.8, "text": "不如继续探索 记录数据"}, {"start": 17.8, "end": 19.2, "text": "你这话"}, {"start": 19.2, "end": 20.52, "text": "难道还有另外的意思"}, {"start": 20.52, "end": 22.4, "text": "它竟然对研究成果毫不心动"}, {"start": 22.4, "end": 23.92, "text": "它到底还掌握着什么线索"}, {"start": 23.92, "end": 25.12, "text": "范小姐慢走"}, {"start": 25.12, "end": 26.24, "text": "预注研究项目顺利"}, {"start": 26.24, "end": 28.88, "text": "后续供样案合同和检测结果在谈"}, {"start": 28.88, "end": 29.88, "text": "谢谢"}, {"start": 29.88, "end": 31.0, "text": "竟然催我走"}, {"start": 31.0, "end": 33.4, "text": "耽误你和那群女人的好事了是吗"}, {"start": 33.4, "end": 36.99, "text": "不识台剧的混蛋"}, {"start": 36.99, "end": 38.61, "text": "张通"}, {"start": 38.9, "end": 41.54, "text": "你这个不知好歹的直男"}, {"start": 41.54, "end": 43.54, "text": "我绝不会就这么认输的"}]}