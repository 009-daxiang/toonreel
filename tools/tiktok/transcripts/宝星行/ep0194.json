{"file": "宝星行-第194集.mp4", "ep": 194, "duration": 57.0, "segments": [{"start": 0.0, "end": 2.68, "text": "接下来进行顶级翡翠分断竞拍"}, {"start": 3.32, "end": 4.64, "text": "涵盖级品紫罗兰"}, {"start": 4.64, "end": 6.08, "text": "满绿玻璃种洋绿"}, {"start": 6.08, "end": 8.04, "text": "以及举世罕见的数百斤"}, {"start": 8.04, "end": 9.52, "text": "高冰种鸡油黄"}, {"start": 9.52, "end": 11.08, "text": "又是那种绝品鸡油黄"}, {"start": 11.08, "end": 12.04, "text": "必须全部拿下"}, {"start": 12.04, "end": 14.08, "text": "赵国珠宝出十二亿"}, {"start": 14.08, "end": 15.8, "text": "今天珠宝出十五亿"}, {"start": 17.37, "end": 19.37, "text": "成交 再次成交"}, {"start": 19.89, "end": 21.41, "text": "红宝石家翡翠"}, {"start": 21.41, "end": 23.41, "text": "直接狂揽三百亿现金"}, {"start": 23.81, "end": 26.05, "text": "张通 你这一场拍卖"}, {"start": 26.37, "end": 27.69, "text": "赚得也太吓人了"}, {"start": 27.69, "end": 28.77, "text": "三百亿"}, {"start": 28.97, "end": 30.57, "text": "老板身家突破三百亿了"}, {"start": 30.57, "end": 32.01, "text": "请诸位安静"}, {"start": 32.01, "end": 36.54, "text": "重头戏才刚刚开始"}, {"start": 36.54, "end": 38.78, "text": "下面展拍第三类重宝"}, {"start": 38.78, "end": 42.18, "text": "九珠年份军超千年的传世野山绅"}, {"start": 42.18, "end": 44.38, "text": "起拍底价 每珠一亿元"}, {"start": 45.98, "end": 47.26, "text": "各位贵宾"}, {"start": 47.26, "end": 48.82, "text": "这九根千年人身"}, {"start": 48.82, "end": 50.78, "text": "每一根都重约七斤"}, {"start": 50.78, "end": 52.74, "text": "绝对的真品无疑"}, {"start": 52.74, "end": 54.58, "text": "这九珠是极其罕见的"}, {"start": 54.58, "end": 56.14, "text": "巨型绅类样本"}, {"start": 56.14, "end": 56.94, "text": "此前一珠"}]}