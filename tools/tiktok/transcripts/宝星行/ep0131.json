{"file": "宝星行-第131集.mp4", "ep": 131, "duration": 53.7, "segments": [{"start": 0.0, "end": 0.72, "text": "現場啊"}, {"start": 0.72, "end": 1.92, "text": "這尷尬的都能用腳趾"}, {"start": 1.92, "end": 3.28, "text": "摳出出三十一丁了"}, {"start": 3.28, "end": 4.08, "text": "趙歉同學"}, {"start": 4.08, "end": 5.04, "text": "我是何凱權啊"}, {"start": 5.04, "end": 6.04, "text": "鄉中大學計算機專業"}, {"start": 6.04, "end": 6.84, "text": "大四的何凱權"}, {"start": 6.84, "end": 7.48, "text": "以前在學校的時候"}, {"start": 7.48, "end": 8.44, "text": "我還給你送過花表白過呢"}, {"start": 8.44, "end": 9.76, "text": "追我的人多了去了"}, {"start": 9.76, "end": 11.52, "text": "每天收幾十封情書"}, {"start": 11.52, "end": 12.72, "text": "我憑什麼要記住你"}, {"start": 12.72, "end": 14.0, "text": "我現在已經參加工作了"}, {"start": 14.0, "end": 15.08, "text": "在大公司當副經理"}, {"start": 15.08, "end": 15.88, "text": "月薪五萬"}, {"start": 15.88, "end": 17.12, "text": "剛才路邊那輛奔馳C級"}, {"start": 17.12, "end": 17.84, "text": "就是我的作家"}, {"start": 17.84, "end": 19.2, "text": "月薪五萬加奔馳"}, {"start": 19.2, "end": 20.16, "text": "這條件在應屆生理"}, {"start": 20.16, "end": 21.28, "text": "絕對是鳳毛鄰腳"}, {"start": 21.28, "end": 22.72, "text": "它不可能不動心"}, {"start": 22.72, "end": 24.44, "text": "月薪五萬開個破奔馳"}, {"start": 24.44, "end": 25.6, "text": "很了不起嗎"}, {"start": 25.6, "end": 26.6, "text": "用得著跑大街上"}, {"start": 26.6, "end": 27.72, "text": "逢人就炫養"}, {"start": 27.72, "end": 28.68, "text": "這位同學"}, {"start": 28.68, "end": 30.24, "text": "請你立刻讓開"}, {"start": 30.24, "end": 31.24, "text": "否則我直接報警"}, {"start": 31.24, "end": 32.24, "text": "說你尋釁滋擾"}, {"start": 32.24, "end": 32.92, "text": "讓讓開"}, {"start": 32.92, "end": 33.92, "text": "報警"}, {"start": 33.92, "end": 34.76, "text": "破奔馳"}, {"start": 34.76, "end": 36.28, "text": "她竟然說我的奔馳是破車"}, {"start": 36.28, "end": 37.6, "text": "甚至還要報警抓我"}, {"start": 38.56, "end": 40.04, "text": "大美女霸氣"}, {"start": 40.04, "end": 41.36, "text": "直接無形大耳光"}, {"start": 41.36, "end": 43.04, "text": "摻臉上啊"}, {"start": 43.04, "end": 44.2, "text": "剛才這穿西裝的"}, {"start": 44.2, "end": 44.84, "text": "還看不起我們"}, {"start": 44.84, "end": 45.92, "text": "賣菜賣水果的"}, {"start": 45.92, "end": 47.28, "text": "現在被當成流氓了吧"}, {"start": 47.28, "end": 47.84, "text": "瘋快"}, {"start": 48.84, "end": 50.48, "text": "還不滾開"}, {"start": 50.48, "end": 51.8, "text": "真想去派出所喝茶"}, {"start": 51.8, "end": 52.56, "text": "是不是"}, {"start": 52.56, "end": 53.22, "text": "對"}, {"start": 53.22, "end": 53.7, "text": "對不起"}]}