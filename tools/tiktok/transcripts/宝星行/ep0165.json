{"file": "宝星行-第165集.mp4", "ep": 165, "duration": 51.7, "segments": [{"start": 0.0, "end": 1.4, "text": "老板真是幽默"}, {"start": 1.4, "end": 2.8, "text": "原来真是假的呀"}, {"start": 2.8, "end": 3.8, "text": "那我就不怕了"}, {"start": 4.46, "end": 5.26, "text": "该你了"}, {"start": 5.46, "end": 6.06, "text": "是吧"}, {"start": 6.76, "end": 7.36, "text": "好嘞"}, {"start": 8.47, "end": 9.47, "text": "起"}, {"start": 10.47, "end": 14.76, "text": "真的是五百斤实心重物"}, {"start": 14.96, "end": 15.96, "text": "不是道具"}, {"start": 15.96, "end": 16.76, "text": "那刚才"}, {"start": 17.16, "end": 18.76, "text": "老板单手像林丝辽带一样"}, {"start": 18.76, "end": 19.56, "text": "举过头顶"}, {"start": 19.96, "end": 21.36, "text": "他到底有多大力量"}, {"start": 21.99, "end": 23.19, "text": "单手五百斤"}, {"start": 23.59, "end": 24.79, "text": "气与悬崗"}, {"start": 24.79, "end": 25.79, "text": "力拔山河"}, {"start": 26.19, "end": 28.22, "text": "这才是真正无敌的男人"}, {"start": 29.24, "end": 30.44, "text": "单手举起五百斤"}, {"start": 30.44, "end": 31.84, "text": "远超普通人体表现"}, {"start": 32.04, "end": 33.49, "text": "不可思议了"}, {"start": 33.49, "end": 33.89, "text": "好了"}, {"start": 34.49, "end": 35.29, "text": "放下来吧"}, {"start": 36.92, "end": 37.52, "text": "老板"}, {"start": 37.92, "end": 38.92, "text": "您太神了"}, {"start": 38.92, "end": 40.92, "text": "这石头比暗村的墨盘还沉"}, {"start": 40.92, "end": 42.52, "text": "力气确实没有垂虚"}, {"start": 42.92, "end": 44.32, "text": "打一趟全法我看看"}, {"start": 45.26, "end": 47.26, "text": "全法扎手底子干净"}, {"start": 47.26, "end": 48.26, "text": "从现在起"}, {"start": 48.26, "end": 50.26, "text": "你就是天堡拍卖行的正式保安了"}, {"start": 50.26, "end": 51.26, "text": "月薪三万"}, {"start": 51.26, "end": 51.66, "text": "三十"}]}