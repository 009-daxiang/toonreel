{"file": "宝星行-第141集.mp4", "ep": 141, "duration": 53.6, "segments": [{"start": 0.0, "end": 2.08, "text": "有人要跳楼"}, {"start": 2.08, "end": 3.88, "text": "不会是何差酸想不开吧"}, {"start": 3.88, "end": 5.68, "text": "那个女人好年轻啊"}, {"start": 5.68, "end": 7.08, "text": "我就想不开了"}, {"start": 7.68, "end": 9.48, "text": "站在边缘护墙上太危险了"}, {"start": 9.48, "end": 11.68, "text": "脚底下稍微打滑一下就掉下来了"}, {"start": 11.68, "end": 13.48, "text": "六十层的摩天大楼呀"}, {"start": 13.48, "end": 15.28, "text": "摔下来哪还有命在"}, {"start": 15.28, "end": 16.88, "text": "快过去看看能不能帮忙"}, {"start": 17.63, "end": 18.83, "text": "去看看怎么回事"}, {"start": 23.44, "end": 24.64, "text": "楼层现场有阵风了"}, {"start": 24.64, "end": 26.24, "text": "气垫范围很难精准预判"}, {"start": 26.24, "end": 27.24, "text": "楼顶输导人员"}, {"start": 27.24, "end": 28.84, "text": "千万不要强行靠过去"}, {"start": 28.84, "end": 29.87, "text": "我认识他"}, {"start": 29.87, "end": 30.87, "text": "他叫杨晴"}, {"start": 30.87, "end": 32.07, "text": "今年三十岁"}, {"start": 32.07, "end": 33.67, "text": "名牌大学毕业的高材生"}, {"start": 33.67, "end": 34.47, "text": "家属吗"}, {"start": 34.47, "end": 35.27, "text": "他为什么要轻声"}, {"start": 35.27, "end": 36.47, "text": "知道原因才能对症下药"}, {"start": 36.47, "end": 37.07, "text": "他以做金融"}, {"start": 37.07, "end": 38.27, "text": "后来辞职自己炒期货"}, {"start": 38.27, "end": 39.27, "text": "赚了几千万"}, {"start": 39.27, "end": 40.47, "text": "但最近行情太差"}, {"start": 40.47, "end": 41.67, "text": "亏他只剩几百万"}, {"start": 41.67, "end": 43.07, "text": "剩下几百万也能生活"}, {"start": 43.07, "end": 44.07, "text": "怎么会走绝路"}, {"start": 44.07, "end": 45.07, "text": "他遇到了骗子"}, {"start": 45.07, "end": 46.07, "text": "那个叫何浩的骗子"}, {"start": 46.07, "end": 46.67, "text": "骗了他的感情"}, {"start": 46.67, "end": 47.87, "text": "把他剩下的钱全全跑了"}, {"start": 47.87, "end": 49.27, "text": "偏偏他母亲又查出尿诺症"}, {"start": 49.27, "end": 50.27, "text": "没钱做幻身手术"}, {"start": 50.27, "end": 51.07, "text": "就是等死"}, {"start": 51.07, "end": 52.07, "text": "他彻底绝望了"}, {"start": 52.07, "end": 53.47, "text": "幻身手术需要几十万"}]}