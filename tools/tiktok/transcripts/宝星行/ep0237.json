{"file": "宝星行-第237集.mp4", "ep": 237, "duration": 47.9, "segments": [{"start": 0.0, "end": 0.92, "text": "食堂可以考慮"}, {"start": 0.92, "end": 2.44, "text": "回頭讓後勤部去安排廚師"}, {"start": 2.44, "end": 3.24, "text": "至於美容院"}, {"start": 3.24, "end": 3.76, "text": "太麻煩了"}, {"start": 3.76, "end": 4.36, "text": "就不專門弄了"}, {"start": 4.36, "end": 5.88, "text": "帶你們以後去做美容的開銷"}, {"start": 5.88, "end": 7.68, "text": "拿發票找財務全額報銷"}, {"start": 7.68, "end": 12.58, "text": "老闆"}, {"start": 12.58, "end": 13.54, "text": "好了好了"}, {"start": 13.54, "end": 14.62, "text": "全是孔義"}, {"start": 14.62, "end": 15.74, "text": "天色晚了"}, {"start": 15.74, "end": 17.22, "text": "都趕快回房休息"}, {"start": 17.22, "end": 17.78, "text": "睡覺就"}, {"start": 17.78, "end": 22.93, "text": "今晚做個好夢呀"}, {"start": 22.93, "end": 24.29, "text": "錢有了"}, {"start": 24.29, "end": 25.69, "text": "美人環繞"}, {"start": 25.69, "end": 28.3, "text": "現實裡的日子徹底安穩了"}, {"start": 28.3, "end": 29.74, "text": "但真正的底氣"}, {"start": 29.74, "end": 31.42, "text": "永遠在保信"}, {"start": 31.42, "end": 33.98, "text": "那些深山大海裡更神奇的秘密"}, {"start": 33.98, "end": 35.98, "text": "是時候徹底揭開了"}, {"start": 37.56, "end": 38.52, "text": "老闆"}, {"start": 38.52, "end": 39.68, "text": "不好吧"}, {"start": 39.68, "end": 42.0, "text": "這麼多同事都住在別墅裡"}, {"start": 42.0, "end": 44.0, "text": "我還是去住別的客房吧"}, {"start": 44.0, "end": 45.6, "text": "你還糾結什麼"}, {"start": 45.6, "end": 46.92, "text": "當然是和我睡"}, {"start": 46.92, "end": 48.0, "text": "他們定然會發"}]}