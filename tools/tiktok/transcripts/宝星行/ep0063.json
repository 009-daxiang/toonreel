{"file": "宝星行-第63集.mp4", "ep": 63, "duration": 52.6, "segments": [{"start": 0.0, "end": 0.76, "text": "人生"}, {"start": 0.76, "end": 1.32, "text": "张通"}, {"start": 1.32, "end": 2.04, "text": "你势力好"}, {"start": 2.04, "end": 3.8, "text": "叔叔这上面有多少个卤碗"}, {"start": 3.8, "end": 5.04, "text": "一千零几个卤碗"}, {"start": 5.04, "end": 6.6, "text": "那就是千年人生"}, {"start": 6.6, "end": 7.64, "text": "人生长在地下"}, {"start": 7.64, "end": 8.68, "text": "环境恶劣"}, {"start": 8.68, "end": 9.72, "text": "看这身体上的皮"}, {"start": 9.72, "end": 10.92, "text": "越老色泽越暗"}, {"start": 10.92, "end": 12.12, "text": "卤碗是一年长一个"}, {"start": 12.12, "end": 13.2, "text": "这一千多个卤碗"}, {"start": 13.2, "end": 14.64, "text": "就是一千多年的岁月呀"}, {"start": 14.64, "end": 16.64, "text": "而且这主虚长达四米多"}, {"start": 16.64, "end": 18.08, "text": "只有真正的千年老身"}, {"start": 18.08, "end": 19.44, "text": "虚才会如此简洁"}, {"start": 19.44, "end": 20.12, "text": "这么长"}, {"start": 20.12, "end": 21.96, "text": "传说中的巨型深深类样本"}, {"start": 21.96, "end": 23.4, "text": "竟然真的存在"}, {"start": 23.4, "end": 24.64, "text": "它的成分和药用价值"}, {"start": 24.64, "end": 26.0, "text": "都潜力巨大"}, {"start": 26.0, "end": 27.26, "text": "太好了"}, {"start": 27.26, "end": 29.26, "text": "这一下我爷爷有救了"}, {"start": 29.26, "end": 30.58, "text": "张通 谢谢你"}, {"start": 30.58, "end": 31.18, "text": "认识你"}, {"start": 31.18, "end": 32.58, "text": "真是我的幸运"}, {"start": 32.58, "end": 34.02, "text": "拿人钱财替人消灾"}, {"start": 34.02, "end": 35.42, "text": "不用客气"}, {"start": 35.42, "end": 36.42, "text": "对了孙先生"}, {"start": 36.42, "end": 37.42, "text": "还要请你给这一根"}, {"start": 37.42, "end": 38.7, "text": "千年人生定个价"}, {"start": 38.7, "end": 39.94, "text": "这是无价之宝"}, {"start": 39.94, "end": 41.1, "text": "没办法孤价的"}, {"start": 41.1, "end": 42.46, "text": "但至少是百年人生价格的"}, {"start": 42.46, "end": 43.34, "text": "十倍以上"}, {"start": 43.34, "end": 45.18, "text": "再一价几千万也很正常"}, {"start": 45.18, "end": 46.54, "text": "若拿去顶级拍卖行"}, {"start": 46.54, "end": 48.22, "text": "凭稀缺性和研究价值"}, {"start": 48.22, "end": 49.98, "text": "五千万起步并不夸张"}, {"start": 49.98, "end": 51.14, "text": "五千万"}, {"start": 51.14, "end": 52.42, "text": "我们忙活一个月"}, {"start": 52.42, "end": 52.7, "text": "连"}]}