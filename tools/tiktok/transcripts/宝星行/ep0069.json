{"file": "宝星行-第69集.mp4", "ep": 69, "duration": 52.6, "segments": [{"start": 0.0, "end": 1.4, "text": "抓紧时间 我们测试他的药效"}, {"start": 1.4, "end": 2.72, "text": "先给医疗团队评估"}, {"start": 2.72, "end": 3.76, "text": "只要还有机会"}, {"start": 3.76, "end": 5.12, "text": "我们就配合治疗"}, {"start": 5.12, "end": 5.92, "text": "爸 妈"}, {"start": 5.92, "end": 7.04, "text": "这位就是张通"}, {"start": 7.04, "end": 8.16, "text": "是他凭借大义力"}, {"start": 8.16, "end": 9.4, "text": "在绝境中挖出来的"}, {"start": 9.4, "end": 11.24, "text": "范叔叔 阿姨 你们好"}, {"start": 11.24, "end": 13.36, "text": "张先生 大恩大德"}, {"start": 13.36, "end": 15.56, "text": "你是我范家的再造恩人啊"}, {"start": 15.56, "end": 17.52, "text": "让开 快让老朽长眼"}, {"start": 19.21, "end": 20.49, "text": "气味很和特别"}, {"start": 20.49, "end": 22.25, "text": "我从来没闻过这样的药味"}, {"start": 22.25, "end": 24.01, "text": "再罕见也不是灵丹妙药"}, {"start": 24.01, "end": 25.89, "text": "初减只发现还有罕见成分"}, {"start": 25.89, "end": 26.93, "text": "能否治疗病情"}, {"start": 26.93, "end": 28.45, "text": "还要先测试一下"}, {"start": 28.45, "end": 31.52, "text": "先送解"}, {"start": 31.52, "end": 32.32, "text": "老董事长"}, {"start": 32.32, "end": 34.72, "text": "这是医疗团队测试可用的辅助样本"}, {"start": 34.72, "end": 36.92, "text": "只能少量服侍 观察情况"}, {"start": 36.92, "end": 44.5, "text": "天 天年人身"}, {"start": 44.5, "end": 46.02, "text": "好像没那么闷了"}, {"start": 46.02, "end": 47.34, "text": "爸 你好了"}, {"start": 47.34, "end": 48.62, "text": "医生 后续该怎么治"}, {"start": 48.62, "end": 49.54, "text": "我们全听医院安排"}, {"start": 49.54, "end": 50.74, "text": "稳定下来就好"}, {"start": 50.74, "end": 51.74, "text": "我们慢慢治"}, {"start": 51.74, "end": 52.86, "text": "活下来就有机"}]}