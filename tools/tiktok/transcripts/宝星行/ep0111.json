{"file": "宝星行-第111集.mp4", "ep": 111, "duration": 52.7, "segments": [{"start": 0.0, "end": 0.68, "text": "为人排队抢"}, {"start": 0.68, "end": 1.44, "text": "满满一车厢"}, {"start": 1.44, "end": 2.76, "text": "光卖水果也能赚几十万了"}, {"start": 5.1, "end": 5.7, "text": "石头"}, {"start": 6.06, "end": 6.58, "text": "难道"}, {"start": 7.1, "end": 8.22, "text": "全是匪催原石"}, {"start": 12.5, "end": 13.18, "text": "这颜色"}, {"start": 13.62, "end": 14.42, "text": "温润纯净"}, {"start": 14.42, "end": 15.94, "text": "宛如凝固的纯净汽油"}, {"start": 15.94, "end": 17.38, "text": "这是传说中的汽油黄"}, {"start": 17.38, "end": 18.82, "text": "质地细腻的连一丁点"}, {"start": 18.82, "end": 20.06, "text": "颗粒杂质都看不见"}, {"start": 20.38, "end": 21.1, "text": "高冰种"}, {"start": 21.42, "end": 21.82, "text": "不"}, {"start": 22.02, "end": 23.34, "text": "这经营剔透的水头"}, {"start": 23.34, "end": 25.26, "text": "绝对已经达到了玻璃种级别"}, {"start": 25.7, "end": 27.22, "text": "玻璃种汽油黄"}, {"start": 27.22, "end": 28.38, "text": "又是汽油黄"}, {"start": 28.5, "end": 30.42, "text": "连这三块全是汽油黄"}, {"start": 30.82, "end": 31.66, "text": "冰种杨绿"}, {"start": 31.66, "end": 32.86, "text": "这么大整整一块"}, {"start": 32.9, "end": 33.5, "text": "紫罗兰"}, {"start": 33.5, "end": 34.3, "text": "帝王子"}, {"start": 34.46, "end": 36.14, "text": "这紫色浓郁的快要滴出来了"}, {"start": 36.14, "end": 36.78, "text": "玻璃种"}, {"start": 37.1, "end": 37.78, "text": "帝王绿"}, {"start": 38.02, "end": 38.9, "text": "毫无杂质"}, {"start": 39.1, "end": 39.98, "text": "通体拳头"}, {"start": 40.42, "end": 40.94, "text": "发财了"}, {"start": 40.94, "end": 41.66, "text": "真发财了"}, {"start": 41.66, "end": 42.86, "text": "张同你特地是寻宝人"}, {"start": 42.86, "end": 43.74, "text": "还是神仙啊"}, {"start": 43.74, "end": 44.26, "text": "这一车车"}, {"start": 44.26, "end": 45.7, "text": "几品明阳率就能卖上几亿"}, {"start": 45.7, "end": 46.14, "text": "那几大块"}, {"start": 46.14, "end": 46.94, "text": "门板一样的玻璃种"}, {"start": 46.94, "end": 47.38, "text": "级油黄"}, {"start": 47.38, "end": 48.22, "text": "得值多少钱"}, {"start": 48.22, "end": 48.78, "text": "过百亿"}, {"start": 48.78, "end": 49.9, "text": "这一车货的总价值"}, {"start": 49.9, "end": 51.3, "text": "绝对超过了一百个亿"}, {"start": 51.5, "end": 52.66, "text": "百亿资产"}]}