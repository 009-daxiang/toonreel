{"file": "宝星行-第121集.mp4", "ep": 121, "duration": 53.7, "segments": [{"start": 0.0, "end": 0.88, "text": "加个微信呗"}, {"start": 0.88, "end": 1.45, "text": "张总"}, {"start": 1.45, "end": 3.17, "text": "你看我符合你们前台的标准吗"}, {"start": 3.17, "end": 4.29, "text": "我保准听话"}, {"start": 4.29, "end": 5.85, "text": "张总求合作啊"}, {"start": 5.85, "end": 6.69, "text": "完蛋"}, {"start": 6.69, "end": 8.81, "text": "这要是采游门非得出大事不可"}, {"start": 8.81, "end": 9.61, "text": "罗旁"}, {"start": 9.61, "end": 11.81, "text": "你特么真把老子推进火坑里了"}, {"start": 11.81, "end": 12.93, "text": "各位同学"}, {"start": 12.93, "end": 14.33, "text": "大家都冷静一下"}, {"start": 14.33, "end": 16.73, "text": "张总今天只是来核查公司事务的"}, {"start": 16.73, "end": 19.01, "text": "招聘工作26号才正式开始"}, {"start": 19.01, "end": 19.89, "text": "大家围在这儿"}, {"start": 19.89, "end": 21.33, "text": "不仅影响学校秩序"}, {"start": 21.33, "end": 22.85, "text": "还会耽误张总的正式"}, {"start": 22.85, "end": 23.73, "text": "罗薇"}, {"start": 23.73, "end": 25.37, "text": "那招聘广告上的福利待遇"}, {"start": 25.37, "end": 26.41, "text": "真的是真的吗"}, {"start": 26.41, "end": 27.61, "text": "车子就在这里"}, {"start": 27.61, "end": 29.53, "text": "张总的实力勿用质疑"}, {"start": 29.53, "end": 30.93, "text": "想要高薪职位"}, {"start": 30.93, "end": 33.85, "text": "大家26号平本事去经贸大厦面试"}, {"start": 33.85, "end": 34.77, "text": "现在都散开"}, {"start": 34.77, "end": 35.93, "text": "给张总让路"}, {"start": 35.93, "end": 36.65, "text": "也是"}, {"start": 36.65, "end": 38.09, "text": "别给大老板留下幻影响"}, {"start": 38.09, "end": 40.02, "text": "快让开"}, {"start": 40.02, "end": 40.86, "text": "谢了"}, {"start": 40.86, "end": 42.02, "text": "26号见"}, {"start": 42.02, "end": 43.1, "text": "张总慢走"}, {"start": 43.1, "end": 44.22, "text": "罗胖"}, {"start": 44.22, "end": 45.46, "text": "你长能耐了啊"}, {"start": 45.46, "end": 46.78, "text": "月薪五万招人"}, {"start": 46.78, "end": 47.86, "text": "还把我名下的法拉利"}, {"start": 47.86, "end": 49.46, "text": "写进广告盖工章"}, {"start": 49.46, "end": 50.98, "text": "招聘什么时候变成炫耀了"}, {"start": 50.98, "end": 51.74, "text": "通哥"}, {"start": 51.74, "end": 52.5, "text": "老板"}, {"start": 52.5, "end": 53.66, "text": "我这也是为了公司的门面"}]}