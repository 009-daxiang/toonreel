{"file": "宝星行-第151集.mp4", "ep": 151, "duration": 53.7, "segments": [{"start": 0.0, "end": 2.0, "text": "只想找个超级大金主"}, {"start": 2.0, "end": 4.0, "text": "我看这豪车的主人或许有戏"}, {"start": 4.0, "end": 5.0, "text": "口碑还算干净"}, {"start": 5.0, "end": 6.0, "text": "有野心不怕"}, {"start": 6.0, "end": 7.0, "text": "只要不乱来就行"}, {"start": 7.0, "end": 9.0, "text": "亲自侧面调查这部旗走对了"}, {"start": 9.0, "end": 10.0, "text": "谢谢了"}, {"start": 10.0, "end": 11.0, "text": "小姐姐你人真好"}, {"start": 11.0, "end": 15.14, "text": "我的天啊"}, {"start": 15.14, "end": 19.21, "text": "刚"}, {"start": 19.21, "end": 20.21, "text": "无奈"}, {"start": 20.21, "end": 21.21, "text": "你刚才有没有说我的坏话"}, {"start": 21.21, "end": 22.21, "text": "没有 真的没有"}, {"start": 22.21, "end": 23.21, "text": "你到底说了什么"}, {"start": 23.21, "end": 24.21, "text": "给我一次不漏的说出来"}, {"start": 24.21, "end": 25.21, "text": "放心 我不会怪你的"}, {"start": 25.21, "end": 26.21, "text": "我就是怕你对我有误会"}, {"start": 26.21, "end": 27.21, "text": "说了什么不好的话"}, {"start": 27.21, "end": 28.21, "text": "那我还能去弥补"}, {"start": 28.21, "end": 29.21, "text": "我就说"}, {"start": 29.21, "end": 30.21, "text": "你是大美女"}, {"start": 30.21, "end": 31.21, "text": "追求者多"}, {"start": 31.21, "end": 32.21, "text": "但你眼光高"}, {"start": 32.21, "end": 33.21, "text": "只想找大金主"}, {"start": 33.21, "end": 34.24, "text": "别的什么都没说"}, {"start": 34.24, "end": 35.24, "text": "没事"}, {"start": 35.24, "end": 36.24, "text": "不是事实"}, {"start": 36.24, "end": 37.24, "text": "谢谢你对我的评价"}, {"start": 37.24, "end": 38.24, "text": "好险"}, {"start": 38.24, "end": 39.24, "text": "若我以前抵挡不住诱惑"}, {"start": 39.24, "end": 40.24, "text": "有任何不好的风评"}, {"start": 40.24, "end": 41.24, "text": "他绝对会打听到"}, {"start": 41.24, "end": 43.24, "text": "刚才的手段让人不寒而立"}, {"start": 43.24, "end": 45.24, "text": "竟然伪装成拍照的和无奈闲聊"}, {"start": 45.24, "end": 46.24, "text": "神豪果然不好互动"}, {"start": 46.24, "end": 47.24, "text": "亲自"}, {"start": 47.24, "end": 48.24, "text": "他是你的追求者吗"}, {"start": 48.24, "end": 49.24, "text": "不是"}, {"start": 49.24, "end": 50.24, "text": "他那样的神豪"}, {"start": 50.24, "end": 51.24, "text": "怎么可能会追求白穷美"}, {"start": 51.24, "end": 52.24, "text": "那他怎么会出现在这里"}, {"start": 52.24, "end": 54.24, "text": "因为我去他的公司求职"}]}