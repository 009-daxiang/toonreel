{"file": "宝星行-第273集.mp4", "ep": 273, "duration": 47.7, "segments": [{"start": 0.0, "end": 1.08, "text": "做好员工沟通"}, {"start": 1.08, "end": 2.28, "text": "我不会报复你"}, {"start": 2.28, "end": 3.48, "text": "但你过去做过什么"}, {"start": 3.48, "end": 6.0, "text": "都应该由证据和调查给出结论"}, {"start": 6.0, "end": 7.58, "text": "罗燕"}, {"start": 7.58, "end": 8.66, "text": "我会配合调查"}, {"start": 8.66, "end": 10.34, "text": "我保留了强迫低价收股"}, {"start": 10.34, "end": 11.14, "text": "职场虐领"}, {"start": 11.14, "end": 12.66, "text": "和侵害员工权益的记录"}, {"start": 12.66, "end": 14.06, "text": "现在全部交给律师和审计"}, {"start": 14.06, "end": 15.86, "text": "这里交给律师和审计"}, {"start": 15.86, "end": 17.1, "text": "大家先回公司"}, {"start": 17.1, "end": 18.54, "text": "把下一阶段工作安排好"}, {"start": 18.54, "end": 21.55, "text": "罗燕保留原有百分之零点五股份"}, {"start": 21.55, "end": 22.35, "text": "明白老板"}, {"start": 22.35, "end": 23.03, "text": "数日后"}, {"start": 23.03, "end": 24.71, "text": "净调与交割完成"}, {"start": 24.71, "end": 26.79, "text": "扣除核定负债等因素"}, {"start": 26.79, "end": 29.57, "text": "最终收购价为四十一亿元"}, {"start": 29.57, "end": 32.57, "text": "罗燕保留原有百分之零点五股份"}, {"start": 32.57, "end": 34.13, "text": "喜欢什么随便挑"}, {"start": 34.13, "end": 35.05, "text": "衣服"}, {"start": 35.05, "end": 36.05, "text": "鞋子"}, {"start": 36.05, "end": 36.93, "text": "包包"}, {"start": 36.93, "end": 38.65, "text": "今天全有我买单"}, {"start": 38.65, "end": 43.29, "text": "老板"}, {"start": 43.29, "end": 45.45, "text": "太贵了吧"}, {"start": 45.45, "end": 46.93, "text": "老板对我们好"}, {"start": 46.93, "end": 47.65, "text": "但我们也不能"}]}