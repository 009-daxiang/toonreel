   {
    "start": 11.56,
    "end": 12.48,
    "text": "这是讨风"
   },
   {
    "start": 12.6,
    "end": 13.56,
    "text": "这都什么年代了"
   },
   {
    "start": 13.56,
    "end": 14.88,
    "text": "还有黄皮子讨风"
   },
   {
    "start": 15.04,
    "end": 16.56,
    "text": "修行哪能投机去抢"
   },
   {
    "start": 16.96,
    "end": 18.36,
    "text": "说他向人讨风失败"
   },
   {
    "start": 18.36,
    "end": 19.08,
    "text": "他得怨我"
   },
   {
    "start": 19.08,
    "end": 20.0,
    "text": "说他向神"
   },
   {
    "start": 20.2,
    "end": 21.0,
    "text": "将来遭了雷劫"
   },
   {
    "start": 21.0,
    "end": 22.12,
    "text": "还不得算我头上"
   },
   {
    "start": 22.28,
    "end": 23.16,
    "text": "不理他就是了"
   },
   {
    "start": 24.98,
    "end": 25.78,
    "text": "有话好好说"
   },
   {
    "start": 25.78,
    "end": 27.1,
    "text": "你先下来 我不走了"
   },
   {
    "start": 27.66,
    "end": 30.37,
    "text": "你到底想干啥"
   }
  ]
 }
]