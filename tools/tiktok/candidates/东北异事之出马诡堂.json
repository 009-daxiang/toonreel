[
 {
  "ep": 42,
  "start": 13.1,
  "end": 59.02,
  "dur": 45.9,
  "score": 23.4,
  "lines": [
   {
    "start": 13.1,
    "end": 14.62,
    "text": "孙铁牛不会再缠她吧"
   },
   {
    "start": 14.62,
    "end": 15.9,
    "text": "那福文是安神的"
   },
   {
    "start": 15.9,
    "end": 17.9,
    "text": "她睡着我们才能入梦收鬼"
   },
   {
    "start": 17.9,
    "end": 19.46,
    "text": "孙铁牛只夜里入梦"
   },
   {
    "start": 19.46,
    "end": 20.82,
    "text": "我们只能梦里收她"
   },
   {
    "start": 20.82,
    "end": 22.5,
    "text": "她已被马师傅送去地府"
   },
   {
    "start": 22.5,
    "end": 24.62,
    "text": "逃亡近百年 这回有她受的"
   },
   {
    "start": 24.62,
    "end": 29.87,
    "text": "刘师傅 小铁师傅"
   },
   {
    "start": 29.87,
    "end": 31.23,
    "text": "我昨晚睡得特别好"
   },
   {
    "start": 31.23,
    "end": 32.63,
    "text": "这是办事的挂筋"
   },
   {
    "start": 33.17,
    "end": 34.53,
    "text": "她咋没做梦呢"
   },
   {
    "start": 35.15,
    "end": 37.71,
    "text": "我家马仙把她梦里的记忆抹除了"
   },
   {
    "start": 37.71,
    "end": 40.9,
    "text": "知道太多对她反而不好"
   },
   {
    "start": 40.9,
    "end": 43.06,
    "text": "收这么多 我心里不踏实"
   },
   {
    "start": 43.06,
    "end": 45.38,
    "text": "小铁 日后你独立看挂 切记"
   },
   {
    "start": 45.38,
    "end": 46.34,
    "text": "鬼也会骗人"
   },
   {
    "start": 46.34,
    "end": 48.54,
    "text": "拿不准真假就让你家鬼仙查她的生平"
   },
   {
    "start": 48.54,
    "end": 49.9,
    "text": "地府都有记载"
   },
   {
    "start": 49.9,
    "end": 52.78,
    "text": "老刘 你不会已经想把我扔下了吧"
   },
   {
    "start": 52.78,
    "end": 53.74,
    "text": "那是不会"
   },
   {
    "start": 53.74,
    "end": 55.74,
    "text": "但我不可能教你一辈子"
   },
   {
    "start": 55.74,
    "end": 57.02,
    "text": "到时候你能信的"
   },
   {
    "start": 57.02,
    "end": 59.02,
    "text": "只有你家唐口的鬼仙"
   }
  ]
 },
 {
  "ep": 93,
  "start": 22.06,
  "end": 67.52,
  "dur": 45.5,
  "score": 20.2,
  "lines": [
   {
    "start": 22.06,
    "end": 24.91,
    "text": "我害怕啥"
   },
   {
    "start": 24.91,
    "end": 25.91,
    "text": "我立堂了"
   },
   {
    "start": 25.91,
    "end": 27.91,
    "text": "我是恶鬼的克星"
   },
   {
    "start": 27.91,
    "end": 28.98,
    "text": "你干啥的"
   },
   {
    "start": 28.98,
    "end": 31.1,
    "text": "哪人都敢进"
   },
   {
    "start": 31.1,
    "end": 36.24,
    "text": "那是咱家堂口刚招的鬼仙"
   },
   {
    "start": 36.24,
    "end": 37.24,
    "text": "考核都通过了"
   },
   {
    "start": 37.24,
    "end": 38.27,
    "text": "你这孩子"
   },
   {
    "start": 38.27,
    "end": 40.27,
    "text": "能不能看清再说话"
   },
   {
    "start": 40.27,
    "end": 41.27,
    "text": "那我难受"
   },
   {
    "start": 41.27,
    "end": 43.69,
    "text": "是不是就因为他呀"
   },
   {
    "start": 43.69,
    "end": 45.69,
    "text": "他一直在你身上待着"
   },
   {
    "start": 45.69,
    "end": 46.69,
    "text": "你没感应到"
   },
   {
    "start": 46.69,
    "end": 48.69,
    "text": "也没让他去后营修行"
   },
   {
    "start": 48.69,
    "end": 49.69,
    "text": "可不就难受到现在吗"
   },
   {
    "start": 49.69,
    "end": 50.69,
    "text": "你咋不早说"
   },
   {
    "start": 50.69,
    "end": 51.69,
    "text": "你们招的"
   },
   {
    "start": 51.69,
    "end": 52.69,
    "text": "考察完"
   },
   {
    "start": 52.69,
    "end": 53.69,
    "text": "直接让他去后营"
   },
   {
    "start": 53.69,
    "end": 54.69,
    "text": "不就行了吗"
   },
   {
    "start": 54.69,
    "end": 55.69,
    "text": "胡闹"
   },
   {
    "start": 55.69,
    "end": 57.69,
    "text": "堂口有规矩"
   },
   {
    "start": 57.69,
    "end": 58.69,
    "text": "进来人了"
   },
   {
    "start": 58.69,
    "end": 59.69,
    "text": "地马必须知道"
   },
   {
    "start": 59.69,
    "end": 60.69,
    "text": "也必须开口工情"
   },
   {
    "start": 60.69,
    "end": 61.69,
    "text": "不然阿猫阿狗"
   },
   {
    "start": 61.69,
    "end": 63.69,
    "text": "都能跟着修行吗"
   },
   {
    "start": 63.69,
    "end": 66.52,
    "text": "敢问鬼仙是何命慧"
   },
   {
    "start": 66.52,
    "end": 67.52,
    "text": "出自何处"
   }
  ]
 },
 {
  "ep": 22,
  "start": 13.34,
  "end": 57.45,
  "dur": 44.1,
  "score": 19.6,
  "lines": [
   {
    "start": 13.34,
    "end": 15.42,
    "text": "只要是压死黄鼠狼"
   },
   {
    "start": 15.42,
    "end": 17.63,
    "text": "就会被索命吗"
   },
   {
    "start": 17.63,
    "end": 21.24,
    "text": "这要看是故意的还是无心的"
   },
   {
    "start": 21.24,
    "end": 22.08,
    "text": "有啥区别"
   },
   {
    "start": 22.08,
    "end": 23.4,
    "text": "无心的是他的结束"
   },
   {
    "start": 23.4,
    "end": 24.76,
    "text": "烧点东西赔个礼就成"
   },
   {
    "start": 24.76,
    "end": 26.04,
    "text": "但得有忏悔之心"
   },
   {
    "start": 26.04,
    "end": 27.28,
    "text": "故意的还来回碾压"
   },
   {
    "start": 27.28,
    "end": 29.34,
    "text": "那就一命抵一命"
   },
   {
    "start": 29.42,
    "end": 31.98,
    "text": "为啥我心里会冒出一个陌生的声音"
   },
   {
    "start": 31.98,
    "end": 33.7,
    "text": "咱们浑身上下翘全开"
   },
   {
    "start": 33.7,
    "end": 34.86,
    "text": "仙家站着翘"
   },
   {
    "start": 34.86,
    "end": 36.18,
    "text": "想跟你沟通就会这样"
   },
   {
    "start": 36.18,
    "end": 38.34,
    "text": "这叫心通还有眼通耳通"
   },
   {
    "start": 38.34,
    "end": 39.34,
    "text": "想跟他们说话"
   },
   {
    "start": 39.34,
    "end": 40.7,
    "text": "心里默念就行"
   },
   {
    "start": 40.7,
    "end": 41.98,
    "text": "别戴自己的思想"
   },
   {
    "start": 41.98,
    "end": 43.14,
    "text": "不然以后看挂不准"
   },
   {
    "start": 43.14,
    "end": 44.94,
    "text": "眼通就是阴阳眼"
   },
   {
    "start": 44.94,
    "end": 46.3,
    "text": "耳通能听见他们说话"
   },
   {
    "start": 46.3,
    "end": 47.42,
    "text": "让你看啥听啥"
   },
   {
    "start": 47.42,
    "end": 49.38,
    "text": "全在你家师父手上"
   },
   {
    "start": 49.38,
    "end": 51.3,
    "text": "那我咋知道说话的是哪位仙家"
   },
   {
    "start": 51.3,
    "end": 52.46,
    "text": "蒙仙 黄仙 鬼仙"
   },
   {
    "start": 52.46,
    "end": 53.7,
    "text": "上身的体感都不一样"
   },
   {
    "start": 53.7,
    "end": 56.01,
    "text": "你熟一熟就知道了"
   },
   {
    "start": 56.01,
    "end": 57.45,
    "text": "这个被压死的黄鼠狼"
   }
  ]
 },
 {
  "ep": 12,
  "start": 27.7,
  "end": 73.26,
  "dur": 45.6,
  "score": 17.2,
  "lines": [
   {
    "start": 27.7,
    "end": 28.9,
    "text": "爷爷为什么在这里"
   },
   {
    "start": 28.9,
    "end": 30.5,
    "text": "供奉这么多地下的神仙"
   },
   {
    "start": 31.7,
    "end": 32.9,
    "text": "我怎么会跪在这儿"
   },
   {
    "start": 33.1,
    "end": 34.3,
    "text": "我不是在睡觉吗"
   },
   {
    "start": 35.06,
    "end": 36.66,
    "text": "这地方有东西在摆弄我"
   },
   {
    "start": 36.86,
    "end": 37.86,
    "text": "我不能再睡了"
   },
   {
    "start": 38.26,
    "end": 39.78,
    "text": "到底发生什么事了"
   },
   {
    "start": 42.34,
    "end": 45.07,
    "text": "爷爷 我是在做梦吗"
   },
   {
    "start": 46.31,
    "end": 47.71,
    "text": "小铁 跪下"
   },
   {
    "start": 48.98,
    "end": 50.58,
    "text": "爷爷 爷爷 你怎么了"
   },
   {
    "start": 50.78,
    "end": 54.83,
    "text": "小铁 你接了 你就安全了"
   },
   {
    "start": 55.36,
    "end": 56.56,
    "text": "爷爷就好了"
   },
   {
    "start": 58.22,
    "end": 59.42,
    "text": "到底要我接什么"
   },
   {
    "start": 59.62,
    "end": 61.42,
    "text": "这黑布为什么缠着我不放"
   },
   {
    "start": 65.93,
    "end": 67.73,
    "text": "叔 我现在咋办 我害怕"
   },
   {
    "start": 67.93,
    "end": 69.53,
    "text": "是不是你爷爷死不明目"
   },
   {
    "start": 69.73,
    "end": 70.53,
    "text": "不愿意走啊"
   },
   {
    "start": 71.06,
    "end": 72.26,
    "text": "我认识一个出马仙"
   },
   {
    "start": 72.26,
    "end": 73.26,
    "text": "带你过去看看"
   }
  ]
 },
 {
  "ep": 63,
  "start": 33.6,
  "end": 79.02,
  "dur": 45.4,
  "score": 16.9,
  "lines": [
   {
    "start": 33.6,
    "end": 34.64,
    "text": "别碰他真身"
   },
   {
    "start": 34.64,
    "end": 35.44,
    "text": "他刚得到"
   },
   {
    "start": 35.44,
    "end": 36.68,
    "text": "还不会开口说话"
   },
   {
    "start": 36.8,
    "end": 38.12,
    "text": "现在原神出窍了"
   },
   {
    "start": 38.12,
    "end": 39.72,
    "text": "这样你就能跟他沟通了"
   },
   {
    "start": 39.72,
    "end": 40.72,
    "text": "但要粘了人气"
   },
   {
    "start": 40.72,
    "end": 41.64,
    "text": "他就回不去了"
   },
   {
    "start": 41.64,
    "end": 43.76,
    "text": "小相同 帮帮我"
   },
   {
    "start": 44.48,
    "end": 45.76,
    "text": "敢问老仙明慧"
   },
   {
    "start": 45.76,
    "end": 47.44,
    "text": "今日来我 有何所求"
   },
   {
    "start": 47.44,
    "end": 48.64,
    "text": "无名高山"
   },
   {
    "start": 48.64,
    "end": 50.44,
    "text": "小相同 莫惊慌"
   },
   {
    "start": 50.44,
    "end": 52.96,
    "text": "今日前来 确有一事相求"
   },
   {
    "start": 55.18,
    "end": 57.14,
    "text": "老仙 我也不会致病啊"
   },
   {
    "start": 57.14,
    "end": 59.1,
    "text": "要不我带您老去宠物医院看看"
   },
   {
    "start": 59.82,
    "end": 61.3,
    "text": "黄大锤我舌头怎么麻了"
   },
   {
    "start": 61.3,
    "end": 62.26,
    "text": "你礼貌吗"
   },
   {
    "start": 62.26,
    "end": 63.66,
    "text": "小相同说的也在里"
   },
   {
    "start": 63.66,
    "end": 64.78,
    "text": "可我求的不是这个"
   },
   {
    "start": 64.78,
    "end": 65.74,
    "text": "还往仙家名誓"
   },
   {
    "start": 65.74,
    "end": 68.22,
    "text": "我与妻女同住周家村后山"
   },
   {
    "start": 68.22,
    "end": 69.74,
    "text": "前些日子出动找吃事"
   },
   {
    "start": 69.74,
    "end": 70.9,
    "text": "被老鹰盯上"
   },
   {
    "start": 70.9,
    "end": 72.06,
    "text": "尾巴被叼住"
   },
   {
    "start": 72.06,
    "end": 74.3,
    "text": "我脑瞎了他一只眼才掉下来"
   },
   {
    "start": 74.3,
    "end": 75.82,
    "text": "这真身不能要了"
   },
   {
    "start": 75.86,
    "end": 78.06,
    "text": "后山 那是藏山"
   },
   {
    "start": 78.06,
    "end": 79.02,
    "text": "传说里那个贪官"
   }
  ]
 },
 {
  "ep": 83,
  "start": 18.14,
  "end": 62.73,
  "dur": 44.6,
  "score": 15.1,
  "lines": [
   {
    "start": 18.14,
    "end": 19.78,
    "text": "我师傅明天到 你别担心"
   },
   {
    "start": 19.78,
    "end": 20.62,
    "text": "为了方便点"
   },
   {
    "start": 20.62,
    "end": 21.9,
    "text": "我们先找个住的地方吧"
   },
   {
    "start": 25.6,
    "end": 26.8,
    "text": "怎么了 没睡好"
   },
   {
    "start": 27.04,
    "end": 28.08,
    "text": "我做了一个梦"
   },
   {
    "start": 28.28,
    "end": 29.76,
    "text": "梦见了一只很高的狗"
   },
   {
    "start": 29.76,
    "end": 30.48,
    "text": "特别大"
   },
   {
    "start": 30.48,
    "end": 32.28,
    "text": "血喷大嘴 一直在追我"
   },
   {
    "start": 32.28,
    "end": 33.24,
    "text": "把我追到悬崖"
   },
   {
    "start": 33.24,
    "end": 34.56,
    "text": "我掉了下去就行了"
   },
   {
    "start": 35.44,
    "end": 36.96,
    "text": "这应该就是你的愁口了"
   },
   {
    "start": 36.96,
    "end": 38.08,
    "text": "老刘下午就到了"
   },
   {
    "start": 38.08,
    "end": 39.32,
    "text": "别害怕有我们在呢"
   },
   {
    "start": 40.17,
    "end": 41.25,
    "text": "小铁说的没错"
   },
   {
    "start": 41.85,
    "end": 43.13,
    "text": "这就是你身后的仇"
   },
   {
    "start": 43.45,
    "end": 45.33,
    "text": "他感觉到你要出马立堂"
   },
   {
    "start": 45.33,
    "end": 46.25,
    "text": "来捣乱了"
   },
   {
    "start": 46.25,
    "end": 48.61,
    "text": "你家祖辈是不是有供过堂口的"
   },
   {
    "start": 48.61,
    "end": 49.93,
    "text": "我听我妈说"
   },
   {
    "start": 49.93,
    "end": 51.85,
    "text": "我姥姥好像供过堂口"
   },
   {
    "start": 51.85,
    "end": 53.85,
    "text": "但不知道什么原因不供了"
   },
   {
    "start": 54.37,
    "end": 55.61,
    "text": "我心里有数了"
   },
   {
    "start": 55.61,
    "end": 56.85,
    "text": "你不用害怕"
   },
   {
    "start": 56.85,
    "end": 58.41,
    "text": "有我和小铁呢"
   },
   {
    "start": 58.41,
    "end": 59.37,
    "text": "没人敢伤你"
   },
   {
    "start": 60.01,
    "end": 61.61,
    "text": "你该报名报名"
   },
   {
    "start": 61.61,
    "end": 62.73,
    "text": "该立堂就立堂"
   }
  ]
 },
 {
  "ep": 2,
  "start": 29.32,
  "end": 75.26,
  "dur": 45.9,
  "score": 14.6,
  "lines": [
   {
    "start": 29.32,
    "end": 31.75,
    "text": "刚出生就被无常盯上了"
   },
   {
    "start": 31.75,
    "end": 35.28,
    "text": "这娃的命怕是轻啊"
   },
   {
    "start": 35.28,
    "end": 36.56,
    "text": "无常所命"
   },
   {
    "start": 36.56,
    "end": 37.56,
    "text": "仙家住"
   },
   {
    "start": 37.56,
    "end": 38.68,
    "text": "体弱多病"
   },
   {
    "start": 38.68,
    "end": 40.08,
    "text": "命格轻"
   },
   {
    "start": 40.08,
    "end": 41.6,
    "text": "大妹子能看出这娃的毛病"
   },
   {
    "start": 41.6,
    "end": 42.4,
    "text": "能不能破解一下"
   },
   {
    "start": 42.4,
    "end": 43.6,
    "text": "多少钱都行"
   },
   {
    "start": 43.6,
    "end": 44.56,
    "text": "娃娶名妹"
   },
   {
    "start": 44.56,
    "end": 45.28,
    "text": "娶了"
   },
   {
    "start": 45.28,
    "end": 45.96,
    "text": "姓周"
   },
   {
    "start": 45.96,
    "end": 46.68,
    "text": "叫天顺"
   },
   {
    "start": 46.68,
    "end": 47.6,
    "text": "改名吧"
   },
   {
    "start": 47.6,
    "end": 48.76,
    "text": "单名一个铁"
   },
   {
    "start": 48.76,
    "end": 49.84,
    "text": "铁鼠扬金"
   },
   {
    "start": 49.84,
    "end": 50.68,
    "text": "这娃八字轻"
   },
   {
    "start": 50.68,
    "end": 51.6,
    "text": "命格吉音"
   },
   {
    "start": 51.6,
    "end": 52.8,
    "text": "正好压制"
   },
   {
    "start": 52.8,
    "end": 53.88,
    "text": "这娃"
   },
   {
    "start": 53.88,
    "end": 57.74,
    "text": "可以接下你饭碗啊"
   },
   {
    "start": 57.74,
    "end": 59.02,
    "text": "人却没了"
   },
   {
    "start": 59.02,
    "end": 61.27,
    "text": "难道是我出现幻觉了"
   },
   {
    "start": 61.27,
    "end": 65.34,
    "text": "感谢仙人指点没击"
   },
   {
    "start": 65.34,
    "end": 65.9,
    "text": "小铁"
   },
   {
    "start": 65.9,
    "end": 67.02,
    "text": "爷爷去县城送货"
   },
   {
    "start": 67.02,
    "end": 68.02,
    "text": "回来给你带玩具"
   },
   {
    "start": 68.02,
    "end": 69.5,
    "text": "在家听话别乱跑"
   },
   {
    "start": 69.5,
    "end": 71.06,
    "text": "天黑前爷爷就回来"
   },
   {
    "start": 71.06,
    "end": 72.78,
    "text": "爷爷我要个小汽车"
   },
   {
    "start": 72.78,
    "end": 74.06,
    "text": "你又做什么"
   },
   {
    "start": 74.06,
    "end": 75.26,
    "text": "我去县城找活"
   }
  ]
 },
 {
  "ep": 53,
  "start": 11.43,
  "end": 54.14,
  "dur": 42.7,
  "score": 13.9,
  "lines": [
   {
    "start": 11.43,
    "end": 12.63,
    "text": "我不该骂你"
   },
   {
    "start": 12.63,
    "end": 14.43,
    "text": "你能不能把灾撤了"
   },
   {
    "start": 14.43,
    "end": 16.23,
    "text": "你最近感觉特别倒霉"
   },
   {
    "start": 16.23,
    "end": 18.43,
    "text": "喝凉水都塞牙 对吧"
   },
   {
    "start": 18.43,
    "end": 22.18,
    "text": "从你这刚走我就开始倒霉了"
   },
   {
    "start": 22.18,
    "end": 24.18,
    "text": "你身后还跟着个女鬼"
   },
   {
    "start": 24.18,
    "end": 24.61,
    "text": "她"
   },
   {
    "start": 24.61,
    "end": 25.61,
    "text": "她是谁"
   },
   {
    "start": 25.61,
    "end": 27.21,
    "text": "瓜子脸 柳叶眉"
   },
   {
    "start": 27.21,
    "end": 29.61,
    "text": "大嘴 鹰儿肥 潮天鼻"
   },
   {
    "start": 29.61,
    "end": 31.61,
    "text": "左耳有一颗黑质 30多岁"
   },
   {
    "start": 31.61,
    "end": 32.21,
    "text": "她"
   },
   {
    "start": 32.21,
    "end": 33.21,
    "text": "她死了"
   },
   {
    "start": 33.21,
    "end": 34.21,
    "text": "不 不可能吧"
   },
   {
    "start": 34.21,
    "end": 35.21,
    "text": "她啥时候死的"
   },
   {
    "start": 35.21,
    "end": 36.21,
    "text": "你不说清楚"
   },
   {
    "start": 36.21,
    "end": 37.21,
    "text": "不光你遭罪"
   },
   {
    "start": 37.21,
    "end": 38.81,
    "text": "你媳妇和孩子也遭罪"
   },
   {
    "start": 38.81,
    "end": 40.96,
    "text": "六年前我认识了她"
   },
   {
    "start": 40.96,
    "end": 42.16,
    "text": "追了好几个月"
   },
   {
    "start": 42.16,
    "end": 43.56,
    "text": "我说会娶她"
   },
   {
    "start": 43.56,
    "end": 45.26,
    "text": "她怀孕了"
   },
   {
    "start": 45.26,
    "end": 46.66,
    "text": "我给了三万让她打掉"
   },
   {
    "start": 46.66,
    "end": 47.46,
    "text": "后来她追问"
   },
   {
    "start": 47.46,
    "end": 49.28,
    "text": "我承认我结过婚"
   },
   {
    "start": 49.28,
    "end": 50.28,
    "text": "她就消失了"
   },
   {
    "start": 50.28,
    "end": 52.14,
    "text": "你如果还有隐瞒"
   },
   {
    "start": 52.14,
    "end": 54.14,
    "text": "天王老子来都救不了你"
   }
  ]
 },
 {
  "ep": 32,
  "start": 32.47,
  "end": 77.18,
  "dur": 44.7,
  "score": 13.8,
  "lines": [
   {
    "start": 32.47,
    "end": 34.47,
    "text": "以后按时锻炼,鬼剑你都绕着走"
   },
   {
    "start": 34.87,
    "end": 36.47,
    "text": "可她活着的时候最疼我"
   },
   {
    "start": 36.87,
    "end": 38.27,
    "text": "为啥现在这么折磨我"
   },
   {
    "start": 38.27,
    "end": 39.47,
    "text": "鬼要是迟迟不投胎"
   },
   {
    "start": 39.47,
    "end": 41.07,
    "text": "七情六欲会慢慢消失"
   },
   {
    "start": 41.27,
    "end": 42.47,
    "text": "她虽知道你是孙子"
   },
   {
    "start": 42.47,
    "end": 43.87,
    "text": "但对你已经没啥感情了"
   },
   {
    "start": 43.87,
    "end": 45.07,
    "text": "那我以后死了"
   },
   {
    "start": 45.07,
    "end": 46.07,
    "text": "是不是也这样"
   },
   {
    "start": 46.07,
    "end": 47.27,
    "text": "所以你活着的时候"
   },
   {
    "start": 47.27,
    "end": 48.87,
    "text": "该孝顺谁就赶紧孝顺"
   },
   {
    "start": 51.54,
    "end": 52.54,
    "text": "我知道规矩"
   },
   {
    "start": 52.94,
    "end": 54.54,
    "text": "可我手里就剩这些钱了"
   },
   {
    "start": 54.54,
    "end": 55.34,
    "text": "就收两百"
   },
   {
    "start": 55.34,
    "end": 56.34,
    "text": "朋友之间大把手"
   },
   {
    "start": 56.34,
    "end": 56.94,
    "text": "回去吧"
   },
   {
    "start": 66.72,
    "end": 67.92,
    "text": "别慌我现在过去"
   },
   {
    "start": 71.53,
    "end": 72.53,
    "text": "你们找我干什么"
   },
   {
    "start": 73.18,
    "end": 74.58,
    "text": "她俩这是有话要说"
   },
   {
    "start": 74.58,
    "end": 75.78,
    "text": "那就等她们先开口"
   },
   {
    "start": 75.98,
    "end": 77.18,
    "text": "我和这位仙家"
   }
  ]
 },
 {
