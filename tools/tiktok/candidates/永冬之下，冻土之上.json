  "lines": [
   {
    "start": 6.44,
    "end": 7.68,
    "text": "可这门外的雪"
   },
   {
    "start": 7.8,
    "end": 8.96,
    "text": "为什么这么少"
   },
   {
    "start": 10.26,
    "end": 11.18,
    "text": "爹 你看"
   },
   {
    "start": 16.3,
    "end": 17.7,
    "text": "原来如此"
   },
   {
    "start": 17.82,
    "end": 19.42,
    "text": "是那排柵栏挡住了雪"
   },
   {
    "start": 19.54,
    "end": 21.22,
    "text": "雪就在山顶提前落下了"
   },
   {
    "start": 21.38,
    "end": 23.26,
    "text": "到咱们这里自然就少了"
   },
   {
    "start": 23.38,
    "end": 24.3,
    "text": "这只是其一"
   },
   {
    "start": 24.74,
    "end": 26.22,
    "text": "柵栏后面堆起来的雪墙"
   },
   {
    "start": 26.34,
    "end": 28.02,
    "text": "还替我们挡住了一部分北风"
   },
   {
    "start": 28.14,
    "end": 29.98,
    "text": "所以昨晚真正吹到雪屋上的风"
   },
   {
    "start": 30.1,
    "end": 31.14,
    "text": "比别处小得多"
   },
   {
    "start": 31.38,
    "end": 33.62,
    "text": "一个门 几根破木头"
   },
   {
    "start": 34.06,
    "end": 35.5,
    "text": "看着都是不起眼的东西"
   },
   {
    "start": 36.02,
    "end": 37.18,
    "text": "到了要命的时候"
   },
   {
    "start": 37.3,
    "end": 38.5,
    "text": "竟然真能救人"
   },
   {
    "start": 38.62,
    "end": 40.22,
    "text": "老庄还说你跑山顶插炸了"
   },
   {
    "start": 40.7,
    "end": 41.78,
    "text": "是脑子冻坏了"
   },
   {
    "start": 41.9,
    "end": 42.58,
    "text": "现在倒好"
   },
   {
    "start": 42.7,
    "end": 43.82,
    "text": "他们那扇气派的大门"
   },
   {
    "start": 43.94,
    "end": 44.74,
    "text": "让雪堵死了"
   },
   {
    "start": 44.86,
    "end": 45.78,
    "text": "咱们这个老鼠洞"
   },
   {
    "start": 45.94,
    "end": 46.7,
    "text": "一拉就开"
   },
   {
    "start": 46.9,
    "end": 48.58,
    "text": "他们那边雪都埋到屋顶了"
   },
   {
    "start": 48.74,
    "end": 49.42,
    "text": "咱们这里"
   },
   {
    "start": 49.62,
    "end": 50.78,
    "text": "连门坎都没摸过"
   }
  ]
 },
 {
  "ep": 42,
  "start": 7.2,
  "end": 53.06,
  "dur": 45.9,
  "score": 12.4,
  "lines": [
   {
    "start": 7.2,
    "end": 7.8,
    "text": "可是"
   },
   {
    "start": 7.8,
    "end": 9.36,
    "text": "可是泥巴不能烧啊"
   },
   {
    "start": 9.36,
    "end": 10.8,
    "text": "你摻它进去干嘛"
   },
   {
    "start": 10.8,
    "end": 11.88,
    "text": "泥巴是不能烧"
   },
   {
    "start": 11.88,
    "end": 12.76,
    "text": "可它有大用"
   },
   {
    "start": 12.76,
    "end": 14.04,
    "text": "它能当成这煤团的骨架"
   },
   {
    "start": 14.04,
    "end": 14.92,
    "text": "骨架"
   },
   {
    "start": 14.92,
    "end": 15.64,
    "text": "你想"
   },
   {
    "start": 15.64,
    "end": 17.4,
    "text": "纯的碎煤一点就着"
   },
   {
    "start": 17.4,
    "end": 18.6,
    "text": "可也一下就烧完了"
   },
   {
    "start": 18.6,
    "end": 20.76,
    "text": "火苗糊糊一阵旺转眼就成灰"
   },
   {
    "start": 20.76,
    "end": 21.6,
    "text": "摻了泥"
   },
   {
    "start": 21.6,
    "end": 23.68,
    "text": "泥把这些碎煤一点点架住隔开"
   },
   {
    "start": 23.68,
    "end": 24.88,
    "text": "火就顺着泥里的煤"
   },
   {
    "start": 24.88,
    "end": 26.72,
    "text": "一点一点慢慢地烧"
   },
   {
    "start": 26.72,
    "end": 27.76,
    "text": "这叫缓室"
   },
   {
    "start": 27.76,
    "end": 30.04,
    "text": "让煤炭缓慢持久地放热"
   },
   {
    "start": 30.04,
    "end": 31.2,
    "text": "一个煤团"
   },
   {
    "start": 31.2,
    "end": 33.04,
    "text": "能顶好几根柴的工夫"
   },
   {
    "start": 33.04,
    "end": 34.8,
    "text": "这慢慢寒冬的长夜一夜"
   },
   {
    "start": 34.8,
    "end": 38.1,
    "text": "就得靠它一点一点地熬过去"
   },
   {
    "start": 38.7,
    "end": 39.5,
    "text": "仙植"
   },
   {
    "start": 39.5,
    "end": 40.86,
    "text": "这白花花的粉末"
   },
   {
    "start": 40.86,
    "end": 42.38,
    "text": "又是啥金贵玩意儿"
   },
   {
    "start": 42.38,
    "end": 44.02,
    "text": "你怎么还往这土哥的里头"
   },
   {
    "start": 44.02,
    "end": 45.22,
    "text": "加料调味了"
   },
   {
    "start": 45.22,
    "end": 46.66,
    "text": "想尝尝"
   },
   {
    "start": 46.66,
    "end": 47.74,
    "text": "这是生石灰"
   },
   {
    "start": 47.74,
    "end": 48.42,
    "text": "预了水"
   },
   {
    "start": 48.42,
    "end": 49.46,
    "text": "能把你的舌头"
   },
   {
    "start": 49.46,
    "end": 50.66,
    "text": "烫成一块烂肉"
   },
   {
    "start": 50.66,
    "end": 52.42,
    "text": "加它是为了去毒"
   },
   {
    "start": 52.42,
    "end": 53.06,
    "text": "我说过"
   }
  ]
 },
 {
  "ep": 28,
  "start": 4.0,
  "end": 49.65,
  "dur": 45.6,
  "score": 12.1,
  "lines": [
   {
    "start": 4.0,
    "end": 5.0,
    "text": "门洞就巴掌大一点"
   },
   {
    "start": 5.0,
    "end": 6.0,
    "text": "就是"
   },
   {
    "start": 6.0,
    "end": 7.0,
    "text": "一个书呆子"
   },
   {
    "start": 7.0,
    "end": 8.0,
    "text": "咱们这么多人一起"
   },
   {
    "start": 8.0,
    "end": 9.0,
    "text": "还能够如现在"
   },
   {
    "start": 9.0,
    "end": 10.0,
    "text": "趴着爬"
   },
   {
    "start": 10.0,
    "end": 11.0,
    "text": "走 进去看看"
   },
   {
    "start": 17.13,
    "end": 18.13,
    "text": "怎么回事"
   },
   {
    "start": 18.13,
    "end": 19.13,
    "text": "怎么屋里还这么冷"
   },
   {
    "start": 19.13,
    "end": 21.47,
    "text": "这雪屋"
   },
   {
    "start": 21.47,
    "end": 23.47,
    "text": "也没牧川说的那么暖和"
   },
   {
    "start": 23.47,
    "end": 25.47,
    "text": "我还行死进来"
   },
   {
    "start": 25.47,
    "end": 26.47,
    "text": "就不用挨动了呢"
   },
   {
    "start": 26.47,
    "end": 27.47,
    "text": "光靠这破雪"
   },
   {
    "start": 27.47,
    "end": 28.47,
    "text": "哪能暖和"
   },
   {
    "start": 28.47,
    "end": 29.47,
    "text": "把火升起来"
   },
   {
    "start": 30.47,
    "end": 31.47,
    "text": "可 可这是雪屋啊"
   },
   {
    "start": 31.47,
    "end": 32.47,
    "text": "雪见了火不得化"
   },
   {
    "start": 32.47,
    "end": 33.47,
    "text": "真在这里头点火"
   },
   {
    "start": 33.47,
    "end": 35.47,
    "text": "屋顶塌下来怎么办"
   },
   {
    "start": 35.47,
    "end": 36.47,
    "text": "牧川昨天晚上"
   },
   {
    "start": 36.47,
    "end": 37.47,
    "text": "就在里头烧了一夜"
   },
   {
    "start": 37.47,
    "end": 38.47,
    "text": "他那屋子塌了吗"
   },
   {
    "start": 38.47,
    "end": 39.47,
    "text": "都是雪挖的"
   },
   {
    "start": 39.47,
    "end": 41.47,
    "text": "他能烧 咱们凭什么不能烧"
   },
   {
    "start": 41.47,
    "end": 48.65,
    "text": "真的"
   },
   {
    "start": 48.65,
    "end": 49.65,
    "text": "我就说这法子"
   }
  ]
 },
 {
  "ep": 15,
  "start": 2.61,
  "end": 46.3,
  "dur": 43.7,
  "score": 10.7,
  "lines": [
   {
    "start": 2.61,
    "end": 3.33,
    "text": "掌柜的"
   },
   {
    "start": 3.57,
    "end": 4.57,
    "text": "咱真把这么多石梅"
   },
   {
    "start": 4.57,
    "end": 5.65,
    "text": "给那傻小子送来啊"
   },
   {
    "start": 5.65,
    "end": 6.53,
    "text": "你懂个屁"
   },
   {
    "start": 6.53,
    "end": 8.29,
    "text": "这一车破石头堆在场院里"
   },
   {
    "start": 8.29,
    "end": 9.29,
    "text": "白送都没人要"
   },
   {
    "start": 9.29,
    "end": 10.89,
    "text": "拿它换木家一座宅子"
   },
   {
    "start": 10.89,
    "end": 12.13,
    "text": "外要整块地皮"
   },
   {
    "start": 12.13,
    "end": 13.05,
    "text": "这种买卖"
   },
   {
    "start": 13.05,
    "end": 14.93,
    "text": "老子做一百回都不嫌多"
   },
   {
    "start": 14.93,
    "end": 15.85,
    "text": "就是不知道"
   },
   {
    "start": 15.85,
    "end": 16.89,
    "text": "那牧川还有没有命"
   },
   {
    "start": 16.89,
    "end": 17.77,
    "text": "跟掌柜的换"
   },
   {
    "start": 18.69,
    "end": 20.21,
    "text": "昨夜那风那雪"
   },
   {
    "start": 20.21,
    "end": 21.29,
    "text": "连村里的母屋"
   },
   {
    "start": 21.29,
    "end": 22.89,
    "text": "都不知道压榻了多少"
   },
   {
    "start": 22.89,
    "end": 25.01,
    "text": "一个人钻在雪队里睡一夜"
   },
   {
    "start": 25.01,
    "end": 25.97,
    "text": "还能活"
   },
   {
    "start": 27.22,
    "end": 28.34,
    "text": "死了更好"
   },
   {
    "start": 28.34,
    "end": 28.9,
    "text": "走"
   },
   {
    "start": 30.12,
    "end": 32.24,
    "text": "房器那小子已经给我了"
   },
   {
    "start": 32.36,
    "end": 34.16,
    "text": "地气八成就在身上"
   },
   {
    "start": 34.16,
    "end": 35.24,
    "text": "到时候把人跑出来"
   },
   {
    "start": 35.24,
    "end": 36.08,
    "text": "气输一拿"
   },
   {
    "start": 36.08,
    "end": 37.8,
    "text": "这车破石头还能省了"
   },
   {
    "start": 42.42,
    "end": 43.38,
    "text": "贺三爷"
   },
   {
    "start": 43.38,
    "end": 44.14,
    "text": "这么早"
   },
   {
    "start": 44.14,
    "end": 45.14,
    "text": "您怎么也来了"
   },
   {
    "start": 45.14,
    "end": 46.3,
    "text": "来看看热闹"
   }
  ]
 },
 {
  "ep": 8,
  "start": 4.0,
  "end": 49.08,
  "dur": 45.1,
  "score": 8.7,
  "lines": [
   {
    "start": 4.0,
    "end": 5.72,
    "text": "外头的寒气也钻不进来"
   },
   {
    "start": 5.72,
    "end": 6.68,
    "text": "它的保暖"
   },
   {
    "start": 6.68,
    "end": 8.12,
    "text": "是寻常木屋的好几倍"
   },
   {
    "start": 8.12,
    "end": 9.32,
    "text": "好几倍"
   },
   {
    "start": 9.32,
    "end": 12.04,
    "text": "那不比我家那漏风的破木屋强多了"
   },
   {
    "start": 12.04,
    "end": 13.16,
    "text": "何止强一点"
   },
   {
    "start": 13.16,
    "end": 14.04,
    "text": "牟川哥"
   },
   {
    "start": 14.04,
    "end": 15.04,
    "text": "那接下来呢"
   },
   {
    "start": 15.04,
    "end": 16.44,
    "text": "接下来往下吧"
   },
   {
    "start": 16.99,
    "end": 19.67,
    "text": "这门不能开在跟主事一样高的地方"
   },
   {
    "start": 19.67,
    "end": 20.67,
    "text": "不一样高"
   },
   {
    "start": 20.67,
    "end": 21.39,
    "text": "那开哪儿"
   },
   {
    "start": 21.39,
    "end": 22.39,
    "text": "开在最低处"
   },
   {
    "start": 22.39,
    "end": 24.51,
    "text": "比屋子里头还要低"
   },
   {
    "start": 24.51,
    "end": 29.25,
    "text": "牟川哥"
   },
   {
    "start": 29.25,
    "end": 30.77,
    "text": "你确定这门就该这么挖"
   },
   {
    "start": 31.2,
    "end": 32.08,
    "text": "怎么了"
   },
   {
    "start": 32.2,
    "end": 34.08,
    "text": "这 这入口比屋子里还低"
   },
   {
    "start": 34.08,
    "end": 34.92,
    "text": "咱们进出的时候"
   },
   {
    "start": 34.92,
    "end": 36.28,
    "text": "岂不是得先钻到坑底"
   },
   {
    "start": 36.28,
    "end": 37.64,
    "text": "再往上爬进去"
   },
   {
    "start": 37.64,
    "end": 39.2,
    "text": "跟个 跟个老鼠洞似的"
   },
   {
    "start": 39.2,
    "end": 40.48,
    "text": "牟川贤职啊"
   },
   {
    "start": 40.48,
    "end": 41.84,
    "text": "石头说得在里"
   },
   {
    "start": 41.84,
    "end": 43.96,
    "text": "这门开得这么低这么窄"
   },
   {
    "start": 43.96,
    "end": 45.36,
    "text": "一个人得趴在地上"
   },
   {
    "start": 45.36,
    "end": 47.04,
    "text": "像狗一样才能钻进去"
   },
   {
    "start": 47.04,
    "end": 47.84,
    "text": "传出去"
   },
   {
    "start": 47.84,
    "end": 49.08,
    "text": "人家不得笑话你"
   }
  ]
 },
 {
  "ep": 55,
  "start": 4.68,
  "end": 48.58,
  "dur": 43.9,
  "score": 5.3,
  "lines": [
   {
    "start": 4.68,
    "end": 6.56,
    "text": "我还这么年轻 我不甘心"
   },
   {
    "start": 9.52,
    "end": 11.68,
    "text": "地府 经这么暖和"
   },
   {
    "start": 12.97,
    "end": 15.13,
    "text": "连躺着的地面 都是热的"
   },
   {
    "start": 15.33,
    "end": 16.01,
    "text": "你没死"
   },
   {
    "start": 16.76,
    "end": 18.92,
    "text": "牟川 你怎么也会在这儿"
   },
   {
    "start": 19.32,
    "end": 19.92,
    "text": "难道"
   },
   {
    "start": 20.51,
    "end": 21.59,
    "text": "难道你也死了"
   },
   {
    "start": 30.84,
    "end": 31.84,
    "text": "牟川哥哥"
   },
   {
    "start": 31.96,
    "end": 34.0,
    "text": "我 好几天没吃东西了"
   },
   {
    "start": 34.16,
    "end": 36.8,
    "text": "你能不能分我一点肉吃"
   },
   {
    "start": 37.08,
    "end": 48.58,
    "text": "我们自己都不够吃"
   }
  ]
 }
]