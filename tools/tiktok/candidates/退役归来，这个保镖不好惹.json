   {
    "start": 3.28,
    "end": 4.24,
    "text": "你们欠的房租"
   },
   {
    "start": 4.24,
    "end": 5.56,
    "text": "我已经替你们接清了"
   },
   {
    "start": 6.32,
    "end": 7.24,
