   },
   {
    "start": 19.62,
    "end": 20.74,
    "text": "我知道你是为我好"
   },
   {
    "start": 20.9,
    "end": 21.62,
    "text": "但是今天的事情"
   },
   {
    "start": 21.62,
    "end": 22.62,
    "text": "真的特别重要"
   },
   {
    "start": 22.9,
    "end": 23.9,
    "text": "有一个已经预约好"
   },
   {
    "start": 23.9,
    "end": 25.1,
    "text": "绝对不能延期的会议"
   },
   {
    "start": 25.66,
    "end": 26.54,
    "text": "我等一下打完点地"
   },
   {
    "start": 26.54,
    "end": 27.42,
    "text": "回去公司开完会"
   },
   {
    "start": 27.42,
    "end": 28.26,
    "text": "到时候再回来"
   },
   {
    "start": 28.9,
    "end": 29.64,
    "text": "会议的情况"
   },
   {
    "start": 29.64,
    "end": 30.56,
    "text": "我已经问过秘书了"
   },
   {
    "start": 31.08,
    "end": 32.12,
    "text": "主要是为了改革公司的"
   },
   {
    "start": 32.12,
    "end": 32.76,
    "text": "销售网络"
   },
   {
    "start": 33.04,
    "end": 34.56,
    "text": "也是你一直都在准备的一件事"
   },
   {
    "start": 34.76,
    "end": 35.12,
    "text": "对"
   },
   {
    "start": 35.6,
    "end": 36.64,
    "text": "你既然知道就该知道"
   },
   {
    "start": 36.64,
    "end": 37.64,
    "text": "这对于我对于公司来说"
   },
   {
    "start": 37.64,
    "end": 38.28,
    "text": "有多么重要"
   },
   {
    "start": 38.28,
    "end": 39.24,
    "text": "所以我必须回去"
   },
   {
    "start": 40.31,
    "end": 41.87,
    "text": "这个事情已经存在很久了"
   },
   {
    "start": 41.87,
    "end": 42.95,
    "text": "你也已经筹备那么久了"
   },
   {
    "start": 42.95,
    "end": 44.15,
    "text": "为什么还要急于这一时"
   },
   {
    "start": 44.15,
    "end": 45.51,
    "text": "你也说了这个事情很重要"
   },
   {
    "start": 45.67,
    "end": 46.47,
    "text": "越是重要的事情"
   },
   {
    "start": 46.47,
    "end": 47.39,
    "text": "越是不能着急"
   },
   {
    "start": 48.03,
    "end": 49.07,
    "text": "万一出了错怎么办"
   },
   {
    "start": 49.47,
    "end": 50.95,
    "text": "何况你现在这个身体状况"
   },
   {
    "start": 51.27,
    "end": 52.27,
    "text": "你觉得你能处理好了"
   }
  ]
