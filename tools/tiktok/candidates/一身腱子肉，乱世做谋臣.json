    "end": 37.11,
    "text": "竟能将三大刺头踪门"
   },
   {
    "start": 37.11,
    "end": 38.51,
    "text": "甚至连先天镜的鬼手婆婆"
   },
   {
    "start": 38.51,
    "end": 40.11,
    "text": "都收服进中校职"
   },
   {
    "start": 40.11,
    "end": 40.67,
    "text": "嗨"
   },
   {
    "start": 40.67,
    "end": 41.75,
    "text": "殿下过奖了"
   },
   {
    "start": 41.75,
    "end": 43.63,
    "text": "某家平城最善以礼夫人"
   },
   {
    "start": 43.63,
    "end": 44.71,
    "text": "他们被某家的一片城"
   },
   {
    "start": 44.71,
    "end": 45.39,
