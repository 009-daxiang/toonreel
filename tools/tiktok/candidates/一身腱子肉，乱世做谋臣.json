   {
    "start": 50.71,
    "end": 52.31,
    "text": "李先生又力盖世骑功"
   },
   {
    "start": 52.31,
    "end": 52.87,
    "text": "本功"
   },
   {
    "start": 52.87,
    "end": 54.59,
    "text": "并有重赏"
