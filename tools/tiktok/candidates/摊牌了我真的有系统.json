   {
    "start": 38.19,
    "end": 38.91,
    "text": "我没事"
   },
   {
    "start": 39.55,
    "end": 40.39,
    "text": "就是陈叔"
   },
   {
    "start": 40.75,
    "end": 42.03,
    "text": "我是不是太高调了"
   },
   {
    "start": 42.39,
    "end": 44.27,
    "text": "我感觉我到哪儿都能牵扯出麻烦"
