    "end": 69.18,
    "text": "我没办法开出证明"
   },
   {
    "start": 69.18,
    "end": 70.14,
    "text": "完不成任务呢"
   },
   {
    "start": 70.14,
    "end": 70.66,
    "text": "完不成"
   },
   {
