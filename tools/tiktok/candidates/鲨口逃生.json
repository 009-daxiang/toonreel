  "end": 59.52,
  "dur": 42.5,
  "score": 7.2,
  "lines": [
   {
    "start": 16.99,
    "end": 17.83,
    "text": "小莫"
   },
   {
    "start": 17.83,
    "end": 19.66,
    "text": "你念念情深意重"
   },
   {
    "start": 19.66,
    "end": 20.66,
    "text": "我很欣慰"
   },
   {
    "start": 21.32,
    "end": 22.84,
    "text": "但事者已逝"
   },
   {
    "start": 22.84,
    "end": 24.2,
    "text": "就别再闹了"
   },
   {
    "start": 24.62,
    "end": 26.66,
    "text": "明天就是我们俩家的婚礼"
   },
   {
    "start": 27.87,
    "end": 29.27,
    "text": "虽然念念走了"
   },
   {
    "start": 29.27,
    "end": 30.83,
    "text": "但连音不能毁"
   },
   {
    "start": 31.07,
    "end": 33.03,
    "text": "珍珠会代替念念嫁给你"
   },
   {
    "start": 33.03,
    "end": 37.19,
    "text": "可笑"
   },
   {
    "start": 37.7,
    "end": 39.14,
    "text": "我寒末娶谁"
   },
   {
    "start": 39.14,
    "end": 40.74,
    "text": "轮得到你们做主"
   },
   {
    "start": 40.74,
    "end": 57.16,
    "text": "连杀鱼不敢进来"
   },
   {
    "start": 57.28,
    "end": 59.52,
    "text": "那我就借他们杀出去"
   }
  ]
 },
 {
  "ep": 16,
