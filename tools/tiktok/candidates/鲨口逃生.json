  "score": 5.5,
  "lines": [
   {
    "start": 61.15,
    "end": 62.59,
    "text": "这是我们沈家的事"
   },
   {
    "start": 62.75,
    "end": 66.01,
    "text": "沈宁是我的未婚妻"
   },
   {
    "start": 70.62,
    "end": 72.14,
    "text": "救生艇的航行记录"
   },
   {
    "start": 72.14,
    "end": 73.94,
    "text": "被人工恶意删除了"
   },
   {
    "start": 76.42,
    "end": 77.98,
    "text": "有人不想让我们知道"
   },
   {
    "start": 78.1,
    "end": 80.86,
    "text": "那艘船到底去过哪里"
   },
   {
    "start": 81.1,
    "end": 83.75,
    "text": "那么大"
   },
   {
    "start": 83.75,
    "end": 84.63,
    "text": "设备坏了"
   },
   {
    "start": 84.79,
    "end": 86.27,
    "text": "为什么只丢关键定位"
   },
   {
    "start": 87.7,
    "end": 88.54,
    "text": "你有证据吗"
   }
  ]
 },
 {
