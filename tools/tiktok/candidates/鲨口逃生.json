  "lines": [
   {
    "start": 49.82,
    "end": 50.7,
    "text": "沈真珠"
   },
   {
    "start": 51.67,
    "end": 53.11,
    "text": "从沈念出事起"
   },
   {
    "start": 53.11,
    "end": 54.83,
    "text": "你就一直在小方设法"
   },
   {
    "start": 54.83,
    "end": 56.43,
    "text": "阻止所有人去找她"
   },
   {
    "start": 57.1,
    "end": 57.74,
    "text": "为什么"
   },
   {
    "start": 58.54,
    "end": 59.22,
    "text": "我没有"
   },
   {
    "start": 59.22,
    "end": 63.58,
    "text": "你到底在怕什么"
   },
   {
    "start": 63.94,
    "end": 65.58,
    "text": "你怕她活着回来"
   },
   {
    "start": 69.18,
    "end": 70.62,
    "text": "我只是接受了现实"
   },
   {
    "start": 71.14,
    "end": 72.26,
    "text": "姐姐已经死了"
   },
   {
    "start": 72.46,
    "end": 73.86,
    "text": "她早就被杀一吃了"
   },
   {
    "start": 76.17,
    "end": 76.85,
    "text": "是吗"
   },
   {
    "start": 78.06,
    "end": 79.86,
    "text": "那你最好稍相祈祷"
   },
   {
    "start": 80.53,
    "end": 81.77,
    "text": "她真的死了"
   },
   {
    "start": 81.77,
    "end": 90.94,
    "text": "可能活着回来"
   },
   {
    "start": 91.48,
    "end": 92.24,
    "text": "莫哥哥"
   },
   {
    "start": 93.52,
    "end": 95.48,
    "text": "这辈子别想再见到那个贱人"
   }
  ]
 },
 {
  "ep": 26,
  "start": 11.6,
  "end": 57.47,
  "dur": 45.9,
  "score": 10.3,
  "lines": [
   {
    "start": 11.6,
    "end": 13.24,
    "text": "我必须尽快找别的落脚点"
   },
   {
    "start": 16.61,
    "end": 17.57,
    "text": "三四十马"
   },
   {
    "start": 18.17,
    "end": 19.25,
    "text": "一分钟内游荡"
   },
   {
    "start": 20.28,
    "end": 21.04,
    "text": "我游得到"
   },
   {
    "start": 22.25,
    "end": 23.45,
    "text": "我必须违宪异部"
   },
   {
    "start": 33.01,
    "end": 34.65,
    "text": "搜救队找了一天一夜"
   },
   {
    "start": 35.35,
    "end": 36.31,
    "text": "再搜下去"
   },
   {
    "start": 36.82,
    "end": 38.78,
    "text": "只会让工作对人往生命危险"
   },
   {
    "start": 39.14,
    "end": 41.46,
    "text": "真正牵远看见沈宁被沙御脱走"
   },
   {
    "start": 41.74,
    "end": 42.7,
    "text": "还有什么好找的"
   },
   {
    "start": 43.06,
    "end": 44.22,
    "text": "二哥别这样说"
   },
   {
    "start": 44.42,
    "end": 45.3,
    "text": "再找找吧"
   },
   {
    "start": 45.62,
    "end": 47.66,
    "text": "哪怕只能找到姐姐的一件衣服"
   },
   {
    "start": 47.78,
    "end": 49.38,
    "text": "回家"
   },
   {
    "start": 50.58,
    "end": 56.51,
    "text": "你做的够多"
   },
   {
    "start": 56.51,
    "end": 57.47,
    "text": "你们停搜的"
   }
  ]
 },
 {
  "ep": 11,
  "start": 5.96,
  "end": 49.76,
  "dur": 43.8,
  "score": 10.1,
  "lines": [
   {
    "start": 5.96,
    "end": 7.92,
    "text": "沐哥姐姐是亲姐妹啊"
   },
   {
    "start": 7.92,
    "end": 8.52,
    "text": "韩沐"
   },
   {
    "start": 11.69,
    "end": 12.29,
    "text": "韩沐"
   },
   {
    "start": 12.73,
    "end": 13.89,
    "text": "珍珠也是受害者"
   },
   {
    "start": 14.29,
    "end": 15.77,
    "text": "她刚从鬼门关逃回来"
   },
   {
    "start": 16.09,
    "end": 17.61,
    "text": "你凭什么这么凶的质问她"
   },
   {
    "start": 19.57,
    "end": 20.77,
    "text": "韩沐 你"
   },
   {
    "start": 21.17,
    "end": 28.38,
    "text": "范围中心"
   },
   {
    "start": 29.27,
    "end": 30.95,
    "text": "将搜索半径扩大三倍"
   },
   {
    "start": 31.31,
    "end": 31.91,
    "text": "韩总"
   },
   {
    "start": 32.65,
    "end": 34.13,
    "text": "夜离海上能见度太低"
   },
   {
    "start": 35.28,
    "end": 36.8,
    "text": "这片海域实在太大了"
   },
   {
    "start": 37.08,
    "end": 38.2,
    "text": "盲目扩大范围"
   },
   {
    "start": 38.32,
    "end": 39.72,
    "text": "亦于大海捞针啊"
   },
   {
    "start": 41.99,
    "end": 44.59,
    "text": "那就一片海域一片海域给我去找"
   },
   {
    "start": 46.52,
    "end": 47.56,
    "text": "我要见人"
   },
   {
    "start": 48.88,
    "end": 49.76,
    "text": "要见识"
   }
  ]
 },
 {
  "ep": 41,
  "start": 21.74,
  "end": 49.42,
  "dur": 27.7,
  "score": 8.1,
  "lines": [
   {
    "start": 21.74,
    "end": 23.18,
    "text": "韩墨到底是什么意思"
   },
   {
    "start": 23.56,
    "end": 24.48,
    "text": "答应娶我"
   },
   {
    "start": 24.48,
    "end": 26.2,
    "text": "但又一直不放弃寻找沈念"
   },
   {
    "start": 26.48,
    "end": 27.04,
    "text": "难道"
   },
   {
    "start": 27.36,
    "end": 28.51,
    "text": "对我起疑了"
   },
   {
    "start": 28.95,
    "end": 29.83,
    "text": "答应娶我"
   },
   {
    "start": 29.95,
    "end": 30.95,
    "text": "是在拖住我"
   },
   {
    "start": 31.35,
    "end": 32.91,
    "text": "万一真让她查出什么东西"
   },
   {
    "start": 32.91,
    "end": 34.43,
    "text": "沈家人一定不会放过我"
   },
   {
    "start": 34.43,
    "end": 35.03,
    "text": "不行"
   },
   {
    "start": 35.39,
    "end": 36.31,
    "text": "我得阻止她"
   },
   {
    "start": 41.7,
    "end": 42.62,
    "text": "你要去哪儿"
   },
   {
    "start": 42.98,
    "end": 43.7,
    "text": "莫哥哥"
   },
   {
    "start": 44.06,
    "end": 45.3,
    "text": "你已经连着魏姐姐的事"
   },
   {
    "start": 45.3,
    "end": 46.42,
    "text": "操劳了两天了"
   },
   {
    "start": 46.78,
    "end": 47.98,
    "text": "我担心你的身体"
   },
   {
    "start": 48.42,
    "end": 49.42,
    "text": "想去看看你"
   }
  ]
 },
 {
  "ep": 31,
