   {
    "start": 69.98,
    "end": 71.98,
    "text": "是华大出了名的仇女"
   },
   {
    "start": 71.98,
    "end": 73.98,
    "text": "你明知道我喜欢的是静怡"
   }
  ]
 },
 {
  "ep": 73,
