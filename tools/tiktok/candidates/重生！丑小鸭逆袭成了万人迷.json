[
 {
  "ep": 94,
  "start": 7.63,
  "end": 52.94,
  "dur": 45.3,
  "score": 15.4,
  "lines": [
   {
    "start": 7.63,
    "end": 9.31,
    "text": "明天是庆祝她康复的聚会"
   },
   {
    "start": 9.47,
    "end": 11.11,
    "text": "你能不能别在这里胡闹了"
   },
   {
    "start": 11.23,
    "end": 12.11,
    "text": "我闹"
   },
   {
    "start": 12.51,
    "end": 13.91,
    "text": "要不是你不接我电话"
   },
   {
    "start": 14.03,
    "end": 15.07,
    "text": "我能找到这儿来"
   },
   {
    "start": 15.19,
    "end": 16.79,
    "text": "还说什么不是你男朋友"
   },
   {
    "start": 16.91,
    "end": 19.19,
    "text": "不是你男朋友怎么偏偏你挨着她做"
   },
   {
    "start": 19.31,
    "end": 20.35,
    "text": "别想骗你妈"
   },
   {
    "start": 20.47,
    "end": 21.79,
    "text": "你妈的眼睛毒着呢"
   },
   {
    "start": 21.91,
    "end": 22.87,
    "text": "从小就是这样"
   },
   {
    "start": 22.99,
    "end": 24.59,
    "text": "她总是固执己见地做着自己"
   },
   {
    "start": 24.71,
    "end": 27.43,
    "text": "看不懂形式 自私事丽 无法沟通"
   },
   {
    "start": 27.55,
    "end": 29.23,
    "text": "这也是她没有在乎的原因之一"
   },
   {
    "start": 29.23,
    "end": 31.23,
    "text": "而这点我也和宋静怡讲过"
   },
   {
    "start": 31.87,
    "end": 34.74,
    "text": "抱歉 我妈可能有点什么误会"
   },
   {
    "start": 34.86,
    "end": 36.06,
    "text": "打扰你的聚会了"
   },
   {
    "start": 36.18,
    "end": 37.26,
    "text": "我先带她离开"
   },
   {
    "start": 37.38,
    "end": 39.1,
    "text": "你们慢慢玩 跟我走"
   },
   {
    "start": 39.22,
    "end": 40.06,
    "text": "什么意思"
   },
   {
    "start": 40.18,
    "end": 41.26,
    "text": "别你妈丢人了"
   },
   {
    "start": 41.38,
    "end": 42.58,
    "text": "要不是我你能长这么大"
   },
   {
    "start": 42.7,
    "end": 44.58,
    "text": "你知道我那个拖油瓶多难找对象吗"
   },
   {
    "start": 44.7,
    "end": 46.1,
    "text": "怎么 你现在攀上高质了"
   },
   {
    "start": 46.22,
    "end": 46.98,
    "text": "知道别你妈丢人了"
   },
   {
    "start": 47.1,
    "end": 48.5,
    "text": "跟我走 我回去跟你说清楚"
   },
   {
    "start": 48.62,
    "end": 50.42,
    "text": "我不走 我凭什么要走"
   },
   {
    "start": 50.54,
    "end": 51.74,
    "text": "人家小棋都没有赶我走"
   },
   {
    "start": 51.86,
    "end": 52.94,
    "text": "你凭什么赶我走"
   }
  ]
 },
 {
  "ep": 1,
  "start": 79.98,
  "end": 125.46,
  "dur": 45.5,
  "score": 15.1,
  "lines": [
   {
    "start": 79.98,
    "end": 81.98,
    "text": "听起来的确没有一点底线"
   },
   {
    "start": 81.98,
    "end": 85.21,
    "text": "可惜死过一次之后"
   },
   {
    "start": 85.21,
    "end": 89.24,
    "text": "底线在我这里是最不值钱的东西"
   },
   {
    "start": 89.24,
    "end": 91.24,
    "text": "送静怡身边不缺追求者"
   },
   {
    "start": 91.24,
    "end": 93.24,
    "text": "长得帅的 身材好的 有钱的"
   },
   {
    "start": 93.24,
    "end": 95.24,
    "text": "可以在学业上给她提供帮助的"
   },
   {
    "start": 95.24,
    "end": 97.24,
    "text": "你凭什么认为你能轻易打动她"
   },
   {
    "start": 97.24,
    "end": 98.24,
    "text": "我"
   },
   {
    "start": 98.24,
    "end": 100.27,
    "text": "就算静怡不会选我"
   },
   {
    "start": 100.27,
    "end": 101.27,
    "text": "那也轮不到你"
   },
   {
    "start": 101.27,
    "end": 102.27,
    "text": "我本以为你只是丑"
   },
   {
    "start": 102.27,
    "end": 104.27,
    "text": "没想到还这么无耻"
   },
   {
    "start": 104.27,
    "end": 105.27,
    "text": "我无耻"
   },
   {
    "start": 105.27,
    "end": 106.27,
    "text": "你和我都在体育系"
   },
   {
    "start": 106.27,
    "end": 107.27,
    "text": "知道我是送静怡的好朋友"
   },
   {
    "start": 107.27,
    "end": 108.27,
    "text": "你假装对我虚寒问暖"
   },
   {
    "start": 108.27,
    "end": 109.27,
    "text": "释放曖昧信息"
   },
   {
    "start": 109.27,
    "end": 111.27,
    "text": "好故意通过我来接近送静怡"
   },
   {
    "start": 111.27,
    "end": 112.27,
    "text": "你到底是谁利用谁在先"
   },
   {
    "start": 112.27,
    "end": 113.27,
    "text": "这个米科看着蠢蠢的"
   },
   {
    "start": 113.27,
    "end": 115.27,
    "text": "居然能看穿我小心思"
   },
   {
    "start": 115.27,
    "end": 116.27,
    "text": "我"
   },
   {
    "start": 116.27,
    "end": 117.27,
    "text": "蒋木也"
   },
   {
    "start": 117.27,
    "end": 118.27,
    "text": "不如我们做个交易"
   },
   {
    "start": 118.27,
    "end": 121.1,
    "text": "米科似乎和之前不一样了"
   },
   {
    "start": 121.1,
    "end": 123.46,
    "text": "今天怎么感觉还挺有气势的"
   },
   {
    "start": 123.46,
    "end": 125.46,
    "text": "利用我男朋友的身份"
   }
  ]
 },
 {
  "ep": 43,
  "start": 22.09,
  "end": 67.91,
  "dur": 45.8,
  "score": 13.5,
  "lines": [
   {
    "start": 22.09,
    "end": 23.7,
    "text": "不是这样的"
   },
   {
    "start": 23.7,
    "end": 25.38,
    "text": "都没错"
   },
   {
    "start": 25.38,
    "end": 27.22,
    "text": "笑话就可以随便聊别人男朋友"
   },
   {
    "start": 27.22,
    "end": 28.42,
    "text": "米克把他当闺蜜"
   },
   {
    "start": 28.42,
    "end": 29.18,
    "text": "他倒好"
   },
   {
    "start": 29.18,
    "end": 30.38,
    "text": "转头就瞧瞧讲"
   },
   {
    "start": 30.38,
    "end": 31.38,
    "text": "没边界感的人"
   },
   {
    "start": 31.38,
    "end": 32.46,
    "text": "都这么理直气壮吗"
   },
   {
    "start": 32.46,
    "end": 33.78,
    "text": "人家男朋友都敢瞧"
   },
   {
    "start": 33.78,
    "end": 34.7,
    "text": "还装无辜"
   },
   {
    "start": 35.26,
    "end": 37.46,
    "text": "宋静怡平时看着挺清纯的"
   },
   {
    "start": 37.46,
    "end": 39.46,
    "text": "没想到私底下这么会玩啊"
   },
   {
    "start": 39.46,
    "end": 41.42,
    "text": "而被宋静怡拒绝的蒋慕怡"
   },
   {
    "start": 41.42,
    "end": 42.82,
    "text": "却在这个时候站出来"
   },
   {
    "start": 42.82,
    "end": 44.18,
    "text": "扛下了所有"
   },
   {
    "start": 44.18,
    "end": 45.98,
    "text": "米克和静怡都是好女孩"
   },
   {
    "start": 45.98,
    "end": 47.63,
    "text": "一切都是我的错"
   },
   {
    "start": 47.63,
    "end": 48.71,
    "text": "对于是"
   },
   {
    "start": 48.71,
    "end": 50.27,
    "text": "我不仅踩着蒋慕怡"
   },
   {
    "start": 50.27,
    "end": 51.79,
    "text": "脱离了仇女的等级"
   },
   {
    "start": 51.79,
    "end": 52.87,
    "text": "又合理地打击了"
   },
   {
    "start": 52.87,
    "end": 54.07,
    "text": "宋静怡的风平"
   },
   {
    "start": 54.07,
    "end": 55.03,
    "text": "怎么不算"
   },
   {
    "start": 55.03,
    "end": 56.55,
    "text": "一种小小的圣人"
   },
   {
    "start": 56.55,
    "end": 59.72,
    "text": "收到男主鹿灵腿款"
   },
   {
    "start": 59.72,
    "end": 61.8,
    "text": "47,554.00元"
   },
   {
    "start": 61.8,
    "end": 63.12,
    "text": "当前系统鱼"
   },
   {
    "start": 63.12,
    "end": 65.0,
    "text": "47,740.00元"
   },
   {
    "start": 65.0,
    "end": 66.4,
    "text": "是否进行操作"
   },
   {
    "start": 67.03,
    "end": 67.91,
    "text": "先不用"
   }
  ]
 },
 {
  "ep": 2,
  "start": 16.11,
  "end": 61.78,
  "dur": 45.7,
  "score": 12.9,
  "lines": [
   {
    "start": 16.11,
    "end": 17.11,
    "text": "直到一个月前"
   },
   {
    "start": 17.11,
    "end": 18.11,
    "text": "我居然重生了"
   },
   {
    "start": 18.11,
    "end": 20.11,
    "text": "还意外获得了内魔系统"
   },
   {
    "start": 31.78,
    "end": 32.78,
    "text": "游戏规则是什么"
   },
   {
    "start": 32.78,
    "end": 33.78,
    "text": "你必须用尽一切办法"
   },
   {
    "start": 33.78,
    "end": 35.78,
    "text": "从这本外人民小说里的男性角色身上"
   },
   {
    "start": 35.78,
    "end": 37.78,
    "text": "获取金钱 礼物等一切具有市价值的东西"
   },
   {
    "start": 37.78,
    "end": 39.78,
    "text": "进通过等级和魅力值升级"
   },
   {
    "start": 39.78,
    "end": 40.78,
    "text": "魅力值越高"
   },
   {
    "start": 40.78,
    "end": 41.78,
    "text": "你的外貌和一些条件"
   },
   {
    "start": 41.78,
    "end": 42.78,
    "text": "都可以进行无限优化"
   },
   {
    "start": 42.78,
    "end": 44.78,
    "text": "总升到最高等级魅魔"
   },
   {
    "start": 44.78,
    "end": 45.78,
    "text": "就可以夺走女主气韵"
   },
   {
    "start": 45.78,
    "end": 47.78,
    "text": "享受属于宋静怡的美好人生"
   },
   {
    "start": 47.78,
    "end": 49.78,
    "text": "那一刻 什么虐保女主 虐保男主"
   },
   {
    "start": 49.78,
    "end": 51.78,
    "text": "我那一刻只有一个想法"
   },
   {
    "start": 51.78,
    "end": 52.78,
    "text": "无论伤害谁 无论牺牲谁"
   },
   {
    "start": 52.78,
    "end": 53.78,
    "text": "无论利用谁"
   },
   {
    "start": 53.78,
    "end": 55.78,
    "text": "我不要再做被宰的鱼"
   },
   {
    "start": 55.78,
    "end": 56.78,
    "text": "我想做拿刀的手"
   },
   {
    "start": 56.78,
    "end": 58.78,
    "text": "我不要再让自己受一丁点委屈"
   },
   {
    "start": 58.78,
    "end": 59.78,
    "text": "查看魅力值"
   },
   {
    "start": 59.78,
    "end": 61.78,
    "text": "当前系统鱼鹅3712.01元"
   }
  ]
 },
 {
  "ep": 63,
  "start": 4.4,
  "end": 49.09,
  "dur": 44.7,
  "score": 12.8,
  "lines": [
   {
    "start": 4.4,
    "end": 6.4,
    "text": "我还要重新体验父母离婚"
   },
   {
    "start": 6.4,
    "end": 8.4,
    "text": "重新经历外公去世"
   },
   {
    "start": 8.4,
    "end": 11.0,
    "text": "重新跟着母亲在各种男人中间周旋"
   },
   {
    "start": 11.0,
    "end": 12.2,
    "text": "被嫌弃"
   },
   {
    "start": 12.2,
    "end": 13.0,
    "text": "被苛待"
   },
   {
    "start": 13.0,
    "end": 14.4,
    "text": "被同学嘲笑"
   },
   {
    "start": 14.4,
    "end": 16.8,
    "text": "然后等着女主像光一样拯救我"
   },
   {
    "start": 16.8,
    "end": 19.0,
    "text": "再毫不犹豫地为她挡刀赴死"
   },
   {
    "start": 19.0,
