[
 {
  "ep": 92,
  "start": 11.98,
  "end": 57.9,
  "dur": 45.9,
  "score": 16.2,
  "lines": [
   {
    "start": 11.98,
    "end": 12.78,
    "text": "不就是简童吗"
   },
   {
    "start": 12.94,
    "end": 13.62,
    "text": "沈修建"
   },
   {
    "start": 13.82,
    "end": 14.82,
    "text": "你别说她不是"
   },
   {
    "start": 15.22,
    "end": 16.1,
    "text": "她要不是你小女朋友"
   },
   {
    "start": 16.1,
    "end": 16.98,
    "text": "你干吗管她死活"
   },
   {
    "start": 17.1,
    "end": 18.46,
    "text": "她发烧关你屁事"
   },
   {
    "start": 18.62,
    "end": 19.78,
    "text": "你别说是可怜她"
   },
   {
    "start": 20.62,
    "end": 21.7,
    "text": "你沈大总裁"
   },
   {
    "start": 21.7,
    "end": 23.3,
    "text": "什么时候这么有同情心了"
   },
   {
    "start": 23.5,
    "end": 24.66,
    "text": "不是你小女朋友"
   },
   {
    "start": 24.78,
    "end": 25.94,
    "text": "你大半夜亲自开车"
   },
   {
    "start": 25.94,
    "end": 26.82,
    "text": "送她去医院"
   },
   {
    "start": 27.74,
    "end": 28.7,
    "text": "可拉倒吧"
   },
   {
    "start": 30.66,
    "end": 31.46,
    "text": "沈总"
   },
   {
    "start": 32.02,
    "end": 32.86,
    "text": "要没事"
   },
   {
    "start": 32.86,
    "end": 33.82,
    "text": "我先出去"
   },
   {
    "start": 33.98,
    "end": 34.86,
    "text": "她就放在你这儿"
   },
   {
    "start": 35.62,
    "end": 36.74,
    "text": "你把人给我看好了"
   },
   {
    "start": 37.84,
    "end": 38.64,
    "text": "她醒了"
   },
   {
    "start": 38.8,
    "end": 39.76,
    "text": "你就跟她说"
   },
   {
    "start": 40.12,
    "end": 41.08,
    "text": "她昏过去了"
   },
   {
    "start": 41.44,
    "end": 42.8,
    "text": "你找了熟人来给她掉水"
   },
   {
    "start": 43.0,
    "end": 45.78,
    "text": "你放手"
   },
   {
    "start": 45.94,
    "end": 47.52,
    "text": "沈小姐 我警告你"
   },
   {
    "start": 47.88,
    "end": 48.4,
    "text": "再不放手"
   },
   {
    "start": 48.4,
    "end": 49.56,
    "text": "老子纵别你"
   },
   {
    "start": 53.66,
    "end": 54.82,
    "text": "你要纵别我"
   },
   {
    "start": 55.77,
    "end": 56.29,
    "text": "来"
   },
   {
    "start": 56.98,
    "end": 57.9,
    "text": "避话避话"
   }
  ]
 },
 {
  "ep": 58,
  "start": 10.06,
  "end": 55.99,
  "dur": 45.9,
  "score": 11.1,
  "lines": [
   {
    "start": 10.06,
    "end": 10.9,
    "text": "没有啊"
   },
   {
    "start": 10.9,
    "end": 13.26,
    "text": "萧先生要是来了那些姐妹肯定知道"
   },
   {
    "start": 13.26,
    "end": 14.22,
    "text": "慕慕"
   },
   {
    "start": 14.22,
    "end": 15.62,
    "text": "你也喜欢萧先生"
   },
   {
    "start": 15.62,
    "end": 16.46,
    "text": "也"
   },
   {
    "start": 16.46,
    "end": 18.18,
    "text": "小小你也喜欢萧先生"
   },
   {
    "start": 18.18,
    "end": 19.14,
    "text": "不是我"
   },
   {
    "start": 19.14,
    "end": 20.34,
    "text": "是其他人"
   },
   {
    "start": 20.34,
    "end": 22.3,
    "text": "好多人都喜欢萧先生"
   },
   {
    "start": 22.3,
    "end": 23.86,
    "text": "幸好你没有"
   },
   {
    "start": 23.86,
    "end": 25.34,
    "text": "萧先生眼光肯定高"
   },
   {
    "start": 25.34,
    "end": 27.58,
    "text": "能当他女朋友的女孩子一定很优秀"
   },
   {
    "start": 27.58,
    "end": 29.02,
    "text": "她来东黄就是玩玩"
   },
   {
    "start": 29.02,
    "end": 31.34,
    "text": "怎么可能看中那些招风隐迭的女人"
   },
   {
    "start": 31.7,
    "end": 33.46,
    "text": "小小我是为你好"
   },
   {
    "start": 33.46,
    "end": 34.78,
    "text": "你别跟他们瞎凑热闹"
   },
   {
    "start": 34.78,
    "end": 37.24,
    "text": "省得以后伤心"
   },
   {
    "start": 37.24,
    "end": 39.04,
    "text": "我知道了慕慕"
   },
   {
    "start": 39.04,
    "end": 41.65,
    "text": "我得去工作了"
   },
   {
    "start": 41.65,
    "end": 43.37,
    "text": "萧先生记住了我的名字"
   },
   {
    "start": 43.37,
    "end": 44.97,
    "text": "他说我很可爱"
   },
   {
    "start": 44.97,
    "end": 46.89,
    "text": "你们这些拥之俗粉"
   },
   {
    "start": 46.89,
    "end": 50.06,
    "text": "凭什么跟我争"
   },
   {
    "start": 50.06,
    "end": 51.66,
    "text": "看到简童了吗"
   },
   {
    "start": 51.66,
    "end": 53.51,
    "text": "简童今天请假"
   },
   {
    "start": 53.51,
    "end": 54.83,
    "text": "好像人有些累"
   },
   {
    "start": 54.83,
    "end": 55.99,
    "text": "想休息休息"
   }
  ]
 },
 {
  "ep": 1,
  "start": 92.02,
  "end": 136.1,
  "dur": 44.1,
  "score": 10.9,
  "lines": [
   {
    "start": 92.02,
    "end": 94.04,
    "text": "威明是我女儿"
   },
   {
    "start": 94.04,
    "end": 96.12,
    "text": "她从小到大乖巧懂事"
   },
   {
    "start": 96.12,
    "end": 98.2,
    "text": "从没踏足过酒吧夜场"
   },
   {
    "start": 98.2,
    "end": 100.72,
    "text": "她却在那种三教九流的地方"
   },
   {
    "start": 100.72,
    "end": 103.08,
    "text": "被一群混混侮辱至死"
   },
   {
    "start": 103.08,
    "end": 104.16,
    "text": "事发前"
   },
   {
    "start": 104.16,
    "end": 105.64,
    "text": "她给你打过电话"
   },
   {
    "start": 105.64,
    "end": 107.26,
    "text": "发过短信"
   },
   {
    "start": 107.26,
    "end": 109.18,
    "text": "你说我已经到了夜色"
   },
   {
    "start": 109.18,
    "end": 111.26,
    "text": "你人呢"
   },
   {
    "start": 111.26,
    "end": 112.65,
    "text": "剪小姐"
   },
   {
    "start": 112.65,
    "end": 114.05,
    "text": "你害死的不是猫狗"
   },
   {
    "start": 114.05,
    "end": 116.1,
    "text": "是活生生的人"
   },
   {
    "start": 116.1,
    "end": 118.06,
    "text": "人都死了你还在狡辩"
   },
   {
    "start": 118.1,
    "end": 120.18,
    "text": "谁都知道你痴禅沈先生"
   },
   {
    "start": 120.18,
    "end": 122.14,
    "text": "沈先生心里只有威明"
   },
   {
    "start": 122.14,
    "end": 123.5,
    "text": "分明是求而不得"
   },
   {
    "start": 123.5,
    "end": 126.44,
    "text": "才想毁了威明的清白"
   },
   {
    "start": 126.44,
    "end": 127.98,
    "text": "你走吧"
   },
   {
    "start": 127.98,
    "end": 129.02,
    "text": "对了"
   },
   {
    "start": 129.02,
    "end": 131.81,
    "text": "沈先生还让我转达一句话"
   },
   {
    "start": 131.81,
    "end": 134.78,
    "text": "沈先生说"
   },
   {
    "start": 134.78,
    "end": 136.1,
    "text": "死的那个人"
   }
  ]
 },
 {
  "ep": 13,
  "start": 10.62,
  "end": 50.18,
  "dur": 39.6,
  "score": 10.7,
  "lines": [
   {
    "start": 10.62,
    "end": 11.82,
    "text": "停在二十八层了"
   },
   {
    "start": 12.1,
    "end": 14.1,
    "text": "沈秀紧带一个清洁宫去二十八层"
   },
   {
    "start": 14.42,
    "end": 15.54,
    "text": "清洁宫也是女人"
   },
   {
    "start": 15.86,
    "end": 16.82,
    "text": "有那么大惊小怪"
   },
   {
    "start": 17.14,
    "end": 18.54,
    "text": "沈秀紧这口味"
   },
   {
    "start": 19.39,
    "end": 20.11,
    "text": "别按了"
   },
   {
    "start": 20.94,
    "end": 22.9,
    "text": "二十八楼整层都是沈秀紧的"
   },
   {
    "start": 23.42,
    "end": 24.78,
    "text": "没有门卡你上不去"
   },
   {
    "start": 29.18,
    "end": 29.82,
    "text": "简通"
   },
   {
    "start": 29.82,
    "end": 31.52,
    "text": "简大小姐"
   },
   {
    "start": 32.25,
    "end": 35.25,
    "text": "你今日真是叫我大开眼界"
   },
   {
    "start": 35.25,
    "end": 36.53,
    "text": "昔日的简大小姐"
   },
   {
    "start": 37.09,
    "end": 38.21,
    "text": "如今为了求饶"
   },
   {
    "start": 38.69,
    "end": 40.65,
    "text": "卑微下箭到大亭广众之下"
   },
   {
    "start": 40.65,
    "end": 41.73,
    "text": "拥稳一个下人"
   },
   {
    "start": 42.09,
    "end": 43.59,
    "text": "你说"
   },
   {
    "start": 44.29,
    "end": 46.33,
    "text": "如果简震东那个老家会知道吗"
   },
   {
    "start": 47.27,
    "end": 48.63,
    "text": "会不会没脸现任"
   },
   {
    "start": 48.98,
    "end": 50.18,
    "text": "简家没有简通"
   }
  ]
 },
 {
  "ep": 81,
  "start": 6.06,
  "end": 51.06,
  "dur": 45.0,
  "score": 9.0,
  "lines": [
   {
    "start": 6.06,
    "end": 7.58,
    "text": "我这边没有给你安排六楼的活儿"
   },
   {
    "start": 7.78,
    "end": 8.9,
    "text": "你怎么会到六楼去的"
   },
   {
    "start": 9.26,
    "end": 10.26,
    "text": "秦木木说"
   },
   {
    "start": 10.38,
    "end": 11.62,
    "text": "六楼有客人点了我"
   },
   {
    "start": 11.98,
    "end": 19.06,
    "text": "谁让你自作主张的"
   },
   {
    "start": 19.34,
    "end": 22.45,
    "text": "是萧先生"
   },
   {
    "start": 22.73,
    "end": 23.29,
    "text": "完了"
   },
   {
    "start": 23.69,
    "end": 24.21,
    "text": "完了"
   },
   {
    "start": 24.69,
    "end": 25.33,
    "text": "简童"
   },
   {
    "start": 25.61,
    "end": 27.49,
    "text": "简童他居然和沈总有关系"
   },
   {
    "start": 28.01,
    "end": 28.89,
    "text": "我该怎么办"
   },
   {
    "start": 29.21,
    "end": 31.01,
    "text": "我好不容易才考上S大"
   },
   {
    "start": 33.05,
    "end": 33.61,
    "text": "什么事"
   },
   {
    "start": 34.05,
    "end": 35.6,
    "text": "沈总"
   },
   {
    "start": 36.12,
    "end": 38.62,
    "text": "秦木木他是S大的学生"
   },
   {
    "start": 38.86,
    "end": 40.06,
    "text": "考上S大不容易"
   },
   {
    "start": 40.58,
    "end": 41.78,
    "text": "他只是一时糊涂"
   },
   {
    "start": 42.7,
    "end": 44.18,
    "text": "求您放过他"
   },
   {
    "start": 44.46,
    "end": 47.7,
    "text": "你替他求情"
   },
   {
    "start": 49.54,
    "end": 51.06,
    "text": "他把你推进水箱里"
   }
  ]
 },
 {
  "ep": 1,
  "start": 4.03,
  "end": 44.6,
  "dur": 40.6,
  "score": 7.4,
  "lines": [
   {
    "start": 4.03,
    "end": 5.47,
    "text": "你只唱听一听"
   },
   {
    "start": 7.5,
    "end": 8.94,
    "text": "那些伤害威脸的小婚婚"
   },
   {
    "start": 8.94,
    "end": 10.06,
    "text": "不是我安排的"
   },
   {
    "start": 10.9,
    "end": 13.62,
    "text": "就这么喜欢我吗"
   },
   {
    "start": 13.62,
    "end": 18.9,
    "text": "还到不惜害死威名"
   },
   {
    "start": 18.9,
    "end": 20.5,
    "text": "我没有存心害死威名"
   },
   {
    "start": 23.46,
    "end": 24.98,
    "text": "剪刀剪刀小姐"
   },
   {
    "start": 26.17,
    "end": 27.29,
    "text": "你怎么对威名"
   },
   {
    "start": 27.77,
    "end": 28.85,
    "text": "我就怎么对你"
   },
   {
    "start": 30.48,
    "end": 32.04,
    "text": "剪刀小姐我现在很累"
   },
   {
    "start": 32.56,
    "end": 33.44,
    "text": "你请回"
   },
   {
    "start": 33.44,
    "end": 35.0,
    "text": "剪刀小姐"
   },
   {
    "start": 35.0,
    "end": 37.0,
    "text": "你听我说没有"
   },
   {
    "start": 37.0,
    "end": 38.36,
    "text": "要我听你说话"
   },
   {
    "start": 38.36,
    "end": 39.68,
    "text": "也不是不可以"
   },
   {
    "start": 39.68,
    "end": 41.24,
    "text": "剪刀小姐要是愿意跪在我"
   },
   {
    "start": 41.24,
    "end": 43.28,
    "text": "沈家庄员前一个晚上"
   },
   {
    "start": 43.32,
    "end": 44.6,
    "text": "或许我心情好了"
   }
  ]
 },
 {
  "ep": 36,
  "start": 14.43,
  "end": 59.48,
  "dur": 45.0,
  "score": 6.9,
  "lines": [
   {
    "start": 14.43,
    "end": 15.43,
    "text": "我憑自己的手"
   },
   {
    "start": 15.43,
    "end": 16.95,
    "text": "自己的汗水賺乾淨的錢"
   },
   {
    "start": 16.95,
    "end": 19.55,
    "text": "每一分都是辛辛苦苦流汗流淚賺來的"
   },
   {
    "start": 20.07,
    "end": 21.47,
    "text": "沒有一分是像簡彤那樣"
   },
   {
    "start": 21.47,
    "end": 22.75,
    "text": "出賣自尊患的"
   },
   {
    "start": 23.43,
    "end": 24.31,
    "text": "我活得坦蕩"
   },
   {
    "start": 24.31,
    "end": 25.35,
    "text": "輕輕白白"
   },
   {
    "start": 25.35,
    "end": 26.91,
    "text": "憑什麼被孟姊羞辱"
   },
   {
    "start": 27.51,
    "end": 29.37,
    "text": "秦慕慕"
   },
   {
    "start": 30.26,
    "end": 32.14,
    "text": "那天要不是簡彤替你解圍"
   },
   {
    "start": 32.66,
    "end": 34.7,
    "text": "就憑你不給西家公子臉面"
   },
   {
    "start": 35.71,
    "end": 37.83,
    "text": "你今天早就被整得比簡彤還慘"
   },
   {
    "start": 38.23,
    "end": 39.55,
    "text": "簡彤能做到的事"
   },
   {
    "start": 39.91,
    "end": 41.64,
    "text": "你做不到"
   },
   {
    "start": 41.84,
    "end": 43.7,
    "text": "當然做不到"
   },
   {
    "start": 44.14,
    "end": 45.62,
    "text": "那種不要臉不要尊嚴的事"
   },
   {
    "start": 45.62,
    "end": 47.74,
    "text": "我秦慕慕這輩子根本不會去做"
   },
   {
    "start": 48.14,
    "end": 49.5,
    "text": "希望一個星期後"
   },
   {
    "start": 49.82,
    "end": 50.74,
    "text": "你還這麼說"
   },
   {
    "start": 52.77,
    "end": 53.41,
    "text": "秦慕慕"
   },
   {
    "start": 54.84,
    "end": 56.32,
    "text": "簡彤今天受的這些"
   },
   {
    "start": 56.56,
    "end": 57.84,
    "text": "本該是你去承受的"
   },
   {
    "start": 58.28,
    "end": 59.48,
    "text": "既然你不念他的好"
   }
  ]
 },
 {
  "ep": 25,
  "start": 7.23,
  "end": 36.8,
  "dur": 29.6,
  "score": 6.3,
  "lines": [
   {
    "start": 7.23,
    "end": 9.23,
    "text": "叫你抬起头来 耳朵聋了"
   },
   {
    "start": 9.81,
    "end": 11.37,
    "text": "需要我叫人来帮你吗"
   },
   {
    "start": 11.77,
    "end": 13.85,
    "text": "不过你这模样实在太倒胃口了"
   },
   {
    "start": 14.33,
    "end": 16.65,
    "text": "小爷的酒只能这么赏你"
   },
   {
    "start": 17.01,
    "end": 18.01,
    "text": "拿着钱快滚"
   },
   {
    "start": 18.01,
    "end": 19.65,
    "text": "小爷多看你一眼 眼睛都疼"
   },
   {
    "start": 19.65,
    "end": 21.13,
    "text": "快 咬尾巴"
   },
   {
    "start": 27.08,
    "end": 27.8,
