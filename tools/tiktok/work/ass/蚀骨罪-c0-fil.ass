Dialogue: 1,0:00:00.00,0:00:30.80,H_fil,,0,0,0,,Bakit mo kami pinapansin kung buhay o patay siya?
Dialogue: 1,0:00:00.00,0:00:30.80,C_fil,,0,0,0,,Panuorin LAHAT — LIBRE ▶ YT688.app
Dialogue: 0,0:00:00.04,0:00:00.94,S_fil,,0,0,0,,Si Jian Tong lang 'yon.
Dialogue: 0,0:00:00.98,0:00:01.88,S_fil,,0,0,0,,Shen Xiujin.
Dialogue: 0,0:00:01.92,0:00:02.82,S_fil,,0,0,0,,Huwag mo nang ideny.
Dialogue: 0,0:00:03.22,0:00:04.12,S_fil,,0,0,0,,Kung hindi siya girlfriend mo,
Dialogue: 0,0:00:04.16,0:00:05.06,S_fil,,0,0,0,,bakit mo pakialaman kung buhay o patay siya?
Dialogue: 0,0:00:05.10,0:00:06.46,S_fil,,0,0,0,,May lagnat siya, ano'ng pakialam mo?
Dialogue: 0,0:00:06.62,0:00:07.78,S_fil,,0,0,0,,Huwag mong sabihing naaawa ka.
Dialogue: 0,0:00:08.62,0:00:09.70,S_fil,,0,0,0,,Big-time CEO Shen,
Dialogue: 0,0:00:09.74,0:00:11.30,S_fil,,0,0,0,,kelan ka pa naging sobrang maaawain?
Dialogue: 0,0:00:11.50,0:00:12.66,S_fil,,0,0,0,,Kung hindi siya jowa mo,
Dialogue: 0,0:00:12.78,0:00:13.94,S_fil,,0,0,0,,ihahatid mo ba siya hating-gabi nang mag-isa
Dialogue: 0,0:00:13.98,0:00:14.88,S_fil,,0,0,0,,papunta sa hospital?
Dialogue: 0,0:00:15.74,0:00:16.70,S_fil,,0,0,0,,Naku, eh.
Dialogue: 0,0:00:18.66,0:00:19.56,S_fil,,0,0,0,,Mr. Shen,
Dialogue: 0,0:00:20.02,0:00:20.92,S_fil,,0,0,0,,Kung wala nang iba,
Dialogue: 0,0:00:20.96,0:00:21.86,S_fil,,0,0,0,,aalis na ako.
Dialogue: 0,0:00:21.98,0:00:22.88,S_fil,,0,0,0,,Iwan ko muna siya dito.
Dialogue: 0,0:00:23.62,0:00:24.74,S_fil,,0,0,0,,Bantayan mo siyang mabuti.
Dialogue: 0,0:00:25.84,0:00:26.74,S_fil,,0,0,0,,Pagkagising niya,
Dialogue: 0,0:00:26.80,0:00:27.76,S_fil,,0,0,0,,sabihin mo sa kanya
Dialogue: 0,0:00:28.12,0:00:29.08,S_fil,,0,0,0,,no'ng himatayin siya,
Dialogue: 0,0:00:29.44,0:00:30.80,S_fil,,0,0,0,,may kakilala kang tinawag para sa kanya.
