Dialogue: 1,0:00:00.00,0:00:34.50,H_vi,,0,0,0,,"Cậu sợ cô ấy còn SỐNG trở về?"
Dialogue: 1,0:00:00.00,0:00:34.50,C_vi,,0,0,0,,Xem toàn bộ MIỄN PHÍ ▶ YT688.app
Dialogue: 0,0:00:00.32,0:00:01.22,S_vi,,0,0,0,,Shen Zhenzhu.
Dialogue: 0,0:00:02.17,0:00:03.61,S_vi,,0,0,0,,Từ khi Shen Nian gặp chuyện,
Dialogue: 0,0:00:03.65,0:00:05.33,S_vi,,0,0,0,,cậu đã tìm đủ mọi cách
Dialogue: 0,0:00:05.37,0:00:06.93,S_vi,,0,0,0,,để chặn mọi người tìm kiếm cô ấy.
Dialogue: 0,0:00:07.60,0:00:08.50,S_vi,,0,0,0,,Tại sao?
Dialogue: 0,0:00:09.04,0:00:09.94,S_vi,,0,0,0,,Tôi không làm vậy.
Dialogue: 0,0:00:09.98,0:00:14.08,S_vi,,0,0,0,,Cậu đang sợ gì cơ?
Dialogue: 0,0:00:14.44,0:00:16.08,S_vi,,0,0,0,,Cậu sợ cô ấy còn sống trở về.
Dialogue: 0,0:00:19.68,0:00:21.12,S_vi,,0,0,0,,Tôi chỉ chấp nhận sự thật.
Dialogue: 0,0:00:21.64,0:00:22.76,S_vi,,0,0,0,,Chị ấy đã chết rồi.
Dialogue: 0,0:00:22.96,0:00:24.36,S_vi,,0,0,0,,Cô ta bị cá mập xơi từ lâu rồi.
Dialogue: 0,0:00:26.67,0:00:27.57,S_vi,,0,0,0,,Vậy à?
Dialogue: 0,0:00:28.56,0:00:30.36,S_vi,,0,0,0,,Vậy cậu nên cầu nguyện đi.
Dialogue: 0,0:00:31.03,0:00:32.27,S_vi,,0,0,0,,Cầu cho cô ấy thật sự đã chết.
Dialogue: 0,0:00:32.31,0:00:34.50,S_vi,,0,0,0,,Vì cô ấy có thể vẫn còn sống.
