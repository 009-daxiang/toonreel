Dialogue: 1,0:00:00.00,0:00:37.10,H_vi,,0,0,0,,Kẻ thù bày mưu... tiếc là cô ấy nhớ mọi thứ
Dialogue: 1,0:00:00.00,0:00:37.10,C_vi,,0,0,0,,Xem toàn bộ MIỄN PHÍ ▶ YT688.app
Dialogue: 0,0:00:00.04,0:00:00.94,S_vi,,0,0,0,,Rất nhiều người
Dialogue: 0,0:00:00.98,0:00:02.41,S_vi,,0,0,0,,chỉ trích Tống Tĩnh Doanh trên diễn đàn là thiếu ranh giới.
Dialogue: 0,0:00:02.69,0:00:04.30,S_vi,,0,0,0,,Không phải vậy!
Dialogue: 0,0:00:04.34,0:00:05.98,S_vi,,0,0,0,,Ai cũng không sai à?
Dialogue: 0,0:00:06.02,0:00:07.82,S_vi,,0,0,0,,Đùa thôi cũng được phép mớm tay người yêu người khác?
Dialogue: 0,0:00:07.86,0:00:09.02,S_vi,,0,0,0,,Mi Ke coi cô ta như bạn thân.
Dialogue: 0,0:00:09.06,0:00:09.96,S_vi,,0,0,0,,Mà cô ta,
Dialogue: 0,0:00:10.00,0:00:10.98,S_vi,,0,0,0,,quay đi nói xấu âm thầm.
Dialogue: 0,0:00:11.02,0:00:11.98,S_vi,,0,0,0,,Kẻ thiếu ranh giới,
Dialogue: 0,0:00:12.02,0:00:13.06,S_vi,,0,0,0,,luôn tự nhiên đến thế à?
Dialogue: 0,0:00:13.10,0:00:14.38,S_vi,,0,0,0,,cả người yêu người khác dám mớm tay,
Dialogue: 0,0:00:14.42,0:00:15.32,S_vi,,0,0,0,,mà còn giả vờ ngơ ngác?
Dialogue: 0,0:00:15.86,0:00:18.06,S_vi,,0,0,0,,Tống Tĩnh Doanh ngoài mặt trong sáng,
Dialogue: 0,0:00:18.10,0:00:20.06,S_vi,,0,0,0,,ai ngờ đằng sau lại chơi bẩn vậy.
Dialogue: 0,0:00:20.10,0:00:22.02,S_vi,,0,0,0,,còn Jiang Muyi — bị Tĩnh Doanh từ chối —
Dialogue: 0,0:00:22.06,0:00:23.42,S_vi,,0,0,0,,lại đứng ra đúng lúc này
Dialogue: 0,0:00:23.46,0:00:24.78,S_vi,,0,0,0,,gánh hết mọi thứ.
Dialogue: 0,0:00:24.82,0:00:26.58,S_vi,,0,0,0,,Mi Ke và Tĩnh Doanh đều là con gái tốt.
Dialogue: 0,0:00:26.62,0:00:28.23,S_vi,,0,0,0,,Tất cả là lỗi của tôi.
Dialogue: 0,0:00:28.27,0:00:29.31,S_vi,,0,0,0,,Còn tôi—
Dialogue: 0,0:00:29.35,0:00:30.87,S_vi,,0,0,0,,không những bước qua Jiang Muyi,
Dialogue: 0,0:00:30.91,0:00:32.39,S_vi,,0,0,0,,thoát khỏi tầng cuối,
Dialogue: 0,0:00:32.43,0:00:33.47,S_vi,,0,0,0,,và hạ gục hợp lý
Dialogue: 0,0:00:33.51,0:00:34.67,S_vi,,0,0,0,,danh tiếng của Tống Tĩnh Doanh.
Dialogue: 0,0:00:34.71,0:00:35.63,S_vi,,0,0,0,,sao lại không phải
Dialogue: 0,0:00:35.67,0:00:37.10,S_vi,,0,0,0,,một chiến thắng nhỏ chứ?
