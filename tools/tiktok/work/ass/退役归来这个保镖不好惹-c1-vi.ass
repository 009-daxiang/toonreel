Dialogue: 1,0:00:00.00,0:00:44.80,H_vi,,0,0,0,,Cậu nghĩ chạy thoát khỏi tôi à?
Dialogue: 1,0:00:00.00,0:00:44.80,C_vi,,0,0,0,,Xem toàn bộ MIỄN PHÍ ▶ YT688.app
Dialogue: 0,0:00:00.04,0:00:01.40,S_vi,,0,0,0,,Cậu nghĩ chạy thoát tôi sao?
Dialogue: 0,0:00:02.57,0:00:04.17,S_vi,,0,0,0,,Khuyên cậu đừng thử.
Dialogue: 0,0:00:04.37,0:00:11.22,S_vi,,0,0,0,,Anh ơi, tha cho tôi với!
Dialogue: 0,0:00:11.26,0:00:13.02,S_vi,,0,0,0,,vụ đánh nhau tôi chỉ là tay sai nhỏ,
Dialogue: 0,0:00:13.06,0:00:14.42,S_vi,,0,0,0,,Tất cả là anh Trọc bảo làm.
Dialogue: 0,0:00:15.43,0:00:16.83,S_vi,,0,0,0,,đêm qua chúng tôi còn đi nghĩa địa,
Dialogue: 0,0:00:16.87,0:00:17.77,S_vi,,0,0,0,,và ở đó cả đêm.
Dialogue: 0,0:00:17.81,0:00:18.83,S_vi,,0,0,0,,Anh bảo gì tôi làm hết rồi!
Dialogue: 0,0:00:21.06,0:00:21.96,S_vi,,0,0,0,,Nhìn này,
Dialogue: 0,0:00:22.32,0:00:23.92,S_vi,,0,0,0,,vết thương trên người tôi chưa lành.
Dialogue: 0,0:00:23.96,0:00:25.92,S_vi,,0,0,0,,Xin anh đó, tha cho tôi!
Dialogue: 0,0:00:25.96,0:00:27.72,S_vi,,0,0,0,,Đứng dậy. Tôi có việc cần hỏi.
Dialogue: 0,0:00:29.43,0:00:30.63,S_vi,,0,0,0,,Bảo hắn sang đợi ở đó.
Dialogue: 0,0:00:31.42,0:00:32.82,S_vi,,0,0,0,,Đợi anh phía trước nhé em.
Dialogue: 0,0:00:33.93,0:00:36.13,S_vi,,0,0,0,,Anh ơi, tôi thật sự chỉ làm theo lệnh.
Dialogue: 0,0:00:36.17,0:00:37.07,S_vi,,0,0,0,,Tôi—
Dialogue: 0,0:00:37.25,0:00:39.45,S_vi,,0,0,0,,Bình tĩnh, chỉ hỏi mấy câu.
Dialogue: 0,0:00:40.88,0:00:41.78,S_vi,,0,0,0,,Cảm ơn anh.
Dialogue: 0,0:00:42.62,0:00:43.62,S_vi,,0,0,0,,Anh Trọc chết rồi đúng không?
Dialogue: 0,0:00:43.66,0:00:44.80,S_vi,,0,0,0,,Anh... anh biết rồi à?!
