Dialogue: 1,0:00:00.00,0:00:46.40,H_vi,,0,0,0,,"Tôi không sợ gì. Tôi lập đàn rồi. Tôi là KHỐC TINH của quỷ dữ."
Dialogue: 1,0:00:00.00,0:00:46.40,C_vi,,0,0,0,,Xem toàn bộ MIỄN PHÍ ▶ YT688.app
Dialogue: 0,0:00:00.04,0:00:02.81,S_vi,,0,0,0,,Tôi sợ gì chứ?
Dialogue: 0,0:00:02.85,0:00:03.81,S_vi,,0,0,0,,Tôi đã lập đàn tế.
Dialogue: 0,0:00:03.85,0:00:05.81,S_vi,,0,0,0,,Tôi là khắc tinh của quỷ dữ.
Dialogue: 0,0:00:05.85,0:00:06.88,S_vi,,0,0,0,,Ông là ai?
Dialogue: 0,0:00:06.92,0:00:09.00,S_vi,,0,0,0,,Dám xông vào thế à?
Dialogue: 0,0:00:09.04,0:00:14.14,S_vi,,0,0,0,,Đó là tiên quỷ đàn ta mới nhận.
Dialogue: 0,0:00:14.18,0:00:15.14,S_vi,,0,0,0,,Ông ấy đã qua khảo nghiệm.
Dialogue: 0,0:00:15.18,0:00:16.17,S_vi,,0,0,0,,Cậu này,
Dialogue: 0,0:00:16.21,0:00:18.17,S_vi,,0,0,0,,nhìn cho kỹ rồi hãy nói.
Dialogue: 0,0:00:18.21,0:00:19.17,S_vi,,0,0,0,,Vậy cảm giác khó chịu của tôi
Dialogue: 0,0:00:19.21,0:00:21.59,S_vi,,0,0,0,,là vì ông ta sao?
Dialogue: 0,0:00:21.63,0:00:23.59,S_vi,,0,0,0,,Hắn vẫn bám trên người cậu.
Dialogue: 0,0:00:23.63,0:00:24.59,S_vi,,0,0,0,,Cậu không cảm nhận được
Dialogue: 0,0:00:24.63,0:00:26.59,S_vi,,0,0,0,,hay đưa hắn về hậu điện tu luyện,
Dialogue: 0,0:00:26.63,0:00:27.59,S_vi,,0,0,0,,nên mới khó chịu đến giờ.
Dialogue: 0,0:00:27.63,0:00:28.59,S_vi,,0,0,0,,Sao anh không nói sớm hơn?
Dialogue: 0,0:00:28.63,0:00:29.59,S_vi,,0,0,0,,Các người là người nhận hắn.
Dialogue: 0,0:00:29.63,0:00:30.59,S_vi,,0,0,0,,Sau khi thẩm tra xong,
Dialogue: 0,0:00:30.63,0:00:31.59,S_vi,,0,0,0,,đưa hắn thẳng về hậu điện —
Dialogue: 0,0:00:31.63,0:00:32.59,S_vi,,0,0,0,,chẳng xong việc sao?
Dialogue: 0,0:00:32.63,0:00:33.59,S_vi,,0,0,0,,Vô lễ quá.
Dialogue: 0,0:00:33.63,0:00:35.59,S_vi,,0,0,0,,Đàn tế có quy củ.
Dialogue: 0,0:00:35.63,0:00:36.59,S_vi,,0,0,0,,Khi có tiên linh vào,
Dialogue: 0,0:00:36.63,0:00:37.59,S_vi,,0,0,0,,đồng cốt phải biết.
Dialogue: 0,0:00:37.63,0:00:38.59,S_vi,,0,0,0,,và phải hỏi cho rõ ràng.
Dialogue: 0,0:00:38.63,0:00:39.59,S_vi,,0,0,0,,Không thì chó mèo nào
Dialogue: 0,0:00:39.63,0:00:41.59,S_vi,,0,0,0,,cũng tu luyện được à?
Dialogue: 0,0:00:41.63,0:00:44.42,S_vi,,0,0,0,,Cho ta hỏi tiên quỷ danh hàm là gì?
Dialogue: 0,0:00:44.46,0:00:45.42,S_vi,,0,0,0,,Xuất thân từ đâu?
Dialogue: 0,0:00:45.46,0:00:46.40,S_vi,,0,0,0,,Có tài năng gì?
