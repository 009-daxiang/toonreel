Dialogue: 1,0:00:00.00,0:00:40.30,H_vi,,0,0,0,,Sau khi chết một lần, tôi không còn giới hạn nào nữa.
Dialogue: 1,0:00:00.00,0:00:40.30,C_vi,,0,0,0,,Xem toàn bộ MIỄN PHÍ ▶ YT688.app
Dialogue: 0,0:00:00.04,0:00:02.98,S_vi,,0,0,0,,Cướp người theo đuổi bạn thân?
Dialogue: 0,0:00:03.02,0:00:04.98,S_vi,,0,0,0,,Nghe thật là không có giới hạn.
Dialogue: 0,0:00:05.02,0:00:08.21,S_vi,,0,0,0,,Nhưng sau khi chết một lần,
Dialogue: 0,0:00:08.25,0:00:12.24,S_vi,,0,0,0,,giới hạn với tôi là thứ rẻ nhất.
Dialogue: 0,0:00:12.28,0:00:14.24,S_vi,,0,0,0,,Tống Tĩnh Doanh không thiếu người theo đuổi.
Dialogue: 0,0:00:14.28,0:00:16.24,S_vi,,0,0,0,,Đẹp trai, dáng chuẩn, giàu có.
Dialogue: 0,0:00:16.28,0:00:18.24,S_vi,,0,0,0,,Cả người giúp được cô ấy trong học tập.
Dialogue: 0,0:00:18.28,0:00:20.24,S_vi,,0,0,0,,Cậu nghĩ dễ dàng khiến cô ấy đổ à?
Dialogue: 0,0:00:20.28,0:00:21.24,S_vi,,0,0,0,,Tôi—
Dialogue: 0,0:00:21.28,0:00:23.27,S_vi,,0,0,0,,Dù Tĩnh Doanh không chọn tôi,
Dialogue: 0,0:00:23.31,0:00:24.27,S_vi,,0,0,0,,cũng chưa chắc là cậu.
Dialogue: 0,0:00:24.31,0:00:25.27,S_vi,,0,0,0,,Tôi cứ tưởng cậu chỉ xấu.
Dialogue: 0,0:00:25.31,0:00:27.27,S_vi,,0,0,0,,Ai ngờ còn đáng xấu hổ hơn.
Dialogue: 0,0:00:27.31,0:00:28.27,S_vi,,0,0,0,,Tôi vô liêm sỉ?
Dialogue: 0,0:00:28.31,0:00:29.27,S_vi,,0,0,0,,Cả hai học cùng khoa thể dục.
Dialogue: 0,0:00:29.31,0:00:30.27,S_vi,,0,0,0,,Anh biết tôi là bạn thân của Tĩnh Doanh.
Dialogue: 0,0:00:30.31,0:00:31.27,S_vi,,0,0,0,,anh giả vờ quan tâm tôi,
Dialogue: 0,0:00:31.31,0:00:32.27,S_vi,,0,0,0,,tỏ ra mập mờ,
Dialogue: 0,0:00:32.31,0:00:34.27,S_vi,,0,0,0,,để thông qua tôi tiếp cận Tĩnh Doanh.
Dialogue: 0,0:00:34.31,0:00:35.27,S_vi,,0,0,0,,Vậy ai lợi dụng ai trước?
Dialogue: 0,0:00:35.31,0:00:36.27,S_vi,,0,0,0,,Mi Ke nhìn có vẻ ngơ ngác,
Dialogue: 0,0:00:36.31,0:00:38.27,S_vi,,0,0,0,,mà nhìn thấu tâm địa tôi.
Dialogue: 0,0:00:38.31,0:00:39.27,S_vi,,0,0,0,,Tôi—
Dialogue: 0,0:00:39.31,0:00:40.27,S_vi,,0,0,0,,Jiang Muyi.
