Dialogue: 1,0:00:00.00,0:00:42.00,H_vi,,0,0,0,,"Ném cả ngọn núi mà cậu gọi là chiến thuật?!"
Dialogue: 1,0:00:00.00,0:00:42.00,C_vi,,0,0,0,,Xem toàn bộ MIỄN PHÍ ▶ YT688.app
Dialogue: 0,0:00:00.04,0:00:01.70,S_vi,,0,0,0,,Kế sách của ta thành công rồi!
Dialogue: 0,0:00:01.74,0:00:03.50,S_vi,,0,0,0,,Thật là kế sách chấn động trời.
Dialogue: 0,0:00:04.38,0:00:05.28,S_vi,,0,0,0,,Anh dùng manh lực,
Dialogue: 0,0:00:05.32,0:00:06.90,S_vi,,0,0,0,,nhấc cả núi đè chết người mà gọi là kế sách?
Dialogue: 0,0:00:06.94,0:00:08.50,S_vi,,0,0,0,,Nó liên quan gì đến kế sách đâu?!
Dialogue: 0,0:00:08.54,0:00:10.76,S_vi,,0,0,0,,Rút quân!
Dialogue: 0,0:00:10.80,0:00:11.76,S_vi,,0,0,0,,Phát thưởng thành công:
Dialogue: 0,0:00:11.80,0:00:13.44,S_vi,,0,0,0,,Sức mạnh +1, ký chủ!
Dialogue: 0,0:00:13.48,0:00:15.54,S_vi,,0,0,0,,Hệ thống chó má, còn chưa chịu thôi à?!
Dialogue: 0,0:00:15.58,0:00:16.58,S_vi,,0,0,0,,Rốt cuộc mày là hệ thống quân sư
Dialogue: 0,0:00:16.62,0:00:17.58,S_vi,,0,0,0,,hay hệ thống cơ bắp?
Dialogue: 0,0:00:17.62,0:00:19.92,S_vi,,0,0,0,,Tăng Trí Lực cho tôi đi!
Dialogue: 0,0:00:19.96,0:00:21.36,S_vi,,0,0,0,,Thế nào rồi, ông Lý?
Dialogue: 0,0:00:21.40,0:00:22.30,S_vi,,0,0,0,,Bẩm điện hạ,
Dialogue: 0,0:00:22.34,0:00:23.24,S_vi,,0,0,0,,không phụ sự giao phó.
Dialogue: 0,0:00:23.28,0:00:24.64,S_vi,,0,0,0,,Kế sách của ta lại thành công.
Dialogue: 0,0:00:24.68,0:00:25.58,S_vi,,0,0,0,,Tốt.
Dialogue: 0,0:00:25.62,0:00:26.56,S_vi,,0,0,0,,Chúc mừng ông Lý lập đại công.
Dialogue: 0,0:00:26.60,0:00:27.50,S_vi,,0,0,0,,Mau đi nhận thưởng.
Dialogue: 0,0:00:27.54,0:00:28.76,S_vi,,0,0,0,,Đa tạ điện hạ.
Dialogue: 0,0:00:28.80,0:00:30.12,S_vi,,0,0,0,,Chuyện gì vậy?
Dialogue: 0,0:00:30.16,0:00:31.28,S_vi,,0,0,0,,ông Lý leo núi bằng tay không,
Dialogue: 0,0:00:31.32,0:00:32.28,S_vi,,0,0,0,,đập gãy sống núi bằng tay không,
Dialogue: 0,0:00:32.32,0:00:33.56,S_vi,,0,0,0,,nhổ cả quả núi mười trượng,
Dialogue: 0,0:00:33.60,0:00:36.78,S_vi,,0,0,0,,và đạp địch cùng giáp thành bột nhão.
Dialogue: 0,0:00:36.82,0:00:38.50,S_vi,,0,0,0,,Vậy mà gọi là kế sách thành công?!
Dialogue: 0,0:00:38.54,0:00:39.46,S_vi,,0,0,0,,Huynh Lý,
Dialogue: 0,0:00:39.50,0:00:40.66,S_vi,,0,0,0,,Thật là tuyệt kế.
Dialogue: 0,0:00:40.70,0:00:41.98,S_vi,,0,0,0,,Tuyệt vời không tả nổi!
