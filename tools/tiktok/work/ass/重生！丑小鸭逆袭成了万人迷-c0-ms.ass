Dialogue: 1,0:00:00.00,0:00:40.30,H_ms,,0,0,0,,Selepas mati sekali, saya tidak ada batas lagi.
Dialogue: 1,0:00:00.00,0:00:40.30,C_ms,,0,0,0,,Tonton semua episod PERCUMA ▶ YT688.app
Dialogue: 0,0:00:00.04,0:00:02.98,S_ms,,0,0,0,,Mencuri peminat kawan baik?
Dialogue: 0,0:00:03.02,0:00:04.98,S_ms,,0,0,0,,Bunyinya memang tanpa batas.
Dialogue: 0,0:00:05.02,0:00:08.21,S_ms,,0,0,0,,Tapi selepas mati sekali,
Dialogue: 0,0:00:08.25,0:00:12.24,S_ms,,0,0,0,,batas jadi benda termurah bagi saya.
Dialogue: 0,0:00:12.28,0:00:14.24,S_ms,,0,0,0,,Song Jingyi tak pernah kekurangan peminat.
Dialogue: 0,0:00:14.28,0:00:16.24,S_ms,,0,0,0,,Kayap, badan cantik, kaya.
Dialogue: 0,0:00:16.28,0:00:18.24,S_ms,,0,0,0,,Malah yang boleh bantu pelajarannya.
Dialogue: 0,0:00:18.28,0:00:20.24,S_ms,,0,0,0,,Awak rasa senang nak menawan dia?
Dialogue: 0,0:00:20.28,0:00:21.24,S_ms,,0,0,0,,Saya—
Dialogue: 0,0:00:21.28,0:00:23.27,S_ms,,0,0,0,,Kalau pun Jingyi tak pilih saya,
Dialogue: 0,0:00:23.31,0:00:24.27,S_ms,,0,0,0,,bukan awak yang layak.
Dialogue: 0,0:00:24.31,0:00:25.27,S_ms,,0,0,0,,Kusangka awak buruk sahaja.
Dialogue: 0,0:00:25.31,0:00:27.27,S_ms,,0,0,0,,Rupanya tidak tahu malu juga.
Dialogue: 0,0:00:27.31,0:00:28.27,S_ms,,0,0,0,,Saya tak tahu malu?
Dialogue: 0,0:00:28.31,0:00:29.27,S_ms,,0,0,0,,Kita dua-dua di fakulti sukan.
Dialogue: 0,0:00:29.31,0:00:30.27,S_ms,,0,0,0,,Awak tahu saya kawan baik Jingyi.
Dialogue: 0,0:00:30.31,0:00:31.27,S_ms,,0,0,0,,awak pura-pura ambil berat pasal saya,
Dialogue: 0,0:00:31.31,0:00:32.27,S_ms,,0,0,0,,memberi isyarat ambigu,
Dialogue: 0,0:00:32.31,0:00:34.27,S_ms,,0,0,0,,untuk dekatkan Jingyi melalui saya.
Dialogue: 0,0:00:34.31,0:00:35.27,S_ms,,0,0,0,,Jadi siapa guna siapa dulu?
Dialogue: 0,0:00:35.31,0:00:36.27,S_ms,,0,0,0,,Mi Ke nampak bodoh,
Dialogue: 0,0:00:36.31,0:00:38.27,S_ms,,0,0,0,,tapi dia nampak menembus hati saya.
Dialogue: 0,0:00:38.31,0:00:39.27,S_ms,,0,0,0,,Saya—
Dialogue: 0,0:00:39.31,0:00:40.27,S_ms,,0,0,0,,Jiang Muyi.
