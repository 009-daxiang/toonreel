Dialogue: 1,0:00:00.00,0:00:44.70,H_fil,,0,0,0,,"Ilang anak na babae ang tatay mo?" "Ako lang."
Dialogue: 1,0:00:00.00,0:00:44.70,C_fil,,0,0,0,,Panuorin LAHAT — LIBRE ▶ YT688.app
Dialogue: 0,0:00:00.04,0:00:00.94,S_fil,,0,0,0,,Anong kidnapping?
Dialogue: 0,0:00:01.33,0:00:02.23,S_fil,,0,0,0,,Captain Li,
Dialogue: 0,0:00:02.27,0:00:03.25,S_fil,,0,0,0,,Hindi ko alam pinagsasasabi mo.
Dialogue: 0,0:00:04.06,0:00:05.06,S_fil,,0,0,0,,Ilang anak na babae ang tatay mo?
Dialogue: 0,0:00:05.38,0:00:06.28,S_fil,,0,0,0,,Ako lang.
Dialogue: 0,0:00:06.58,0:00:09.26,S_fil,,0,0,0,,Oo nga, tama.
Dialogue: 0,0:00:09.50,0:00:10.40,S_fil,,0,0,0,,Hindi pwedeng mali.
Dialogue: 0,0:00:10.86,0:00:12.22,S_fil,,0,0,0,,Wala kang alam sa pagkakidnap mo?
Dialogue: 0,0:00:12.46,0:00:14.02,S_fil,,0,0,0,,Hindi ko gets sinasabi ni Captain Li.
Dialogue: 0,0:00:14.30,0:00:15.20,S_fil,,0,0,0,,Tsaka,
Dialogue: 0,0:00:15.24,0:00:16.14,S_fil,,0,0,0,,anong kinalaman niyan sa pagpapakawala niyo?
Dialogue: 0,0:00:16.18,0:00:17.08,S_fil,,0,0,0,,Ano'ng kinalaman?
Dialogue: 0,0:00:17.12,0:00:18.02,S_fil,,0,0,0,,Mayroon.
Dialogue: 0,0:00:18.06,0:00:18.96,S_fil,,0,0,0,,Malaking kinalaman.
Dialogue: 0,0:00:19.00,0:00:19.90,S_fil,,0,0,0,,Ano'ng sabi mo?
Dialogue: 0,0:00:19.94,0:00:20.84,S_fil,,0,0,0,,Si Chen Yundong assistant mo.
Dialogue: 0,0:00:20.88,0:00:21.90,S_fil,,0,0,0,,Employado ng kompanya niyo.
Dialogue: 0,0:00:22.42,0:00:23.32,S_fil,,0,0,0,,Oo.
Dialogue: 0,0:00:23.36,0:00:24.26,S_fil,,0,0,0,,Kailan pa?
Dialogue: 0,0:00:24.70,0:00:25.60,S_fil,,0,0,0,,Tatlong araw.
Dialogue: 0,0:00:25.64,0:00:26.54,S_fil,,0,0,0,,Dumating si Chen Yundong sa kompanya namin
Dialogue: 0,0:00:26.58,0:00:27.48,S_fil,,0,0,0,,tatlong araw pa lang.
Dialogue: 0,0:00:29.02,0:00:29.92,S_fil,,0,0,0,,Tatlong araw?
Dialogue: 0,0:00:29.96,0:00:30.86,S_fil,,0,0,0,,Magbilang nga ako.
Dialogue: 0,0:00:31.10,0:00:32.00,S_fil,,0,0,0,,Ibig sabihin
Dialogue: 0,0:00:32.04,0:00:32.94,S_fil,,0,0,0,,sa ikatlong araw pagkatapos makidnap ka
Dialogue: 0,0:00:32.98,0:00:33.88,S_fil,,0,0,0,,saka siya pumasok sa kompanya niyo?
Dialogue: 0,0:00:33.92,0:00:34.82,S_fil,,0,0,0,,Tama ba?
Dialogue: 0,0:00:34.86,0:00:35.76,S_fil,,0,0,0,,Paano siya pumasok?
Dialogue: 0,0:00:35.80,0:00:36.70,S_fil,,0,0,0,,Nag-apply siya.
Dialogue: 0,0:00:37.71,0:00:38.61,S_fil,,0,0,0,,Ikaw, lumabas muna.
Dialogue: 0,0:00:39.03,0:00:39.93,S_fil,,0,0,0,,May gusto akong
Dialogue: 0,0:00:39.97,0:00:40.95,S_fil,,0,0,0,,kausapin nang sarili si Miss Zhang.
Dialogue: 0,0:00:41.15,0:00:42.05,S_fil,,0,0,0,,Hindi pwede.
Dialogue: 0,0:00:42.09,0:00:42.99,S_fil,,0,0,0,,Sige.
Dialogue: 0,0:00:43.03,0:00:43.93,S_fil,,0,0,0,,Pero Captain Li,
Dialogue: 0,0:00:43.97,0:00:44.70,S_fil,,0,0,0,,pagkatapos niyong mag-usap,
