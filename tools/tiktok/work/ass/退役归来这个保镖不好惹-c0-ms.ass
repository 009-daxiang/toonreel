Dialogue: 1,0:00:00.00,0:00:44.70,H_ms,,0,0,0,,"Berapa ramai puteri ayah awak?" "Saya sahaja."
Dialogue: 1,0:00:00.00,0:00:44.70,C_ms,,0,0,0,,Tonton semua episod PERCUMA ▶ YT688.app
Dialogue: 0,0:00:00.04,0:00:00.94,S_ms,,0,0,0,,Culik apa?
Dialogue: 0,0:00:01.33,0:00:02.23,S_ms,,0,0,0,,Kapten Li,
Dialogue: 0,0:00:02.27,0:00:03.25,S_ms,,0,0,0,,Saya tak faham apa yang awak maksud.
Dialogue: 0,0:00:04.06,0:00:05.06,S_ms,,0,0,0,,Berapa puteri ayah awak?
Dialogue: 0,0:00:05.38,0:00:06.28,S_ms,,0,0,0,,Saya sahaja.
Dialogue: 0,0:00:06.58,0:00:09.26,S_ms,,0,0,0,,Betul macam itu.
Dialogue: 0,0:00:09.50,0:00:10.40,S_ms,,0,0,0,,Maknanya tak silap.
Dialogue: 0,0:00:10.86,0:00:12.22,S_ms,,0,0,0,,Awak tak tahu pasal culik awak?
Dialogue: 0,0:00:12.46,0:00:14.02,S_ms,,0,0,0,,Saya tak faham maksud Kapten Li.
Dialogue: 0,0:00:14.30,0:00:15.20,S_ms,,0,0,0,,Tambahan pula,
Dialogue: 0,0:00:15.24,0:00:16.14,S_ms,,0,0,0,,apa kaitan dengan awak lepaskan dia?
Dialogue: 0,0:00:16.18,0:00:17.08,S_ms,,0,0,0,,Apa kaitannya?
Dialogue: 0,0:00:17.12,0:00:18.02,S_ms,,0,0,0,,Ada.
Dialogue: 0,0:00:18.06,0:00:18.96,S_ms,,0,0,0,,Kaitannya sangat besar.
Dialogue: 0,0:00:19.00,0:00:19.90,S_ms,,0,0,0,,Apakah yang awak cakap tadi?
Dialogue: 0,0:00:19.94,0:00:20.84,S_ms,,0,0,0,,Chen Yundong pembantu awak.
Dialogue: 0,0:00:20.88,0:00:21.90,S_ms,,0,0,0,,Pekerja syarikat awak.
Dialogue: 0,0:00:22.42,0:00:23.32,S_ms,,0,0,0,,Ya.
Dialogue: 0,0:00:23.36,0:00:24.26,S_ms,,0,0,0,,Sejak bila?
Dialogue: 0,0:00:24.70,0:00:25.60,S_ms,,0,0,0,,Tiga hari.
Dialogue: 0,0:00:25.64,0:00:26.54,S_ms,,0,0,0,,Chen Yundong masuk syarikat kami
Dialogue: 0,0:00:26.58,0:00:27.48,S_ms,,0,0,0,,hanya tiga hari.
Dialogue: 0,0:00:29.02,0:00:29.92,S_ms,,0,0,0,,Tiga hari?
Dialogue: 0,0:00:29.96,0:00:30.86,S_ms,,0,0,0,,Biar saya kira.
Dialogue: 0,0:00:31.10,0:00:32.00,S_ms,,0,0,0,,Maksudnya
Dialogue: 0,0:00:32.04,0:00:32.94,S_ms,,0,0,0,,hari ketiga selepas culik awak
Dialogue: 0,0:00:32.98,0:00:33.88,S_ms,,0,0,0,,dia mula kerja di syarikat awak?
Dialogue: 0,0:00:33.92,0:00:34.82,S_ms,,0,0,0,,Betul tak?
Dialogue: 0,0:00:34.86,0:00:35.76,S_ms,,0,0,0,,Macam mana dia masuk?
Dialogue: 0,0:00:35.80,0:00:36.70,S_ms,,0,0,0,,Dia memohon kerja.
Dialogue: 0,0:00:37.71,0:00:38.61,S_ms,,0,0,0,,Awak keluar sebentar.
Dialogue: 0,0:00:39.03,0:00:39.93,S_ms,,0,0,0,,Saya ada perkara
Dialogue: 0,0:00:39.97,0:00:40.95,S_ms,,0,0,0,,berbual bersendirian dengan Puan Zhang.
Dialogue: 0,0:00:41.15,0:00:42.05,S_ms,,0,0,0,,Tak boleh.
Dialogue: 0,0:00:42.09,0:00:42.99,S_ms,,0,0,0,,Baik.
Dialogue: 0,0:00:43.03,0:00:43.93,S_ms,,0,0,0,,Tapi Kapten Li,
Dialogue: 0,0:00:43.97,0:00:44.70,S_ms,,0,0,0,,selepas berbual,
