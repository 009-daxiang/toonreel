Dialogue: 1,0:00:00.00,0:00:37.10,H_ms,,0,0,0,,Musuhnya berkonspirasi... malangnya dia ingat segalanya
Dialogue: 1,0:00:00.00,0:00:37.10,C_ms,,0,0,0,,Tonton semua episod PERCUMA ▶ YT688.app
Dialogue: 0,0:00:00.04,0:00:00.94,S_ms,,0,0,0,,Ramai orang
Dialogue: 0,0:00:00.98,0:00:02.41,S_ms,,0,0,0,,mengkritik Song Jingyi di forum sebab tak tahu batas.
Dialogue: 0,0:00:02.69,0:00:04.30,S_ms,,0,0,0,,Bukan macam itu!
Dialogue: 0,0:00:04.34,0:00:05.98,S_ms,,0,0,0,,Semua tak bersalah?
Dialogue: 0,0:00:06.02,0:00:07.82,S_ms,,0,0,0,,Bergurau boleh mesra dengan boyfriend orang?
Dialogue: 0,0:00:07.86,0:00:09.02,S_ms,,0,0,0,,Mi Ke menganggap dia kawan baik.
Dialogue: 0,0:00:09.06,0:00:09.96,S_ms,,0,0,0,,Tapi dia,
Dialogue: 0,0:00:10.00,0:00:10.98,S_ms,,0,0,0,,pula mengutuknya di belakang.
Dialogue: 0,0:00:11.02,0:00:11.98,S_ms,,0,0,0,,Orang tiada batas,
Dialogue: 0,0:00:12.02,0:00:13.06,S_ms,,0,0,0,,yakin sangat kah?
Dialogue: 0,0:00:13.10,0:00:14.38,S_ms,,0,0,0,,boyfriend orang berani mesra,
Dialogue: 0,0:00:14.42,0:00:15.32,S_ms,,0,0,0,,masih pura-pura tak tahu?
Dialogue: 0,0:00:15.86,0:00:18.06,S_ms,,0,0,0,,Song Jingyi nampak tak bersalah,
Dialogue: 0,0:00:18.10,0:00:20.06,S_ms,,0,0,0,,rupanya di belakang mainnya kotor.
Dialogue: 0,0:00:20.10,0:00:22.02,S_ms,,0,0,0,,Dan Jiang Muyi yang ditolak Song Jingyi,
Dialogue: 0,0:00:22.06,0:00:23.42,S_ms,,0,0,0,,pula tampil ketika ini
Dialogue: 0,0:00:23.46,0:00:24.78,S_ms,,0,0,0,,dan tanggung semua.
Dialogue: 0,0:00:24.82,0:00:26.58,S_ms,,0,0,0,,Mi Ke dan Jingyi dua-duanya gadis baik.
Dialogue: 0,0:00:26.62,0:00:28.23,S_ms,,0,0,0,,Semua ini salah saya.
Dialogue: 0,0:00:28.27,0:00:29.31,S_ms,,0,0,0,,Dan saya—
Dialogue: 0,0:00:29.35,0:00:30.87,S_ms,,0,0,0,,saya bukan sahaja pijak Jiang Muyi,
Dialogue: 0,0:00:30.91,0:00:32.39,S_ms,,0,0,0,,keluar daripada tahap bawah,
Dialogue: 0,0:00:32.43,0:00:33.47,S_ms,,0,0,0,,dan tumbangkan dengan sah
Dialogue: 0,0:00:33.51,0:00:34.67,S_ms,,0,0,0,,reputasi Song Jingyi.
Dialogue: 0,0:00:34.71,0:00:35.63,S_ms,,0,0,0,,bukankah itu
Dialogue: 0,0:00:35.67,0:00:37.10,S_ms,,0,0,0,,kemenangan kecil?
