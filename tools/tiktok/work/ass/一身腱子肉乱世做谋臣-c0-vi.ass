Dialogue: 1,0:00:00.00,0:00:45.90,H_vi,,0,0,0,,Hệ thống đưa anh gym về quá khứ... để làm quân sư?!
Dialogue: 1,0:00:00.00,0:00:45.90,C_vi,,0,0,0,,Xem toàn bộ MIỄN PHÍ ▶ YT688.app
Dialogue: 0,0:00:00.04,0:00:00.94,S_vi,,0,0,0,,Tôi kiếm sống bằng bộ óc.
Dialogue: 0,0:00:00.98,0:00:01.88,S_vi,,0,0,0,,Vừa nãy anh còn nâng hòn đá nghìn cân bằng tay không,
Dialogue: 0,0:00:01.92,0:00:03.28,S_vi,,0,0,0,,và anh gọi đó là
Dialogue: 0,0:00:03.32,0:00:05.28,S_vi,,0,0,0,,Vậy anh có từng tập võ chưa?
Dialogue: 0,0:00:05.32,0:00:06.28,S_vi,,0,0,0,,Chưa từng tập.
Dialogue: 0,0:00:06.32,0:00:07.28,S_vi,,0,0,0,,tôi tập gym chỉ để kiếm cơm —
Dialogue: 0,0:00:07.32,0:00:09.28,S_vi,,0,0,0,,cơ bắp chẳng phải võ nghệ.
Dialogue: 0,0:00:09.32,0:00:10.28,S_vi,,0,0,0,,nhưng trong ta giấu trăm vạn hùng binh,
Dialogue: 0,0:00:10.32,0:00:12.28,S_vi,,0,0,0,,rồng ẩn của thời đại này.
Dialogue: 0,0:00:12.34,0:00:14.34,S_vi,,0,0,0,,Tại cái hệ thống lởm khổm này:
Dialogue: 0,0:00:14.38,0:00:16.34,S_vi,,0,0,0,,bắt thuê quân sư trong 3 ngày —
Dialogue: 0,0:00:16.38,0:00:17.34,S_vi,,0,0,0,,nếu không xong,
Dialogue: 0,0:00:17.38,0:00:18.34,S_vi,,0,0,0,,tôi thành thái giám!
Dialogue: 0,0:00:18.38,0:00:19.34,S_vi,,0,0,0,,Là danh dự của đàn ông đấy!
Dialogue: 0,0:00:19.38,0:00:21.34,S_vi,,0,0,0,,Chết cũng phải làm quân sư!
Dialogue: 0,0:00:21.38,0:00:22.34,S_vi,,0,0,0,,Li tráng sĩ,
Dialogue: 0,0:00:22.38,0:00:24.34,S_vi,,0,0,0,,vào trướng ta làm đại tướng.
Dialogue: 0,0:00:24.38,0:00:25.34,S_vi,,0,0,0,,ta bảo đảm vinh quang cho người.
Dialogue: 0,0:00:25.38,0:00:26.34,S_vi,,0,0,0,,Xin từ biệt.
Dialogue: 0,0:00:26.38,0:00:28.34,S_vi,,0,0,0,,Nếu điện hạ ép tôi làm võ phu thô,
Dialogue: 0,0:00:28.38,0:00:29.34,S_vi,,0,0,0,,tôi phải đầu quân cho minh chủ khác.
Dialogue: 0,0:00:29.38,0:00:31.30,S_vi,,0,0,0,,Tráng sĩ,
Dialogue: 0,0:00:31.34,0:00:32.30,S_vi,,0,0,0,,nếu người sang trại địch,
Dialogue: 0,0:00:32.34,0:00:33.30,S_vi,,0,0,0,,nước ta lấy gì chống lại?
Dialogue: 0,0:00:33.34,0:00:36.19,S_vi,,0,0,0,,Ta,
Dialogue: 0,0:00:36.23,0:00:37.89,S_vi,,0,0,0,,chấp thuận.
Dialogue: 0,0:00:37.93,0:00:38.89,S_vi,,0,0,0,,Đa tạ điện hạ.
Dialogue: 0,0:00:38.93,0:00:39.89,S_vi,,0,0,0,,Thảo dân quyết tận tâm phụng sự.
Dialogue: 0,0:00:39.93,0:00:40.89,S_vi,,0,0,0,,và cống hiến mưu lược cho chủ công.
Dialogue: 0,0:00:40.93,0:00:41.89,S_vi,,0,0,0,,[Tinh!]
Dialogue: 0,0:00:41.93,0:00:42.89,S_vi,,0,0,0,,Chúc mừng ký chủ: thuê quân sư thành công!
Dialogue: 0,0:00:42.93,0:00:44.89,S_vi,,0,0,0,,Hoàn thành nhiệm vụ hệ thống.
Dialogue: 0,0:00:44.93,0:00:45.89,S_vi,,0,0,0,,Đang phát thưởng...
